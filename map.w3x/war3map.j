function Trig_StartBuildingDEmon_Conditions takes nothing returns boolean
    local integer id= GetUnitTypeId(GetConstructingStructure())
    return id == 'h0DU' or id == 'h0DX' or id == 'h02C' or id == 'h0DZ' or id == 'h0DY' or id == 'h0DS' or id == 'h0DS' or id == 'h0DW' or id == 'h0E1' or id == 'h0E0' or id == 'h0DV' or id == 'h0DT'
endfunction

function Trig_StartBuildingDEmon_Actions takes nothing returns nothing
    local integer pi= GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
    set disincome[pi]=disincome[pi] - 6
    set udg_UnitsCount[pi]=udg_UnitsCount[pi] - 1
    call UpdateGraf(pi)
    call Enter(GetTriggerUnit())
endfunction

