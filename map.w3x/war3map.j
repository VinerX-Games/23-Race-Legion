//===========================================================================
// Trigger: CheckNearCapitals
//===========================================================================

function CheckNearCapitals takes unit city returns boolean
    local group g= CreateGroup()
    local unit u= GetTriggerUnit()
    
    set udg_LocalPlayer=GetOwningPlayer(city)
    call GroupEnumUnitsInRange(g, GetUnitX(city), GetUnitY(city), 3050, Condition(function CapitalOfEnemy))

    if FirstOfGroup(g) != null then
        call DisplayTextToPlayer(udg_LocalPlayer, 0, 0, "Посадка к чужой столице (Радиус 3к) запрещена")
        set g=null
        return false
    endif
    
    
    
    
    call DestroyGroup(g)
    set g=null
    return true
endfunction
//===========================================================================
// Trigger: PortalCommonFunction
//===========================================================================
function PortalConditions takes nothing returns boolean
    return not IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) and GetUnitAbilityLevel(GetFilterUnit(), 'Sch5') == 0 and GetUnitAbilityLevel(GetFilterUnit(), 'A001') == 0 and GetUnitAbilityLevel(GetFilterUnit(), 'A1M3') == 0 and GetUnitAbilityLevel(GetFilterUnit(), 'Awrp') == 0 and GetUnitAbilityLevel(GetFilterUnit(), 'A00A') == 0
endfunction

function TeleportUnitsEach takes nothing returns nothing
    call SetUnitPosition(GetEnumUnit(), GetRandomReal(GetRectMinX(gRect), GetRectMaxX(gRect)), GetRandomReal(GetRectMinY(gRect), GetRectMaxY(gRect)))
    call RemoveLocation(gLoc)
    call EnterGreen(GetEnumUnit())
endfunction

function TeleportUnits takes unit Portal,rect Rect2,real radious returns nothing
    set gLoc=GetUnitLoc(Portal)
    set gRect=Rect2
    call GroupEnumUnitsInRangeOfLocCounted(gGroup, gLoc, radious, Condition(function PortalConditions), 150)
    call ForGroup(gGroup, function TeleportUnitsEach)
    call GroupClear(gGroup)
    call RemoveLocation(gLoc)
endfunction


// хз что тут менр
function PortalConditionsED takes nothing returns boolean
    return not IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) and GetUnitAbilityLevel(GetFilterUnit(), 'Sch5') == 0 and GetUnitAbilityLevel(GetFilterUnit(), 'A001') == 0 and GetUnitAbilityLevel(GetFilterUnit(), 'A1M3') == 0 and GetUnitTypeId(GetFilterUnit()) != 'n01W' and GetUnitTypeId(GetFilterUnit()) != 'n01X' and GetUnitAbilityLevel(GetFilterUnit(), 'Awrp') == 0 and GetUnitAbilityLevel(GetFilterUnit(), 'A1LR') >= 1
endfunction

function TeleportUnitsED takes unit Portal,rect Rect2,real radious returns nothing
    set gLoc=GetUnitLoc(Portal)
    set gRect=Rect2
    call GroupEnumUnitsInRangeOfLocCounted(gGroup, gLoc, radious, Condition(function PortalConditionsED), 150)
    call ForGroup(gGroup, function TeleportUnitsEach)
    call GroupClear(gGroup)
    call RemoveLocation(gLoc)
endfunction



