function Trig_F2_Start_Conditions takes nothing returns boolean
    if ( not ( CountLivingPlayerUnitsOfTypeId('h0GR', GetTriggerPlayer()) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_F2_Start_Actions takes nothing returns nothing
    set udg_LocalPosition2=GetRectCenter(gg_rct_HostRegion)
    call ClearSelectionForPlayer(GetTriggerPlayer())
    call CreateNUnitsAtLoc(1, 'h0GR', GetTriggerPlayer(), udg_LocalPosition2, bj_UNIT_FACING)
    call SelectUnitAddForPlayer(GetLastCreatedUnit(), GetTriggerPlayer())
endfunction

