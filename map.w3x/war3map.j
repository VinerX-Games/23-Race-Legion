//===========================================================================
// Trigger: AttackedAI
//
// IssuePointOrderLoc
// IssueTargetOrder
//===========================================================================
function Trig_AttackedAI_Conditions takes nothing returns boolean
    set gAttacked=GetTriggerUnit()
    set gPi=GetPlayerId(GetOwningPlayer(gAttacked))
    return udg_AiControl[gPi]
endfunction



function Trig_AttackedAI_Actions takes nothing returns nothing

    if IsUnitInGroup(gAttacked, udg_ZahvatBuildings) or IsUnitInGroup(gAttacked, AiUnitsToPort[gPi]) then
        if Random(1 , 30) then
            call PortTo(gAttacked)
        endif
    elseif IsUnitInGroup(gAttacked, udg_StolicaGroups) then
        if Random(1 , 10) and GetUnitState(gAttacked, UNIT_STATE_LIFE) > 7500 then
            call PortToFast(gAttacked)
        elseif Random(1 , 5) then
            call PortToFast(gAttacked)
        endif
        
    elseif IsUnitType(gAttacked, UNIT_TYPE_STRUCTURE) then
        if Random(1 , 5) and IsUnitInGroup(gAttacked, AiCapitalBuildigs[gPi]) then
            call PortToFast(gAttacked)
        elseif Random(1 , 30) then
            call PortTo(gAttacked)
        endif
    else
        // --------------- Алый орден
        if AiRace[gPi] == "Scarlet" then
            call AttackedScarlet(gAttacked)
        elseif AiRace[gPi] == "BloodElves" then
            call AttackedBloodElves(gAttacked)
        elseif AiRace[gPi] == "Goblins" then
            call AttackedGoblins(gAttacked)
        elseif AiRace[gPi] == "Naga" then
            call AttackedNaga(gAttacked)
        elseif AiRace[gPi] == "Horde" then
            call AttackedNaga(gAttacked)
        endif
    endif
endfunction

