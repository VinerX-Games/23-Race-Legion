function InitTrig_Spell_Dvij takes nothing returns nothing
    set gg_trg_Spell_Dvij=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_Spell_Dvij, udg_Timer)
    call TriggerAddCondition(gg_trg_Spell_Dvij, Condition(function Trig_Spell_Dvij_Conditions))
    call TriggerAddAction(gg_trg_Spell_Dvij, function Trig_Spell_Dvij_Actions)
endfunction

//===========================================================================
// Trigger: DieDummy
//
// Создает 3 шара которые кружат вокруг героя бесконечно пока он их не потратит или умрет
// запуская их во врагов герой наносит им урон в 200 АОЕ и вешает противные бафы
// Первый выпущенный шар вешает на врагов замедление
// Второй выпущенный шар вешает на врагов хекс
// Третий выпущенный шар вешает на врагов промахи
// Не ставить перезарядку скила на 0 так как будут баги
//===========================================================================
function Trig_DieDummy_Func001Func002A takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_DieDummy_Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetDyingUnit()) == 'h0MK' ) ) then
        return false
    endif
    return true
endfunction

function Trig_DieDummy_Func002Func002A takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_DieDummy_Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetDyingUnit()) == 'h0MJ' ) ) then
        return false
    endif
    return true
endfunction

function Trig_DieDummy_Actions takes nothing returns nothing
    if ( Trig_DieDummy_Func001C() ) then
        call ForGroupBJ(GetUnitsOfTypeIdAll('h0MK'), function Trig_DieDummy_Func001Func002A)
    else
    endif
    if ( Trig_DieDummy_Func002C() ) then
        call ForGroupBJ(GetUnitsOfTypeIdAll('h0MJ'), function Trig_DieDummy_Func002Func002A)
    else
    endif
endfunction

//===========================================================================
function InitTrig_DieDummy takes nothing returns nothing
    set gg_trg_DieDummy=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_DieDummy, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddAction(gg_trg_DieDummy, function Trig_DieDummy_Actions)
endfunction

