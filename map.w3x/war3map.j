//===========================================================================
// Trigger: MassIceArrow
//===========================================================================
function Trig_MassIceArrow_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A1HE'
endfunction


function Trig_MassIceArrow_Actions takes nothing returns nothing
    local location l= GetSpellTargetLoc()
    local player p= GetOwningPlayer(GetTriggerUnit())
    local boolexpr bex
    local integer dammyAbility= 'A1HF'
    local integer level= GetUnitAbilityLevel(GetTriggerUnit(), GetSpellAbilityId())
    local group g= CreateGroup()
    local unit u
    local unit u2
    local integer i= 0
    set udg_LocalPlayer=p
    set bex=Condition(function EnemEl)
    call GroupEnumUnitsInRangeOfLoc(g, l, 150, bex)
    
    if FirstOfGroup(g) == null then
        //Нету врагов
        call BlzStartUnitAbilityCooldown(GetTriggerUnit(), 'A1HE', 14)
        call SetUnitState(GetTriggerUnit(), UNIT_STATE_MANA, GetUnitState(GetTriggerUnit(), UNIT_STATE_MANA) + 100 + 35 * level)
        
    
    else
        call RemoveLocation(l)
        set l=GetUnitLoc(GetTriggerUnit())
        loop
            set u=FirstOfGroup(g)
            exitwhen u == null
            
            set u2=CreateUnitAtLoc(p, 'h05P', l, bj_UNIT_FACING)
            
            call UnitAddAbility(u2, dammyAbility)
            call SetUnitAbilityLevel(u2, dammyAbility, level)
            call IssueTargetOrder(u2, "thunderbolt", u)
            call RemoveUnitTimed(u2 , 2)
            set i=i + 1
            call GroupRemoveUnit(g, u)
        endloop
    endif
    
    set u=null
    call DestroyGroup(g)
    set g=null
    call RemoveLocation(l)
    set p=null
    call DestroyBoolExpr(bex)
    set u2=null
    set bex=null
endfunction

//===========================================================================
function InitTrig_MassIceArrow takes nothing returns nothing
    set gg_trg_MassIceArrow=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_MassIceArrow, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_MassIceArrow, Condition(function Trig_MassIceArrow_Conditions))
    call TriggerAddAction(gg_trg_MassIceArrow, function Trig_MassIceArrow_Actions)
endfunction


