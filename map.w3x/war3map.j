//===========================================================================
// Trigger: StartBuildingSil
//===========================================================================

function Trig_StartBuildingSil_Conditions takes nothing returns boolean
    local integer id= GetUnitTypeId(GetConstructingStructure())
    return id == 'e01J' or id == 'e01J' or id == 'e01L' or id == 'eo1M' or id == 'e01H' or id == 'eo1K'
endfunction

function Trig_StartBuildingSil_Actions takes nothing returns nothing
    local integer pi= GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
    set disincome[pi]=disincome[pi] - 6.25
    call UpdateGraf(pi)
    call Enter(GetTriggerUnit())
endfunction

//===========================================================================
function InitTrig_StartBuildingSil takes nothing returns nothing
    set gg_trg_StartBuildingSil=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_StartBuildingSil, EVENT_PLAYER_UNIT_CONSTRUCT_START)
    call TriggerAddCondition(gg_trg_StartBuildingSil, Condition(function Trig_StartBuildingSil_Conditions))
    call TriggerAddAction(gg_trg_StartBuildingSil, function Trig_StartBuildingSil_Actions)
endfunction


