function Trig_DestroyTrain_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTrainedUnit()) == 'h0P7'
endfunction

function Trig_DestroyTrain_Func002A takes nothing returns nothing
    call KillUnit(GetEnumUnit())
endfunction

function LimitTrainDestroy takes nothing returns nothing
    call SetPlayerTechMaxAllowedSwap('h0P7', 0, GetEnumPlayer())
endfunction

function Trig_DestroyTrain_Actions takes nothing returns nothing
    call RemoveUnit(GetTrainedUnit())
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_TrainArea), function Trig_DestroyTrain_Func002A)
    call CreateDestructableLoc('B01R', GetRectCenter(gg_rct_Region_143), 0.0, 3, 0)

    call CreateDestructableLoc('B01S', GetRectCenter(OffsetRectBJ(gg_rct_Region_143, 0, 200.00)), GetRandomDirectionDeg(), 1, 0)
    call CreateDestructableLoc('B01S', GetRectCenter(OffsetRectBJ(gg_rct_Region_143, 0, - 200.00)), GetRandomDirectionDeg(), 1, 0)
    call CreateDestructableLoc('B01S', GetRectCenter(OffsetRectBJ(gg_rct_Region_143, 650.00, 200.00)), GetRandomDirectionDeg(), 1, 0)
    call CreateDestructableLoc('B01S', GetRectCenter(OffsetRectBJ(gg_rct_Region_143, 650.00, - 200.00)), GetRandomDirectionDeg(), 1, 0)
    
    call CreateDestructableLoc('B01S', GetRectCenter(OffsetRectBJ(gg_rct_Region_143, 1300.00, 200.00)), GetRandomDirectionDeg(), 1, 0)
    call CreateDestructableLoc('B01S', GetRectCenter(OffsetRectBJ(gg_rct_Region_143, 1300.00, - 200.00)), GetRandomDirectionDeg(), 1, 0)
    
    call CreateDestructableLoc('B01R', GetRectCenter(OffsetRectBJ(gg_rct_Region_143, 1300.00, 0.00)), GetRandomDirectionDeg(), 3, 0)
    call RemoveUnit(gg_unit_n003_0149)
    call RemoveUnit(gg_unit_n003_0028)
    call ForForce(udg_AllPlayers, function LimitTrainDestroy)
endfunction

