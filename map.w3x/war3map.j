//===========================================================================
// Trigger: PassiveTalisra
//===========================================================================
function Trig_PassiveTalisra_Conditions takes nothing returns boolean
    return GetUnitAbilityLevel(GetTriggerUnit(), 'B08J') + GetUnitAbilityLevel(GetTriggerUnit(), 'B08K') > 0 and not IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) and GetEventDamage() >= GetUnitState(GetTriggerUnit(), UNIT_STATE_LIFE) //Её бафф
endfunction

function Talisra takes nothing returns boolean
    return GetUnitAbilityLevel(GetFilterUnit(), 'A1OS') > 0 //Абилка
endfunction

function Trig_PassiveTalisra_Actions takes nothing returns nothing
    local group g= CreateGroup()
    local unit u= GetTriggerUnit()
    local unit u2
    local player p= GetOwningPlayer(u)
    local integer pi= GetPlayerId(p)
    call GroupEnumUnitsInRangeCounted(g, GetUnitX(u), GetUnitY(u), 650, Condition(function Talisra), 1)
    set u2=FirstOfGroup(g)

    if GetRandomInt(1, 4) + 0.25 * GetUnitAbilityLevel(u2, 'A1OS') > 3 and GetUnitState(u2, UNIT_STATE_MANA) > 50 then //Абилка
        call SetUnitManaBJ(u2, GetUnitState(u2, UNIT_STATE_MANA) - 50)
        if playerCapital[pi] == null then
            call MakeFakeCapital(p)
        endif
        if playerCapital[pi] != null then
            call SetUnitX(u, GetUnitX(playerCapital[pi]))
            call SetUnitY(u, GetUnitY(playerCapital[pi]))
            call SetUnitLifePercentBJ(u, 10)
            call SetUnitLifeBJ(u, GetUnitState(u, UNIT_STATE_LIFE) + GetEventDamage())
            call RemoveEffectTimed(AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl", GetUnitX(u), GetUnitY(u)) , 3)
            call RemoveEffectTimed(AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl", GetUnitX(playerCapital[pi]), GetUnitY(playerCapital[pi])) , 3)
        endif
    endif
    
    call DestroyGroup(g)

    set g=null
    set u=null
    set u2=null
endfunction

//===========================================================================
function InitTrig_PassiveTalisra takes nothing returns nothing
    set gg_trg_PassiveTalisra=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_PassiveTalisra, EVENT_PLAYER_UNIT_DAMAGING)
    call TriggerAddCondition(gg_trg_PassiveTalisra, Condition(function Trig_PassiveTalisra_Conditions))
    call TriggerAddAction(gg_trg_PassiveTalisra, function Trig_PassiveTalisra_Actions)
endfunction


//===========================================================================
// Trigger: IceTrollsStart
//===========================================================================
function IceTrollsStartEach takes nothing returns nothing
    local player p= GetEnumPlayer()
    
    call SetPlayerTechMaxAllowedSwap('n07B', 0, p) // Взыватель душ
    call SetPlayerTechMaxAllowedSwap('R09L', 0, p) // Его грейд
    call SetPlayerTechMaxAllowedSwap('o04T', 0, p) // Голем
    call SetPlayerTechMaxAllowedSwap('R09P', 0, p) // Golem grade
    
    
    call SetPlayerTechMaxAllowedSwap('n05W', 0, p) // Mamont
    call SetPlayerTechMaxAllowedSwap('n05X', 0, p) // Magnatavr
    call SetPlayerTechMaxAllowedSwap('R0I5', 0, p) // Grade
    
    //Loa
    call SetPlayerTechMaxAllowedSwap('n061', 0, p)
    call SetPlayerTechMaxAllowedSwap('n062', 0, p)
    call SetPlayerTechMaxAllowedSwap('o05B', 0, p)
    
    //Loa poglosenie
    call SetPlayerTechMaxAllowedSwap('R0AI', 0, p)
    call SetPlayerTechMaxAllowedSwap('R0AJ', 0, p)
    call SetPlayerTechMaxAllowedSwap('R0AD', 0, p)
    
     
    //Loa altars
    call SetPlayerTechMaxAllowedSwap('o06J', 0, p)
    call SetPlayerTechMaxAllowedSwap('o06K', 0, p)
    call SetPlayerTechMaxAllowedSwap('o06I', 0, p)
    
    call SetPlayerTechMaxAllowedSwap('O06L', 1, p) // Malakk

endfunction

function Trig_IceTrollsStart_Actions takes nothing returns nothing
    call ForForce(udg_AllPlayers, function IceTrollsStartEach)
endfunction

