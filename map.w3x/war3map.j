        return false
    endif
    if ( not ( GetUnitTypeId(GetSpellTargetUnit()) == 'u019' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lord_Func001C takes nothing returns boolean
    if ( not Trig_Lord_Func001Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Lord_Actions takes nothing returns nothing
    if ( Trig_Lord_Func001C() ) then
        call ReplaceUnitBJ(GetSpellTargetUnit(), 'lorE', bj_UNIT_STATE_METHOD_DEFAULTS)
        call UnitApplyTimedLifeBJ(60.00, 'BTLF', GetLastReplacedUnitBJ())
    else
        if ( Trig_Lord_Func001Func001C() ) then
            call ReplaceUnitBJ(GetSpellTargetUnit(), 'lorE', bj_UNIT_STATE_METHOD_DEFAULTS)
            call UnitApplyTimedLifeBJ(60.00, 'BTLF', GetLastReplacedUnitBJ())
        else
            call DoNothing()
        endif
    endif
endfunction

