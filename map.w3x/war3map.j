//===========================================================================
// Trigger: PerebobArmy Uni
//===========================================================================

// Перебор игроков
function PlayerArmy takes nothing returns nothing
    set gInt=CountPlayersInForceBJ(udg_BotsActive)
    if gInt == 0 then
        call PauseTimer(udg_PlayerGet1)
        call ResumeTimer(udg_TimerSmall2)
        call TimerStart(udg_TimerSmall2, 3 * AiRepeat / 5, false, null)
        if udg_Octhet then
            call DisplayTimedTextFromPlayer(Player(0), 0, 0, 4, "Заканчиваю перебор игроков для армии")
        endif

    else
            //Каждый отдельный игро
        set gPlayer=ForcePickRandomPlayer(udg_BotsActive)

        call ForceRemovePlayer(udg_BotsActive, gPlayer)

        set LazyCount=0
        if gAllyGroup == null then
            set gAllyGroup=CreateGroup()
        endif
        call GroupEnumUnitsOfPlayer(gAllyGroup, gPlayer, B_Lazy)
        
        if FirstOfGroup(gAllyGroup) != null then
            set udg_LocalInteger=1
            
            loop
                exitwhen udg_LocalInteger > AiMass or FirstOfGroup(gAllyGroup) == null

                //set udg_LocalUnit2 = GroupPickRandomUnit(gAllyGroup)
                
                set udg_LocalUnit2=BlzGroupUnitAt(gAllyGroup, GetRandomInt(0, LazyCount))
                               
                call GroupRemoveUnit(gAllyGroup, udg_LocalUnit2)
                set LazyCount=LazyCount - 1
                // Дровосеки
                if GetUnitTypeId(udg_LocalUnit2) == 'h03C' then
                    if Random(1 , 2) then
                        call IssueImmediateOrder(udg_LocalUnit2, "autoharvestlumber")
                    else
                        call ExecuteFunc("TryAttack")
                    endif
                else
                    call ExecuteFunc("TryAttack")
                endif
                
                set udg_LocalInteger=udg_LocalInteger + 1
            endloop

        endif
    endif
    
    
endfunction
//===========================================================================
function InitTrig_PerebobArmy_Uni takes nothing returns nothing
    set gg_trg_PerebobArmy_Uni=CreateTrigger()
    call DisableTrigger(gg_trg_PerebobArmy_Uni)
    call TriggerRegisterTimerExpireEvent(gg_trg_PerebobArmy_Uni, udg_PlayerGet1)
    call TriggerAddAction(gg_trg_PerebobArmy_Uni, function PlayerArmy)
endfunction


