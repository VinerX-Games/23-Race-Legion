//*  AllPlayersStart
function AllPlayersStart takes nothing returns nothing
    set gInt=0
    
    
    loop
        exitwhen gInt >= 23
        
        if GetPlayerSlotState(Player(gInt)) == PLAYER_SLOT_STATE_PLAYING then
            call ForceAddPlayer(udg_AllPlayers, Player(gInt))
            call ForceAddPlayer(udg_AllPlayers2, Player(gInt))
        endif
        

        set gInt=gInt + 1
    endloop


endfunction


function aiStart takes nothing returns nothing
    set gInt=0
    loop
        exitwhen gInt >= 23
        if GetPlayerController(Player(gInt)) == MAP_CONTROL_COMPUTER then
            call createAiPlayer(gInt)
        endif
        set gInt=gInt + 1
    endloop
endfunction
