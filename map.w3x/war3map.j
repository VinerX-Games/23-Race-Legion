    call SetUnitAbilityLevelSwapped('A0AW', GetEnumUnit(), GetPlayerTechCountSimple('R04O', GetOwningPlayer(GetEnumUnit())))
    call SetUnitAbilityLevelSwapped('A0AV', GetEnumUnit(), GetPlayerTechCountSimple('R04O', GetOwningPlayer(GetEnumUnit())))
