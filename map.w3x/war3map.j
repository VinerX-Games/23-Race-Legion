//===========================================================================
// Trigger: Player2VassalTo1 Back Copy
//===========================================================================
function Trig_Player2VassalTo1_Back_Copy_Conditions takes nothing returns boolean
    if ( not ( S2I(SubStringBJ(GetEventPlayerChatString(), 4, 5)) >= 1 ) ) then
        return false
    endif
    if ( not ( S2I(SubStringBJ(GetEventPlayerChatString(), 4, 5)) <= 24 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Player2VassalTo1_Back_Copy_Actions takes nothing returns nothing
    set udg_LocalInteger=S2I(SubStringBJ(GetEventPlayerChatString(), 4, 5))
    call SetPlayerAllianceStateBJ(ConvertedPlayer(udg_LocalInteger), Player(0), bj_ALLIANCE_UNALLIED)
endfunction

