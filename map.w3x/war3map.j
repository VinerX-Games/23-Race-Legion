    call SetPlayerTechResearchedSwap('R04O', 1, GetEnumPlayer())
    call SetPlayerAbilityAvailableBJ(false, 'A0AT', GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('H0BD', 1, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('N018', 1, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('N01A', 1, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('N019', 1, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('Nalc', 1, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('Ntin', 1, GetEnumPlayer())
    
    call SetPlayerTechMaxAllowedSwap('Gmex', 1, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('Galh', 1, GetEnumPlayer())
    
    
    call SetPlayerTechMaxAllowedSwap('h06L', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('h06N', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('h06Q', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('h06O', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('h078', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('h06M', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('h06P', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('h06U', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('h06Y', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('h06S', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('h06T', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('o00W', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('o00Y', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('o00X', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('h06R', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('h06V', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('h06W', 0, GetEnumPlayer())
endfunction

function goblinsStartLimits takes nothing returns nothing
    call ForForce(bj_FORCE_ALL_PLAYERS, function goblinsStartLimits_act)
    call ForForce(udg_Bots, function goblinsStartLimits_act)
endfunction


