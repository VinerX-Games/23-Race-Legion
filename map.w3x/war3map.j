//*  AttackedGoblins
function AttackedGoblins takes unit u returns nothing

endfunction
//***************************************************************************
//*  StrategGoblins
function Strateg_Goblins_EC takes integer id returns nothing
    //Это ферма
    if id == 'h077' then
        set udg_LocalInteger3=udg_LocalInteger3 + 1
    //Это Т1
    elseif id == 'h070' then
        set udg_LocalInteger3=udg_LocalInteger3 + 4
    endif
endfunction

function Strateg_Goblins takes integer i,integer pi,player p returns nothing

        if Grades[pi] < 150 then
            if i > 17 then

                // Лаборатория
                call MakeGradeCheckCap(p , 'h076' , 'R04P' , 6)
                call MakeGradeCheckCap(p , 'h076' , 'R04E' , 6)
                call MakeGradeCheckCap(p , 'h076' , 'R04F' , 6)
                call MakeGradeCheckCap(p , 'h076' , 'R04G' , 6)
                call MakeGradeCheckCap(p , 'h076' , 'R04H' , 6)
                call MakeGradeCheckCap(p , 'h076' , 'R04I' , 6)
                call MakeGradeCheckCap(p , 'h076' , 'R04J' , 6)
                call MakeGradeCheckCap(p , 'h076' , 'R04K' , 6)
                call MakeGradeCheckCap(p , 'h076' , 'R04L' , 6)
                call MakeGradeCheckCap(p , 'h076' , 'R04M' , 6)

                // Бюро
                call MakeGradeCheckCap(p , 'h079' , 'R056' , 6)
                call MakeGradeCheckCap(p , 'h079' , 'R07A' , 6)
                call MakeGradeCheckCap(p , 'h079' , 'R05X' , 6)
                call MakeGradeCheckCap(p , 'h079' , 'R05Y' , 6)
                call MakeGradeCheckCap(p , 'h079' , 'R04N' , 6)
                call MakeGradeCheckCap(p , 'h079' , 'R04Q' , 6)
                call MakeGradeCheckCap(p , 'h079' , 'R04R' , 6)
                call MakeGradeCheckCap(p , 'h079' , 'R053' , 6)
                call MakeGradeCheckCap(p , 'h079' , 'R05W' , 6)

                // База
                call MakeGradeCheckCap(p , 'h070' , 'R0D4' , 6)
                
                //Покупка предмета
                if GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD) > 2000 then
                    call TryBuy(p , i)
                endif
            endif

        else
            call warRace(Grades[pi] , p)

        endif

        //Спавн мага тп
        if i > 60 and LoadInteger(AiData, pi, 'h07A') < i / 35 then
            call MakeMageTp(pi)
        endif

endfunction
//***************************************************************************
//*  BuildGoblins
function ChooseBuildings_Goblins takes integer pi returns integer
    // Инициализируем массив и добавляем стартовый вариант
    set tArray[0]=1
    set tArray[1]='h077' // 1 Банк

    // Добавляем здания по условиям
    call CheckAndAddBuilding(pi , 'h070' , 4 , 5) // Штаб
    call CheckAndAddBuilding(pi , 'h077' , 20 , 3) // Доп. банки на старте
    call CheckAndAddBuilding(pi , 'h073' , 18 , 7) // Казарма
    call CheckAndAddBuilding(pi , 'h07S' , 30 , 1) // Турель
    call CheckAndAddBuilding(pi , 'h079' , 5 , 3) // Бюро
    call CheckAndAddBuilding(pi , 'h076' , 18 , 4) // Ларабаратория
    call CheckAndAddBuilding(pi , 'o016' , 3 , 8) // Алтарь
    if Grades[pi] > 8 then //R04P,R04E,R04F,R04G,R04H,R04I,R04J,R04K,R04L,R04M
        call CheckAndAddBuilding(pi , 'h074' , 15 , 2) // Завод
        call CheckAndAddBuilding(pi , 'h075' , 15 , 2) // Фабрика
    endif


    // Выбираем случайный вариант из массива
    set gInt=GetRandomInt(1, tArray[0])
    return tArray[gInt]
endfunction
//***************************************************************************
//*  BuildingsGoblins
function PereborBuildings_Goblins takes integer id,integer pi,unit u returns nothing
    set tArray[0]=0 // Очистка массива перед выбором
    // Казармы h06K h06O,h06Q,h06L,h06N,,h078,h06M
    if id == 'h073' then
        if Random(1 , 6) then
            call IssueNeutralImmediateOrderById(Player(pi), u, 'h07R')
        else

            // Добавление юнитов
            call AddUnit('h06K' , 2) // Рекрут
            if Grades[pi] > 8 then
                call AddUnit('h060' , 1) // 
                call AddUnit('h06Q' , 3) // 
                call AddUnit('h06L' , 3) // 
                call AddUnit('h06N' , 3) // 
                call AddUnit('h078' , 3) // 
                call AddUnit('h06M' , 3) // 
            endif

        endif

    // Штаб
    elseif id == 'h070' then
        call CheckAndAddUnit(pi , 'n00V' , 25 , 2)
    // Завод
    elseif id == 'h074' then // h06S,h06U,h06Y,h06R,h06T
        call AddUnit('h06S' , 2) // Базовый юнит завода
        call AddUnit('h06U' , 2) // 
        call AddUnit('h06Y' , 4) // 
        call AddUnit('h06R' , 3) // 
        call AddUnit('h06T' , 3) // 

    // Фабрика o00W,o00Y,o00X,h06P
    elseif id == 'h075' then
        call AddUnit('o00W' , 2) // 
        call AddUnit('o00Y' , 2) // 
        call AddUnit('o00X' , 3) // 
        call AddUnit('h06P' , 3) // 
    // Алтарь  H0BD,Galh,Gmex
    elseif id == 'o016' then
        call CheckAndAddUnit(pi , 'H0BD' , 1 , 1)
        call CheckAndAddUnit(pi , 'Galh' , 1 , 1)
        call CheckAndAddUnit(pi , 'Gmex' , 1 , 1)
    endif
    call aiOrderUnit(u)
endfunction

function aiNavalTrain_Goblins takes unit u,integer pi returns nothing
    set udg_LocalInteger3=GetRandomInt(1, 5)
   
    if udg_LocalInteger3 == 1 then
        call IssueImmediateOrderById(u, 'h06X')
    elseif udg_LocalInteger3 == 2 then
        call IssueImmediateOrderById(u, 'h06U')
    elseif udg_LocalInteger3 == 3 then
        call IssueImmediateOrderById(u, 'h06V')
    elseif udg_LocalInteger3 == 4 then
        call IssueImmediateOrderById(u, 'h06W')
    elseif udg_LocalInteger3 == 5 and LoadInteger(AiData, pi, 'h0OD') < 1 then
        call IssueImmediateOrderById(u, 'h0OD')
    endif
endfunction
                
                
                
