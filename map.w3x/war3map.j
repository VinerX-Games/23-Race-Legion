function Trig_sek5_Func001A takes nothing returns nothing

    local player pe= GetEnumPlayer()

    local integer i= 0
	//Герои Специализации
    call SetPlayerTechMaxAllowed(pe, 'n026', i) //кровавый палач
    call SetPlayerTechMaxAllowed(pe, 'H0H8', i) //паладин лечение альянс
    call SetPlayerTechMaxAllowed(pe, 'H0H9', i) //паладин защита альянс
