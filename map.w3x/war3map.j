endfunction

//===========================================================================
// Trigger: ArcanaBuild
//===========================================================================
function Trig_ArcanaBuild_Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetConstructedStructure()) == 'h04F' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R01D', GetOwningPlayer(GetTriggerUnit())) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ArcanaBuild_Conditions takes nothing returns boolean
    if ( not Trig_ArcanaBuild_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_ArcanaBuild_Actions takes nothing returns nothing
    call BlzSetUnitName(GetTriggerUnit(), "|cff8080ffКолодец арканы|r")
endfunction

