//===========================================================================
// Trigger: ItsFineOrNot
//===========================================================================
function AllowedPosition takes unit u returns boolean
    local real x= GetUnitX(u)
    local real y= GetUnitY(u)
    
    if udg_Continents[1] == 1 and ( RectContainsCoords(gg_rct_EastenKingdoms, x, y) or RectContainsCoords(gg_rct_BlackMountain, x, y) or RectContainsCoords(gg_rct_EasternDungeons, x, y) ) then
        return true
    endif
    if udg_Continents[2] == 1 and ( RectContainsCoords(gg_rct_Kalim, x, y) or RectContainsCoords(gg_rct_Ankirag, x, y) and RectContainsCoords(gg_rct_Maradon, x, y) and RectContainsCoords(gg_rct_Orgrimmar, x, y) ) then
        return true
    endif
    if udg_Continents[3] == 1 and ( RectContainsCoords(gg_rct_Outland, x, y) ) then
        return true
    endif
    if udg_Continents[4] == 1 and ( RectContainsCoords(gg_rct_Nord, x, y) or RectContainsCoords(gg_rct_Azgel, x, y) ) then
        return true
    endif
    if udg_Continents[5] == 1 and ( RectContainsCoords(gg_rct_Pandaria, x, y) ) then
        return true
    endif
    if udg_Continents[6] == 1 and ( RectContainsCoords(gg_rct_Argus, x, y) ) then
        return true
    endif
    if udg_Continents[7] == 1 and RectContainsCoords(gg_rct_BrokenIsles, x, y) then
        return true
    endif
    if RectContainsCoords(gg_rct_EmeraldDream, x, y) then
        return true
    endif
    return false
endfunction


function KillIf takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer id= GetHandleId(t)
    local unit u= LoadUnitHandle(Hash, id, 0)
    //local integer uid = StringHash( I2S(GetHandleId(u))+"k")
    local integer time= LoadInteger(Hash, id, 1)
    local effect e= LoadEffectHandle(Hash, id, 2)
    
    
    if time > 0 then
        if GetUnitAbilityLevel(u, 'A0U6') == 0 or AllowedPosition(u) then
            call UnitRemoveAbility(u, 'A0U6')
            call UnitRemoveAbility(u, 'B05M')
            call DestroyEffect(e)
            call DestroyTimer(t)
            call FlushChildHashtable(Hash, id)
        
        else
            set time=time - 2
            call SaveInteger(Hash, id, 1, time)
        
        endif
        
        
        
    
    
    else
        call KillUnit(u)
        call DestroyEffect(e)
        call DestroyTimer(t)
        call FlushChildHashtable(Hash, id)
        
    endif
    
    set t=null
    set u=null
    set e=null
endfunction


function Continents takes unit u returns nothing
    local timer t= CreateTimer()
    local integer id= GetHandleId(t)
    
    //local integer uid = StringHash( I2S(GetHandleId(u))+"k")
    local effect e
    if AllowedPosition(u) then
        if GetUnitAbilityLevel(u, 'A0U6') > 0 then
            call UnitRemoveAbility(u, 'A0U6')
            call UnitRemoveAbility(u, 'B05M')
        endif
        
        
    else
        if IsUnitType(u, UNIT_TYPE_STRUCTURE) then
            call ExplodeUnitBJ(u)
            
        elseif GetUnitTypeId(u) == 'H049' then
            
            
        else
            if GetUnitAbilityLevel(u, 'A0U6') > 0 then
                call SetUnitPosition(u, 0, 0)
                call DisplayTextToPlayer(GetOwningPlayer(u), 0, 0, "Ваш круг телепортирован в цент карты")
                
                
                //call SaveInteger(Hash,id,1,30)
                
            else
                call UnitAddAbility(u, 'A0U6')
                set e=AddSpecialEffectTarget("Abilities\\Spells\\Other\\TalkToMe\\TalkToMe", u, "overhead")
                //call TriggerExecute( gg_trg_GoHome_No_fine )
                
                
                call TimerStart(t, 2, true, function KillIf)
                //call SaveTimerHandle(Hash,uid,0,t)
                call SaveUnitHandle(Hash, id, 0, u)
                call SaveInteger(Hash, id, 1, 30)
                call SaveEffectHandle(Hash, id, 2, e)
            endif
            
        endif
    endif
    
    set t=null
    set u=null
    set e=null
endfunction



