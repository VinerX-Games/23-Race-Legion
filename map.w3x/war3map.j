//===========================================================================
function Trig_Revive_Conditions takes nothing returns boolean
    set gUnit=GetRevivableUnit()
    set gPi=GetPlayerId(GetOwningPlayer(gUnit))
    return udg_AiControl[gPi]
endfunction

function Trig_Revive_Actions takes nothing returns nothing
    local unit u= gUnit
    //call ReviveHeroTimed(gUnit,GetUnitLevel(gUnit)*7)
    call TriggerSleepAction(GetUnitLevel(gUnit) * 7)
    call GroupEnumUnitsOfPlayer(gGroup, GetOwningPlayer(u), Altars)
    if FirstOfGroup(gGroup) != null then
        set gUnit2=GroupPickRandomUnit2(gGroup)
        call ReviveHero(u, GetUnitX(gUnit2), GetUnitY(gUnit2), true)
    endif
    

endfunction

