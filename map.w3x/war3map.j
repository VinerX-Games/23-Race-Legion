function Trig_TechT2_Actions takes nothing returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local player p= GetOwningPlayer(GetTriggerUnit())
    local location l= GetUnitRallyPoint(GetTriggerUnit())
    local unit u
    local integer pi= GetPlayerId(p)
    
    
    //1 юнит
    set a[0]=0
    
    //blood elves arcane guard
    if GetPlayerTechCount(p, 'R0D2', true) == 1 and GetPlayerTechCount(p, 'R0E9', true) != 1 then
        set i=1
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='o026'
            
            set b=b + 1
            exitwhen b >= i
        endloop

    endif
    //Goblins golem
    if GetPlayerTechCount(p, 'R0E4', true) == 1 then
        set i=1
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='o028'
            
            set b=b + 1
            exitwhen b >= i
        endloop

    endif
    

    
    set i=GetRandomInt(1, a[0])
    set b=a[i]
    
    call aiFixTrainBefore(GetTrainedUnit() , pi)
    set u=ReplaceUnit(GetTrainedUnit() , b , bj_UNIT_STATE_METHOD_RELATIVE)
    call aiFixTrainAfter(u , pi)
//
//    call UnitAddAbility(u,'A0UZ')
//    call SetUnitAbilityLevel(u,'A0UZ',35+udg_HordeTechPrice[pi])
//
     
    call UnitAddAbility(u, 'A0YU')


        call IssuePointOrderLoc(u, "attack", l)

    call RemoveLocation(l)
endfunction

