//===========================================================================
// Trigger: AiLogAll
//===========================================================================
function Trig_AiLogAll_Conditions takes nothing returns boolean
    return S2I(SubStringBJ(GetEventPlayerChatString(), 6, 8)) >= 1 and S2I(SubStringBJ(GetEventPlayerChatString(), 6, 8)) <= 24
endfunction

function aiNameGroup takes nothing returns nothing
    set gString=gString + " " + I2S(Counter) + "." + GetUnitName(GetEnumUnit())
    set Counter=Counter + 1
    if ModuloInteger(Counter, 28) == 0 then
        call BJDebugMsg(I2S(Counter) + " " + gString)
        set gString=""
    endif
endfunction


function Trig_AiLogAll_Actions takes nothing returns nothing
    set gPi=S2I(SubStringBJ(GetEventPlayerChatString(), 6, 8)) - 1
    set gPlayer=Player(gPi)
    //call ForGroup(gGroup,function )
    call BJDebugMsg("Бот: " + GetPlayerName(gPlayer))
    call BJDebugMsg("Блок хешей --- ")
    call BJDebugMsg("Number:" + I2S((LoadInteger(AiData, (gPi ), ( StringHash("Number")))))) // INLINED!!
    call BJDebugMsg("NumberN:" + I2S((LoadInteger(AiData, (gPi ), ( StringHash("NumberN")))))) // INLINED!!
    call BJDebugMsg("NumberPorts:" + I2S((LoadInteger(AiData, (gPi ), ( StringHash("NumberPorts")))))) // INLINED!!
    call BJDebugMsg("NumberGuard:" + I2S((LoadInteger(AiData, (gPi ), ( StringHash("NumberGuard")))))) // INLINED!!
    call BJDebugMsg("T:" + I2S((LoadInteger(AiData, (gPi ), ( StringHash("T")))))) // INLINED!!
    call BJDebugMsg("HV:" + I2S((LoadInteger(AiData, (gPi ), ( StringHash("HV")))))) // INLINED!!
    call BJDebugMsg("Де факто в группах")
    
    set gString="Group udg_Ai_army[pi] ------"
    set Counter=0
    call ForGroup(udg_Ai_army[gPi], function aiNameGroup)
    call BJDebugMsg(I2S(Counter) + " " + gString)
    
    set gString="Group udg_Ai_navy[pi] ------"
    set Counter=0
    call ForGroup(udg_Ai_navy[gPi], function aiNameGroup)
    call BJDebugMsg(I2S(Counter) + " " + gString)
    
    set gString="Group AiCapitalGuard[pi]"
    set Counter=0
    call ForGroup(AiCapitalGuard[gPi], function aiNameGroup)
    call BJDebugMsg(I2S(Counter) + " " + gString)
    
    set gString="Group udg_Ai_builders[pi]"
        set Counter=0
    call ForGroup(udg_Ai_builders[gPi], function aiNameGroup)
    call BJDebugMsg(I2S(Counter) + " " + gString)
    
    set gString="Group udg_Ai_buildersT[pi] "
    set Counter=0
    call ForGroup(udg_Ai_buildersT[gPi], function aiNameGroup)
    call BJDebugMsg(I2S(Counter) + " " + gString)
    
    set gString="Group udg_Ai_harvest[pi]"
    set Counter=0
    call ForGroup(udg_Ai_harvest[gPi], function aiNameGroup)
    call BJDebugMsg(I2S(Counter) + " " + gString)
    
    set gString="Group udg_Ai_buildings[pi] ------"
    set Counter=0
    call ForGroup(udg_Ai_buildings[gPi], function aiNameGroup)
    call BJDebugMsg(I2S(Counter) + " " + gString)

    if gGroup == null then
        call BJDebugMsg("gGroup сломана")
    endif
    if gSubGroup == null then
        call BJDebugMsg("gSubGroup сломана")
    endif
    if gAllyGroup == null then
        call BJDebugMsg("gAllyGroup сломана")
    endif
    
    //call BJDebugMsg("Т1 "+I2S(getAiCount(gPi,'ogre')))
    //call BJDebugMsg("Т2 "+I2S(getAiCount(gPi,'ostr')))
    //call BJDebugMsg("T3 "+I2S(getAiCount(gPi,'ofrt')))
    
endfunction

