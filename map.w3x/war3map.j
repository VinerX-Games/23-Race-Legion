//*  PortToAction
function ChoseRandomSpot takes unit dest,integer pi,real x,real y returns unit
    set Counter=0
    set CheckPlayer=Player(pi)
    call GroupEnumUnitsInRange(gGroup, x, y, 3200, b_OwnBuldingsInRange)
    return BlzGroupUnitAt(gGroup, GetRandomInt(0, Counter))
endfunction

// Создает мага тп и делат теп по позиции выбранного юнита
function MakeTPMage takes unit dest,unit u2,integer pi returns nothing
    set gX=GetUnitX(dest)
    set gY=GetUnitY(dest)
    if LoadInteger(AiData, pi, gMageTP) < 10 and GetUnitAbilityLevel(dest, 'A1RD') == 0 then
        set gUnit3=ChoseRandomSpot(dest , pi , gX , gY)
        if gUnit3 != null then
            set gX=GetUnitX(gUnit3)
            set gY=GetUnitY(gUnit3)
        else
            set gUnit=CreateUnit(Player(pi), 'h07A', gX, gY, 0)
        endif
        call RemoveEffectTimed(AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl", gX, gY) , 3)
        call IssuePointOrder(gUnit, "darksummoning", GetUnitX(u2), GetUnitY(u2))
        call GroupAddUnit(udg_Ai_army[pi], gUnit)
        call GroupAddUnit(AiUnitsToPort[pi], gUnit)
        call NumberAdd(pi , gMageTP)
        call AddAbilityTimed(dest , 'A1RD' , 8)
    endif
 
endfunction



// Выбирает юнита которого можно тепнуть к выбранному юниту
function PortTo takes unit u returns nothing

    set gPlayer=GetOwningPlayer(u)
    set gPi=GetPlayerId(gPlayer)

    set LazyCount=0
    call GroupEnumUnitsOfPlayer(gGroup, gPlayer, B_Lazy)
    set gUnit2=BlzGroupUnitAt(gGroup, GetRandomInt(0, LazyCount))

    // Точка
    if IsUnitInGroup(u, udg_ZahvatBuildings) then
        call UnitAddAbility(u, 'A0Y4')
        call IssuePointOrder(u, "darksummoning", GetUnitX(gUnit2), GetUnitY(gUnit2))
        
        // Дополнительно маг тп
        if Random(1 , 4) then
            call MakeTPMage(u , gUnit2 , gPi)
        endif
    // Маг тп 
    elseif GetUnitTypeId(u) == gMageTP then
        call IssuePointOrder(u, "darksummoning", GetUnitX(gUnit2), GetUnitY(gUnit2))
    else
    
        call MakeTPMage(u , gUnit2 , gPi)
    endif
 
endfunction



// Выбирает юнита которого можно тепнуть к выбранному юниту
function PortToFast takes unit u returns nothing

    set gPlayer=GetOwningPlayer(u)
    set gPi=GetPlayerId(gPlayer)

    set LazyCount=0
    call GroupEnumUnitsOfPlayer(gGroup, gPlayer, B_InAiArmy)
    set gUnit2=BlzGroupUnitAt(gGroup, GetRandomInt(0, LazyCount))

    // Точка
    if IsUnitInGroup(gAttacked, udg_ZahvatBuildings) then
        call UnitAddAbility(u, 'A0Y4')
        call IssuePointOrder(u, "darksummoning", GetUnitX(gUnit2), GetUnitY(gUnit2))
        
        // Дополнительно маг тп
        if Random(1 , 4) then
            call MakeTPMage(u , gUnit2 , gPi)
        endif
    // Здание
    else
        call MakeTPMage(u , gUnit2 , gPi)
    endif
 
endfunction
//***************************************************************************
//*  WakPortToAction

// Выбирает юнита которого можно тепнуть к выбранному юниту
function WalkPortTo takes unit u returns nothing
    call PortTo(u)
endfunction
//***************************************************************************
//*  TryPort

// Выбирает юнитов к которым можно тепнуться и делает к ним теп
function TryPort takes nothing returns nothing
    local integer pi= TryPort_pi
    local unit u

    set u=GroupPickRandomUnit2(AiUnitsToPort[pi])
    if u != null then
        set CheckPlayer=Player(pi)
        if HasEnemyNear(u) != null then
            call PortTo(u)
        endif
    endif
   
    set u=null

endfunction
//***************************************************************************
//*  RequestPort


// Выбирает юнитов к которым можно тепнуться и делает к ним теп
function RequestPort takes unit u returns nothing
    set gPlayer=GetOwningPlayer(u)
    set gPi=GetPlayerId(gPlayer)
    set gInt=0
    loop
        exitwhen gInt > 3
        
        set u=GroupPickRandomUnit2(AiUnitsToPort[gPi])
        if u != null then
            set CheckPlayer=gPlayer
            if HasEnemyNear(u) != null then
                call PortTo(u)
            endif
            exitwhen true
        endif
        set gInt=gInt + 1
    
    endloop

endfunction


