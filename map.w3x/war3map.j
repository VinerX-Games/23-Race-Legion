function startNaga takes integer pi returns nothing
        //Старт юниты
        call CreateNUnitsAtLoc(8, 'nmpe', Player(pi), udg_LocalPoint, bj_UNIT_FACING)
        call GroupAddGroup(GetLastCreatedGroup(), udg_Ai_units[pi])
        call GroupAddGroup(GetLastCreatedGroup(), udg_Ai_builders[pi])
        call CreateNUnitsAtLoc(1, 'nntt', Player(pi), udg_LocalPoint, bj_UNIT_FACING)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Ai_units[pi])
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Ai_buildings[pi])

        call SaveInteger(AiData, pi, 'nmpe', 8)
        call SaveInteger(AiData, pi, 'nntt', 1)
        call SetPlayerName(Player(pi), "Стая (" + I2S(pi + 1) + ")")
        call SaveStr(AiData, pi, StringHash("Race"), "NG")
        call TriggerExecute(gg_trg_NagaStart)
        
        set AiRace[pi]="Naga"
endfunction
