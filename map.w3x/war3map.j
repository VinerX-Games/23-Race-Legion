                    call IssueImmediateOrderById(u, 'H045')
                endif
        
            
        endif
                
                
endfunction
                
                
                
                
                
                
//***************************************************************************
//*  MakeGrade


function ThisType takes nothing returns boolean
    return GetUnitTypeId(GetFilterUnit()) == udg_LocalInteger5
endfunction

function MakeGrade takes player gamer,integer GradeUnit,integer Grade returns nothing
    local group g= CreateGroup()
    local player p= gamer
    local integer pi= GetPlayerId(p)
    local unit u= null
    local boolexpr b= null

    
    set udg_LocalInteger5=GradeUnit
    set b=Condition(function ThisType)
    call GroupEnumUnitsOfPlayer(g, p, b)
    set u=GroupPickRandomUnit(g)
    if u != null then
        call IssueImmediateOrderById(u, Grade)
    endif
    
    call DestroyBoolExpr(b)
    call DestroyGroup(g)
    set b=null
    set g=null
    set p=null
    set u=null
endfunction
//***************************************************************************
//*  BuildT
function TType takes nothing returns nothing

    
    if GetUnitTypeId(GetEnumUnit()) == udg_LocalInteger5 then
        call GroupAddUnit(udg_LocalOtrad, GetEnumUnit())
    endif
    
endfunction



function BuildT takes player x,integer before,integer after returns nothing
    local group g= CreateGroup()
    local player p= x
    local unit u= null
    
    
    
    call GroupClear(udg_LocalOtrad)
    call GroupEnumUnitsOfPlayer(g, p, null)
    set udg_LocalInteger5=before
    call ForGroup(g, function TType)
    call DestroyGroup(g)
    
    
    set g=udg_LocalOtrad
    set u=GroupPickRandomUnit(g)

    call IssueImmediateOrderById(u, after)
    
    //Зачистка
    call DestroyGroup(g)
    set udg_LocalOtrad=CreateGroup()
    set g=null
    set p=null
    set u=null
endfunction


//***************************************************************************
//*  StrategScarlet
function Strateg_Scarlet takes integer i,integer pi,player p returns nothing
        local integer r=0
        
        
        if Grades[pi] < 100 then
            if i > 17 then

                // Кузница
                call MakeGrade(p , 'h060' , 'R04B')
                call MakeGrade(p , 'h060' , 'R04A')
                call MakeGrade(p , 'h060' , 'R049')
                call MakeGrade(p , 'h060' , 'R048')
                call MakeGrade(p , 'h060' , 'R04C')
                
                // Лесопилка
                call MakeGrade(p , 'h062' , 'RHac')
                call MakeGrade(p , 'h062' , 'Rhlh')
                
                //Казармы
                call MakeGrade(p , 'h05Z' , 'R03K')
                
                //Покупка предмета
                if GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD) > 2000 then
                    call TryBuy(p)
                endif
            endif

            


            if i > 35 and ( LoadInteger(AiData, pi, 'h05V') + LoadInteger(AiData, pi, 'h05W') >= 1 ) then

                // Казармы
                call MakeGrade(p , 'h05Z' , 'R03W')
                call MakeGrade(p , 'h05Z' , 'R03V')
                
                call MakeGrade(p , 'h05Z' , 'R03L')
                call MakeGrade(p , 'h05Z' , 'R03M')
                
                // Храм
                call MakeGrade(p , 'h061' , 'R03Y')
                call MakeGrade(p , 'h061' , 'R03X')
                
                //Мастерская
                set r=GetRandomInt(1, 2)
                if r == 1 then
                    call MakeGrade(p , 'h064' , 'R03T')
                else
                    call MakeGrade(p , 'h064' , 'R03S')
                endif
                call MakeGrade(p , 'h064' , 'R047')
                call MakeGrade(p , 'h064' , 'R046')
                call MakeGrade(p , 'h064' , 'R045')
                call MakeGrade(p , 'h064' , 'R03U')
            endif

               
            if i > 45 then
                call MakeGrade(p , 'h011' , 'R005')
                call MakeGrade(p , 'h011' , 'R006')
                call MakeGrade(p , 'h011' , 'R007')
                call MakeGrade(p , 'h011' , 'R002')
                call MakeGrade(p , 'h011' , 'R003')
            endif
        endif

        //Делай т2
        if i > 25 and LoadInteger(AiData, pi, 'h05V') < 3 then
            call BuildT(p , 'h05U' , 'h05V')
        endif
        
        //Делай т3
        if i > 55 and LoadInteger(AiData, pi, 'h05W') < 3 then
            call BuildT(p , 'h05V' , 'h05W')
        endif

        //Спавн мага тп
        if i > 60 and LoadInteger(AiData, pi, 'h07A') < i / 35 then
            call MakeMageTp(pi)
        endif

        //Выбор Пути Ордена
        if i > 65 and LoadInteger(AiData, pi, 'h05V') >= 1 then
            set r=GetRandomInt(1, 2)
            if r == 1 then
                call MakeGrade(p , 'h05W' , 'R040')
                call SaveBoolean(AiData, pi, 'R040', true)
            else
                call MakeGrade(p , 'h05W' , 'R03Z')
                call SaveBoolean(AiData, pi, 'R03Z', true)
            endif
            
            
            // Церковь
            call MakeGrade(p , 'h068' , 'R044')
            call MakeGrade(p , 'h068' , 'R043')
            call MakeGrade(p , 'h068' , 'R042')
            call MakeGrade(p , 'h068' , 'R041')
        endif
        
        
        

    





endfunction
//***************************************************************************
//*  StrategBloodElves
function Strateg_BloodElves takes integer i,integer pi,player p returns nothing
       local integer r=0
       if Grades[pi] < 100 then
           if i > 17 then


                set r=GetRandomInt(1, 3)
                
                if r == 1 then
                // Кузница
                call MakeGrade(p , 'h04R' , 'R01L')
                call MakeGrade(p , 'h04R' , 'R01J')
                call MakeGrade(p , 'h04R' , 'R01K')
                call MakeGrade(p , 'h04R' , 'R01M')
                elseif r == 2 then
                call MakeGrade(p , 'h04R' , 'R01R')
                
                // Лесопилка
                call MakeGrade(p , 'h04Q' , 'R03I')
                call MakeGrade(p , 'h04Q' , 'R03J')
                call MakeGrade(p , 'h04Q' , 'R01N')
                else
                call MakeGrade(p , 'h04Q' , 'R01T')

                call MakeGrade(p , 'h04Q' , 'R03E')
                call MakeGrade(p , 'h04Q' , 'R03F')
                
                //Казармы
                call MakeGrade(p , 'h04D' , 'R03K')
                
                //Покупка предмета
                endif
            endif

            


            if i > 35 and ( LoadInteger(AiData, pi, 'h04B') + LoadInteger(AiData, pi, 'h04A') >= 1 ) then


                 set r=GetRandomInt(1, 2)
                if r == 1 then
                // Казармы
                call MakeGrade(p , 'h04D' , 'R03W')
                call MakeGrade(p , 'h04D' , 'R03V')
                
                call MakeGrade(p , 'h04D' , 'R03L')
                call MakeGrade(p , 'h04D' , 'R03M')
                
                // Здание магов
                call MakeGrade(p , 'h04E' , 'R0BU')
                call MakeGrade(p , 'h04E' , 'R01O')
                
                elseif r == 2 then
                call MakeGrade(p , 'h04E' , 'R01P')
                call MakeGrade(p , 'h04E' , 'R01Q')
                call MakeGrade(p , 'h04E' , 'R01S')

                
                //Мастерская
               
                call MakeGrade(p , 'h04G' , 'R03N')
                call MakeGrade(p , 'h04G' , 'R030')
                else
                call MakeGrade(p , 'h04G' , 'R03P')
                call MakeGrade(p , 'h04G' , 'R03Q')
                call MakeGrade(p , 'h04G' , 'R021')
                call MakeGrade(p , 'h04G' , 'Rhcd')
                endif
                
                
                //Хранилище маны

                set r=GetRandomInt(0, 4)
                if r == 0 then
                    call MakeGrade(p , 'h04F' , 'R03R')
                elseif r == 1 then
                    call MakeGrade(p , 'h04F' , 'R01H')
                elseif r == 2 then
                    call MakeGrade(p , 'h04F' , 'R01I')
                elseif r == 3 then
                    call MakeGrade(p , 'h04F' , 'R01G')
                else
                    call MakeGrade(p , 'h04F' , 'R01D')
                endif
            
            
            

                
                
               
            endif
            

        endif
        
        
        //Купи предмет простой
        if i > 20 and GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD) > 2000 then
            call TryBuy(p)
        endif

        //Делай т2
        if i > 25 and LoadInteger(AiData, pi, 'h04B') < 3 then
            call BuildT(p , 'h04C' , 'h04B')
        endif

        //Делай т3
        if i > 55 and LoadInteger(AiData, pi, 'h04A') < 3 then
            call BuildT(p , 'h04B' , 'h04A')
        endif

        //Спавн мага тп
        if i > 60 and LoadInteger(AiData, pi, 'h07A') < 3 then
            call MakeMageTp(pi)
        endif

        
        
        
endfunction
//***************************************************************************
//*  AttackerScarlet
function Attacker_Skarlet takes integer id,unit u,unit target,player p returns nothing
    local integer i
    local unit u2
    local real x= GetUnitX(target)
    local real y= GetUnitY(target)
    local real x2
    local real y2
    local group g= CreateGroup()
    
    if id == 'H06C' then
        set i=GetRandomInt(1, 5)
            if i == 1 then
                call IssueTargetOrder(u, "firebolt", target)
            elseif i == 2 then
                call IssuePointOrder(u, "flamestrike", x, y)
            elseif i == 2 then
                call IssueImmediateOrder(u, "waterelemental")
            endif
    
    ///Если герой Капиатн
    elseif id == 'H06B' then
        set i=GetRandomInt(1, 5)
            if i == 1 then
                call IssueImmediateOrder(u, "berserk")
            elseif i == 2 then
                call IssueImmediateOrder(u, "thanderclap")
            elseif i == 3 then
                call IssueImmediateOrder(u, "roar")
            endif
    
    
    ///Если герой Паладин
    elseif id == 'H03H' then
        set i=GetRandomInt(1, 5)
            if i == 1 then
                set CheckPlayer=p
                call GroupEnumUnitsInRange(g, x, y, 450, ToHeal)
                set u2=GroupPickRandomUnit(g)
                call IssueTargetOrder(u, "firebolt", u2)
            elseif i == 2 then
                call IssueImmediateOrder(u, "roar")
            elseif i == 2 then
                call IssueImmediateOrder(u, "ressurection")
            endif
    
// ------ Юниты    
    
    ///Монахиня
    elseif id == 'h067' then
        set i=GetRandomInt(1, 4)
            if i == 1 then
                call IssueTargetOrder(u, "flamingarrows", target)
            elseif i == 2 then
                set x2=GetUnitX(u) - GetUnitX(target)
                set y2=GetUnitY(u) - GetUnitY(target)
                if SquareRoot(x2 * x2 + y2 * y2) < 525 then
                    call IssueTargetOrder(u, "devourmagic", target)
                endif
            endif
            
    
    ///Жрец
    elseif id == 'n008' then
        set i=GetRandomInt(1, 4)
            if i == 1 then
                call IssueTargetOrder(u, "flamingarrows", target)
            elseif i == 2 then
                set x2=GetUnitX(u) - GetUnitX(target)
                set y2=GetUnitY(u) - GetUnitY(target)
                if SquareRoot(x2 * x2 + y2 * y2) < 490 then
                    call IssueTargetOrder(u, "dispel", target)
                endif
            endif
    
    ///Гладиатор
    elseif id == 'h03G' then
        set i=GetRandomInt(1, 3)
            if i == 1 then
                call IssueTargetOrder(u, "berserk", target)
            elseif i == 2 then
                call IssuePointOrder(u, "roar", x, y)
            endif
    
    
    elseif id == 'h00Z' or id == 'h00Y' and IsUnitType(target, UNIT_TYPE_STRUCTURE) == false then
        set i=GetRandomInt(1, 6)
            if i == 1 and GetUnitStatePercent(target, UNIT_STATE_LIFE, UNIT_STATE_MAX_LIFE) < GetUnitStatePercent(u, UNIT_STATE_LIFE, UNIT_STATE_MAX_LIFE) then
                set x2=GetUnitX(u) - GetUnitX(target)
                set y2=GetUnitY(u) - GetUnitY(target)
                if SquareRoot(x2 * x2 + y2 * y2) < 125 then
                    call IssueTargetOrder(u, "ancestralspirit", target)
                else
                    //call IssuePointOrder(u, "Move", x,y)
                endif
            elseif i == 2 then
                set x2=GetUnitX(u) - GetUnitX(target)
                set y2=GetUnitY(u) - GetUnitY(target)
                if SquareRoot(x2 * x2 + y2 * y2) < 360 then
                    call IssuePointOrder(u, "clusterrockets", x, y)
                else
                    //call IssuePointOrder(u, "Move", x,y)
                endif
                
                
            elseif i == 3 and GetUnitStatePercent(u, UNIT_STATE_LIFE, UNIT_STATE_MAX_LIFE) < 45 then
                call IssueImmediateOrder(u, "tranquility")
            endif
    endif
    
    call GroupClear(g)
    call DestroyGroup(g)
    set g=null
    set u=null
    set target=null
    set u2=null
endfunction
//***************************************************************************
//*  AttackerBloodElves
function Attacker_BloodElves takes integer id,unit u,unit target,player p returns nothing
    local integer i
    local unit u2
    local real x= GetUnitX(target)
    local real y= GetUnitY(target)
    local real x2
    local real y2
    local group g= CreateGroup()
    
    
    //Чародей
    if id == 'H043' then
        set i=GetRandomInt(1, 6)
            if i == 1 then
                call IssueTargetOrder(u, "banish", target)
            elseif i == 2 then
                call IssueTargetOrder(u, "steal", target)
            elseif i == 3 then
                call IssuePointOrder(u, "flamestrike", x, y)
            elseif i == 4 then
                call IssueImmediateOrder(u, "summonphoenix")
            endif
    
    ///Если герой Ренджер
    elseif id == 'Hjnd' then
        set i=GetRandomInt(1, 3)
            if i == 1 then
                call IssueTargetOrder(u, "shadowstrike", target)
            elseif IsUnitType(target, UNIT_TYPE_HERO) == true then
                call IssueTargetOrder(u, "faeriefire", target)
            endif
    
    
    ///Если герой Паладин
    elseif id == 'H045' then
        set i=GetRandomInt(1, 5)
            if i == 1 then
                call IssueImmediateOrder(u, "roar")
            elseif i == 2 then
                call IssueImmediateOrder(u, "fanofknives")
            elseif i == 3 then
                call IssueImmediateOrder(u, "ressurection")
            endif
    
// ------ Юниты    
    
    ///Всадник
    elseif id == 'H03H' then
        set i=GetRandomInt(1, 4)
            if i == 1 then
                call IssueImmediateOrder(u, "berserk")
            endif
            
    
    ///Магистр
    elseif id == 'n040' then
        set i=GetRandomInt(1, 5)
            if i == 1 then
                call IssueImmediateOrder(u, "frostarmoron")
                call IssueImmediateOrder(u, "curseoff")
            elseif i == 2 then
                call IssueImmediateOrder(u, "frostarmoroff")
                call IssueImmediateOrder(u, "curseon")
            
            elseif i == 3 then
                set x2=GetUnitX(u) - GetUnitX(target)
                set y2=GetUnitY(u) - GetUnitY(target)
                if SquareRoot(x2 * x2 + y2 * y2) < 490 then
                    call IssueTargetOrder(u, "carrionswarm", target)
                endif
            endif
    
    /// Арканистка
    elseif id == 'h041' then
        set i=GetRandomInt(1, 3)
            if i == 1 then
                call IssueTargetOrder(u, "polymorph", target)
            elseif i == 2 then
                set x2=GetUnitX(u) - GetUnitX(target)
                set y2=GetUnitY(u) - GetUnitY(target)
                if SquareRoot(x2 * x2 + y2 * y2) < 490 then
                    call IssueTargetOrder(u, "devourmagic", target)
                endif
            endif
    //Чернокнижник
    elseif id == 'h042' then
        set i=GetRandomInt(1, 6)
            if i == 1 then
                call IssueImmediateOrder(u, "faeriefireoff")
                call IssueImmediateOrder(u, "curseon")
                call IssueImmediateOrder(u, "bloodlustoff")
            elseif i == 2 then
                call IssueImmediateOrder(u, "faeriefireoff")
                call IssueImmediateOrder(u, "curseoff")
                call IssueImmediateOrder(u, "bloodluston")
            elseif i == 3 then
                call IssueImmediateOrder(u, "faeriefireon")
                call IssueImmediateOrder(u, "curseoff")
                call IssueImmediateOrder(u, "bloodluston")
            
            endif
    // Рыцарь крови
    elseif id == 'H03Y' then
        set i=GetRandomInt(1, 3)
            if i == 1 then
                set CheckPlayer=p
                call GroupEnumUnitsInRange(g, x, y, 550, ToHeal)
                set u2=GroupPickRandomUnit(g)
                call IssueTargetOrder(u, "healingwave", u2)
            
            endif
    
    // ФЛот
    elseif id == 'h00Z' or id == 'h00Y' and IsUnitType(target, UNIT_TYPE_STRUCTURE) == false then
        set i=GetRandomInt(1, 6)
            if i == 1 and GetUnitStatePercent(target, UNIT_STATE_LIFE, UNIT_STATE_MAX_LIFE) < GetUnitStatePercent(u, UNIT_STATE_LIFE, UNIT_STATE_MAX_LIFE) then
                set x2=GetUnitX(u) - GetUnitX(target)
                set y2=GetUnitY(u) - GetUnitY(target)
                if SquareRoot(x2 * x2 + y2 * y2) < 125 then
                    call IssueTargetOrder(u, "ancestralspirit", target)
                else
                    //call IssuePointOrder(u, "Move", x,y)
                endif
            elseif i == 2 then
                set x2=GetUnitX(u) - GetUnitX(target)
                set y2=GetUnitY(u) - GetUnitY(target)
                if SquareRoot(x2 * x2 + y2 * y2) < 360 then
                    call IssuePointOrder(u, "clusterrockets", x, y)
                else
                    //call IssuePointOrder(u, "Move", x,y)
                endif
                
                
            elseif i == 3 and GetUnitStatePercent(u, UNIT_STATE_LIFE, UNIT_STATE_MAX_LIFE) < 45 then
                call IssueImmediateOrder(u, "tranquility")
            endif
    endif
    
    
    call GroupClear(g)
    call DestroyGroup(g)
    set g=null
    set u=null
    set target=null
    set u2=null
endfunction

//***************************************************************************
//*
//*  Unit Item Tables
//*
//***************************************************************************

function Unit000387_DropItems takes nothing returns nothing
    local widget trigWidget= null
    local unit trigUnit= null
    local integer itemID= 0
    local boolean canDrop= true

    set trigWidget=bj_lastDyingWidget
    if ( trigWidget == null ) then
        set trigUnit=GetTriggerUnit()
    endif

    if ( trigUnit != null ) then
        set canDrop=not IsUnitHidden(trigUnit)
        if ( canDrop and GetChangingUnit() != null ) then
            set canDrop=( GetChangingUnitPrevOwner() == Player(PLAYER_NEUTRAL_AGGRESSIVE) )
        endif
    endif

    if ( canDrop ) then
        // Item set 0
        call RandomDistReset()
        call RandomDistAddItem(- 1, 100)
        set itemID=RandomDistChoose()
        if ( trigUnit != null ) then
            call UnitDropItem(trigUnit, itemID)
        else
            call WidgetDropItem(trigWidget, itemID)
        endif

    endif

    set bj_lastDyingWidget=null
    call DestroyTrigger(GetTriggeringTrigger())
endfunction


