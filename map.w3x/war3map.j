    set gg_trg_ResO=CreateTrigger()
    call TriggerRegisterPlayerChatEvent(gg_trg_ResO, Player(0), "reso", true)
    call TriggerAddAction(gg_trg_ResO, function Trig_ResO_Actions)
endfunction

