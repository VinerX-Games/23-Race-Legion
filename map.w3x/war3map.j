//===========================================================================
// Trigger: SpellChangeWorld
//===========================================================================
function Trig_SpellChangeWorld_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A1ER'
endfunction

function Trig_SpellChangeWorld_Actions takes nothing returns nothing
    local group g= CreateGroup()
    local unit u
    local integer i= 0
    local location l= GetSpellTargetLoc()
    call SetUnitPositionLoc(GetTriggerUnit(), l)
    call IssueImmediateOrder(GetTriggerUnit(), "metamorphosis")
    call GroupEnumUnitsInRangeOfLoc(g, l, 250, null)
    loop
        set u=FirstOfGroup(g)
        exitwhen u == null
        if GetOwningPlayer(u) != GetOwningPlayer(GetTriggerUnit()) then
            call UnitDamageTargetBJ(GetTriggerUnit(), u, 225, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_DEATH)
        endif
        call GroupRemoveUnit(g, u)
        set u=null
    endloop
    call DestroyGroup(g)
    call RemoveLocation(l)
    set l=null
    set g=null
    set u=null
endfunction

//===========================================================================
function InitTrig_SpellChangeWorld takes nothing returns nothing
    set gg_trg_SpellChangeWorld=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_SpellChangeWorld, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_SpellChangeWorld, Condition(function Trig_SpellChangeWorld_Conditions))
    call TriggerAddAction(gg_trg_SpellChangeWorld, function Trig_SpellChangeWorld_Actions)
endfunction
