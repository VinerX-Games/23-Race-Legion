//===========================================================================
// Trigger: AlmostDiyW2
//===========================================================================
function Trig_AlmostDiyW2_Conditions takes nothing returns boolean
    return GetUnitAbilityLevel(GetTriggerUnit(), 'w2a0') > 0
endfunction 


function FZepp takes nothing returns boolean
    return GetUnitAbilityLevel(GetFilterUnit(), 'w2a1') > 0 and GetOwningPlayer(GetFilterUnit()) == udg_LocalPlayer and UnitAlive(GetFilterUnit()) //and GetUnitUserData(GetFilterUnit())<6

endfunction

function Trig_AlmostDiyW2_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local real Damage= GetEventDamage()
    local real hp= GetUnitState(u, UNIT_STATE_LIFE)
    local boolexpr Zepp
    local unit u2
    local group g
    
    
    
    
    if hp - Damage < 1 and Random(5 + GetPlayerTechCount(GetOwningPlayer(u), 'w2rq', true) , 10) then
        
        set udg_LocalPlayer=GetOwningPlayer(u)
        set Zepp=Condition(function FZepp)
        set g=CreateGroup()
        call GroupEnumUnitsInRangeCounted(g, GetUnitX(u), GetUnitY(u), 1000, Zepp, 5)
        
        
        set u2=BlzGroupUnitAt(g, GetRandomInt(1, BlzGroupGetSize(g)))
        if u2 != null and UnitAlive(u2) then
            
            call RemoveEffectTimed(AddSpecialEffect("Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl", GetUnitX(u), GetUnitY(u)) , 1)
            call SetUnitState(u, UNIT_STATE_LIFE, hp + Damage)
            call SetUnitPosition(u, GetUnitX(u2), GetUnitY(u2))
            call IssueTargetOrder(u, "smart", u2)
        endif
        
        call DestroyGroup(g)
        set g=null
        set u2=null
    endif
    
    
    
    
    set u=null
    
endfunction

//===========================================================================
function InitTrig_AlmostDiyW2 takes nothing returns nothing
    set gg_trg_AlmostDiyW2=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_AlmostDiyW2, EVENT_PLAYER_UNIT_DAMAGING)
    call TriggerAddCondition(gg_trg_AlmostDiyW2, Condition(function Trig_AlmostDiyW2_Conditions))
    call TriggerAddAction(gg_trg_AlmostDiyW2, function Trig_AlmostDiyW2_Actions)
endfunction


