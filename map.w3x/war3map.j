// Trigger: PoleAstralaDragons
//===========================================================================
function Trig_PoleAstralaDragons_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0QV' ) ) then
        return false
    endif
    return true
endfunction

function Trig_PoleAstralaDragons_Func003002 takes nothing returns boolean
    return ( 0 == 0 )
endfunction

function Trig_PoleAstralaDragons_Func005A takes nothing returns nothing
    local unit u
    call CreateNUnitsAtLoc(1, 'H0BN', GetOwningPlayer(GetTriggerUnit()), udg_LocalPosition[14], bj_UNIT_FACING)
    call UnitAddAbilityBJ('AHbn', GetLastCreatedUnit())
    call SetUnitManaBJ(GetLastCreatedUnit(), 1111111.00)
    call SetUnitAbilityLevelSwapped('AHbn', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A08R', GetTriggerUnit()))
    call IssueTargetOrderBJ(GetLastCreatedUnit(), "banish", GetEnumUnit())
    set u=udg_LocalUnit[1]
    call UnitApplyTimedLife(u, 'BTLF', 2)
    set u=null
endfunction

function Trig_PoleAstralaDragons_Actions takes nothing returns nothing
    set udg_LocalPosition[14]=GetUnitLoc(GetTriggerUnit())
    set udg_LocalPosition2=GetSpellTargetLoc()
    set udg_Boolexpr=Condition(function Trig_PoleAstralaDragons_Func003002)
    call GroupEnumUnitsInRangeOfLoc(udg_LocalOtrad2, udg_LocalPosition2, 200, udg_Boolexpr)
    call ForGroupBJ(udg_LocalOtrad2, function Trig_PoleAstralaDragons_Func005A)
    call RemoveLocation(udg_LocalPosition[14])
endfunction

