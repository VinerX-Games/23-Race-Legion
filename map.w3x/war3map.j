function GroupPickRandomUnitEnum2 takes nothing returns nothing
    set bj_groupRandomConsidered=bj_groupRandomConsidered + 1
    if ( GetRandomInt(1, bj_groupRandomConsidered) == 1 ) then
        set bj_groupRandomCurrentPick=GetEnumUnit()
    endif
endfunction


function GroupPickRandomUnit2 takes group whichGroup returns unit

    set bj_groupRandomConsidered=0
    set bj_groupRandomCurrentPick=null
    call ForGroup(whichGroup, function GroupPickRandomUnitEnum2)


    return bj_groupRandomCurrentPick
endfunction

//***************************************************************************
//*  Distance
function DistanceBetweenUnits takes unit u,unit target returns real
    set gX2=GetUnitX(u) - GetUnitX(target)
    set gY2=GetUnitY(u) - GetUnitY(target)
    return SquareRoot(gX2 * gX2 + gY2 * gY2)
endfunction



function DistanceBetweenCoords2 takes real x,real y,real x2,real y2 returns real
    set gX2=x - x2
    set gY2=y - y2
    return SquareRoot(gX2 * gX2 + gY2 * gY2)
endfunction


function DistanceBetweenUnitsXY takes real x,real y,unit target returns real
    set gX2=x - GetUnitX(target)
    set gY2=y - GetUnitY(target)
    return SquareRoot(gX2 * gX2 + gY2 * gY2)
endfunction

