//===========================================================================
function Trig_K2T2b_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTrainedUnit()) == 'o02B'
endfunction

function K2bCount takes player p returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local integer pi= GetPlayerId(p)
    set a[0]=0
    
    
    
    
    // ironhorde orc
    
    set i=1
    set b=3
    
    loop
        set a[0]=a[0] + 1
        set a[a[0]]='o02D'
        
        set b=b + 1
        exitwhen b >= i
    endloop
    
    // black mountain orc
    
    set i=1
    set b=1
    
    loop
        set a[0]=a[0] + 1
        set a[a[0]]='o02C'
        
        set b=b + 1
        exitwhen b >= i
    endloop

    //снайпер 2
    if GetPlayerTechCount(p, 'R0E4', true) >= 1 then
        set i=1
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='o02J'
            
            set b=b + 1
            exitwhen b >= i
        endloop

    endif
    
    //Long Containment
    call SaveInteger(CommonHash, pi, StringHash("K2b_0"), a[0])
    set i=1
    loop
        
        
        call SaveInteger(CommonHash, pi, StringHash("K2b") + i, a[i])
        set i=i + 1
        exitwhen i > a[0]
    endloop
    
    
    
    
endfunction

