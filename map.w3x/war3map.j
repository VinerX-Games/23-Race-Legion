//===========================================================================
// Trigger: FireShielDamageUniversal
//===========================================================================
function Trig_FireShielDamageUniversal_Conditions takes nothing returns boolean
    local real dx
    local real dy
    set gCaster=GetEventDamageSource() //На ком щит
    set gTarget=BlzGetEventDamageTarget()
    set dx=GetUnitX(gCaster) - GetUnitX(gTarget)
    set dy=GetUnitY(gCaster) - GetUnitY(gTarget)
    return GetUnitAbilityLevel(gCaster, 'B00F') > 0 and SquareRoot(dx * dx + dy * dy) < 200 and gCaster != null and UnitAlive(gCaster) and gTarget != null and UnitAlive(gTarget)
endfunction

function Trig_FireShielDamageUniversal_Actions takes nothing returns nothing
    call UnitDamageTargetBJ(GetTriggerUnit(), gCaster, 45, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_FIRE)
endfunction

