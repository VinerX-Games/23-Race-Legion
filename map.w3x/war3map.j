// scope initBoolExprs begins

function UnitsWithReviveHeroSpellEach takes nothing returns boolean
    set gUnit=GetFilterUnit()
    if UnitAlive(gUnit) and BlzGetUnitBooleanField(gUnit, ConvertUnitBooleanField('urev')) then
        set Counter=Counter + 1
        return true
    else
        return false
    endif
endfunction

function f_OwnBuildingsInRange takes nothing returns boolean
    set gUnit=GetFilterUnit()
    if UnitAlive(gUnit) and GetOwningPlayer(gUnit) == CheckPlayer and IsUnitType(gUnit, UNIT_TYPE_STRUCTURE) then
        set Counter=Counter + 1
        return true
    else
        return false
    endif
endfunction

function f_OwnHeroes takes nothing returns boolean
    set gUnit=GetFilterUnit()
    if UnitAlive(gUnit) and IsUnitType(gUnit, UNIT_TYPE_HERO) then
        set Counter=Counter + 1
        return true
    else
        return false
    endif
endfunction


function f_OwnCapitalInRange takes nothing returns boolean
    set gUnit=GetFilterUnit()
    if IsUnitInGroup(gUnit, udg_StolicaGroups) and GetOwningPlayer(gUnit) == CheckPlayer and UnitAlive(gUnit) then
        return true
    else
        return false
    endif
endfunction

function initBoolExprs___Init takes nothing returns nothing
    set UnitsWithReviveHeroSpell=Condition(function UnitsWithReviveHeroSpellEach)
    set b_OwnBuldingsInRange=Condition(function f_OwnBuildingsInRange)
    set b_OwnCapitalInRange=Condition(function f_OwnCapitalInRange)
    set b_OwnHeroes=Condition(function f_OwnHeroes)
    
endfunction


// scope initBoolExprs ends
//***************************************************************************
//*  LibNewFunctions
//***************************************************************************
//*  AddExp

function addArmyExp takes unit u,integer pi returns nothing
  //   call BJDebugMsg("Start")
    set gPlayer=GetOwningPlayer(u)
    set gId=GetUnitTypeId(u)
    set gPi=GetPlayerId(gPlayer)
    if IsPlayerAlly(gPlayer, Player(pi)) then
        return
    endif
    
    if IsUnitType(u, UNIT_TYPE_STRUCTURE) then
        if IsUnitInGroup(gAttacked, udg_ZahvatBuildings) then
            set gReal=1
        else
            set gReal=( I2R(GetUnitGoldCost(gId)) * 0.01 )
        endif
    else
        if IsUnitType(u, UNIT_TYPE_HERO) then
            set gReal=( GetHeroLevel(u) * 1 )
        else
            set gReal=( I2R(GetUnitGoldCost(gId)) * 0.02 )
        endif
    endif
    set ArmyExp[pi]=ArmyExp[pi] + gReal
    set ArmyExp[gPi]=RMaxBJ(0, ArmyExp[gPi] - gReal * 0.9)
   // call BJDebugMsg( GetUnitName(u)+" "+R2S(ArmyExp[pi]))
endfunction

//Устанавливает бонус за опыт
function ArmyExpSetBonus takes integer pi returns nothing
    call SetUnitAbilityLevel(ArmyExpBonus[pi], 'arb1', IMinBJ(R2I(( ArmyExp[pi] / 500 ) + 1), 11))
    call SetUnitAbilityLevel(ArmyExpBonus[pi], 'arb0', IMinBJ(R2I(( ArmyExp[pi] / 500 ) + 1), 11))
endfunction


// Добавляет столбец опыта
function ExpandTableArmyExpr takes nothing returns nothing
    local integer i= 0
    local integer l__max= 1
    call MultiboardSetColumnCount(Multiboard, 4)
    
    
    set ArmyPowerColumn[24]=MultiboardGetItem(Multiboard, 0, 3)
    call MultiboardSetItemValue(ArmyPowerColumn[24], "Опыт")
    call MultiboardSetItemWidth(ArmyPowerColumn[24], 0.06)
    call MultiboardReleaseItem(ArmyPowerColumn[24])
    
    loop
        exitwhen i > 23
        set ArmyExp[i]=0.001
        if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING or IsPlayerInForce(Player(i), udg_Bots) then
            set ArmyPowerColumn[i]=MultiboardGetItem(Multiboard, l__max, 3)
            call MultiboardSetItemValue(ArmyPowerColumn[i], "0")
            call MultiboardSetItemWidth(ArmyPowerColumn[i], 0.06)
            set l__max=l__max + 1
        endif
        set i=i + 1
    
    endloop
     
    
    
    call MultiboardDisplay(Multiboard, false)
    call MultiboardDisplay(Multiboard, true)
    
    
endfunction

//***************************************************************************
//*  UpdateGraph
function PercentGraph takes integer pi returns nothing
    call MultiboardSetItemValue(ThirdColumn[pi], ( R2SW_Polyfill(I2R(CityPlayerCount[pi]) * 100.0 / I2R(CityCount)) + "%" ))
endfunction

function ArmyExpGraph takes integer pi returns nothing
    call MultiboardSetItemValue(ArmyPowerColumn[pi], R2SW_Polyfill(ArmyExp[pi]))
endfunction

function UpdateGraf takes integer pi returns nothing
    local player p= Player(pi)
    local integer r= R2I(udg_UnitsCount[pi] / 25.00)
    set logistic[pi]=( ( 500 + 100 * ( r - 1 ) ) / 2 * r ) // прогрессия
    
    //Общий модификатор расходов
    if GetPlayerTechCount(p, 'R0DV', true) + GetPlayerTechCount(p, 'R0GZ', true) >= 1 then
        set additional[pi]=disincome[pi] * ( udg_MainPrice[pi] / ( - 100.0 ) )
    endif
    
    
    if DisOn then
        set balance[pi]=income[pi] - disincome[pi] + corruption[pi] - logistic[pi] + additional[pi]
    else
        set balance[pi]=income[pi]
    endif
    
    // Табличка
    call MultiboardSetItemValue(MultiboardItem[MultiboardItemOwnerIndex[pi] * 2 + 1], I2S(udg_UnitsCount[pi]))
    call PercentGraph(pi)
    call ArmyExpGraph(pi)
     
endfunction
//***************************************************************************
//*  Enter
function Enter takes unit u returns nothing
    local integer id= GetUnitTypeId(u)
    local player p= GetOwningPlayer(u)
    local integer pi= GetPlayerId(p)
    
    
    
    call MultiboardSetItemValue(MultiboardItem[MultiboardItemOwnerIndex[pi] * 2 + 1], I2S(udg_UnitsCount[pi]))
    

endfunction
//***************************************************************************
//*  Settings




function StartInc takes nothing returns nothing
    
    local integer i= 0
        loop
            exitwhen i >= 24
            set income[i]=0
            set incomeW[i]=0
            set disincome[i]=0
            set logistic[i]=0
            set corruption[i]=0
            set balance[i]=0
            set additional[i]=0
            set AllyTax[i]=0
            set i=i + 1
        endloop
    call RegionAddRect(Allmap, GetWorldBounds())
    
endfunction
//***************************************************************************
//*  CountAddDis and CountDelDis
function AddCountDis takes unit u,integer pi returns nothing
    local integer i
  //Добавляет потребление с юнита    
    
    if u == null then
        return
    endif
    
    // Кейс здания или его симуляция
    if ( IsUnitType(u, UNIT_TYPE_STRUCTURE) or GetUnitAbilityLevel(u, 'A1IJ') > 0 ) then
        if IsUnitInGroup(u, udg_BuildedSctructure[1]) then
            set income[pi]=income[pi] + I2R(GetUnitFoodMade(u))
            
            //Различные дополнения 
            if GetUnitAbilityLevel(u, 'A0AY') >= 1 then
                set income[pi]=( income[pi] + ( 100.00 * I2R(GetUnitAbilityLevel(u, 'A0AY')) ) )
            elseif GetUnitAbilityLevel(u, 'A0SM') >= 1 then
                set income[pi]=( income[pi] + ( 75.00 * I2R(GetUnitAbilityLevel(u, 'A0SM')) ) )
            elseif GetUnitAbilityLevel(u, 'A0VS') == 1 then
                set income[pi]=( income[pi] + 100 )
            endif
            
            if GetUnitAbilityLevel(u, 'A1HS') > 0 then
                set income[pi]=( income[pi] - 5 )
                set i=LoadInteger(Hash, GetHandleId(u), 0)
                set income[i]=( income[i] + 5 )
            endif
            
            
            set i=GetUnitAbilityLevel(u, 'A0B5')
            if i > 0 then
                set incomeW[pi]=incomeW[pi] + ( 50.00 * i )
            endif
        endif
        
    // Кейс юнита
    else
        //Это не оживление мертвых, не суммон
        if not IsUnitType(u, UNIT_TYPE_SUMMONED) then
            
            set udg_UnitsCount[pi]=udg_UnitsCount[pi] + 1
            //call DisplayTextToPlayer(p,0,0,I2S(udg_UnitsCount[pi]))
            
            
            if IsUnitType(u, UNIT_TYPE_HERO) then
                set disincome[pi]=( disincome[pi] + 100.00 )
                if GetUnitAbilityLevel(u, 'A0XV') != 0 then // Казначейская аблика
                    set income[pi]=income[pi] + ( 100 + GetUnitAbilityLevel(u, 'A0XV') * 100 )
                endif
                
            else
                set udg_Price=GetUnitGoldCost(GetUnitTypeId(u))
                set disincome[pi]=( disincome[pi] + ( udg_Price * Tax ) )
                // ---------------------------Особые условия-----------------------------          +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
                // ---------------------------Топливо гоблинов-----------------------------
                if GetUnitAbilityLevel(u, 'A0A5') != 0 then
                    set disincome[pi]=disincome[pi] + ( ( udg_Price * Tax ) * ( 1.60 - ( 0.10 * I2R(GetUnitAbilityLevel(u, 'A0A5')) ) ) )

                // ---------------------------Поколения Силитидов-------------------------
                elseif GetUnitAbilityLevel(u, 'A0VH') == 1 then
                    set disincome[pi]=disincome[pi] - ( udg_Price * Tax / 2 )
                elseif GetUnitAbilityLevel(u, 'A0VH') == 2 then
                    set disincome[pi]=disincome[pi] - ( udg_Price * Tax / 3 * 2 )
                
                //Horde land
             //   elseif  GetUnitAbilityLevel(u,'OR00')!=0 then
                 
                  //  set disincome[pi] = disincome[pi] + ( ( udg_Price * Tax ) * ( ( GetUnitAbilityLevel(u,'OR00')-35 )/100.0) )
                
                endif
                
                
            endif
        
        
        //Случай призывных у культа.
        elseif GetUnitAbilityLevel(u, 'A1HL') > 0 then
            set udg_UnitsCount[pi]=udg_UnitsCount[pi] + 1
            set udg_Price=GetUnitGoldCost(GetUnitTypeId(u))
            set disincome[pi]=( disincome[pi] + ( udg_Price * Tax / 2 ) )
        endif
 
    endif
    
    
    
    
    call UpdateGraf(pi)

endfunction


function DelCountDis takes unit u,integer pi returns nothing
    local integer i
    //Убирает потребление с юнита
    
    if u == null then
        return
    endif
    
    
    //юнит
    //Здание
    if ( IsUnitType(u, UNIT_TYPE_STRUCTURE) or GetUnitAbilityLevel(u, 'A1IJ') > 0 ) then
    
        if IsUnitInGroup(u, udg_BuildedSctructure[1]) then
            set income[pi]=income[pi] - I2R(GetUnitFoodMade(u))
            
            //Различные дополнения
            if GetUnitAbilityLevel(u, 'A0AY') >= 1 then
                    set income[pi]=( income[pi] - ( 100.00 * I2R(GetUnitAbilityLevel(u, 'A0AY')) ) )
            elseif GetUnitAbilityLevel(u, 'A0SM') >= 1 then
                set income[pi]=( income[pi] - ( 75.00 * I2R(GetUnitAbilityLevel(u, 'A0SM')) ) )
            endif
            
            if GetUnitAbilityLevel(u, 'A0VS') == 1 then
                set income[pi]=( income[pi] - 100 )
            endif
            
            if GetUnitAbilityLevel(u, 'A1HS') > 0 then
                set income[pi]=( income[pi] + 5 )
                set i=LoadInteger(Hash, GetHandleId(u), 0)
                set income[i]=( income[i] - 5 )
                call FlushChildHashtable(Hash, GetHandleId(u))
            endif
            
            
            
            set i=GetUnitAbilityLevel(u, 'A0B5')
            if i > 0 then
                set incomeW[pi]=incomeW[pi] - ( 50.00 * i )
            endif
        endif
    
    //Не здание
    //Это не оживление мертвых, не суммон
    elseif not IsUnitType(u, UNIT_TYPE_SUMMONED) then
        set udg_UnitsCount[pi]=udg_UnitsCount[pi] - 1
        //Гер
        if IsUnitType(u, UNIT_TYPE_HERO) then
                set disincome[pi]=( disincome[pi] - 100.00 )
                
                
                //Различные дополнения
                if GetUnitAbilityLevel(u, 'A0XV') != 0 then
                        set income[pi]=income[pi] - ( 100 + GetUnitAbilityLevel(u, 'A0XV') * 100 )
                endif
        
        //юнит
        else
                
               
               // call DisplayTextToPlayer(p,0,0,("Увидел смерть до юнита "+GetUnitName(u)))
                set udg_Price=GetUnitGoldCost(GetUnitTypeId(u))
                set disincome[pi]=( disincome[pi] - ( udg_Price * Tax ) )
                
                
                //Различные дополнения
                // ---------------------------Топливо гоблинов-----------------------------
                if GetUnitAbilityLevel(u, 'A0A5') != 0 then
                    set disincome[pi]=disincome[pi] - ( ( udg_Price * Tax ) * ( 1.60 - ( 0.10 * I2R(GetUnitAbilityLevel(u, 'A0A5')) ) ) )

                // ---------------------------Поколения Силитидов------------------------- ??
                elseif GetUnitAbilityLevel(u, 'A0VH') == 1 then
                    set disincome[pi]=disincome[pi] + ( udg_Price * Tax / 2 )
                elseif GetUnitAbilityLevel(u, 'A0VH') == 2 then
                    set disincome[pi]=disincome[pi] + ( udg_Price * Tax / 3 * 2 )
                elseif GetUnitAbilityLevel(u, 'OR00') != 0 then
                    set disincome[pi]=disincome[pi] - ( ( udg_Price * Tax ) * ( ( GetUnitAbilityLevel(u, 'OR00') - 35 ) / 100.0 ) )
                  
                  //Horde land
               // elseif  GetUnitAbilityLevel(u,'OR00')!=0 then                  
                //    set disincome[pi] = disincome[pi] - ( ( udg_Price * Tax ) * ( ( GetUnitAbilityLevel(u,'OR00')-35 )/100.0) )
                
                endif
        endif
        
        
        
        
    //Случай призывных у культа.
    elseif GetUnitAbilityLevel(u, 'A1HL') > 0 then
            set udg_UnitsCount[pi]=udg_UnitsCount[pi] - 1
            set udg_Price=GetUnitGoldCost(GetUnitTypeId(u))
            set disincome[pi]=( disincome[pi] - ( udg_Price * Tax / 2 ) )
        
    endif
    
    call UpdateGraf(pi)
    set u=null
endfunction



function TimedCountAct takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer tid= GetHandleId(t)
    local unit u= LoadUnitHandle(Hash, tid, 1)
    call DelCountDis(u , GetPlayerId(GetOwningPlayer(u)))
    
    call FlushChildHashtable(Hash, tid)
    call DestroyTimer(t)
    set t=null
    set u=null
endfunction

function TimedCount takes unit u returns nothing
    local timer t= CreateTimer()
    call SaveUnitHandle(Hash, GetHandleId(t), 1, u)
    call TimerStart(t, 0.3, false, function TimedCountAct)
    
    set t=null
endfunction



//***************************************************************************
//*  ClearEc
function ClearEc takes integer pi returns nothing
    set income[pi]=0
    set incomeW[pi]=0
    set disincome[pi]=0
    set logistic[pi]=0
    set corruption[pi]=0
    set balance[pi]=0
    set additional[pi]=0
    set udg_UnitsCount[pi]=0
    set CityPlayerCount[pi]=0
endfunction

//call ClearEc(GetPlayerId(GetEnumPlayer()))

//***************************************************************************
//*  ClearPlayer
function KillAll takes nothing returns nothing
    local unit u= GetEnumUnit()
    local integer id= GetUnitTypeId(u)
    local player p= GetOwningPlayer(u)
    if IsUnitInGroup(u, udg_ZahvatBuildings) or GetUnitAbilityLevel(u, 'A1HJ') > 0 then
        call SetUnitOwner(u, Player(25), true)
    elseif IsUnitInGroup(u, udg_StolicaGroups) then
        call RemoveUnit(u)
    else
        //Случай пилота танка
        if id == 'h0KS' then
            call UnitRemoveAbility(u, 'A18O')
        endif
        if IsUnitType(u, UNIT_TYPE_HERO) then
            call SetPlayerTechMaxAllowed(p, id, GetPlayerTechMaxAllowed(p, id) + 1)
        endif
        call RemoveUnit(u)
    endif
    
    set u=null
    set p=null
endfunction

function ClearPlayer takes player p returns nothing
    local integer pi= GetPlayerId(p)
    local group g= CreateGroup()

    call GroupEnumUnitsOfPlayer(g, p, null)
    call ForGroup(g, function KillAll)
    call GroupClear(g)
    call SetPlayerStateBJ(Player(pi), PLAYER_STATE_RESOURCE_GOLD, 0)
    call SetPlayerStateBJ(Player(pi), PLAYER_STATE_RESOURCE_LUMBER, 0)

    call SetPlayerAbilityAvailable(Player(pi), 'A0IQ', true)
    call ClearEc(pi)
    call turnOffAi(pi)
    call UpdateGraf(pi)
    set playerCapital[pi]=null
    set ArmyExp[pi]=0.0
    
    
    call DestroyGroup(g)
    set g=null
endfunction
//***************************************************************************
//*  TimedUpdate
function TimedUpdateCheck takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer id= GetHandleId(t)
    local unit u= LoadUnitHandle(Hash, id, 1)
    local player p= LoadPlayerHandle(Hash, id, 2)
    local integer currentLevel= LoadInteger(Hash, id, 3)
    


    local integer levels= 4
    local integer pi= GetPlayerId(p)
    
    if GetUnitAbilityLevel(GetTriggerUnit(), 'A1N9') > 0 then
        set levels=levels - 2
    endif
    
    
    if GetOwningPlayer(u) == p and UnitAlive(u) and currentLevel <= levels then

        //Development
        call BlzStartUnitAbilityCooldown(u, 'A10G', 300)
        //call BlzSetUnitAbilityCooldown(u,'A10G',1,300)
    
        //Golda
        if GetUnitAbilityLevel(u, 'A0AY') == 0 then
            call UnitAddAbility(u, 'A0AY')
            set income[pi]=income[pi] + 100

            
        elseif GetUnitAbilityLevel(u, 'A0AY') < levels then
            set income[pi]=income[pi] + 100
            call IncUnitAbilityLevel(u, 'A0AY')
            
        else //if GetUnitAbilityLevel(u, 'A0AY') >= levels then
            set income[pi]=income[pi] + 100
            call UnitRemoveAbility(u, 'A0AZ')
           
            
        endif
        
        //Lumber
        if GetUnitAbilityLevel(u, 'A0B5') == 0 then
            call UnitAddAbility(u, 'A0B5')
            set incomeW[pi]=incomeW[pi] + 50.00
        elseif GetUnitAbilityLevel(u, 'A0B5') < levels then
            call IncUnitAbilityLevel(u, 'A0B5')
            set incomeW[pi]=incomeW[pi] + 50.00
        else //if GetUnitAbilityLevel( u,'A0B5' ) >= levels then
            call UnitRemoveAbility(u, 'A0B1')
            
        endif
        
        if GetUnitAbilityLevel(u, 'A0AY') + GetUnitAbilityLevel(u, 'A0B5') >= levels * 2 then
            //Развитие
            call BlzUnitHideAbility(u, 'A10G', true)
            call BlzUnitDisableAbility(u, 'A10G', true, true)
        
        
        endif
        
        call UpdateGraf(pi)
        set u=null
        set p=null
        call SaveInteger(Hash, id, 3, currentLevel + 1)
        call TimerStart(t, 300, false, function TimedUpdateCheck)
        set t=null

    else
        set u=null
        set p=null
        call DestroyTimer(t)
        set t=null
        call FlushChildHashtable(Hash, id)
    endif
endfunction





function TimedUpdate takes unit u,player p returns nothing
    local timer t= CreateTimer()
    local integer id= GetHandleId(t)
    
    call UnitAddAbility(u, 'A10G')
    call BlzStartUnitAbilityCooldown(u, 'A10G', 300)
    call TimerStart(t, 300, false, function TimedUpdateCheck)
    call SaveUnitHandle(Hash, id, 1, u)
    call SavePlayerHandle(Hash, id, 2, p)
    call SaveInteger(Hash, id, 3, 1)
    
    set u=null
    set p=null
    set t=null


endfunction
