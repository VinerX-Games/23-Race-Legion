//===========================================================================
// Trigger: SpellMassSunAttack
//===========================================================================

function Trig_SpellMassSunAttack_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A1KX'
endfunction


function Trig_SpellMassSunAttack_Actions takes nothing returns nothing
    local location l= GetSpellTargetLoc()
    local unit caster= GetTriggerUnit()
    local player p= GetOwningPlayer(caster)
    //local boolexpr bex
    local integer dammyAbility= 'A1KY'
    local integer level= GetUnitAbilityLevel(caster, GetSpellAbilityId())
    local group g= CreateGroup()
    local unit u
    local unit u2
    local integer i= 0
    set udg_LocalPlayer=p
    //set bex = Condition(function EnemEl) 
    call GroupEnumUnitsInRangeOfLoc(g, l, 150, null)
    
    if FirstOfGroup(g) == null then
        //Нету врагов
        call BlzStartUnitAbilityCooldown(caster, dammyAbility, 15)
        call SetUnitState(caster, UNIT_STATE_MANA, GetUnitState(caster, UNIT_STATE_MANA) + 100 + 35 * level)
        
    
    else
        call RemoveLocation(l)
        set l=GetUnitLoc(caster)
        loop
            set u=FirstOfGroup(g)
            exitwhen u == null
            
            set u2=CreateUnitAtLoc(p, Dummy, l, bj_UNIT_FACING)
            
            if IsPlayerEnemy(GetOwningPlayer(u), p) then
                set dammyAbility='A1KZ'
            else
                set dammyAbility='A1KY'
            endif
            
            call UnitAddAbility(u2, dammyAbility)
            call SetUnitAbilityLevel(u2, dammyAbility, level)
            
            if IsPlayerEnemy(GetOwningPlayer(u), p) then
                call IssueTargetOrder(u2, "firebolt", u)
            else
                call IssueTargetOrder(u2, "holybolt", u)
            endif
            call RemoveUnitTimed(u2 , 2)
            set i=i + 1
            call GroupRemoveUnit(g, u)
            set u=null
        endloop
    endif
    
    set u=null
    call DestroyGroup(g)
    set g=null
    call RemoveLocation(l)
    set p=null
    //call DestroyBoolExpr(bex)
    set u2=null
    //set bex = null

endfunction




//===========================================================================
function InitTrig_SpellMassSunAttack takes nothing returns nothing
    set gg_trg_SpellMassSunAttack=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_SpellMassSunAttack, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_SpellMassSunAttack, Condition(function Trig_SpellMassSunAttack_Conditions))
    call TriggerAddAction(gg_trg_SpellMassSunAttack, function Trig_SpellMassSunAttack_Actions)
endfunction


//===========================================================================
// Trigger: Manasbor
//===========================================================================
function Trig_Manasbor_Conditions takes nothing returns boolean
    set gCaster=GetEventDamageSource()
    set gTarget=GetEventTargetUnit()
    return GetUnitAbilityLevel(gCaster, 'A1GR') > 0
endfunction

function Trig_Manasbor_Actions takes nothing returns nothing
    local real enemyMana= GetUnitState(GetTriggerUnit(), UNIT_STATE_MANA)
    local integer k= 0
    if IsUnitType(gTarget, UNIT_TYPE_HERO) then
        if enemyMana > 1 then
            set k=1
        else
            return
        endif
    else
        if enemyMana > 5 then
            set k=5
        else
            return
        endif
    endif
    if gCaster != null and UnitAlive(gCaster) then
        call SetUnitState(gCaster, UNIT_STATE_MANA, RMaxBJ(0, GetUnitState(gCaster, UNIT_STATE_MANA) + k))
    endif
endfunction

//===========================================================================
function InitTrig_Manasbor takes nothing returns nothing
    set gg_trg_Manasbor=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Manasbor, EVENT_PLAYER_UNIT_DAMAGING)
    call TriggerAddCondition(gg_trg_Manasbor, Condition(function Trig_Manasbor_Conditions))
    call TriggerAddAction(gg_trg_Manasbor, function Trig_Manasbor_Actions)
endfunction


