    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(udg_Caster)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAlly(GetEnumUnit(), GetOwningPlayer(udg_Caster)) == false ) ) then
