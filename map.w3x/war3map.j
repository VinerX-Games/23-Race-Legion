//*  BuildT
function TType takes nothing returns nothing
    if GetUnitTypeId(GetEnumUnit()) == udg_LocalInteger5 then
        call GroupAddUnit(udg_LocalOtrad, GetEnumUnit())
    endif
endfunction



function BuildT takes player p,integer before,integer after returns nothing
    local unit u= null
    
    call GroupClear(udg_LocalOtrad)
    call GroupEnumUnitsOfPlayer(gGroup, p, null)
    set udg_LocalInteger5=before
    call ForGroup(gGroup, function TType)


    set gGroup=udg_LocalOtrad
    set u=GroupPickRandomUnit2(gGroup)
    call IssueImmediateOrderById(u, after)
    
    //Зачистка
    set udg_LocalOtrad=CreateGroup()

    set u=null
endfunction


//***************************************************************************
//*  TryBuy

function TryBuy takes player p,integer ePoints returns nothing

    local unit u
    local integer itemId
    call GroupEnumUnitsOfPlayer(gGroup, p, LiveHero)
    set u=GroupPickRandomUnit2(gGroup)
    if u != null then
        
        if UnitInventoryCount(u) >= 6 then
            call RemoveItem(UnitItemInSlot(u, GetRandomInt(0, 5)))
        endif
     
        set gInt=GetRandomInt(1, 6)
        if ePoints < 35 then
            if gInt == 1 then
                set itemId='I02S'
            elseif gInt == 2 then
                set itemId='I030'
            elseif gInt == 3 then
                set itemId='I02Z'
            elseif gInt == 4 then
                set itemId='I02Y'
            elseif gInt == 5 then
                set itemId='I02T'
            elseif gInt == 6 then
                set itemId='I02X'
            endif
        elseif ePoints < 150 then
            
            if gInt == 1 then
                set itemId='I010'
            elseif gInt == 2 then
                set itemId='I01A'
            elseif gInt == 3 then
                set itemId='I02Z'
            elseif gInt == 4 then
                set itemId='I01P'
            elseif gInt == 5 then
                set itemId='I002'
            elseif gInt == 6 then
                set itemId='I003'
            endif
        else
            
            if gInt == 1 then
                set itemId='I00W'
            elseif gInt == 2 then
                set itemId='I030'
            elseif gInt == 3 then
                set itemId='I011'
            elseif gInt == 4 then
                set itemId='I00F'
            elseif gInt == 5 then
                set itemId='I017'
            elseif gInt == 6 then
                set itemId='I01C'
            endif
        endif

        
        if GetInventoryIndexOfItemTypeBJ(u, itemId) == 0 then
            call UnitAddItemByIdSwapped(itemId, u)
        endif
        
    endif

    set u=null
endfunction
//***************************************************************************
//*  SpawnMageTp


function MakeMageTp takes integer pi returns nothing
    call GroupEnumUnitsOfPlayer(gGroup, Player(pi), Altars)
    if FirstOfGroup(gGroup) != null then
        set gUnit2=GroupPickRandomUnit2(gGroup)
        set gUnit=CreateUnit(Player(pi), 'h07A', GetUnitX(gUnit2), GetUnitY(gUnit2), 0)
        call GroupAddUnit(udg_Ai_army[pi], gUnit)
        call GroupAddUnit(AiUnitsToPort[pi], gUnit)
        call NumberAdd(pi , 'h07A')
        
    endif
endfunction
