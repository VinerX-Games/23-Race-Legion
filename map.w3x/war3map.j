//===========================================================================
// Trigger: Kill
//===========================================================================
function Trig_Kill_Func002Func001Func001C takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_StolicaGroups) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetEnumUnit()) == GetTriggerPlayer() ) ) then
        return false
    endif
    return true
endfunction

function Trig_Kill_Func002Func001Func003C takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_ZahvatBuildings) != true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetEnumUnit()) == GetTriggerPlayer() ) ) then
        return false
    endif
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_StolicaGroups) != true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Kill_Func002Func001C takes nothing returns boolean
    if ( not Trig_Kill_Func002Func001Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_Kill_Func002A takes nothing returns nothing
    if ( Trig_Kill_Func002Func001C() ) then
        call KillUnit(GetEnumUnit())
    else
        if ( Trig_Kill_Func002Func001Func001C() ) then
            call KillUnit(GetEnumUnit())
            set udg_LocalPlayer=GetTriggerPlayer()
            call ConditionalTriggerExecute(gg_trg_StolicaKill)
        else
        endif
    endif
endfunction

function Trig_Kill_Actions takes nothing returns nothing
    local player p= GetTriggerPlayer()
    local group g= CreateGroup()
    call GroupEnumUnitsSelected(g, p, null)
    call ForGroup(g, function Trig_Kill_Func002A)
    call DestroyGroup(g)
    set g=null
    set p=null
endfunction

//===========================================================================
function InitTrig_Kill takes nothing returns nothing
    set gg_trg_Kill=CreateTrigger()
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(0), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(1), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(2), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(3), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(4), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(5), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(6), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(7), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(8), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(9), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(10), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(11), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(12), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(13), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(14), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(15), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(16), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(17), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(18), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(19), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(20), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(21), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(22), "-kill", true)
    call TriggerRegisterPlayerChatEvent(gg_trg_Kill, Player(23), "-kill", true)
    call TriggerAddAction(gg_trg_Kill, function Trig_Kill_Actions)
endfunction


//===========================================================================
// Trigger: StolicaKill
//===========================================================================
function Trig_StolicaKill_Func002Func001C takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_ZahvatBuildings) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_StolicaKill_Func002A takes nothing returns nothing
    if ( Trig_StolicaKill_Func002Func001C() ) then
        call SetUnitOwner(GetEnumUnit(), Player(PLAYER_NEUTRAL_AGGRESSIVE), true)
    else
        call KillUnit(GetEnumUnit())
        call RemoveUnit(GetEnumUnit())
    endif
endfunction

function Trig_StolicaKill_Func005A takes nothing returns nothing
    call DisplayTextToForce(GetPlayersAll(), ( GetPlayerName(GetEnumPlayer()) + ( " освободился от игрока " + GetPlayerName(udg_LocalPlayer) ) ))
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=24
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetPlayerAllianceStateBJ(GetTriggerPlayer(), ConvertedPlayer(GetForLoopIndexA()), bj_ALLIANCE_UNALLIED)
        call SetPlayerAllianceStateBJ(GetEnumPlayer(), ConvertedPlayer(GetForLoopIndexA()), bj_ALLIANCE_UNALLIED)
        call SetPlayerAllianceStateBJ(ConvertedPlayer(GetForLoopIndexA()), udg_LocalPlayer, bj_ALLIANCE_UNALLIED)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

function Trig_StolicaKill_Actions takes nothing returns nothing
    call DisplayTextToForce(GetPlayersAll(), ( GetPlayerName(udg_LocalPlayer) + "|cffff0000 - самоубился! |rЗачем?)" ))
    call ForGroupBJ(GetUnitsOfPlayerAll(udg_LocalPlayer), function Trig_StolicaKill_Func002A)
    call SetPlayerAbilityAvailableBJ(true, 'A0IQ', udg_LocalPlayer)
    // Обнуляю вассалов самоубийцы. Вы свободны!
    call ForForce(udg_Vassals[GetConvertedPlayerId(udg_LocalPlayer)], function Trig_StolicaKill_Func005A)
    call ForceClear(udg_Vassals[GetConvertedPlayerId(udg_LocalPlayer)])
endfunction

//===========================================================================
function InitTrig_StolicaKill takes nothing returns nothing
    set gg_trg_StolicaKill=CreateTrigger()
    call TriggerAddAction(gg_trg_StolicaKill, function Trig_StolicaKill_Actions)
endfunction

