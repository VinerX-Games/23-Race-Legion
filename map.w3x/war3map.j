//***************************************************************************
//*  R2SW_Polyfill
function R2SW_Polyfill takes real value returns string
    local string output= ""
    local integer two_off= ModuloInteger(R2I(value / 0.01), 10)
    local integer on_off= ModuloInteger(R2I(value / 0.1), 10)
    return I2S(R2I(value)) + "." + I2S(on_off) + I2S(two_off)
endfunction
