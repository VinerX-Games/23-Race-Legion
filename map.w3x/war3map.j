//===========================================================================
// Trigger: DieT C
//===========================================================================
function Trig_DieT_C_Conditions takes nothing returns boolean
    local unit u= GetTriggerUnit()
    local integer id= GetUnitTypeId(u)
    if IsUnitType(u, UNIT_TYPE_SUMMONED) or u == null or IsUnitType(u, UNIT_TYPE_STRUCTURE) or id == 'H0BN' or id == 'H0GB' or id == 'e02Z' or id == 'h0GA' then
        set u=null
        return false
    else
        set u=null
        return true
    endif
    
endfunction

function Trig_DieT_C_Actions takes nothing returns nothing
    local unit u=  GetTriggerUnit()
    local player p= GetOwningPlayer(u)
    local integer pi= GetPlayerId(p)
    local integer i= GetPlayerId(p)
    
    call TriggerSleepAction(0.15)
    if u != null then
        set udg_UnitsCount[pi]=udg_UnitsCount[pi] - 1
        //call DisplayTextToPlayer(p,0,0,I2S(udg_UnitsCount[pi]))
        call MultiboardSetItemValue(MultiboardItem[MultiboardItemOwnerIndex[pi] * 2 + 1], I2S(udg_UnitsCount[pi]))
    endif
    
    
    
    set i=0
    set u=null
    set p=null
endfunction

//===========================================================================
function InitTrig_DieT_C takes nothing returns nothing
    set gg_trg_DieT_C=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_DieT_C, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_DieT_C, Condition(function Trig_DieT_C_Conditions))
    call TriggerAddAction(gg_trg_DieT_C, function Trig_DieT_C_Actions)
endfunction


