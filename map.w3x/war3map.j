//===========================================================================
// Trigger: ChoseLich
//===========================================================================

function Trig_ChoseLich_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0SW' or GetSpellAbilityId() == 'A0T1'
endfunction

function HaveSpell takes nothing returns boolean
    return GetUnitAbilityLevel(GetFilterUnit(), 'A0SW') + GetUnitAbilityLevel(GetFilterUnit(), 'A0T1') != 0
endfunction


function Trig_ChoseLich_Func003002 takes nothing returns boolean
    return GetUnitTypeId(GetFilterUnit()) == 'e01I' and GetOwningPlayer(GetTriggerUnit()) == GetOwningPlayer(GetFilterUnit())
endfunction



function Trig_ChoseLich_Actions takes nothing returns nothing
    local unit u1
    local unit u2
    local group g= CreateGroup()
    local group g2= CreateGroup()
    local integer i= 0
    local player p= GetOwningPlayer(GetTriggerUnit())
    call ClearSelectionForPlayer(p)
    set udg_Boolexpr=Condition(function HaveSpell)
    call GroupEnumUnitsSelected(g, p, udg_Boolexpr)
    set udg_Boolexpr=Condition(function Trig_ChoseLich_Func003002)
    
    loop
        set u1=FirstOfGroup(g)
        exitwhen u1 == null or i >= 12
        
        call GroupEnumUnitsInRangeCounted(g2, GetUnitX(u1), GetUnitY(u1), 1200, udg_Boolexpr, IMaxBJ(12 - i, 1))
        loop
            set u2=FirstOfGroup(g2)
            exitwhen u2 == null or i >= 12
        
            call SelectUnitAddForPlayer(u2, p)
    
            set i=i + 1
            call GroupRemoveUnit(g2, u2)
        endloop
         
    
        
        call GroupRemoveUnit(g, u1)
    endloop
    
    
    
    
    
   
    call DestroyGroup(g)
    call DestroyGroup(g2)
    set g=null
    set g2=null
    set u1=null
    set u2=null
    
endfunction

//===========================================================================
function InitTrig_ChoseLich takes nothing returns nothing
    set gg_trg_ChoseLich=CreateTrigger()
    call DisableTrigger(gg_trg_ChoseLich)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ChoseLich, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_ChoseLich, Condition(function Trig_ChoseLich_Conditions))
    call TriggerAddAction(gg_trg_ChoseLich, function Trig_ChoseLich_Actions)
endfunction


//===========================================================================
// Trigger: ChoseUnits2
//===========================================================================
function Trig_ChoseUnits2_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0SX'
endfunction

function OnlyOrganic takes nothing returns boolean
    return GetUnitTypeId(GetFilterUnit()) == 'e02W' and not IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON)
endfunction





function Trig_ChoseUnits2_Actions takes nothing returns nothing
    local group g= CreateGroup()
    set udg_LocalPosition2=GetUnitLoc(GetTriggerUnit())
    set udg_LocalPosition3=GetSpellTargetLoc()
    set udg_Boolexpr=Condition(function OnlyOrganic)
    call GroupEnumUnitsInRange(g, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 400, udg_Boolexpr)
    call GroupPointOrder(g, "attack", GetSpellTargetX(), GetSpellTargetY())
    
    call DestroyGroup(g)
    set g=null
endfunction

//===========================================================================
function InitTrig_ChoseUnits2 takes nothing returns nothing
    set gg_trg_ChoseUnits2=CreateTrigger()
    call DisableTrigger(gg_trg_ChoseUnits2)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ChoseUnits2, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_ChoseUnits2, Condition(function Trig_ChoseUnits2_Conditions))
    call TriggerAddAction(gg_trg_ChoseUnits2, function Trig_ChoseUnits2_Actions)
endfunction


