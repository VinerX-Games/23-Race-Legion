//===========================================================================
// Trigger: Undermining
//
// Abilities\Spells\Undead\Impale\ImpaleMissTarget.mdl
//===========================================================================
// ПЕРЕМЕННЫЕ ГЛОБАЛЬНЫЕ МЕНЯТЬ ТОЛЬКО ТУТ
//===================================================================================================================================
// основаня функция, тут ничего менять не нужно
//===================================================================================================================================

//================================================================================================================================================================================
// Этам 0 - доп функции
//================
function UnUgolMT takes real x1,real x2,real y1,real y2 returns real
    return bj_RADTODEG * Atan2(y2 - y1, x2 - x1)
endfunction

function UnRastMT takes real x1,real x2,real y1,real y2 returns real
    local real dx= x2 - x1
    local real dy= y2 - y1
    return SquareRoot(dx * dx + dy * dy)
endfunction

//function UnParabolaZ takes real h, real d, real x returns real
 // return (4 * h / d) * (d - x) * (x / d)
//endfunction
//h - максимальная высота в прыжке на середине расстояния (x = d / 2),
//d - общее расстояние до цели
//x - расстояние от исходной цели до точки, где следует взять высоту по параболе.

//================================================================================================================================================================================
// Этам 1 - проверка скила
//================
function Trig_Undermining_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == UnSkill
endfunction
//================================================================================================================================================================================
// Этам 3 - подбрасываем врагов
//================
function Trig_Undermining_move_units takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer h= GetHandleId(t)
    local unit GT= LoadUnitHandle(Hash, h, 1)
    local unit un= LoadUnitHandle(Hash, h, 2)
    local integer kol= LoadInteger(Hash, h, 3)
    local integer lvl
    local real uron
    //-------
    call SetUnitFlyHeight(un, kol * 20, 0)
    if LoadBoolean(Hash, h, 4) then
        set kol=kol + 1
        call SaveInteger(Hash, h, 3, kol)
        if kol >= 25 then
            call SaveBoolean(Hash, h, 4, false)
        endif
    else
        set kol=kol - 1
        call SaveInteger(Hash, h, 3, kol)
        if kol <= 1 then
            call SetUnitFlyHeight(un, 0, 0)
            call DestroyTimer(t)
            call FlushChildHashtable(Hash, h)
            set lvl=GetUnitAbilityLevel(GT, UnSkill)
            set uron=UnKofDmg1 * lvl * GetHeroStr(GT, true) + lvl * UnKofDmg2
            call UnitDamageTarget(GT, un, uron, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_UNIVERSAL, WEAPON_TYPE_WHOKNOWS)
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl", un, "orign"))
        endif
    endif
    //-------
    set GT=null
    set un=null
endfunction

//================================================================================================================================================================================
// Этам 2 - двигаем героя
//================
function Trig_Undermining_move_hero takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer h= GetHandleId(t)
    local unit GT= LoadUnitHandle(Hash, h, 1)
    local real l= LoadReal(Hash, h, 2)
    local group g= LoadGroupHandle(Hash, h, 3)
    local real x1= LoadReal(Hash, h, 4)
    local real y1= LoadReal(Hash, h, 5)
    local real dx= GetUnitX(GT)
    local real dy= GetUnitY(GT)
    local group gg= CreateGroup()
    local unit un
    local real x
    local real y
    local real ugol= UnUgolMT(dx , x1 , dy , y1)
    local timer t1
    local integer h1
    //-------
    set x=dx + 70 * Cos(ugol * bj_DEGTORAD) //вычисляем следующий х
    set y=dy + 70 * Sin(ugol * bj_DEGTORAD) //вычисляем следующий у
    //set w = UnParabolaZ(500, l, UnRastMT(x, x1, y, y1)) //вычисляем высоту
    // ищем конец пути
    if UnRastMT(x1 , dx , y1 , dy) > 70 and not IsTerrainPathable(x, y, PATHING_TYPE_FLYABILITY) then
        // двигаем юнита
        call SetUnitX(GT, x)
        call SetUnitY(GT, y)
        call SetUnitFacing(GT, ugol)
        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\Impale\\ImpaleMissTarget.mdl", x, y))
        //------------------------------------
        // записываем юнитов в группу и подбрасываем их
        call GroupEnumUnitsInRange(gg, x, y, 150, null)
        loop
            set un=FirstOfGroup(gg)
            exitwhen un == null
            if not IsUnitType(un, UNIT_TYPE_STRUCTURE) and IsUnitEnemy(un, GetOwningPlayer(GT)) and not IsUnitType(un, UNIT_TYPE_DEAD) and not IsUnitType(un, UNIT_TYPE_FLYING) and not IsUnitInGroup(un, g) then
                //call BJDebugMsg("Подбросил")
                call UnitAddAbility(un, 'Amrf')
                call UnitRemoveAbility(un, 'Amrf')
                set t1=CreateTimer()
                set h1=GetHandleId(t1)
                call SaveUnitHandle(Hash, h1, 1, GT)
                call SaveUnitHandle(Hash, h1, 2, un)
                call SaveInteger(Hash, h1, 3, 1)
                call SaveBoolean(Hash, h1, 4, true)
                call GroupAddUnit(g, un)
                call TimerStart(t1, 0.01, true, function Trig_Undermining_move_units)
            endif
            call GroupRemoveUnit(gg, un)
        endloop
        //---------------------------------------
    else
        //call BJDebugMsg("Закончился скилл")
        call DestroyGroup(g)
        call DestroyTimer(t)
        call FlushChildHashtable(Hash, h)
        call SetUnitFlyHeight(GT, 0, 0)
        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl", dx, dy))
        call PauseUnit(GT, false)
        call ShowUnit(GT, true)
        call SelectUnitAddForPlayer(GT, GetOwningPlayer(GT))
    endif
    //-------
    set GT=null
    set un=null
    set g=null
    set t=null
    call DestroyGroup(gg)
    set gg=null
    set t1=null
endfunction

//================================================================================================================================================================================
// Этам 2 - основная функция
//================
function Trig_Undermining_Actions takes nothing returns nothing
    local unit GT= GetTriggerUnit()
    local timer t= CreateTimer()
    local integer h= GetHandleId(t)
    local real x= GetUnitX(GT)
    local real y= GetUnitY(GT)
    local real x1= GetSpellTargetX()
    local real y1= GetSpellTargetY()
    local real l= UnRastMT(x , x1 , y , y1)
    //-------
    //call BJDebugMsg("Начался скилл")
    call SaveUnitHandle(Hash, h, 1, GT)
    call SaveReal(Hash, h, 2, l)
    // проигрываем звук
    call SetSoundPosition(gg_snd_ImpaleHit, x, y, 0)
    call SetSoundVolume(gg_snd_ImpaleHit, PercentToInt(100, 127))
    call PlaySoundBJ(gg_snd_ImpaleHit)
    //----
    call SaveGroupHandle(Hash, h, 3, CreateGroup())
    call SaveReal(Hash, h, 4, x1)
    call SaveReal(Hash, h, 5, y1)
    call PauseUnit(GT, true)
    call ShowUnit(GT, false)
    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl", x, y))
    call TimerStart(t, 0.055, true, function Trig_Undermining_move_hero) //стартуем движение героя
    //-------
    set GT=null
    set t=null
endfunction

//===========================================================================
function InitTrig_Undermining takes nothing returns nothing
    set gg_trg_Undermining=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Undermining, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Undermining, Condition(function Trig_Undermining_Conditions))
    call TriggerAddAction(gg_trg_Undermining, function Trig_Undermining_Actions)
endfunction


//===========================================================================
// Trigger: PassiveAdal
//===========================================================================
function Trig_PassiveAdal_Conditions takes nothing returns boolean
    return GetUnitAbilityLevel(GetTriggerUnit(), 'B084') > 0 and not IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) and GetEventDamage() >= GetUnitState(GetTriggerUnit(), UNIT_STATE_LIFE) //Её бафф
endfunction

function Adal takes nothing returns boolean
    return GetUnitAbilityLevel(GetFilterUnit(), 'A1L6') > 0 //Абилка
endfunction

function Trig_PassiveAdal_Actions takes nothing returns nothing
    local group g= CreateGroup()
    local unit u= GetTriggerUnit()
    local unit u2
    call GroupEnumUnitsInRangeCounted(g, GetUnitX(u), GetUnitY(u), 500, Condition(function Adal), 1)
    set u2=FirstOfGroup(g)

    if GetRandomInt(1, 4) + 0.25 * GetUnitAbilityLevel(u2, 'A1L6') > 3 and GetUnitState(u2, UNIT_STATE_MANA) > 50 then //Абилка
        call SetUnitManaBJ(u2, GetUnitState(u2, UNIT_STATE_MANA) - 50)
        call SetUnitLifePercentBJ(u, 50)
        call RemoveEffectTimed(AddSpecialEffect("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl", GetUnitX(u), GetUnitY(u)) , 3)
    endif
    
    call DestroyGroup(g)

    set g=null
    set u=null
    set u2=null
endfunction

//===========================================================================
function InitTrig_PassiveAdal takes nothing returns nothing
    set gg_trg_PassiveAdal=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_PassiveAdal, EVENT_PLAYER_UNIT_DAMAGING)
    call TriggerAddCondition(gg_trg_PassiveAdal, Condition(function Trig_PassiveAdal_Conditions))
    call TriggerAddAction(gg_trg_PassiveAdal, function Trig_PassiveAdal_Actions)
endfunction


