function Trig_Player2VassalTo1_Back_Actions takes nothing returns nothing
    call SetPlayerAllianceStateBJ(Player(1), Player(0), bj_ALLIANCE_UNALLIED)
endfunction

//===========================================================================
function InitTrig_Player2VassalTo1_Back takes nothing returns nothing
    set gg_trg_Player2VassalTo1_Back=CreateTrigger()
    call TriggerRegisterPlayerChatEvent(gg_trg_Player2VassalTo1_Back, Player(0), "b2", true)
    call TriggerAddAction(gg_trg_Player2VassalTo1_Back, function Trig_Player2VassalTo1_Back_Actions)
endfunction

//===========================================================================
// Trigger: Player3VassalTo1
//===========================================================================
function Trig_Player3VassalTo1_Actions takes nothing returns nothing
    call SetPlayerAllianceStateBJ(Player(2), Player(0), bj_ALLIANCE_ALLIED_ADVUNITS)
endfunction

