function aiNavalTrain_Common takes unit u,integer pi returns nothing
    if Random(1 , 2) and LoadInteger(AiData, pi, 'h00Y') < 50 then
        call IssueImmediateOrderById(u, 'h00Y')
    elseif LoadInteger(AiData, pi, 'h00Z') < 75 then
        call IssueImmediateOrderById(u, 'h00Z')
    endif
endfunction
                
                
                
