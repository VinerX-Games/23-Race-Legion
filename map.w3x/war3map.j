//===========================================================================
// Trigger: Upgrade Income
//===========================================================================
function Trig_Upgrade_Income_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0VM' and IsUnitSelected(GetTriggerUnit(), GetOwningPlayer(GetTriggerUnit()))
endfunction

function Trig_Upgrade_Income_Actions takes nothing returns nothing
    local integer pi= GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
    call UnitAddAbility(GetTriggerUnit(), 'A0VS')
    
    
    //Добавляю инком
    set income[pi]=income[pi] + 100
    call UpdateGraf(pi)
    
    
    call UnitRemoveAbility(GetTriggerUnit(), 'A0VJ')
    
    call UnitAddAbilityBJ('A1M5', GetTriggerUnit())
    call BlzStartUnitAbilityCooldown(GetTriggerUnit(), 'A1M5', 5)
    call RemoveAbilityTimed(GetTriggerUnit() , 'A1M5' , 5)
    call AddAbilityTimed(GetTriggerUnit() , 'A146' , 5)
endfunction

//===========================================================================
function InitTrig_Upgrade_Income takes nothing returns nothing
    set gg_trg_Upgrade_Income=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Upgrade_Income, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Upgrade_Income, Condition(function Trig_Upgrade_Income_Conditions))
    call TriggerAddAction(gg_trg_Upgrade_Income, function Trig_Upgrade_Income_Actions)
endfunction


//===========================================================================
// Trigger: Demontag
//===========================================================================
function Trig_Demontag_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A146' and IsUnitSelected(GetTriggerUnit(), GetOwningPlayer(GetTriggerUnit()))
endfunction

function Trig_Demontag_Actions takes nothing returns nothing
    local integer pi= GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
    call UnitRemoveAbility(GetTriggerUnit(), 'A146')
    call UnitAddAbility(GetTriggerUnit(), 'A0VJ')
    if GetUnitAbilityLevel(GetTriggerUnit(), 'A0VS') == 1 then
        set income[pi]=income[pi] - 100
        call UnitRemoveAbility(GetTriggerUnit(), 'A0VS')
    endif
    
    call UnitRemoveAbility(GetTriggerUnit(), 'A1C2')
    call UnitRemoveAbility(GetTriggerUnit(), 'A0VR')
    call UnitRemoveAbility(GetTriggerUnit(), 'A0VT')
    call UnitRemoveAbility(GetTriggerUnit(), 'A0MK')
endfunction

//===========================================================================
function InitTrig_Demontag takes nothing returns nothing
    set gg_trg_Demontag=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Demontag, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Demontag, Condition(function Trig_Demontag_Conditions))
    call TriggerAddAction(gg_trg_Demontag, function Trig_Demontag_Actions)
endfunction


//===========================================================================
// Trigger: ResoursesInterface Copy
//===========================================================================
function Trig_ResoursesInterface_Copy_Actions takes nothing returns nothing
    
    local player p= GetLocalPlayer()
    local integer pi= GetPlayerId(p)
    local string text
    local string text2
    local real other= corruption[pi] + additional[pi]
    
    //if DisOn then
      //  call BlzFrameSetText(BlzGetFrameByName("Income0202",0), I2S(R2I(disincome[pi])))
   // else
       // call BlzFrameSetText(BlzGetFrameByName("Income0202",0), "|cffffff00"+I2S(R2I(disincome[pi]))+"(0)|r" )
   // endif
    
    
    if balance[pi] > 0 then
        call BlzFrameSetText(IncomeTextFr, "|cffbeffa0" + I2S(R2I(balance[pi])))
        call BlzFrameSetText(tooltipTitle, "|cffbeffa0Профицит")
    elseif balance[pi] == 0 then
        call BlzFrameSetText(IncomeTextFr, I2S(R2I(balance[pi])))
        call BlzFrameSetText(tooltipTitle, "Нулевой баланс")
    else
        call BlzFrameSetText(IncomeTextFr, "|cffffb4a0" + I2S(R2I(balance[pi])))
        call BlzFrameSetText(tooltipTitle, "|cffffb4a0Дефицит")
    endif
    //set balance[pi]=income[pi]-disincome[pi]+corruption[pi]-logistic[pi]+additional[pi]
    
    
    //Цифры
    set text="|cffbeffa0" + I2S(R2I(income[pi])) + "*(" + R2S(IncomeMod) + "-" + R2S(AllyTax[pi]) + ")|r-(|cffffb4a0" + I2S(R2I(disincome[pi])) + "|r+|cffffb4a0" + I2S(R2I(logistic[pi])) + "|r)"
    if GetPlayerTechCount(p, 'R07E', true) > 0 then
        set text=text + " + " + I2S(R2I(corruption[pi]))
    endif
    if GetPlayerTechCount(p, 'R0DV', true) + GetPlayerTechCount(p, 'R0GZ', true) > 0 then
        set text=text + " и " + I2S(R2I(additional[pi]))
    endif
    
    //Пояснение
    set text2="|n|cffbeffa0Доходы * Мод. Базы и Союза|r - (|cffffb4a0Расходы|r+|cffffb4a0Логистика|r)"
    if GetPlayerTechCount(p, 'R07E', true) > 0 then
        set text2=text2 + "+коррупция"
    endif
    
    if GetPlayerTechCount(p, 'R0DV', true) + GetPlayerTechCount(p, 'R0GZ', true) > 0 then
        set text2=text2 + " и дополнительно"
    endif
    //set text = "Доход("+R2S(income[pi])+")-Расход("+R2S()+")|n-Логистика("+R2S(logistic[pi])+")"+"|n прочие элементы в разработке"
    call BlzFrameSetText(tooltipBody, text + text2)
    
    
    set text=null
    set p=null
endfunction

//===========================================================================
function InitTrig_ResoursesInterface_Copy takes nothing returns nothing
    set gg_trg_ResoursesInterface_Copy=CreateTrigger()
    call TriggerRegisterTimerEvent(gg_trg_ResoursesInterface_Copy, 0.10, true)
    call TriggerAddAction(gg_trg_ResoursesInterface_Copy, function Trig_ResoursesInterface_Copy_Actions)
endfunction
