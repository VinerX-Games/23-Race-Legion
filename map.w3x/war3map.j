//===========================================================================
// Trigger: ChangeAutoWorkers
//===========================================================================
function Trig_ChangeAutoWorkers_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A1L9'
endfunction

function Trig_ChangeAutoWorkers_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local integer lvl= GetUnitAbilityLevel(u, 'A1L9')
    if lvl == 1 then
        call SetUnitAbilityLevel(u, 'A1L9', 2)
        call UnitAddAbility(u, 'cDA9')
        call UnitRemoveAbility(u, 'cDa4')
        call BlzStartUnitAbilityCooldown(u, 'cDA9', 30)
    else
        call SetUnitAbilityLevel(u, 'A1L9', 1)
        call UnitAddAbility(u, 'cDa4')
        call UnitRemoveAbility(u, 'cDA9')
        call BlzStartUnitAbilityCooldown(u, 'cDa4', 30)
    endif
    call IssueImmediateOrder(u, "raisedeadon")
    set u=null
endfunction

//===========================================================================
function InitTrig_ChangeAutoWorkers takes nothing returns nothing
    set gg_trg_ChangeAutoWorkers=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ChangeAutoWorkers, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_ChangeAutoWorkers, Condition(function Trig_ChangeAutoWorkers_Conditions))
    call TriggerAddAction(gg_trg_ChangeAutoWorkers, function Trig_ChangeAutoWorkers_Actions)
endfunction


