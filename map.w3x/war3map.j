function InitTrig_SecondChance takes nothing returns nothing
    set gg_trg_SecondChance=CreateTrigger()
    call TriggerRegisterPlayerChatEvent(gg_trg_SecondChance, Player(0), "-raceselect", false)
    call TriggerAddAction(gg_trg_SecondChance, function Trig_SecondChance_Actions)
endfunction

