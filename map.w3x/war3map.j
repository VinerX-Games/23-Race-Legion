function Trig_MassSglaz_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A1E0'
endfunction


function Trig_MassSglaz_Actions takes nothing returns nothing
    local location l= GetSpellTargetLoc()
    local player p= GetOwningPlayer(GetTriggerUnit())
    local boolexpr bex
    local integer level= GetUnitAbilityLevel(GetTriggerUnit(), 'A1E0')
    local group g= CreateGroup()
    local unit u
    local unit u2
    local integer i= 0
    set udg_LocalPlayer=p
    set bex=Condition(function EnemEl)
    call GroupEnumUnitsInRangeOfLoc(g, l, 110 + 50 * level, bex)
    
    call RemoveLocation(l)
    set l=GetUnitLoc(GetTriggerUnit())
    loop
        set u=FirstOfGroup(g)
        exitwhen u == null
        
        set u2=CreateUnitAtLoc(p, 'H0BN', l, bj_UNIT_FACING)
        call RemoveUnitTimed(u2 , 2)
        call UnitAddAbility(u2, 'A1E1')
        call SetUnitManaBJ(u2, 1111111.00)
        //call SetUnitAbilityLevel( u2,'A17Z', level )
        call IssueTargetOrder(u2, "hex", u)
        
        set i=i + 1
        call GroupRemoveUnit(g, u)
    endloop
    
    
    set u=null
    call DestroyGroup(g)
    set g=null
    call RemoveLocation(l)
    set p=null
    call DestroyBoolExpr(bex)
    set u2=null
    set bex=null
endfunction

