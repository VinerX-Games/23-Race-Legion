    set gg_trg_Emerald_Dream_TP_OFF_O=CreateTrigger()
    call TriggerRegisterLeaveRectSimple(gg_trg_Emerald_Dream_TP_OFF_O, gg_rct_EmeraldDream)
    call TriggerAddAction(gg_trg_Emerald_Dream_TP_OFF_O, function Trig_Emerald_Dream_TP_OFF_O_Actions)
endfunction

//===========================================================================
// Trigger: NoAttackGreen
//===========================================================================
function Trig_NoAttackGreen_Conditions takes nothing returns boolean
    return GetUnitAbilityLevel(GetAttacker(), 'A0LR') > 0 and GetUnitAbilityLevel(GetTriggerUnit(), 'A1LR') > 0 // or GetUnitAbilityLevel( GetTriggerUnit(),'A0LR')>0 and GetUnitAbilityLevel( GetAttacker(),'A1LR')>0
endfunction

function Trig_NoAttackGreen_Actions takes nothing returns nothing
    call IssueImmediateOrder(GetAttacker(), "stop")
endfunction

//===========================================================================
function InitTrig_NoAttackGreen takes nothing returns nothing
    local timer t= CreateTimer()
    set gg_trg_NoAttackGreen=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_NoAttackGreen, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_NoAttackGreen, Condition(function Trig_NoAttackGreen_Conditions))
    call TriggerAddAction(gg_trg_NoAttackGreen, function Trig_NoAttackGreen_Actions)
    call TimerStart(t, 150, true, function checkGreenArea)
endfunction


