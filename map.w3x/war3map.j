//===========================================================================
// Trigger: StartG
//===========================================================================
function Trig_StartG_Func001A takes nothing returns nothing
    call SetPlayerTechResearchedSwap('R04O', 1, GetEnumPlayer())
    call SetPlayerAbilityAvailableBJ(false, 'A0AT', GetEnumPlayer())
