    set gg_trg_DamageBeforeW2=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_DamageBeforeW2, EVENT_PLAYER_UNIT_DAMAGING)
    call TriggerAddCondition(gg_trg_DamageBeforeW2, Condition(function Trig_DamageBeforeW2_Conditions))
