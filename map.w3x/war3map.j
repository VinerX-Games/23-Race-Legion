//===========================================================================

function Trig_Leave_Army_U_Conditions takes nothing returns boolean
    set gUnit=GetTriggerUnit()
    set gPi=GetPlayerId(GetOwningPlayer(gUnit))
    return IsUnitInGroup(gUnit, udg_Ai_army[gPi]) and not IsUnitType(gUnit, UNIT_TYPE_HERO)
endfunction

function Trig_Leave_Army_U_Actions takes nothing returns nothing
    call GroupRemoveUnit(udg_Ai_army[gPi], gUnit)
    call GroupRemoveUnit(udg_Ai_units[gPi], gUnit)
    call NumberRem(gPi , GetUnitTypeId(gUnit))
    call NumberRem(gPi , StringHash("Number"))
    
    
    call SetUnitLifeBJ(gUnit, 0)
    if not IsUnitInGroup(gUnit, DeadGroupAi) then
        call GroupAddUnit(DeadGroupAi, gUnit)
        call TriggerRegisterUnitStateEvent(gg_trg_UnitReviveAi, gUnit, UNIT_STATE_LIFE, GREATER_THAN, 0.01)
    endif
    
endfunction

