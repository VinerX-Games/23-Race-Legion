function CheckAndCreateCapital takes player p returns nothing
    local unit u
    local group g= CreateGroup()
    call GroupEnumUnitsOfPlayer(g, p, Condition(function Capitals))
    if BlzGroupGetSize(g) == 0 then //Столицы нет
    
        call GroupClear(g)
        set Counter=0
        call GroupEnumUnitsOfPlayer(g, p, Condition(function HaveCapitalAbility))
        
        if BlzGroupGetSize(g) > 0 then
            set u=BlzGroupUnitAt(g, GetRandomInt(0, BlzGroupGetSize(g) - 1))
            call SetPlayerAbilityAvailable(p, 'A0IQ', false)
            call MakeCapital(u)
            call DisplayTimedTextToForce(udg_AllPlayers, 5, ( GetPlayerName(p) + " - |cffffff00почти проиграл|r|r, его |cffd45e19столица|r не не была построена ко времени, а потому была установлена автоматически." ))
        else
            if GetPlayerSlotState(p) == PLAYER_SLOT_STATE_PLAYING then
                call DisplayTimedTextToForce(udg_AllPlayers, 5, ( GetPlayerName(p) + " - |cffff0000проиграл|r, его |cffd45e19столица |r не построена ко времени. :(" ))
            endif
            
            call ClearPlayer(p)
            
        endif
        //call DisplayTextToPlayer(Player(0),0,0,"Тестирование: Игрок "+GetPlayerName(p)+"  не имеет столицу")
    else
    
        //call DisplayTextToPlayer(Player(0),0,0,"Тестирование: Игрок "+GetPlayerName(p)+"  имеет столицу")
    endif
    
    
    
    set u=null
    call DestroyGroup(g)
    set g=null
    
endfunction



function AllPlayersCapital takes nothing returns nothing
    call CheckAndCreateCapital(GetEnumPlayer())
endfunction

function Trig_StolicaTime_Actions takes nothing returns nothing
    call ForForce(udg_AllPlayers, function AllPlayersCapital)
    call ForForce(udg_Bots, function AllPlayersCapital)
    //call DisplayTextToPlayer(Player(0),0,0,"Тестирование: поток не отрубился")
endfunction

