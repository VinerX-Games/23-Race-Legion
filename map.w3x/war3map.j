//===========================================================================
function Trig_Brac_Func002Func002C takes nothing returns boolean
    if ( ( GetUnitAbilityLevelSwapped('A0A6', GetAttacker()) == 1 ) ) then
        return true
    endif
    if ( ( GetUnitAbilityLevelSwapped('A0A6', GetAttacker()) == 2 ) ) then
        return true
    endif
    if ( ( GetUnitAbilityLevelSwapped('A0A6', GetAttacker()) == 3 ) ) then
        return true
    endif
    if ( ( GetUnitAbilityLevelSwapped('A0A6', GetAttacker()) == 4 ) ) then
        return true
    endif
    if ( ( GetUnitAbilityLevelSwapped('A0A6', GetAttacker()) == 5 ) ) then
        return true
    endif
    return false
endfunction

function Trig_Brac_Func002C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B028') == true ) ) then
        return false
    endif
    if ( not Trig_Brac_Func002Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Brac_Conditions takes nothing returns boolean
    if ( not Trig_Brac_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Brac_Actions takes nothing returns nothing
    local texttag t
    call CreateTextTagUnitBJ("TRIGSTR_7336", GetAttacker(), - 20.00, 5.00, 100, 100, 100, 0.00)
    set udg_LocalText=GetLastCreatedTextTag()
    call SetTextTagPermanentBJ(udg_LocalText, false)
    call SetTextTagLifespanBJ(udg_LocalText, 2.00)
    call SetTextTagFadepointBJ(udg_LocalText, 2.00)
    call SetTextTagVelocityBJ(udg_LocalText, 75.00, 90)
    set t=udg_LocalText
    call TriggerSleepAction(2.00)
    set udg_LocalText=t
    call DestroyTextTagBJ(udg_LocalText)
    set t=null
endfunction

