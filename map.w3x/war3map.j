// Общие функции


function isUnitInNoWaterArea takes real x,real y returns boolean
    return RectContainsCoords(gg_rct_NoWater1, x, y) or RectContainsCoords(gg_rct_NoWater2, x, y) or RectContainsCoords(gg_rct_NoWater3, x, y)
endfunction

function isUnitWaterRelated takes unit u returns boolean
    return IsUnitInGroup(u, udg_CityNearWater) or IsUnitInGroup(u, Navy) or IsUnitInGroup(u, Port)
endfunction



//  --------------    Функции для фильтров     --------------
function f_EnemyUnitP takes nothing returns boolean
    local unit u= GetFilterUnit()
    local player p= GetOwningPlayer(u)
    if UnitAlive(u) and IsPlayerEnemy(p, CheckPlayer) or WaygateIsActive(u) and not ( IsUnitInGroup(u, Navy) or GetUnitAbilityLevel(u, 'A1MS') > 0 ) then // A1MS Стр точка
        set Counter=Counter + 1
        if IsUnitInGroup(u, udg_StolicaGroups) then
            set EnemyCapital=u
        endif
        set u=null
        return true
    else
        set u=null
        return false
    endif
endfunction

function f_EnemyUnit takes nothing returns boolean
    local unit u= GetFilterUnit()
    if UnitAlive(u) and IsPlayerEnemy(GetOwningPlayer(u), CheckPlayer) and not ( WaygateIsActive(u) or IsUnitInGroup(u, Navy) or GetUnitAbilityLevel(u, 'A1MS') > 0 ) then
        set Counter=Counter + 1
        if IsUnitInGroup(u, udg_StolicaGroups) then
            set EnemyCapital=u
        endif
        set u=null
        return true
    endif
    return false
endfunction

// Цель для флота
function f_EnemyUnitN takes nothing returns boolean
    local unit u= GetFilterUnit()
    local player p= GetOwningPlayer(u)
    local real x= GetUnitX(u)
    local real y= GetUnitY(u)
    
    if UnitAlive(u) and IsPlayerEnemy(p, CheckPlayer) and isUnitWaterRelated(u) and not ( isUnitInNoWaterArea(x , y) or WaygateIsActive(u) ) then
        set u=null
        set Counter=Counter + 1
        return true
    else
        set u=null
        return false
    endif
    
    
endfunction

function f_ToHeal takes nothing returns boolean
    local unit u= GetFilterUnit()
    if IsPlayerAlly(GetOwningPlayer(u), CheckPlayer) and IsUnitIdType(GetUnitTypeId(u), UNIT_TYPE_MECHANICAL) != true then
        set u=null
        return true
    else
        set u=null
        return false
    endif
    
endfunction



//Гланый фильтр для войск, кому надо отдать приказ
function f_Lazy takes nothing returns boolean
    set gUnit=GetFilterUnit()
    set gInt=GetUnitCurrentOrder(gUnit)
        
    if UnitAlive(gUnit) and IsUnitInGroup(gUnit, udg_Ai_army[GetPlayerId(GetOwningPlayer(gUnit))]) and ( gInt == 851972 or gInt == 851976 or gInt == 0 ) and not ( IsUnitType(gUnit, UNIT_TYPE_PEON) or IsUnitType(gUnit, UNIT_TYPE_STRUCTURE) ) then // // and ( gInt ==  851972 or gInt == 851976 or gInt == 0 ) and /*
        set LazyCount=LazyCount + 1
        return true
    else
        return false
    endif
endfunction


//Тоже самое + проверка игрка так как тут жля радиуса
function f_LazyF takes nothing returns boolean
    set gUnit=GetFilterUnit()
    set gInt=GetUnitCurrentOrder(gUnit)
    return UnitAlive(gUnit) and IsUnitInGroup(gUnit, udg_Ai_army[GetPlayerId(CheckPlayer)]) and ( gInt == 851972 or gInt == 851976 or gInt == 0 ) and not ( IsUnitType(gUnit, UNIT_TYPE_PEON) or IsUnitType(gUnit, UNIT_TYPE_STRUCTURE) ) //  //and ( gInt ==  851972 or gInt == 851976 or gInt == 0 ) 

endfunction


function f_LazyN takes nothing returns boolean
    set gUnit=GetFilterUnit()
    set gInt=GetUnitCurrentOrder(gUnit)
    
    if UnitAlive(gUnit) and IsUnitInGroup(gUnit, udg_Ai_navy[GetPlayerId(CheckPlayer)]) and ( gInt == 851972 or gInt == 851976 or gInt == 0 ) then
        set LazyCount=LazyCount + 1
        return true
    else
        return false
    endif

endfunction

function f_FixZ takes nothing returns boolean
   return GetUnitCurrentOrder(GetFilterUnit()) == 851983
endfunction

function f_FixUnvul takes nothing returns boolean
   return BlzIsUnitInvulnerable(GetFilterUnit())
   //return GetUnitAbilityLevel(GetFilterUnit(),'Bvul')>0
endfunction

function f_LazyW takes nothing returns boolean
    set gUnit=GetFilterUnit()
    set gInt=GetUnitCurrentOrder(gUnit)
    return UnitAlive(gUnit) and IsUnitInGroup(gUnit, udg_Ai_builders[GetPlayerId(GetOwningPlayer(gUnit))]) and ( gInt == 851972 or gInt == 851976 or gInt == 0 )
endfunction

function f_LazyT takes nothing returns boolean
    set gUnit=GetFilterUnit()
    set gInt=GetUnitCurrentOrder(gUnit)
    return UnitAlive(gUnit) and IsUnitInGroup(gUnit, udg_Ai_buildersT[GetPlayerId(GetOwningPlayer(gUnit))]) and ( gInt == 851972 or gInt == 851976 or gInt == 0 )
endfunction

function f_PortB takes nothing returns boolean
    return IsUnitInGroup(GetFilterUnit(), AiUnitsToPort[CheckId])
endfunction

function f_Worker takes nothing returns boolean
    set gUnit=GetFilterUnit()
    return UnitAlive(gUnit) and IsUnitInGroup(gUnit, udg_Ai_buildersT[GetPlayerId(GetOwningPlayer(gUnit))])
endfunction

function f_Harwest takes nothing returns boolean
    set gUnit=GetFilterUnit()
    if UnitAlive(gUnit) and IsUnitInGroup(gUnit, udg_Ai_harvest[GetPlayerId(GetOwningPlayer(gUnit))]) then
        return true
    else
        return false
    endif
endfunction

function f_InAiArmy takes nothing returns boolean
    set gUnit=GetFilterUnit()
    return UnitAlive(gUnit) and IsUnitInGroup(gUnit, udg_Ai_army[GetPlayerId(GetOwningPlayer(gUnit))])
endfunction

function f_InAiNavy takes nothing returns boolean
    set gUnit=GetFilterUnit()
    return UnitAlive(gUnit) and IsUnitInGroup(gUnit, udg_Ai_navy[GetPlayerId(GetOwningPlayer(gUnit))])
endfunction


// Здания в которых надо делать найм - без работы, в группе, определенного типа
function f_OnlyNeaded takes nothing returns boolean
    set gUnit=GetFilterUnit()

    if not UnitAlive(gUnit) then
        return false
    endif

    set gPi=GetPlayerId(GetOwningPlayer(gUnit))
    // Проверка на принадлежность к группе сразу
    if not IsUnitInGroup(gUnit, udg_Ai_buildings[gPi]) then
        return false
    endif

    set gInt=GetUnitTypeId(gUnit)
    // Алый орден
    if AiRace[gPi] == "Scarlet" then
        if gInt == 'h05Z' or gInt == 'h05X' or gInt == 'h011' or gInt == 'h064' or gInt == 'h05U' or gInt == 'h068' or gInt == 'h061' or gInt == 'h05W' then
            set Counter=Counter + 1
            return true
        endif
    // Эльфы крови
    elseif AiRace[gPi] == "BloodElves" then
        if gInt == 'h04C' or gInt == 'h04B' or gInt == 'h04K' or gInt == 'h04D' or gInt == 'h05J' or gInt == 'h04G' or gInt == 'h04E' or gInt == 'h011' then
            set Counter=Counter + 1
            return true
        endif
    // Гоблины
    elseif AiRace[gPi] == "Goblins" then
        if gInt == 'h0D7' or gInt == 'o016' or gInt == 'h070' or gInt == 'h079' or gInt == 'h074' or gInt == 'h073' or gInt == 'h076' or gInt == 'h075' then
            set Counter=Counter + 1
            return true
        endif
    // Наги
    elseif AiRace[gPi] == "Naga" then
        if gInt == 'n055' or gInt == 'h0JW' or gInt == 'n04L' or gInt == 'nntt' or gInt == 'nnsg' or gInt == 'nnsa' or gInt == 'nnad' then
            set Counter=Counter + 1
            return true
        endif
    // Орда
    elseif AiRace[gPi] == "Horde" then
        if gInt == 'ogre' or gInt == 'orbr' or gInt == 'obar' or gInt == 'oalt' or gInt == 'obea' or gInt == 'osld' or gInt == 'otto' then
            set Counter=Counter + 1
            return true
        endif
    endif
    return false
endfunction




function f_NavalBases takes nothing returns boolean
    set gUnit=GetFilterUnit()
    set gId=GetUnitTypeId(gUnit)
    
    if UnitAlive(gUnit) and ( gId == 'h011' or gId == 'h0D7' or gId == 'n04L' or gId == 'h0HO' ) then
        set Counter=Counter + 1
        return true
    else
        return false
    endif

endfunction

function f_Hero takes nothing returns boolean
    return IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO)
endfunction

function f_HeroD takes nothing returns boolean
    return IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) and GetUnitState(GetFilterUnit(), UNIT_STATE_LIFE) <= 0
endfunction


function f_LiveHero takes nothing returns boolean
    return GetUnitState(GetFilterUnit(), UNIT_STATE_LIFE) > 0.6 and IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO)
endfunction


//Расовые штуки

//Алый орден
function f_Altars takes nothing returns boolean
    set gUnit=GetFilterUnit()
    set gId=GetUnitTypeId(gUnit)
    return UnitAlive(gUnit) and gId == 'h05X' or gId == 'h05J' or gId == 'o016' or gId == 'nnad' or gId == 'oalt'
endfunction


function MakeHash takes nothing returns nothing

    local integer i= 0
        //call DisplayTimedTextFromPlayer(Player(0),0,0,4, "Залил хеш")
        loop
            exitwhen i == 24
            call SaveInteger(AiData, i, 'h05W', 0)
            call SaveInteger(AiData, i, 'h0ZX', 0)
            call SaveInteger(AiData, i, 'h064', 0)
            call SaveInteger(AiData, i, 'h05Z', 0)
            call SaveInteger(AiData, i, 'h05W', 0)
            call SaveInteger(AiData, i, 'h05Y', 0)
            call SaveInteger(AiData, i, 'h05V', 0)
            call SaveInteger(AiData, i, 'h061', 0)
            call SaveInteger(AiData, i, 'h068', 0)
            call SaveInteger(AiData, i, 'h05W', 0)
            call SaveInteger(AiData, i, 'h062', 0)
            call SaveInteger(AiData, i, 'h060', 0)
            set i=i + 1
        endloop
    //call DisplayTimedTextFromPlayer(Player(0),0,0,4, "Залил хеш 2")
endfunction
//


function SetPortalGroup takes nothing returns nothing
    
    local integer i= 0
        
        loop
            exitwhen i >= 24
            set AiUnitsToPort[i]=CreateGroup()
            set AiCapitalGuard[i]=CreateGroup()
            set AiCapitalBuildigs[i]=CreateGroup()
            set Grades[i]=0
            set i=i + 1
        endloop
endfunction

function AiLimitsSet takes nothing returns nothing
    set gInt=CountPlayersInForceBJ(udg_Bots)
    set AiLimit=IMaxBJ(70, 200 - gInt * 5)
    
    set AiMass=IMaxBJ(8 - gInt, 4)
    set AiRepeat=2 + IMinBJ(R2I(gInt / 2), 8)
    
endfunction

function SetBools takes nothing returns nothing
    //call DisplayTimedTextFromPlayer(Player(1),0,0, 4,"Инициалзиация буллов")

    set Altars=Condition(function f_Altars)
    set ToHeal=Condition(function f_ToHeal)
    set B_LazyW=Condition(function f_LazyW)
    set B_Worker=Condition(function f_Worker)
    set B_LazyT=Condition(function f_LazyT)
    set B_Lazy=Condition(function f_Lazy)
    set B_LazyN=Condition(function f_LazyN)
    set B_LazyF=Condition(function f_LazyF)
    set Harwest=Condition(function f_Harwest)
    set B_OnlyNeaded=Condition(function f_OnlyNeaded)
    set B_NavalBases=Condition(function f_NavalBases)
    set B_Hero=Condition(function f_Hero)
    set B_HeroD=Condition(function f_HeroD)
    set B_InAiArmy=Condition(function f_InAiArmy)
    set B_InAiNavy=Condition(function f_InAiNavy)
    set udg_B_EnemyUnitN=Condition(function f_EnemyUnitN)
    set udg_B_EnemyUnit=Condition(function f_EnemyUnit)
    set udg_B_EnemyUnitP=Condition(function f_EnemyUnitP)
    set PortB=Condition(function f_PortB)
    set FixZ=Condition(function f_FixZ)
    set LiveHero=Condition(function f_LiveHero)
    
    set B_FixUnvul=Condition(function f_FixUnvul)
    
    //call AiPoitsSet()
    call SetPortalGroup()
    call MakeHash()
endfunction


//library AI0 ends
//library ArmyBonus:
function CreateArmyBonusUnit takes player p returns nothing
    set gPi=GetPlayerId(p)
    if ArmyExpBonus[gPi] == null then
        set ArmyExpBonus[gPi]=CreateUnit(p, 'arbo', 0, 0, 0.0)
        call UnitAddAbility(ArmyExpBonus[gPi], 'arb1')
        call UnitAddAbility(ArmyExpBonus[gPi], 'arb0')
    endif

endfunction

//library ArmyBonus ends
//library Global:

    
    //==========================================
    
    function GetPosZ takes real x,real y returns real
        call MoveLocation(Global_TempLoc, x, y)
        return GetLocationZ(Global_TempLoc)
    endfunction
    function GetUnitZ takes unit u returns real
        return GetPosZ(GetUnitX(u) , GetUnitY(u)) + GetUnitFlyHeight(u)
    endfunction
    function SetUnitZ takes unit u,real z returns nothing
        call SetUnitFlyHeight(u, z - GetPosZ(GetUnitX(u) , GetUnitY(u)), 0)
    endfunction
    
    function DistanceBetweenCoords takes real x1,real y1,real x2,real y2 returns real
        return SquareRoot(Pow(x2 - x1, 2) + Pow(y2 - y1, 2))
    endfunction
    function DistanceBetweenWidgetAndCoords takes widget w,real x,real y returns real
        return SquareRoot(Pow(x - GetWidgetX(w), 2) + Pow(y - GetWidgetY(w), 2))
    endfunction
    function DistanceBetweenCoordsAndWidget takes real x,real y,widget w returns real
        return SquareRoot(Pow(GetWidgetX(w) - x, 2) + Pow(GetWidgetY(w) - y, 2))
    endfunction
    function DistanceBetweenWidgets takes widget w1,widget w2 returns real
        return SquareRoot(Pow(GetWidgetX(w2) - GetWidgetX(w1), 2) + Pow(GetWidgetY(w2) - GetWidgetY(w1), 2))
    endfunction
    
    function AngleBetweenCoords takes real x1,real y1,real x2,real y2 returns real
        return Atan2(y2 - y1, x2 - x1) * bj_RADTODEG
    endfunction
    function AngleBetweenWidgetAndCoords takes widget w,real x,real y returns real
        return Atan2(y - GetWidgetY(w), x - GetWidgetX(w)) * bj_RADTODEG
    endfunction
    function AngleBetweenCoordsAndWidget takes real x,real y,widget w returns real
        return Atan2(GetWidgetY(w) - y, GetWidgetX(w) - x) * bj_RADTODEG
    endfunction
    function AngleBetweenWidgets takes widget w1,widget w2 returns real
        return Atan2(GetWidgetY(w2) - GetWidgetY(w1), GetWidgetX(w2) - GetWidgetX(w1)) * bj_RADTODEG
    endfunction
    
    function PolarProjectionX takes real x,real d,real a returns real
        return x + d * Cos(a * bj_DEGTORAD)
    endfunction
    function PolarProjectionY takes real x,real d,real a returns real
        return x + d * Sin(a * bj_DEGTORAD)
    endfunction
    
    function AngleDifference takes real a,real b returns real
        local real r
        if a > 180 then
            set a=a - 360
        elseif a < - 180 then
            set a=a + 360
        endif
        if b > 180 then
            set b=b - 360
        elseif b < - 180 then
            set b=b + 360
        endif
        set r=RMaxBJ(a, b) - RMinBJ(a, b)
        return RMinBJ(r, 360 - r)
    endfunction
    
    function BezierCurves_2C takes real c1,real c2,real t returns real
        local real u= 1 - t
        return c1 * u + c2 * t
    endfunction
    function BezierCurves_3C takes real c1,real c2,real c3,real t returns real
        local real u= 1 - t
        return c1 * u * u + c2 * 2 * t * u + c3 * t * t
    endfunction
    function BezierCurves_4C takes real c1,real c2,real c3,real c4,real t returns real
        local real u= 1 - t
        return c1 * u * u * u + c2 * 3 * t * u * u + c3 * 3 * t * t * u + c4 * t * t * t
    endfunction
    
    //==========================================
    

    function AvalibleUnit takes unit u returns boolean
        return not IsUnitType(u, UNIT_TYPE_STRUCTURE) and not IsUnitType(u, UNIT_TYPE_ANCIENT) and UnitAlive(u)
    endfunction
    function AvalibleUnitAlly takes unit s,unit u returns boolean
        return IsUnitAlly(u, GetOwningPlayer(s)) and AvalibleUnit(u)
    endfunction
    function AvalibleUnitEnemy takes unit s,unit u returns boolean
        return IsUnitEnemy(u, GetOwningPlayer(s)) and AvalibleUnit(u)
    endfunction
    
    function Global___GroupCountUnitsEnum takes nothing returns nothing
        set Global___TempIntArray[1]=Global___TempIntArray[1] + 1
    endfunction
    function GroupCountUnits takes group g returns integer
        set Global___TempIntArray[1]=0
        call ForGroup(g, function Global___GroupCountUnitsEnum)
        return Global___TempIntArray[1]
    endfunction
    
    function Global___GroupRandomUnitEnum takes nothing returns nothing
        set Global___TempIntArray[1]=Global___TempIntArray[1] + 1
        if Global___TempIntArray[1] == Global___TempIntArray[2] then
            set Global___TempUnitArray[1]=GetEnumUnit()
        endif
    endfunction
    function GroupRandomUnit takes group g returns unit
        set Global___TempIntArray[2]=GetRandomInt(1, GroupCountUnits(g))
        set Global___TempIntArray[1]=0
        set Global___TempUnitArray[1]=null
        call ForGroup(g, function Global___GroupRandomUnitEnum)
        return Global___TempUnitArray[1]
    endfunction
    
    function Global___KillDestructablesInRangeEnum takes nothing returns nothing
        if DistanceBetweenWidgetAndCoords(GetEnumDestructable() , Global___TempRealArray[1] , Global___TempRealArray[2]) <= Global___TempRealArray[3] then
            call KillDestructable(GetEnumDestructable())
        endif
    endfunction
    function KillDestructablesInRange takes real x,real y,real r,boolexpr b returns nothing
        set Global___TempRealArray[1]=x
        set Global___TempRealArray[2]=y
        set Global___TempRealArray[3]=r
        call SetRect(Global_TempRect, Global___TempRealArray[1] - r, Global___TempRealArray[2] - r, Global___TempRealArray[1] + r, Global___TempRealArray[2] + r)
        call EnumDestructablesInRect(Global_TempRect, b, function Global___KillDestructablesInRangeEnum)
    endfunction
    
    function InterruptOrderCheck takes integer i returns boolean
        if i == 852002 or i == 852003 or i == 852004 or i == 852005 or i == 852006 or i == 852007 or i == 852537 or i > 1000000 then
            return false
        endif
        return true
    endfunction
    
    function UnitAddPowerUpItem takes unit u,integer id returns boolean
        local item it
        local boolean invAdded= false
        local boolean added= true
        set it=CreateItem(id, GetUnitX(u), GetUnitY(u))
        if GetUnitAbilityLevel(u, 'AInv') == 0 then //AInv -> Inventory
            set invAdded=true
            call UnitAddAbility(u, 'AInv') //AInv -> Inventory
        endif
        if UnitAddItem(u, it) == false then
            set added=false
        elseif GetWidgetLife(it) > 0.00 then
            set added=false
        endif
        call RemoveItem(it)
        if invAdded then
            call UnitRemoveAbility(u, 'AInv') //AInv -> Inventory
        endif
        set it=null
        return added
    endfunction
    
    //==========================================
    
    
        
        function s__StackTemplate_destroy takes integer this returns nothing
            if s__StackTemplate_NOW[this] > 0 then
                set s__StackTemplate_STACK[s__StackTemplate_NOW[this]]=s__StackTemplate_STACK[s__StackTemplate_COUNT]
                set s__StackTemplate_NOW[s__StackTemplate_STACK[s__StackTemplate_NOW[this]]]=s__StackTemplate_NOW[this]
                set s__StackTemplate_STACK[s__StackTemplate_COUNT]=0
                set s__StackTemplate_COUNT=s__StackTemplate_COUNT - 1
            endif
            call s__StackTemplate_deallocate(this)
        endfunction
        
        function s__StackTemplate_create takes nothing returns integer
            local integer this= s__StackTemplate__allocate()
            set s__StackTemplate_COUNT=s__StackTemplate_COUNT + 1
            set s__StackTemplate_STACK[s__StackTemplate_COUNT]=this
            set s__StackTemplate_NOW[s__StackTemplate_STACK[s__StackTemplate_COUNT]]=s__StackTemplate_COUNT
            return this
        endfunction
    
