function Trig_JoinBuildings_Conditions takes nothing returns boolean
    set gTriggerUnit=GetTriggerUnit()
    set gPlayer=GetOwningPlayer(gTriggerUnit)
    set gPi=GetPlayerId(gPlayer)
    return udg_AiControl[gPi]
endfunction

function aiUnitBuildingJoins takes unit structure,integer pi returns nothing
    local integer id= GetUnitTypeId(structure)
    call GroupAddUnit(udg_Ai_buildings[pi], structure)
    call GroupAddUnit(udg_Ai_units[pi], structure)
    call NumberAdd(pi , id)
    
    if playerCapital[pi] != null or DistanceBetweenUnits(playerCapital[pi] , structure) <= 3000 then
        call GroupAddUnit(AiCapitalBuildigs[pi], structure)
    endif
endfunction


function Trig_JoinBuildings_Actions takes nothing returns nothing
    set gConstructingStructure=GetConstructingStructure()
    call aiUnitBuildingJoins(gConstructingStructure , gPi)
endfunction

