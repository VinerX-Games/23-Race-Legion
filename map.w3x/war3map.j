//===========================================================================
// Trigger: K1T4
//===========================================================================
function Trig_K1T4_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTrainedUnit()) == 'otau'
endfunction


function T3Count takes player p returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local integer pi= GetPlayerId(p)
    
    //1 юнит
    set a[0]=0
    
    if GetPlayerTechCount(p, 'R0E9', true) < 1 then
        set b=0
        set i=5
        loop // Таурен
                set a[0]=a[0] + 1
                set a[a[0]]='o01L'
                
                
                set b=b + 1
                exitwhen b >= i
        endloop
    endif
    set b=0
    set i=2
    loop // Огр-воитель
            set a[0]=a[0] + 1
            set a[a[0]]='o01M'
            set b=b + 1
            exitwhen b >= i
    endloop
    
    //Cor Cron
    if GetPlayerTechCount(p, 'R0E0', false) == 1 and GetPlayerTechCount(p, 'R0EH', true) < 1 then
        set i=4
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='o01U'
            
            set b=b + 1
            exitwhen b >= i
        endloop

    endif
    
    //Death knight
    if GetPlayerTechCount(p, 'R0E3', true) == 1 then
        set i=2
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='o021'
            
            set b=b + 1
            exitwhen b >= i
        endloop

    endif
    
    if GetPlayerTechCount(p, 'R0EE', true) == 1 and GetPlayerTechCount(p, 'R0E9', true) != 1 then
        set b=0
        set i=2
        loop //Pandaren
                set a[0]=a[0] + 1
                set a[a[0]]='o02W'
                set b=b + 1
                exitwhen b >= i
        endloop
    endif
    
    
    //Long Containment
    call SaveInteger(CommonHash, pi, StringHash("T3_0"), a[0])
    set i=1
    loop
        
        
        call SaveInteger(CommonHash, pi, StringHash("T3") + i, a[i])
        set i=i + 1
        exitwhen i > a[0]
    endloop
    
    
    
    
endfunction

function Trig_K1T4_Actions takes nothing returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local player p= GetOwningPlayer(GetTriggerUnit())
    local location l= GetUnitRallyPoint(GetTriggerUnit())
    local unit u
    local integer pi= GetPlayerId(p)
    
    
    
    
    
    // 
    set i=LoadInteger(CommonHash, pi, StringHash("T3_0"))
    set i=GetRandomInt(1, i)
    set b=LoadInteger(CommonHash, pi, StringHash("T3") + i)
    //
    
    //Тен Тотем
    if b == 'o01L' and Random(1 , 25) then
        set b='o032'
    endif
    
    call aiFixTrainBefore(GetTrainedUnit() , pi)
    set u=ReplaceUnit(GetTrainedUnit() , b , bj_UNIT_STATE_METHOD_RELATIVE)
    call aiFixTrainAfter(u , pi)
    
//    
//    // Elite Price
//    call UnitAddAbility(u,'A0UX')
//    call SetUnitAbilityLevel(u,'OR00',35+udg_HordeElitePrice[pi])
//    

     
    call UnitAddAbility(u, 'A0YU')


        call IssuePointOrderLoc(u, "attack", l)

    call RemoveLocation(l)
    set p=null
    set u=null
endfunction

//===========================================================================
function InitTrig_K1T4 takes nothing returns nothing
    set gg_trg_K1T4=CreateTrigger()
    call DisableTrigger(gg_trg_K1T4)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_K1T4, EVENT_PLAYER_UNIT_TRAIN_FINISH)
    call TriggerAddCondition(gg_trg_K1T4, Condition(function Trig_K1T4_Conditions))
    call TriggerAddAction(gg_trg_K1T4, function Trig_K1T4_Actions)
endfunction


//===========================================================================
// Trigger: K2T1
//===========================================================================
function Trig_K2T1_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTrainedUnit()) == 'ohun'
endfunction

function K1Count takes player p returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local integer pi= GetPlayerId(p)
    
    //1 юнит
    set a[0]=0
    
    // Troll
    if GetPlayerTechCount(p, 'R0E9', true) < 1 then
        set i=5
        loop
                set a[0]=a[0] + 1
                set a[a[0]]='o01G'
                set b=b + 1
                exitwhen b >= i
        endloop
    endif
    
    //Орк
    set b=0
    set i=2
    loop
            set a[0]=a[0] + 1
            set a[a[0]]='o01X'
            set b=b + 1
            exitwhen b >= i
    endloop
    
    
    
//    if GetPlayerTechCount(p,'R0D1',true) >= 1 then
//        set i = 1 
//        set b = 1
//        
//        loop
//            set a[0] = a[0] + 1
//            set a[ a[0] ] = 'o01E'
//            
//            set b = b + 1
//            exitwhen b >= i
//        endloop
//
//    endif
    
    
    //Long Containment
    call SaveInteger(CommonHash, pi, StringHash("K1_0"), a[0])
    set i=1
    loop
        
        
        call SaveInteger(CommonHash, pi, StringHash("K1") + i, a[i])
        set i=i + 1
        exitwhen i > a[0]
    endloop
    
    
    
    
endfunction

function Trig_K2T1_Actions takes nothing returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local player p= GetOwningPlayer(GetTriggerUnit())
    local location l= GetUnitRallyPoint(GetTriggerUnit())
    local unit u
    local integer pi= GetPlayerId(p)
    
    
    
    // 
    set i=LoadInteger(CommonHash, pi, StringHash("K1_0"))
    set i=GetRandomInt(1, i)
    set b=LoadInteger(CommonHash, pi, StringHash("K1") + i)
    //
    call aiFixTrainBefore(GetTrainedUnit() , pi)
    set u=ReplaceUnit(GetTrainedUnit() , b , bj_UNIT_STATE_METHOD_RELATIVE)
    call aiFixTrainAfter(u , pi)
    
//    
//    call UnitAddAbility(u,'OR00')
//    call SetUnitAbilityLevel(u,'OR00',35+udg_HordeLandPrice[pi])
//    
    
     
    call UnitAddAbility(u, 'A0YU')

    call IssuePointOrderLoc(u, "attack", l)

    call RemoveLocation(l)
    set p=null
    set u=null
endfunction

//===========================================================================
function InitTrig_K2T1 takes nothing returns nothing
    set gg_trg_K2T1=CreateTrigger()
    call DisableTrigger(gg_trg_K2T1)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_K2T1, EVENT_PLAYER_UNIT_TRAIN_FINISH)
    call TriggerAddCondition(gg_trg_K2T1, Condition(function Trig_K2T1_Conditions))
    call TriggerAddAction(gg_trg_K2T1, function Trig_K2T1_Actions)
endfunction


//===========================================================================
// Trigger: K2T2
//===========================================================================
function Trig_K2T2_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTrainedUnit()) == 'o01P'
endfunction

function K2Count takes player p returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local integer pi= GetPlayerId(p)
    
   set a[0]=0
    
    
    
    if GetPlayerTechCount(p, 'R0E9', true) < 1 then
        set i=4
        // Troll
        loop
                set a[0]=a[0] + 1
                set a[a[0]]='otbk'
                set b=b + 1
                exitwhen b >= i
        endloop
    
    endif
    
    // black mountain orc
    if GetPlayerTechCount(p, 'R0D1', true) == 1 then
        set i=2
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='o01Y'
            
            set b=b + 1
            exitwhen b >= i
        endloop

    endif
    
    //Goblin sniper
    if GetPlayerTechCount(p, 'R0E4', true) == 1 then
        set i=2
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='o02F'
            
            set b=b + 1
            exitwhen b >= i
        endloop

    endif
    
    //Long Containment
    call SaveInteger(CommonHash, pi, StringHash("K2_0"), a[0])
    set i=1
    loop
        
        
        call SaveInteger(CommonHash, pi, StringHash("K2") + i, a[i])
        set i=i + 1
        exitwhen i > a[0]
    endloop
    
    
    
    
endfunction

function Trig_K2T2_Actions takes nothing returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local player p= GetOwningPlayer(GetTriggerUnit())
    local location l= GetUnitRallyPoint(GetTriggerUnit())
    local unit u
    local integer pi= GetPlayerId(p)
    
    
    // 
    set i=LoadInteger(CommonHash, pi, StringHash("K2_0"))
    set i=GetRandomInt(1, i)
    set b=LoadInteger(CommonHash, pi, StringHash("K2") + i)
    //
    
    call aiFixTrainBefore(GetTrainedUnit() , pi)
    set u=ReplaceUnit(GetTrainedUnit() , b , bj_UNIT_STATE_METHOD_RELATIVE)
    call aiFixTrainAfter(u , pi)
    
//    call UnitAddAbility(u,'OR00')
//    call SetUnitAbilityLevel(u,'OR00',35+udg_HordeLandPrice[pi])
//    
     
    call UnitAddAbility(u, 'A0YU')


        call IssuePointOrderLoc(u, "attack", l)

    call RemoveLocation(l)
    set p=null
    set u=null
endfunction

//===========================================================================
function InitTrig_K2T2 takes nothing returns nothing
    set gg_trg_K2T2=CreateTrigger()
    call DisableTrigger(gg_trg_K2T2)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_K2T2, EVENT_PLAYER_UNIT_TRAIN_FINISH)
    call TriggerAddCondition(gg_trg_K2T2, Condition(function Trig_K2T2_Conditions))
    call TriggerAddAction(gg_trg_K2T2, function Trig_K2T2_Actions)
endfunction


