function Trig_Spell_Dvij_Func004Func007Func006Func005Func002A takes nothing returns nothing
    if ( Trig_Spell_Dvij_Func004Func007Func006Func005Func002Func001C() ) then
        call GroupAddUnitSimple(GetEnumUnit(), udg_Group)
        call UnitDamageTargetBJ(udg_Caster, GetEnumUnit(), ( 50.00 * I2R(GetUnitAbilityLevelSwapped('A1BN', udg_Caster)) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL)
        set udg_To4kaAOE=GetUnitLoc(GetEnumUnit())
