    call DisableTrigger(gg_trg_PereborBuildings)
    call TriggerRegisterTimerExpireEvent(gg_trg_PereborBuildings, udg_TimerSmall3)
    call TriggerAddAction(gg_trg_PereborBuildings, function Trig_PereborBuildings_Actions)
endfunction


//===========================================================================
// Trigger: PereborNavalBases
//===========================================================================

function PereborNavalb takes nothing returns nothing
    local player p= GetEnumPlayer()
    local integer pi
    local integer id
    local integer i
    local unit u
    
    set udg_LocalInteger2=GetPlayerId(GetEnumPlayer())
    set pi=GetPlayerId(p)
    
    set Counter=0
    call GroupEnumUnitsOfPlayer(gGroup, p, B_NavalBases)
    set i=LoadInteger(AiData, pi, StringHash("NumberN"))
    // Пропуск если 0 или больше трети армии
    if FirstOfGroup(gGroup) == null then
        if udg_Octhet then
            call DisplayTimedTextFromPlayer(p, 0, 0, 4, GetPlayerName(p) + " имеет 0 верфей")
        endif
        
        set u=null
        return
        
    elseif i > LoadInteger(AiData, pi, StringHash("Number")) / 3 then
        if udg_Octhet then
            call DisplayTimedTextFromPlayer(p, 0, 0, 4, GetPlayerName(p) + " имеет флот больше трети армии")
        endif
        

        set u=null
        return
    endif
    
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=6
    loop
        
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd or FirstOfGroup(gGroup) == null or GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD) < 2000
        set u=BlzGroupUnitAt(gGroup, GetRandomInt(0, Counter))
        set Counter=Counter - 1
       // call DisplayTimedTextFromPlayer(p,0,0,4, GetUnitName(u))
        call GroupRemoveUnit(gGroup, u)
        set id=GetUnitTypeId(u)
          
        // Верфь
        if AiRace[pi] == "Scarlet" or AiRace[pi] == "BloodElves" then
            call aiNavalTrain_Common(u , pi)
        elseif AiRace[pi] == "Goblins" then
            call aiNavalTrain_Goblins(u , pi)
        elseif AiRace[pi] == "Naga" then
            call aiNavalTrain_Naga(u , pi)
        elseif AiRace[pi] == "Horde" then
            call aiNavalTrain_Horde(u , pi)
        endif

        
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    
endfunction

function Trig_PereborNavalBases_Actions takes nothing returns nothing
    call ForForce(udg_Bots, function PereborNavalb)
endfunction

