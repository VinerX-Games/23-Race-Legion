//===========================================================================
// Trigger: KakecCommon
//===========================================================================
function DisableKalec takes nothing returns nothing
    call SetPlayerAbilityAvailableBJ(false, 'A12R', GetEnumPlayer())
endfunction

function EnableKalec takes nothing returns nothing
    call SetPlayerAbilityAvailableBJ(true, 'A12R', GetEnumPlayer())
endfunction

//===========================================================================
// Trigger: KalecStart
//===========================================================================
function Trig_KalecStart_Conditions takes nothing returns boolean

    return GetSpellAbilityId() == 'A12R' and IsUnitSelected(GetTriggerUnit(), GetOwningPlayer(GetTriggerUnit()))
endfunction

function Trig_KalecStart_Actions takes nothing returns nothing
    local unit u
    local location l= GetUnitLoc(GetTriggerUnit())
    set u=CreateUnitAtLoc(Player(24), 'n04W', l, bj_UNIT_FACING)
    call TriggerRegisterUnitEvent(gg_trg_KalecDead, u, EVENT_UNIT_DEATH)
    call UnitRemoveAbility(GetTriggerUnit(), 'A12R')
    call ForForce(udg_AllPlayers, function DisableKalec)
    call TriggerSleepAction(245)
    if UnitAlive(u) then
        call ShowUnit(u, false)
        call RemoveUnit(u)
        call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()), 0, 0, "Вы не успели победить Калесгоса за 4 минуты")
        call ForForce(udg_AllPlayers, function EnableKalec)
        call UnitAddAbility(GetTriggerUnit(), 'A12R')
    endif
    
    call RemoveLocation(l)
    set l=null
    set u=null
endfunction

