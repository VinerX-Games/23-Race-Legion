    call CameraSetupApplyForPlayer(true, gg_cam_GW4, GetEnumPlayer(), 0)
endfunction

function Trig_StartLobby_Func007C takes nothing returns boolean
    if ( not ( udg_LocalInteger == 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_StartLobby_Func008Func001A takes nothing returns nothing
    call CameraSetupApplyForPlayer(true, gg_cam_GW5, GetEnumPlayer(), 0)
endfunction

function Trig_StartLobby_Func008C takes nothing returns boolean
    if ( not ( udg_LocalInteger == 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_StartLobby_Func014A takes nothing returns nothing
    call CameraSetupApplyForPlayer(true, gg_cam_HostRegion, GetEnumPlayer(), 0)
    call SetCameraFieldForPlayer(GetEnumPlayer(), CAMERA_FIELD_TARGET_DISTANCE, 3400.00, 0.00)
    call CreateNUnitsAtLoc(1, 'h0GA', GetEnumPlayer(), udg_LocalPosition2, bj_UNIT_FACING)
endfunction

function Trig_StartLobby_Actions takes nothing returns nothing
    set udg_LocalPosition2=GetRectCenter(gg_rct_HostRegion)
    set udg_LocalInteger=GetRandomInt(1, 5)
    if ( Trig_StartLobby_Func004C() ) then
        call ForForce(udg_AllPlayers, function Trig_StartLobby_Func004Func001A)
    else
    endif
    if ( Trig_StartLobby_Func005C() ) then
        call ForForce(udg_AllPlayers, function Trig_StartLobby_Func005Func001A)
    else
    endif
    if ( Trig_StartLobby_Func006C() ) then
        call ForForce(udg_AllPlayers, function Trig_StartLobby_Func006Func001A)
    else
    endif
    if ( Trig_StartLobby_Func007C() ) then
        call ForForce(udg_AllPlayers, function Trig_StartLobby_Func007Func001A)
    else
    endif
    if ( Trig_StartLobby_Func008C() ) then
        call ForForce(udg_AllPlayers, function Trig_StartLobby_Func008Func001A)
    else
    endif
    set udg_LocalInteger=4
    call DisplayTimedTextToForce(GetPlayersAll(), I2R(udg_LocalInteger), "TRIGSTR_11404")
    set udg_LocalInteger=( udg_LocalInteger - 3 )
    call TriggerSleepAction(I2R(udg_LocalInteger))
    call ForForce(udg_AllPlayers, function Trig_StartLobby_Func014A)
    call RemoveLocation(udg_LocalPosition2)
    call StartTimerBJ(udg_LobbyTime, false, 60.00)
    call CreateTimerDialogBJ(GetLastCreatedTimerBJ(), "TRIGSTR_19360")
    set udg_LobbyTimerWindows=GetLastCreatedTimerDialogBJ()
    call CreateNUnitsAtLoc(1, 'n04G', Player(0), GetRectCenter(GetPlayableMapRect()), bj_UNIT_FACING)
    set ModeBuilding=GetLastCreatedUnit()
    call SelectUnitForPlayerSingle(GetLastCreatedUnit(), Player(0))
endfunction

