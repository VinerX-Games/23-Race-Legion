endfunction

//function TimedMessageDomination takes player p returns nothing
//    local integer pi = GetPlayerId(p)
//    
//    //DisplayTextToPlayer()
//
//endfunction
//
function ExpandTable takes nothing returns nothing
    local integer i= 0
    local integer l__max= 1
    call MultiboardSetColumnCount(Multiboard, 3)
    
    
    set ThirdColumn[24]=MultiboardGetItem(Multiboard, 0, 2)
    call MultiboardSetItemValue(ThirdColumn[24], "Точек,%")
    call MultiboardSetItemWidth(ThirdColumn[24], 0.06)
    call MultiboardReleaseItem(ThirdColumn[24])
    
    loop
        exitwhen i > 23
        set CityPlayerCount[i]=0
        if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING or IsPlayerInForce(Player(i), udg_Bots) then
            set ThirdColumn[i]=MultiboardGetItem(Multiboard, l__max, 2)
            call MultiboardSetItemValue(ThirdColumn[i], "0.000%")
            call MultiboardSetItemWidth(ThirdColumn[i], 0.06)
            set l__max=l__max + 1
        endif
        set i=i + 1
    
    endloop
     
    
    
    call MultiboardDisplay(Multiboard, false)
    call MultiboardDisplay(Multiboard, true)
    
    
endfunction

