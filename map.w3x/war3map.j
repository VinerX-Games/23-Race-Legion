//===========================================================================
// Trigger: SpellDamageReturn
//===========================================================================
function Trig_SpellDamageReturn_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A1E3'
endfunction

function Trig_SpellDamageReturn_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local real hp= GetUnitState(u, UNIT_STATE_LIFE) * 0.6
    local integer seconds= 7
    local integer i= 0
    local effect e= AddSpecialEffectTargetUnitBJ("Chest", u, "Abilities\\Spells\\Items\\VampiricPotion\\VampPotionCaster.mdl")
    call UnitDamageTargetBJ(u, u, hp, ATTACK_TYPE_HERO, DAMAGE_TYPE_UNIVERSAL)
    
    loop
        exitwhen not UnitAlive(u) or u == null or i * 0.5 > seconds
        call SetUnitState(u, UNIT_STATE_LIFE, GetUnitState(u, UNIT_STATE_LIFE) + hp * 0.07)
        call UnitDamageTargetBJ(u, u, 0, ATTACK_TYPE_HERO, DAMAGE_TYPE_DEATH)
        call TriggerSleepAction(0.25)
       
        set i=i + 1
    endloop
    call DestroyEffect(e)
    set e=null
    set u=null
endfunction

//===========================================================================
function InitTrig_SpellDamageReturn takes nothing returns nothing
    set gg_trg_SpellDamageReturn=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_SpellDamageReturn, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_SpellDamageReturn, Condition(function Trig_SpellDamageReturn_Conditions))
    call TriggerAddAction(gg_trg_SpellDamageReturn, function Trig_SpellDamageReturn_Actions)
endfunction


//===========================================================================
// Trigger: DamageConvert
//===========================================================================
function Trig_DamageConvert_Conditions takes nothing returns boolean
    
    return GetUnitAbilityLevel(GetEventDamageSource(), 'A1E5') > 0 and IsPlayerEnemy(GetOwningPlayer(GetEventDamageSource()), GetOwningPlayer(GetTriggerUnit()))
    
    
    
endfunction

function Trig_DamageConvert_Actions takes nothing returns nothing
    local unit u= GetEventDamageSource()
    local integer level= GetUnitAbilityLevel(u, 'A1E5')
    local real damage= GetEventDamage()
    local effect e= AddSpecialEffectTargetUnitBJ("Chest", u, "Abilities\\Spells\\Items\\VampiricPotion\\VampPotionCaster.mdl")
    call SetUnitState(u, UNIT_STATE_LIFE, GetUnitState(u, UNIT_STATE_LIFE) + damage * ( 0.04 * level ))
  
    
    set u=null
    call DestroyEffect(e)
    set e=null
endfunction

//===========================================================================
function InitTrig_DamageConvert takes nothing returns nothing
    set gg_trg_DamageConvert=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_DamageConvert, EVENT_PLAYER_UNIT_DAMAGED)
    call TriggerAddCondition(gg_trg_DamageConvert, Condition(function Trig_DamageConvert_Conditions))
    call TriggerAddAction(gg_trg_DamageConvert, function Trig_DamageConvert_Actions)
endfunction


