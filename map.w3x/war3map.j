//===========================================================================
// Trigger: PereborNavalBases
//===========================================================================

function PereborNavalb takes nothing returns nothing
    local group g= CreateGroup()
    local player p= GetEnumPlayer()
    local integer pi
    local integer id
    local integer i
    local integer b
    local integer array a
    local unit u
    local integer HaveOrder= 0
    
    set udg_LocalInteger2=GetPlayerId(GetEnumPlayer())
    set pi=GetPlayerId(p)
    
    call GroupEnumUnitsOfPlayer(g, p, B_NavalBases)
    set i=LoadInteger(AiData, pi, StringHash("NumberN"))
    // Пропуск если 0 или лимит юнитов
    if FirstOfGroup(g) == null or ( i > 4 * AiLimit ) or ( i > LoadInteger(AiData, pi, StringHash("Number")) / 4 ) then
        if udg_Octhet then
            call DisplayTimedTextFromPlayer(p, 0, 0, 4, GetPlayerName(p) + " - достиг предела флота")
        endif
        
        call DestroyGroup(g)
        set g=null
        set u=null
        set p=null
        return
    endif
    
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=6
    loop
        
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd or FirstOfGroup(g) == null or GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD) < 3000
        set u=GroupPickRandomUnit(g)
       // call DisplayTimedTextFromPlayer(p,0,0,4, GetUnitName(u))
        call GroupRemoveUnit(g, u)
        set id=GetUnitTypeId(u)
          
          // Верфь
        if id == 'h011' then
            set udg_LocalInteger3=GetRandomInt(2, 3)
           
            if udg_LocalInteger3 == 2 and LoadInteger(AiData, pi, 'h00Y') < 50 then
                call IssueImmediateOrderById(u, 'h00Y')
            elseif LoadInteger(AiData, pi, 'h00Z') < 75 then
                call IssueImmediateOrderById(u, 'h00Z')
            endif
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    
    
    
    
    call DestroyGroup(g)
    set g=null
    set p=null
endfunction

