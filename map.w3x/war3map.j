function Trig_Lord_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'NQ06' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lord_Func001Func001Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('NQ06', GetTriggerUnit()) == 2 ) ) then
        return false
    endif
    if ( not ( CountLivingPlayerUnitsOfTypeId('lord', GetTriggerPlayer()) < 3 ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetSpellTargetUnit()) == 'u019' ) ) then
        return false
    endif
