//===========================================================================
// Trigger: Strateg
//
// AiData
//===========================================================================


function ZahType takes nothing returns nothing
    local unit u= GetEnumUnit()
    local integer pi= GetPlayerId(GetOwningPlayer(u))
    local integer id= GetUnitTypeId(u)
    //Это точка
    if IsUnitInGroup(u, udg_ZahvatBuildings) then
        set udg_LocalInteger3=udg_LocalInteger3 + 8
    else
        if AiRace[pi] == "Scarlet" then
            call Strateg_Scarlet_EC(id)
        elseif AiRace[pi] == "BloodElves" then
            call Strateg_BloodElves_EC(id)
        elseif AiRace[pi] == "Goblins" then
            call Strateg_Goblins_EC(id)
        elseif AiRace[pi] == "Naga" then
            call Strateg_Naga_EC(id)
        elseif AiRace[pi] == "Horde" then
            call Strateg_Horde_EC(id)
        endif
    endif
endfunction


function Strateg takes nothing returns nothing
    local integer i= 0
    local integer r= 0
    local player p= GetEnumPlayer()
    local integer pi= GetPlayerId(p)
    
    
    // Считаю фермы и точки
    set udg_LocalInteger3=0
    call GroupEnumUnitsOfPlayer(gGroup, p, null)
    call ForGroup(gGroup, function ZahType)
    call GroupClear(gGroup)
    set i=udg_LocalInteger3
    //Посчитал
    
    
    //Ресы на развитие
    
    call AdjustPlayerStateSimpleBJ(p, PLAYER_STATE_RESOURCE_GOLD, 500 + i * 9 * AiMoney) // -LoadInteger(AiData,pi,StringHash("Number"))*10 )
    call AdjustPlayerStateSimpleBJ(p, PLAYER_STATE_RESOURCE_LUMBER, 250 + i * 5 * AiMoney)
    
    //call DisplayTimedTextFromPlayer(Player(0),0,0,4,(GetPlayerName(p)+" "+I2S(GetPlayerId(p))))
    //call DisplayTimedTextFromPlayer(Player(0),0,0,4,I2S(i))
    
    // Увеличивает уровень спопособности юнита с аурами
    call SetUnitAbilityLevel(BonusUnit[pi], 'aib0', IMinBJ(R2I(i / 50 + 1), 10))
    call SetUnitAbilityLevel(BonusUnit[pi], 'aib1', IMinBJ(R2I(i / 50 + 1), 10))
    //call BJDebugMsg("Юнит "+GetUnitName(BonusUnit[pi])+" очков"+I2S(i)+" Уровень "+I2S(IMinBJ( R2I(i/10),4)))
    
    
    
    if AiRace[pi] == "Scarlet" then
        call Strateg_Scarlet(i , pi , p)
    elseif AiRace[pi] == "BloodElves" then
        call Strateg_BloodElves(i , pi , p)
    elseif AiRace[pi] == "Goblins" then
        call Strateg_Goblins(i , pi , p)
    elseif AiRace[pi] == "Naga" then
        call Strateg_Naga(i , pi , p)
    elseif AiRace[pi] == "Horde" then
        call Strateg_Horde(i , pi , p)
    endif
   
    
    
    
    //Рандомный теп - чем больше доходов, тем больше попыток
    set r=0
    loop
        exitwhen r > i / 55
        if FirstOfGroup(AiUnitsToPort[pi]) != null then
            set TryPort_pi=pi
            call ExecuteFunc("TryPort")
            
        endif
        set r=r + 1
    endloop

endfunction



function Trig_Strateg_Actions takes nothing returns nothing
    
    if udg_Octhet then
        call DisplayTimedTextFromPlayer(GetEnumPlayer(), 0, 0, 4, "Тик стратега")
    endif
    
    call ForForce(udg_Bots, function Strateg)

    if udg_Octhet then
        call DisplayTimedTextFromPlayer(GetEnumPlayer(), 0, 0, 4, "Конец Тика стратега")
    endif


endfunction

//===========================================================================
function InitTrig_Strateg takes nothing returns nothing
    set gg_trg_Strateg=CreateTrigger()
    call DisableTrigger(gg_trg_Strateg)
    call TriggerRegisterTimerExpireEvent(gg_trg_Strateg, udg_AiTimerStrateg)
    call TriggerAddAction(gg_trg_Strateg, function Trig_Strateg_Actions)
endfunction


