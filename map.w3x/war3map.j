function Trig_BlinkToUnit_Spell_Actions takes nothing returns nothing
    set udg_LocalPosition[20]=GetUnitLoc(GetSpellTargetUnit())
    set udg_LocalPosition[21]=GetUnitLoc(GetTriggerUnit())
    call TriggerSleepAction(( DistanceBetweenPoints(udg_LocalPosition[20], udg_LocalPosition[21]) / 1200.00 ))
    call SetUnitPositionLoc(GetTriggerUnit(), udg_LocalPosition[20])
    call IssueTargetOrderBJ(GetTriggerUnit(), "attack", GetAttackedUnitBJ())
    call RemoveLocation(udg_LocalPosition[20])
    call RemoveLocation(udg_LocalPosition[21])
endfunction

