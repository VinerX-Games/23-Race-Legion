//===========================================================================
// Trigger: StartTableCode
//===========================================================================
function ActivePlayers takes nothing returns boolean
    return GetPlayerSlotState(GetFilterPlayer()) == PLAYER_SLOT_STATE_PLAYING and not IsPlayerInForce(GetFilterPlayer(), udg_Bots)
endfunction


function GetPlayerNameCut takes player p returns string
    local string s= GetPlayerName(p)
    local string s2
    local string s3= ""
    local integer i= 0
    loop
        set s2=SubString(s, i, i + 1)
        exitwhen s2 == "#" or i > 18 or s2 == null
        
        
        set s3=s3 + s2
        set i=i + 1
    endloop
    return s3
endfunction




function Trig_StartTableCode_Actions takes nothing returns nothing
    local integer i= 0
    set udg_PlayersCount=CountPlayersInForceBJ(GetPlayersMatching(Condition(function ActivePlayers)))
    set udg_PlayersCount=udg_PlayersCount + CountPlayersInForceBJ(udg_Bots)
    
    set Multiboard=CreateMultiboard()
    call MultiboardSetRowCount(Multiboard, udg_PlayersCount + 1)
    call MultiboardSetColumnCount(Multiboard, 2)
    call MultiboardSetTitleText(Multiboard, "Таблица разведки")
    set MultiboardItem[0]=MultiboardGetItem(Multiboard, 0, 0)
    set MultiboardItem[1]=MultiboardGetItem(Multiboard, 0, 1)
    call MultiboardSetItemValue(MultiboardItem[0], "Имя игрока")
    call MultiboardSetItemValue(MultiboardItem[1], "Юнитов")
    call MultiboardSetItemWidth(MultiboardItem[0], 0.12)
    call MultiboardSetItemWidth(MultiboardItem[1], 0.06)
    call MultiboardReleaseItem(MultiboardItem[0])
    call MultiboardReleaseItem(MultiboardItem[1])
    loop
        if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING or IsPlayerInForce(Player(i), udg_Bots) or udg_AiControl[i] then
            set max=max + 1
            set MultiboardItemOwnerIndex[i]=max
            set MultiboardItem[max * 2]=MultiboardGetItem(Multiboard, max, 0)
            set MultiboardItem[max * 2 + 1]=MultiboardGetItem(Multiboard, max, 1)
            set udg_LocalText2=( ( I2S(GetConvertedPlayerId(Player(i))) + ". " ) + GetPlayerNameCut(Player(i)) )
                        
            //set udg_LocalText2 = SubString(udg_LocalText2, 0, StringLength(udg_LocalText2)-4 )
            call MultiboardSetItemValue(MultiboardItem[max * 2], udg_LocalText2)
            call MultiboardSetItemWidth(MultiboardItem[max * 2], 0.14)
            call MultiboardSetItemValue(MultiboardItem[max * 2 + 1], "0")
            call MultiboardSetItemWidth(MultiboardItem[max * 2 + 1], 0.06)
        endif
        set i=i + 1
        exitwhen i > 23
    endloop
    call MultiboardSetItemsStyle(Multiboard, true, false)
    call MultiboardDisplay(Multiboard, true)
    call ExpandTable()
    call ExpandTableArmyExpr()
    
endfunction

