        return false
    endif
    return true
endfunction

function Trig_Spell1_Copy_Actions takes nothing returns nothing
    set udg_LocalInteger2=GetRandomInt(1, 2)
    if ( Trig_Spell1_Copy_Func003C() ) then
        if ( Trig_Spell1_Copy_Func003Func002C() ) then
            set udg_LocalPosition2=GetRectCenter(gg_rct_QtunSp2)
        else
            set udg_LocalPosition2=GetRectCenter(gg_rct_QtunSp1)
        endif
        set udg_LocalInteger=R2I(( ( I2R(BlzGetUnitMaxHP(GetTriggerUnit())) - GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) ) / 1000.00 ))
        set udg_LocalInteger2=( udg_LocalInteger * 2 )
        call CreateNUnitsAtLoc(udg_LocalInteger2, 'e022', GetOwningPlayer(GetTriggerUnit()), udg_LocalPosition2, bj_UNIT_FACING)
        set udg_LocalOtrad=GetLastCreatedGroup()
        set udg_LocalPosition3=GetUnitLoc(gg_unit_n03D_0666)
        call ForGroupBJ(udg_LocalOtrad, function Trig_Spell1_Copy_Func003Func008A)
        call GroupClear(udg_LocalOtrad)
        call RemoveLocation(udg_LocalPosition2)
        call RemoveLocation(udg_LocalPosition3)
    else
    endif
    if ( Trig_Spell1_Copy_Func004C() ) then
        set udg_LocalInteger2=GetRandomInt(1, 2)
        if ( Trig_Spell1_Copy_Func004Func002C() ) then
            set udg_LocalPosition2=GetRectCenter(gg_rct_QtunSp2)
        else
            set udg_LocalPosition2=GetRectCenter(gg_rct_QtunSp1)
        endif
        set udg_LocalInteger=R2I(( ( I2R(BlzGetUnitMaxHP(GetTriggerUnit())) - GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) ) / 1000.00 ))
        set udg_LocalInteger2=( udg_LocalInteger * 4 )
        call CreateNUnitsAtLoc(udg_LocalInteger2, 'e022', GetOwningPlayer(GetTriggerUnit()), udg_LocalPosition2, bj_UNIT_FACING)
        set udg_LocalOtrad=GetLastCreatedGroup()
        set udg_LocalPosition3=GetUnitLoc(gg_unit_n03D_0666)
        call ForGroupBJ(udg_LocalOtrad, function Trig_Spell1_Copy_Func004Func008A)
        call GroupClear(udg_LocalOtrad)
        call RemoveLocation(udg_LocalPosition2)
        call RemoveLocation(udg_LocalPosition3)
    else
    endif
    if ( Trig_Spell1_Copy_Func005C() ) then
        set udg_LocalInteger2=GetRandomInt(1, 2)
        if ( Trig_Spell1_Copy_Func005Func002C() ) then
            set udg_LocalPosition2=GetRectCenter(gg_rct_QtunSp2)
        else
            set udg_LocalPosition2=GetRectCenter(gg_rct_QtunSp1)
        endif
        set udg_LocalInteger=R2I(( ( I2R(BlzGetUnitMaxHP(GetTriggerUnit())) - GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) ) / 1000.00 ))
        set udg_LocalInteger2=( udg_LocalInteger * 1 )
        call CreateNUnitsAtLoc(udg_LocalInteger2, 'e01Q', GetOwningPlayer(GetTriggerUnit()), udg_LocalPosition2, bj_UNIT_FACING)
        set udg_LocalOtrad=GetLastCreatedGroup()
        set udg_LocalPosition3=GetUnitLoc(gg_unit_n03D_0666)
        call ForGroupBJ(udg_LocalOtrad, function Trig_Spell1_Copy_Func005Func008A)
        call GroupClear(udg_LocalOtrad)
        call RemoveLocation(udg_LocalPosition2)
        call RemoveLocation(udg_LocalPosition3)
    else
    endif
    if ( Trig_Spell1_Copy_Func006C() ) then
        set udg_LocalInteger2=GetRandomInt(1, 2)
        if ( Trig_Spell1_Copy_Func006Func002C() ) then
            set udg_LocalPosition2=GetRectCenter(gg_rct_QtunSp2)
        else
            set udg_LocalPosition2=GetRectCenter(gg_rct_QtunSp1)
        endif
        set udg_LocalInteger=R2I(( ( I2R(BlzGetUnitMaxHP(GetTriggerUnit())) - GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) ) / 1000.00 ))
        set udg_LocalInteger2=( udg_LocalInteger * 1 )
        call CreateNUnitsAtLoc(udg_LocalInteger2, 'e01P', GetOwningPlayer(GetTriggerUnit()), udg_LocalPosition2, bj_UNIT_FACING)
        set udg_LocalOtrad=GetLastCreatedGroup()
        set udg_LocalPosition3=GetUnitLoc(gg_unit_n03D_0666)
        call ForGroupBJ(udg_LocalOtrad, function Trig_Spell1_Copy_Func006Func008A)
        call GroupClear(udg_LocalOtrad)
        call RemoveLocation(udg_LocalPosition2)
        call RemoveLocation(udg_LocalPosition3)
    else
    endif
endfunction

