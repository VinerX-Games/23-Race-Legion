function PlayerNavy takes nothing returns nothing
    local group g= CreateGroup()
    local player p= null
    local unit u
    local integer id
    local integer i
    local integer i2

    //Локалки
    
    //Каждый отдельный игрок
    //Узнаю номер игрока
    
    if CountPlayersInForceBJ(udg_BotsActiveB) == 0 then
        call PauseTimer(udg_PlayerGet4)
        call ResumeTimer(udg_TimerSmall4)
        call TimerStart(udg_TimerSmall4, 6.14 * AiRepeat / 5, false, null)
        if udg_Octhet then
            call DisplayTimedTextFromPlayer(Player(0), 0, 0, 4, "Заканчиваю перебор игроков для флота")
        endif
    else
        
        set p=ForcePickRandomPlayer(udg_BotsActiveB)
        call ForceRemovePlayer(udg_BotsActiveB, p)
        call GroupEnumUnitsOfPlayer(g, p, B_LazyN)
        if FirstOfGroup(g) != null then
 
            
            set i=1
            loop
                set u=FirstOfGroup(g)
                exitwhen i > AiMass or u == null
                
                set id=GetUnitTypeId(u)
                call GroupRemoveUnit(g, u)
                set i=i + 1

                if id == 'h00Y' or id == 'h00Z' then
                    set udg_LocalUnit3=u
                    call ExecuteFunc("TryAttackN")
                endif
            endloop
        endif
        
    endif
    set p=null
    call DestroyGroup(g)
    set g=null
    set u=null
endfunction
