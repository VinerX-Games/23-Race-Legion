function InitTrig_____________________________________001_Copy takes nothing returns nothing
    set gg_trg_____________________________________001_Copy=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_____________________________________001_Copy, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_____________________________________001_Copy, Condition(function Trig_____________________________________001_Copy_Conditions))
    call TriggerAddAction(gg_trg_____________________________________001_Copy, function Trig_____________________________________001_Copy_Actions)
