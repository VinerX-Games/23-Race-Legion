//library SanctifiedEnchantment:

    
    // ===============================================================
    
//Implemented from module BindTemplate:

        function s__SanctifiedEnchantment_Save takes handle h,integer i,integer s returns nothing
            call SaveInteger(Global_Hash, GetHandleId(h), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + i, s)
        endfunction
        function s__SanctifiedEnchantment_SaveThis takes integer this,handle h,integer i returns nothing
            call SaveInteger(Global_Hash, GetHandleId((h )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( i ), ( this)) // INLINED!!
        endfunction
        function s__SanctifiedEnchantment_Load takes handle h,integer i returns integer
            return LoadInteger(Global_Hash, GetHandleId(h), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + i)
        endfunction
        function s__SanctifiedEnchantment_Flush takes handle h,integer i returns nothing
            call SaveInteger(Global_Hash, GetHandleId((h )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( i ), ( 0)) // INLINED!!
        endfunction
        
        function s__SanctifiedEnchantment_SaveUnique takes handle h,integer s returns nothing
            call SaveInteger(Global_Hash, GetHandleId((h )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( - 1 ), ( s)) // INLINED!!
        endfunction
        function s__SanctifiedEnchantment_SaveThisUnique takes integer this,handle h returns nothing
            call SaveInteger(Global_Hash, GetHandleId(((h ) )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( - 1 ), ( ( this))) // INLINED!!
        endfunction
        function s__SanctifiedEnchantment_LoadUnique takes handle h returns integer
            return (LoadInteger(Global_Hash, GetHandleId((h )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( - 1))) // INLINED!!
        endfunction
        function s__SanctifiedEnchantment_FlushUnique takes handle h returns nothing
            call SaveInteger(Global_Hash, GetHandleId(((h ) )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( ( - 1) ), ( 0)) // INLINED!!
        endfunction
        
        function s__SanctifiedEnchantment_BindTemplate___SetCount takes handle h,integer c returns nothing
            call SaveInteger(Global_Hash, GetHandleId((h )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( 0 ), ( c)) // INLINED!!
        endfunction
        function s__SanctifiedEnchantment_GetCount takes handle h returns integer
            return (LoadInteger(Global_Hash, GetHandleId((h )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( 0))) // INLINED!!
        endfunction
        
        function s__SanctifiedEnchantment_Add takes handle h,integer s returns nothing
            local integer c= (LoadInteger(Global_Hash, GetHandleId(((h) )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( 0))) + 1 // INLINED!!
            if c < JASS_MAX_ARRAY_SIZE then
                call SaveInteger(Global_Hash, GetHandleId((h )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( c ), ( s)) // INLINED!!
                call SaveInteger(Global_Hash, GetHandleId(((h ) )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( 0 ), ( ( c))) // INLINED!!
            endif
        endfunction
        function s__SanctifiedEnchantment_AddThis takes integer this,handle h returns nothing
            call s__SanctifiedEnchantment_Add(h , this)
        endfunction
        
        function s__SanctifiedEnchantment_Remove takes handle h,integer s returns nothing
            local integer c= (LoadInteger(Global_Hash, GetHandleId(((h) )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( 0))) // INLINED!!
            local integer i= c
            loop
                exitwhen i <= 0
                if (LoadInteger(Global_Hash, GetHandleId((h )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( i))) == s then // INLINED!!
                    call SaveInteger(Global_Hash, GetHandleId((h )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( i ), ( (LoadInteger(Global_Hash, GetHandleId((h )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( c))))) // INLINED!!
                    call SaveInteger(Global_Hash, GetHandleId(((h ) )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( ( c) ), ( 0)) // INLINED!!
                    call SaveInteger(Global_Hash, GetHandleId(((h ) )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( 0 ), ( ( c - 1))) // INLINED!!
                    exitwhen true
                endif
                set i=i - 1
            endloop
        endfunction
        function s__SanctifiedEnchantment_RemoveThis takes integer this,handle h returns nothing
            call s__SanctifiedEnchantment_Remove(h , this)
        endfunction
        
        function s__SanctifiedEnchantment_RemoveOrdered takes handle h,integer s returns nothing
            local boolean b= false
            local integer c= (LoadInteger(Global_Hash, GetHandleId(((h) )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( 0))) // INLINED!!
            local integer i= 1
            loop
                exitwhen i > c
                if not b then
                    if (LoadInteger(Global_Hash, GetHandleId((h )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( i))) == s then // INLINED!!
                        set b=true
                    endif
                endif
                if b then
                    call SaveInteger(Global_Hash, GetHandleId((h )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( i ), ( (LoadInteger(Global_Hash, GetHandleId((h )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( i + 1))))) // INLINED!!
                endif
                set i=i + 1
            endloop
            if b then
                call SaveInteger(Global_Hash, GetHandleId(((h ) )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( ( c) ), ( 0)) // INLINED!!
                call SaveInteger(Global_Hash, GetHandleId(((h ) )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( 0 ), ( ( c - 1))) // INLINED!!
            endif
        endfunction
        function s__SanctifiedEnchantment_RemoveThisOrdered takes integer this,handle h returns nothing
            call s__SanctifiedEnchantment_RemoveOrdered(h , this)
        endfunction
        
        
        function s__SanctifiedEnchantment_update takes integer this,unit c returns nothing
            set s__SanctifiedEnchantment_Time[this]=0
            set s__SanctifiedEnchantment_Level[this]=GetUnitAbilityLevel(c, SanctifiedEnchantment_SkillId)
            call SetUnitAbilityLevel(s__SanctifiedEnchantment_Target[this], SanctifiedEnchantment_SkillAbilityStatusId, s__SanctifiedEnchantment_Level[this])
            call SetUnitAbilityLevel(s__SanctifiedEnchantment_Target[this], SanctifiedEnchantment_AbilitySplashId, s__SanctifiedEnchantment_Level[this])
        endfunction
        
        function s__SanctifiedEnchantment_destroy takes integer this returns nothing
            call DisableTrigger(s__SanctifiedEnchantment_Trigger[this])
            call SaveInteger(Global_Hash, GetHandleId((((s__SanctifiedEnchantment_Trigger[this]) ) )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( ( - 1) ), ( 0)) // INLINED!!
            call DestroyTrigger(s__SanctifiedEnchantment_Trigger[this])
            set s__SanctifiedEnchantment_Trigger[this]=null
            // ====================
            call SaveInteger(Global_Hash, GetHandleId((((s__SanctifiedEnchantment_Target[this]) ) )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( ( - 1) ), ( 0)) // INLINED!!
            call UnitRemoveAbility(s__SanctifiedEnchantment_Target[this], SanctifiedEnchantment_SkillBookId)
            call UnitRemoveAbility(s__SanctifiedEnchantment_Target[this], SanctifiedEnchantment_SkillBuffStatusId)
            set s__SanctifiedEnchantment_Target[this]=null
            call s__SanctifiedEnchantment_deallocate(this)
        endfunction
        
        function s__SanctifiedEnchantment_Function takes nothing returns boolean
            local integer this= (LoadInteger(Global_Hash, GetHandleId(((GetTriggeringTrigger()) )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( - 1))) // INLINED!!
            if GetTriggerEventId() == EVENT_GAME_TIMER_EXPIRED then
                set s__SanctifiedEnchantment_Time[this]=s__SanctifiedEnchantment_Time[this] + s__SanctifiedEnchantment_Date
                if s__SanctifiedEnchantment_Time[this] >= SanctifiedEnchantment_BuffDuration[s__SanctifiedEnchantment_Level[this]] or GetUnitAbilityLevel(s__SanctifiedEnchantment_Target[this], SanctifiedEnchantment_SkillBuffStatusId) == 0 then
                    call s__SanctifiedEnchantment_destroy(this)
                endif
            else
                call s__SanctifiedEnchantment_destroy(this)
            endif
            return false
        endfunction
        
        function s__SanctifiedEnchantment_create takes unit c,unit t returns integer
            local integer this= s__SanctifiedEnchantment__allocate()
            set s__SanctifiedEnchantment_Level[this]=GetUnitAbilityLevel(c, SanctifiedEnchantment_SkillId)
            set s__SanctifiedEnchantment_Target[this]=t
            call UnitAddAbility(s__SanctifiedEnchantment_Target[this], SanctifiedEnchantment_SkillBookId)
            call UnitMakeAbilityPermanent(s__SanctifiedEnchantment_Target[this], true, SanctifiedEnchantment_SkillBookId)
            call UnitMakeAbilityPermanent(s__SanctifiedEnchantment_Target[this], true, SanctifiedEnchantment_SkillAbilityStatusId)
            call UnitMakeAbilityPermanent(s__SanctifiedEnchantment_Target[this], true, SanctifiedEnchantment_AbilitySplashId)
            call SetUnitAbilityLevel(s__SanctifiedEnchantment_Target[this], SanctifiedEnchantment_SkillAbilityStatusId, s__SanctifiedEnchantment_Level[this])
            call SetUnitAbilityLevel(s__SanctifiedEnchantment_Target[this], SanctifiedEnchantment_AbilitySplashId, s__SanctifiedEnchantment_Level[this])
            call s__SanctifiedEnchantment_SaveThisUnique(this,s__SanctifiedEnchantment_Target[this])
            // ====================
            set s__SanctifiedEnchantment_Trigger[this]=CreateTrigger()
            call s__SanctifiedEnchantment_SaveThisUnique(this,s__SanctifiedEnchantment_Trigger[this])
            call TriggerAddCondition(s__SanctifiedEnchantment_Trigger[this], Condition(function s__SanctifiedEnchantment_Function))
            call TriggerRegisterDeathEvent(s__SanctifiedEnchantment_Trigger[this], s__SanctifiedEnchantment_Target[this])
            call TriggerRegisterTimerEvent(s__SanctifiedEnchantment_Trigger[this], s__SanctifiedEnchantment_Date, true)
            return this
        endfunction
    
    
    function SanctifiedEnchantment___SkillAction_EFFECT takes nothing returns nothing
        local integer se= (LoadInteger(Global_Hash, GetHandleId(((GetSpellTargetUnit()) )), 10000 + JASS_MAX_ARRAY_SIZE * s__SanctifiedEnchantment_Key + ( - 1))) // INLINED!!
        if se > 0 then
            call s__SanctifiedEnchantment_update(se,GetTriggerUnit())
        else
            call s__SanctifiedEnchantment_create(GetTriggerUnit() , GetSpellTargetUnit())
        endif
    endfunction
    function SanctifiedEnchantment___SkillCondition_EFFECT takes nothing returns boolean
        return GetSpellAbilityId() == SanctifiedEnchantment_SkillId
    endfunction
    
    function SanctifiedEnchantment___InitPreload takes nothing returns nothing
        local integer index= 0
        loop
            call SetPlayerAbilityAvailable(Player(index), SanctifiedEnchantment_SkillBookId, false)
            set index=index + 1
            exitwhen index == bj_MAX_PLAYER_SLOTS
        endloop
    endfunction
    function SanctifiedEnchantment___Init takes nothing returns nothing
        local trigger trg= CreateTrigger()
        call TriggerRegisterAnyUnitEventBJ(trg, EVENT_PLAYER_UNIT_SPELL_EFFECT)
        call TriggerAddCondition(trg, Condition(function SanctifiedEnchantment___SkillCondition_EFFECT))
        call TriggerAddAction(trg, function SanctifiedEnchantment___SkillAction_EFFECT)
        set trg=null
        call SanctifiedEnchantment___InitPreload()
        // ====================
        set SanctifiedEnchantment_BuffDuration[1]=40
        set SanctifiedEnchantment_BuffDuration[2]=40
        set SanctifiedEnchantment_BuffDuration[3]=40
        set SanctifiedEnchantment_BuffDuration[4]=40
    endfunction
    

//library SanctifiedEnchantment ends
//library Races:
//***************************************************************************
//*  BuildTemplate

// Добавляет строение во варианты постройки
function AddBuilding takes integer buildingId,integer count returns nothing
    set tB=1 // Базовый шанс
    loop
        set tArray[0]=tArray[0] + 1
        set tArray[tArray[0]]=buildingId
        set tB=tB + 1
        exitwhen tB > count
    endloop
endfunction

// Проверяет лимит и добавляет во варианты постройки
function CheckAndAddBuilding takes integer pi,integer buildingId,integer limit,integer power returns nothing
    if LoadInteger(AiData, pi, buildingId) < limit then
        call AddBuilding(buildingId , power)
    endif
endfunction




//***************************************************************************
//*  UnitTrainTemplate
// Добавляет юнит в массив tArray с учетом количества
function AddUnit takes integer unitId,integer power returns nothing
    set tB=1
    loop
        set tArray[0]=tArray[0] + 1
        set tArray[tArray[0]]=unitId
        set tB=tB + 1
        exitwhen tB > power
    endloop
endfunction

// Проверяет лимит и добавляет юнит в массив tArray с учетом мощности
function CheckAndAddUnit takes integer pi,integer unitId,integer limit,integer power returns nothing
    if limit == 0 or LoadInteger(AiData, pi, unitId) < limit then
        call AddUnit(unitId , power)
    endif
endfunction

// Заказывает юнита рандомом массива если не пуст, очищает кол-во на случай если забуду
function aiOrderUnit takes unit u returns nothing
    if tArray[0] > 0 then
        call IssueImmediateOrderById(u, tArray[GetRandomInt(1, tArray[0])])
        set tArray[0]=0
    endif
endfunction
   

//***************************************************************************
//*  MakeGrade

function ThisType takes nothing returns boolean
    if GetUnitTypeId(GetFilterUnit()) == udg_LocalInteger5 then
        set Counter=Counter + 1
        return true
    endif
    return false
endfunction

function MakeGrade takes player gamer,integer GradeUnit,integer Grade returns nothing
    local boolexpr b= null

    set udg_LocalInteger5=GradeUnit
    set Counter=0
    set b=Condition(function ThisType)
    call GroupEnumUnitsOfPlayer(gGroup, gamer, b)
    set gUnit=BlzGroupUnitAt(gGroup, GetRandomInt(0, Counter))
    if gUnit != null then
        call IssueImmediateOrderById(gUnit, Grade)
    endif
    
    call DestroyBoolExpr(b)
    set b=null
endfunction

function MakeGradeCheckCap takes player gamer,integer GradeUnit,integer Grade,integer Cap returns nothing
    if GetPlayerTechCount(gamer, Grade, true) <= Cap then
        call MakeGrade(gamer , GradeUnit , Grade)
    endif
endfunction


