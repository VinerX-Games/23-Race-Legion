//===========================================================================
// Trigger: NavyLight
//===========================================================================
function Trig_NavyLight_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTrainedUnit()) == 'h0HN'
endfunction

function Trig_NavyLight_Actions takes nothing returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local player p= GetOwningPlayer(GetTriggerUnit())
    local location l= GetUnitRallyPoint(GetTriggerUnit())
    local unit u
    local integer pi= GetPlayerId(p)
    set a[0]=0
    
    //1 юнит
    set b=0
    set i=4
    loop // Fregat
            set a[0]=a[0] + 1
            set a[a[0]]='h0D6'
            set b=b + 1
            exitwhen b >= i
    endloop

    //4 юнит андеды
    if GetPlayerTechCount(p, 'R0D3', true) == 1 and GetPlayerTechCount(p, 'R0E9', true) != 1 then
        set i=2
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='h0J3'
            
            set b=b + 1
            exitwhen b >= i
        endloop

    endif
    
    //4 юнит андеды
    if GetPlayerTechCount(p, 'R0D2', true) == 1 and GetPlayerTechCount(p, 'R0E9', true) != 1 then
        set i=2
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='h0HT'
            
            set b=b + 1
            exitwhen b >= i
        endloop

    endif
    
    
    //Зандалары
    if GetPlayerTechCount(p, 'R0F3', true) == 1 then
        set i=2
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='h0J4'
            
            set b=b + 1
            exitwhen b >= i
        endloop

    endif
    
    //Зандалары
    if GetPlayerTechCount(p, 'R0E4', true) == 1 then
        set i=2
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='h0JB'
            
            set b=b + 1
            exitwhen b >= i
        endloop

    endif
    
    set i=GetRandomInt(1, a[0])
    set b=a[i]
    
    call aiFixTrainBefore(GetTrainedUnit() , pi)
    set u=ReplaceUnit(GetTrainedUnit() , b , bj_UNIT_STATE_METHOD_RELATIVE)
    call aiFixTrainAfter(u , pi)
//    call UnitAddAbility(u,'A0UZ')
//    call SetUnitAbilityLevel(u,'A0V0',35+udg_HordeNavyPrice[pi])
//
     
    call UnitAddAbility(u, 'A0YU')


        call IssuePointOrderLoc(u, "attack", l)

    call RemoveLocation(l)
endfunction

