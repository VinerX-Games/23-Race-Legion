// Trigger: Page2
//===========================================================================
function Trig_Page2_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0HZ'
endfunction

function Trig_Page2_Actions takes nothing returns nothing

    
    call UnitRemoveAbilityBJ(GetSpellAbilityId(), GetTriggerUnit())
    call UnitAddAbilityBJ('A1GW', GetTriggerUnit())
    
    
    
    
    call UnitAddAbilityBJ('A0HM', GetTriggerUnit()) // Алый орден
    call UnitAddAbilityBJ('A0Y0', GetTriggerUnit()) // Стром
    call UnitAddAbilityBJ('A1EG', GetTriggerUnit()) // Ледяные тролли
    
    call UnitAddAbilityBJ('A121', GetTriggerUnit()) // Worgens
    call UnitAddAbilityBJ('A0HN', GetTriggerUnit()) // Dalaran
    call UnitAddAbilityBJ('A1FN', GetTriggerUnit()) // Лесные тролли
    
    
    call UnitAddAbilityBJ('A0HR', GetTriggerUnit()) // Thieves
    call UnitAddAbilityBJ('A0HO', GetTriggerUnit()) // Kultiras
    call UnitAddAbilityBJ('A1DZ', GetTriggerUnit()) // Trolls Jungle
    
    
    
    
    
    call UnitRemoveAbilityBJ('A02A', GetTriggerUnit()) // Альянс
    call UnitRemoveAbilityBJ('A0YV', GetTriggerUnit()) // Horde
    call UnitRemoveAbilityBJ('A0HV', GetTriggerUnit()) // Plet
    call UnitRemoveAbilityBJ('A0HL', GetTriggerUnit()) // Night Elves
    
    call UnitRemoveAbilityBJ('A0HQ', GetTriggerUnit()) // Blood Elves 
    call UnitRemoveAbilityBJ('A14O', GetTriggerUnit()) // Nags 
    call UnitRemoveAbilityBJ('A0OK', GetTriggerUnit()) // Illidary 
    call UnitRemoveAbilityBJ('A0MY', GetTriggerUnit()) // Legion 
    call UnitRemoveAbilityBJ('A0HS', GetTriggerUnit()) // Draeneys 
    
endfunction

