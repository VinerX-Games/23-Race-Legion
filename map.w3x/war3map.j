//===========================================================================
// Trigger: EveryAiEnemy
//===========================================================================
function Trig_EveryAiEnemy_Actions takes nothing returns nothing
    local integer i= 0
    local force f= CreateForce()
    loop
        exitwhen i > 23
        if udg_AiControl[i] then
            call ForceAddPlayer(f, Player(i))
        endif
        
        set i=i + 1
    endloop
    call SetForceAllianceStateBJ(f, f, bj_ALLIANCE_ALLIED_VISION)
    call DisplayTimedTextFromPlayer(Player(0), 0, 0, 4, "Хост объединил всех ии в одну комманду. Вы там держитесь!")



    call DestroyForce(f)
    set f=null
endfunction

