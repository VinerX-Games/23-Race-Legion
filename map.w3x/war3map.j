//===========================================================================
// Trigger: NextMenu
//===========================================================================



function Trig_NextMenu_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0Y5'
endfunction

function Trig_NextMenu_Actions takes nothing returns nothing
    local location l= Location(0, 0)
    
    //call DisplayTextToPlayer(Player(0),0,0,"33")
    //call DisplayTextToPlayer(Player(0),0,0, I2S(ModeBuildingI))
    
    
    if ModeBuildingI < 4 then
        set ModeBuildingI=ModeBuildingI + 1
    else
        set ModeBuildingI=0
    endif
    
    call RemoveUnit(ModeBuilding)
    if ModeBuildingI == 0 then
        set ModeBuilding=CreateUnitAtLoc(Player(0), 'n04G', l, 0)
    elseif ModeBuildingI == 1 then
        set ModeBuilding=CreateUnitAtLoc(Player(0), 'n04D', l, 0)
    elseif ModeBuildingI == 2 then
        set ModeBuilding=CreateUnitAtLoc(Player(0), 'n04F', l, 0)
    elseif ModeBuildingI == 3 then
        set ModeBuilding=CreateUnitAtLoc(Player(0), 'n04H', l, 0)
    elseif ModeBuildingI == 4 then
        set ModeBuilding=CreateUnitAtLoc(Player(0), 'n04I', l, 0)
    endif
    call ClearSelectionForPlayer(Player(0))
    call SelectUnitForPlayerSingle(ModeBuilding, Player(0))
    
    
    call RemoveLocation(l)
endfunction

