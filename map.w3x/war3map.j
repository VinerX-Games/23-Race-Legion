    call DisableTrigger(gg_trg_SpawnTimer)
    call TriggerRegisterTimerExpireEventBJ(gg_trg_SpawnTimer, udg_SilitidTimer)
    call TriggerAddAction(gg_trg_SpawnTimer, function Trig_SpawnTimer_Actions)
endfunction


