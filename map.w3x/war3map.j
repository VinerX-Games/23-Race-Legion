//===========================================================================
// Trigger: No2SameItems
//===========================================================================

function Trig_No2SameItems_Actions takes nothing returns nothing
    local location l= GetUnitLoc(GetTriggerUnit())
    local integer i=0
    local item Item= GetManipulatedItem()
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=6
    
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if GetItemTypeId(Item) == GetItemTypeId(UnitItemInSlotBJ(GetTriggerUnit(), GetForLoopIndexA())) then
            set i=i + 1
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    
    if i >= 2 then
        call UnitDropItemPointLoc(GetTriggerUnit(), Item, l)
        call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()), 0, 0, "TRIGSTR_1254")
    
    endif
    call RemoveLocation(l)
    set l=null
    set Item=null
endfunction

