        set udg_LocalUnit[11]=GetAttackedUnitBJ()
        set u=udg_LocalUnit[11]
        call TriggerSleepAction(9.00)
        set udg_LocalUnit[11]=u
        call UnitRemoveAbilityBJ('A02O', udg_LocalUnit[11])
        call UnitRemoveAbilityBJ('A02Q', udg_LocalUnit[11])
        set u=null
    else
    endif
endfunction

