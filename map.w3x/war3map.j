function InitSounds takes nothing returns nothing
    set gg_snd_oep_82_nzothfish_whispers_offset_periodic_ambient_09__2_u=CreateSound("war3mapImported/oep_82_nzothfish_whispers_offset_periodic_ambient_09 (2).mp3", false, false, false, 0, 0, "DefaultEAXON")
    call SetSoundDuration(gg_snd_oep_82_nzothfish_whispers_offset_periodic_ambient_09__2_u, 144)
    call SetSoundChannel(gg_snd_oep_82_nzothfish_whispers_offset_periodic_ambient_09__2_u, 0)
    call SetSoundVolume(gg_snd_oep_82_nzothfish_whispers_offset_periodic_ambient_09__2_u, 127)
    call SetSoundPitch(gg_snd_oep_82_nzothfish_whispers_offset_periodic_ambient_09__2_u, 1.0)
