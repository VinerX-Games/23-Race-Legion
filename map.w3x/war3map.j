function InitAllyPriorities takes nothing returns nothing

    call SetStartLocPrioCount(0, 1)
    call SetStartLocPrio(0, 0, 2, MAP_LOC_PRIO_HIGH)

    call SetStartLocPrioCount(1, 5)
    call SetStartLocPrio(1, 0, 3, MAP_LOC_PRIO_LOW)
    call SetStartLocPrio(1, 1, 8, MAP_LOC_PRIO_HIGH)
    call SetStartLocPrio(1, 2, 10, MAP_LOC_PRIO_HIGH)
    call SetStartLocPrio(1, 3, 11, MAP_LOC_PRIO_LOW)
    call SetStartLocPrio(1, 4, 20, MAP_LOC_PRIO_HIGH)

    call SetStartLocPrioCount(2, 2)
    call SetStartLocPrio(2, 0, 0, MAP_LOC_PRIO_LOW)
    call SetStartLocPrio(2, 1, 12, MAP_LOC_PRIO_HIGH)

    call SetStartLocPrioCount(3, 3)
    call SetStartLocPrio(3, 0, 8, MAP_LOC_PRIO_HIGH)
    call SetStartLocPrio(3, 1, 9, MAP_LOC_PRIO_HIGH)
    call SetStartLocPrio(3, 2, 20, MAP_LOC_PRIO_HIGH)

    call SetStartLocPrioCount(4, 1)
    call SetStartLocPrio(4, 0, 21, MAP_LOC_PRIO_HIGH)

    call SetStartLocPrioCount(5, 4)
