//Подраздел континентов
// кого надо выкинуть, если он на этом континенте
function InKalim takes nothing returns boolean
    return RectContainsUnit(gg_rct_Kalim, GetFilterUnit()) != true or RectContainsUnit(gg_rct_NordNotKalim, GetFilterUnit())
endfunction

function InNord takes nothing returns boolean
    return RectContainsUnit(gg_rct_Nord, GetFilterUnit()) != true and RectContainsUnit(gg_rct_Azgel, GetFilterUnit()) != true
endfunction

function InVK takes nothing returns boolean
    return ( RectContainsUnit(gg_rct_EastenKingdoms, GetFilterUnit()) != true and RectContainsUnit(gg_rct_EasternDungeons, GetFilterUnit()) != true and RectContainsUnit(gg_rct_BlackMountain, GetFilterUnit()) != true ) or RectContainsUnit(gg_rct_OutNoVk, GetFilterUnit())
endfunction

function InBisles takes nothing returns boolean
    return RectContainsUnit(gg_rct_BrokenIsles, GetFilterUnit()) != true
endfunction

function InOutland takes nothing returns boolean
    return RectContainsUnit(gg_rct_Outland, GetFilterUnit()) != true or RectContainsUnit(gg_rct_VknotOut, GetFilterUnit())
endfunction

function InArgus takes nothing returns boolean
    return RectContainsUnit(gg_rct_Argus, GetFilterUnit()) != true
endfunction

function InPandaria takes nothing returns boolean
    return RectContainsUnit(gg_rct_Pandaria, GetFilterUnit()) != true
endfunction


// Подземки
function InAnkirag takes nothing returns boolean
    return RectContainsUnit(gg_rct_Ankirag, GetFilterUnit()) != true
endfunction

function InAzgel takes nothing returns boolean
    return RectContainsUnit(gg_rct_Azgel, GetFilterUnit()) != true
endfunction

function InBlackRock takes nothing returns boolean
    return RectContainsUnit(gg_rct_BlackMountain, GetFilterUnit()) != true
endfunction

function InOrgrimmar takes nothing returns boolean
    return RectContainsUnit(gg_rct_Orgrimmar, GetFilterUnit()) != true
endfunction

function InDeadMines takes nothing returns boolean
    return RectContainsUnit(gg_rct_DeadMines, GetFilterUnit()) != true
endfunction

function InStalgorn takes nothing returns boolean
    return RectContainsUnit(gg_rct_Stalgorn, GetFilterUnit()) != true
endfunction

function InUldum takes nothing returns boolean
    return RectContainsUnit(gg_rct_Uldum, GetFilterUnit()) != true
endfunction

function InMaradon takes nothing returns boolean
    return RectContainsUnit(gg_rct_Maradon, GetFilterUnit()) != true
endfunction

function InUndercity takes nothing returns boolean
    return RectContainsUnit(gg_rct_Undercity, GetFilterUnit()) != true
endfunction

// Летающие города
function InDalaran takes nothing returns boolean
    return RectContainsUnit(gg_rct_KillDalaran, GetFilterUnit()) != true
endfunction

function InNaxramas takes nothing returns boolean
    return RectContainsUnit(gg_rct_Naxramas, GetFilterUnit()) != true
endfunction


function SetContinetsBooleprs takes nothing returns nothing

    set udg_B_InKalim=Condition(function InKalim)
    set udg_B_InNord=Condition(function InNord)
    set udg_B_InVK=Condition(function InVK)
    set udg_B_InOutland=Condition(function InOutland)
    set udg_B_InBIsles=Condition(function InBisles)
    set udg_B_InArgus=Condition(function InArgus)
    set udg_B_InPandaria=Condition(function InPandaria)
    
    // Подземки
    set udg_B_Ankirag=Condition(function InAnkirag)
    set udg_B_Azgel=Condition(function InAzgel)
    set udg_B_BlackRock=Condition(function InBlackRock)
    set udg_B_Orgrimmar=Condition(function InOrgrimmar)
    set udg_B_DeadMines=Condition(function InDeadMines)
    set udg_B_Stalgorn=Condition(function InStalgorn)
    set udg_B_Uldum=Condition(function InUldum)
    set udg_B_Maradon=Condition(function InMaradon)
    set udg_B_Undercity=Condition(function InUndercity)
    
    //Летающие города
    set udg_B_Dalaran=Condition(function InDalaran)
    set udg_B_Naxramas=Condition(function InNaxramas)

endfunction

// Инициализирует все это дело
function initContinentalBoolExprs___Init takes nothing returns nothing
    call SetContinetsBooleprs()
endfunction

