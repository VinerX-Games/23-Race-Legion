//===========================================================================
// Trigger: CheckType
//===========================================================================
function Trig_CheckType_Actions takes nothing returns nothing
    local group g= CreateGroup()
    local unit u
    local integer i= 0
    local integer b= 0
    call GroupEnumUnitsSelected(g, Player(0), null)
    set u=FirstOfGroup(g)
    //call DisplayTimedTextFromPlayer(Player(0),0,0, 4, "Айди владельца "+I2S(GetPlayerId(GetOwningPlayer(u)))+" Айди юнита "+I2S(GetUnitTypeId(u)))
    call DisplayTimedTextFromPlayer(Player(0), 0, 0, 4, "Юнитов такого типа")
    loop
        exitwhen i == 23
        set b=LoadInteger(AiData, i, GetUnitTypeId(u))
        call DisplayTimedTextFromPlayer(Player(0), 0, 0, 4, GetPlayerName(Player(i)) + " кол-во " + I2S(b))
        set i=i + 1
    endloop
    


endfunction

