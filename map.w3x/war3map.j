function Trig_Portal_Periodic_Func001Func006Func002Func011Func004C takes nothing returns boolean
    if ( not ( udg_Portal_missileTargetable[udg_Portal_INDEX_TARGET] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func001Func006Func002Func011Func012Func004C takes nothing returns boolean
    if ( not ( IsUnitSelected(udg_Portal_traveller, GetOwningPlayer(udg_Portal_traveller)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func001Func006Func002Func011Func012Func005C takes nothing returns boolean
    if ( not ( udg_Portal_missileTargetable[udg_Portal_INDEX_TARGET] == true ) ) then
        return false
    endif
