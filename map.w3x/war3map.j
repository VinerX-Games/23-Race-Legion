//===========================================================================
// Trigger: UnitUpgraded
//===========================================================================
function Trig_UnitUpgraded_Conditions takes nothing returns boolean
    return GetUnitState(GetTriggerUnit(), UNIT_STATE_LIFE) > 0 and GetUnitFoodMade(GetTriggerUnit()) >= 1
endfunction

function Trig_UnitUpgraded_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local player p= GetOwningPlayer(u)
    local integer pi= GetPlayerId(p)
    local integer i= GetUnitFoodMade(u)
    
    //Добавляю инком
    
    
    if GetUnitAbilityLevel(u, 'A0LJ') >= 1 then
        if i == 200 then
            set income[pi]=income[pi] + 170
        elseif i == 300 then
            set income[pi]=income[pi] + 100
        
        endif
           
    elseif GetUnitTypeId(u) == 'h0HU' then
        set income[pi]=income[pi] + 35
    endif
    
    
    call UpdateGraf(pi)
    
    
    set u=null
endfunction

