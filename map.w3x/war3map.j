function Trig_AttackerAi_Conditions takes nothing returns boolean
    set gAttacker=GetAttacker()
    set gPlayer=GetOwningPlayer(gAttacker)
    set gPi=GetPlayerId(gPlayer)
    return udg_AiControl[gPi]
endfunction

function Trig_AttackerAi_Actions takes nothing returns nothing
    local integer id= GetUnitTypeId(gAttacker)
    
    set gTarget=GetTriggerUnit()
    if AiRace[gPi] == "Scarlet" then
        call Attacker_Skarlet(id , gAttacker , gTarget , gPlayer)
    elseif AiRace[gPi] == "BloodElves" then
        call Attacker_BloodElves(id , gAttacker , gTarget , gPlayer)
    elseif AiRace[gPi] == "Naga" then
        call Attacker_Naga(id , gAttacker , gTarget , gPlayer)
    elseif AiRace[gPi] == "Goblins" then
        call Attacker_Goblins(id , gAttacker , gTarget , gPlayer)
    elseif AiRace[gPi] == "Horde" then
        call Attacker_Goblins(id , gAttacker , gTarget , gPlayer)
    endif

endfunction

