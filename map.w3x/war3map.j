function InitTrig_Sand_Strike_Loop takes nothing returns nothing
    set gg_trg_Sand_Strike_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_Sand_Strike_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Sand_Strike_Loop, 0.04)
    call TriggerAddAction(gg_trg_Sand_Strike_Loop, function Trig_Sand_Strike_Loop_Actions)
endfunction

