function Trig_DiyGoblinW2_Conditions takes nothing returns boolean
    //return GetUnitAbilityLevel(GetTriggerUnit(),'w2a0' ) > 0 
    return GetUnitTypeId(GetTriggerUnit()) == 'w206'
endfunction 


function Trig_DiyGoblinW2_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local player p= GetOwningPlayer(u)
    local real hp= GetUnitState(u, UNIT_STATE_LIFE)
    local integer uh= GetHandleId(u)
    local integer lvl= LoadInteger(Hash, uh, 0)
    local boolexpr Zepp
    local unit u2
    local group g
    
    
    
    
    if Random(3 , 4) then
        
        set udg_LocalPlayer=GetOwningPlayer(u)
        set Zepp=Condition(function FZepp)
        set g=CreateGroup()
        call GroupEnumUnitsInRangeCounted(g, GetUnitX(u), GetUnitY(u), 1000, Zepp, 5)
        
        
        set u2=BlzGroupUnitAt(g, GetRandomInt(1, BlzGroupGetSize(g)))
        if u2 != null and UnitAlive(u2) then
                   
            call RemoveEffectTimed(AddSpecialEffect("Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl", GetUnitX(u2), GetUnitY(u2)) , 1)
            call CreateUnit(p, 'w206', GetUnitX(u2), GetUnitY(u2), 0.0)
            call AddXp(u2 , 100 * lvl + 25 * lvl)
        endif
    endif
    
    
    call DestroyGroup(g)
    set g=null
    set u=null
    set u2=null
endfunction

