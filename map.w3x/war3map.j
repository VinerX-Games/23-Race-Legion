//===========================================================================
// Trigger: GelbinSpellAttacked
//===========================================================================
function Trig_GelbinSpellAttacked_Conditions takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0XC', GetTriggerUnit()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_GelbinSpellAttacked_Func001Func001Func002Func002C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(GetTriggerUnit()) < 80.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_GelbinSpellAttacked_Func001Func001Func002C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(GetTriggerUnit()) < 60.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_GelbinSpellAttacked_Func001Func001C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(GetTriggerUnit()) < 40.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_GelbinSpellAttacked_Func001C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(GetTriggerUnit()) < 20.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_GelbinSpellAttacked_Actions takes nothing returns nothing
    if ( Trig_GelbinSpellAttacked_Func001C() ) then
        call SetUnitAbilityLevelSwapped('A0XD', GetTriggerUnit(), 5)
    else
        if ( Trig_GelbinSpellAttacked_Func001Func001C() ) then
            call SetUnitAbilityLevelSwapped('A0XD', GetTriggerUnit(), 4)
        else
            if ( Trig_GelbinSpellAttacked_Func001Func001Func002C() ) then
                call SetUnitAbilityLevelSwapped('A0XD', GetTriggerUnit(), 3)
            else
                if ( Trig_GelbinSpellAttacked_Func001Func001Func002Func002C() ) then
                    call SetUnitAbilityLevelSwapped('A0XD', GetTriggerUnit(), 2)
                else
                    call SetUnitAbilityLevelSwapped('A0XD', GetTriggerUnit(), 1)
                endif
            endif
        endif
    endif
endfunction

//===========================================================================
function InitTrig_GelbinSpellAttacked takes nothing returns nothing
    set gg_trg_GelbinSpellAttacked=CreateTrigger()
    call DisableTrigger(gg_trg_GelbinSpellAttacked)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_GelbinSpellAttacked, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_GelbinSpellAttacked, Condition(function Trig_GelbinSpellAttacked_Conditions))
