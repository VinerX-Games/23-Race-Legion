function Trig_Page4_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0QR'
endfunction

function Trig_Page4_Actions takes nothing returns nothing


    
    
        
    
    call UnitAddAbilityBJ('A0QN', GetTriggerUnit()) // Elems
    call UnitAddAbilityBJ('A0HT', GetTriggerUnit()) // Nerubs
    call UnitAddAbilityBJ('A0QQ', GetTriggerUnit()) // Argwinol (Ent)
    
    call UnitAddAbilityBJ('A0RQ', GetTriggerUnit()) // Dragons
    call UnitAddAbilityBJ('A0J7', GetTriggerUnit()) // Ogres
    call UnitAddAbilityBJ('A1HA', GetTriggerUnit()) // Cult of Damned
    
    
    call UnitAddAbilityBJ('A1JN', GetTriggerUnit()) // HordeW2
    call UnitAddAbilityBJ('A0HW', GetTriggerUnit()) // Faceless

    
    
        
    
    
    call UnitRemoveAbilityBJ('A0SD', GetTriggerUnit()) // Gnomes
    call UnitRemoveAbilityBJ('A0AC', GetTriggerUnit()) // Goblins
    call UnitRemoveAbilityBJ('A0HU', GetTriggerUnit()) // Nighborn
    
    call UnitRemoveAbilityBJ('A0HP', GetTriggerUnit()) // Vryculs
    call UnitRemoveAbilityBJ('A17N', GetTriggerUnit()) // Ogres
    call UnitRemoveAbilityBJ('A155', GetTriggerUnit()) // Forsacen
    
    
    call UnitRemoveAbilityBJ('A1I6', GetTriggerUnit()) // Pandarens
    call UnitRemoveAbilityBJ('A0HX', GetTriggerUnit()) // Twilig cult
    call UnitRemoveAbilityBJ('A1JL', GetTriggerUnit()) // Horde of Fel
    
    
        
    
    
    call UnitAddAbility(GetTriggerUnit(), 'A0I1')
    call UnitRemoveAbility(GetTriggerUnit(), GetSpellAbilityId())
endfunction

