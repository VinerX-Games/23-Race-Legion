function Trig_UnitEnterMap_Conditions takes nothing returns boolean
    set gTriggerUnit=GetEnteringUnit()
    return GetUnitAbilityLevel(gTriggerUnit, 'A0Z5') == 0 //Проверка на даммика или юнита вне экономики
endfunction

function Trig_UnitEnterMap_Actions takes nothing returns nothing

    if GetUnitState(gTriggerUnit, UNIT_STATE_LIFE) < 0.7 then
        if not IsUnitInGroup(gTriggerUnit, DeadGroup) then
            call GroupAddUnit(DeadGroup, gTriggerUnit)
            call TriggerRegisterUnitStateEvent(gg_trg_UnitRevive, gTriggerUnit, UNIT_STATE_LIFE, GREATER_THAN, 0.60)
        endif
        
        return
    endif
    
    call AddCountDis(gTriggerUnit , GetPlayerId(GetOwningPlayer(gTriggerUnit)))

endfunction

