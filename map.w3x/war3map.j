//***************************************************************************
//*  aiUnitJoinsCapitalGuard



function aiUnitJoinsCapitalGuard takes unit u,integer pi returns boolean
    if playerCapital[pi] == null then
         if udg_Octhet then
            //call BJDebugMsg("Не прошел в стражу нет столицы")
         endif
         return false
    elseif DistanceBetweenUnits(playerCapital[pi] , u) > 3000 then
         if udg_Octhet then
            //call BJDebugMsg("Не прошел в стражу расстояние "+ R2SW_Polyfill(DistanceBetweenUnits(playerCapital[pi],u))) 
         endif
         return false
    elseif LoadInteger(AiData, pi, StringHash("NumberGuard")) + 15 > LoadInteger(AiData, pi, StringHash("Number")) / 5 then
        //call BJDebugMsg("Не прошел в стражу стража больше "+I2S(LoadInteger(AiData,pi,StringHash("NumberGuard")))+I2S(LoadInteger(AiData,pi,StringHash("Number"))/5))
        return false
    endif

    call NumberAdd(pi , StringHash("NumberGuard"))
    call GroupAddUnit(AiCapitalGuard[pi], u)
    call IssuePointOrder(u, "smart", GetUnitX(playerCapital[pi]), GetUnitY(playerCapital[pi]))
    
    return true
endfunction
//***************************************************************************
//*  AttackerHumanFleet
function Attacker_HumanFleet takes integer id,unit u,unit target,real x,real y returns nothing
    
    if id == 'h00Z' or id == 'h00Y' and IsUnitType(target, UNIT_TYPE_STRUCTURE) == false then
        set gInt=GetRandomInt(1, 6)
        if gInt == 1 and GetUnitStatePercent(target, UNIT_STATE_LIFE, UNIT_STATE_MAX_LIFE) < GetUnitStatePercent(u, UNIT_STATE_LIFE, UNIT_STATE_MAX_LIFE) then
            set gX2=GetUnitX(u) - GetUnitX(target)
            set gY2=GetUnitY(u) - GetUnitY(target)
            if SquareRoot(gX2 * gX2 + gY2 * gY2) < 125 then
                call IssueTargetOrder(u, "ancestralspirit", target)
            else
                //call IssuePointOrder(u, "Move", x,y)
            endif
        elseif gInt == 2 then
            set gX2=GetUnitX(u) - GetUnitX(target)
            set gY2=GetUnitY(u) - GetUnitY(target)
            if SquareRoot(gX2 * gX2 + gY2 * gY2) < 300 then
                call IssuePointOrder(u, "clusterrockets", x, y)
            else
                //call IssuePointOrder(u, "Move", x,y)
            endif
            
            
        elseif gInt == 3 and GetUnitStatePercent(u, UNIT_STATE_LIFE, UNIT_STATE_MAX_LIFE) < 40 then
            call IssueImmediateOrder(u, "tranquility")
        endif
    endif

endfunction
