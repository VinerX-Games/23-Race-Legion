//***************************************************************************
//*  XpLevelW2
function AddXp takes unit u,real addXp returns nothing
    local integer uh= GetHandleId(u)
    local integer lvl= LoadInteger(Hash, uh, 0)
    local real xp= LoadReal(Hash, uh, 1)
    local real r
    

    if lvl < 10 then
        set xp=xp + addXp
        
        loop
        
            exitwhen xp < 100 + 25 * lvl
            
        
            set r=GetUnitLifePercent(u)
            call BlzSetUnitMaxHP(u, MathRound(BlzGetUnitMaxHP(u) * 1.035))
            call SetUnitLifePercentBJ(u, r)
            
            set r=GetUnitManaPercent(u)
            call BlzSetUnitMaxMana(u, MathRound(BlzGetUnitMaxMana(u) * 1.035))
            call SetUnitManaPercentBJ(u, r)
            call BlzSetUnitBaseDamage(u, MathRound(BlzGetUnitBaseDamage(u, 0) * 1.04), 0)
            call BlzSetUnitBaseDamage(u, MathRound(BlzGetUnitBaseDamage(u, 1) * 1.04), 1)
        
        
            
            

            set xp=xp - ( 100 + 25 * lvl )
            set lvl=lvl + 1
            
            call SetUnitAbilityLevel(u, 'w2a0', lvl)
            
        endloop
        
        
        
        call SaveInteger(Hash, uh, 0, lvl) //StringHash("lvl"),lvl)
        call SaveReal(Hash, uh, 1, xp) //StringHash("xp"),xp)
    endif

endfunction


