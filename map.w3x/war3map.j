    set gg_trg_TechT1=CreateTrigger()
    call DisableTrigger(gg_trg_TechT1)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_TechT1, EVENT_PLAYER_UNIT_TRAIN_FINISH)
    call TriggerAddCondition(gg_trg_TechT1, Condition(function Trig_TechT1_Conditions))
    call TriggerAddAction(gg_trg_TechT1, function Trig_TechT1_Actions)
endfunction


