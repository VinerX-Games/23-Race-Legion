//===========================================================================
// Trigger: ReturnDamage
//===========================================================================
function Trig_ReturnDamage_Conditions takes nothing returns boolean
    return GetUnitAbilityLevel(GetTriggerUnit(), 'A1GQ') > 0
endfunction


function Trig_ReturnDamage_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local unit u2= null
    local group g= CreateGroup()
    local boolexpr b
    local lightning l
    local real damage= GetEventDamage() * 1.30
    call DisableTrigger(GetTriggeringTrigger())
    set udg_LocalPlayer=GetOwningPlayer(u)
    set udg_LocalInteger2=0
    set b=Condition(function isEnemy)
    call GroupEnumUnitsInRange(g, GetUnitX(u), GetUnitY(u), 550, b)
   // set u2 = FirstOfGroup(g) 
    if udg_LocalInteger2 > 0 then
        set u2=BlzGroupUnitAt(g, GetRandomInt(0, udg_LocalInteger2 - 1))
        if u2 != null and UnitAlive(u2) and u != u2 then
            call SetUnitLifeBJ(u, GetUnitState(u, UNIT_STATE_LIFE) + damage)
            call UnitDamageTargetBJ(u, u2, damage, ATTACK_TYPE_HERO, DAMAGE_TYPE_DEATH)
            set l=AddLightning("MFPB", true, GetUnitX(u), GetUnitY(u), GetUnitX(u2), GetUnitY(u2))
            call RemoveLigtingTimed(l , 0.9)
            
        endif
    endif
    call DestroyGroup(g)
    call DestroyBoolExpr(b)
    set g=null
    set b=null
    set l=null
    set u=null
    set u2=null
    
    call EnableTrigger(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_ReturnDamage takes nothing returns nothing
    set gg_trg_ReturnDamage=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ReturnDamage, EVENT_PLAYER_UNIT_DAMAGED)
    call TriggerAddCondition(gg_trg_ReturnDamage, Condition(function Trig_ReturnDamage_Conditions))
    call TriggerAddAction(gg_trg_ReturnDamage, function Trig_ReturnDamage_Actions)
endfunction


