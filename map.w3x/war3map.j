    if ( Trig_TankChangeAttack_Func001C() ) then
        call BlzSetUnitWeaponBooleanFieldBJ(GetTriggerUnit(), UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, false)
        call BlzSetUnitWeaponBooleanFieldBJ(GetTriggerUnit(), UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, true)
    else
