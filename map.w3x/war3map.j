    call TriggerAddAction(gg_trg_PerebobNavy, function PlayerNavy)
endfunction


//===========================================================================
// Trigger: PereborBuildings
//===========================================================================

function Trig_PereborBuildings_Code_Func002A takes nothing returns nothing
    local group g= CreateGroup()
    local player p= GetEnumPlayer()
    local integer pi
    local integer id
    local integer i
    local integer b
    local integer array a
    local unit u
    local integer HaveOrder= 0
    
    set udg_LocalInteger2=GetPlayerId(GetEnumPlayer())
    set pi=GetPlayerId(p)
    
    call GroupEnumUnitsOfPlayer(g, p, B_OnlyNeaded)

    // Пропуск если 0 или лимит юнитов
    if FirstOfGroup(g) == null or LoadInteger(AiData, pi, StringHash("Number")) > 10 * AiLimit then
        if udg_Octhet then
            call DisplayTimedTextFromPlayer(p, 0, 0, 4, GetPlayerName(p) + " - достиг предела юнитов")
        endif
        
        call DestroyGroup(g)
        set g=null
        set u=null
        set p=null
        return
    endif
    
    //Собсвтенно группа зданий, которые надо чекать 
    
    
    
    
    
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd or FirstOfGroup(g) == null
        set u=GroupPickRandomUnit(g)
        call GroupRemoveUnit(g, u)
        set id=GetUnitTypeId(u)
        
        if AiRace[pi] == "Scarlet" then
            if id == 'h05Z' then //Казармы
   
                set a[0]=1 //Кол-во вариантов со старта
                set a[1]='h03B' // 1 Пехотинец

                // Доп. варианты при условиях

                // 2 Лучник
                if LoadInteger(AiData, pi, 'h060') >= 1 then
                    set i=1 //мошь выбора
                    set b=1
                    
                    loop
                        set a[0]=a[0] + 1
                        set a[a[0]]='n007'
                        
                        set b=b + 1
                        exitwhen b >= i
                    endloop
                endif
                
                // 3 Тяж Мечник
                if LoadInteger(AiData, pi, 'h05V') + LoadInteger(AiData, pi, 'h05W') >= 1 then
                    set i=4 //мошь выбора
                    set b=1
                    
                    loop
                        set a[0]=a[0] + 1
                        set a[a[0]]='h039'
                        set b=b + 1
                        exitwhen b >= i
                    endloop
                endif
                
                // 4 Всадник
                if LoadInteger(AiData, pi, 'h05W') >= 1 then
                    set i=6 //мошь выбора
                    set b=1
                    
                    loop
                        set a[0]=a[0] + 1
                        set a[a[0]]='h066'
                        set b=b + 1
                        exitwhen b >= i
                    endloop
                endif
                set i=GetRandomInt(1, a[0])
                call IssueImmediateOrderById(u, a[i])
            

            // Ратуша
            elseif id == 'h05U' then
             
                
                set udg_LocalInteger3=GetRandomInt(1, 3)
                if udg_LocalInteger3 == 1 and LoadInteger(AiData, pi, 'h014') < 20 then
                    call IssueImmediateOrderById(u, 'h014')

                elseif udg_LocalInteger3 == 2 and LoadInteger(AiData, pi, 'h03C') < 15 then
                    call IssueImmediateOrderById(u, 'h03C')
                    
                elseif udg_LocalInteger3 == 3 and LoadInteger(AiData, pi, 'h03A') < 15 then
                    call IssueImmediateOrderById(u, 'h03A')
                else
                endif
            
            // Мастеская
            elseif id == 'h064' then
                call IssueImmediateOrderById(u, 'o00I')


            elseif id == 'h061' then
                set udg_LocalInteger3=GetRandomInt(1, 2)
                if udg_LocalInteger3 == 1 then
                    call IssueImmediateOrderById(u, 'h067')
                elseif udg_LocalInteger3 == 2 then
                    call IssueImmediateOrderById(u, 'n008')
                endif
            
            // Алтарь
            elseif id == 'h05X' then
                set udg_LocalInteger3=GetRandomInt(1, 3)
                if udg_LocalInteger3 == 1 then
                    call IssueImmediateOrderById(u, 'H06C')
                endif
                if udg_LocalInteger3 == 2 then
                    call IssueImmediateOrderById(u, 'H03H')
                endif
                if udg_LocalInteger3 == 3 then
                    call IssueImmediateOrderById(u, 'H06B')
                endif
            // Церковь
            elseif id == 'h068' then

                set a[0]=1 //Кол-во вариантов со старта
                set a[1]=0 // Никто

                // Доп. варианты при условиях

                // 1 Паладин
                if LoadBoolean(AiData, pi, 'R040') and LoadInteger(AiData, pi, 'h05W') >= 1 then
                    set i=1 //мошь выбора
                    set b=1
                    
                    loop
                        set a[0]=a[0] + 1
                        set a[a[0]]='h03F'
                        
                        set b=b + 1
                        exitwhen b >= i
                    endloop
                endif
                
                // 3 Берсерк
                if LoadBoolean(AiData, pi, 'R040') and LoadInteger(AiData, pi, 'h05W') >= 1 then
                    set i=1 //мошь выбора
                    set b=1
                    
                    loop
                        set a[0]=a[0] + 1
                        set a[a[0]]='h03D'
                        set b=b + 1
                        exitwhen b >= i
                    endloop
                endif
                
                 // 3 Инквизитор
                if LoadBoolean(AiData, pi, 'R03Z') and LoadInteger(AiData, pi, 'h05W') >= 1 then
                    set i=1 //мошь выбора
                    set b=1
                    
                    loop
                        set a[0]=a[0] + 1
                        set a[a[0]]='h03I'
                        
                        set b=b + 1
                        exitwhen b >= i
                    endloop
                endif
                
                // 4 Гладиатор
                if LoadBoolean(AiData, pi, 'R03Z') and LoadInteger(AiData, pi, 'h05W') >= 1 then
                    set i=1 //мошь выбора
                    set b=1
                    
                    loop
                        set a[0]=a[0] + 1
                        set a[a[0]]='h03G'
                        set b=b + 1
                        exitwhen b >= i
                    endloop
                endif
                
                set i=GetRandomInt(1, a[0])
                call IssueImmediateOrderById(u, a[i])
                
            endif
        
        elseif AiRace[pi] == "BloodElves" then

            call PereborBuildings2_BloodElves(id , pi , u)
            
        endif
        
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    
    
    
    
    call DestroyGroup(g)
    set g=null
    set p=null
endfunction

function Trig_PereborBuildings_Actions takes nothing returns nothing
    call PauseTimer(udg_TimerSmall3)
    if udg_Octhet then
        call DisplayTimedTextFromPlayer(Player(0), 0, 0, 4, "Тик зданий")
    endif
    call ForForce(udg_Bots, function Trig_PereborBuildings_Code_Func002A)
    if udg_Octhet then
        call DisplayTimedTextFromPlayer(Player(0), 0, 0, 4, "Конец тика зданий")
    endif
    call TimerStart(udg_TimerSmall3, 9.00 * AiRepeat / 5, false, null)
endfunction

