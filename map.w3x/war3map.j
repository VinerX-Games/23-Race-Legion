//===========================================================================
// Trigger: VaishArrow
//===========================================================================
function Trig_VaishArrow_Conditions takes nothing returns boolean
    set gTarget=BlzGetEventDamageTarget()
    set gCaster=GetEventDamageSource()
    //call BJDebugMsg("Test 1"+GetUnitName(gTarget)+GetUnitName(gCaster)+I2S(GetUnitAbilityLevel(gTarget, 'B06P'))+I2S(GetUnitAbilityLevel(gTarget, 'B06Q')) )
    //return GetUnitAbilityLevel(gTarget, 'B06P')>0 and GetUnitAbilityLevel(gTarget, 'B06Q')==0 
    return GetUnitAbilityLevel(gCaster, 'A16C') > 0 and BlzGetEventAttackType() == ATTACK_TYPE_NORMAL and Random(1 , 10)
endfunction

function Trig_VaishArrow_Actions takes nothing returns nothing
    //call BJDebugMsg("Test 2"+GetUnitName(gTarget)+GetUnitName(gCaster))
    call DummyCastTargetLevel('A16D' , "frostnova" , gCaster , gTarget , GetUnitAbilityLevel(gCaster, 'A16C'))
endfunction

