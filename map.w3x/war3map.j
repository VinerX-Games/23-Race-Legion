//===========================================================================
function Trig_ZacliatieOfLive_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A1G5'
endfunction


function zlifeend takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer id= GetHandleId(t)
    local unit u2= LoadUnitHandle(Hash, id, 1)
    call UnitRemoveAbility(u2, 'A1G6')
    call FlushChildHashtable(Hash, id)
    call DestroyTimer(t)
    set t=null
    set u2=null
endfunction




function Trig_ZacliatieOfLive_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local timer t= CreateTimer()
    local integer id= GetHandleId(t)
    
    call UnitAddAbility(u, 'A1G6')
    call TriggerRegisterUnitEvent(gg_trg_SetLifeNormal, u, EVENT_UNIT_DAMAGING)
    call TimerStart(t, 15 * GetUnitAbilityLevel(u, 'A1G5'), false, function zlifeend)
    call SaveUnitHandle(Hash, id, 1, u)
    
    set u=null


    set t=null
endfunction

