function Trig_Leave_Army_U_Conditions takes nothing returns boolean
    return IsUnitInGroup(GetTriggerUnit(), udg_Ai_army[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]) and IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) != true
endfunction

function Trig_Leave_Army_U_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local integer pi= GetPlayerId(GetOwningPlayer(u))
    call GroupRemoveUnit(udg_Ai_army[pi], u)
    call GroupRemoveUnit(udg_Ai_units[pi], u)
    call NumberRem(pi , GetUnitTypeId(u))
    call NumberRem(pi , StringHash("Number"))
    
    set u=null
endfunction

