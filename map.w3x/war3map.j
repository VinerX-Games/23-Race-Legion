//===========================================================================
// Trigger: CommonHome
//===========================================================================
function Trig_CommonHome_Conditions takes nothing returns boolean
    return GetResearched() == 'R0EH'
endfunction

function NoneRadicals takes nothing returns boolean
    local integer id= GetUnitTypeId(GetFilterUnit())
    return ( id == 'o01U' or id == 'o01Z' or id == 'o02G' or id == 'o01Y' or id == 'o01S' or id == 'o01E' or id == 'o02L' )

endfunction

function Trig_CommonHome_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local player p= GetOwningPlayer(u)
    local integer pi= GetPlayerId(p)
    local group g= CreateGroup()
    set udg_MainPrice[pi]=udg_MainPrice[pi] - 10
    call countAll(p)

    
    
    
    //End other races
    set g=CreateGroup()
    set udg_Boolexpr=Condition(function NoneRadicals)
    call GroupEnumUnitsOfPlayer(g, p, udg_Boolexpr)
    loop
        set u=FirstOfGroup(g)
        exitwhen u == null
        
        call SetUnitOwner(u, Player(24), true)
        
        call GroupRemoveUnit(g, u)
        set u=null
    endloop
    
    
    
    // Бонусы ЧГ -
    if GetPlayerTechCount(p, 'R0D1', true) == 1 then
        set udg_MainPrice[pi]=udg_MainPrice[pi] + 3
        //set udg_HordeLandPrice[pi] = udg_HordeLandPrice[pi] + 5
        
    endif
    call SetPlayerTechResearched(p, 'R0D1', 2)
     
    
    // Бонусы Драконьей пасти  -
    if GetPlayerTechCount(p, 'R0E1', true) == 1 then
        set udg_MainPrice[pi]=udg_MainPrice[pi] + 3
        //set udg_HordeLandPrice[pi] = udg_HordeLandPrice[pi] + 5
        //set udg_HordeElitePrice[pi] = udg_HordeElitePrice[pi] + 3
        
    endif
    call SetPlayerTechResearched(p, 'R0E1', 2)
     
    // Бонусы Кор Крон  -
    if GetPlayerTechCount(p, 'R0E0', true) == 1 then
        set udg_MainPrice[pi]=udg_MainPrice[pi] - 5
        //set udg_HordeElitePrice[pi] = udg_HordeElitePrice[pi] + 5
        
    endif
    call SetPlayerTechResearched(p, 'R0E0', 2)
    
    
    
    
    
    
    //call SetPlayerTechMaxAllowed(p,'R0EA',1)
    //call SetPlayerTechResearched(p,'R0E7',1) //Разрешает дд
    call DestroyGroup(g)
    
    
    
    //call ChangeLandUnitsNow(p,pi)
    //call ChangeMagicUnitsNow(p,pi)
    //call ChangeTechUnitsNow(p,pi)
    //call ChangeEliteUnitsNow(p,pi)
    
    call SetPlayerTechMaxAllowed(p, 'R0F3', 1)
    call SetPlayerTechMaxAllowed(p, 'R0F4', 1)
    
    
    call SetPlayerTechMaxAllowed(p, 'R0EI', 0)
    call SetPlayerTechMaxAllowed(p, 'R0E9', 0)
    set p=null
    set u=null
    
endfunction

