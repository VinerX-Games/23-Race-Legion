//===========================================================================
// Trigger: Race Random
//===========================================================================
function Trig_Race_Random_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A12Q'
endfunction


function incN takes nothing returns integer
    set icrisingN=icrisingN + 1
    return icrisingN
endfunction

function Trig_Race_Random_Actions takes nothing returns nothing
    local integer racecount= 34
    local integer racechance
    local location l= GetUnitLoc(GetTriggerUnit())
    local player p= GetOwningPlayer(GetTriggerUnit())
    call RemoveUnit(GetSpellAbilityUnit())
    set racechance=GetRandomInt(1, racecount)
    set icrisingN=0
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'h0G9', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R0H3', 1, p)
        call SetPlayerTechResearchedSwap('R0HY', 1, p)
        call TriggerExecute(gg_trg_StromgardOn)
    endif
    
    //Драконы
    if racechance == incN() then
        
        call CreateNUnitsAtLoc(1, 'dra1', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R0BY', 1, p)
        call DragonsOn()
    endif
    //Элементали
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'e00F', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R0A2', 1, p)
        call ElemOn()
    endif
    
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'n00V', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R07E', 1, p)
        call SetPlayerTechResearchedSwap('R0J3', 1, p)
        call TriggerExecute(gg_trg_GoblinsOn)
    endif
    
    if racechance == incN() then
        call CreateNUnitsAtLoc(8, 'e02Y', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R0AO', 1, p)
    endif
    
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'h0EI', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R07H', 1, p)
        call SetPlayerTechResearchedSwap('R0KZ', 1, p) //Illidary or Nagi
        call SetPlayerTechResearchedSwap('R0L0', 1, p) //Illidary or Blood elves
        call ConditionalTriggerExecute(gg_trg_IllidaryOn)
    endif
    
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'h002', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R00G', 1, p)
        call TriggerExecute(gg_trg_BanditsOn)
    endif
    
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'h014', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R07B', 1, p)
    endif
    
    if racechance == incN() then
        call CreateNUnitsAtLoc(3, 'u00P', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R07I', 1, p)
        call ConditionalTriggerExecute(gg_trg_UndeadOn)
    endif
    // Blood elves
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'h04K', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R07C', 1, p)
        call SetPlayerTechResearchedSwap('R0L0', 1, p)
        call ConditionalTriggerExecute(gg_trg_BloodElvesOn)
    endif
    
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'opeo', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R0DV', 1, p)
        call SetPlayerTechResearchedSwap('R0J3', 1, p)
        call ConditionalTriggerExecute(gg_trg_HordeOn)
    endif
    //Dalaran
    if racechance == incN() then
        call CreateNUnitsAtLoc(3, 'u001', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R0BW', 1, p)
        call SetPlayerTechResearchedSwap('R0KK', 1, GetOwningPlayer(GetTriggerUnit()))
    endif
    
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'h013', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R07D', 1, p)
        call SetPlayerTechResearchedSwap('R0HX', 1, p)
    endif
    
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'h0CJ', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R07J', 1, p)
    endif
    
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'h012', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R07G', 1, p)
    endif
    
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'h0C9', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R07F', 1, p)
    endif
    
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'o00J', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R07K', 1, p)
    endif
    
    if racechance == incN() then
        call CreateNUnitsAtLoc(3, 'h0BE', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R07N', 1, p)
    endif
    
    if racechance == incN() then
        call CreateNUnitsAtLoc(3, 'h0BE', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R07N', 1, p)
    endif
    
    if racechance == incN() then
        call CreateNUnitsAtLoc(8, 'e01G', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R0BV', 1, p)
        call SetPlayerAbilityAvailableBJ(true, 'A1B7', p)
        call ConditionalTriggerExecute(gg_trg_SilitidsOn)
    endif
    
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'h0FA', p, l, bj_UNIT_FACING)
        call CreateNUnitsAtLoc(1, 'h0FX', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R0BX', 1, p)
        call SetPlayerTechResearchedSwap('R0HW', 1, p)
        call ConditionalTriggerExecute(gg_trg_GnomesOn)
    endif
    
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'h0FA', p, l, bj_UNIT_FACING)
        call CreateNUnitsAtLoc(1, 'h0FX', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R0BX', 1, p)
        call SetPlayerTechResearchedSwap('R0HW', 1, p)
        call ConditionalTriggerExecute(gg_trg_GnomesOn)
    endif
    
    if racechance == incN() then
        call SetPlayerTechResearchedSwap('R0FX', 1, p)
        call CreateNUnitsAtLoc(5, 'h0IT', p, l, bj_UNIT_FACING)
    endif
    
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'nmpe', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R0FS', 1, p)
        //call SetPlayerTechResearchedSwap( 'R0KZ', 1, p )
    endif
    
    if racechance == incN() then
        call CreateNUnitsAtLoc(6, 'ewsp', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R0G4', 1, p)
    endif
    
    //Forsaken отрекшиеся
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'h0J5', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R0G3', 1, p)
        call ForsakenOn()
    endif
    
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'o03W', p, l, bj_UNIT_FACING)
    endif
    //Alliance
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'hpea', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R0GZ', 1, p)
        call SetPlayerTechResearchedSwap('R0HX', 1, p)
        call SetPlayerTechResearchedSwap('R0HW', 1, p)
        call SetPlayerTechResearchedSwap('R0HY', 1, p)
        call SetPlayerTechResearchedSwap('R0KK', 1, p)
    endif
    
    
    
    // Horde W2
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'w200', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R0KB', 1, p)
        call SetPlayerTechResearchedSwap('R0KC', 1, p)
        call SetPlayerTechResearchedSwap('R0KD', 1, p)
        call HordeW2On()
    endif
    //Pandarens
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'pa01', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R0L3', 1, p)
    endif
    // Cult of Damned
    if racechance == incN() then
        call CreateNUnitsAtLoc(3, 'cD02', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R0J4', 1, p)
        call SetPlayerTechResearchedSwap('R0J5', 1, p)
        call CultOn()
    endif
    //Forest Trolls
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'o04V', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R0J1', 1, p)
        call StartForestTrolls()
    endif
    //FellOrc
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'n06B', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R0KA', 1, p)
        call SetPlayerTechResearchedSwap('R0KC', 1, p)
    endif
    //Jungle Trolls
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'o04Q', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R0IH', 1, p)
        call StartJungleTrolls()
    endif
    //Ice Trolls
    if racechance == incN() then
        call CreateNUnitsAtLoc(5, 'o045', p, l, bj_UNIT_FACING)
        call SetPlayerTechResearchedSwap('R0L1', 1, p)
        //call StartJungleTrolls()
    endif
    call RemoveLocation(l)
endfunction

