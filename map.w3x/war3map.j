//===========================================================================
// Trigger: HelpButton
//===========================================================================
function Trig_HelpButton_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A1EM'
endfunction

function Trig_HelpButton_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local unit u2= null
    local group g= CreateGroup()
    local boolexpr b
    local lightning l
    
    call DisableTrigger(GetTriggeringTrigger())
    set udg_LocalPlayer=GetOwningPlayer(u)
    set udg_LocalInteger2=0
    set b=Condition(function AllyToKill)
    call GroupEnumUnitsInRange(g, GetUnitX(u), GetUnitY(u), 750, b)
    
    
    
    loop
        exitwhen udg_LocalInteger2 < 1 or ( GetUnitLifePercent(u) >= 98.0 and GetUnitManaPercent(u) > 98.0 )
            set u2=BlzGroupUnitAt(g, GetRandomInt(0, udg_LocalInteger2 - 1))
            if u2 != null and UnitAlive(u2) and u != u2 then
                call GroupRemoveUnit(g, u2)
                set udg_LocalInteger2=udg_LocalInteger2 - 1
                call SetUnitLifeBJ(u, ( GetUnitStateSwap(UNIT_STATE_LIFE, u) + GetUnitStateSwap(UNIT_STATE_LIFE, u2) * 0.4 ))
                call SetUnitManaBJ(u, ( GetUnitStateSwap(UNIT_STATE_MANA, u) + GetUnitStateSwap(UNIT_STATE_MANA, u2) * 0.4 ))
                call UnitDamageTargetBJ(u, u2, 9999, ATTACK_TYPE_HERO, DAMAGE_TYPE_DEATH)
                set l=AddLightning("AFOD", true, GetUnitX(u), GetUnitY(u), GetUnitX(u2), GetUnitY(u2))
                call RemoveLigtingTimed(l , 2)
            endif
            
        
    endloop
    call DestroyGroup(g)
    call DestroyBoolExpr(b)
    set g=null
    set b=null
    set l=null
    set u=null
    set u2=null
    
    call EnableTrigger(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_HelpButton takes nothing returns nothing
    set gg_trg_HelpButton=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HelpButton, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_HelpButton, Condition(function Trig_HelpButton_Conditions))
    call TriggerAddAction(gg_trg_HelpButton, function Trig_HelpButton_Actions)
endfunction


//===========================================================================
// Trigger: BrokenBlood
//===========================================================================
function Trig_BrokenBlood_Conditions takes nothing returns boolean
    //call DisplayTextToPlayer(Player(0),0,0,"-")
    return GetSpellAbilityId() == 'A1DB'
endfunction


function EnemyToBlood takes nothing returns boolean
    local unit u= GetFilterUnit()
    if UnitAlive(u) and IsPlayerEnemy(GetOwningPlayer(u), udg_LocalPlayer) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and not IsUnitType(u, UNIT_TYPE_MECHANICAL) and GetUnitAbilityLevel(u, 'A1DE') == 0 then
        set u=null
        return true
    
    endif
    set u=null
    return false
endfunction


function BrokenBlood takes nothing returns nothing
    local integer seconds= 10
    local real damage= udg_LocalReal2
    local unit u= udg_LocalUnit3
    local unit u2= udg_LocalUnit2
    local group g= CreateGroup()
    local boolexpr b
    local effect e= AddSpecialEffectTargetUnitBJ("overhead", u2, "Trolls/RedsplashMissilebyRas.mdx")
    local integer i= 0
    //call DisplayTextToPlayer(Player(0),0,0,"2"+GetUnitName(u2))
     
    call UnitAddAbility(u2, 'A1DE')
    //call BlzSetAbilityTooltip( 'ANav', I2S(GetPlayerId(GetOwningPlayer(u))), 0 )
    loop
        exitwhen not UnitAlive(u2) or i * 0.25 > seconds
        call UnitDamageTargetBJ(u, u2, damage, ATTACK_TYPE_HERO, DAMAGE_TYPE_DEATH)
        call TriggerSleepAction(0.25)
        set i=i + 1
    endloop
    
//    
    call DestroyEffect(e)
    set udg_LocalPlayer=GetOwningPlayer(u)
    set b=Condition(function EnemyToBlood)
    call GroupEnumUnitsInRange(g, GetUnitX(u2), GetUnitY(u2), 425, b)
   
    set u2=FirstOfGroup(g)
    if u2 != null and UnitAlive(u2) then
        call GroupRemoveUnit(g, u2)
        set udg_LocalUnit3=u
        set udg_LocalUnit2=u2
        set udg_LocalReal2=RMaxBJ(2.5, damage + 0.25)
        call ExecuteFunc("BrokenBlood")
    endif
    //С шансом 50% распрастранится еще
    if Random(1 , 2) then
        set u2=FirstOfGroup(g)
        if u2 != null and UnitAlive(u2) then
            call GroupRemoveUnit(g, u2)
            set udg_LocalUnit3=u
            set udg_LocalUnit2=u2
            set udg_LocalReal2=RMaxBJ(2.5, damage + 0.25)
            call ExecuteFunc("BrokenBlood")
        endif
    
    endif
    
    call UnitRemoveAbility(u2, 'A1DE')
    call DestroyGroup(g)
    call DestroyBoolExpr(b)
    set g=null
    set b=null
    set e=null
    
endfunction



function Trig_BrokenBlood_Actions takes nothing returns nothing
    set udg_LocalUnit3=GetTriggerUnit()
    set udg_LocalUnit2=GetSpellTargetUnit()
    set udg_LocalReal2=1
    call ExecuteFunc("BrokenBlood")
    
    
    

    
endfunction

//===========================================================================
function InitTrig_BrokenBlood takes nothing returns nothing
    set gg_trg_BrokenBlood=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_BrokenBlood, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_BrokenBlood, Condition(function Trig_BrokenBlood_Conditions))
    call TriggerAddAction(gg_trg_BrokenBlood, function Trig_BrokenBlood_Actions)
endfunction


