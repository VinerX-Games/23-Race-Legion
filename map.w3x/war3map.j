function InitTrig_Draenei_Build_Abill takes nothing returns nothing
    set gg_trg_Draenei_Build_Abill=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Draenei_Build_Abill, EVENT_PLAYER_UNIT_CONSTRUCT_START)
    call TriggerAddCondition(gg_trg_Draenei_Build_Abill, Condition(function Trig_Draenei_Build_Abill_Conditions))
