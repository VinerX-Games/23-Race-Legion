function InitTrig_CorrupPlus takes nothing returns nothing
    set gg_trg_CorrupPlus=CreateTrigger()
    call DisableTrigger(gg_trg_CorrupPlus)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_CorrupPlus, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_CorrupPlus, Condition(function Trig_CorrupPlus_Conditions))
