//===========================================================================
// Trigger: AiFixTrain
//===========================================================================
function aiFixTrainBefore takes unit oldUnit,integer pi returns boolean
    
    if udg_AiControl[pi] then
        //call GroupRemoveUnit( udg_Ai_army[pi],oldUnit )
        //call GroupRemoveUnit( udg_Ai_units[pi],oldUnit )
        call NumberRem(pi , GetUnitTypeId(oldUnit))
        call NumberRem(pi , StringHash("Number"))
        return true
    endif
    
    return false
endfunction

function aiFixTrainAfter takes unit NewUnit,integer pi returns nothing
    if udg_AiControl[pi] then
        call aiUnitJoins(NewUnit , pi)
    endif
    
endfunction

//===========================================================================
// Trigger: K1T1
//===========================================================================
function Trig_K1T1_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTrainedUnit()) == 'ogru'
endfunction

function T1Count takes player p returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local integer pi= GetPlayerId(p)
    
    //1 юнит
    set a[0]=0
    set i=4
    loop
            set a[0]=a[0] + 1
            set a[a[0]]='o01I'
            set b=b + 1
            exitwhen b >= i
    endloop
    //2 юнит Черной гора
    if GetPlayerTechCount(p, 'R0D1', true) == 1 and GetPlayerTechCount(p, 'R0EH', true) < 1 then
        set i=1
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='o01E'
            
            set b=b + 1
            exitwhen b >= i
        endloop

    endif
    //3 юнит - эльфы
    if GetPlayerTechCount(p, 'R0D2', true) == 1 and GetPlayerTechCount(p, 'R0E9', true) != 1 then
        set i=1
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='o01F'
            
            set b=b + 1
            exitwhen b >= i
        endloop

    endif
    //4 юнит андеды
    if GetPlayerTechCount(p, 'R0D3', true) == 1 and GetPlayerTechCount(p, 'R0E9', true) != 1 then
        set i=2
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='o01H'
            
            set b=b + 1
            exitwhen b >= i
        endloop
    endif
    
    //Long Containment
    call SaveInteger(CommonHash, pi, StringHash("T1_0"), a[0])
    set i=1
    loop
        
        
        call SaveInteger(CommonHash, pi, StringHash("T1") + i, a[i])
        set i=i + 1
        
        exitwhen i > a[0]
    endloop
    
    
    
    
endfunction



function Trig_K1T1_Actions takes nothing returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local player p= GetOwningPlayer(GetTriggerUnit())
    local location l= GetUnitRallyPoint(GetTriggerUnit())
    local unit u
    local integer pi= GetPlayerId(p)
    
    
    set i=LoadInteger(CommonHash, pi, StringHash("T1_0"))
    set i=GetRandomInt(1, i)
    set b=LoadInteger(CommonHash, pi, ( StringHash("T1") + i ))
    
    call aiFixTrainBefore(GetTrainedUnit() , pi)
    set u=ReplaceUnit(GetTrainedUnit() , b , bj_UNIT_STATE_METHOD_RELATIVE)
    call aiFixTrainAfter(u , pi)

//   
//    call UnitAddAbility(u,'OR00')
//    call SetUnitAbilityLevel(u,'OR00',35+udg_HordeLandPrice[pi])
//    

//    call UnitAddAbility(u,'A1J0')
//    if udg_HordeLandPrice[pi] > 0 then
//        call BlzSetAbilityExtendedTooltip( 'A1J0', "Этот воин потребляет на "+I2S((udg_HordeLandPrice[pi])+"% больше.", 0 )
//    elseif udg_HordeLandPrice[pi] < 0 then
//        call BlzSetAbilityExtendedTooltip( 'A1J0', "Этот воин потребляет на "+I2S((udg_HordeLandPrice[pi])+"% больше.", 0 )
//    endif
    
    call UnitAddAbility(u, 'A0YU')
    
    // Ai moment    
    call IssuePointOrderLoc(u, "attack", l)


    call RemoveLocation(l)

    set u=null
endfunction

//===========================================================================
function InitTrig_K1T1 takes nothing returns nothing
    set gg_trg_K1T1=CreateTrigger()
    call DisableTrigger(gg_trg_K1T1)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_K1T1, EVENT_PLAYER_UNIT_TRAIN_FINISH)
    call TriggerAddCondition(gg_trg_K1T1, Condition(function Trig_K1T1_Conditions))
    call TriggerAddAction(gg_trg_K1T1, function Trig_K1T1_Actions)
endfunction


//===========================================================================
// Trigger: K1T2
//===========================================================================
function Trig_K1T2_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTrainedUnit()) == 'o01N'
endfunction


function T2Count takes player p returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local integer pi= GetPlayerId(p)
    
    //1 юнит
    set a[0]=0
    
    set b=0
    set i=2
    loop //Орк
            set a[0]=a[0] + 1
            set a[a[0]]='o01Q'
            set b=b + 1
            exitwhen b >= i
    endloop
    
    set b=0
    set i=1
    loop //Огр
            set a[0]=a[0] + 1
            set a[a[0]]='o01O'
            set b=b + 1
            exitwhen b >= i
    endloop
    
    
    if GetPlayerTechCount(p, 'R0EE', true) == 1 and GetPlayerTechCount(p, 'R0E9', true) != 1 then
        set b=0
        set i=1
        loop //Pandaren
                set a[0]=a[0] + 1
                set a[a[0]]='o02S'
                set b=b + 1
                exitwhen b >= i
        endloop
    endif
    
    //Long Containment
    call SaveInteger(CommonHash, pi, StringHash("T2_0"), a[0])
    set i=1
    loop
        
        
        call SaveInteger(CommonHash, pi, StringHash("T2") + i, a[i])
        set i=i + 1
        exitwhen i > a[0]
    endloop
    
    
    
    
endfunction


function Trig_K1T2_Actions takes nothing returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local player p= GetOwningPlayer(GetTriggerUnit())
    local location l= GetUnitRallyPoint(GetTriggerUnit())
    local unit u
    local integer pi= GetPlayerId(p)
    
    // 
    set i=LoadInteger(CommonHash, pi, StringHash("T2_0"))

    set i=GetRandomInt(1, i)
    set b=LoadInteger(CommonHash, pi, StringHash("T2") + i)
    //
    
    
    call aiFixTrainBefore(GetTrainedUnit() , pi)
    set u=ReplaceUnit(GetTrainedUnit() , b , bj_UNIT_STATE_METHOD_RELATIVE)
    call aiFixTrainAfter(u , pi)
    call IssuePointOrderLoc(u, "attack", l)

//
//    call UnitAddAbility(u,'OR00')
//    call SetUnitAbilityLevel(u,'OR00',35+udg_HordeLandPrice[pi])
//    
    
     
    call UnitAddAbility(u, 'A0YU')

    
    call RemoveLocation(l)
    set p=null
    set u=null
endfunction

//===========================================================================
function InitTrig_K1T2 takes nothing returns nothing
    set gg_trg_K1T2=CreateTrigger()
    call DisableTrigger(gg_trg_K1T2)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_K1T2, EVENT_PLAYER_UNIT_TRAIN_FINISH)
    call TriggerAddCondition(gg_trg_K1T2, Condition(function Trig_K1T2_Conditions))
    call TriggerAddAction(gg_trg_K1T2, function Trig_K1T2_Actions)
endfunction


