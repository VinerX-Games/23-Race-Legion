//===========================================================================
// Trigger: K2T3
//===========================================================================
function Trig_K2T3_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTrainedUnit()) == 'okod'
endfunction

function K3Count takes player p returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local integer pi= GetPlayerId(p)
    set a[0]=0

    
    
    // Kodo-orc
    set b=0
    set i=2
    loop
            set a[0]=a[0] + 1
            set a[a[0]]='o01R'
            set b=b + 1
            exitwhen b >= i
    endloop
    
    //Dragon    
    if GetPlayerTechCount(p, 'R0E1', true) >= 1 and GetPlayerTechCount(p, 'R0EH', true) < 1 then
        set b=0
        set i=2
        loop
                set a[0]=a[0] + 1
                set a[a[0]]='o01S'
                set b=b + 1
                exitwhen b >= i
        endloop
    endif

    //Dark ranger    
    if GetPlayerTechCount(p, 'R0D3', true) == 1 and GetPlayerTechCount(p, 'R0E9', true) != 1 then
        set b=0
        set i=2
        loop
                set a[0]=a[0] + 1
                set a[a[0]]='o02M'
                set b=b + 1
                exitwhen b >= i
        endloop
    endif

    
    
    //Long Containment
    call SaveInteger(CommonHash, pi, StringHash("K3_0"), a[0])
    set i=1
    loop
        
        
        call SaveInteger(CommonHash, pi, StringHash("K3") + i, a[i])
        set i=i + 1
        exitwhen i > a[0]
    endloop
    
    
    
    
endfunction

function Trig_K2T3_Actions takes nothing returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local player p= GetOwningPlayer(GetTriggerUnit())
    local location l= GetUnitRallyPoint(GetTriggerUnit())
    local unit u
    local integer pi= GetPlayerId(p)
    
    
    
    // 
    set i=LoadInteger(CommonHash, pi, StringHash("K3_0"))
    set i=GetRandomInt(1, i)
    set b=LoadInteger(CommonHash, pi, StringHash("K3") + i)
    //
    call aiFixTrainBefore(GetTrainedUnit() , pi)
    set u=ReplaceUnit(GetTrainedUnit() , b , bj_UNIT_STATE_METHOD_RELATIVE)
    call aiFixTrainAfter(u , pi)
//    // Elite Price
//    call UnitAddAbility(u,'A0UX')
//    call SetUnitAbilityLevel(u,'OR00',35+udg_HordeElitePrice[pi])
//
     
    call UnitAddAbility(u, 'A0YU')

        call IssuePointOrderLoc(u, "attack", l)

    call RemoveLocation(l)
    set p=null
    set u=null
endfunction

//===========================================================================
function InitTrig_K2T3 takes nothing returns nothing
    set gg_trg_K2T3=CreateTrigger()
    call DisableTrigger(gg_trg_K2T3)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_K2T3, EVENT_PLAYER_UNIT_TRAIN_FINISH)
    call TriggerAddCondition(gg_trg_K2T3, Condition(function Trig_K2T3_Conditions))
