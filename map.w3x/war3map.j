    call RemoveUnit(GetSpellAbilityUnit())
    call SetPlayerTechResearchedSwap('R0KA', 1, GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerTechResearchedSwap('R0KC', 1, GetOwningPlayer(GetTriggerUnit()))
    
    call RemoveLocation(udg_LocalPosition2)
endfunction

