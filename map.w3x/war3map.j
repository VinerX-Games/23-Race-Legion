//===========================================================================
// Trigger: TPrepeat
//===========================================================================
function Trig_TPrepeat_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A1IG'
endfunction

function CommandTp takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer id= GetHandleId(t)
    local unit u= LoadUnitHandle(Hash, id, 0)


    if u != null and UnitAlive(u) and GetUnitAbilityLevel(u, 'A1IH') > 0 then
        call IssuePointOrder(u, "darksummoning", LoadReal(Hash, id, 1), LoadReal(Hash, id, 2))
    
    
    else
        call DestroyTimer(t)
        call FlushChildHashtable(Hash, id)
    
    endif

    set u=null
    set t=null
endfunction




function Trig_TPrepeat_Actions takes nothing returns nothing
    local timer t= CreateTimer()
    local integer id= GetHandleId(t)
    local unit u= GetTriggerUnit()
    
    call SaveUnitHandle(Hash, id, 0, u)
    call SaveReal(Hash, id, 1, GetSpellTargetX())
    call SaveReal(Hash, id, 2, GetSpellTargetY())
    
    call BlzUnitHideAbility(u, 'A1IG', true)
    call RemoveAbilityTimed(u , 'A1IG' , 1)
    call UnitAddAbility(u, 'A1IH')
    
    call TimerStart(t, RMaxBJ(BlzGetUnitAbilityCooldownRemaining(u, 'A0IO'), 15), true, function CommandTp)
    set t=null
    set u=null
endfunction

//===========================================================================
function InitTrig_TPrepeat takes nothing returns nothing
    set gg_trg_TPrepeat=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_TPrepeat, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_TPrepeat, Condition(function Trig_TPrepeat_Conditions))
    call TriggerAddAction(gg_trg_TPrepeat, function Trig_TPrepeat_Actions)
endfunction


