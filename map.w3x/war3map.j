//===========================================================================
// Trigger: SpellMassAxes
//===========================================================================

function Trig_SpellMassAxes_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'w2af'
endfunction


function Trig_SpellMassAxes_Actions takes nothing returns nothing
    local location l= GetSpellTargetLoc()
    local unit caster= GetTriggerUnit()
    local player p= GetOwningPlayer(caster)
    local boolexpr bex
    local integer dammyAbility= 'w2aa'
    local integer level= GetUnitAbilityLevel(caster, GetSpellAbilityId())
    local group g= CreateGroup()
    local unit u
    local unit u2
    local integer i= 0
    set udg_LocalPlayer=p
    set bex=Condition(function EnemEl)
    call GroupEnumUnitsInRangeOfLoc(g, l, 150, bex)
    
    if FirstOfGroup(g) == null then
        //Нету врагов
        call BlzStartUnitAbilityCooldown(caster, dammyAbility, 15)
        call SetUnitState(caster, UNIT_STATE_MANA, GetUnitState(caster, UNIT_STATE_MANA) + 100 + 35 * level)
        
    
    else
        call RemoveLocation(l)
        set l=GetUnitLoc(caster)
        loop
            set u=FirstOfGroup(g)
            exitwhen u == null
            
            set u2=CreateUnitAtLoc(p, Dummy, l, bj_UNIT_FACING)
            
            call UnitAddAbility(u2, dammyAbility)
            call SetUnitAbilityLevel(u2, dammyAbility, level)
            call IssueTargetOrder(u2, "thunderbolt", u)
            call RemoveUnitTimed(u2 , 2)
            set i=i + 1
            call GroupRemoveUnit(g, u)
        endloop
    endif
    
    set u=null
    call DestroyGroup(g)
    set g=null
    call RemoveLocation(l)
    set p=null
    call DestroyBoolExpr(bex)
    set u2=null
    set bex=null

endfunction




