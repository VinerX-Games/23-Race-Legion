    call DisableTrigger(gg_trg_PerebobNavy)
    call TriggerRegisterTimerExpireEvent(gg_trg_PerebobNavy, udg_PlayerGet4)
    call TriggerAddAction(gg_trg_PerebobNavy, function PlayerNavy)
endfunction


//===========================================================================
// Trigger: PereborBuildings
//===========================================================================
function Trig_PereborBuildings_Code_Func002A takes nothing returns nothing
    set gPlayer=GetEnumPlayer()
    
    set udg_LocalInteger2=GetPlayerId(gPlayer)
    set gPi=GetPlayerId(gPlayer)
    set Counter=0
    call GroupEnumUnitsOfPlayer(gGroup, gPlayer, B_OnlyNeaded)

    // Пропуск если 0 или лимит юнитов
    if FirstOfGroup(gGroup) == null then

        if udg_Octhet then
            call DisplayTimedTextFromPlayer(gPlayer, 0, 0, 4, GetPlayerName(gPlayer) + " - не имеет производящих зданий")
        endif
        if gGroup == null then
            set gGroup=CreateGroup()
            call DisplayTimedTextFromPlayer(gPlayer, 0, 0, 4, GetPlayerName(gPlayer) + " - на самом деле сломалась группа")
        endif
        return
    elseif LoadInteger(AiData, gPi, StringHash("Number")) > AiLimit then
        if udg_Octhet then
            call DisplayTimedTextFromPlayer(gPlayer, 0, 0, 4, GetPlayerName(gPlayer) + " - достиг предела юнитов")
        endif

        return
    endif
    
    //Собственно группа зданий, которые надо чекать 
       
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd or FirstOfGroup(gGroup) == null
        set gUnit=BlzGroupUnitAt(gGroup, GetRandomInt(0, Counter))
        call GroupRemoveUnit(gGroup, gUnit)
        set gId=GetUnitTypeId(gUnit)
        
        if AiRace[gPi] == "Scarlet" then
            call PereborBuildings_ScarletOrden(gId , gPi , gUnit)
        elseif AiRace[gPi] == "BloodElves" then
            call PereborBuildings2_BloodElves(gId , gPi , gUnit)
        elseif AiRace[gPi] == "Goblins" then
            call PereborBuildings_Goblins(gId , gPi , gUnit)
        elseif AiRace[gPi] == "Naga" then
            call PereborBuildings_Naga(gId , gPi , gUnit)
        elseif AiRace[gPi] == "Horde" then
            call PereborBuildings_Horde(gId , gPi , gUnit)
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    
endfunction

function Trig_PereborBuildings_Actions takes nothing returns nothing
    call PauseTimer(udg_TimerSmall3)
    if udg_Octhet then
        call DisplayTimedTextFromPlayer(Player(0), 0, 0, 4, "Тик зданий")
    endif
    call ForForce(udg_Bots, function Trig_PereborBuildings_Code_Func002A)
    if udg_Octhet then
        call DisplayTimedTextFromPlayer(Player(0), 0, 0, 4, "Конец тика зданий")
    endif
    call TimerStart(udg_TimerSmall3, 8.50 * AiRepeat / 5, false, null)
endfunction

