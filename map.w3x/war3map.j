        if ( Trig_SpawnQtun_Func002Func002C() ) then
            set udg_LocalPosition2=GetRectCenter(gg_rct_QtunSp2)
        else
            set udg_LocalPosition2=GetRectCenter(gg_rct_QtunSp1)
        endif
        set udg_LocalInteger=R2I(( ( I2R(BlzGetUnitMaxHP(GetTriggerUnit())) - GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) ) / 1000.00 ))
        set udg_LocalInteger2=( udg_LocalInteger * 2 )
        set udg_LocalOtrad=GetLastCreatedGroup()
        set udg_LocalPosition3=GetUnitLoc(gg_unit_n03D_0666)
        call ForGroupBJ(udg_LocalOtrad, function Trig_SpawnQtun_Func002Func008A)
        call GroupClear(udg_LocalOtrad)
