//===========================================================================
// Trigger: Draenei Build Abill
//===========================================================================
function Trig_Draenei_Build_Abill_Conditions takes nothing returns boolean

    return GetUnitAbilityLevel(GetConstructingStructure(), 'A0Z3') > 0
endfunction



function Trig_Draenei_Build_Abill_Actions takes nothing returns nothing
    local unit u= GetConstructingStructure()
    //call BJDebugMsg("2")
    if Random(1 , 2) and GetPlayerTechCount(GetOwningPlayer(u), 'R0EB', true) > 0 then
        call TriggerSleepAction(0)
        call SetBuildingProgressTimed(u , 20 , 0)
        //call BJDebugMsg("3")
    endif
    call UnitRemoveAbility(u, 'A0Z3')
    set u=null
endfunction

