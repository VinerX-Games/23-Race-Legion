    call UnitAddAbilityBJ('AUdc', GetLastCreatedUnit())
    call SetUnitManaBJ(GetLastCreatedUnit(), 1111111.00)
    call SetUnitAbilityLevelSwapped('AUdc', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A08R', GetTriggerUnit()))
    call IssueTargetOrderBJ(GetLastCreatedUnit(), "deathcoil", GetEnumUnit())
