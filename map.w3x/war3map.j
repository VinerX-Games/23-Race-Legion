//===========================================================================
// Trigger: StormwindFirst
//===========================================================================
function Trig_StormwindFirst_Conditions takes nothing returns boolean
    return GetResearched() == 'R0HH'
endfunction

function Trig_StormwindFirst_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local player p= GetOwningPlayer(u)
    local integer pi= GetPlayerId(p)
    set udg_MainPrice[pi]=udg_MainPrice[pi] - 5
    
    
    
    // Бонусы левая 
    if GetPlayerTechCount(p, 'R0HS', true) == 1 then
        set udg_MainPrice[pi]=udg_MainPrice[pi] - 5
    endif
    if GetPlayerTechCount(p, 'R0H8', true) == 1 then
        set udg_MainPrice[pi]=udg_MainPrice[pi] - 5
    endif
    if GetPlayerTechCount(p, 'R0HB', true) == 1 then
        set udg_MainPrice[pi]=udg_MainPrice[pi] - 5
    endif
    
    //Центр
    if GetPlayerTechCount(p, 'R0H9', true) == 1 then
        set udg_MainPrice[pi]=udg_MainPrice[pi] - 5
    endif
    if GetPlayerTechCount(p, 'R0H9', true) == 1 then
        set udg_MainPrice[pi]=udg_MainPrice[pi] - 5
    endif
    if GetPlayerTechCount(p, 'R0HD', true) == 1 then
        set udg_MainPrice[pi]=udg_MainPrice[pi] - 5
    endif
    
    call AcountAll(p)

    call SetPlayerTechMaxAllowed(p, 'R0HN', 1)
    call SetPlayerTechMaxAllowed(p, 'R0HC', 1)
    call SetPlayerTechResearched(p, 'R001', 1)
    call EndBranch(p)
endfunction

//===========================================================================
function InitTrig_StormwindFirst takes nothing returns nothing
    set gg_trg_StormwindFirst=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_StormwindFirst, EVENT_PLAYER_UNIT_RESEARCH_FINISH)
    call TriggerAddCondition(gg_trg_StormwindFirst, Condition(function Trig_StormwindFirst_Conditions))
    call TriggerAddAction(gg_trg_StormwindFirst, function Trig_StormwindFirst_Actions)
endfunction


