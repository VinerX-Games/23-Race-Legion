//===========================================================================
// Trigger: Dovorougenie Code O
//===========================================================================
function Trig_Dovorougenie_Code_O_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A000' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dovorougenie_Code_Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'h003' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dovorougenie_Code_Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'h00P' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dovorougenie_Code_Func003C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'h029' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dovorougenie_Code_Func004C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'n000' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Dovorougenie_Code_O_Actions takes nothing returns nothing
    if ( Trig_Dovorougenie_Code_Func001C() ) then
        call ReplaceUnit2(GetTriggerUnit() , 'h005' , bj_UNIT_STATE_METHOD_RELATIVE)
        if ( Trig_Dovorougenie_3t_O_Copy_Func001C() ) then
            call SelectUnitAddForPlayer(GetLastReplacedUnitBJ(), GetOwningPlayer(GetTriggerUnit()))
        else
        endif
    else
    endif
    if ( Trig_Dovorougenie_Code_Func002C() ) then
        call ReplaceUnit2(GetTriggerUnit() , 'h00S' , bj_UNIT_STATE_METHOD_RELATIVE)
        if ( Trig_Dovorougenie_3t_O_Copy_Func001C() ) then
            call SelectUnitAddForPlayer(GetLastReplacedUnitBJ(), GetOwningPlayer(GetTriggerUnit()))
        else
        endif
    else
    endif
    if ( Trig_Dovorougenie_Code_Func003C() ) then
        call ReplaceUnit2(GetTriggerUnit() , 'h02A' , bj_UNIT_STATE_METHOD_RELATIVE)
        if ( Trig_Dovorougenie_3t_O_Copy_Func001C() ) then
            call SelectUnitAddForPlayer(GetLastReplacedUnitBJ(), GetOwningPlayer(GetTriggerUnit()))
        else
        endif
