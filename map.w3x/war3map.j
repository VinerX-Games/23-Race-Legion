function InitTrig_Leave_Army_U takes nothing returns nothing
    set gg_trg_Leave_Army_U=CreateTrigger()
    call DisableTrigger(gg_trg_Leave_Army_U)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Leave_Army_U, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Leave_Army_U, Condition(function Trig_Leave_Army_U_Conditions))
