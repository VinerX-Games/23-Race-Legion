//===========================================================================
// Trigger: AiRep
//===========================================================================
function aiRep takes integer pi returns nothing
    if not udg_AiControl[pi] then
        return
    endif
    
    
    // Очистка
    call FlushChildHashtable(AiData, (pi)) // INLINED!!
    
    call GroupClear(udg_Ai_units[pi])
    call GroupClear(udg_Ai_navy[pi])
    call GroupClear(udg_Ai_army[pi])
    call GroupClear(udg_Ai_buildersT[pi])
    call GroupClear(udg_Ai_builders[pi])
    call GroupClear(udg_Ai_harvest[pi])
    call GroupClear(AiUnitsToPort[pi])
    
    // Очистка
    if gGroup == null then
        set gGroup=CreateGroup()
    endif
    
    set gPlayer=Player(pi)
    call BJDebugMsg("Бот:" + GetPlayerName(gPlayer))
    call GroupEnumUnitsOfPlayer(gGroup, gPlayer, null)
    loop
        set gUnit=FirstOfGroup(gGroup)
        if gUnit == null then
            exitwhen true
        endif
        call BJDebugMsg(" " + GetUnitName(gUnit))
        if GetUnitAbilityLevel(gUnit, gDummySpell) == 0 and not IsUnitType(gUnit, UNIT_TYPE_SUMMONED) then
            
            // Сломался с неуязом
            if BlzIsUnitInvulnerable(gUnit) then // GetUnitAbilityLevel(gUnit, 'Bvul') > 0 then
                call BJDebugMsg(": Неуяз фикс")
                set gUnit=ReplaceUnit2(gUnit , GetUnitTypeId(gUnit) , bj_UNIT_STATE_METHOD_RELATIVE)
                
            endif
           
            set gId=GetUnitTypeId(gUnit)
            //call NumberReset(pi,id)
            
            if IsUnitType(gUnit, UNIT_TYPE_STRUCTURE) then
                call UnitSetConstructionProgress(gUnit, 100)
                
                if isNavalBase(gId) then
                    call aiNavalBaseJoin(gUnit)
                endif
                
                call aiUnitBuildingJoins(gUnit , pi)
                if IsUnitInGroup(gUnit, udg_ZahvatBuildings) then
                    call GroupAddUnit(AiUnitsToPort[pi], gUnit)
                endif
            else
                
                if isShip(gId) then
                    call aiShipJoins(gUnit , pi)
                endif
                
                call aiUnitJoins(gUnit , pi)
                if gId == 'h07A' then // Маг-тп
                   call GroupAddUnit(AiUnitsToPort[pi], gUnit)
                endif
            endif
        
        
        
        endif
        
        call GroupRemoveUnit(gGroup, gUnit)
    endloop
    
endfunction

function aiRepUnvul_act takes nothing returns nothing
    set gUnit=GetEnumUnit()
    if not IsUnitType(gUnit, UNIT_TYPE_STRUCTURE) then
        set gUnit=ReplaceUnit2(gUnit , GetUnitTypeId(gUnit) , bj_UNIT_STATE_METHOD_RELATIVE)
    endif
    
endfunction

// Починка неуза
function aiRepUnvul takes integer pi returns nothing
    if not udg_AiControl[pi] then
        return
    endif
    
    set gPlayer=Player(pi)
    call GroupEnumUnitsOfPlayer(gGroup, gPlayer, B_FixUnvul)
    call ForGroup(gGroup, function aiRepUnvul_act)

    
endfunction


function aiFixAll takes nothing returns nothing
    local integer i= 0
    loop
        exitwhen i >= 23
        
                
        call aiRepUnvul(i)
        call aiRep(i)

        
        call DisplayTextToPlayer(Player(i), 0, 0, "Экономика всех ботов пересчитана, чтобы избежать непредвиденных багов, это экпериментальная функция")
        set i=i + 1
    endloop
    
endfunction




 
