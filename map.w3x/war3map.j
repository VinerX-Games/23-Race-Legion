//===========================================================================
function Trig_EnemyPower_Conditions takes nothing returns boolean
    return GetUnitAbilityLevel(GetEventDamageSource(), 'A0O5') > 0 and GetPlayerTechCount(GetOwningPlayer(GetEventDamageSource()), 'R096', true) > 0
endfunction

function Trig_EnemyPower_Actions takes nothing returns nothing
    //call SetUnitState(GetEventDamageSource(),UNIT_STATE_LIFE,
    if BlzGetEventAttackType() == ATTACK_TYPE_NORMAL then
        call SetUnitLifePercentBJ(GetEventDamageSource(), GetUnitLifePercent(GetEventDamageSource()) + 0.25)
    else
        call SetUnitLifePercentBJ(GetEventDamageSource(), GetUnitLifePercent(GetEventDamageSource()) + 0.5)
    
    endif
    

endfunction

