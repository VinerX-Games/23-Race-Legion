function InitTrig_TrueHorde takes nothing returns nothing
    set gg_trg_TrueHorde=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_TrueHorde, EVENT_PLAYER_UNIT_RESEARCH_FINISH)
    call TriggerAddCondition(gg_trg_TrueHorde, Condition(function Trig_TrueHorde_Conditions))
    call TriggerAddAction(gg_trg_TrueHorde, function Trig_TrueHorde_Actions)
endfunction


