//===========================================================================
// Trigger: Help
//===========================================================================
function Trig_Help_Conditions takes nothing returns boolean
    return GetUnitAbilityLevel(GetTriggerUnit(), 'A1DD') > 0 and GetUnitLifePercent(GetTriggerUnit()) <= 75
endfunction

function AllyToKill takes nothing returns boolean
    local unit u= GetFilterUnit()
    if UnitAlive(u) and GetOwningPlayer(u) == udg_LocalPlayer and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and not IsUnitType(u, UNIT_TYPE_HERO) and not IsUnitType(u, UNIT_TYPE_SUMMONED) and not IsUnitType(u, UNIT_TYPE_MECHANICAL) and GetUnitTypeId(u) != 'h07A' then
        set u=null
        set udg_LocalInteger2=udg_LocalInteger2 + 1
        return true
    endif
    set u=null
    return false
endfunction

function Trig_Help_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local unit u2= null
    local group g= CreateGroup()
    local boolexpr b
    local lightning l
    
    call DisableTrigger(GetTriggeringTrigger())
    set udg_LocalPlayer=GetOwningPlayer(u)
    set udg_LocalInteger2=0
    set b=Condition(function AllyToKill)
    call GroupEnumUnitsInRange(g, GetUnitX(u), GetUnitY(u), 750, b)
   // set u2 = FirstOfGroup(g) 
    if udg_LocalInteger2 > 0 then
        set u2=BlzGroupUnitAt(g, GetRandomInt(0, udg_LocalInteger2 - 1))
        if u2 != null and UnitAlive(u2) and u != u2 then
            
            call SetUnitLifeBJ(u, ( GetUnitStateSwap(UNIT_STATE_LIFE, u) + GetUnitStateSwap(UNIT_STATE_LIFE, u2) * 0.4 ))
            call SetUnitManaBJ(u, ( GetUnitStateSwap(UNIT_STATE_MANA, u) + GetUnitStateSwap(UNIT_STATE_MANA, u2) * 0.4 ))
            call UnitDamageTargetBJ(u, u2, 9999, ATTACK_TYPE_HERO, DAMAGE_TYPE_DEATH)
            set l=AddLightning("AFOD", true, GetUnitX(u), GetUnitY(u), GetUnitX(u2), GetUnitY(u2))
            call TriggerSleepAction(0.15)
            call DestroyLightning(l)
        endif
    endif
    call DestroyGroup(g)
    call DestroyBoolExpr(b)
    set g=null
    set b=null
    set l=null
    set u=null
    set u2=null
    
    call EnableTrigger(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Help takes nothing returns nothing
    set gg_trg_Help=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Help, EVENT_PLAYER_UNIT_DAMAGED)
    call TriggerAddCondition(gg_trg_Help, Condition(function Trig_Help_Conditions))
    call TriggerAddAction(gg_trg_Help, function Trig_Help_Actions)
endfunction


//===========================================================================
// Trigger: SpelltakesHealth
//===========================================================================
function Trig_SpelltakesHealth_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A1DC' or GetSpellAbilityId() == 'A1EL'
endfunction

function Trig_SpelltakesHealth_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    //call UnitDamageTargetBJ( GetTriggerUnit(), GetTriggerUnit(), 150.00, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_DEATH )
    
    
    
    call SetUnitLifeBJ(u, ( GetUnitStateSwap(UNIT_STATE_LIFE, u) - 75 * GetUnitAbilityLevel(u, GetSpellAbilityId()) ))
    if GetSpellAbilityId() == 'A1EL' and GetOwningPlayer(GetTriggerUnit()) == GetOwningPlayer(GetSpellTargetUnit()) then
        
        call BlzEndUnitAbilityCooldown(GetTriggerUnit(), 'A1EL')
    endif
    
    set u=null
endfunction

