    call SetPlayerAbilityAvailableBJ(false, 'A0KM', GetEnumPlayer())
    call SetPlayerAbilityAvailableBJ(false, 'A0KN', GetEnumPlayer())
    call SetPlayerAbilityAvailableBJ(false, 'A0IZ', GetEnumPlayer())
