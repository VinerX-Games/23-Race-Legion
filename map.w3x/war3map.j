//===========================================================================
function Trig_Moneta_C_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetSoldUnit()) == 'h0G8'
endfunction

function Trig_Moneta_C_Actions takes nothing returns nothing
    local integer pi= GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
    //call KillUnit( GetSoldUnit() )
    call RemoveUnit(GetSoldUnit())
    
    set income[pi]=income[pi] + 75
    call UpdateGraf(pi)
    
    
    if GetUnitAbilityLevel(GetTriggerUnit(), 'A0SM') == 0 then
        call UnitAddAbility(GetTriggerUnit(), 'A0SM')
        set udg_LocalUnit2=GetTriggerUnit()
        call UnitMakeAbilityPermanent(udg_LocalUnit2, true, 'A0SM')
    else
        call IncUnitAbilityLevel(GetTriggerUnit(), 'A0SM')
    endif
endfunction

