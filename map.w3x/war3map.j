    //1 юнит
    if GetPlayerTechCount(p, 'R0EA', true) < 1 then
        
        set b=0
        set i=2
        loop // Destroyer
                set a[0]=a[0] + 1
                set a[a[0]]='o01T'
                set b=b + 1
                exitwhen b >= i
        endloop
        
    else
        
        set b=0
        set i=2
        loop // Better Destroyer
                set a[0]=a[0] + 1
                set a[a[0]]='o020'
                set b=b + 1
                exitwhen b >= i
        endloop
    
    endif

    //3 юнит - эльфы ballista
    if GetPlayerTechCount(p, 'R0D2', true) == 1 and GetPlayerTechCount(p, 'R0E9', true) != 1 then
        set i=1
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='o02K'
            
            set b=b + 1
            exitwhen b >= i
        endloop

    endif
    
    
    
    
    set i=GetRandomInt(1, a[0])
    set b=a[i]
    
    set u=ReplaceUnit(GetTrainedUnit() , b , bj_UNIT_STATE_METHOD_RELATIVE)
    

    call UnitAddAbility(u, 'A0UZ')
    call SetUnitAbilityLevel(u, 'A0UZ', 35 + udg_HordeTechPrice[pi])

    set udg_UnitsCount[pi]=udg_UnitsCount[pi] - 1
    call UnitAddAbility(u, 'A0YU')

    call IssuePointOrderLoc(u, "attack", l)
    call RemoveLocation(l)
endfunction

