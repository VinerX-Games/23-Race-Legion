function InitTrig_SpellMassAxes takes nothing returns nothing
    set gg_trg_SpellMassAxes=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_SpellMassAxes, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_SpellMassAxes, Condition(function Trig_SpellMassAxes_Conditions))
    call TriggerAddAction(gg_trg_SpellMassAxes, function Trig_SpellMassAxes_Actions)
endfunction


//===========================================================================
// Trigger: SpellArrow
//===========================================================================
function Trig_SpellArrow_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'w2aW' and IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO)
endfunction

function FireDark takes nothing returns nothing
    
    local timer t= GetExpiredTimer()
    local integer id= GetHandleId(t)
    local unit u= LoadUnitHandle(Hash, id, 0)
    //local integer aid = LoadInteger(Hash,id,1)
    local integer times= LoadInteger(Hash, id, 2)
    local integer level= LoadInteger(Hash, id, 3)
    local location loc= LoadLocationHandle(Hash, id, 4)
    local unit u2= CreateUnit(GetOwningPlayer(u), Dummy, GetUnitX(u), GetUnitY(u), bj_UNIT_FACING)
    call SetUnitFlyHeight(u2, 100.00, 10)
    call UnitAddAbility(u2, 'w2aE')
    call SetUnitAbilityLevel(u2, 'w2aE', level)
    call IssuePointOrderLoc(u2, "carrionswarm", loc)
    call RemoveUnitTimed(u2 , 2)
    
    
    set times=times + 1
    call SaveInteger(Hash, id, 2, times)
    if times > 8 then
        call RemoveLocation(loc)
        call FlushChildHashtable(Hash, id)
        call PauseTimer(t)
        call DestroyTimer(t)
    endif
    
    
    set u=null
    set u2=null
    set t=null
    
    set loc=null

endfunction


function Trig_SpellArrow_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    
    local timer t= CreateTimer()
    local integer id= GetHandleId(t)
    
    call TimerStart(t, 0.35, true, function FireDark)
    call SaveUnitHandle(Hash, id, 0, u)
    //call SaveInteger(Hash,id,1, 'w2aW')
    call SaveInteger(Hash, id, 2, 0)
    call SaveInteger(Hash, id, 3, GetUnitAbilityLevel(u, 'w2aW'))
    call SaveLocationHandle(Hash, id, 4, GetSpellTargetLoc())

    set t=null
    set u=null

    
endfunction

