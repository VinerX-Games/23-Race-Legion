    call TriggerAddCondition(gg_trg_TechT2, Condition(function Trig_TechT2_Conditions))
    call TriggerAddAction(gg_trg_TechT2, function Trig_TechT2_Actions)
endfunction


//===========================================================================
// Trigger: NavyHeavy
//===========================================================================
function Trig_NavyHeavy_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTrainedUnit()) == 'h0HK'
endfunction

function Trig_NavyHeavy_Actions takes nothing returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local player p= GetOwningPlayer(GetTriggerUnit())
    local location l= GetUnitRallyPoint(GetTriggerUnit())
    local unit u
    local integer pi= GetPlayerId(p)
    set a[0]=0
    
    //1 юнит
    if GetPlayerTechCount(p, 'R0E9', true) < 1 then
        
        set b=0
        set i=2
        loop // Drednout
                set a[0]=a[0] + 1
                set a[a[0]]='h0D5'
                set b=b + 1
                exitwhen b >= i
        endloop
        
    else
        
        set b=0
        set i=2
        loop // ArmoredShip
                set a[0]=a[0] + 1
                set a[a[0]]='h0HM'
                set b=b + 1
                exitwhen b >= i
        endloop
    
    endif
    //Отреки
    if GetPlayerTechCount(p, 'R0D3', true) == 1 and GetPlayerTechCount(p, 'R0E9', true) != 1 then
        set i=2
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='h0I5'
            
            set b=b + 1
            exitwhen b >= i
        endloop

    endif
    
    
    
    
    set i=GetRandomInt(1, a[0])
    set b=a[i]
    
    call aiFixTrainBefore(GetTrainedUnit() , pi)
    set u=ReplaceUnit(GetTrainedUnit() , b , bj_UNIT_STATE_METHOD_RELATIVE)
    call aiFixTrainAfter(u , pi)
//
//    call UnitAddAbility(u,'A0UZ')
//    call SetUnitAbilityLevel(u,'A0V0',35+udg_HordeNavyPrice[pi])
//
     
    call UnitAddAbility(u, 'A0YU')
    

        call IssuePointOrderLoc(u, "attack", l)

    call RemoveLocation(l)
endfunction

