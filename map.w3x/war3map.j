//===========================================================================
// Trigger: BlinkToUnit attack
//===========================================================================
function Trig_BlinkToUnit_attack_Func002C takes nothing returns boolean
    if ( ( GetUnitAbilityLevelSwapped('A0MZ', GetAttacker()) == 1 ) ) then
        return true
    endif
    if ( ( GetUnitAbilityLevelSwapped('A0MZ', GetAttacker()) == 2 ) ) then
        return true
    endif
    if ( ( GetUnitAbilityLevelSwapped('A0MZ', GetAttacker()) == 3 ) ) then
        return true
    endif
    if ( ( GetUnitAbilityLevelSwapped('A0MZ', GetAttacker()) == 4 ) ) then
        return true
    endif
    return false
endfunction

function Trig_BlinkToUnit_attack_Conditions takes nothing returns boolean
    if ( not Trig_BlinkToUnit_attack_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_BlinkToUnit_attack_Actions takes nothing returns nothing
    local unit u
    set udg_LocalPosition[19]=GetUnitLoc(GetAttackedUnitBJ())
    set udg_LocalUnit[19]=GetAttacker()
    call SetUnitPositionLoc(GetAttacker(), udg_LocalPosition[19])
    call RemoveLocation(udg_LocalPosition[19])
    call IssueTargetOrderBJ(udg_LocalUnit[19], "attack", GetAttackedUnitBJ())
    call UnitAddAbilityBJ('A0N0', udg_LocalUnit[19])
    call SetUnitAbilityLevelSwapped('A0N0', udg_LocalUnit[19], GetUnitAbilityLevelSwapped('A0MZ', udg_LocalUnit[19]))
    call UnitAddAbilityBJ('A0N2', udg_LocalUnit[19])
    call SetUnitAbilityLevelSwapped('A0N2', udg_LocalUnit[19], GetUnitAbilityLevelSwapped('A0MZ', udg_LocalUnit[19]))
    call UnitRemoveAbilityBJ('A0MZ', udg_LocalUnit[19])
    set u=udg_LocalUnit[19]
    call TriggerSleepAction(2.30)
    set udg_LocalUnit[19]=u
    call UnitAddAbilityBJ('A0MZ', udg_LocalUnit[19])
    call SetUnitAbilityLevelSwapped('A0MZ', udg_LocalUnit[19], GetUnitAbilityLevelSwapped('A0N0', udg_LocalUnit[19]))
    call UnitRemoveAbilityBJ('A0N0', udg_LocalUnit[19])
    call UnitRemoveAbilityBJ('A0N2', udg_LocalUnit[19])
    set u=null
endfunction

//===========================================================================
function InitTrig_BlinkToUnit_attack takes nothing returns nothing
    set gg_trg_BlinkToUnit_attack=CreateTrigger()
    call DisableTrigger(gg_trg_BlinkToUnit_attack)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_BlinkToUnit_attack, EVENT_PLAYER_UNIT_ATTACKED)
