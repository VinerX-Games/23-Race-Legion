function Trig_MainSpawn2_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetConstructedStructure()) == 'e01H'
endfunction

function spawnlich takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer id= GetHandleId(t)
    local unit u= LoadUnitHandle(Hash, id, 1)
    local integer typeid= GetUnitTypeId(u)
    local integer uid= GetHandleId(u)
    local integer currentCount= LoadInteger(Hash, uid, 1)
    local real x= GetUnitX(u)
    local real y= GetUnitY(u)
    local unit u2
    local player p= GetOwningPlayer(u)
    //call DisplayTextToPlayer(Player(0),0,0,"Таймер кончился"+I2S(currentCount))
    if currentCount < 3 and UnitAlive(u) then
        set u2=CreateUnit(p, 'e01I', x, y, bj_UNIT_FACING)
        call SetUnitTimeScale(u2, 0.25)
        call SaveUnitHandle(Hash, GetHandleId(u2), 1, u)
        call SaveBoolean(Hash, GetHandleId(u2), 2, true)
        set currentCount=currentCount + 1
        if typeid == 'e021' then
            set u2=CreateUnit(p, 'e01I', x, y, bj_UNIT_FACING)
            call SetUnitTimeScale(u2, 0.25)
            call SaveUnitHandle(Hash, GetHandleId(u2), 1, u)
            call SaveBoolean(Hash, GetHandleId(u2), 2, true)
            set currentCount=currentCount + 1
        elseif typeid == 'e020' then
            set u2=CreateUnit(p, 'e01I', x, y, bj_UNIT_FACING)
            call SetUnitTimeScale(u2, 0.25)
            call SaveBoolean(Hash, GetHandleId(u2), 2, true)
            call SaveUnitHandle(Hash, GetHandleId(u2), 1, u)
            set u2=CreateUnit(p, 'e01I', x, y, bj_UNIT_FACING)
            call SetUnitTimeScale(u2, 0.25)
            call SaveBoolean(Hash, GetHandleId(u2), 2, true)
            call SaveUnitHandle(Hash, GetHandleId(u2), 1, u)
            set currentCount=currentCount + 2
        endif
        
    else
        call PauseTimer(t)
        call DestroyTimer(t)
        set t=null
        call SaveBoolean(Hash, uid, 1, false)
        call FlushChildHashtable(Hash, id)
        set p=null
    endif
    call SaveInteger(Hash, uid, 1, currentCount)
    set t=null
    set u=null
    set u2=null
    set p=null
endfunction




function Trig_MainSpawn2_Actions takes nothing returns nothing
    local timer t= CreateTimer()
    local integer id= GetHandleId(t)
    local integer uid= GetHandleId(GetConstructedStructure())
    call TimerStart(t, 25, true, function spawnlich)
    call SaveUnitHandle(Hash, id, 1, GetConstructedStructure())
    call SaveInteger(Hash, uid, 1, 0)
    call SaveBoolean(Hash, uid, 2, true)
    
    set t=null
    
endfunction

//===========================================================================
function InitTrig_MainSpawn2 takes nothing returns nothing
    set gg_trg_MainSpawn2=CreateTrigger()
    call DisableTrigger(gg_trg_MainSpawn2)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_MainSpawn2, EVENT_PLAYER_UNIT_CONSTRUCT_FINISH)
    call TriggerAddCondition(gg_trg_MainSpawn2, Condition(function Trig_MainSpawn2_Conditions))
    call TriggerAddAction(gg_trg_MainSpawn2, function Trig_MainSpawn2_Actions)
endfunction


//===========================================================================
// Trigger: LichDead
//===========================================================================
function Trig_LichDead_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTriggerUnit()) == 'e01I' and LoadBoolean(Hash, GetHandleId(GetTriggerUnit()), 2)
endfunction

function Trig_LichDead_Actions takes nothing returns nothing
    local integer oldid= GetHandleId(GetTriggerUnit())
    local unit u2= LoadUnitHandle(Hash, oldid, 1)
    local integer id= GetHandleId(u2)
    local integer currentCount= LoadInteger(Hash, id, 1) - 1
    local timer t
    call FlushChildHashtable(Hash, oldid)
    
    call SaveInteger(Hash, id, 1, currentCount)
    
    
    if UnitAlive(u2) and currentCount < 3 and not LoadBoolean(Hash, id, 2) then
        set t=CreateTimer()
        call TimerStart(t, 25, true, function spawnlich)
        call SaveBoolean(Hash, id, 2, true)
    endif
    
    
    set t=null
    set u2=null
endfunction

