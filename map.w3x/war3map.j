function InitTrig_NoTpNearCapital takes nothing returns nothing
    set gg_trg_NoTpNearCapital=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_NoTpNearCapital, EVENT_PLAYER_UNIT_SPELL_CAST)
    call TriggerAddCondition(gg_trg_NoTpNearCapital, Condition(function Trig_NoTpNearCapital_Conditions))
    call TriggerAddAction(gg_trg_NoTpNearCapital, function Trig_NoTpNearCapital_Actions)
endfunction


//===========================================================================
// Trigger: ManabombaNewSystem
//
// У условии спел каста манабомбы
//===========================================================================
function damageRadious takes unit damager,real delay,real damage,location destination,real radious,integer times,real interval,attacktype Attacktype,damagetype Damagetype returns nothing
    local integer i= 0
    loop
        exitwhen i >= times
        call UnitDamagePointLoc(damager, delay + interval * i, damage, destination, radious, Attacktype, Damagetype)
        set i=i + 1
    endloop


endfunction



  
function ManabombaNuke takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer tid= GetHandleId(t)
    local location destination= LoadLocationHandle(Hash, tid, 0)
    local unit caster= LoadUnitHandle(Hash, tid, 3)
    call RemoveUnit(LoadUnitHandle(Hash, tid, 1))
    call RemoveUnit(LoadUnitHandle(Hash, tid, 2))
   // call BJDebugMsg("Нюка")


    call RemoveEffectTimed(AddSpecialEffectLocBJ(destination, "war3mapImported\\ExplosionC.mdx") , 60)
    //call RemoveEffectTimed( AddSpecialEffectLocBJ( destination, "ForceField03.mdx" ) 20)
    
    
    
    
    call damageRadious(caster , 0.0 , 375.00 , destination , 70 , 20 , 0.25 , ATTACK_TYPE_CHAOS , DAMAGE_TYPE_MAGIC)

    call damageRadious(caster , 5 , 600.00 , destination , 55 , 12 , 0.25 , ATTACK_TYPE_CHAOS , DAMAGE_TYPE_MAGIC)

    call damageRadious(caster , 8 , 900.00 , destination , 3 , 160 , 0.25 , ATTACK_TYPE_CHAOS , DAMAGE_TYPE_MAGIC)
    call damageRadious(caster , 8 , 375.00 , destination , 5 , 160 , 0.25 , ATTACK_TYPE_CHAOS , DAMAGE_TYPE_MAGIC)
    
    
    call UnitRemoveAbility(caster, 'A0TS')

    
    
    call PauseTimer(t)
    call DestroyTimer(t)
    set t=null
    call FlushChildHashtable(Hash, tid)
    set caster=null
    call RemoveLocation(destination)
    set destination=null
endfunction


function ManabombaMissle takes unit caster,location destination returns nothing
    local timer t= CreateTimer()
    local integer tid= GetHandleId(t)

    local location l= GetUnitLoc(caster)
    local player p= GetOwningPlayer(caster)
    local unit u1
    local unit u2
   //call BJDebugMsg("Миссле")
     
    // Удаляю спел манабомбы
    call UnitRemoveAbility(caster, 'A0TT')
    // Юнит кастер
    set u1=CreateUnitAtLoc(p, 'h05P', l, bj_UNIT_FACING)
    call BlzSetUnitRealFieldBJ(u1, UNIT_RF_FLY_HEIGHT, GetUnitDefaultFlyHeight(caster))
    call UnitAddAbilityBJ('A0TU', u1)
    // Юнит жертва
    set u2=CreateUnitAtLoc(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'h0GI', destination, bj_UNIT_FACING)
    call BlzSetUnitRealFieldBJ(u2, UNIT_RF_FLY_HEIGHT, GetUnitDefaultFlyHeight(caster))
    
    
    
    call SetUnitPathing(u1, false)
    call SetUnitPathing(u2, false)
    call IssueTargetOrder(u1, "firebolt", u2)
     
    call TimerStart(t, ( DistanceBetweenPoints(l, destination) / 600.00 ), false, function ManabombaNuke)
    call SaveLocationHandle(Hash, tid, 0, destination)
    call SaveUnitHandle(Hash, tid, 1, u1)
    call SaveUnitHandle(Hash, tid, 2, u2)
    call SaveUnitHandle(Hash, tid, 3, caster)
    
    call RemoveLocation(l)
    set l=null
    set u1=null
    set u2=null
endfunction  
  


//===========================================================================
// Trigger: ManabobmaStart
//===========================================================================
function Trig_ManabobmaStart_Conditions takes nothing returns boolean
    if ( not ( GetItemTypeId(GetManipulatedItem()) == 'I01U' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'nzep' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ManabobmaStart_Actions takes nothing returns nothing
    call UnitAddAbilityBJ('A0TS', GetTriggerUnit())
    call UnitAddAbilityBJ('A0TT', GetTriggerUnit())
    call BlzSetUnitMaxHP(GetTriggerUnit(), 3000)
    call SetUnitLifePercentBJ(GetTriggerUnit(), 100)
    call RemoveItem(GetManipulatedItem())
    call TriggerRegisterUnitEvent(gg_trg_ManabombaDead, GetTriggerUnit(), EVENT_UNIT_DEATH)
    call TriggerRegisterUnitEvent(gg_trg_Manabomba2, GetTriggerUnit(), EVENT_UNIT_SPELL_CHANNEL)
endfunction

//===========================================================================
function InitTrig_ManabobmaStart takes nothing returns nothing
    set gg_trg_ManabobmaStart=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ManabobmaStart, EVENT_PLAYER_UNIT_PICKUP_ITEM)
    call TriggerAddCondition(gg_trg_ManabobmaStart, Condition(function Trig_ManabobmaStart_Conditions))
    call TriggerAddAction(gg_trg_ManabobmaStart, function Trig_ManabobmaStart_Actions)
endfunction

