function isStartPosition takes nothing returns boolean
    return GetUnitTypeId(GetFilterUnit()) == 'h0O1'
endfunction

function SetStartLocations takes nothing returns nothing
    local group StartLocations= CreateGroup()
    local boolexpr b= Condition(function isStartPosition)
    local unit u
    call GroupEnumUnitsInRect(StartLocations, bj_mapInitialPlayableArea, b)
    loop
        set u=FirstOfGroup(StartLocations)
        exitwhen u == null
    
        set StartLoc[StartLocCount]=GetUnitLoc(u)
        set StartLocCount=StartLocCount + 1
        
        
        call GroupRemoveUnit(StartLocations, u)
        call RemoveUnit(u)
        set u=null
    endloop
    
    call DestroyGroup(StartLocations)
    set StartLocations=null
    call DestroyBoolExpr(b)
    set b=null
    set u=null
endfunction

function RandomLoc takes nothing returns location
    
    return StartLoc[GetRandomInt(0, StartLocCount - 1)]
    
endfunction


