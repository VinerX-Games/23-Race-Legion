//===========================================================================
// Trigger: CorrupPlus
//===========================================================================
function Trig_CorrupPlus_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0AS'
endfunction

function Trig_CorrupPlus_Func008A takes nothing returns nothing
    call SetUnitAbilityLevelSwapped('A0AW', GetEnumUnit(), GetPlayerTechCountSimple('R04O', GetOwningPlayer(GetEnumUnit())))
    call SetUnitAbilityLevelSwapped('A0AV', GetEnumUnit(), GetPlayerTechCountSimple('R04O', GetOwningPlayer(GetEnumUnit())))
endfunction

function CorriptionTimerPlus takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer tid= GetHandleId(t)
    local player p= Player(LoadInteger(Hash, tid, 0))
    if GetPlayerTechCountSimple('R04O', p) == 6 then
        call SetPlayerAbilityAvailableBJ(true, 'A0AT', p)
    else
        call SetPlayerAbilityAvailableBJ(true, 'A0AS', p)
        call SetPlayerAbilityAvailableBJ(true, 'A0AT', p)
    endif
    call FlushChildHashtable(Hash, tid)
    call DestroyTimer(t)
    set t=null

endfunction


function Trig_CorrupPlus_Actions takes nothing returns nothing
    local timer t= CreateTimer()
    local integer tid= GetHandleId(t)
    local player p= GetOwningPlayer(GetTriggerUnit())
    call SetPlayerAbilityAvailableBJ(false, 'A0AS', p)
    call SetPlayerAbilityAvailableBJ(false, 'A0AT', p)
    call SetPlayerTechResearchedSwap('R04O', ( GetPlayerTechCountSimple('R04O', p) + 1 ), p)
    
    call GroupEnumUnitsOfPlayer(udg_LocalOtrad2, p, null)
    call ForGroupBJ(udg_LocalOtrad2, function Trig_CorrupPlus_Func008A)
    call GroupClear(udg_LocalOtrad2)

    
    call SaveInteger(Hash, tid, 0, GetPlayerId(p))
    call TimerStart(t, 60, false, function CorriptionTimerPlus)
    
    

    set t=null
endfunction

//===========================================================================
function InitTrig_CorrupPlus takes nothing returns nothing
    set gg_trg_CorrupPlus=CreateTrigger()
    call DisableTrigger(gg_trg_CorrupPlus)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_CorrupPlus, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_CorrupPlus, Condition(function Trig_CorrupPlus_Conditions))
    call TriggerAddAction(gg_trg_CorrupPlus, function Trig_CorrupPlus_Actions)
endfunction


