function isShip takes integer id returns boolean
    return id == 'h00X' or id == 'h00Y' or id == 'h00Z' or id == 'h0CZ' or id == 'h0D2' or id == 'h0D0' or id == 'h0D5' or id == 'h0D4' or id == 'h0D6' or id == 'h0DB' or id == 'h0D9' or id == 'h0DA' or id == 'h0E6' or id == 'h0E5' or id == 'h0E8' or id == 'h03L' or id == 'h03K' or id == 'h06W' or id == 'h0DM' or id == 'h06V' or id == 'h06X' //Гоблины
    
endfunction

function aiShipJoins takes unit u,integer pi returns nothing
    call GroupAddUnit(Navy, u)
    call GroupAddUnit(udg_Ai_navy[pi], u)
endfunction

function Trig_MainFloatUnits_Conditions takes nothing returns boolean
    set gUnit=GetTrainedUnit()
    set gId=GetUnitTypeId(gUnit)
    return isShip(gId)
endfunction


function Trig_MainFloatUnits_Actions takes nothing returns nothing
    call aiShipJoins(gUnit , GetPlayerId(GetOwningPlayer(gUnit)))
endfunction

