function InitTrig_NextMenu takes nothing returns nothing
    set gg_trg_NextMenu=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_NextMenu, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_NextMenu, Condition(function Trig_NextMenu_Conditions))
    call TriggerAddAction(gg_trg_NextMenu, function Trig_NextMenu_Actions)
endfunction


