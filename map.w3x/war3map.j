//===========================================================================
// Trigger: Spell E2
//===========================================================================
function Trig_Spell_E2_Conditions takes nothing returns boolean
 
    return GetUnitTypeId(GetEventDamageSource()) == 'O04H' and GetUnitAbilityLevel(GetTriggerUnit(), 'A0H1') > 0
    // Тип применяющего и спел применяющего
endfunction

function Trig_Spell_E2_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    call DisableTrigger(GetTriggeringTrigger())
    call UnitRemoveAbility(u, 'A0H1')
    //call DisplayTextToPlayer(Player(0),0,0,"Работает")
    set udg_To4kaTarget=GetUnitLoc(u)
    call UnitDamageTargetBJ(GetEventDamageSource(), u, I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, GetEventDamageSource(), true)), ATTACK_TYPE_HERO, DAMAGE_TYPE_UNIVERSAL)
    call AddSpecialEffectLocBJ(udg_To4kaTarget, "Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl")
    call DestroyEffectBJ(GetLastCreatedEffectBJ())
    call CreateTextTagLocBJ(( "|cff00ff00+" + I2S(GetHeroStatBJ(bj_HEROSTAT_AGI, GetEventDamageSource(), true)) ), udg_To4kaTarget, 140.00, 9.00, 100, 100, 100, 0)
    call SetTextTagVelocityBJ(GetLastCreatedTextTag(), 150.00, 90)
    call SetTextTagSuspendedBJ(GetLastCreatedTextTag(), false)
    call SetTextTagPermanentBJ(GetLastCreatedTextTag(), false)
    call SetTextTagLifespanBJ(GetLastCreatedTextTag(), 0.80)
    call SetTextTagFadepointBJ(GetLastCreatedTextTag(), 0.80)
    call RemoveLocation(udg_To4kaTarget)
    call EnableTrigger(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Spell_E2 takes nothing returns nothing
    set gg_trg_Spell_E2=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Spell_E2, EVENT_PLAYER_UNIT_DAMAGED)
    call TriggerAddCondition(gg_trg_Spell_E2, Condition(function Trig_Spell_E2_Conditions))
    call TriggerAddAction(gg_trg_Spell_E2, function Trig_Spell_E2_Actions)
endfunction


//===========================================================================
// Trigger: HpRegen2
//===========================================================================
function Trig_HpRegen2_Conditions takes nothing returns boolean
    
    return GetUnitAbilityLevel(GetTriggerUnit(), 'A1CA') > 0 // Тут абилка иконка
    
    
endfunction

function Trig_HpRegen2_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()

    local integer spellid= 'A1CY'
    local integer timerspellid= 'A1CX'
    local real lifep= GetUnitLifePercent(u)
    local integer time= 10
    
    if lifep < 25 then
        call UnitAddAbility(u, spellid)
        call SetUnitAbilityLevel(u, spellid, 2)
        call BlzStartUnitAbilityCooldown(u, timerspellid, 20)
       // call DisplayTextToPlayer(Player(0),0,0,"м 25"+R2S(lifep))
    elseif lifep < 50 then
            call UnitAddAbility(u, spellid)
            call SetUnitAbilityLevel(u, spellid, 1)
            call BlzStartUnitAbilityCooldown(u, timerspellid, 20)
     //       call DisplayTextToPlayer(Player(0),0,0,"м50"+R2S(lifep))
            
    else
            call UnitRemoveAbility(u, spellid)
       //     call DisplayTextToPlayer(Player(0),0,0,"Другое"+R2S(lifep))
    endif
    call UnitAddAbility(u, timerspellid)
    call BlzStartUnitAbilityCooldown(u, timerspellid, time)
    call TriggerSleepAction(time)
    
    if BlzGetUnitAbilityCooldownRemaining(u, timerspellid) == 0 then
        call UnitRemoveAbility(u, spellid)
    endif
    
    
    
    set u=null
endfunction

//===========================================================================
function InitTrig_HpRegen2 takes nothing returns nothing
    set gg_trg_HpRegen2=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HpRegen2, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_HpRegen2, Condition(function Trig_HpRegen2_Conditions))
    call TriggerAddAction(gg_trg_HpRegen2, function Trig_HpRegen2_Actions)
endfunction


