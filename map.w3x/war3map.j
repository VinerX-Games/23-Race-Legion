// Trigger: StartForestTrolls
//===========================================================================
function ForestStart takes nothing returns nothing
    
    
    call SetPlayerTechMaxAllowedSwap('o05N', 3, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('o05M', 3, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('o05O', 3, GetEnumPlayer())
    
    call SetPlayerTechMaxAllowedSwap('O056', 1, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('O057', 1, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('O058', 1, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('O059', 1, GetEnumPlayer())
    
    call SetPlayerTechMaxAllowedSwap('o04Y', 0, GetEnumPlayer())
    
endfunction

function Trig_StartForestTrolls_Actions takes nothing returns nothing
    call ForForce(udg_AllPlayers, function ForestStart)
endfunction

