function InitTrig_TimerIncome takes nothing returns nothing
    set gg_trg_TimerIncome=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_TimerIncome, udg_IncomeTimerSecond)
    call TriggerAddAction(gg_trg_TimerIncome, function Trig_TimerIncome_Actions)
endfunction


