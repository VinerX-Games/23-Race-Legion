endfunction

function Trig_UpgradeSkelets_Actions takes nothing returns nothing
    local player p= GetOwningPlayer(GetTriggerUnit())
    local integer lvl= GetPlayerTechCount(p, 'R0K4', true)
    
    if lvl == 1 then
