function InitTrig_RRR takes nothing returns nothing
    set gg_trg_RRR=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_RRR, 0.04)
    call TriggerAddAction(gg_trg_RRR, function Trig_RRR_Actions)
endfunction


//===========================================================================
// Trigger: RemoveUnitTimed
//
// Любой триг может это вызвать, главное до этого задать LocalUni2
//===========================================================================
function ToKillAct takes nothing returns nothing
    
    local timer t= GetExpiredTimer()
    local integer id= GetHandleId(t)
    call RemoveUnit(LoadUnitHandle(Hash, id, 1))
    call FlushChildHashtable(Hash, id)
    call DestroyTimer(t)
    set t=null

endfunction
function RemoveUnitTimed takes unit u,real time returns nothing
    local timer t= CreateTimer()
    local integer id= GetHandleId(t)
    call TimerStart(t, time, false, function ToKillAct)
    call SaveUnitHandle(Hash, id, 1, u)
    set u=null
    set t=null
endfunction

//===========================================================================
// Trigger: ReviveHeroTimed
//
// Любой триг может это вызвать, главное до этого задать LocalUni2
//===========================================================================


function ReviveHeroTimedAct takes nothing returns nothing
    
    local timer t= GetExpiredTimer()
    local integer id= GetHandleId(t)
    set gUnit=LoadUnitHandle(Hash, id, 1)
    
    set Counter=0
    call GroupEnumUnitsOfPlayer(gGroup, GetOwningPlayer(gUnit), UnitsWithReviveHeroSpell)
    if FirstOfGroup(gGroup) != null then
        set gUnit2=GroupPickRandomUnit2(gGroup)
        call ReviveHero(gUnit, GetUnitX(gUnit2), GetUnitY(gUnit2), true)
    endif
    
    call FlushChildHashtable(Hash, id)
    call DestroyTimer(t)
    set t=null
endfunction

function ReviveHeroTimed takes unit u,real time returns nothing
    local timer t= CreateTimer()
    local integer id= GetHandleId(t)
    call TimerStart(t, time, false, function ReviveHeroTimedAct)
    call SaveUnitHandle(Hash, id, 1, u)
    set t=null
endfunction



