//JASSHelper struct globals:
constant integer si__StackTemplate=1
integer si__StackTemplate_F=0
integer si__StackTemplate_I=0
integer array si__StackTemplate_V
integer array s__StackTemplate_STACK
integer s__StackTemplate_COUNT= 0
integer array s__StackTemplate_NOW
constant integer si__SanctifiedEnchantment=2
integer si__SanctifiedEnchantment_F=0
integer si__SanctifiedEnchantment_I=0
integer array si__SanctifiedEnchantment_V
constant integer s__SanctifiedEnchantment_Key=8
constant real s__SanctifiedEnchantment_Date= 0.05
integer array s__SanctifiedEnchantment_Level
unit array s__SanctifiedEnchantment_Target
real array s__SanctifiedEnchantment_Time
trigger array s__SanctifiedEnchantment_Trigger

endglobals
    native UnitAlive takes unit u returns boolean
native GetUnitGoldCost takes integer unitid returns integer
native GetUnitWoodCost takes integer unitid returns integer
native GetPlayerUnitTypeCount takes player p, integer unitid returns integer


//Generated allocator of StackTemplate
function s__StackTemplate__allocate takes nothing returns integer
 local integer this=si__StackTemplate_F
    if (this!=0) then
        set si__StackTemplate_F=si__StackTemplate_V[this]
    else
        set si__StackTemplate_I=si__StackTemplate_I+1
        set this=si__StackTemplate_I
    endif
    if (this>8190) then
        return 0
    endif

    set si__StackTemplate_V[this]=-1
 return this
endfunction

//Generated destructor of StackTemplate
function s__StackTemplate_deallocate takes integer this returns nothing
    if this==null then
        return
    elseif (si__StackTemplate_V[this]!=-1) then
        return
    endif
    set si__StackTemplate_V[this]=si__StackTemplate_F
    set si__StackTemplate_F=this
endfunction

//Generated allocator of SanctifiedEnchantment
function s__SanctifiedEnchantment__allocate takes nothing returns integer
 local integer this=si__SanctifiedEnchantment_F
    if (this!=0) then
        set si__SanctifiedEnchantment_F=si__SanctifiedEnchantment_V[this]
    else
        set si__SanctifiedEnchantment_I=si__SanctifiedEnchantment_I+1
        set this=si__SanctifiedEnchantment_I
    endif
    if (this>8190) then
        return 0
    endif

   set s__SanctifiedEnchantment_Time[this]= 0
    set si__SanctifiedEnchantment_V[this]=-1
 return this
endfunction

//Generated destructor of SanctifiedEnchantment
function s__SanctifiedEnchantment_deallocate takes integer this returns nothing
    if this==null then
        return
    elseif (si__SanctifiedEnchantment_V[this]!=-1) then
        return
    endif
    set si__SanctifiedEnchantment_V[this]=si__SanctifiedEnchantment_F
    set si__SanctifiedEnchantment_F=this
endfunction

//library A1:

function EnemEl takes nothing returns boolean
    return GetOwningPlayer(GetFilterUnit()) != udg_LocalPlayer
endfunction


