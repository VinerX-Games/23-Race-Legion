function Trig_DamageBeforeW2_Actions takes nothing returns nothing
    local unit u= GetEventDamageSource()
    local integer uh= GetHandleId(u)
    local integer lvl= LoadInteger(Hash, uh, 0)
    local real damage= GetEventDamage()
    
    call DisableTrigger(gg_trg_DamageBeforeW2)
    call DisableTrigger(gg_trg_DamagerW2)
    if u != null then
        call UnitDamageTargetBJ(u, GetTriggerUnit(), damage * 0.02 * lvl, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_UNIVERSAL)
    else
        call UnitDamageTargetBJ(GetTriggerUnit(), GetTriggerUnit(), damage * 0.02 * lvl, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_UNIVERSAL)
    endif
    call EnableTrigger(gg_trg_DamageBeforeW2)
    call EnableTrigger(gg_trg_DamagerW2)
        
    
    set u=null
endfunction

