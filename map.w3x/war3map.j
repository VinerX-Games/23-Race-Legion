//===========================================================================
// Trigger: SpellGiveQSpell
//===========================================================================
function Trig_SpellGiveQSpell_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A1ES'
endfunction

function Trig_SpellGiveQSpell_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    //call DisplayTextToPlayer(Player(0),0,0,"2")
    call TriggerSleepAction(0.5)
    if GetUnitAbilityLevel(u, 'A1EZ') > 0 then
        //Дух
        call UnitRemoveAbility(u, 'A1EW')
        call BlzUnitHideAbility(u, 'A1EV', false)
    else
        //Материальныей мир
        call UnitAddAbility(u, 'A1EW')
        call SetUnitAbilityLevel(u, 'A1EW', GetUnitAbilityLevel(u, 'A1EV'))
        call BlzUnitHideAbility(u, 'A1EV', true)
    endif


    set u=null
endfunction

//===========================================================================
function InitTrig_SpellGiveQSpell takes nothing returns nothing
    set gg_trg_SpellGiveQSpell=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_SpellGiveQSpell, EVENT_PLAYER_UNIT_SPELL_FINISH)
    call TriggerAddCondition(gg_trg_SpellGiveQSpell, Condition(function Trig_SpellGiveQSpell_Conditions))
    call TriggerAddAction(gg_trg_SpellGiveQSpell, function Trig_SpellGiveQSpell_Actions)
endfunction


//===========================================================================
// Trigger: GetMoreStatsBwon
//
// Default melee game initialization for all players
//===========================================================================


function Trig_GetMoreStatsBwon_Conditions takes nothing returns boolean
    return Bwonsamdy[GetPlayerId(GetOwningPlayer(GetKillingUnit()))] != null
endfunction

function Trig_GetMoreStatsBwon_Actions takes nothing returns nothing
    local unit u= Bwonsamdy[GetPlayerId(GetOwningPlayer(GetKillingUnit()))]
    if u != null then
        call BlzSetUnitMaxHP(u, ( BlzGetUnitMaxHP(u) + 1 ))
        call BlzSetUnitMaxMana(u, ( BlzGetUnitMaxMana(u) + 6 ))
        call SetUnitLifeBJ(u, ( GetUnitStateSwap(UNIT_STATE_LIFE, u) + 1 ))
        call SetUnitManaBJ(u, ( GetUnitStateSwap(UNIT_STATE_MANA, u) + 6 ))
        call BlzSetUnitRealFieldBJ(u, UNIT_RF_MANA_REGENERATION, ( BlzGetUnitRealField(u, UNIT_RF_MANA_REGENERATION) + 0.05 ))
        
    endif
    set u=null
endfunction

//===========================================================================
function InitTrig_GetMoreStatsBwon takes nothing returns nothing
    set gg_trg_GetMoreStatsBwon=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_GetMoreStatsBwon, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_GetMoreStatsBwon, Condition(function Trig_GetMoreStatsBwon_Conditions))
    call TriggerAddAction(gg_trg_GetMoreStatsBwon, function Trig_GetMoreStatsBwon_Actions)
endfunction


//===========================================================================
// Trigger: DamagePercent
//===========================================================================
function Trig_DamagePercent_Conditions takes nothing returns boolean
    //call DisplayTextToPlayer(Player(0),0,0,"2")
    return GetUnitAbilityLevel(GetEventDamageSource(), 'A1ET') > 0 and GetUnitAbilityLevel(GetTriggerUnit(), 'A1EU') == 0
endfunction

function Trig_DamagePercent_Actions takes nothing returns nothing
    local integer seconds= 7
    local unit u= GetEventDamageSource()
    local unit u2= GetTriggerUnit()
    local effect e= AddSpecialEffectTargetUnitBJ("overhead", u2, "Abilities\\Spells\\Undead\\Curse\\CurseTarget.mdl")
    local integer i= 0
    //call DisplayTextToPlayer(Player(0),0,0,"2"+GetUnitName(u2))
     
    call UnitAddAbility(u2, 'A1EU')
    //call BlzSetAbilityTooltip( 'ANav', I2S(GetPlayerId(GetOwningPlayer(u))), 0 )
    loop
        exitwhen not UnitAlive(u2) or i * 0.25 > seconds
        call UnitDamageTargetBJ(u, u2, RMaxBJ(75, BlzGetUnitMaxHP(u2) * 0.005), ATTACK_TYPE_HERO, DAMAGE_TYPE_DEATH)
        call TriggerSleepAction(0.25)
        set i=i + 1
    endloop
    call UnitRemoveAbility(u2, 'A1EU')
    call DestroyEffect(e)
    set u=null
    set u2=null
    set e=null

endfunction

//===========================================================================
function InitTrig_DamagePercent takes nothing returns nothing
    set gg_trg_DamagePercent=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_DamagePercent, EVENT_PLAYER_UNIT_DAMAGED)
    call TriggerAddCondition(gg_trg_DamagePercent, Condition(function Trig_DamagePercent_Conditions))
    call TriggerAddAction(gg_trg_DamagePercent, function Trig_DamagePercent_Actions)
endfunction


