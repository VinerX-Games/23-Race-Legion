function Trig_BlinkToUnit_Spell_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0N3'
endfunction





function Trig_BlinkToUnit_Spell_Actions takes nothing returns nothing

    local location l1= GetUnitLoc(GetSpellTargetUnit())
    local location l2= GetUnitLoc(GetTriggerUnit())
    
    call MoveWithOrderTimed(GetTriggerUnit() , GetSpellTargetUnit() , l1 , "attack" , DistanceBetweenPoints(l1, l2) / 1200 + 0.4)

    call RemoveLocation(l2)
    set l1=null
    set l2=null
endfunction

//===========================================================================
function InitTrig_BlinkToUnit_Spell takes nothing returns nothing
    set gg_trg_BlinkToUnit_Spell=CreateTrigger()
    call DisableTrigger(gg_trg_BlinkToUnit_Spell)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_BlinkToUnit_Spell, EVENT_PLAYER_UNIT_SPELL_CAST)
    call TriggerAddCondition(gg_trg_BlinkToUnit_Spell, Condition(function Trig_BlinkToUnit_Spell_Conditions))
    call TriggerAddAction(gg_trg_BlinkToUnit_Spell, function Trig_BlinkToUnit_Spell_Actions)
endfunction


//===========================================================================
// Trigger: Edvin Ult
//
// Резня в тени
//===========================================================================
function Trig_Edvin_Ult_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0N4'
endfunction


function Trig_Edvin_Ult_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local unit u2
    local group g= CreateGroup()

    call GroupEnumUnitsInRange(g, GetSpellTargetX(), GetSpellTargetY(), 235.00, null)
    
    
    
    loop
        set u2=FirstOfGroup(g)
        exitwhen u2 == null
        
        if GetOwningPlayer(u2) != GetOwningPlayer(u) then
            
            call SetUnitX(u, GetUnitX(u2))
            call SetUnitY(u, GetUnitY(u2))
            call RemoveEffectTimed(AddSpecialEffect("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodLarge1.mdl", GetUnitX(u2), GetUnitY(u2)) , 1)
            call UnitDamageTargetBJ(u, u2, ( 300 * GetUnitAbilityLevel(u, 'A0N4') + 2 * GetHeroAgi(u, true) ), ATTACK_TYPE_HERO, DAMAGE_TYPE_FORCE)
                 
            
            
        endif
        
        call GroupRemoveUnit(g, u2)
    endloop
    
    
    
    
    call UnitAddAbility(u, 'A0N5')
    call BlzUnitDisableAbility(u, 'A0N1', true, true)
    call IssueImmediateOrder(u, "windwalk")
    call BlzUnitDisableAbility(u, 'A0N1', false, false)
    call BlzStartUnitAbilityCooldown(u, 'A0N4', 35)
    
    call DestroyGroup(g)
    set g=null
    set u=null
    set u2=null

endfunction

//===========================================================================
function InitTrig_Edvin_Ult takes nothing returns nothing
    set gg_trg_Edvin_Ult=CreateTrigger()
    call DisableTrigger(gg_trg_Edvin_Ult)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Edvin_Ult, EVENT_PLAYER_UNIT_SPELL_CAST)
    call TriggerAddCondition(gg_trg_Edvin_Ult, Condition(function Trig_Edvin_Ult_Conditions))
    call TriggerAddAction(gg_trg_Edvin_Ult, function Trig_Edvin_Ult_Actions)
endfunction


//===========================================================================
// Trigger: Del1FromTable C
//===========================================================================
function Trig_Del1FromTable_C_Actions takes nothing returns nothing
    local integer i= GetPlayerId(udg_LocalPlayer)
    set udg_UnitsCount[GetConvertedPlayerId(udg_LocalPlayer)]=( udg_UnitsCount[GetConvertedPlayerId(udg_LocalPlayer)] - 1 )
    call MultiboardSetItemValue(MultiboardItem[MultiboardItemOwnerIndex[i] * 2 + 1], I2S(udg_UnitsCount[i + 1]))
    set i=0
endfunction

