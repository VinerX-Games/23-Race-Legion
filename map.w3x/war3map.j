    if ( not ( udg_HisloA[0] == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Spell_Dvij_Func004Func007C takes nothing returns boolean
    if ( not ( udg_LogikaCast == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Spell_Dvij_Func004C takes nothing returns boolean
    return true
endfunction

function Trig_Spell_Dvij_Actions takes nothing returns nothing
    // обнуление
    if ( Trig_Spell_Dvij_Func002C() ) then
        call RemoveUnit(udg_Dummy[0])
        call RemoveUnit(udg_Dummy[1])
        call RemoveUnit(udg_Dummy[2])
        call GroupClear(udg_Group)
        call SetPlayerAbilityAvailableBJ(false, 'A1BM', GetOwningPlayer(udg_Caster))
        call SetPlayerAbilityAvailableBJ(true, 'A1BN', GetOwningPlayer(udg_Caster))
        call RemoveLocation(udg_To4kaCaster)
        set udg_Dummy[0]=null
        set udg_Dummy[1]=null
        set udg_Dummy[2]=null
        set udg_Caster=null
        set udg_Logika=false
        set udg_LogikaCast=false
        call PauseTimerBJ(true, udg_Timer)
    else
    endif
    if ( (true) ) then // INLINED!!
        set udg_To4kaCaster=GetUnitLoc(udg_Caster)
        // скорость поворота если заменить + на -  шары будут крутится в другую сторону
        set udg_Ygol[1]=( udg_Ygol[1] + 5 )
        if ( Trig_Spell_Dvij_Func004Func004C() ) then
            call SetUnitPositionLoc(udg_Dummy[0], PolarProjectionBJ(udg_To4kaCaster, 100.00, ( 0.00 + I2R(udg_Ygol[1]) )))
        else
        endif
        if ( Trig_Spell_Dvij_Func004Func005C() ) then
            call SetUnitPositionLoc(udg_Dummy[1], PolarProjectionBJ(udg_To4kaCaster, 100.00, ( 120.00 + I2R(udg_Ygol[1]) )))
        else
        endif
        if ( Trig_Spell_Dvij_Func004Func006C() ) then
            call SetUnitPositionLoc(udg_Dummy[2], PolarProjectionBJ(udg_To4kaCaster, 100.00, ( 240.00 + I2R(udg_Ygol[1]) )))
        else
        endif
        if ( Trig_Spell_Dvij_Func004Func007C() ) then
            // Первый летящий шар
            if ( Trig_Spell_Dvij_Func004Func007Func002C() ) then
                set udg_To4kaTarget=GetUnitLoc(udg_Target)
                set udg_To4kaDummy=GetUnitLoc(udg_Dummy[2])
                // Скорость полета шара во врага
                call SetUnitPositionLoc(udg_Dummy[2], PolarProjectionBJ(udg_To4kaDummy, 50.00, AngleBetweenPoints(udg_To4kaDummy, udg_To4kaTarget)))
                if ( Trig_Spell_Dvij_Func004Func007Func002Func005C() ) then
                    // АОЕ урона и бафов
                    call ForGroupBJ(GetUnitsInRangeOfLocAll(200.00, udg_To4kaTarget), function Trig_Spell_Dvij_Func004Func007Func002Func005Func002A)
                    call AddSpecialEffectLocBJ(udg_To4kaTarget, "Abilities\\Spells\\Demon\\DarkPortal\\DarkPortalTarget.mdl")
                    call DestroyEffectBJ(GetLastCreatedEffectBJ())
                    call RemoveUnit(udg_Dummy[2])
                    set udg_Target=null
                    set udg_LogikaCast=false
                else
                endif
                call RemoveLocation(udg_To4kaDummy)
                call RemoveLocation(udg_To4kaTarget)
            else
            endif
            // Второй летящий шар
            if ( Trig_Spell_Dvij_Func004Func007Func004C() ) then
                set udg_To4kaTarget=GetUnitLoc(udg_Target)
                set udg_To4kaDummy=GetUnitLoc(udg_Dummy[1])
                // Скорость полета шара во врага
                call SetUnitPositionLoc(udg_Dummy[1], PolarProjectionBJ(udg_To4kaDummy, 50.00, AngleBetweenPoints(udg_To4kaDummy, udg_To4kaTarget)))
                if ( Trig_Spell_Dvij_Func004Func007Func004Func006C() ) then
                    // АОЕ урона и бафов
                    call ForGroupBJ(GetUnitsInRangeOfLocAll(200.00, udg_To4kaTarget), function Trig_Spell_Dvij_Func004Func007Func004Func006Func002A)
                    call AddSpecialEffectLocBJ(udg_To4kaTarget, "Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualTarget.mdl")
                    call DestroyEffectBJ(GetLastCreatedEffectBJ())
                    call RemoveUnit(udg_Dummy[1])
                    set udg_Target=null
                    set udg_LogikaCast=false
                else
                endif
                call RemoveLocation(udg_To4kaDummy)
                call RemoveLocation(udg_To4kaTarget)
            else
            endif
            // Третий летящий шар
            if ( Trig_Spell_Dvij_Func004Func007Func006C() ) then
                set udg_To4kaTarget=GetUnitLoc(udg_Target)
                set udg_To4kaDummy=GetUnitLoc(udg_Dummy[0])
                // Скорость полета шара во врага
                call SetUnitPositionLoc(udg_Dummy[0], PolarProjectionBJ(udg_To4kaDummy, 50.00, AngleBetweenPoints(udg_To4kaDummy, udg_To4kaTarget)))
                if ( Trig_Spell_Dvij_Func004Func007Func006Func005C() ) then
                    // АОЕ урона и бафов
                    call ForGroupBJ(GetUnitsInRangeOfLocAll(200.00, udg_To4kaTarget), function Trig_Spell_Dvij_Func004Func007Func006Func005Func002A)
                    call AddSpecialEffectLocBJ(udg_To4kaTarget, "Abilities\\Spells\\Undead\\DeathPact\\DeathPactTarget.mdl")
                    call DestroyEffectBJ(GetLastCreatedEffectBJ())
                    call RemoveUnit(udg_Dummy[0])
                    set udg_Target=null
                    set udg_LogikaCast=false
                    set udg_HisloA[0]=0
                else
                endif
                call RemoveLocation(udg_To4kaDummy)
                call RemoveLocation(udg_To4kaTarget)
            else
            endif
        else
        endif
    else
    endif
endfunction

