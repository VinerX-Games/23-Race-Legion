function Trig_StartCreateChoice_Actions takes nothing returns nothing
    local integer i
    local integer i2
    set i=S2I(SubStringBJ(GetEventPlayerChatString(), 4, 5)) - 1
    call TriggerExecute(gg_trg_TurnAi)
    
   
    set udg_AiControl[i]=true
    call ForceAddPlayerSimple(Player(i), udg_Bots)
    // Обычное появление и ресы
   
    //Задаю место
    
    
    set udg_LocalPoint=RandomLoc() //GetCameraEyePositionLoc()
    
    
        
    
    //Задаю место
    
    //call RandomAiPlace()
    
    //В итоге место 
    
    
    set i2=GetRandomInt(1, 2)
    
    
    //Алый орден
    if i2 == 1 then
        //Старт юниты
        call CreateNUnitsAtLoc(8, 'h014', Player(i), udg_LocalPoint, bj_UNIT_FACING)
        call GroupAddGroup(GetLastCreatedGroup(), udg_Ai_units[i])
        call GroupAddGroup(GetLastCreatedGroup(), udg_Ai_builders[i])
        call CreateNUnitsAtLoc(1, 'h05U', Player(i), udg_LocalPoint, bj_UNIT_FACING)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Ai_units[i])
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Ai_buildings[i])
        call SaveInteger(AiData, i, 'h014', 8)
        call SaveInteger(AiData, i, 'h05U', 1)
        call SetPlayerName(Player(i), "Алый Орден (" + I2S(i + 1) + ")")
        call SaveStr(AiData, i, StringHash("Race"), "AO")
        
        set AiRace[i]="Scarlet"
    elseif i > 1 then
        call CreateNUnitsAtLoc(8, 'h04K', Player(i), udg_LocalPoint, bj_UNIT_FACING)
        call GroupAddGroup(GetLastCreatedGroup(), udg_Ai_units[i])
        call GroupAddGroup(GetLastCreatedGroup(), udg_Ai_builders[i])
        call CreateNUnitsAtLoc(1, 'h04C', Player(i), udg_LocalPoint, bj_UNIT_FACING)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Ai_units[i])
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Ai_buildings[i])
        call SaveInteger(AiData, i, 'h04K', 8)
        call SaveInteger(AiData, i, 'h04C', 1)
        call SetPlayerName(Player(i), "Эльфы Крови (" + I2S(i + 1) + ")")
        call SaveStr(AiData, i, StringHash("Race"), "BE")
        call TriggerExecute(gg_trg_BloodElvesOn)
        set AiRace[i]="BloodElves"

    
    endif
    //Лимиты
    call SetLimits(Player(i))
    
    
    
    call SetPlayerStateBJ(Player(i), PLAYER_STATE_RESOURCE_GOLD, 5000)
    call SetPlayerStateBJ(Player(i), PLAYER_STATE_RESOURCE_LUMBER, 5000)
    call SetBools()
    call TriggerExecute(gg_trg_CityNearWater2)
    
    // Данные ИИшки
    // Таймеры ИИ
    
    call StartTimerBJ(udg_TimerSmall, false, 1.11 * AiRepeat / 5)
    call StartTimerBJ(udg_TimerSmall2, false, 2.12 * AiRepeat / 5)
    call StartTimerBJ(udg_TimerSmall3, false, 3.13 * AiRepeat / 5)
    call StartTimerBJ(udg_TimerSmall4, false, 4.14 * AiRepeat / 5)
    call StartTimerBJ(udg_AiTimerStrateg, true, 15.15 * AiRepeat / 5)
    call StartTimerBJ(udg_TimerToChangeAi, false, 3000.00)
endfunction

//===========================================================================
function InitTrig_StartCreateChoice takes nothing returns nothing
    set gg_trg_StartCreateChoice=CreateTrigger()
    call TriggerRegisterPlayerChatEvent(gg_trg_StartCreateChoice, Player(0), "-ai", false)
    call TriggerAddCondition(gg_trg_StartCreateChoice, Condition(function Trig_StartCreateChoice_Conditions))
    call TriggerAddAction(gg_trg_StartCreateChoice, function Trig_StartCreateChoice_Actions)
endfunction


//===========================================================================
// Trigger: StartCreateAll
//===========================================================================

function Trig_StartCreateAll_Actions takes nothing returns nothing
    local integer i= 1
    local integer i2= 0
    call TriggerExecute(gg_trg_TurnAi)

    loop
        exitwhen i == 23
        if i != 12 and i != 15 and GetPlayerName(Player(i)) != "Нейтрал" and GetPlayerName(Player(i)) != "Противник" then
            set udg_AiControl[i]=true
            call ForceAddPlayer(udg_Bots, Player(i))
            // Обычное появление и ресы
           
            //Задаю место
            set i2=GetRandomInt(0, 4)
            if i2 == 0 then
                set udg_LocalPoint=Location(18787, - 14852)
            elseif i2 == 1 then
                set udg_LocalPoint=Location(18891, - 8993)
            elseif i2 == 2 then
                set udg_LocalPoint=Location(16989, - 2303)
            elseif i2 == 3 then
                set udg_LocalPoint=Location(26958, - 5)
            elseif i2 == 4 then
                set udg_LocalPoint=Location(20346, 7012)
            endif
            //Задаю место
            
            //set udg_LocalPoint = GetRandomLocInRect(gg_rct_Bot1_Copy15)
            
            //В итоге место 
            
            
            
            
            //Старт юниты
            call CreateNUnitsAtLoc(10, 'h014', Player(i), udg_LocalPoint, bj_UNIT_FACING)
            call GroupAddGroup(GetLastCreatedGroup(), udg_Ai_units[i])
            call GroupAddGroup(GetLastCreatedGroup(), udg_Ai_builders[i])
            call CreateNUnitsAtLoc(1, 'h05U', Player(i), udg_LocalPoint, bj_UNIT_FACING)
            call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Ai_units[i])
            call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Ai_buildings[i])
            call SaveInteger(AiData, i, 'h014', 10)
            call SaveInteger(AiData, i, 'h05U', 1)
            call SaveStr(AiData, udg_LocalInteger, StringHash("Race"), "AO")
            //Лимиты
            call SetLimits(Player(i))
            
            
            
            call SetPlayerStateBJ(Player(i), PLAYER_STATE_RESOURCE_GOLD, 6000)
            call SetPlayerStateBJ(Player(i), PLAYER_STATE_RESOURCE_LUMBER, 6000)
        endif
        set i=i + 1
    endloop
   
    
    call SetBools()
    call TriggerExecute(gg_trg_CityNearWater2)
    // Данные ИИшки
    // Таймеры ИИ
    
    call StartTimerBJ(udg_TimerSmall, false, 1.11)
    call StartTimerBJ(udg_TimerSmall2, false, 2.12)
    call StartTimerBJ(udg_TimerSmall3, false, 3.13)
    call StartTimerBJ(udg_TimerSmall4, false, 4.14)
    call StartTimerBJ(udg_AiTimerStrateg, true, 15.15)
endfunction

