//===========================================================================
// Trigger: Page1
//===========================================================================
function Trig_Page1_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0I1'
endfunction

function Trig_Page1_Actions takes nothing returns nothing
    call UnitAddAbilityBJ('A0HZ', GetTriggerUnit()) // 2 c
    call UnitRemoveAbilityBJ('A0I1', GetTriggerUnit()) // 1 c
    
    

    
    
    
    call UnitAddAbilityBJ('A02A', GetTriggerUnit()) // Альянс
    call UnitAddAbilityBJ('A0YV', GetTriggerUnit()) // Horde
    call UnitAddAbilityBJ('A0HV', GetTriggerUnit()) // Plet
    call UnitAddAbilityBJ('A0HL', GetTriggerUnit()) // Night Elves
    
    call UnitAddAbilityBJ('A0HQ', GetTriggerUnit()) // Blood Elves 
    call UnitAddAbilityBJ('A14O', GetTriggerUnit()) // Nags 
    call UnitAddAbilityBJ('A0OK', GetTriggerUnit()) // Illidary 
    call UnitAddAbilityBJ('A0MY', GetTriggerUnit()) // Legion 
    call UnitAddAbilityBJ('A0HS', GetTriggerUnit()) // Draeneys 
    
    
    
    
    
    call UnitRemoveAbilityBJ('A0QN', GetTriggerUnit()) // Elems
    call UnitRemoveAbilityBJ('A0HT', GetTriggerUnit()) // Nerubs
    call UnitRemoveAbilityBJ('A0QQ', GetTriggerUnit()) // Argwinol (Ent)
    
    call UnitRemoveAbilityBJ('A0RQ', GetTriggerUnit()) // Dragons
    call UnitRemoveAbilityBJ('A0J7', GetTriggerUnit()) // Ogres
    call UnitRemoveAbilityBJ('A1HA', GetTriggerUnit()) // Cult of Damned
    
    
    call UnitRemoveAbilityBJ('A1JN', GetTriggerUnit()) // HordeW2
    call UnitRemoveAbilityBJ('A0HW', GetTriggerUnit()) // Faceless

endfunction

//===========================================================================
function InitTrig_Page1 takes nothing returns nothing
    set gg_trg_Page1=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Page1, EVENT_PLAYER_UNIT_SPELL_ENDCAST)
    call TriggerAddCondition(gg_trg_Page1, Condition(function Trig_Page1_Conditions))
    call TriggerAddAction(gg_trg_Page1, function Trig_Page1_Actions)
endfunction


