//===========================================================================
// Trigger: EndBranch
//
// Закрывает дальнейшее общее обучение
//===========================================================================
function EndBranch takes player p returns nothing

    //New Allies
    call SetPlayerTechMaxAllowed(p, 'R0HS', 0)
    call SetPlayerTechMaxAllowed(p, 'R0H5', 0)
    call SetPlayerTechMaxAllowed(p, 'R0H8', 0)
    call SetPlayerTechMaxAllowed(p, 'R0HB', 0)
    
    //Old allies
    call SetPlayerTechMaxAllowed(p, 'R0HQ', 0)
    call SetPlayerTechMaxAllowed(p, 'R0HV', 0)
    call SetPlayerTechMaxAllowed(p, 'R0H9', 0)
    call SetPlayerTechMaxAllowed(p, 'R0HD', 0)
    
    //Human
    call SetPlayerTechMaxAllowed(p, 'R0HR', 0)
    call SetPlayerTechMaxAllowed(p, 'R0H6', 0)
    call SetPlayerTechMaxAllowed(p, 'R0HA', 0)
    call SetPlayerTechMaxAllowed(p, 'R0H7', 0)
  

endfunction

