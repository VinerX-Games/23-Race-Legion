    set gg_trg_GeneralRegen=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_GeneralRegen, EVENT_PLAYER_HERO_SKILL)
    call TriggerAddCondition(gg_trg_GeneralRegen, Condition(function Trig_GeneralRegen_Conditions))
    call TriggerAddAction(gg_trg_GeneralRegen, function Trig_GeneralRegen_Actions)
endfunction

