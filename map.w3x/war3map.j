    if ( ( GetUnitAbilityLevelSwapped('A0AR', GetAttacker()) == 1 ) ) then
        return true
    endif
    if ( ( GetUnitAbilityLevelSwapped('A0AR', GetAttacker()) == 2 ) ) then
        return true
    endif
    if ( ( GetUnitAbilityLevelSwapped('A0AR', GetAttacker()) == 3 ) ) then
        return true
    endif
    if ( ( GetUnitAbilityLevelSwapped('A0AR', GetAttacker()) == 4 ) ) then
        return true
    endif
    if ( ( GetUnitAbilityLevelSwapped('A0AR', GetAttacker()) == 5 ) ) then
        return true
