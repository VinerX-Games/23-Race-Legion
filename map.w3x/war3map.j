        endloop
    endif
    
    if GetPlayerTechCount(p, 'R0HH', true) < 1 then
        //High eldf sorc
        set b=0
        set i=2
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='h0KV'
            
            set b=b + 1
