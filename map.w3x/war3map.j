//===========================================================================
// Trigger: PosadkaDal2
//===========================================================================
function Trig_PosadkaDal_Conditions takes nothing returns boolean
    //call DisplayTextToPlayer(Player(0),0,0,"Тест Условие ")
    set udg_LocalPlayer=GetOwningPlayer(GetTriggerUnit())
    return GetSpellAbilityId() == AbilityDown and CheckPosition(GetSpellTargetX() , GetSpellTargetY() , 25) and CheckNearCapitals(GetTriggerUnit())
    
    //return ( GetIssuedOrderId()==OrderId("root") or GetIssuedOrderId()==OrderId("unroot") ) and GetUnitTypeId(GetTriggerUnit())=='e00C'
endfunction


function Trig_PosadkaDal_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local unit u2= CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'n063', GetUnitX(u), GetUnitY(u) - 65, 0.00)
    call SetUnitMoveSpeed(u, 0.0)
    call SaveUnitHandle(Hash, StringHash("Dalaran"), 1, u2)
    
    
    //Пора упасть
    //call DisplayTextToPlayer(Player(0),0,0,"Тест - посадка"+R2S(GetUnitMoveSpeed(u)))
    call BlzSetUnitRealFieldBJ(u, UNIT_RF_FLY_HEIGHT, - 200.00)
    call SetUnitFlyHeightBJ(u, - 200, 55.00)
    call UnitAddAbility(u, 'A1M6')
    call UnitAddAbility(u, 'A1GE')
    call BlzSetUnitRealFieldBJ(u, UNIT_RF_TURN_RATE, 0.00)
   
    call UnitAddAbility(u, AbilityAp)
    call BlzStartUnitAbilityCooldown(u, AbilityAp, 15)
    call UnitRemoveAbility(u, AbilityDown)
    
    
    
    call ShowUnit(gg_unit_n003_0588, true)
    
    //call UnitRemoveAbilityBJ( 'A1F3', u )
    //call UnitAddAbility(u,'A0HY')
    
    call WaygateActivate(gg_unit_n003_0588, true)
    call WaygateActivate(u2, true)
    call MoveRectTo(gg_rct_DalaranOut, GetUnitX(u), GetUnitY(u))
    call WaygateSetDestination(gg_unit_n003_0588, GetRectCenterX(gg_rct_DalaranOut), GetRectCenterY(gg_rct_DalaranOut))
    call WaygateSetDestination(u2, GetRectCenterX(gg_rct_DalaranIn), GetRectCenterY(gg_rct_DalaranIn))
    call WaygateActivate(u2, true)
    call WaygateActivate(gg_unit_n003_0588, true)
    set u2=null
    set u=null
endfunction

//===========================================================================
function InitTrig_PosadkaDal2 takes nothing returns nothing
    set gg_trg_PosadkaDal2=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_PosadkaDal2, EVENT_PLAYER_UNIT_SPELL_EFFECT)

    call TriggerAddCondition(gg_trg_PosadkaDal2, Condition(function Trig_PosadkaDal_Conditions))
    call TriggerAddAction(gg_trg_PosadkaDal2, function Trig_PosadkaDal_Actions)
endfunction


