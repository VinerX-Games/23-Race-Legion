function InitTrig_DeadRessurected takes nothing returns nothing
    set gg_trg_DeadRessurected=CreateTrigger()
    call TriggerAddCondition(gg_trg_DeadRessurected, Condition(function Trig_DeadRessurected_Conditions))
    call TriggerAddAction(gg_trg_DeadRessurected, function Trig_DeadRessurected_Actions)
endfunction


