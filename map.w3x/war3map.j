function InitTrig_AttackedAI takes nothing returns nothing
    set gg_trg_AttackedAI=CreateTrigger()
    call DisableTrigger(gg_trg_AttackedAI)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_AttackedAI, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_AttackedAI, Condition(function Trig_AttackedAI_Conditions))
    call TriggerAddAction(gg_trg_AttackedAI, function Trig_AttackedAI_Actions)
endfunction


