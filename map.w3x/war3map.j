    if ( not ( GetResearched() == 'R0BL' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Klap_Klap_War_Shield_Actions takes nothing returns nothing
    call SetPlayerTechMaxAllowedSwap('R0BK', 0, GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerTechMaxAllowedSwap('R0BN', 1, GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerTechMaxAllowedSwap('R0BO', 1, GetOwningPlayer(GetTriggerUnit()))
endfunction

//===========================================================================
function InitTrig_Klap_Klap_War_Shield takes nothing returns nothing
    set gg_trg_Klap_Klap_War_Shield=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Klap_Klap_War_Shield, EVENT_PLAYER_UNIT_RESEARCH_FINISH)
    call TriggerAddCondition(gg_trg_Klap_Klap_War_Shield, Condition(function Trig_Klap_Klap_War_Shield_Conditions))
    call TriggerAddAction(gg_trg_Klap_Klap_War_Shield, function Trig_Klap_Klap_War_Shield_Actions)
endfunction

