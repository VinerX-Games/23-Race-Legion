//===========================================================================
// Trigger: StartUlt
//===========================================================================
function Trig_StartUlt_Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'MIMH' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() == 'MIM6' ) ) then
        return false
    endif
    return true
endfunction

function Trig_StartUlt_Conditions takes nothing returns boolean
    if ( not Trig_StartUlt_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_StartUlt_Func001Func001C takes nothing returns boolean
    if ( not ( GetPlayerState(GetTriggerPlayer(), PLAYER_STATE_RESOURCE_GOLD) >= 8000 ) ) then
        return false
    endif
    if ( not ( GetPlayerState(GetTriggerPlayer(), PLAYER_STATE_RESOURCE_LUMBER) >= 8000 ) ) then
        return false
    endif
    if ( not ( CountLivingPlayerUnitsOfTypeId('mim1', GetTriggerPlayer()) < 2 ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('MIM6', GetTriggerUnit()) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_StartUlt_Func001C takes nothing returns boolean
    if ( not ( GetPlayerState(GetTriggerPlayer(), PLAYER_STATE_RESOURCE_GOLD) >= 8000 ) ) then
        return false
    endif
    if ( not ( GetPlayerState(GetTriggerPlayer(), PLAYER_STATE_RESOURCE_LUMBER) >= 8000 ) ) then
        return false
    endif
    if ( not ( CountLivingPlayerUnitsOfTypeId('mim1', GetTriggerPlayer()) < 1 ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('MIM6', GetTriggerUnit()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_StartUlt_Actions takes nothing returns nothing
    if ( Trig_StartUlt_Func001C() ) then
        call SetPlayerStateBJ(GetTriggerPlayer(), PLAYER_STATE_RESOURCE_GOLD, ( GetPlayerState(GetTriggerPlayer(), PLAYER_STATE_RESOURCE_GOLD) - 8000 ))
        call SetPlayerStateBJ(GetTriggerPlayer(), PLAYER_STATE_RESOURCE_LUMBER, ( GetPlayerState(GetTriggerPlayer(), PLAYER_STATE_RESOURCE_LUMBER) - 8000 ))
        call UnitAddAbilityBJ('MIM4', GetTriggerUnit())
        call SetUnitAbilityLevelSwapped('MIM4', GetTriggerUnit(), GetUnitAbilityLevelSwapped('MIM6', GetTriggerUnit()))
        call BlzUnitHideAbility(GetTriggerUnit(), 'MIM4', false)
        call SetUnitAnimationWithRarity(GetTriggerUnit(), "Attack spell", RARITY_FREQUENT)
        call PauseUnitBJ(true, GetTriggerUnit())
        call TriggerSleepAction(50.00)
        call PauseUnitBJ(false, GetTriggerUnit())
        call IssueImmediateOrderBJ(GetTriggerUnit(), "stomp")
    else
        if ( Trig_StartUlt_Func001Func001C() ) then
            call SetPlayerStateBJ(GetTriggerPlayer(), PLAYER_STATE_RESOURCE_GOLD, ( GetPlayerState(GetTriggerPlayer(), PLAYER_STATE_RESOURCE_GOLD) - 8000 ))
            call SetPlayerStateBJ(GetTriggerPlayer(), PLAYER_STATE_RESOURCE_LUMBER, ( GetPlayerState(GetTriggerPlayer(), PLAYER_STATE_RESOURCE_LUMBER) - 8000 ))
            call UnitAddAbilityBJ('MIM4', GetTriggerUnit())
            call SetUnitAbilityLevelSwapped('MIM4', GetTriggerUnit(), GetUnitAbilityLevelSwapped('MIM6', GetTriggerUnit()))
            call BlzUnitHideAbility(GetTriggerUnit(), 'MIM4', false)
            call PauseUnitBJ(true, GetTriggerUnit())
            call TriggerSleepAction(50.00)
            call PauseUnitBJ(false, GetTriggerUnit())
            call IssueImmediateOrderBJ(GetTriggerUnit(), "stomp")
        else
            call DoNothing()
        endif
    endif
endfunction

//===========================================================================
function InitTrig_StartUlt takes nothing returns nothing
    set gg_trg_StartUlt=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_StartUlt, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_StartUlt, Condition(function Trig_StartUlt_Conditions))
    call TriggerAddAction(gg_trg_StartUlt, function Trig_StartUlt_Actions)
endfunction

