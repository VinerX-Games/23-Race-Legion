function InitTrig_Pole_Astrala_Demons_Copy_Copy_2 takes nothing returns nothing
    set gg_trg_Pole_Astrala_Demons_Copy_Copy_2=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Pole_Astrala_Demons_Copy_Copy_2, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Pole_Astrala_Demons_Copy_Copy_2, Condition(function Trig_Pole_Astrala_Demons_Copy_Copy_2_Conditions))
    call TriggerAddAction(gg_trg_Pole_Astrala_Demons_Copy_Copy_2, function Trig_Pole_Astrala_Demons_Copy_Copy_2_Actions)
endfunction

//===========================================================================
// Trigger: SargerasReturnDamage
//===========================================================================
function Trig_SargerasReturnDamage_Conditions takes nothing returns boolean
    return GetUnitAbilityLevel(GetEventDamageSource(), 'A0MQ') > 0
endfunction

function Trig_SargerasReturnDamage_Actions takes nothing returns nothing
    local real hp_factor= 1 - GetUnitLifePercent(GetTriggerUnit())
    local real damage= GetEventDamage() * GetUnitAbilityLevel(GetEventDamageSource(), 'A0MQ') * 0.03 * ( 1 + hp_factor )
    call UnitDamageTarget(GetEventDamageSource(), GetTriggerUnit(), damage, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_DEATH, WEAPON_TYPE_WHOKNOWS)
    
endfunction

//===========================================================================
function InitTrig_SargerasReturnDamage takes nothing returns nothing
    set gg_trg_SargerasReturnDamage=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_SargerasReturnDamage, EVENT_PLAYER_UNIT_DAMAGED)
    call TriggerAddCondition(gg_trg_SargerasReturnDamage, Condition(function Trig_SargerasReturnDamage_Conditions))
    call TriggerAddAction(gg_trg_SargerasReturnDamage, function Trig_SargerasReturnDamage_Actions)
endfunction


