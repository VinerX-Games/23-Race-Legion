//===========================================================================
// Trigger: TechStart
//===========================================================================
function Trig_TechStart_Func001C takes nothing returns boolean
    if ( ( GetResearched() == 'R09C' ) ) then
        return true
    endif
    if ( ( GetResearched() == 'R09D' ) ) then
        return true
    endif
    if ( ( GetResearched() == 'R09E' ) ) then
        return true
    endif
    if ( ( GetResearched() == 'R09F' ) ) then
        return true
    endif
    return false
endfunction

function Trig_TechStart_Conditions takes nothing returns boolean
    if ( not Trig_TechStart_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_TechStart_Func002C takes nothing returns boolean
    if ( not ( udg_TechResearched[GetConvertedPlayerId(GetTriggerPlayer())] == udg_MAX_TECH_RESEARCHES ) ) then
        return false
    endif
    return true
endfunction

function Trig_TechStart_Actions takes nothing returns nothing
    if ( Trig_TechStart_Func002C() ) then
        call EnableTrigger(gg_trg_TechLoopedCancel)
        loop
        call IssueImmediateOrderById(GetTriggerUnit(), 851976)
        exitwhen udg_TechId == GetResearched()
        endloop
        call DisableTrigger(gg_trg_TechLoopedCancel)
    else
    endif
endfunction

//===========================================================================
function InitTrig_TechStart takes nothing returns nothing
    set gg_trg_TechStart=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_TechStart, EVENT_PLAYER_UNIT_RESEARCH_START)
    call TriggerAddCondition(gg_trg_TechStart, Condition(function Trig_TechStart_Conditions))
    call TriggerAddAction(gg_trg_TechStart, function Trig_TechStart_Actions)
endfunction

