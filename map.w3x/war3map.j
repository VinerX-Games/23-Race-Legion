//===========================================================================
// Trigger: MeatDeal
//===========================================================================
function Trig_MeatDeal_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'cDa5'
endfunction

function Trig_Untitled_Trigger_003_Func001001003 takes nothing returns boolean
    return GetUnitAbilityLevel(GetFilterUnit(), 'cDa6') > 0 and GetOwningPlayer(GetFilterUnit()) == udg_LocalPlayer and UnitAlive(GetFilterUnit())
endfunction

function Trig_MeatDeal_Actions takes nothing returns nothing
    local boolexpr Boolexpr
    local unit caster= GetTriggerUnit()
    local unit target
    local unit eachUnit
    local group g= CreateGroup()
    local real healthMax
    local real healthCurrent
    local integer id
    local player p= GetOwningPlayer(caster)
    local real Efficiency= 0.5 + GetPlayerTechCount(p, 'cDR5', true) * 0.05
    local integer count= 0
    set udg_LocalPlayer=p
    set Boolexpr=Condition(function Trig_Untitled_Trigger_003_Func001001003)
    call GroupEnumUnitsInRangeCounted(g, GetSpellTargetX(), GetSpellTargetY(), 275, Boolexpr, 12)
    
    //if target == null then
        set target=FirstOfGroup(g)
        set id=GetUnitTypeId(target)
    //endif 
    

    if target == null then
        
        call DestroyGroup(g)
        call DestroyBoolExpr(Boolexpr)
        set Boolexpr=null
        set g=null
        set caster=null
        set target=null
        set eachUnit=null
        return
    else
        set healthMax=GetUnitState(target, UNIT_STATE_MAX_LIFE) * Efficiency
        set healthCurrent=GetUnitState(target, UNIT_STATE_LIFE) * Efficiency
        call GroupRemoveUnit(g, target)
        
        loop
            set eachUnit=FirstOfGroup(g)
            exitwhen eachUnit == null or healthMax >= 5000
            call GroupRemoveUnit(g, eachUnit)
            set healthMax=healthMax + GetUnitState(eachUnit, UNIT_STATE_MAX_LIFE) * Efficiency
            set healthCurrent=healthCurrent + GetUnitState(eachUnit, UNIT_STATE_LIFE) * Efficiency
            set count=count + 1
            if eachUnit != target then
                call DelCountDis(eachUnit , GetPlayerId(GetOwningPlayer(eachUnit)))
                
                call RemoveUnit(eachUnit)
                call RemoveEffectTimed(AddSpecialEffect("Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl", GetUnitX(eachUnit), GetUnitY(eachUnit)) , 2)
            endif
            
        endloop
        
        
        
        if healthMax > 5000 then //Титан из плоти
            if id != 'cD00' then
                set target=ReplaceUnit2(target , 'cD00' , bj_UNIT_STATE_METHOD_RELATIVE)
            endif
            
        
        elseif healthMax > 2500 and id != 'cD09' then //Мясной голем
            
            if id != 'cD09' or id != 'cD14' then
                if Random(1 , 2) then
                    set target=ReplaceUnit2(target , 'cD14' , bj_UNIT_STATE_METHOD_RELATIVE)
                else
                    set target=ReplaceUnit2(target , 'cD09' , bj_UNIT_STATE_METHOD_RELATIVE)
                endif
                
            endif
            
        elseif healthMax > 1000 and id != 'cD09' then //Поганище
            
            if id != 'cD10' then
                set target=ReplaceUnit2(target , 'cD10' , bj_UNIT_STATE_METHOD_RELATIVE)
            endif
        else
            
            call BlzUnitCancelTimedLife(target)
            
            //call UnitApplyTimedLife( target, 'BTLF', 60)
        
        endif
        
        
        //call UnitRemoveType(target, UNIT_TYPE_SUMMONED)
        call RemoveEffectTimed(AddSpecialEffectTarget("NewEffects/Soul Discharge.mdx", target, "origin") , 2)
        call BlzSetUnitMaxHP(target, IMinBJ(R2I(healthMax), 8000))
        call SetUnitState(target, UNIT_STATE_LIFE, healthCurrent)
        //call AddCountDis(target,GetPlayerId(GetOwningPlayer(target)))
    endif
    
    call DestroyBoolExpr(Boolexpr)
    set Boolexpr=null
    call DestroyGroup(g)
    set g=null
    set caster=null
    set target=null
    set eachUnit=null
endfunction

//===========================================================================
function InitTrig_MeatDeal takes nothing returns nothing
    set gg_trg_MeatDeal=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_MeatDeal, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_MeatDeal, Condition(function Trig_MeatDeal_Conditions))
    call TriggerAddAction(gg_trg_MeatDeal, function Trig_MeatDeal_Actions)
endfunction


//===========================================================================
// Trigger: BoneDeal
//===========================================================================
function Trig_BoneDeal_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'cDar'
endfunction

function BoneCheck takes nothing returns boolean
    return GetUnitAbilityLevel(GetFilterUnit(), 'cDat') > 0 and GetOwningPlayer(GetFilterUnit()) == udg_LocalPlayer and UnitAlive(GetFilterUnit())
endfunction

function Trig_BoneDeal_Actions takes nothing returns nothing
    local boolexpr Boolexpr
    local unit caster= GetTriggerUnit()
    local unit target
    local unit eachUnit
    local group g= CreateGroup()
    local real healthMax
    local real healthCurrent
    local integer id
    local player p= GetOwningPlayer(caster)
    local real Efficiency= 0.5 + GetPlayerTechCount(p, 'R0JH', true) * 0.05
    local integer count= 0
    
    set udg_LocalPlayer=p
    set Boolexpr=Condition(function BoneCheck)
    call GroupEnumUnitsInRangeCounted(g, GetSpellTargetX(), GetSpellTargetY(), 275, Boolexpr, 12)
    
    //if target == null then
        set target=FirstOfGroup(g)
        set id=GetUnitTypeId(target)
    //endif 
    

    if target == null then
        
        call DestroyGroup(g)
        call DestroyBoolExpr(Boolexpr)
        set Boolexpr=null
        set g=null
        set caster=null
        set target=null
        set eachUnit=null
        return
    else
        set healthMax=GetUnitState(target, UNIT_STATE_MAX_LIFE) * Efficiency
        set healthCurrent=GetUnitState(target, UNIT_STATE_LIFE) * Efficiency
        call GroupRemoveUnit(g, target)
        
        loop
            set eachUnit=FirstOfGroup(g)
            exitwhen eachUnit == null or healthMax >= 3500
            call GroupRemoveUnit(g, eachUnit)
            set healthMax=healthMax + GetUnitState(eachUnit, UNIT_STATE_MAX_LIFE) * Efficiency
            set healthCurrent=healthCurrent + GetUnitState(eachUnit, UNIT_STATE_LIFE) * Efficiency
            set count=count + 1
            if eachUnit != target then
                //call KillUnit(eachUnit)
                call DelCountDis(eachUnit , GetPlayerId(GetOwningPlayer(eachUnit)))
                call RemoveUnit(eachUnit)
                call RemoveEffectTimed(AddSpecialEffect("NewEffects/FlareStampedeMissileDeath.mdx", GetUnitX(eachUnit), GetUnitY(eachUnit)) , 2)
            endif
            
        endloop
        
        
        
        if healthMax > 2500 then //Титан из костей
            if id != 'cD23' then
                set target=ReplaceUnit2(target , 'cD23' , bj_UNIT_STATE_METHOD_RELATIVE)
                call IssueImmediateOrder(target, "Locustswarm")
            endif
            
            
        elseif healthMax > 1250 and id != 'cD09' then //Страж или привратник
            
            if id != 'cD33' or id != 'cD18' then
                if Random(1 , 2) then
                    set target=ReplaceUnit2(target , 'cD18' , bj_UNIT_STATE_METHOD_RELATIVE)
                else
                    set target=ReplaceUnit2(target , 'cD33' , bj_UNIT_STATE_METHOD_RELATIVE)
                endif
                
            endif
            
        else
            call BlzUnitCancelTimedLife(target)
            //call UnitApplyTimedLife( target, 'BTLF', 60)
        endif
        
        //call UnitRemoveType(target, UNIT_TYPE_SUMMONED)
        call RemoveEffectTimed(AddSpecialEffectTarget("NewEffects/Soul Discharge Purple.mdx", target, "origin") , 2)
        call BlzSetUnitMaxHP(target, IMinBJ(R2I(healthMax), 3500))
        call SetUnitState(target, UNIT_STATE_LIFE, healthCurrent)
        //call UnitAddType(target, UNIT_TYPE_SUMMONED)
        //call AddCountDis(target,GetPlayerId(GetOwningPlayer(target)))
    endif
    
    call DestroyBoolExpr(Boolexpr)
    set Boolexpr=null
    call DestroyGroup(g)
    set g=null
    set caster=null
    set target=null
    set eachUnit=null
endfunction

//===========================================================================
function InitTrig_BoneDeal takes nothing returns nothing
    set gg_trg_BoneDeal=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_BoneDeal, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_BoneDeal, Condition(function Trig_BoneDeal_Conditions))
    call TriggerAddAction(gg_trg_BoneDeal, function Trig_BoneDeal_Actions)
endfunction


