//===========================================================================
// Trigger: TrueHorde
//===========================================================================
function Trig_TrueHorde_Conditions takes nothing returns boolean
    return GetResearched() == 'R0E9'
endfunction

function NoNeORc takes nothing returns boolean
    local integer id= GetUnitTypeId(GetFilterUnit())
    return ( id == 'ospw' or id == 'o026' or id == 'o025' or id == 'o024' or id == 'o023' or id == 'o01G' or id == 'o01L' or id == 'o01F' or id == 'o01H' or id == 'otbk' )

endfunction

function Trig_TrueHorde_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local player p= GetOwningPlayer(u)
    local integer pi= GetPlayerId(p)
    local group g= CreateGroup()
    set udg_HordeMainPrice[pi]=udg_HordeMainPrice[pi] + 5
    set udg_HordeElitePrice[pi]=udg_HordeElitePrice[pi] - 5


    call ChangeEliteUnitsNow(p , pi)
    
    
    //End other races
    set g=CreateGroup()
    set udg_Boolexpr=Condition(function NoNeORc)
    call GroupEnumUnitsOfPlayer(g, p, udg_Boolexpr)
    loop
        set u=FirstOfGroup(g)
        exitwhen u == null
        
        call KillUnit(u)
        
        call GroupRemoveUnit(g, u)
        set u=null
    endloop
    
    
    
    // Бонусы бладов -
    if GetPlayerTechCount(p, 'R0D2', true) == 1 then
        set udg_HordeMainPrice[pi]=udg_HordeMainPrice[pi] - 3
        set udg_HordeLandPrice[pi]=udg_HordeLandPrice[pi] + 5
        
    endif
    call SetPlayerTechResearched(p, 'R0D2', 2)
     
    
    // Бонусы отреков  -
    if GetPlayerTechCount(p, 'R0D2', true) == 1 then
        set udg_HordeMainPrice[pi]=udg_HordeMainPrice[pi] - 3
        set udg_HordeLandPrice[pi]=udg_HordeLandPrice[pi] + 5
        
    endif
    call SetPlayerTechResearched(p, 'R0D3', 2)
    
    
    // Бонусы пандаренов  -
    if GetPlayerTechCount(p, 'R0E0', true) == 1 then
        set udg_HordeMainPrice[pi]=udg_HordeMainPrice[pi] - 2
        set udg_HordeLandPrice[pi]=udg_HordeLandPrice[pi] + 2
        set udg_HordeElitePrice[pi]=udg_HordeElitePrice[pi] + 1
        
    endif
    call SetPlayerTechResearched(p, 'R0E0', 2)
     
    
    call SetPlayerTechMaxAllowed(p, 'R0EA', 1)
    call SetPlayerTechResearched(p, 'R0E7', 1) //Разрешает дд
    call DestroyGroup(g)
    
    
    
    
    call ChangeLandUnitsNow(p , pi)
    call ChangeMagicUnitsNow(p , pi)
    call ChangeTechUnitsNow(p , pi)
    call ChangeEliteUnitsNow(p , pi)
    
    set p=null
    set u=null
    
endfunction

//===========================================================================
function InitTrig_TrueHorde takes nothing returns nothing
    set gg_trg_TrueHorde=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_TrueHorde, EVENT_PLAYER_UNIT_RESEARCH_FINISH)
    call TriggerAddCondition(gg_trg_TrueHorde, Condition(function Trig_TrueHorde_Conditions))
    call TriggerAddAction(gg_trg_TrueHorde, function Trig_TrueHorde_Actions)
endfunction


//===========================================================================
// Trigger: IronHorde
//===========================================================================
function Trig_IronHorde_Conditions takes nothing returns boolean
    return GetResearched() == 'R0EA'
endfunction


function Trig_IronHorde_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local player p= GetOwningPlayer(u)
    local integer pi= GetPlayerId(p)

    set udg_HordeMainPrice[pi]=udg_HordeMainPrice[pi] + 5
    set udg_HordeElitePrice[pi]=udg_HordeElitePrice[pi] - 8
    set udg_HordeNavyPrice[pi]=udg_HordeNavyPrice[pi] - 3

    call ChangeEliteUnitsNow(p , pi)
    call ChangeNavyUnitsNow(p , pi)
    
    //Old units
    call SetPlayerTechMaxAllowed(p, 'ogru', 0)
    call SetPlayerTechMaxAllowed(p, 'ohun', 0)
    call SetPlayerTechMaxAllowed(p, 'o01N', 0)
    call SetPlayerTechMaxAllowed(p, 'o01P', 0)
    //New units
    call SetPlayerTechMaxAllowed(p, 'o029', - 1)
    call SetPlayerTechMaxAllowed(p, 'o02B', - 1)
    call SetPlayerTechMaxAllowed(p, 'h0CY', - 1)
    
    
   
    
    
    //call SetPlayerTechMaxAllowed(p,'R0E9',1)
    
    
    
    
    
    

    set p=null
    set u=null
    
endfunction

