//===========================================================================
// Trigger: Spell Dvij
//
// Создает 3 шара которые кружат вокруг героя бесконечно пока он их не потратит или умрет
// запуская их во врагов герой наносит им урон в 200 АОЕ и вешает противные бафы
// Первый выпущенный шар вешает на врагов замедление
// Второй выпущенный шар вешает на врагов хекс
// Третий выпущенный шар вешает на врагов промахи
// Не ставить перезарядку скила на 0 так как будут баги
//===========================================================================
function Trig_Spell_Dvij_Conditions takes nothing returns boolean
    if ( not ( udg_Logika == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Spell_Dvij_Func002Func004C takes nothing returns boolean
    if ( ( IsUnitDeadBJ(udg_Caster) == true ) ) then
        return true
    endif
    if ( ( udg_HisloA[0] == 0 ) ) then
        return true
    endif
    return false
endfunction

function Trig_Spell_Dvij_Func002C takes nothing returns boolean
    if ( not Trig_Spell_Dvij_Func002Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_Spell_Dvij_Func004Func004Func002C takes nothing returns boolean
    if ( ( udg_HisloA[0] == 2 ) ) then
        return true
    endif
    if ( ( udg_HisloA[0] == 3 ) ) then
        return true
    endif
    if ( ( udg_HisloA[0] == 4 ) ) then
        return true
    endif
    return false
endfunction

function Trig_Spell_Dvij_Func004Func004C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Dummy[0]) == true ) ) then
        return false
    endif
    if ( not Trig_Spell_Dvij_Func004Func004Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Spell_Dvij_Func004Func005Func003C takes nothing returns boolean
    if ( ( udg_HisloA[0] == 3 ) ) then
        return true
    endif
    if ( ( udg_HisloA[0] == 4 ) ) then
        return true
    endif
    return false
endfunction

function Trig_Spell_Dvij_Func004Func005C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Dummy[1]) == true ) ) then
        return false
    endif
    if ( not Trig_Spell_Dvij_Func004Func005Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_Spell_Dvij_Func004Func006C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Dummy[2]) == true ) ) then
        return false
    endif
    if ( not ( udg_HisloA[0] == 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Spell_Dvij_Func004Func007Func002Func005Func002Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(udg_Caster)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAlly(GetEnumUnit(), GetOwningPlayer(udg_Caster)) == false ) ) then
        return false
    endif
    if ( not ( IsUnitDeadBJ(GetEnumUnit()) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Spell_Dvij_Func004Func007Func002Func005Func002A takes nothing returns nothing
    if ( Trig_Spell_Dvij_Func004Func007Func002Func005Func002Func001C() ) then
        call GroupAddUnitSimple(GetEnumUnit(), udg_Group)
        call UnitDamageTargetBJ(udg_Caster, GetEnumUnit(), ( 100.00 * I2R(GetUnitAbilityLevelSwapped('A1BN', udg_Caster)) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL)
        set udg_To4kaAOE=GetUnitLoc(GetEnumUnit())
        call CreateNUnitsAtLoc(1, 'h0MK', GetOwningPlayer(udg_Caster), udg_To4kaAOE, bj_UNIT_FACING)
        set udg_Dummy[4]=GetLastCreatedUnit()
        call IssueTargetOrderBJ(udg_Dummy[4], "slow", GetEnumUnit())
        call UnitApplyTimedLifeBJ(1.50, 'BTLF', udg_Dummy[4])
        set udg_Dummy[4]=null
        call RemoveLocation(udg_To4kaAOE)
    else
    endif
endfunction

