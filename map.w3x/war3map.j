    return GetBooleanOr((GetUnitTypeId(GetFilterUnit()) == 'e01H'), (GetBooleanOr((GetUnitTypeId(GetFilterUnit()) == 'e020'), (GetUnitTypeId(GetFilterUnit()) == 'e021')))) // INLINED!!
endfunction

