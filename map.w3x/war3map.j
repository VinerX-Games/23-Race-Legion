    call CreateNUnitsAtLoc(1, 'H0BN', GetOwningPlayer(GetTriggerUnit()), udg_LocalPosition2, bj_UNIT_FACING)
    set udg_LocalUnit2=GetLastCreatedUnit()
    call TriggerExecute(gg_trg_ToKill2)
    call UnitAddAbilityBJ('AUdc', GetLastCreatedUnit())
    call SetUnitManaBJ(GetLastCreatedUnit(), 1111111.00)
    call SetUnitAbilityLevelSwapped('AUdc', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0WD', GetTriggerUnit()))
    call IssueTargetOrderBJ(GetLastCreatedUnit(), "deathcoil", GetEnumUnit())
endfunction

