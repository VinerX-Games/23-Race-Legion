//===========================================================================
// Trigger: GazloySpellheals
//===========================================================================
function Trig_GazloySpellheals_Conditions takes nothing returns boolean
    
    return GetUnitAbilityLevel(GetEventDamageSource(), 'A1KK') > 0 and IsPlayerEnemy(GetOwningPlayer(GetEventDamageSource()), GetOwningPlayer(GetTriggerUnit()))
    
    
    
endfunction

function Trig_GazloySpellheals_Actions takes nothing returns nothing
    local unit u= GetEventDamageSource()
    local integer level= GetUnitAbilityLevel(u, 'A1KK')
    local real damage= GetEventDamage()
    local effect e= AddSpecialEffectTargetUnitBJ("Chest", u, "Abilities\\Spells\\Items\\VampiricPotion\\VampPotionCaster.mdl")
    call SetUnitState(u, UNIT_STATE_LIFE, GetUnitState(u, UNIT_STATE_LIFE) + damage * ( 0.01 * level ))
  
    
    set u=null
    call DestroyEffect(e)
    set e=null
endfunction

//===========================================================================
function InitTrig_GazloySpellheals takes nothing returns nothing
    set gg_trg_GazloySpellheals=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_GazloySpellheals, EVENT_PLAYER_UNIT_DAMAGED)
    call TriggerAddCondition(gg_trg_GazloySpellheals, Condition(function Trig_GazloySpellheals_Conditions))
    call TriggerAddAction(gg_trg_GazloySpellheals, function Trig_GazloySpellheals_Actions)
endfunction


//===========================================================================
// Trigger: FarmBuildG
//===========================================================================
function Gtiers takes integer pi returns nothing
    local integer phash= Gfarm
    local integer puhash= Gtier
    local integer count= LoadInteger(Hash, pi, phash)
    local unit u= LoadUnitHandle(Hash, pi, puhash)
    local integer id= GetUnitTypeId(u)
   
    if count < 6 then
        call KillUnit(u)
    elseif count < 12 then
        call KillUnit(u)
        set u=CreateUnit(Player(pi), 'h001', 0, 0, 0.0)
    else
        call KillUnit(u)
        set u=CreateUnit(Player(pi), 'h0P6', 0, 0, 0.0)
    endif

    call SaveUnitHandle(Hash, pi, puhash, u)
    set u=null
endfunction

function Trig_FarmBuildG_Conditions takes nothing returns boolean
    set gUnit=GetTriggerUnit()
    set gInt=GetUnitTypeId(gUnit)
    set gPi=GetPlayerId(GetOwningPlayer(gUnit))
    return gInt == 'h076' // Lab
endfunction

function Trig_FarmBuildG_Actions takes nothing returns nothing
    call ChangeObjectsCount(gPi , Gfarm , 1)
    call Gtiers(gPi)
endfunction

//===========================================================================
function InitTrig_FarmBuildG takes nothing returns nothing
    set gg_trg_FarmBuildG=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_FarmBuildG, EVENT_PLAYER_UNIT_CONSTRUCT_FINISH)
    call TriggerAddCondition(gg_trg_FarmBuildG, Condition(function Trig_FarmBuildG_Conditions))
    call TriggerAddAction(gg_trg_FarmBuildG, function Trig_FarmBuildG_Actions)
endfunction


