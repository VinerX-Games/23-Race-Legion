function AiPoitsSet takes nothing returns nothing
    set PointForAi[0]=Location(- 18782, 469)
    set PointForAi[1]=Location(- 27743, 548)
    set PointForAi[2]=Location(- 26040, - 6528)
    set PointForAi[3]=Location(- 16827, - 5185)
    set PointForAi[4]=Location(- 16827, - 5185)
    //set PointForAi[5]=Location(-18782,469)
endfunction

function RandomAiPlace takes nothing returns nothing
    local integer i= 0
    local integer c= 0
    local location array b

    set i=0
    loop
        exitwhen i >= 15
        
        if PointForAi[i] != null then
            set b[c]=PointForAi[i]
            set PointForAi[i]=null
            set c=c + 1
        endif
        set i=i + 1
    endloop
    // Получил массив локаций б
    
    set i=GetRandomInt(0, c)
    set udg_LocalPoint=b[i]
    set i=0
    loop
        exitwhen i >= 15
        set b[i]=null
    
        set i=i + 1
    endloop
    

endfunction
