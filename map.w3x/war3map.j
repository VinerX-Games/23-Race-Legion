//===========================================================================
// Trigger: IllyFire
//===========================================================================
function Trig_IllyFire_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0NJ' ) ) then
        return false
    endif
    return true
endfunction

function Trig_IllyFire_Func001Func001Func002Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0NJ', GetTriggerUnit()) == 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_IllyFire_Func001Func001Func002C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0NJ', GetTriggerUnit()) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_IllyFire_Func001Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0NJ', GetTriggerUnit()) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_IllyFire_Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0NJ', GetTriggerUnit()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_IllyFire_Actions takes nothing returns nothing
    if ( Trig_IllyFire_Func001C() ) then
        call UnitAddAbilityBJ('A0NO', GetTriggerUnit())
        call UnitAddAbilityBJ('A0NM', GetTriggerUnit())
        call TriggerSleepAction(15.00)
        call UnitRemoveAbilityBJ('A0NO', GetTriggerUnit())
        call UnitRemoveAbilityBJ('A0NM', GetTriggerUnit())
    else
        if ( Trig_IllyFire_Func001Func001C() ) then
            call UnitAddAbilityBJ('A0NP', GetTriggerUnit())
            call UnitAddAbilityBJ('A0NK', GetTriggerUnit())
            call TriggerSleepAction(15.00)
            call UnitRemoveAbilityBJ('A0NP', GetTriggerUnit())
            call UnitRemoveAbilityBJ('A0NK', GetTriggerUnit())
        else
            if ( Trig_IllyFire_Func001Func001Func002C() ) then
                call UnitAddAbilityBJ('A0NR', GetTriggerUnit())
                call UnitAddAbilityBJ('A0NL', GetTriggerUnit())
                call TriggerSleepAction(15.00)
                call UnitRemoveAbilityBJ('A0NR', GetTriggerUnit())
                call UnitRemoveAbilityBJ('A0NL', GetTriggerUnit())
            else
                if ( Trig_IllyFire_Func001Func001Func002Func001C() ) then
                    call UnitAddAbilityBJ('A0NQ', GetTriggerUnit())
                    call UnitAddAbilityBJ('A0NN', GetTriggerUnit())
                    call TriggerSleepAction(15.00)
                    call UnitRemoveAbilityBJ('A0NQ', GetTriggerUnit())
                    call UnitRemoveAbilityBJ('A0NN', GetTriggerUnit())
                else
                endif
            endif
        endif
    endif
endfunction

//===========================================================================
function InitTrig_IllyFire takes nothing returns nothing
    set gg_trg_IllyFire=CreateTrigger()
    call DisableTrigger(gg_trg_IllyFire)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_IllyFire, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_IllyFire, Condition(function Trig_IllyFire_Conditions))
    call TriggerAddAction(gg_trg_IllyFire, function Trig_IllyFire_Actions)
endfunction

