function Trig_Pirats_Conditions takes nothing returns boolean
    if ( not ( GetResearched() == 'R00E' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pirats_O_Copy_Func005002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h00Y' )
endfunction

function Trig_Pirats_O_Copy_Func008A takes nothing returns nothing
    call ReplaceUnit(GetEnumUnit() , 'h03L' , bj_UNIT_STATE_METHOD_RELATIVE)
endfunction

function Trig_Pirats_O_Copy_Func010002 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'h00Z' )
endfunction

function Trig_Pirats_O_Copy_Func013A takes nothing returns nothing
    call ReplaceUnit(GetEnumUnit() , 'h03K' , bj_UNIT_STATE_METHOD_RELATIVE)
endfunction

function Trig_Pirats_Actions takes nothing returns nothing
    call SetPlayerTechMaxAllowedSwap('h03L', - 1, GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerTechMaxAllowedSwap('h03K', - 1, GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerTechMaxAllowedSwap('h00Y', 0, GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerTechMaxAllowedSwap('h00Z', 0, GetOwningPlayer(GetTriggerUnit()))
    set udg_Boolexpr=Condition(function Trig_Pirats_O_Copy_Func005002)
    set udg_LocalPlayer=GetOwningPlayer(GetTriggerUnit())
    call GroupEnumUnitsOfPlayer(udg_LocalOtrad2, udg_LocalPlayer, udg_Boolexpr)
    call ForGroupBJ(udg_LocalOtrad2, function Trig_Pirats_O_Copy_Func008A)
    call GroupClear(udg_LocalOtrad2)
    set udg_Boolexpr=Condition(function Trig_Pirats_O_Copy_Func010002)
    set udg_LocalPlayer=GetOwningPlayer(GetTriggerUnit())
    call GroupEnumUnitsOfPlayer(udg_LocalOtrad2, udg_LocalPlayer, udg_Boolexpr)
    call ForGroupBJ(udg_LocalOtrad2, function Trig_Pirats_O_Copy_Func013A)
    call GroupClear(udg_LocalOtrad2)
endfunction

