        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func001Func006C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_Portal_loc1, udg_Portal_loc3) <= udg_Portal_range[udg_Portal_INDEX_TARGET] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func001A takes nothing returns nothing
    set udg_Portal_traveller=GetEnumUnit()
    set udg_Portal_INDEX_CASTER=GetUnitUserData(udg_Portal_traveller)
    set udg_Portal_INDEX_TARGET=GetUnitUserData(udg_Portal_targeted[udg_Portal_INDEX_CASTER])
    set udg_Portal_loc1=GetUnitLoc(udg_Portal_traveller)
    set udg_Portal_loc3=GetUnitLoc(udg_Portal_targeted[udg_Portal_INDEX_CASTER])
    if ( Trig_Portal_Periodic_Func001Func006C() ) then
        if ( Trig_Portal_Periodic_Func001Func006Func002C() ) then
            if ( Trig_Portal_Periodic_Func001Func006Func002Func002C() ) then
                set udg_Portal_isTeleporting[udg_Portal_INDEX_CASTER]=true
                set udg_Portal_delayFXAbil[udg_Portal_INDEX_CASTER]=udg_Portal_delayFXAbil[udg_Portal_INDEX_TARGET]
                call UnitAddAbilityBJ(udg_Portal_delayFXAbil[udg_Portal_INDEX_CASTER], udg_Portal_traveller)
            else
            endif
            set udg_Portal_delay[udg_Portal_INDEX_CASTER]=( udg_Portal_delay[udg_Portal_INDEX_CASTER] - ( 1.00 / 32.00 ) )
        else
            set udg_Portal_isTeleporting[udg_Portal_INDEX_CASTER]=false
            set udg_Portal_loc2=GetUnitLoc(udg_Portal_traveller)
            call AddSpecialEffectLocBJ(udg_Portal_loc2, udg_Portal_departureFX[udg_Portal_INDEX_TARGET])
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
            call UnitRemoveAbilityBJ(udg_Portal_delayFXAbil[udg_Portal_INDEX_CASTER], udg_Portal_traveller)
            call RemoveLocation(udg_Portal_loc2)
            set udg_Portal_loc2=GetUnitLoc(udg_Portal_portal[udg_Portal_INDEX_TARGET])
            // -------- -------- -------- -------- -------- -------- -------- -------- -------- --------
            if ( Trig_Portal_Periodic_Func001Func006Func002Func011C() ) then
                call CreateNUnitsAtLocFacingLocBJ(1, udg_Portal_missileDummy[udg_Portal_INDEX_TARGET], GetOwningPlayer(udg_Portal_traveller), udg_Portal_loc1, udg_Portal_loc2)
                set udg_Portal_dummy=GetLastCreatedUnit()
                if ( Trig_Portal_Periodic_Func001Func006Func002Func011Func003C() ) then
                    call SelectUnitAddForPlayer(udg_Portal_dummy, GetOwningPlayer(udg_Portal_traveller))
                else
                endif
                if ( Trig_Portal_Periodic_Func001Func006Func002Func011Func004C() ) then
                    call SetUnitInvulnerable(udg_Portal_dummy, false)
                else
                endif
                call IssuePointOrderLocBJ(udg_Portal_dummy, "move", udg_Portal_loc2)
                set udg_Portal_INDEX_TRAVELLER=GetUnitUserData(udg_Portal_dummy)
                set udg_Portal_missileSpeed[udg_Portal_INDEX_TRAVELLER]=0.00
                set udg_Portal_portal[udg_Portal_INDEX_TRAVELLER]=udg_Portal_portal[udg_Portal_INDEX_TARGET]
                set udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER]=udg_Portal_traveller
                call GroupAddUnitSimple(udg_Portal_dummy, udg_Portal_teleMissiles)
                call ShowUnitHide(udg_Portal_traveller)
            else
                if ( Trig_Portal_Periodic_Func001Func006Func002Func011Func012C() ) then
                    call CreateNUnitsAtLocFacingLocBJ(1, udg_Portal_missileDummy[udg_Portal_INDEX_TARGET], GetOwningPlayer(udg_Portal_traveller), udg_Portal_loc1, udg_Portal_loc2)
                    set udg_Portal_dummy=GetLastCreatedUnit()
                    if ( Trig_Portal_Periodic_Func001Func006Func002Func011Func012Func004C() ) then
                        call SelectUnitAddForPlayer(udg_Portal_dummy, GetOwningPlayer(udg_Portal_traveller))
                    else
                    endif
                    if ( Trig_Portal_Periodic_Func001Func006Func002Func011Func012Func005C() ) then
                        call SetUnitInvulnerable(udg_Portal_dummy, false)
                    else
                    endif
                    call UnitAddAbilityBJ(udg_Portal_missileFXAbil[udg_Portal_INDEX_TARGET], udg_Portal_dummy)
                    call SetUnitFlyHeightBJ(udg_Portal_dummy, udg_Portal_missileHeight[udg_Portal_INDEX_TARGET], 0.00)
                    set udg_Portal_INDEX_TRAVELLER=GetUnitUserData(udg_Portal_dummy)
                    set udg_Portal_missileSpeed[udg_Portal_INDEX_TRAVELLER]=udg_Portal_missileSpeed[udg_Portal_INDEX_TARGET]
                    set udg_Portal_portal[udg_Portal_INDEX_TRAVELLER]=udg_Portal_portal[udg_Portal_INDEX_TARGET]
                    set udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER]=udg_Portal_traveller
                    call SetUnitPathing(udg_Portal_dummy, false)
                    call GroupAddUnitSimple(udg_Portal_dummy, udg_Portal_teleMissiles)
                    call ShowUnitHide(udg_Portal_traveller)
                else
                    call RemoveLocation(udg_Portal_loc3)
                    set udg_Portal_INDEX_TRAVELLER=GetUnitUserData(udg_Portal_portal[udg_Portal_INDEX_TARGET])
                    set udg_Portal_loc3=PolarProjectionBJ(udg_Portal_loc2, GetRandomReal(0.00, udg_Portal_range[udg_Portal_INDEX_TRAVELLER]), GetRandomDirectionDeg())
                    call SetUnitPositionLoc(udg_Portal_traveller, udg_Portal_loc3)
                    set udg_Portal_loc4=GetUnitRallyPoint(udg_Portal_targeted[udg_Portal_INDEX_CASTER])
                    call IssuePointOrderLocBJ(udg_Portal_traveller, "attack", udg_Portal_loc4)
                    call RemoveLocation(udg_Portal_loc4)
                    call AddSpecialEffectLocBJ(udg_Portal_loc3, udg_Portal_arrivalFX[udg_Portal_INDEX_TRAVELLER])
                    call DestroyEffectBJ(GetLastCreatedEffectBJ())
                endif
            endif
            call RemoveLocation(udg_Portal_loc2)
            set udg_Portal_targeted[udg_Portal_INDEX_CASTER]=null
            call GroupRemoveUnitSimple(udg_Portal_traveller, udg_Portal_group)
        endif
    else
        if ( Trig_Portal_Periodic_Func001Func006Func001C() ) then
            // This is here in case of a unit being knockbacked outside the Portal's reach
            set udg_Portal_isTeleporting[udg_Portal_INDEX_CASTER]=false
            call IssueTargetOrderBJ(udg_Portal_traveller, "smart", udg_Portal_targeted[udg_Portal_INDEX_CASTER])
        else
        endif
    endif
    // -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- 
    call RemoveLocation(udg_Portal_loc3)
    call RemoveLocation(udg_Portal_loc1)
endfunction

function Trig_Portal_Periodic_Func002Func007Func003Func001Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Portal_portal[udg_Portal_INDEX_TRAVELLER]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func002Func007Func003Func001Func012C takes nothing returns boolean
    if ( not ( IsUnitSelected(udg_Portal_traveller, GetOwningPlayer(udg_Portal_traveller)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func002Func007Func003Func001C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_Portal_loc1, udg_Portal_loc2) <= udg_Portal_range[udg_Portal_INDEX_TARGET] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func002Func007Func003Func002Func013C takes nothing returns boolean
    if ( not ( IsUnitSelected(udg_Portal_traveller, GetOwningPlayer(udg_Portal_traveller)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func002Func007Func003Func002Func014C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Portal_portal[udg_Portal_INDEX_TRAVELLER]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func002Func007Func003Func002C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_Portal_loc1, udg_Portal_loc2) <= ( udg_Portal_missileSpeed[udg_Portal_INDEX_TRAVELLER] / 33.00 ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func002Func007Func003C takes nothing returns boolean
    if ( not ( udg_Portal_missileSpeed[udg_Portal_INDEX_TRAVELLER] > 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func002Func007Func015C takes nothing returns boolean
    if ( not ( IsUnitSelected(udg_Portal_traveller, GetOwningPlayer(udg_Portal_traveller)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func002Func007C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Portal_traveller) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func002A takes nothing returns nothing
    // In this group, the Portal_traveller is the missile unit, not the actual unit being teleported
    // The unit is Portal_targeted
    set udg_Portal_traveller=GetEnumUnit()
    set udg_Portal_INDEX_TRAVELLER=GetUnitUserData(udg_Portal_traveller)
    set udg_Portal_INDEX_CASTER=GetUnitUserData(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER])
    set udg_Portal_INDEX_TARGET=GetUnitUserData(udg_Portal_portal[udg_Portal_INDEX_TRAVELLER])
    if ( Trig_Portal_Periodic_Func002Func007C() ) then
        set udg_Portal_loc1=GetUnitLoc(udg_Portal_traveller)
        set udg_Portal_loc2=GetUnitLoc(udg_Portal_portal[udg_Portal_INDEX_TRAVELLER])
        if ( Trig_Portal_Periodic_Func002Func007Func003C() ) then
            if ( Trig_Portal_Periodic_Func002Func007Func003Func002C() ) then
                call ShowUnitShow(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER])
                set udg_Portal_loc3=PolarProjectionBJ(udg_Portal_loc1, GetRandomReal(0.00, udg_Portal_range[GetUnitUserData(udg_Portal_portal[udg_Portal_INDEX_TRAVELLER])]), GetRandomDirectionDeg())
                call SetUnitPositionLoc(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], udg_Portal_loc3)
                call UnitApplyTimedLifeBJ(0.01, 'BTLF', udg_Portal_traveller)
                call GroupRemoveUnitSimple(udg_Portal_traveller, udg_Portal_teleMissiles)
                call GroupRemoveUnitSimple(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], udg_Portal_group)
                call AddSpecialEffectLocBJ(udg_Portal_loc3, udg_Portal_arrivalFX[GetUnitUserData(udg_Portal_portal[udg_Portal_INDEX_TRAVELLER])])
                call DestroyEffectBJ(GetLastCreatedEffectBJ())
                set udg_Portal_loc4=GetUnitRallyPoint(udg_Portal_portal[udg_Portal_INDEX_TRAVELLER])
                call IssuePointOrderLocBJ(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], "attack", udg_Portal_loc4)
                call RemoveLocation(udg_Portal_loc4)
                call RemoveLocation(udg_Portal_loc3)
                if ( Trig_Portal_Periodic_Func002Func007Func003Func002Func013C() ) then
                    call SelectUnitAddForPlayer(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], GetOwningPlayer(udg_Portal_traveller))
                else
                endif
            else
                if ( Trig_Portal_Periodic_Func002Func007Func003Func002Func014C() ) then
                    set udg_Portal_loc3=PolarProjectionBJ(udg_Portal_loc1, ( udg_Portal_missileSpeed[udg_Portal_INDEX_TRAVELLER] / 33.00 ), AngleBetweenPoints(udg_Portal_loc1, udg_Portal_loc2))
                    call SetUnitPositionLocFacingLocBJ(udg_Portal_traveller, udg_Portal_loc3, udg_Portal_loc2)
                    call RemoveLocation(udg_Portal_loc3)
                else
                    call UnitApplyTimedLifeBJ(0.01, 'BTLF', udg_Portal_traveller)
                endif
            endif
        else
            if ( Trig_Portal_Periodic_Func002Func007Func003Func001C() ) then
                call ShowUnitShow(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER])
                call SetUnitPositionLoc(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], udg_Portal_loc1)
                call UnitApplyTimedLifeBJ(0.01, 'BTLF', udg_Portal_traveller)
                call GroupRemoveUnitSimple(udg_Portal_traveller, udg_Portal_teleMissiles)
                call GroupRemoveUnitSimple(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], udg_Portal_group)
                call AddSpecialEffectLocBJ(udg_Portal_loc1, udg_Portal_arrivalFX[udg_Portal_INDEX_TARGET])
                call DestroyEffectBJ(GetLastCreatedEffectBJ())
                set udg_Portal_loc4=GetUnitRallyPoint(udg_Portal_portal[udg_Portal_INDEX_TRAVELLER])
                call IssuePointOrderLocBJ(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], "attack", udg_Portal_loc4)
                call RemoveLocation(udg_Portal_loc4)
                if ( Trig_Portal_Periodic_Func002Func007Func003Func001Func012C() ) then
                    call SelectUnitAddForPlayer(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], GetOwningPlayer(udg_Portal_traveller))
                else
                endif
            else
                if ( Trig_Portal_Periodic_Func002Func007Func003Func001Func001C() ) then
                else
                    call UnitApplyTimedLifeBJ(0.01, 'BTLF', udg_Portal_traveller)
                endif
            endif
        endif
        call RemoveLocation(udg_Portal_loc2)
        call RemoveLocation(udg_Portal_loc1)
    else
        call ShowUnitShow(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER])
        set udg_Portal_loc1=GetUnitLoc(udg_Portal_traveller)
        call SetUnitPositionLoc(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], udg_Portal_loc1)
        call RemoveLocation(udg_Portal_loc1)
        call SetUnitFlyHeightBJ(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], GetUnitFlyHeight(udg_Portal_traveller), 0.00)
        call ExplodeUnitBJ(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER])
        call GroupRemoveUnitSimple(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], udg_Portal_group)
        call GroupRemoveUnitSimple(udg_Portal_traveller, udg_Portal_teleMissiles)
        call UnitRemoveAbilityBJ(udg_Portal_delayFXAbil[udg_Portal_INDEX_TRAVELLER], udg_Portal_traveller)
        if ( Trig_Portal_Periodic_Func002Func007Func015C() ) then
            call SelectUnitAddForPlayer(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], GetOwningPlayer(udg_Portal_traveller))
        else
        endif
    endif
endfunction

function Trig_Portal_Periodic_Func003C takes nothing returns boolean
    if ( not ( IsUnitGroupEmptyBJ(udg_Portal_group) == true ) ) then
        return false
    endif
    if ( not ( IsUnitGroupEmptyBJ(udg_Portal_teleMissiles) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Actions takes nothing returns nothing
    call ForGroupBJ(udg_Portal_group, function Trig_Portal_Periodic_Func001A)
    call ForGroupBJ(udg_Portal_teleMissiles, function Trig_Portal_Periodic_Func002A)
    if ( Trig_Portal_Periodic_Func003C() ) then
        call DisableTrigger(GetTriggeringTrigger())
    else
    endif
endfunction

//===========================================================================
function InitTrig_Portal_Periodic takes nothing returns nothing
    set gg_trg_Portal_Periodic=CreateTrigger()
    call DisableTrigger(gg_trg_Portal_Periodic)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Portal_Periodic, ( 1 / 32.00 ))
    call TriggerAddAction(gg_trg_Portal_Periodic, function Trig_Portal_Periodic_Actions)
endfunction

//===========================================================================
// Trigger: Portal Target
//===========================================================================
function Trig_Portal_Target_Func006C takes nothing returns boolean
    if ( ( GetIssuedOrderIdBJ() == String2OrderIdBJ("smart") ) ) then
        return true
    endif
    if ( ( GetIssuedOrderIdBJ() == String2OrderIdBJ("move") ) ) then
        return true
    endif
    return false
endfunction

function Trig_Portal_Target_Conditions takes nothing returns boolean
    if ( not ( udg_Portal_active[GetUnitUserData(GetOrderTargetUnit())] == true ) ) then
        return false
    endif
    if ( not ( IsUnitInGroup(GetTriggerUnit(), udg_Portal_teleMissiles) == false ) ) then
        return false
    endif
    if ( not Trig_Portal_Target_Func006C() ) then
        return false
    endif
    if ( not ( IsUnitAlly(GetTriggerUnit(), GetOwningPlayer(GetOrderTargetUnit())) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Target_Func003Func001Func005C takes nothing returns boolean
    if ( not ( IsTriggerEnabled(gg_trg_Portal_Periodic) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Target_Func003Func001C takes nothing returns boolean
    if ( not ( udg_Portal_preventAllies[udg_Portal_INDEX_TARGET] == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) != GetOwningPlayer(GetOrderTargetUnit()) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Target_Func003C takes nothing returns boolean
    if ( not ( udg_Portal_active[udg_Portal_INDEX_CASTER] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Target_Actions takes nothing returns nothing
    set udg_Portal_INDEX_CASTER=GetUnitUserData(GetTriggerUnit())
    set udg_Portal_INDEX_TARGET=GetUnitUserData(GetOrderTargetUnit())
    if ( Trig_Portal_Target_Func003C() ) then
        call DisplayTimedTextToForce(GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), 10.00, "TRIGSTR_19362")
    else
        if ( Trig_Portal_Target_Func003Func001C() ) then
        else
            set udg_Portal_targeted[udg_Portal_INDEX_CASTER]=GetOrderTargetUnit()
            call GroupAddUnitSimple(GetTriggerUnit(), udg_Portal_group)
            set udg_Portal_delay[udg_Portal_INDEX_CASTER]=udg_Portal_delay[udg_Portal_INDEX_TARGET]
            // -------- -------- -------- -------- -------- -------- -------- -------- -------- --------
            if ( Trig_Portal_Target_Func003Func001Func005C() ) then
                call EnableTrigger(gg_trg_Portal_Periodic)
            else
            endif
        endif
    endif
endfunction

//===========================================================================
function InitTrig_Portal_Target takes nothing returns nothing
    set gg_trg_Portal_Target=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Portal_Target, EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
    call TriggerAddCondition(gg_trg_Portal_Target, Condition(function Trig_Portal_Target_Conditions))
    call TriggerAddAction(gg_trg_Portal_Target, function Trig_Portal_Target_Actions)
endfunction

//===========================================================================
// Trigger: Portal Disengage
//===========================================================================
function Trig_Portal_Disengage_Conditions takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetTriggerUnit(), udg_Portal_group) == true ) ) then
        return false
    endif
    if ( not ( GetOrderTargetUnit() != udg_Portal_targeted[GetUnitUserData(GetTriggerUnit())] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Disengage_Actions takes nothing returns nothing
    set udg_Portal_INDEX_CASTER=GetUnitUserData(GetTriggerUnit())
    set udg_Portal_INDEX_TARGET=GetUnitUserData(udg_Portal_targeted[udg_Portal_INDEX_CASTER])
    set udg_Portal_delay[udg_Portal_INDEX_CASTER]=0.00
    set udg_Portal_isTeleporting[udg_Portal_INDEX_CASTER]=false
    set udg_Portal_targeted[udg_Portal_INDEX_CASTER]=null
    call GroupRemoveUnitSimple(GetTriggerUnit(), udg_Portal_group)
    call UnitRemoveAbilityBJ(udg_Portal_delayFXAbil[udg_Portal_INDEX_TARGET], GetTriggerUnit())
endfunction

//===========================================================================
function InitTrig_Portal_Disengage takes nothing returns nothing
    set gg_trg_Portal_Disengage=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Portal_Disengage, EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Portal_Disengage, EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Portal_Disengage, EVENT_PLAYER_UNIT_ISSUED_ORDER)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Portal_Disengage, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Portal_Disengage, Condition(function Trig_Portal_Disengage_Conditions))
    call TriggerAddAction(gg_trg_Portal_Disengage, function Trig_Portal_Disengage_Actions)
endfunction

//===========================================================================
// Trigger: Portal Death
//===========================================================================
function Trig_Portal_Death_Conditions takes nothing returns boolean
    if ( not ( udg_Portal_active[GetUnitUserData(GetTriggerUnit())] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Death_Func004Func004C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Death_Func004Func005C takes nothing returns boolean
    if ( not ( udg_Portal_portal[udg_Portal_INDEX_CASTER] == udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Death_Func004A takes nothing returns nothing
    set udg_Portal_traveller=GetEnumUnit()
    set udg_Portal_INDEX_TRAVELLER=GetUnitUserData(udg_Portal_traveller)
    call UnitRemoveAbilityBJ(udg_Portal_delayFXAbil[udg_Portal_INDEX_CASTER], udg_Portal_traveller)
    if ( Trig_Portal_Death_Func004Func004C() ) then
        set udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER]=null
        set udg_Portal_delay[udg_Portal_INDEX_TRAVELLER]=0.00
        set udg_Portal_isTeleporting[udg_Portal_INDEX_TRAVELLER]=false
        call GroupRemoveUnitSimple(udg_Portal_traveller, udg_Portal_group)
    else
    endif
    if ( Trig_Portal_Death_Func004Func005C() ) then
        set udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER]=null
        set udg_Portal_delay[udg_Portal_INDEX_TRAVELLER]=0.00
        set udg_Portal_isTeleporting[udg_Portal_INDEX_TRAVELLER]=false
        call GroupRemoveUnitSimple(udg_Portal_traveller, udg_Portal_group)
    else
    endif
endfunction

function Trig_Portal_Death_Actions takes nothing returns nothing
    set udg_Portal_INDEX_CASTER=GetUnitUserData(GetTriggerUnit())
    set udg_Portal_INDEX_TARGET=GetUnitUserData(udg_Portal_portal[udg_Portal_INDEX_CASTER])
    call ForGroupBJ(udg_Portal_group, function Trig_Portal_Death_Func004A)
    set udg_Portal_active[udg_Portal_INDEX_CASTER]=false
    set udg_Portal_active[udg_Portal_INDEX_TARGET]=false
    call DestroyEffectBJ(udg_Portal_FX[udg_Portal_INDEX_CASTER])
    call DestroyEffectBJ(udg_Portal_FX[udg_Portal_INDEX_TARGET])
    set udg_Portal_portal[udg_Portal_INDEX_CASTER]=null
    set udg_Portal_portal[udg_Portal_INDEX_TARGET]=null
endfunction

//===========================================================================
function InitTrig_Portal_Death takes nothing returns nothing
    set gg_trg_Portal_Death=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Portal_Death, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Portal_Death, Condition(function Trig_Portal_Death_Conditions))
    call TriggerAddAction(gg_trg_Portal_Death, function Trig_Portal_Death_Actions)
endfunction

//===========================================================================
// Trigger: Portal Missile Order
//
// This prevents killable missiles from deviating from their path since they may only deposit units at the sister portal.
// Selectable missiles that use thier own movement to go to sister portals should have the Ward classification.
//===========================================================================
function Trig_Portal_Missile_Order_Conditions takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetTriggerUnit(), udg_Portal_teleMissiles) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Missile_Order_Actions takes nothing returns nothing
    call DisableTrigger(GetTriggeringTrigger())
    set udg_Portal_INDEX_CASTER=GetUnitUserData(GetTriggerUnit())
    set udg_Portal_loc1=GetUnitLoc(udg_Portal_portal[udg_Portal_INDEX_CASTER])
    call IssuePointOrderLocBJ(GetTriggerUnit(), "move", udg_Portal_loc1)
    call RemoveLocation(udg_Portal_loc1)
    call EnableTrigger(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Portal_Missile_Order takes nothing returns nothing
    set gg_trg_Portal_Missile_Order=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Portal_Missile_Order, EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Portal_Missile_Order, EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Portal_Missile_Order, EVENT_PLAYER_UNIT_ISSUED_ORDER)
    call TriggerAddCondition(gg_trg_Portal_Missile_Order, Condition(function Trig_Portal_Missile_Order_Conditions))
    call TriggerAddAction(gg_trg_Portal_Missile_Order, function Trig_Portal_Missile_Order_Actions)
endfunction

//===========================================================================
// Trigger: Portal Disconnect
//
// Copy the Sever Connection ability and then this if you intend to make Portals able to disconnect from one another with a no-target spell. Otherwise you may skip this trigger.
// Add your various connector spells to the -------- Or - Any (Conditions) are true -------- to give your Portals the Sever Connection spell.
//===========================================================================
function Trig_Portal_Disconnect_Conditions takes nothing returns boolean
    if ( not ( udg_Portal_active[GetUnitUserData(GetTriggerUnit())] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Disconnect_Func001Func005Func004C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Disconnect_Func001Func005Func005C takes nothing returns boolean
    if ( not ( udg_Portal_portal[udg_Portal_INDEX_CASTER] == udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Disconnect_Func001Func005A takes nothing returns nothing
    set udg_Portal_traveller=GetEnumUnit()
    set udg_Portal_INDEX_TRAVELLER=GetUnitUserData(udg_Portal_traveller)
    call UnitRemoveAbilityBJ(udg_Portal_delayFXAbil[udg_Portal_INDEX_CASTER], udg_Portal_traveller)
    if ( Trig_Portal_Disconnect_Func001Func005Func004C() ) then
        set udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER]=null
        set udg_Portal_delay[udg_Portal_INDEX_TRAVELLER]=0.00
        set udg_Portal_isTeleporting[udg_Portal_INDEX_TRAVELLER]=false
        call GroupRemoveUnitSimple(udg_Portal_traveller, udg_Portal_group)
    else
    endif
    if ( Trig_Portal_Disconnect_Func001Func005Func005C() ) then
        set udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER]=null
        set udg_Portal_delay[udg_Portal_INDEX_TRAVELLER]=0.00
        set udg_Portal_isTeleporting[udg_Portal_INDEX_TRAVELLER]=false
        call GroupRemoveUnitSimple(udg_Portal_traveller, udg_Portal_group)
    else
    endif
endfunction

function Trig_Portal_Disconnect_Func001C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == udg_Portal_SeverAbility ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Disconnect_Actions takes nothing returns nothing
    if ( Trig_Portal_Disconnect_Func001C() ) then
        set udg_Portal_INDEX_CASTER=GetUnitUserData(GetTriggerUnit())
        set udg_Portal_INDEX_TARGET=GetUnitUserData(udg_Portal_portal[udg_Portal_INDEX_CASTER])
        call UnitRemoveAbilityBJ(udg_Portal_SeverAbility, GetTriggerUnit())
        call UnitRemoveAbilityBJ(udg_Portal_SeverAbility, udg_Portal_portal[udg_Portal_INDEX_CASTER])
        call ForGroupBJ(udg_Portal_group, function Trig_Portal_Disconnect_Func001Func005A)
        set udg_Portal_active[udg_Portal_INDEX_CASTER]=false
        set udg_Portal_active[udg_Portal_INDEX_TARGET]=false
        call DestroyEffectBJ(udg_Portal_FX[udg_Portal_INDEX_CASTER])
        call DestroyEffectBJ(udg_Portal_FX[udg_Portal_INDEX_TARGET])
        set udg_Portal_portal[udg_Portal_INDEX_CASTER]=null
        set udg_Portal_portal[udg_Portal_INDEX_TARGET]=null
    else
    endif
endfunction

//===========================================================================
function InitTrig_Portal_Disconnect takes nothing returns nothing
    set gg_trg_Portal_Disconnect=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Portal_Disconnect, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Portal_Disconnect, Condition(function Trig_Portal_Disconnect_Conditions))
    call TriggerAddAction(gg_trg_Portal_Disconnect, function Trig_Portal_Disconnect_Actions)
endfunction

//===========================================================================
// Trigger: Connect Portal 2
//
// No Missile, No Delays
//===========================================================================
function Trig_Connect_Portal_2_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0TQ' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Connect_Portal_2_Func001Func003Func002C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_Portal_portal[udg_Portal_INDEX_TARGET] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Connect_Portal_2_Func001Func003C takes nothing returns boolean
    if ( not ( udg_Portal_active[udg_Portal_INDEX_TARGET] == true ) ) then
        return false
    endif
    if ( not ( GetSpellTargetUnit() != udg_Portal_portal[udg_Portal_INDEX_CASTER] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Connect_Portal_2_Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSpellTargetUnit()) == GetUnitTypeId(GetTriggerUnit()) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Connect_Portal_2_Actions takes nothing returns nothing
    if ( Trig_Connect_Portal_2_Func001C() ) then
        set udg_Portal_INDEX_CASTER=GetUnitUserData(GetTriggerUnit())
        set udg_Portal_INDEX_TARGET=GetUnitUserData(GetSpellTargetUnit())
        if ( Trig_Connect_Portal_2_Func001Func003C() ) then
            call DisplayTimedTextToForce(GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), 10.00, "TRIGSTR_19222")
        else
            if ( Trig_Connect_Portal_2_Func001Func003Func002C() ) then
                call DisplayTimedTextToForce(GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), 10.00, "TRIGSTR_19228")
            else
                set udg_Portal_ConfigIndex[1]=udg_Portal_INDEX_CASTER
                set udg_Portal_ConfigIndex[2]=udg_Portal_INDEX_TARGET
                set bj_forLoopAIndex=1
                set bj_forLoopAIndexEnd=2
                loop
                    exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                    // -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- --------
                    // CONFIGURE HERE
                    // -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- --------
                    set udg_Portal_departureFX[udg_Portal_ConfigIndex[GetForLoopIndexA()]]="Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl"
                    set udg_Portal_arrivalFX[udg_Portal_ConfigIndex[GetForLoopIndexA()]]="Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl"
                    set udg_Portal_activeFX[udg_Portal_ConfigIndex[GetForLoopIndexA()]]="Abilities\\Spells\\Orc\\Voodoo\\VoodooAura.mdl"
                    set udg_Portal_range[udg_Portal_ConfigIndex[GetForLoopIndexA()]]=180.00
                    set udg_Portal_delay[udg_Portal_ConfigIndex[GetForLoopIndexA()]]=0.00
                    set udg_Portal_missileSpeed[udg_Portal_ConfigIndex[GetForLoopIndexA()]]=0.00
                    set udg_Portal_preventAllies[udg_Portal_ConfigIndex[GetForLoopIndexA()]]=false
                    // The value below here dont matter since the delay and missileSpeed are both 0
                    set udg_Portal_missileHeight[udg_Portal_ConfigIndex[GetForLoopIndexA()]]=0.00
                    set udg_Portal_missileTargetable[udg_Portal_ConfigIndex[GetForLoopIndexA()]]=false
                    set udg_Portal_missileUseOwnMovement[udg_Portal_ConfigIndex[GetForLoopIndexA()]]=false
                    // -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- --------
                    // //END CONFIGURATION
                    // -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- --------
                    set bj_forLoopAIndex=bj_forLoopAIndex + 1
                endloop
                set udg_Portal_INDEX_CASTER=udg_Portal_ConfigIndex[1]
                set udg_Portal_INDEX_TARGET=udg_Portal_ConfigIndex[2]
                // -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- --------
                call TriggerExecute(gg_trg_Portal_Connect)
            endif
        endif
    else
        call DisplayTimedTextToForce(GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), 10.00, "TRIGSTR_19244")
    endif
endfunction

//===========================================================================
function InitTrig_Connect_Portal_2 takes nothing returns nothing
    set gg_trg_Connect_Portal_2=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Connect_Portal_2, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Connect_Portal_2, Condition(function Trig_Connect_Portal_2_Conditions))
    call TriggerAddAction(gg_trg_Connect_Portal_2, function Trig_Connect_Portal_2_Actions)
endfunction

