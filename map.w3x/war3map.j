    call EnableTrigger(gg_trg_VoidBegin)
    call EnableTrigger(gg_trg_VoidCansel)
    call EnableTrigger(gg_trg_Light)
    call EnableTrigger(gg_trg_LightBegin)
    call EnableTrigger(gg_trg_LightCansel)
    call EnableTrigger(gg_trg_felspell2)
    call EnableTrigger(gg_trg_voidspell111)
    call EnableTrigger(gg_trg_lightspel)
    call EnableTrigger(gg_trg_ArcanaBuild)
    call EnableTrigger(gg_trg_FelBuild)
    call EnableTrigger(gg_trg_VoidBuild)
    call EnableTrigger(gg_trg_LigthBuild)
    
    
    call EnableTrigger(gg_trg_FireShielDamageUniversal)
    
    call EnableTrigger(gg_trg_Porcha)
    call EnableTrigger(gg_trg_FirePodgogStrela)
    call EnableTrigger(gg_trg_Souz)
    
    call EnableTrigger(gg_trg_ArcanaIscachenie)
    call EnableTrigger(gg_trg_ArcanaStrela)
    
    call EnableTrigger(gg_trg_AutoMana)
    call EnableTrigger(gg_trg_AutoStrelaFire)
    call EnableTrigger(gg_trg_AutoStrelaArcana)
    call EnableTrigger(gg_trg_AutoStrelaFel)
    call EnableTrigger(gg_trg_AutoSummonGonch)
    
    call EnableTrigger(gg_trg_FirePodgog)
    call EnableTrigger(gg_trg_FirePodgogStrela2)

    call EnableTrigger(gg_trg_VedmakF)
    call EnableTrigger(gg_trg_VedmakB)
    call EnableTrigger(gg_trg_VedmakC)
    
    call EnableTrigger(gg_trg_MagsF)
    call EnableTrigger(gg_trg_MagsB)
