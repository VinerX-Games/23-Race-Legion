function Trig_KM2_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTrainedUnit()) == 'o01W'
endfunction

function Trig_KM2_Actions takes nothing returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local player p= GetOwningPlayer(GetTriggerUnit())
    local location l= GetUnitRallyPoint(GetTriggerUnit())
    local unit u
    local integer pi= GetPlayerId(p)
    
    
    //1 юнит
    set a[0]=0
  
  
    // Магистр
    if GetPlayerTechCount(p, 'R0D2', true) == 1 and GetPlayerTechCount(p, 'R0E9', true) != 1 then
        set i=2
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='o023'
            
            set b=b + 1
            exitwhen b >= i
        endloop

    endif
    // Темный шаман
    if GetPlayerTechCount(p, 'R0E9', true) == 1 then
        set i=2
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='o01V'
            
            set b=b + 1
            exitwhen b >= i
        endloop
    
    
    endif
    set i=GetRandomInt(1, a[0])
    set b=a[i]
    
    call aiFixTrainBefore(GetTrainedUnit() , pi)
    set u=ReplaceUnit(GetTrainedUnit() , b , bj_UNIT_STATE_METHOD_RELATIVE)
    call aiFixTrainAfter(u , pi)
    
//    
//    call UnitAddAbility(u,'A0UY')
//    call SetUnitAbilityLevel(u,'OR00',35+udg_HordeMagicPrice[pi])
//    
    
     
    
    call UnitAddAbility(u, 'A0YU')

    call IssuePointOrderLoc(u, "attack", l)

    call RemoveLocation(l)
    set p=null
    set u=null
endfunction

