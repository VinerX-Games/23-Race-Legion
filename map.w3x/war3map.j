    endif
    call DisplayTextToForce(GetPlayersAll(), udg_LocalText2)
    call EnableTrigger(gg_trg_LeaveNeadedRegions)
    call ForGroupBJ(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_Continents_set_On_Func013001002)), function Trig_Continents_set_On_Func013A)
    call StartTimerBJ(udg_TimerToCont, false, 0.50)
endfunction

