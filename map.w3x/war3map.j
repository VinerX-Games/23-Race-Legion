    call WaygateSetDestinationLocBJ(gg_unit_n003_0090, GetUnitLoc(gg_unit_e00E_0085))
endfunction

//===========================================================================
function InitTrig_TurtleStart takes nothing returns nothing
    set gg_trg_TurtleStart=CreateTrigger()
    call TriggerAddAction(gg_trg_TurtleStart, function Trig_TurtleStart_Actions)
endfunction


//===========================================================================
// Trigger: TurtlePosadka
//===========================================================================
function Trig_PosadkaTurtle_Conditions takes nothing returns boolean
    set udg_LocalPlayer=GetOwningPlayer(GetTriggerUnit())
    return GetSpellAbilityId() == TurtleAbilityDown and CheckPosition(GetSpellTargetX() , GetSpellTargetY() , 15) and CheckNearCapitals(GetTriggerUnit())
endfunction


function Trig_PosadkaTurtle_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local unit u2= CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'n075', GetUnitX(u), GetUnitY(u) + 65, 0.00)
    call SetUnitMoveSpeed(u, 0.0)
    call SaveUnitHandle(Hash, StringHash("Turtle"), 1, u2)
    
    //call DisplayTextToPlayer(Player(0),0,0,"Тест - посадка")
    call AddUnitAnimationProperties(u, "Swim", false)
    call UnitAddAbility(u, 'A1M6')
    call UnitAddAbility(u, 'A1GE')
    call BlzSetUnitRealFieldBJ(u, UNIT_RF_TURN_RATE, 0.00)
   
    call UnitAddAbility(u, TurtleAbilityAp)
    call BlzStartUnitAbilityCooldown(u, TurtleAbilityAp, 15)
    call UnitRemoveAbility(u, TurtleAbilityDown)
    
    
    
    call ShowUnit(gg_unit_n003_0090, true)
    
    //call UnitRemoveAbilityBJ( 'A1F3', u )
    //call UnitAddAbility(u,'A0HY')
    
    call WaygateActivate(gg_unit_n003_0090, true)
    call WaygateActivate(u2, true)
    call MoveRectTo(gg_rct_TurtleOut, GetUnitX(u), GetUnitY(u))
    call WaygateSetDestination(gg_unit_n003_0090, GetRectCenterX(gg_rct_TurtleOut), GetRectCenterY(gg_rct_TurtleOut))
    call WaygateSetDestination(u2, GetRectCenterX(gg_rct_TurtleIn), GetRectCenterY(gg_rct_TurtleIn))
    call WaygateActivate(u2, true)
    call WaygateActivate(gg_unit_n003_0090, true)
    set u2=null
    set u=null
endfunction

//===========================================================================
function InitTrig_TurtlePosadka takes nothing returns nothing
    set gg_trg_TurtlePosadka=CreateTrigger()
    

    
    call TriggerRegisterAnyUnitEventBJ(gg_trg_TurtlePosadka, EVENT_PLAYER_UNIT_SPELL_EFFECT)


    call TriggerAddCondition(gg_trg_TurtlePosadka, Condition(function Trig_PosadkaTurtle_Conditions))
    call TriggerAddAction(gg_trg_TurtlePosadka, function Trig_PosadkaTurtle_Actions)
endfunction


//===========================================================================
// Trigger: TurtleSwim
//===========================================================================
function Trig_TurtleSwim_Conditions takes nothing returns boolean

    return GetSpellAbilityId() == TurtleAbilityAp
    
endfunction


function Trig_TurtleSwim_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    call RemoveUnit(LoadUnitHandle(Hash, StringHash("Turtle"), 1))
    call FlushChildHashtable(Hash, StringHash("Turtle"))
    call SetUnitMoveSpeed(u, GetUnitDefaultMoveSpeed(u))
    
    call AddUnitAnimationProperties(u, "Swim", true)
    call ShowUnit(gg_unit_n003_0090, false)
    call UnitRemoveAbility(u, 'A1M6')
    call UnitRemoveAbility(u, 'A1GE')
    call UnitAddAbility(u, TurtleAbilityDown)
    call BlzSetUnitRealFieldBJ(u, UNIT_RF_TURN_RATE, 0.15)
    call BlzStartUnitAbilityCooldown(u, TurtleAbilityDown, 15)
    call UnitRemoveAbility(u, TurtleAbilityAp)
    
    call WaygateActivateBJ(false, gg_unit_n003_0090)
    
    //call UnitAddAbility( u, 'A1F3')
    //call UnitRemoveAbility(u,'A0HY')
    
    //call DisplayTextToPlayer(Player(0),0,0,"Тест - взлет"+R2S(GetUnitMoveSpeed(u)))
    call WaygateActivate(gg_unit_n003_0090, false)

    
    
    set u=null
endfunction

//===========================================================================
function InitTrig_TurtleSwim takes nothing returns nothing
    set gg_trg_TurtleSwim=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_TurtleSwim, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_TurtleSwim, Condition(function Trig_TurtleSwim_Conditions))
    call TriggerAddAction(gg_trg_TurtleSwim, function Trig_TurtleSwim_Actions)
endfunction


