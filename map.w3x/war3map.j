//===========================================================================
// Trigger: MassMolot
//===========================================================================
function Trig_MassMolot_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'AHtb'
endfunction



function Trig_MassMolot_Actions takes nothing returns nothing
    local location l= GetUnitLoc(GetTriggerUnit())
    local player p= GetOwningPlayer(GetTriggerUnit())
    
    local boolexpr bex= Condition(function EnemEl)
    local integer level= GetUnitAbilityLevelSwapped('AHtb', GetTriggerUnit())
    local group g= CreateGroup()
    local unit u
    local unit u2
    local integer i= 0
    set udg_LocalPlayer=p
    call GroupEnumUnitsInRangeOfLoc(g, l, 400, bex)
    
    call RemoveLocation(l)
    set l=GetUnitLoc(GetTriggerUnit())
    loop
        set u=FirstOfGroup(g)
        exitwhen i >= ( 4 * level ) or u == null
        
        set u2=CreateUnitAtLoc(p, 'H0BN', l, bj_UNIT_FACING)
        call RemoveUnitTimed(u2 , 2)
        call UnitAddAbility(u2, 'A17Z')
        call SetUnitManaBJ(u2, 1111111.00)
        call SetUnitAbilityLevel(u2, 'A17Z', level)
        call IssueTargetOrder(u2, "thunderbolt", u)
        
        set i=i + 1
        call GroupRemoveUnit(g, u)
    endloop
    
    
    set u=null
    call DestroyGroup(g)
    set g=null
    call RemoveLocation(l)
    set p=null
    call DestroyBoolExpr(bex)
    set u2=null
    set bex=null
endfunction

//===========================================================================
function InitTrig_MassMolot takes nothing returns nothing
    set gg_trg_MassMolot=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_MassMolot, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_MassMolot, Condition(function Trig_MassMolot_Conditions))
    call TriggerAddAction(gg_trg_MassMolot, function Trig_MassMolot_Actions)
endfunction


//===========================================================================
// Trigger: VarianCharge
//===========================================================================
function Trig_VarianCharge_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A1AG'
endfunction

//================================================================================================================================================================================
// Этам 2 - двигаем героя
//================
function Trig_Charge_move_heroV takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer h= GetHandleId(t)
    local unit GT= LoadUnitHandle(Hash, h, 1)
    local real l= LoadReal(Hash, h, 2)
    local group g
    local real x1= LoadReal(Hash, h, 4)
    local real y1= LoadReal(Hash, h, 5)
    local real dx= GetUnitX(GT)
    local real dy= GetUnitY(GT)
    local unit un
    local real x
    local real y
    local real uron
    local integer lvl
    local real w
    local real ugol= JSTRUgolMT(dx , x1 , dy , y1)
    local timer t1
    local integer h1
    local real MaxW
    if l <= 500 then
        set MaxW=l
    else
        set MaxW=500
    endif
    //-------
    set x=dx + 25 * Cos(ugol * bj_DEGTORAD) //вычисляем следующий х
    set y=dy + 25 * Sin(ugol * bj_DEGTORAD) //вычисляем следующий у
    set w=JSTRParabolaZ(MaxW , l , JSTRRastMT(x , x1 , y , y1)) //вычисляем высоту
    
    // ищем конец пути
    if JSTRRastMT(x1 , dx , y1 , dy) > 25 then //and not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
        // двигаем юнита
        call SetUnitX(GT, x)
        call SetUnitY(GT, y)
        call SetUnitFacing(GT, ugol)
        //call SetUnitFlyHeight(GT, w, 0)
    else
        call DestroyEffect(LoadEffectHandle(Hash, h, 6))
        call DestroyTimer(t)
        call FlushChildHashtable(Hash, h)
        call SetUnitAnimation(GT, "attack")
        //call SetUnitFlyHeight(GT, 0, 0)
        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl", dx, dy))
        set g=CreateGroup()
        call GroupEnumUnitsInRange(g, dx, dy, 260, null)
        loop
            set un=FirstOfGroup(g)
            exitwhen un == null
            set lvl=GetUnitAbilityLevel(GT, JSTRSkill)
            
            // винер - проверка на героя
            if IsUnitType(GT, UNIT_TYPE_HERO) then
                set uron=JSTRKofDmg1 * lvl * 0.75 * GetHeroStr(GT, true) + lvl * JSTRKofDmg2
            else
                set uron=lvl * JSTRKofDmg2 * 4
            endif
            
            if not IsUnitType(un, UNIT_TYPE_STRUCTURE) and IsUnitEnemy(un, GetOwningPlayer(GT)) and not IsUnitType(un, UNIT_TYPE_DEAD) and not IsUnitType(un, UNIT_TYPE_FLYING) then
                call UnitDamageTarget(GT, un, uron, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_UNIVERSAL, WEAPON_TYPE_WHOKNOWS)
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageDeathCaster.mdl", un, "orign"))
                //--------
                // двигаем юнита в другую сторону от кастера
                if JSTRBoolMove then
                    set ugol=JSTRUgolMT(dx , GetUnitX(un) , dy , GetUnitY(un))
                    set t1=CreateTimer()
                    set h1=GetHandleId(t1)
                    call SaveUnitHandle(Hash, h1, 1, un)
                    call SaveReal(Hash, h1, 2, ugol)
                    call SaveInteger(Hash, h1, 3, 17)
                    call TimerStart(t1, 0.015, true, function Trig_JumpSTR_move_units)
                endif
                //-------- 
            endif
            call GroupRemoveUnit(g, un)
        endloop
        call DestroyGroup(g)
    endif
    //-------
    set GT=null
    set un=null
    set g=null
    set t=null
    set t1=null
endfunction

//================================================================================================================================================================================
// Этам 2 - основная функция
//================
function Trig_VarianCharge_Actions takes nothing returns nothing
    local unit GT= GetTriggerUnit()
    //local group g = CreateGroup()
    local timer t= CreateTimer()
    local integer h= GetHandleId(t)
    local real x= GetUnitX(GT)
    local real y= GetUnitY(GT)
    local real x1= GetSpellTargetX()
    local real y1= GetSpellTargetY()
    local real l= JSTRRastMT(x , x1 , y , y1)
    
    set JSTRSkill=GetSpellAbilityId()
    call UnitAddAbility(GT, 'Amrf')
    call UnitRemoveAbility(GT, 'Amrf')
    //-------
    call SaveUnitHandle(Hash, h, 1, GT)
    if l != 0 then
        call SaveReal(Hash, h, 2, l)
    else
        call SaveReal(Hash, h, 2, 1)
    endif
    call SaveReal(Hash, h, 4, x1)
    call SaveReal(Hash, h, 5, y1)
    //call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl", x, y))
    call TimerStart(t, 0.025, true, function Trig_Charge_move_heroV) //стартуем движение героя
    //-------
    set GT=null
    //set g = null
    set t=null
endfunction

//===========================================================================
function InitTrig_VarianCharge takes nothing returns nothing
    set gg_trg_VarianCharge=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_VarianCharge, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_VarianCharge, Condition(function Trig_VarianCharge_Conditions))
    call TriggerAddAction(gg_trg_VarianCharge, function Trig_VarianCharge_Actions)
endfunction


