//===========================================================================
// Trigger: SecondChance
//===========================================================================
function Trig_SecondChance_Func003Func007001002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == true )
endfunction

function Trig_SecondChance_Func003Func007A takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_SecondChance_Func003Func008C takes nothing returns boolean
    if ( not ( udg_LocalInteger >= 1 ) ) then
        return false
    endif
    if ( not ( udg_LocalInteger <= 24 ) ) then
        return false
    endif
    if ( not ( udg_LocalInteger != 13 ) ) then
        return false
    endif
    if ( not ( udg_LocalInteger != 16 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SecondChance_Func003C takes nothing returns boolean
    if ( not Trig_SecondChance_Func003Func008C() ) then
        return false
    endif
    return true
endfunction

function Trig_SecondChance_Actions takes nothing returns nothing
    set udg_LocalText2=SubStringBJ(GetEventPlayerChatString(), 12, 13)
    set udg_LocalInteger=S2I(udg_LocalText2)
    if ( Trig_SecondChance_Func003C() ) then
        set udg_LocalPosition2=GetRandomLocInRect(gg_rct_HostRegion)
        call DisplayTimedTextToForce(GetPlayersAll(), 5.00, ( ( "Хост " + GetPlayerName(GetTriggerPlayer()) ) + ( " дал игроку " + ( GetPlayerName(ConvertedPlayer(udg_LocalInteger)) + " второй шанс!" ) ) ))
        call CreateNUnitsAtLoc(1, 'h0HJ', ConvertedPlayer(udg_LocalInteger), udg_LocalPosition2, bj_UNIT_FACING)
        call SetPlayerStateBJ(ConvertedPlayer(udg_LocalInteger), PLAYER_STATE_RESOURCE_GOLD, 5000)
        call SetPlayerStateBJ(ConvertedPlayer(udg_LocalInteger), PLAYER_STATE_RESOURCE_LUMBER, 5000)
        call RemoveLocation(udg_LocalPosition2)
        call ForGroupBJ(GetUnitsOfPlayerMatching(ConvertedPlayer(udg_LocalInteger), Condition(function Trig_SecondChance_Func003Func007001002)), function Trig_SecondChance_Func003Func007A)
    else
    endif
endfunction

