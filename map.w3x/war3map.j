//===========================================================================
// Trigger: PlagueOnBuilding
//===========================================================================
function Trig_PlagueOnBuilding_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A1HR'
endfunction

function Plague takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer id= GetHandleId(t)
    local integer time= LoadInteger(Hash, id, 1)
    local effect e
    local unit u= LoadUnitHandle(Hash, id, 0)
    //Начало
    if time == 0 and UnitAlive(u) and u != null then
        call UnitAddAbility(u, 'A1HS')
        set e=AddSpecialEffectTargetUnitBJ("overhead", u, "CultOfDamned\\PlagueCloudTargetLight.mdx")
        call SaveEffectHandle(Hash, id, 2, e)
        
    //Тикает
    elseif time < 30 and UnitAlive(u) and u != null then
        call SaveInteger(Hash, id, 1, time + 1)
        
    //Конец
    else
        if UnitAlive(u) then
            set income[LoadInteger(Hash, GetHandleId(u), 0)]=income[LoadInteger(Hash, GetHandleId(u), 0)] - 5
            set income[GetPlayerId(GetOwningPlayer(u))]=income[GetPlayerId(GetOwningPlayer(u))] + 5
        endif
        call UnitRemoveAbility(u, 'A1HS')
        call DestroyEffect(LoadEffectHandle(Hash, id, 2))
        call PauseTimer(t)
        call DestroyTimer(t)
        call FlushChildHashtable(Hash, id)
    
    endif


    set e=null
    set t=null
    set u=null
endfunction



function Trig_PlagueOnBuilding_Actions takes nothing returns nothing
    local timer t= CreateTimer()
    local integer id= GetHandleId(t)
    local unit u= GetSpellTargetUnit()
    if u != null then
        if GetUnitAbilityLevel(u, 'A1HS') < 1 and IsPlayerEnemy(GetOwningPlayer(u), GetOwningPlayer(GetTriggerUnit())) then
            //Начать
            
            if GetUnitFoodMade(u) > 0 then
                set income[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]=income[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))] + 5
                set income[GetPlayerId(GetOwningPlayer(u))]=income[GetPlayerId(GetOwningPlayer(u))] - 5
            endif
            
            call SaveInteger(Hash, GetHandleId(u), 0, GetPlayerId(GetOwningPlayer(GetTriggerUnit())))
            call SaveUnitHandle(Hash, id, 0, u)
            call SaveInteger(Hash, id, 1, 0)
            call TimerStart(t, 1.00, true, function Plague)
        else
            //Продлить
            call SaveInteger(Hash, id, 1, 1)
        
        endif
    endif
    set t=null
    
endfunction

//===========================================================================
function InitTrig_PlagueOnBuilding takes nothing returns nothing
    set gg_trg_PlagueOnBuilding=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_PlagueOnBuilding, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_PlagueOnBuilding, Condition(function Trig_PlagueOnBuilding_Conditions))
    call TriggerAddAction(gg_trg_PlagueOnBuilding, function Trig_PlagueOnBuilding_Actions)
endfunction


