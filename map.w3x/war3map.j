    call CameraSetupApplyForPlayer(true, gg_cam_GW1, GetEnumPlayer(), 0)
endfunction

function Trig_StartLobby_Func004C takes nothing returns boolean
    if ( not ( udg_LocalInteger == 1 ) ) then
        return false
    endif
    return true
endfunction

