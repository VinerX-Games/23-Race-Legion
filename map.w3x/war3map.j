//===========================================================================
function Trig_StartJungleTrools_Func001A takes nothing returns nothing
    call SetPlayerTechMaxAllowedSwap('O05B', 1, GetEnumPlayer())
    
    call SetPlayerTechMaxAllowedSwap('O05A', 1, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('O05D', 1, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('O055', 1, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('O054', 1, GetEnumPlayer())
    
    //Black spear
    call SetPlayerTechMaxAllowedSwap('o04P', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('O05L', 0, GetEnumPlayer())
    
    //Gurubashy
    call SetPlayerTechMaxAllowedSwap('o04N', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('O055', 0, GetEnumPlayer())
    
    //call SetPlayerTechMaxAllowedSwap( 'A1DN', 0, GetEnumPlayer() )
    
    call SetPlayerTechMaxAllowedSwap('A1EP', 1, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('A1EQ', 1, GetEnumPlayer())
    
endfunction

function Trig_StartJungleTrools_Actions takes nothing returns nothing
    call ForForce(udg_AllPlayers, function Trig_StartJungleTrools_Func001A)
endfunction

