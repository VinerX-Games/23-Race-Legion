//===========================================================================
// Trigger: UnitsToBuildingSituation2
//===========================================================================
function Trig_UnitsToBuildingSituation2_Func002C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e021' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e020' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e01H' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e01J' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e01L' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e01M' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e01X' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e01K' ) ) then
        return true
    endif
    return false
endfunction

function Trig_UnitsToBuildingSituation2_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    if ( not Trig_UnitsToBuildingSituation2_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_UnitsToBuildingSituation2_Actions takes nothing returns nothing
    local integer i= GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
    set udg_UnitsCount[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]=( udg_UnitsCount[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))] - 1 )
    call MultiboardSetItemValue(MultiboardItem[MultiboardItemOwnerIndex[i] * 2 + 1], I2S(udg_UnitsCount[i]))
    set i=0
endfunction

//===========================================================================
function InitTrig_UnitsToBuildingSituation2 takes nothing returns nothing
    set gg_trg_UnitsToBuildingSituation2=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_UnitsToBuildingSituation2, EVENT_PLAYER_UNIT_CONSTRUCT_START)
