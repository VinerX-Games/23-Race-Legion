//***************************************************************************
//*  StrategHorde
function Strateg_Horde_EC takes integer id returns nothing
        //Это ферма
        if id == 'nnfm' then
            set udg_LocalInteger3=udg_LocalInteger3 + 1
        //Это Т1
        elseif id == 'ogre' then
            set udg_LocalInteger3=udg_LocalInteger3 + 4
        //Это Т2
        elseif id == 'ostr' then
            set udg_LocalInteger3=udg_LocalInteger3 + 6
        //Это Т3
        elseif id == 'ofrt' then
            set udg_LocalInteger3=udg_LocalInteger3 + 8
        endif
endfunction

function Strateg_Horde takes integer i,integer pi,player p returns nothing
    if Grades[pi] < 150 then
        
        // nnsg (второй набор)
        if i < 50 then
            call MakeGradeCheckCap(p , 'nntt' , 'R0FE' , 1)
            call MakeGradeCheckCap(p , 'nntt' , 'R0FF' , 1)
        endif
        
        if i > 17 then

            
            
            call MakeGradeCheckCap(p , 'ogre' , 'Ropg' , 1)
            // Ofor
            call MakeGradeCheckCap(p , 'ofor' , 'R0G5' , 6)
            call MakeGradeCheckCap(p , 'ofor' , 'R0E6' , 6)
            call MakeGradeCheckCap(p , 'ofor' , 'Rome' , 6)
            call MakeGradeCheckCap(p , 'ofor' , 'Roar' , 6)
            call MakeGradeCheckCap(p , 'ofor' , 'Rora' , 6)
            call MakeGradeCheckCap(p , 'ofor' , 'Rosp' , 3)
            call MakeGradeCheckCap(p , 'ofor' , 'Rorb' , 3)


            // пех даль тех
            call MakeGradeCheckCap(p , 'obar' , 'R0EC' , 3)
            call MakeGradeCheckCap(p , 'obea' , 'R0ED' , 3)
            call MakeGradeCheckCap(p , 'otto' , 'R0EF' , 3)

            // маги  Rost,Rowt,Rowd
            call MakeGradeCheckCap(p , 'osld' , 'Rost' , 3)
            call MakeGradeCheckCap(p , 'osld' , 'Rost' , 3)
            call MakeGradeCheckCap(p , 'osld' , 'Rowd' , 3)
            
            //Покупка предмета
            if GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD) > 2000 then
                call TryBuy(p , i)
            endif
            
            call strategFleetGrades(i , p , 'h0HO')
        endif
            
            // Посольство
            set gInt=GetRandomInt(1, 5)
            if gInt == 1 then
                call MakeGradeCheckCap(p , 'ovln' , 'R0F3' , 1)
                call MakeGradeCheckCap(p , 'ovln' , 'R0F4' , 1)
                call MakeGradeCheckCap(p , 'ovln' , 'R0EH' , 1)
                call MakeGradeCheckCap(p , 'ovln' , 'R0EI' , 1)
            elseif gInt == 2 then
                call MakeGradeCheckCap(p , 'ovln' , 'R0EE' , 1)
                call MakeGradeCheckCap(p , 'ovln' , 'R0EA' , 1)
                call MakeGradeCheckCap(p , 'ovln' , 'R0E9' , 1)
                call MakeGradeCheckCap(p , 'ovln' , 'R0E5' , 1)
            elseif gInt == 3 then
                call MakeGradeCheckCap(p , 'ovln' , 'R0E4' , 1)
                call MakeGradeCheckCap(p , 'ovln' , 'R0E3' , 1)
                call MakeGradeCheckCap(p , 'ovln' , 'R0E1' , 1)
                call MakeGradeCheckCap(p , 'ovln' , 'R0E0' , 1)
            elseif gInt == 4 then
                call MakeGradeCheckCap(p , 'ovln' , 'R0DZ' , 1)
                call MakeGradeCheckCap(p , 'ovln' , 'R0D2' , 1)
                call MakeGradeCheckCap(p , 'ovln' , 'R0D3' , 1)
                call MakeGradeCheckCap(p , 'ovln' , 'R0D1' , 1)
            elseif gInt == 5 then
                call MakeGradeCheckCap(p , 'ovln' , 'R0DX' , 1)
                call MakeGradeCheckCap(p , 'ovln' , 'R0DY' , 1)
                call MakeGradeCheckCap(p , 'ovln' , 'R0DZ' , 1)
                call MakeGradeCheckCap(p , 'ovln' , 'R0DW' , 1)
                call MakeGradeCheckCap(p , 'ovln' , 'R0KO' , 1)
            endif


    else
        call warRace(Grades[pi] , p)
    endif
    //Делай т2
    if i > 25 and LoadInteger(AiData, pi, 'ostr') < 3 then
        call BuildT(p , 'ogre' , 'ostr')
    endif
    
    //Делай т3
    if i > 55 and LoadInteger(AiData, pi, 'ofrt') < 3 then
        call BuildT(p , 'ostr' , 'ofrt')
    endif
    
    //Спавн мага тп
    if i > 60 and LoadInteger(AiData, pi, 'h07A') < i / 35 then
        call MakeMageTp(pi)
    endif


endfunction
//***************************************************************************
//*  BuildHorde
function ChooseBuildings_Horde takes integer pi returns integer
    // Инициализируем массив и добавляем стартовый вариант
    set tArray[0]=1
    set tArray[1]='otrb' // 1 землянка
    
    // h0HO,ogre obar  otrb    ,,,,,oalt,,osld,otto,owtw,ovln
    call CheckAndAddBuilding(pi , 'ogre' , 3 , 5) // T1
    call CheckAndAddBuilding(pi , 'otrb' , 20 , 3) // Доп. землянки на старте
    call CheckAndAddBuilding(pi , 'obar' , 3 , 7) // Доп казармы на старте
    call CheckAndAddBuilding(pi , 'obar' , 18 , 3) // Казарма
    call CheckAndAddBuilding(pi , 'obea' , 18 , 2) // Стрельбище
    call CheckAndAddBuilding(pi , 'owtw' , 30 , 1) // Tower
    call CheckAndAddBuilding(pi , 'ofor' , 5 , 3) // Лесопилка
    call CheckAndAddBuilding(pi , 'oalt' , 3 , 6) // Алтарь
    if LoadInteger(AiData, pi, 'ostr') + LoadInteger(AiData, pi, 'ofrt') > 0 then // (pi,'ostr') or aiHasUnit(pi,'ofrt') then
        call CheckAndAddBuilding(pi , 'osld' , 15 , 10) // Обитель духов
        call CheckAndAddBuilding(pi , 'otto' , 15 , 10) // Мастерская
    endif
    call CheckAndAddBuilding(pi , 'osld' , 15 , 1) // Обитель духов
    call CheckAndAddBuilding(pi , 'otto' , 15 , 1) // Мастерская
    
    
    call CheckAndAddBuilding(pi , 'ovln' , 1 , 6) // Посольство
    // Выбираем случайный вариант из массива
    set gInt=GetRandomInt(1, tArray[0])
    return tArray[gInt]
endfunction

//***************************************************************************
//*  BuildingsHorde
function PereborBuildings_Horde takes integer id,integer pi,unit u returns nothing
    local boolean HasMage= GetPlayerTechResearched(Player(pi), 'R0E9', true)
    local boolean IronHorde= GetPlayerTechResearched(Player(pi), 'R0EA', true)
    
    // h0HO,ogre,otrb,orbr,obar,ofor,oalt,obea,osld,otto,owtw,ovln
    set tArray[0]=0
    // Barracks ogru,o029,o01N,orai,otau
    if id == 'obar' then
        
        if IronHorde then
            call AddUnit('o01N' , 2) // T2 Iron
        else
            call AddUnit('ogru' , 2) // T1
            if (LoadInteger(AiData, (pi ), ( 'ostr')) > 0) or (LoadInteger(AiData, (pi ), ( 'ofrt')) > 0) then // INLINED!!
                call AddUnit('o029' , 3) // T2
            endif
        endif

        if (LoadInteger(AiData, (pi ), ( 'ofrt')) > 0) then // INLINED!!
            call AddUnit('orai' , 5) // 
            call AddUnit('otau' , 5) // 
        endif
    // strel o01P,okod,o02B,ohun
    elseif id == 'obea' then
        
        if IronHorde then
            call AddUnit('o02B' , 2) // T2 Iron
        else
            call AddUnit('ohun' , 2) // T1
            if (LoadInteger(AiData, (pi ), ( 'ostr')) > 0) or (LoadInteger(AiData, (pi ), ( 'ofrt')) > 0) then // INLINED!!
                call AddUnit('o01P' , 3) // T2
            endif
        endif

        if (LoadInteger(AiData, (pi ), ( 'ofrt')) > 0) then // INLINED!!
            call AddUnit('okod' , 5) // 
        endif

    // Тиры
    elseif id == 'ogre' or id == 'ostr' or id == 'ofrt' then
        if LoadInteger(AiData, pi, 'opeo') < 25 then
            call IssueImmediateOrderById(u, 'opeo')
        endif
    // Обитель духов o01W,oshm,odoc
    elseif id == 'osld' then
        call AddUnit('oshm' , 4) // 
        call AddUnit('o01W' , 2) // M damage
        call AddUnit('oshm' , 4) // 
    // Мастерская h0CY,ocat,o022
    elseif id == 'otto' then
    
        call AddUnit('ocat' , 2)
        call AddUnit('o022' , 1)
        if IronHorde then
            call AddUnit('h0CY' , 2) // iron star
        endif

    
    // Алтарь oalt Obla,Ofar,Otch
    elseif id == 'oalt' then
        call CheckAndAddUnit(pi , 'Ofar' , 1 , 1)
        call CheckAndAddUnit(pi , 'Obla' , 1 , 1)
        call CheckAndAddUnit(pi , 'Otch' , 1 , 1)
    endif
    
    call aiOrderUnit(u)
endfunction
                
//  h0HO,h0D4,h0HN,h0HK
function aiNavalTrain_Horde takes unit u,integer pi returns nothing
    set udg_LocalInteger3=GetRandomInt(1, 2)
   
    if udg_LocalInteger3 == 1 then
        call IssueImmediateOrderById(u, 'h0HN')
    elseif udg_LocalInteger3 == 2 then
        call IssueImmediateOrderById(u, 'h0HK')
    endif
endfunction
           
