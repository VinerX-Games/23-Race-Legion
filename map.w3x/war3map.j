//===========================================================================
// Trigger: AK1T1
//===========================================================================
function Trig_AK1T1_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTrainedUnit()) == 'hfoo'
endfunction

function AT1Count takes player p returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local integer pi= GetPlayerId(p)
    set a[0]=0
    // Штормград простой
    
    if GetPlayerTechCount(p, 'R0H6', true) < 1 then
        set i=4
        //Stormwind common
        loop
                set a[0]=a[0] + 1
                set a[a[0]]='h0KD'
                set b=b + 1
                exitwhen b >= i
        endloop
    else
        //Stromwind blue
        set i=4
        loop
                set a[0]=a[0] + 1
                set a[a[0]]='h0LW'
                set b=b + 1
                exitwhen b >= i
        endloop
    
    endif
    
    //Лордеронец
    if GetPlayerTechCount(p, 'R0HH', true) < 1 then
        set i=1
        set b=1
        
        // интеграция лордеронцев
        if GetPlayerTechCount(p, 'R0HV', true) > 1 then
            set i=i + 2
        endif
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='h0KR'
            
            set b=b + 1
            exitwhen b >= i
        endloop
    endif
    //Stromgarge
    if GetPlayerTechCount(p, 'R0HJ', true) > 0 then
        set i=3
        set b=1
        
      
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='h0M9'
            
            set b=b + 1
            exitwhen b >= i
        endloop
    endif
    
    //Long Containment
    call SaveInteger(CommonHash, pi, StringHash("AT1_0"), a[0])
    set i=1
    loop
        
        
        call SaveInteger(CommonHash, pi, StringHash("AT1") + i, a[i])
        set i=i + 1
        
        exitwhen i > a[0]
    endloop
    
    
    
    
endfunction



function Trig_AK1T1_Actions takes nothing returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local player p= GetOwningPlayer(GetTriggerUnit())
    local location l= GetUnitRallyPoint(GetTriggerUnit())
    local unit u
    local integer pi= GetPlayerId(p)
    
    
    set i=LoadInteger(CommonHash, pi, StringHash("AT1_0"))
    set i=GetRandomInt(1, i)
    set b=LoadInteger(CommonHash, pi, ( StringHash("AT1") + i ))
    
    set u=ReplaceUnit(GetTrainedUnit() , b , bj_UNIT_STATE_METHOD_RELATIVE)
    
   
    //call UnitAddAbility(u,'OR00')
    //call SetUnitAbilityLevel(u,'OR00',35+udg_HordeLandPrice[pi])
    
    
     
    call UnitAddAbility(u, 'A17P')
    call IssuePointOrderLoc(u, "attack", l)
    call RemoveLocation(l)
    set p=null
    set u=null
endfunction

//===========================================================================
function InitTrig_AK1T1 takes nothing returns nothing
    set gg_trg_AK1T1=CreateTrigger()
    //call DisableTrigger(gg_trg_AK1T1)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_AK1T1, EVENT_PLAYER_UNIT_TRAIN_FINISH)
    call TriggerAddCondition(gg_trg_AK1T1, Condition(function Trig_AK1T1_Conditions))
    call TriggerAddAction(gg_trg_AK1T1, function Trig_AK1T1_Actions)
endfunction


//===========================================================================
// Trigger: AK1T2
//===========================================================================
function Trig_AK1T2_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTrainedUnit()) == 'h0K4'
endfunction

function AT2Count takes player p returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local integer pi= GetPlayerId(p)
    
    // Штормград простой
    set a[0]=0
    set i=4
    loop
            set a[0]=a[0] + 1
            set a[a[0]]='h0KC'
            set b=b + 1
            exitwhen b >= i
    endloop
    
    
    if GetPlayerTechCount(p, 'R0HB', true) == 1 and GetPlayerTechCount(p, 'R0HH', true) < 1 then
        //Pandaren
        set i=1
        set b=1
        //
        if GetPlayerTechCount(p, 'R0HE', true) + GetPlayerTechCount(p, 'R0HF', true) > 0 then
            set i=i + 2
        
        endif
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='o042'
            
            set b=b + 1
            exitwhen b >= i
        endloop
        
        
    endif
    
    //Long Containment
    call SaveInteger(CommonHash, pi, StringHash("AT2_0"), a[0])
    set i=1
    loop
        
        
        call SaveInteger(CommonHash, pi, StringHash("AT2") + i, a[i])
        set i=i + 1
        
        exitwhen i > a[0]
    endloop
    
    
    
    
endfunction



function Trig_AK1T2_Actions takes nothing returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local player p= GetOwningPlayer(GetTriggerUnit())
    local location l= GetUnitRallyPoint(GetTriggerUnit())
    local unit u
    local integer pi= GetPlayerId(p)
    
    
    set i=LoadInteger(CommonHash, pi, StringHash("AT2_0"))
    set i=GetRandomInt(1, i)
    set b=LoadInteger(CommonHash, pi, ( StringHash("AT2") + i ))
    
    set u=ReplaceUnit(GetTrainedUnit() , b , bj_UNIT_STATE_METHOD_RELATIVE)
    
   
    //call UnitAddAbility(u,'OR00')
    //call SetUnitAbilityLevel(u,'OR00',35+udg_HordeLandPrice[pi])
    
    
     
    call UnitAddAbility(u, 'A17P')
    call IssuePointOrderLoc(u, "attack", l)
    call RemoveLocation(l)
    set p=null
    set u=null
endfunction

//===========================================================================
function InitTrig_AK1T2 takes nothing returns nothing
    set gg_trg_AK1T2=CreateTrigger()
    //call DisableTrigger(gg_trg_AK1T2)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_AK1T2, EVENT_PLAYER_UNIT_TRAIN_FINISH)
    call TriggerAddCondition(gg_trg_AK1T2, Condition(function Trig_AK1T2_Conditions))
    call TriggerAddAction(gg_trg_AK1T2, function Trig_AK1T2_Actions)
endfunction


