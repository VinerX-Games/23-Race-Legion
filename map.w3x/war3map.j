    set gg_trg_K1TCav=CreateTrigger()
    call DisableTrigger(gg_trg_K1TCav)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_K1TCav, EVENT_PLAYER_UNIT_TRAIN_FINISH)
    call TriggerAddCondition(gg_trg_K1TCav, Condition(function Trig_K1TCav_Conditions))
    call TriggerAddAction(gg_trg_K1TCav, function Trig_K1TCav_Actions)
