function Trig_StartLobby_Func004Func001A takes nothing returns nothing
    call CameraSetupApplyForPlayer(true, gg_cam_GW1, GetEnumPlayer(), 0)
endfunction

function Trig_StartLobby_Func004C takes nothing returns boolean
    if ( not ( udg_LocalInteger == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_StartLobby_Func005Func001A takes nothing returns nothing
    call CameraSetupApplyForPlayer(true, gg_cam_GW2, GetEnumPlayer(), 0)
endfunction

function Trig_StartLobby_Func005C takes nothing returns boolean
    if ( not ( udg_LocalInteger == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_StartLobby_Func006Func001A takes nothing returns nothing
    call CameraSetupApplyForPlayer(true, gg_cam_GW3, GetEnumPlayer(), 0)
endfunction

function Trig_StartLobby_Func006C takes nothing returns boolean
    if ( not ( udg_LocalInteger == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_StartLobby_Func007Func001A takes nothing returns nothing
    call CameraSetupApplyForPlayer(true, gg_cam_GW4, GetEnumPlayer(), 0)
endfunction

function Trig_StartLobby_Func007C takes nothing returns boolean
    if ( not ( udg_LocalInteger == 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_StartLobby_Func008Func001A takes nothing returns nothing
    call CameraSetupApplyForPlayer(true, gg_cam_GW5, GetEnumPlayer(), 0)
endfunction

function Trig_StartLobby_Func008C takes nothing returns boolean
    if ( not ( udg_LocalInteger == 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_StartLobby_Func015Func003C takes nothing returns boolean
    if ( not ( GetEnumPlayer() != Player(0) ) ) then
        return false
    endif
    return true
endfunction

function Trig_StartLobby_Func015A takes nothing returns nothing
    call CameraSetupApplyForPlayer(true, gg_cam_HostRegion, GetEnumPlayer(), 0)
    call SetCameraFieldForPlayer(GetEnumPlayer(), CAMERA_FIELD_TARGET_DISTANCE, 3400.00, 0.00)
    if ( Trig_StartLobby_Func015Func003C() ) then
        set udg_LocalPosition2=GetRandomLocInRect(gg_rct_HostRegion)
        call CreateNUnitsAtLoc(1, 'h0GA', GetEnumPlayer(), udg_LocalPosition2, bj_UNIT_FACING)
        call RemoveLocation(udg_LocalPosition2)
    else
    endif
endfunction

function Trig_StartLobby_Actions takes nothing returns nothing
    set udg_LocalPosition2=GetRectCenter(gg_rct_HostRegion)
    set udg_LocalInteger=GetRandomInt(1, 5)
    if ( Trig_StartLobby_Func004C() ) then
        call ForForce(udg_AllPlayers, function Trig_StartLobby_Func004Func001A)
    else
    endif
    if ( Trig_StartLobby_Func005C() ) then
        call ForForce(udg_AllPlayers, function Trig_StartLobby_Func005Func001A)
    else
    endif
    if ( Trig_StartLobby_Func006C() ) then
        call ForForce(udg_AllPlayers, function Trig_StartLobby_Func006Func001A)
    else
    endif
    if ( Trig_StartLobby_Func007C() ) then
        call ForForce(udg_AllPlayers, function Trig_StartLobby_Func007Func001A)
    else
    endif
    if ( Trig_StartLobby_Func008C() ) then
        call ForForce(udg_AllPlayers, function Trig_StartLobby_Func008Func001A)
    else
    endif
    set udg_LocalInteger=4
    call DisplayTimedTextToForce(GetPlayersAll(), I2R(udg_LocalInteger), "TRIGSTR_10982")
    set udg_LocalInteger=( udg_LocalInteger - 3 )
    call TriggerSleepAction(I2R(udg_LocalInteger))
    call ForForce(udg_AllPlayers, function Trig_StartLobby_Func015A)
    call RemoveLocation(udg_LocalPosition2)
    call StartTimerBJ(udg_LobbyTime, false, 60.00)
    call CreateTimerDialogBJ(GetLastCreatedTimerBJ(), "TRIGSTR_19360")
    set udg_LobbyTimerWindows=GetLastCreatedTimerDialogBJ()
    call CreateNUnitsAtLoc(1, 'n04G', Player(0), GetRectCenter(GetPlayableMapRect()), bj_UNIT_FACING)
    set ModeBuilding=GetLastCreatedUnit()
    call SelectUnitForPlayerSingle(GetLastCreatedUnit(), Player(0))
endfunction

//===========================================================================
function InitTrig_StartLobby takes nothing returns nothing
    set gg_trg_StartLobby=CreateTrigger()
    call TriggerRegisterTimerEventSingle(gg_trg_StartLobby, 0.01)
    call TriggerAddAction(gg_trg_StartLobby, function Trig_StartLobby_Actions)
endfunction

//===========================================================================
// Trigger: EndLobby and Start game
//===========================================================================
function Trig_EndLobby_and_Start_game_Func004Func006C takes nothing returns boolean
    if ( not ( udg_Continents[0] == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_EndLobby_and_Start_game_Func004A takes nothing returns nothing
    call CreateRaceCircles(GetEnumPlayer())
    call ClearAllies(GetEnumPlayer())
    call CreateArmyBonusUnit(GetEnumPlayer())
    call FogModifierStop(udg_Visibl[GetConvertedPlayerId(GetEnumPlayer())])
    call DestroyFogModifier(udg_Visibl[GetConvertedPlayerId(GetEnumPlayer())])
    if ( Trig_EndLobby_and_Start_game_Func004Func006C() ) then
        call CreateFogModifierRectBJ(true, GetEnumPlayer(), FOG_OF_WAR_VISIBLE, GetPlayableMapRect())
        call FogModifierStop(GetLastCreatedFogModifier())
        call DestroyFogModifier(GetLastCreatedFogModifier())
    else
        call ConditionalTriggerExecute(gg_trg_SeeOnlyNeedeed)
    endif
endfunction

function Trig_EndLobby_and_Start_game_Func005A takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_EndLobby_and_Start_game_Actions takes nothing returns nothing
    call TimerDialogDisplayBJ(false, udg_LobbyTimerWindows)
    call DestroyTimerDialogBJ(udg_LobbyTimerWindows)
    call DisplayTextToForce(GetPlayersAll(), "TRIGSTR_19369")
    call ForForce(udg_AllPlayers, function Trig_EndLobby_and_Start_game_Func004A)
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_HostReg2), function Trig_EndLobby_and_Start_game_Func005A)
    call DisableTrigger(gg_trg_SaveSelection)
    call BlzEnableSelections(true, true)
    call RemoveUnit(ModeBuilding) // INLINED!!
    call ConditionalTriggerExecute(gg_trg_StartDal)
    call ConditionalTriggerExecute(gg_trg_NaxStart)
    call ConditionalTriggerExecute(gg_trg_TurtleStart)
    call aiStart()
endfunction

