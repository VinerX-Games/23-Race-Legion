    set gg_trg_EndLobby_and_Start_game=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_EndLobby_and_Start_game, udg_LobbyTime)
    call TriggerAddAction(gg_trg_EndLobby_and_Start_game, function Trig_EndLobby_and_Start_game_Actions)
endfunction

