function Trig_Continents_set_On_Actions takes nothing returns nothing
    set udg_LocalText2=( "Режим континентов:|cffffff00 включен|r" )
    call DisplayTextToForce(GetPlayersAll(), udg_LocalText2)
    set udg_LocalText2="|cff00ff00Итого доступны для игры: |r"
