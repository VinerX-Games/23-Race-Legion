function Trig_TurnAi_Actions takes nothing returns nothing
    if not IsTriggerEnabled(gg_trg_OchetStart) then
        call EnableTrigger(gg_trg_OchetStart)
        call EnableTrigger(gg_trg_OchetEnd)
        call EnableTrigger(gg_trg_PereborPlayersForBuilders)
        call EnableTrigger(gg_trg_PereborBuilders_Uni)
        call EnableTrigger(gg_trg_PereborPlayerForArmy)
        call EnableTrigger(gg_trg_PerebobArmy_Uni)
        call EnableTrigger(gg_trg_PereborPlayerForNavy)
        call EnableTrigger(gg_trg_PereborBuildings)
        call EnableTrigger(gg_trg_PerebobNavy)
        call EnableTrigger(gg_trg_Strateg)
        call EnableTrigger(gg_trg_AttackerAi)
        call EnableTrigger(gg_trg_AttackedAI)
        call EnableTrigger(gg_trg_GetLvl)
        call EnableTrigger(gg_trg_Revive)
        call EnableTrigger(gg_trg_PereborNavalBases)
        
        call EnableTrigger(gg_trg_JoinAll)
        call EnableTrigger(gg_trg_JoinBuildings)
        call EnableTrigger(gg_trg_UpgradeBuildings)
        call EnableTrigger(gg_trg_EndBuilding)
        call EnableTrigger(gg_trg_CheckType)
        call EnableTrigger(gg_trg_CheckOrderType)
        call EnableTrigger(gg_trg_PortUnits)
        call EnableTrigger(gg_trg_Leave_Army_U)
        call EnableTrigger(gg_trg_Leave_Navy_U)
        call EnableTrigger(gg_trg_Leave_Harvest_U)
        call EnableTrigger(gg_trg_Leave_Builders_U)
        call EnableTrigger(gg_trg_Leave_BuildersT_U)
        call EnableTrigger(gg_trg_Leave_Buildings_U)
        call EnableTrigger(gg_trg_CheckType)
        call EnableTrigger(gg_trg_CheckOrderType)
        
    endif
    
    
endfunction

