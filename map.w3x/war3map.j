    call SetPlayerAbilityAvailableBJ(true, 'A07L', GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerAbilityAvailableBJ(false, 'A037', GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerAbilityAvailableBJ(true, 'A07K', GetOwningPlayer(GetTriggerUnit()))
    //                           
    call SetPlayerAbilityAvailableBJ(true, 'A07P', GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerAbilityAvailableBJ(true, 'A07Q', GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerAbilityAvailableBJ(true, 'A07N', GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerAbilityAvailableBJ(true, 'A07O', GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerAbilityAvailableBJ(true, 'A02G', GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerAbilityAvailableBJ(true, 'A07D', GetOwningPlayer(GetTriggerUnit()))
    //                           
    call SetPlayerAbilityAvailableBJ(false, 'A07M', GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerAbilityAvailableBJ(false, 'A07S', GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerAbilityAvailableBJ(true, 'A07R', GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerAbilityAvailableBJ(false, 'A07T', GetOwningPlayer(GetTriggerUnit()))
    //                           
    call SetPlayerAbilityAvailableBJ(false, 'A02J', GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerAbilityAvailableBJ(false, 'A00W', GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerAbilityAvailableBJ(false, 'A030', GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerAbilityAvailableBJ(false, 'A02Z', GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerAbilityAvailableBJ(false, 'A02R', GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerAbilityAvailableBJ(false, 'A02G', GetOwningPlayer(GetTriggerUnit()))
    //                           
    call SetPlayerTechMaxAllowedSwap('R03D', 1, GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerTechMaxAllowedSwap('R03C', 1, GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerTechMaxAllowedSwap('R025', 1, GetOwningPlayer(GetTriggerUnit()))
endfunction

