//===========================================================================
function Trig_Timer_Func009Func001A takes nothing returns nothing
    call SetPlayerAbilityAvailableBJ(false, 'A0IQ', GetEnumPlayer())
endfunction

function Trig_Timer_Func009C takes nothing returns boolean
    if ( not ( udg_GameMode == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Timer_Actions takes nothing returns nothing
    set udg_AllPlayers=GetPlayersAll()
    call StartTimerBJ(udg_IncomeTimerSecond, true, I2R(udg_SET_TimerTime))
    call CreateTimerDialogBJ(GetLastCreatedTimerBJ(), "TRIGSTR_4633")
    set udg_TimerSecond=GetLastCreatedTimerDialogBJ()
    call StartTimerBJ(udg_IncomeTimerFirst, false, 600.00)
    call CreateTimerDialogBJ(GetLastCreatedTimerBJ(), "TRIGSTR_7397")
    set udg_TimerToDis=GetLastCreatedTimerDialogBJ()
    if ( Trig_Timer_Func009C() ) then
        call ForForce(udg_AllPlayers, function Trig_Timer_Func009Func001A)
    else
    endif
endfunction

