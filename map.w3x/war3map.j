//===========================================================================
function Trig_Spell_E_Copy_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A1DA' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Spell_E_Copy_Actions takes nothing returns nothing
    set udg_MUI_E_Glaz=( udg_MUI_E_Glaz + 1 )
    set udg_Antibag_E_Glaz[udg_MUI_E_Glaz]=( udg_Antibag_E_Glaz[udg_MUI_E_Glaz] + 1 )
    set udg_Cikl_E_Glaz=0
    set udg_Dalnost_E_Glaz[udg_MUI_E_Glaz]=0.00
    set udg_Caster_E_Glaz[udg_MUI_E_Glaz]=GetTriggerUnit()
    call SetUnitPathing(udg_Caster_E_Glaz[udg_MUI_E_Glaz], false)
    call PauseUnitBJ(true, udg_Caster_E_Glaz[udg_MUI_E_Glaz])
    call SetUnitAnimation(udg_Caster_E_Glaz[udg_MUI_E_Glaz], "attack walk stand spin")
    set udg_Logika_E_Glaz[udg_MUI_E_Glaz]=true
    call StartTimerBJ(udg_Timer_E_Glaz, true, 0.03)
endfunction

