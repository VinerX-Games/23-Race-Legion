    if ( Trig_FarmTier3_Res_Func002Func002Func002C() ) then
        return true
    endif
    if ( Trig_FarmTier3_Res_Func002Func002Func003C() ) then
        return true
    endif
    return false
endfunction

function Trig_FarmTier3_Res_Func002C takes nothing returns boolean
    if ( not ( udg_TierLevel[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] <= 2 ) ) then
        return false
    endif
    if ( not Trig_FarmTier3_Res_Func002Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_FarmTier3_Res_Conditions takes nothing returns boolean
    if ( not Trig_FarmTier3_Res_Func002C() ) then
        return false
    endif
    return true
endfunction

