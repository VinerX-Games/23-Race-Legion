//===========================================================================
// Trigger: BlinkToUnit attack
//===========================================================================
function Trig_BlinkToUnit_attack_Conditions takes nothing returns boolean
    return GetUnitAbilityLevel(GetAttacker(), 'A0MZ') >= 1 and BlzGetUnitAbilityCooldownRemaining(GetAttacker(), 'A0MZ') == 0
endfunction


function MoveTimedEnd takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer id= GetHandleId(t)

    call SetUnitPositionLoc(LoadUnitHandle(Hash, id, 1), LoadLocationHandle(Hash, id, 2))
       
    call RemoveLocation(LoadLocationHandle(Hash, id, 2))
    call DestroyTimer(t)
    set t=null
    
    
endfunction

function MoveTimed takes unit u,location l,real time returns nothing
    local timer t= CreateTimer()
    local integer id= GetHandleId(t)
    
    call SaveUnitHandle(Hash, id, 1, u)
    call SaveLocationHandle(Hash, id, 2, l)
    call TimerStart(t, time, false, function MoveTimedEnd)
    
    set t=null
endfunction



function MoveWithOrderTimedEnd takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer id= GetHandleId(t)

    call SetUnitPositionLoc(LoadUnitHandle(Hash, id, 1), LoadLocationHandle(Hash, id, 2))
    call IssueTargetOrder(LoadUnitHandle(Hash, id, 1), LoadStr(Hash, id, 4), LoadUnitHandle(Hash, id, 3))
    
    call RemoveLocation(LoadLocationHandle(Hash, id, 2))
    call DestroyTimer(t)
    set t=null
    
    
endfunction

function MoveWithOrderTimed takes unit u,unit target,location l,string order,real time returns nothing
    local timer t= CreateTimer()
    local integer id= GetHandleId(t)
    
    call SaveUnitHandle(Hash, id, 1, u)
    call SaveLocationHandle(Hash, id, 2, l)
    call SaveUnitHandle(Hash, id, 3, target)
    call SaveStr(Hash, id, 4, order)
    call TimerStart(t, time, false, function MoveWithOrderTimedEnd)
 
    set t=null
endfunction



function Trig_BlinkToUnit_attack_Actions takes nothing returns nothing
    set gUnit=GetAttacker()

//
//    call IssueTargetOrderBJ( gUnit, "attack", GetAttackedUnitBJ() )
//    call UnitAddAbility( 'A0N0', gUnit )
//    call SetUnitAbilityLevelSwapped( 'A0N0', gUnit, GetUnitAbilityLevelSwapped('A0MZ', gUnit) )
//    call UnitAddAbility( 'A0N2', gUnit )
//    call SetUnitAbilityLevelSwapped( 'A0N2', gUnit, GetUnitAbilityLevelSwapped('A0MZ', gUnit) )
//    call UnitRemoveAbility( 'A0MZ', gUnit )
//    
    call MoveWithOrderTimed(gUnit , GetTriggerUnit() , GetUnitLoc(GetTriggerUnit()) , "attack" , 0.1)
    call DummyCastTargetLevel('A1MY' , "shadowstrike" , gUnit , GetTriggerUnit() , GetUnitAbilityLevel(gUnit, 'A0MZ'))
    
    call BlzStartUnitAbilityCooldown(gUnit, 'A0MZ', 3)
//    call UnitAddAbilityBJ( 'A0MZ', gUnit )
//    call SetUnitAbilityLevelSwapped( 'A0MZ', gUnit, GetUnitAbilityLevelSwapped('A0N0', gUnit) )
//    call UnitRemoveAbilityBJ( 'A0N0', gUnit )
//    call UnitRemoveAbilityBJ( 'A0N2', gUnit )
endfunction

