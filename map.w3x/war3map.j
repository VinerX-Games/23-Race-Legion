    call ForGroupBJ(GetUnitsInRectAll(gg_rct_TurtleIsland), function Trig_NaxDiy_Func002A)
    call ForGroupBJ(GetUnitsOfTypeIdAll('n075'), function Trig_NaxDiy_Func003A)
    call DisableTrigger(GetTriggeringTrigger())
endfunction

