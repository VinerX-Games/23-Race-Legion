//===========================================================================
function Trig_FastKokon_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0ML'
endfunction

function Trig_FastKokon_Actions takes nothing returns nothing
    set gUnit=GetTriggerUnit()
    call SetUnitTimeScale(gUnit, 1)
    call KillUnit(gUnit)
    call CreateUnit(GetOwningPlayer(gUnit), 'e02W', GetUnitX(gUnit), GetUnitY(gUnit), 0.0)
    call CreateUnit(GetOwningPlayer(gUnit), 'e02W', GetUnitX(gUnit), GetUnitY(gUnit), 0.0)
    call CreateUnit(GetOwningPlayer(gUnit), 'e02W', GetUnitX(gUnit), GetUnitY(gUnit), 0.0)
endfunction

