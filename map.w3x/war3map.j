    call DisplayTextToPlayer(( GetOwningPlayer(GetTriggerUnit()) ), 0, 0, ( "Ваш флагман |cffff0000уничтожен.|r" ))
    call SetPlayerAbilityAvailableBJ(true, 'A009', GetOwningPlayer(GetTriggerUnit()))
