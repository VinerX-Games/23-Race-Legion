function createAiPlayer takes integer pi returns nothing
    set gPlayer=Player(pi)
    call TriggerExecute(gg_trg_TurnAi)
    
   
    set udg_AiControl[pi]=true
    call ForceAddPlayerSimple(gPlayer, udg_Bots)
    // Обычное появление и ресы
   
    //Задаю место

    set udg_LocalPoint=(StartLoc[GetRandomInt(0, StartLocCount - 1)]) // INLINED!!

    // Раса аи
    set gInt=GetRandomInt(1, 5)
    
    //Алый орден
    if gInt == 1 then
        call startScarlet(pi)
    elseif gInt == 2 then
        call startBloodElves(pi)
    elseif gInt == 3 then
        call startGoblins(pi)
    elseif gInt == 4 then
        call startNaga(pi)
    else
        call startHorde(pi)
    endif
    
    set udg_LocalText2=GetPlayerName(gPlayer)
    set udg_LocalText2=( ( I2S(pi + 1) + ". " ) + udg_LocalText2 )
    call MultiboardSetItemValue(MultiboardItem[MultiboardItemOwnerIndex[pi] * 2 + 0], udg_LocalText2)
    
    
    
    // Создает юнита с аурами
    set BonusUnit[pi]=CreateUnitAtLoc(gPlayer, 'aiu0', udg_LocalPoint, bj_UNIT_FACING)
    call UnitAddAbility(BonusUnit[pi], 'aib0')
    call UnitAddAbility(BonusUnit[pi], 'aib1')
    
    call CreateArmyBonusUnit(gPlayer)
    
    //Лимиты
    call SetLimits(gPlayer)
    call AiLimitsSet()
    
    
    call SetPlayerStateBJ(gPlayer, PLAYER_STATE_RESOURCE_GOLD, 5000)
    call SetPlayerStateBJ(gPlayer, PLAYER_STATE_RESOURCE_LUMBER, 5000)
    call SetBools()
    call TriggerExecute(gg_trg_CityNearWater2)
    
    // Данные ИИшки
    // Таймеры ИИ
    
    call StartTimerBJ(udg_TimerSmall, false, 1.11 * AiRepeat / 5)
    call StartTimerBJ(udg_TimerSmall2, false, 2.12 * AiRepeat / 5)
    call StartTimerBJ(udg_TimerSmall3, false, 3.13 * AiRepeat / 5)
    call StartTimerBJ(udg_TimerSmall4, false, 4.14 * AiRepeat / 5)
    call StartTimerBJ(udg_AiTimerStrateg, true, 15.15 * AiRepeat / 5)
    call StartTimerBJ(udg_TimerToChangeAi, false, 600.00)
    call TimerStart(aiFixer, 1800.00, true, null)
endfunction


