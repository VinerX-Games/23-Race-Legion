    return GetSpellAbilityId() == 'A02D' and GetPlayerTechCount(GetOwningPlayer(GetTriggerUnit()), 'R01G', true) == 3 and GetUnitAbilityLevel(GetSpellTargetUnit(), 'A1QZ') < 1 // and GetUnitAbilityLevel(GetSpellTargetUnit(), 'B00U')<1
