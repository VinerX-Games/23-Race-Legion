function GetLvlHorde takes unit u returns nothing
    // Герои Obla,Ofar,Otch
        // A12F,AOwk,AOcr,AOww
        if GetUnitTypeId(u) == 'Obla' then
                set gInt=GetRandomInt(1, 3)
                if GetHeroLevel(u) == 6 or GetHeroLevel(u) == 10 then
                    call SelectHeroSkill(u, 'AOww')
                elseif gInt == 1 then
                    call SelectHeroSkill(u, 'A12F')
                elseif gInt == 2 then
                    call SelectHeroSkill(u, 'A12F')
                elseif gInt == 2 then
                    call SelectHeroSkill(u, 'AOcr')
                else
                    //call SelectHeroSkill( u, 'A0D5' )
                endif
        //AOfs,AOsf,AOcl,A12E
        elseif GetUnitTypeId(u) == 'Ofar' then
                set gInt=GetRandomInt(0, 3)
                if gInt == 0 then
                    call SelectHeroSkill(u, 'A12E')
                elseif gInt == 1 then
                    call SelectHeroSkill(u, 'AOcl')
                elseif gInt == 2 then
                    call SelectHeroSkill(u, 'AOsf')
                else
                    call SelectHeroSkill(u, 'AOfs')
                endif

        // A026,AOr2,AOre,AOw2
        elseif GetUnitTypeId(u) == 'Otch' or GetUnitTypeId(u) == 'O02Z' then
                set gInt=GetRandomInt(1, 3)
                if GetHeroLevel(u) == 6 or GetHeroLevel(u) == 10 then
                    call SelectHeroSkill(u, 'AOre')
                elseif gInt == 1 then
                    call SelectHeroSkill(u, 'AOre')
                elseif gInt == 2 then
                    call SelectHeroSkill(u, 'AOr2')
                else
                    call SelectHeroSkill(u, 'A026')
                endif
        endif
endfunction
