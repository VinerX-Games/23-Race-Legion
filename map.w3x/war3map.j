//===========================================================================
// Trigger: ChoseLich
//===========================================================================
function Trig_ChoseLich_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A0SW' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0T1' ) ) then
        return true
    endif
    return false
endfunction

function Trig_ChoseLich_Conditions takes nothing returns boolean
    if ( not Trig_ChoseLich_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_ChoseLich_Func003002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetFilterUnit()) == 'e01I' )
endfunction

function Trig_ChoseLich_Func003002002 takes nothing returns boolean
    return ( GetOwningPlayer(GetTriggerUnit()) == GetOwningPlayer(GetFilterUnit()) )
endfunction

function Trig_ChoseLich_Func003002 takes nothing returns boolean
    return GetBooleanAnd((GetUnitTypeId(GetFilterUnit()) == 'e01I'), (GetOwningPlayer(GetTriggerUnit()) == GetOwningPlayer(GetFilterUnit()))) // INLINED!!
endfunction

function Trig_ChoseLich_Func005Func002A takes nothing returns nothing
    call SelectUnitAddForPlayer(GetEnumUnit(), GetOwningPlayer(GetTriggerUnit()))
endfunction

function Trig_ChoseLich_Func005C takes nothing returns boolean
    if ( not ( IsUnitGroupEmptyBJ(udg_LocalOtrad2) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ChoseLich_Actions takes nothing returns nothing
    set udg_LocalPosition2=GetUnitLoc(GetTriggerUnit())
    set udg_Boolexpr=Condition(function Trig_ChoseLich_Func003002)
    call GroupEnumUnitsInRangeOfLoc(udg_LocalOtrad2, udg_LocalPosition2, 1200, udg_Boolexpr)
    if ( Trig_ChoseLich_Func005C() ) then
    else
        call ClearSelectionForPlayer(GetOwningPlayer(GetTriggerUnit()))
        call ForGroupBJ(udg_LocalOtrad2, function Trig_ChoseLich_Func005Func002A)
    endif
    call GroupClear(udg_LocalOtrad2)
    call RemoveLocation(udg_LocalPosition2)
endfunction

//===========================================================================
function InitTrig_ChoseLich takes nothing returns nothing
    set gg_trg_ChoseLich=CreateTrigger()
    call DisableTrigger(gg_trg_ChoseLich)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ChoseLich, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_ChoseLich, Condition(function Trig_ChoseLich_Conditions))
    call TriggerAddAction(gg_trg_ChoseLich, function Trig_ChoseLich_Actions)
endfunction

