//===========================================================================
// Trigger: K1TCav
//===========================================================================
function Trig_K1TCav_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTrainedUnit()) == 'orai'
endfunction

function Trig_K1TCav_Actions takes nothing returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local player p= GetOwningPlayer(GetTriggerUnit())
    local location l= GetUnitRallyPoint(GetTriggerUnit())
    local unit u
    local integer pi= GetPlayerId(p)
    
    
    //1 юнит
    set a[0]=0
    
    set b=0
    set i=3
    loop //Орк
            set a[0]=a[0] + 1
            set a[a[0]]='o027'
            set b=b + 1
            exitwhen b >= i
    endloop
    
    //3 юнит - эльфы
    if GetPlayerTechCount(p, 'R0D2', true) == 1 and GetPlayerTechCount(p, 'R0E9', true) != 1 then
        set i=1
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='o02H'
            
            set b=b + 1
            exitwhen b >= i
        endloop

    endif
    
    //Драконья пасть
    if GetPlayerTechCount(p, 'R0E1', true) == 1 and GetPlayerTechCount(p, 'R0EH', true) < 1 then
        set i=1
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='o01Z'
            
            set b=b + 1
            exitwhen b >= i
        endloop

    endif
    //Магнатавр
    if GetPlayerTechCount(p, 'R0E5', true) == 1 then
        set i=1
        set b=1
        
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='o02E'
            
            set b=b + 1
            exitwhen b >= i
        endloop

    endif
    
    
    
    
    set i=GetRandomInt(1, a[0])
    set b=a[i]
    
    set u=ReplaceUnit(GetTrainedUnit() , b , bj_UNIT_STATE_METHOD_RELATIVE)
    

    call UnitAddAbility(u, 'OR00')
    call SetUnitAbilityLevel(u, 'OR00', 35 + udg_HordeLandPrice[pi])
    
    
    set udg_UnitsCount[pi]=udg_UnitsCount[pi] - 1
    call UnitAddAbility(u, 'A0YU')

    call IssuePointOrderLoc(u, "attack", l)
    call RemoveLocation(l)
    set p=null
    set u=null
endfunction

