//===========================================================================
// Trigger: Upgrade Kontrol
//===========================================================================
function Trig_Upgrade_Kontrol_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0VQ' ) ) then
        return false
    endif
    if ( not ( IsUnitSelected(GetTriggerUnit(), GetOwningPlayer(GetTriggerUnit())) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Upgrade_Kontrol_Actions takes nothing returns nothing
    call UnitAddAbilityBJ('A0TW', GetTriggerUnit())
    call BlzUnitDisableAbility(GetTriggerUnit(), 'A0TV', true, true)
    call BlzSetUnitRealFieldBJ(GetTriggerUnit(), UNIT_RF_SIGHT_RADIUS, 6500.00)
    call UnitAddTypeBJ(UNIT_TYPE_FLYING, GetTriggerUnit())
    call UnitRemoveAbilityBJ('A0VJ', GetTriggerUnit())
    
    
    call UnitAddAbilityBJ('A1M5', GetTriggerUnit())
    call BlzStartUnitAbilityCooldown(GetTriggerUnit(), 'A1M5', 5)
    call RemoveAbilityTimed(GetTriggerUnit() , 'A1M5' , 5)
    call AddAbilityTimed(GetTriggerUnit() , 'A146' , 5)
    
endfunction

//===========================================================================
function InitTrig_Upgrade_Kontrol takes nothing returns nothing
    set gg_trg_Upgrade_Kontrol=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Upgrade_Kontrol, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Upgrade_Kontrol, Condition(function Trig_Upgrade_Kontrol_Conditions))
    call TriggerAddAction(gg_trg_Upgrade_Kontrol, function Trig_Upgrade_Kontrol_Actions)
endfunction


