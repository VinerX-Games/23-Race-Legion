endfunction

//===========================================================================
// Trigger: Spell E Dvij
//===========================================================================
function Trig_Spell_E_Dvij_Func001Func001Func007Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(udg_Caster_E_Glaz[udg_Cikl_E_Glaz])) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAlly(GetEnumUnit(), GetOwningPlayer(udg_Caster_E_Glaz[udg_Cikl_E_Glaz])) == false ) ) then
        return false
    endif
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_Group_E_Glaz[udg_Cikl_E_Glaz]) == false ) ) then
        return false
    endif
    if ( not ( IsUnitDeadBJ(GetEnumUnit()) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Spell_E_Dvij_Func001Func001Func007A takes nothing returns nothing
    if ( Trig_Spell_E_Dvij_Func001Func001Func007Func001C() ) then
        call UnitDamageTargetBJ(udg_Caster_E_Glaz[udg_Cikl_E_Glaz], GetEnumUnit(), ( 50.00 * I2R(GetUnitAbilityLevelSwapped('A1DA', udg_Caster_E_Glaz[udg_Cikl_E_Glaz])) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL)
        call GroupAddUnitSimple(GetEnumUnit(), udg_Group_E_Glaz[udg_Cikl_E_Glaz])
    else
    endif
endfunction

function Trig_Spell_E_Dvij_Func001Func001Func008Func001C takes nothing returns boolean
    if ( ( IsUnitDeadBJ(udg_Caster_E_Glaz[udg_Cikl_E_Glaz]) == true ) ) then
        return true
    endif
    if ( ( udg_Dalnost_E_Glaz[udg_Cikl_E_Glaz] == 0.20 ) ) then
        return true
    endif
    return false
endfunction

function Trig_Spell_E_Dvij_Func001Func001Func008Func008C takes nothing returns boolean
    if ( not ( udg_Antibag_E_Glaz[udg_MUI_E_Glaz] == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Spell_E_Dvij_Func001Func001Func008C takes nothing returns boolean
    if ( not Trig_Spell_E_Dvij_Func001Func001Func008Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Spell_E_Dvij_Func001Func001C takes nothing returns boolean
    if ( not ( udg_Logika_E_Glaz[udg_Cikl_E_Glaz] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Spell_E_Dvij_Actions takes nothing returns nothing
    set udg_Cikl_E_Glaz=1
    loop
        exitwhen udg_Cikl_E_Glaz > udg_MUI_E_Glaz
        if ( Trig_Spell_E_Dvij_Func001Func001C() ) then
            set udg_Dalnost_E_Glaz[udg_Cikl_E_Glaz]=( udg_Dalnost_E_Glaz[udg_Cikl_E_Glaz] + 0.02 )
            set udg_To4kaCaster_E_Glaz[udg_Cikl_E_Glaz]=GetUnitLoc(udg_Caster_E_Glaz[udg_Cikl_E_Glaz])
            call SetUnitPositionLoc(udg_Caster_E_Glaz[udg_Cikl_E_Glaz], PolarProjectionBJ(udg_To4kaCaster_E_Glaz[udg_Cikl_E_Glaz], 60.00, GetUnitFacing(udg_Caster_E_Glaz[udg_Cikl_E_Glaz])))
            call AddSpecialEffectLocBJ(udg_To4kaCaster_E_Glaz[udg_Cikl_E_Glaz], "Cosmic Ball.mdx")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
            set bj_wantDestroyGroup=true
            call ForGroupBJ(GetUnitsInRangeOfLocAll(150.00, udg_To4kaCaster_E_Glaz[udg_Cikl_E_Glaz]), function Trig_Spell_E_Dvij_Func001Func001Func007A)
            if ( Trig_Spell_E_Dvij_Func001Func001Func008C() ) then
                call GroupClear(udg_Group_E_Glaz[udg_Cikl_E_Glaz])
                call SetUnitPathing(udg_Caster_E_Glaz[udg_Cikl_E_Glaz], true)
                call PauseUnitBJ(false, udg_Caster_E_Glaz[udg_Cikl_E_Glaz])
                set udg_Dalnost_E_Glaz[udg_Cikl_E_Glaz]=0.00
                set udg_Logika_E_Glaz[udg_Cikl_E_Glaz]=false
                set udg_Antibag_E_Glaz[udg_Cikl_E_Glaz]=( udg_Antibag_E_Glaz[udg_Cikl_E_Glaz] - 1 )
                if ( Trig_Spell_E_Dvij_Func001Func001Func008Func008C() ) then
                    call PauseTimerBJ(true, udg_Timer_E_Glaz)
                    set udg_MUI_E_Glaz=0
                else
                endif
            else
            endif
            call RemoveLocation(udg_To4kaCaster_E_Glaz[udg_Cikl_E_Glaz])
        else
        endif
        set udg_Cikl_E_Glaz=udg_Cikl_E_Glaz + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Spell_E_Dvij takes nothing returns nothing
    set gg_trg_Spell_E_Dvij=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_Spell_E_Dvij, udg_Timer_E_Glaz)
    call TriggerAddAction(gg_trg_Spell_E_Dvij, function Trig_Spell_E_Dvij_Actions)
endfunction

