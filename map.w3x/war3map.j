//===========================================================================
// Trigger: FeodalDead
//===========================================================================
function Trig_FeodalDead_Conditions takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetTriggerUnit(), udg_StolicaGroups) == true ) ) then
        return false
    endif
    if ( not ( GetUnitLifePercent(GetTriggerUnit()) <= 15.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_FeodalDead_Func004Func002Func001Func010Func001Func003C takes nothing returns boolean
    if ( not ( IsPlayerInForce(GetOwningPlayer(GetTriggerUnit()), udg_Vassals[GetForLoopIndexB()]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_FeodalDead_Func004Func002Func001Func010A takes nothing returns nothing
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=24
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call SetPlayerAllianceStateBJ(GetEnumPlayer(), ConvertedPlayer(GetForLoopIndexB()), bj_ALLIANCE_UNALLIED)
        call SetPlayerAllianceStateBJ(ConvertedPlayer(GetForLoopIndexB()), GetEnumPlayer(), bj_ALLIANCE_UNALLIED)
        if ( Trig_FeodalDead_Func004Func002Func001Func010Func001Func003C() ) then
            call ForceRemovePlayerSimple(GetOwningPlayer(GetTriggerUnit()), udg_Vassals[GetForLoopIndexB()])
        else
        endif
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
    call ForceAddPlayerSimple(GetEnumPlayer(), udg_Vassals[GetConvertedPlayerId(ConvertedPlayer(GetForLoopIndexA()))])
    call SetPlayerAllianceStateBJ(GetEnumPlayer(), GetOwningPlayer(GetAttacker()), bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(GetEnumPlayer(), ConvertedPlayer(GetForLoopIndexA()), bj_ALLIANCE_ALLIED_UNITS)
    call SetPlayerAllianceStateBJ(GetOwningPlayer(GetAttacker()), GetEnumPlayer(), bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(ConvertedPlayer(GetForLoopIndexA()), GetEnumPlayer(), bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(GetOwningPlayer(GetAttacker()), GetEnumPlayer(), bj_ALLIANCE_ALLIED_VISION)
    call DisplayTextToForce(GetPlayersAll(), ( GetPlayerName(GetEnumPlayer()) + ( " - стал вассалом игрока " + GetPlayerName(ConvertedPlayer(GetForLoopIndexA())) ) ))
endfunction

function Trig_FeodalDead_Func004Func002Func001C takes nothing returns boolean
    if ( not ( IsPlayerInForce(GetOwningPlayer(GetAttacker()), udg_Vassals[GetForLoopIndexA()]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_FeodalDead_Func004Func011A takes nothing returns nothing
    call DisplayTextToForce(GetPlayersAll(), ( GetPlayerName(GetEnumPlayer()) + ( " - стал вассалом игрока " + GetPlayerName(GetOwningPlayer(GetAttacker())) ) ))
    call ForceAddPlayerSimple(GetEnumPlayer(), udg_Vassals[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))])
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=24
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call SetPlayerAllianceStateBJ(GetEnumPlayer(), ConvertedPlayer(GetForLoopIndexB()), bj_ALLIANCE_UNALLIED)
        call SetPlayerAllianceStateBJ(ConvertedPlayer(GetForLoopIndexB()), GetEnumPlayer(), bj_ALLIANCE_UNALLIED)
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
endfunction

function Trig_FeodalDead_Func004Func017Func001C takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetEnumUnit(), udg_ZahvatBuildings) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_FeodalDead_Func004Func017A takes nothing returns nothing
    if ( Trig_FeodalDead_Func004Func017Func001C() ) then
        call SetUnitOwner(GetEnumUnit(), Player(PLAYER_NEUTRAL_AGGRESSIVE), true)
    else
        call KillUnit(GetEnumUnit())
        call RemoveUnit(GetEnumUnit())
    endif
endfunction

function Trig_FeodalDead_Func004Func020A takes nothing returns nothing
    call DisplayTextToForce(GetPlayersAll(), ( GetPlayerName(GetEnumPlayer()) + ( " освободился от игрока " + GetPlayerName(GetOwningPlayer(GetTriggerUnit())) ) ))
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=24
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetPlayerAllianceStateBJ(GetOwningPlayer(GetTriggerUnit()), ConvertedPlayer(GetForLoopIndexA()), bj_ALLIANCE_UNALLIED)
        call SetPlayerAllianceStateBJ(GetEnumPlayer(), ConvertedPlayer(GetForLoopIndexA()), bj_ALLIANCE_UNALLIED)
        call SetPlayerAllianceStateBJ(ConvertedPlayer(GetForLoopIndexA()), GetOwningPlayer(GetTriggerUnit()), bj_ALLIANCE_UNALLIED)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

function Trig_FeodalDead_Func004C takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetTriggerUnit()) == GetOwningPlayer(GetAttacker()) ) ) then
        return false
    endif
    return true
endfunction

function Trig_FeodalDead_Actions takes nothing returns nothing
    call SetUnitLifePercentBJ(GetTriggerUnit(), 100)
    call SetUnitInvulnerable(GetTriggerUnit(), true)
    call SetUnitInvulnerable(GetTriggerUnit(), false)
    if ( Trig_FeodalDead_Func004C() ) then
        // Триггер для самоубийцы
        call DisplayTextToForce(GetPlayersAll(), ( GetPlayerName(GetOwningPlayer(GetTriggerUnit())) + "|cffff0000 - самоубился! |rЗачем?)" ))
        call ForGroupBJ(GetUnitsOfPlayerAll(GetOwningPlayer(GetTriggerUnit())), function Trig_FeodalDead_Func004Func017A)
        call SetPlayerAbilityAvailableBJ(true, 'A0IQ', GetOwningPlayer(GetTriggerUnit()))
        // Обнуляю вассалов самоубийцы. Вы свободны!
        call ForForce(udg_Vassals[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], function Trig_FeodalDead_Func004Func020A)
        call ForceClear(udg_Vassals[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])
    else
        // --------------------------------------------------------------------   Васссал кого-то захватил
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=24
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            if ( Trig_FeodalDead_Func004Func002Func001C() ) then
                set bj_forLoopBIndex=1
                set bj_forLoopBIndexEnd=24
                loop
                    exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
                    call SetPlayerAllianceStateBJ(GetTriggerPlayer(), ConvertedPlayer(GetForLoopIndexB()), bj_ALLIANCE_UNALLIED)
                    call SetPlayerAllianceStateBJ(ConvertedPlayer(GetForLoopIndexB()), GetTriggerPlayer(), bj_ALLIANCE_UNALLIED)
                    set bj_forLoopBIndex=bj_forLoopBIndex + 1
                endloop
                // Есть сеньор
                // Вассализация хозяина столицы
                call DisplayTextToForce(GetPlayersAll(), ( GetPlayerName(GetOwningPlayer(GetTriggerUnit())) + ( " - стал вассалом игрока " + GetPlayerName(ConvertedPlayer(GetForLoopIndexA())) ) ))
                call ForceAddPlayerSimple(GetOwningPlayer(GetTriggerUnit()), udg_Vassals[GetConvertedPlayerId(ConvertedPlayer(GetForLoopIndexA()))])
                call SetPlayerAllianceStateBJ(GetOwningPlayer(GetTriggerUnit()), ConvertedPlayer(GetForLoopIndexA()), bj_ALLIANCE_ALLIED_UNITS)
                call SetPlayerAllianceStateBJ(GetOwningPlayer(GetAttacker()), GetOwningPlayer(GetTriggerUnit()), bj_ALLIANCE_ALLIED_VISION)
                call SetPlayerAllianceStateBJ(ConvertedPlayer(GetForLoopIndexA()), GetOwningPlayer(GetTriggerUnit()), bj_ALLIANCE_ALLIED_VISION)
                // Вассализация вассалов хозяина столицы
                call ForForce(udg_Vassals[GetConvertedPlayerId(GetOwningPlayer(GetAttackedUnitBJ()))], function Trig_FeodalDead_Func004Func002Func001Func010A)
                call ForceClear(udg_Vassals[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])
                call SetForceAllianceStateBJ(udg_Vassals[GetForLoopIndexA()], udg_Vassals[GetForLoopIndexA()], bj_ALLIANCE_ALLIED_VISION)
                call SetForceAllianceStateBJ(udg_Vassals[GetForLoopIndexA()], GetForceOfPlayer(GetOwningPlayer(GetAttacker())), bj_ALLIANCE_ALLIED_UNITS)
                return
            else
            endif
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        // --------------------------------------------------------------------   Сеньор кого-то захватил
        // Вассализация хозяина столицы
        set bj_forLoopBIndex=1
        set bj_forLoopBIndexEnd=24
        loop
            exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
            call SetPlayerAllianceStateBJ(GetTriggerPlayer(), ConvertedPlayer(GetForLoopIndexB()), bj_ALLIANCE_UNALLIED)
            call SetPlayerAllianceStateBJ(ConvertedPlayer(GetForLoopIndexB()), GetTriggerPlayer(), bj_ALLIANCE_UNALLIED)
            set bj_forLoopBIndex=bj_forLoopBIndex + 1
        endloop
        call DisplayTextToForce(GetPlayersAll(), ( GetPlayerName(GetOwningPlayer(GetTriggerUnit())) + ( " - стал вассалом игрока " + GetPlayerName(GetOwningPlayer(GetAttacker())) ) ))
        call ForceAddPlayerSimple(GetOwningPlayer(GetTriggerUnit()), udg_Vassals[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))])
        call SetPlayerAllianceStateBJ(GetOwningPlayer(GetTriggerUnit()), GetOwningPlayer(GetAttacker()), bj_ALLIANCE_ALLIED_UNITS)
        call SetPlayerAllianceStateBJ(GetOwningPlayer(GetAttacker()), GetOwningPlayer(GetTriggerUnit()), bj_ALLIANCE_ALLIED_VISION)
        // Вассализация вассалов хозяина столицы
        call ForForce(udg_Vassals[GetConvertedPlayerId(GetOwningPlayer(GetAttackedUnitBJ()))], function Trig_FeodalDead_Func004Func011A)
        call SetForceAllianceStateBJ(udg_Vassals[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))], udg_Vassals[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))], bj_ALLIANCE_ALLIED_VISION)
        call SetForceAllianceStateBJ(udg_Vassals[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))], GetForceOfPlayer(GetOwningPlayer(GetAttacker())), bj_ALLIANCE_ALLIED_UNITS)
        call ForceClear(udg_Vassals[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])
    endif
endfunction

