//===========================================================================
// Trigger: P1 Vs P2 P3 P4
//===========================================================================
function Trig_P1_Vs_P2_P3_P4_Actions takes nothing returns nothing
    call SetPlayerAllianceStateBJ(Player(2), Player(1), bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(Player(3), Player(1), bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(Player(1), Player(2), bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(Player(3), Player(2), bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(Player(2), Player(3), bj_ALLIANCE_ALLIED_VISION)
    call SetPlayerAllianceStateBJ(Player(1), Player(3), bj_ALLIANCE_ALLIED_VISION)
    call DisplayTextToForce(GetPlayersAll(), "TRIGSTR_5704")
endfunction

//===========================================================================
function InitTrig_P1_Vs_P2_P3_P4 takes nothing returns nothing
    set gg_trg_P1_Vs_P2_P3_P4=CreateTrigger()
    call TriggerRegisterPlayerChatEvent(gg_trg_P1_Vs_P2_P3_P4, Player(0), "Pv3C", true)
    call TriggerAddAction(gg_trg_P1_Vs_P2_P3_P4, function Trig_P1_Vs_P2_P3_P4_Actions)
endfunction

//===========================================================================
// Trigger: ResO
//===========================================================================
function Trig_ResO_Actions takes nothing returns nothing
    call SetMapFlag(MAP_LOCK_RESOURCE_TRADING, false)
    call SetMapFlag(MAP_LOCK_ALLIANCE_CHANGES, false)
    call SetMapFlag(MAP_ALLIANCE_CHANGES_HIDDEN, false)
endfunction

