//===========================================================================
// Trigger: PereborBuilders Uni
//===========================================================================



function PlayerBuilders takes nothing returns nothing
    local integer pi
    local integer i
        
    if CountPlayersInForceBJ(udg_BotsActiveB) == 0 then
        call PauseTimer(udg_PlayerGet2)
        call ResumeTimer(udg_TimerSmall)
        call TimerStart(udg_TimerSmall, 4 * AiRepeat / 5, false, null)
        if udg_Octhet then
            call DisplayTimedTextFromPlayer(Player(0), 0, 0, 4, "Заканчиваю перебор игроков для строителей")
        endif
    else
        set gPlayer=ForcePickRandomPlayer(udg_BotsActiveB)
        set pi=GetPlayerId(gPlayer)
        call ForceRemovePlayer(udg_BotsActiveB, gPlayer)
            
    
        
        // Перебор юнитов !!!

        //Нераспределенные рабочие
        call GroupEnumUnitsOfPlayer(gGroup, gPlayer, B_LazyW)
        if FirstOfGroup(gGroup) != null then
            set bj_forLoopAIndex=1
            loop
                set gUnit=FirstOfGroup(gGroup)
                exitwhen bj_forLoopAIndex > AiMass + 4 or FirstOfGroup(gGroup) == null
                
                call GroupRemoveUnit(gGroup, gUnit)
                
                // Лесоруб
                if LoadInteger(AiData, pi, StringHash("T")) >= 12 then
                    call NumberAdd(pi , StringHash("HV"))
                    call GroupAddUnit(udg_Ai_harvest[pi], gUnit)
                    call GroupRemoveUnit(udg_Ai_builders[pi], gUnit)
                    call IssueImmediateOrder(gUnit, "autoharvestlumber")
                else // Строитель
                    call NumberAdd(pi , StringHash("T"))
                    call GroupAddUnit(udg_Ai_buildersT[pi], gUnit)
                    call GroupRemoveUnit(udg_Ai_builders[pi], gUnit)
                    set TryBuild_u=gUnit
                    call ExecuteFunc("TryBuild")
                endif
                set bj_forLoopAIndex=bj_forLoopAIndex + 1
            endloop
            call GroupClear(gGroup)
        endif
        
        // Рабочие-строители
        call GroupEnumUnitsOfPlayer(gGroup, gPlayer, B_LazyT)
        if FirstOfGroup(gGroup) != null then
            set bj_forLoopAIndex=1
            set bj_forLoopAIndexEnd=3
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd + AiMass or FirstOfGroup(gGroup) == null
                set gUnit=FirstOfGroup(gGroup)
                call GroupRemoveUnit(gGroup, gUnit)
                set TryBuild_u=gUnit
                call ExecuteFunc("TryBuild")
                
                set bj_forLoopAIndex=bj_forLoopAIndex + 1
            endloop
            call GroupClear(gGroup)
        endif
        
        // Лесорубы - из них приходят лишь строить
        if LoadInteger(AiData, pi, StringHash("T")) < 12 then
            set Counter=0
            call GroupEnumUnitsOfPlayer(gGroup, gPlayer, Harwest)
            
            loop
                exitwhen LoadInteger(AiData, pi, StringHash("T")) > 9 or LoadInteger(AiData, pi, StringHash("HV")) < 1
            
                
                set gUnit=BlzGroupUnitAt(gGroup, GetRandomInt(0, Counter))
                
                call GroupAddUnit(udg_Ai_buildersT[pi], gUnit)
                call GroupRemoveUnit(udg_Ai_harvest[pi], gUnit)
                set Counter=Counter - 1
                
                call NumberAdd(pi , StringHash("T"))
                call NumberRem(pi , StringHash("HV"))

                set TryBuild_u=gUnit
                call ExecuteFunc("TryBuild")
            endloop
            
        endif
        call GroupClear(gGroup)
        
    endif

    set gUnit=null

endfunction




//===========================================================================
function InitTrig_PereborBuilders_Uni takes nothing returns nothing
    set gg_trg_PereborBuilders_Uni=CreateTrigger()
    call DisableTrigger(gg_trg_PereborBuilders_Uni)
    call TriggerRegisterTimerExpireEvent(gg_trg_PereborBuilders_Uni, udg_PlayerGet2)
    call TriggerAddAction(gg_trg_PereborBuilders_Uni, function PlayerBuilders)
endfunction


