//===========================================================================
// Trigger: RitualPoglocenia
//===========================================================================
function Trig_RitualPoglocenia_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A1GA' and GetUnitAbilityLevel(GetSpellTargetUnit(), 'A1F9') > 0 and not IsUnitType(GetSpellTargetUnit(), UNIT_TYPE_HERO)
endfunction




function Trig_RitualPoglocenia_Actions takes nothing returns nothing
   //local unit u = GetTriggerUnit()
    local unit u2= GetSpellTargetUnit()
    local integer id= GetUnitTypeId(u2)
    
    
    //Маги
    if id == 'o052' or id == 'o051' then
        set u2=ReplaceUnit2(u2 , 'o05O' , bj_UNIT_STATE_METHOD_RELATIVE)
        
    //танки
    elseif id == 'o04Z' or id == 'o04X' or id == 'o04V' or id == 'o050' then
        set u2=ReplaceUnit2(u2 , 'o05M' , bj_UNIT_STATE_METHOD_RELATIVE)
    //дд
    elseif id == 'o04W' or id == 'o04Y' or id == 'o053' then
        set u2=ReplaceUnit2(u2 , 'o05N' , bj_UNIT_STATE_METHOD_RELATIVE)
    else
        call KillUnit(u2)
    endif
    
    call UnitAddAbility(u2, 'A0Z5')
    
    set u2=null

endfunction

//===========================================================================
function InitTrig_RitualPoglocenia takes nothing returns nothing
    set gg_trg_RitualPoglocenia=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_RitualPoglocenia, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_RitualPoglocenia, Condition(function Trig_RitualPoglocenia_Conditions))
    call TriggerAddAction(gg_trg_RitualPoglocenia, function Trig_RitualPoglocenia_Actions)
endfunction


//===========================================================================
// Trigger: WantAxe
//===========================================================================
function Trig_WantAxe_Conditions takes nothing returns boolean
    //call DisplayTextToPlayer(Player(0),0,0,"2")
    return GetUnitAbilityLevel(GetEventDamageSource(), 'A1G3') > 0 and GetUnitAbilityLevel(GetTriggerUnit(), 'A1G4') == 0 and IsPlayerEnemy(GetOwningPlayer(GetEventDamageSource()), GetOwningPlayer(GetTriggerUnit()))
endfunction

function toporend takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer id= GetHandleId(t)
    local unit u2= LoadUnitHandle(Hash, id, 1)
    call UnitRemoveAbility(u2, 'A1G4')
    call FlushChildHashtable(Hash, id)
    call DestroyTimer(t)
    set t=null
    set u2=null
endfunction


function Trig_WantAxe_Actions takes nothing returns nothing
    local unit u= GetEventDamageSource()
    local unit u2= GetTriggerUnit()
    local timer t= CreateTimer()
    local integer id= GetHandleId(t)
    //call DisplayTextToPlayer(Player(0),0,0,"2"+GetUnitName(u2))
     
    call UnitAddAbility(u2, 'A1G4')
    
    call TimerStart(t, 7, false, function toporend)
    call SaveUnitHandle(Hash, id, 1, u2)
    
    set u=null
    set u2=null

    set t=null
endfunction

//===========================================================================
function InitTrig_WantAxe takes nothing returns nothing
    set gg_trg_WantAxe=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_WantAxe, EVENT_PLAYER_UNIT_DAMAGED)
    call TriggerAddCondition(gg_trg_WantAxe, Condition(function Trig_WantAxe_Conditions))
    call TriggerAddAction(gg_trg_WantAxe, function Trig_WantAxe_Actions)
endfunction


//===========================================================================
// Trigger: BeFaster
//===========================================================================
function Trig_BeFaster_Conditions takes nothing returns boolean
    
    return GetUnitAbilityLevel(BlzGetEventDamageTarget(), 'A1F9') > 0 or GetUnitAbilityLevel(BlzGetEventDamageTarget(), 'A1G2') > 0 // Тут абилка иконка
    
    
endfunction

function Trig_BeFaster_Actions takes nothing returns nothing
    local unit u= BlzGetEventDamageTarget()
    local integer spellid= 'A1F8'
    local integer timerspellid= 'A1CX'
    local real lifep= GetUnitLifePercent(u)
    local integer time= 10
    
    
    //call DisplayTextToPlayer(Player(0),0,0,"Добавил")
    if lifep <= 30 then
        call UnitAddAbility(u, spellid)
        call SetUnitAbilityLevel(u, spellid, 4)
        call BlzStartUnitAbilityCooldown(u, timerspellid, 20)
       // call DisplayTextToPlayer(Player(0),0,0,"м 25"+R2S(lifep))
    elseif lifep <= 50 then
            call UnitAddAbility(u, spellid)
            call SetUnitAbilityLevel(u, spellid, 3)
            call BlzStartUnitAbilityCooldown(u, timerspellid, 20)
     //       call DisplayTextToPlayer(Player(0),0,0,"м50"+R2S(lifep))   
    elseif lifep <= 70 then
            call UnitAddAbility(u, spellid)
            call SetUnitAbilityLevel(u, spellid, 2)
            call BlzStartUnitAbilityCooldown(u, timerspellid, 20)
     //       call DisplayTextToPlayer(Player(0),0,0,"м50"+R2S(lifep))
    elseif lifep <= 90 then
            call UnitAddAbility(u, spellid)
            call SetUnitAbilityLevel(u, spellid, 1)
            call BlzStartUnitAbilityCooldown(u, timerspellid, 20)
     //       call DisplayTextToPlayer(Player(0),0,0,"м50"+R2S(lifep))
                
    else
            call UnitRemoveAbility(u, spellid)
       //     call DisplayTextToPlayer(Player(0),0,0,"Другое"+R2S(lifep))
    endif
    call UnitAddAbility(u, timerspellid)
    call BlzStartUnitAbilityCooldown(u, timerspellid, time)
    call TriggerSleepAction(time)
    
    if BlzGetUnitAbilityCooldownRemaining(u, timerspellid) == 0 then
        call UnitRemoveAbility(u, spellid)
    endif
    
    
    
    set u=null
endfunction

//===========================================================================
function InitTrig_BeFaster takes nothing returns nothing
    set gg_trg_BeFaster=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_BeFaster, EVENT_PLAYER_UNIT_DAMAGED)
    call TriggerAddCondition(gg_trg_BeFaster, Condition(function Trig_BeFaster_Conditions))
    call TriggerAddAction(gg_trg_BeFaster, function Trig_BeFaster_Actions)
endfunction


//===========================================================================
// Trigger: MassSetca
//===========================================================================
function Trig_MassSetca_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A1FC'
endfunction


function Trig_MassSetca_Actions takes nothing returns nothing
    local location l= GetSpellTargetLoc()
    local player p= GetOwningPlayer(GetTriggerUnit())
    local boolexpr bex
    local integer dammyAbility= 'A1FD'
    local integer level= GetUnitAbilityLevel(GetTriggerUnit(), GetSpellAbilityId())
    local group g= CreateGroup()
    local unit u
    local unit u2
    local integer i= 0
    set udg_LocalPlayer=p
    set bex=Condition(function EnemEl)
    call GroupEnumUnitsInRangeOfLoc(g, l, 100 + 45 * level, bex)
    
    call RemoveLocation(l)
    set l=GetUnitLoc(GetTriggerUnit())
    loop
        set u=FirstOfGroup(g)
        exitwhen u == null
        
        set u2=CreateUnitAtLoc(p, 'H0BN', l, bj_UNIT_FACING)
        set udg_LocalUnit2=u2
        call TriggerExecute(gg_trg_ToKill2)
        call UnitAddAbility(u2, dammyAbility)
        call SetUnitManaBJ(u2, 1111111.00)
        call SetUnitAbilityLevel(u2, dammyAbility, level)
        call IssueTargetOrder(u2, "ensnare", u)
        
        set i=i + 1
        call GroupRemoveUnit(g, u)
    endloop
    
    
    set u=null
    call DestroyGroup(g)
    set g=null
    call RemoveLocation(l)
    set p=null
    call DestroyBoolExpr(bex)
    set u2=null
    set bex=null
endfunction

//===========================================================================
function InitTrig_MassSetca takes nothing returns nothing
    set gg_trg_MassSetca=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_MassSetca, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_MassSetca, Condition(function Trig_MassSetca_Conditions))
    call TriggerAddAction(gg_trg_MassSetca, function Trig_MassSetca_Actions)
endfunction


//===========================================================================
// Trigger: MassFrenzy
//===========================================================================
function Trig_MassFrenzy_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A1ID'
endfunction

function FFrenzy takes nothing returns boolean
    return GetOwningPlayer(GetFilterUnit()) == udg_LocalPlayer and GetUnitAbilityLevel(GetFilterUnit(), 'BUhf') == 0 and not IsUnitType(GetFilterUnit(), UNIT_TYPE_MECHANICAL) and not IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE)
    

endfunction

function Trig_MassFrenzy_Actions takes nothing returns nothing
    local location l= GetUnitLoc(GetTriggerUnit())
    local player p= GetOwningPlayer(GetTriggerUnit())
    
    local boolexpr bex
    
    local group g= CreateGroup()
    local unit u
    local unit u2
    local integer i= 0
    set udg_LocalPlayer=p
    set bex=Condition(function FFrenzy)
    call GroupEnumUnitsInRangeOfLocCounted(g, l, 400, bex, 4)
    
    call RemoveLocation(l)
    set l=GetUnitLoc(GetTriggerUnit())
    loop
        set u=FirstOfGroup(g)
        exitwhen i > 4 or u == null
        
        set u2=CreateUnitAtLoc(p, 'h05P', l, bj_UNIT_FACING)
        
        
        call UnitAddAbility(u2, 'A1FA')
        call SetUnitManaBJ(u2, 1111111.00)
        
        call IssueTargetOrder(u2, "unholyfrenzy", u)
        
        set i=i + 1
        call RemoveUnitTimed(u2 , 2)
        call GroupRemoveUnit(g, u)
    endloop
    
    
    set u=null
    call DestroyGroup(g)
    set g=null
    call RemoveLocation(l)
    set p=null
    call DestroyBoolExpr(bex)
    set u2=null
    set bex=null
endfunction

//===========================================================================
function InitTrig_MassFrenzy takes nothing returns nothing
    set gg_trg_MassFrenzy=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_MassFrenzy, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_MassFrenzy, Condition(function Trig_MassFrenzy_Conditions))
    call TriggerAddAction(gg_trg_MassFrenzy, function Trig_MassFrenzy_Actions)
endfunction


