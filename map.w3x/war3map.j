//===========================================================================
// Trigger: F2 2
//===========================================================================
function Trig_F2_2_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A167'
endfunction

function Trig_F2_2_Actions takes nothing returns nothing
    local integer pi= GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
    local group g= CreateGroup()
    local group g0= CreateGroup()
    local unit u
    local integer i= 0
    local location loc= GetSpellTargetLoc()
    
    //set g = udg_F_Group[pi+1]
    call GroupAddGroup(udg_F_Group[pi + 1], g)
    loop
    
        set u=FirstOfGroup(g)
        if u == null then
            call GroupPointOrderLoc(g0, "attack", loc)
            exitwhen true
        endif
             
        if i == 12 then
            call GroupPointOrderLoc(g0, "attack", loc)
            set i=0
            call GroupClear(g0)
            
        else
        
        endif
        set i=i + 1
        call GroupAddUnit(g0, u)
        call GroupRemoveUnit(g, u)
        set u=null
    endloop


    call DestroyGroup(g)
    call DestroyGroup(g0)
    set g=null
    set g0=null
    call RemoveLocation(loc)
    set loc=null
endfunction

//===========================================================================
function InitTrig_F2_2 takes nothing returns nothing
    set gg_trg_F2_2=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_F2_2, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_F2_2, Condition(function Trig_F2_2_Conditions))
    call TriggerAddAction(gg_trg_F2_2, function Trig_F2_2_Actions)
endfunction


//===========================================================================
// Trigger: F2 Attack Point
//
// Для того чтобы атаковали ближайшие точки
//===========================================================================
function Trig_F2_Attack_Point_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A1L0'
endfunction


function OwnUnit takes nothing returns boolean
    return GetOwningPlayer(GetFilterUnit()) == udg_LocalPlayer
endfunction

function IsCityEnemy takes nothing returns boolean
    return GetUnitAbilityLevel(GetFilterUnit(), 'AHad') >= 0 and GetOwningPlayer(GetFilterUnit()) != udg_LocalPlayer
endfunction





function Trig_F2_Attack_Point_Actions takes nothing returns nothing
    local integer pi= GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
    local group g= CreateGroup()
    local group points= CreateGroup()
    local group g0= CreateGroup()
    local unit u
    local unit u2
    local integer i= 0
    local real x
    local real y

    //set g = udg_F_Group[pi+1]
    call GroupAddGroup(udg_F_Group[pi + 1], g)
    set udg_LocalPlayer=GetOwningPlayer(GetTriggerUnit())
    loop
    
        set u=FirstOfGroup(g)
        exitwhen u == null or i >= 25
        
        set x=GetUnitX(u)
        set y=GetUnitY(u)
        
        call GroupEnumUnitsInRange(g0, x, y, 500, Condition(function OwnUnit))
        call GroupEnumUnitsInRange(points, x, y, 7500, Condition(function IsCityEnemy))
        if FirstOfGroup(points) != null then
            set u2=BlzGroupUnitAt(points, GetRandomInt(0, BlzGroupGetSize(points) - 1))
            call GroupPointOrder(g0, "attack", GetUnitX(u2), GetUnitY(u2))
                
        endif
        call GroupRemoveGroup(g, g0)
        call GroupClear(g0)
        call GroupRemoveUnit(g, u)
        set u=null
        set i=i + 1
    endloop
    

    call DestroyGroup(g)
    call DestroyGroup(g0)
    call DestroyGroup(points)

    set g=null
    set g0=null
    set points=null
    
    set u=null
    set u2=null

endfunction

//===========================================================================
function InitTrig_F2_Attack_Point takes nothing returns nothing
    set gg_trg_F2_Attack_Point=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_F2_Attack_Point, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_F2_Attack_Point, Condition(function Trig_F2_Attack_Point_Conditions))
    call TriggerAddAction(gg_trg_F2_Attack_Point, function Trig_F2_Attack_Point_Actions)
endfunction


//===========================================================================
// Trigger: F2 Start
//===========================================================================
function Trig_F2_Start_Conditions takes nothing returns boolean
    if ( not ( CountLivingPlayerUnitsOfTypeId('h0GR', GetTriggerPlayer()) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_F2_Start_Actions takes nothing returns nothing
    set udg_LocalPosition2=GetRectCenter(gg_rct_HostRegion)
    call ClearSelectionForPlayer(GetTriggerPlayer())
    call CreateNUnitsAtLoc(1, 'h0GR', GetTriggerPlayer(), udg_LocalPosition2, bj_UNIT_FACING)
    call SelectUnitAddForPlayer(GetLastCreatedUnit(), GetTriggerPlayer())
endfunction

//===========================================================================
function InitTrig_F2_Start takes nothing returns nothing
    set gg_trg_F2_Start=CreateTrigger()
    call TriggerRegisterPlayerChatEvent(gg_trg_F2_Start, Player(0), "-f2", true)
