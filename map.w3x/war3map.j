    set gg_trg_FeodalDead2=CreateTrigger()
    call DisableTrigger(gg_trg_FeodalDead2)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_FeodalDead2, EVENT_PLAYER_UNIT_ATTACKED)
