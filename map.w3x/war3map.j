//===========================================================================
function Trig_TrainHakkar_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTrainedUnit()) == 'O055'
endfunction

function Trig_TrainHakkar_Actions takes nothing returns nothing
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=50
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call TriggerRegisterUnitLifeEvent(gg_trg_Help, GetTrainedUnit(), LESS_THAN, ( 14 * I2R(GetForLoopIndexA()) ))
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call TriggerRegisterUnitLifeEvent(gg_trg_Help, GetTrainedUnit(), LESS_THAN, 2.00)
endfunction

