function f_ToHeal takes nothing returns boolean
    local unit u= GetFilterUnit()
    if IsPlayerAlly(GetOwningPlayer(u), CheckPlayer) and IsUnitIdType(GetUnitTypeId(u), UNIT_TYPE_MECHANICAL) != true then
        set u=null
        return true
    else
        set u=null
        return false
    endif
    
endfunction



//Гланый фильтр для войск, кому надо отдать приказ
function f_Lazy takes nothing returns boolean
    local integer i= GetUnitCurrentOrder(GetFilterUnit())
    return IsUnitInGroup(GetFilterUnit(), udg_Ai_army[GetPlayerId(GetOwningPlayer(GetFilterUnit()))]) and ( i == 851972 or i == 851976 or i == 0 )

endfunction


function f_LazyN takes nothing returns boolean
    local integer i= GetUnitCurrentOrder(GetFilterUnit())
    return IsUnitInGroup(GetFilterUnit(), udg_Ai_navy[GetPlayerId(GetOwningPlayer(GetFilterUnit()))]) and ( i == 851972 or i == 851976 or i == 0 )

endfunction


function f_LazyF takes nothing returns boolean
    local integer i= GetUnitCurrentOrder(GetFilterUnit())
    return GetOwningPlayer(GetFilterUnit()) == CheckPlayer and ( i == 851972 or i == 851976 or i == 0 ) and GetUnitTypeId(GetFilterUnit()) != 'h014' and IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) != true

endfunction


function f_FixZ takes nothing returns boolean
   return GetUnitCurrentOrder(GetFilterUnit()) == 851983
endfunction



function f_LazyW takes nothing returns boolean
    local integer i= GetUnitCurrentOrder(GetFilterUnit())
    return IsUnitInGroup(GetFilterUnit(), udg_Ai_builders[GetPlayerId(GetOwningPlayer(GetFilterUnit()))]) and ( i == 851972 or i == 851976 or i == 0 )
endfunction


function f_LazyT takes nothing returns boolean
    local integer i= GetUnitCurrentOrder(GetFilterUnit())
    return IsUnitInGroup(GetFilterUnit(), udg_Ai_buildersT[GetPlayerId(GetOwningPlayer(GetFilterUnit()))]) and ( i == 851972 or i == 851976 or i == 0 )
endfunction



function f_PortB takes nothing returns boolean
    return IsUnitInGroup(GetFilterUnit(), AiUnitsToPort[CheckId])


endfunction

function f_Worker takes nothing returns boolean
    return IsUnitInGroup(GetFilterUnit(), udg_Ai_buildersT[GetPlayerId(GetOwningPlayer(GetFilterUnit()))])
endfunction



function f_Harwest takes nothing returns boolean
    return IsUnitInGroup(GetFilterUnit(), udg_Ai_harvest[GetPlayerId(GetOwningPlayer(GetFilterUnit()))])

endfunction


function f_InAiArmy takes nothing returns boolean
    return IsUnitInGroup(GetFilterUnit(), udg_Ai_army[GetPlayerId(GetOwningPlayer(GetFilterUnit()))])
endfunction

function f_InAiNavy takes nothing returns boolean
    return IsUnitInGroup(GetFilterUnit(), udg_Ai_navy[GetPlayerId(GetOwningPlayer(GetFilterUnit()))])
endfunction


// Здания в которых надо делать найм - без работы, в группе, определенного типа
function f_OnlyNeaded takes nothing returns boolean
    //return GetUnitTypeId(GetFilterUnit()) != 'h05Y' and GetUnitTypeId(GetFilterUnit()) != 'h062' and GetUnitTypeId(GetFilterUnit()) != 'h063' 
    local integer i= GetUnitTypeId(GetFilterUnit())
    local integer pi= GetPlayerId(GetOwningPlayer(GetFilterUnit()))
    
    
    //Алый орден
    if AiRace[pi] == "Scarlet" then
        return IsUnitInGroup(GetFilterUnit(), udg_Ai_buildings[pi]) and ( i == 'h05Z' or i == 'h05X' or i == 'h011' or i == 'h064' or i == 'h05U' or i == 'h068' or i == 'h061' or i == 'h05W' )
    
    
    // Эльфы крови
    elseif AiRace[pi] == "BloodElves" then
        return IsUnitInGroup(GetFilterUnit(), udg_Ai_buildings[pi]) and ( i == 'h04C' or i == 'h04B' or i == 'h04K' or i == 'h04D' or i == 'h05J' or i == 'h04G' or i == 'h04E' or i == 'h011' )
    endif
    return false
    
   
    
endfunction



function f_NavalBases takes nothing returns boolean
    local integer i= GetUnitTypeId(GetFilterUnit())
    return i == 'h011'

endfunction

function f_Hero takes nothing returns boolean
    return IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO)
endfunction

function f_HeroD takes nothing returns boolean
    return IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) and IsUnitDeadBJ(GetFilterUnit())
endfunction


function f_LiveHero takes nothing returns boolean
    return GetUnitState(GetFilterUnit(), UNIT_STATE_LIFE) > 0.6 and IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO)
endfunction

//Подраздел континентов
 

// кого надо выкинуть, если он на этом континенте
function InKalim takes nothing returns boolean
    return RectContainsUnit(gg_rct_Kalim, GetFilterUnit()) != true or RectContainsUnit(gg_rct_NordNotKalim, GetFilterUnit())
endfunction
function InAnkirag takes nothing returns boolean
    return RectContainsUnit(gg_rct_Ankirag, GetFilterUnit()) != true
endfunction


function InNord takes nothing returns boolean
    return RectContainsUnit(gg_rct_Nord, GetFilterUnit()) != true and RectContainsUnit(gg_rct_Azgel, GetFilterUnit()) != true
endfunction
function InVK takes nothing returns boolean
    return ( RectContainsUnit(gg_rct_EastenKingdoms, GetFilterUnit()) != true and RectContainsUnit(gg_rct_EasternDungeons, GetFilterUnit()) != true and RectContainsUnit(gg_rct_BlackMountain, GetFilterUnit()) != true ) or RectContainsUnit(gg_rct_OutNoVk, GetFilterUnit())
endfunction
function InBisles takes nothing returns boolean
    return RectContainsUnit(gg_rct_BrokenIsles, GetFilterUnit()) != true
endfunction
function InOutland takes nothing returns boolean
    return RectContainsUnit(gg_rct_Outland, GetFilterUnit()) != true or RectContainsUnit(gg_rct_VknotOut, GetFilterUnit())
endfunction
function InArgus takes nothing returns boolean
    return RectContainsUnit(gg_rct_Argus, GetFilterUnit()) != true
endfunction
function InPandaria takes nothing returns boolean
    return RectContainsUnit(gg_rct_Pandaria, GetFilterUnit()) != true
endfunction




