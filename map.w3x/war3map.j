    set gg_trg_PereborBuildings=CreateTrigger()
    call DisableTrigger(gg_trg_PereborBuildings)
    call TriggerRegisterTimerExpireEvent(gg_trg_PereborBuildings, udg_TimerSmall3)
    call TriggerAddAction(gg_trg_PereborBuildings, function Trig_PereborBuildings_Actions)
