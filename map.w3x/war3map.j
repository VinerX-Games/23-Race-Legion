endfunction


function NewMember takes nothing returns nothing
    
    local timer t= GetExpiredTimer()
    local integer id= GetHandleId(t)
    local unit u= LoadUnitHandle(Hash, id, 1)
    local integer uid= GetHandleId(u)

    if UnitAlive(u) then
        call SaveInteger(Hash, uid, 1, IMaxBJ(LoadInteger(Hash, uid, 1) + 1, 3))
    
    else
        
        call DestroyTimer(t)
        call FlushChildHashtable(Hash, id)
        call FlushChildHashtable(Hash, uid)
    endif
    set t=null
    set u=null
endfunction



function Trig_BuidingThatSellRecruts_Actions takes nothing returns nothing
    local unit u= GetConstructedStructure()
    local timer t= CreateTimer()
    local integer id= GetHandleId(t)
    local integer uid= GetHandleId(u)
    local integer startCount= 1
    call UnitAddAbility(u, 'Asud')
    call AddUnitToStock(u, 'h0NC', startCount, 3) //Юнит который продается
    call AddUnitToStock(u, 'h0NL', startCount, 3) //Юнит который продается
    
    call TimerStart(t, 30, true, function NewMember)
    call SaveUnitHandle(Hash, id, 1, u)
    call SaveInteger(Hash, uid, 1, startCount)
    set u=null
    set t=null
endfunction

