//===========================================================================
function Trig_Continents_Spell_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0UI' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Continents_Spell_Actions takes nothing returns nothing
    call DisplayTextToForce(GetPlayersAll(), "TRIGSTR_12041")
    set udg_Continents[0]=0
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=15
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Continents[GetForLoopIndexA()]=0
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call UnitAddAbilityBJ('A0UB', GetTriggerUnit())
    call UnitRemoveAbilityBJ('A0UM', GetTriggerUnit())
    call UnitAddAbilityBJ('A0UC', GetTriggerUnit())
    call UnitRemoveAbilityBJ('A0UN', GetTriggerUnit())
    call UnitRemoveAbilityBJ('A0UO', GetTriggerUnit())
    call UnitAddAbilityBJ('A0UD', GetTriggerUnit())
    call UnitAddAbilityBJ('A0UE', GetTriggerUnit())
    call UnitRemoveAbilityBJ('A0UP', GetTriggerUnit())
    call UnitAddAbilityBJ('A0UF', GetTriggerUnit())
    call UnitRemoveAbilityBJ('A0UQ', GetTriggerUnit())
    call UnitAddAbilityBJ('A0UH', GetTriggerUnit())
    call UnitRemoveAbilityBJ('A0UR', GetTriggerUnit())
    call UnitAddAbilityBJ('A0UG', GetTriggerUnit())
    call UnitRemoveAbilityBJ('A0US', GetTriggerUnit())
endfunction

