//===========================================================================
// Trigger: AM3
//===========================================================================
function Trig_AM3_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTrainedUnit()) == 'hspt'
endfunction

function AM3Count takes player p returns nothing
    local integer array a
    local integer i= 0
    local integer b= 0
    local integer pi= GetPlayerId(p)
    set a[0]=0
    
    // ШРУ
    if GetPlayerTechCount(p, 'R0HA', true) >= 1 then
        
        set i=4
        set b=0
        
        
        //Араторская прибавка
        if GetPlayerTechCount(p, 'R0HG', true) > 0 then
            set i=i + 1
        endif
        loop
                set a[0]=a[0] + 1
                set a[a[0]]='h0LU'
                set b=b + 1
                exitwhen b >= i
        endloop
        
    endif
    
    if GetPlayerTechCount(p, 'R0H8', true) == 1 and GetPlayerTechCount(p, 'R0HH', true) < 1 then
        //Dranay
        set i=1
        set b=1
        // Левые ветки
        if GetPlayerTechCount(p, 'R0HE', true) + GetPlayerTechCount(p, 'R0HF', true) > 0 then
            set i=i + 2
        endif
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='h0KQ'
            
            set b=b + 1
            exitwhen b >= i
        endloop
    endif
    
    
    if GetPlayerTechCount(p, 'R0HI', true) == 1 then
        //Dalaran
        set i=3
        set b=0
        //Араторская прибавка
        if GetPlayerTechCount(p, 'R0HG', true) > 0 then
            set i=i + 2
        endif
        loop
            set a[0]=a[0] + 1
            set a[a[0]]='h0M8'
            
            set b=b + 1
            exitwhen b >= i
        endloop
    endif

    
    //Long Containment
    call SaveInteger(CommonHash, pi, StringHash("AM3_0"), a[0])
    set i=1
    loop
        
        
        call SaveInteger(CommonHash, pi, StringHash("AM3") + i, a[i])
        set i=i + 1
        
        exitwhen i > a[0]
    endloop
    
    
    
    
endfunction



