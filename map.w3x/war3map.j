//===========================================================================
// Trigger: Cities Start 2
//
// Заношу в группы нейтральные здания
//===========================================================================

function ItIsCity takes nothing returns boolean
    return GetUnitAbilityLevel(GetFilterUnit(), 'AHad') == 1 and GetUnitAbilityLevel(GetFilterUnit(), 'Awrp') == 0
endfunction

function Trig_Cities_Start_2_Func003A takes nothing returns nothing
    local unit u= GetEnumUnit()
    local integer id= GetUnitTypeId(u)
    set CityCount=CityCount + 1
    call BlzSetUnitArmor(u, 3)
    call SetUnitState(u, UNIT_STATE_LIFE, 5000)
    call GroupAddUnit(udg_ZahvatBuildings, u)
    call GroupAddUnit(udg_BuildedSctructure[1], u)
    if ( id == 'h08A' or id == 'h08A' or id == 'h004' or id == 'h0B3' or id == 'h081' or id == 'h0AP' or id == 'h00G' or id == 'h08G' or id == 'h05O' or id == 'h089' or id == 'h0AG' or id == 'h097' or id == 'h09Z' or id == 'h088' or id == 'h094' or id == 'h00F' or id == 'h09P' or id == 'h00F' or id == 'h0BB' or id == 'h0E3' or id == 'h06I' ) then
        call GroupAddUnit(PortalBuildingAi, u)
    endif
    set u=null
endfunction

function Trig_Cities_Start_2_Actions takes nothing returns nothing
    set udg_Boolexpr=Condition(function ItIsCity)
    call GroupEnumUnitsInRect(udg_LocalOtrad2, bj_mapInitialPlayableArea, udg_Boolexpr)
    call ForGroup(udg_LocalOtrad2, function Trig_Cities_Start_2_Func003A)
    call GroupClear(udg_LocalOtrad2)
endfunction

//===========================================================================
function InitTrig_Cities_Start_2 takes nothing returns nothing
    local integer i= 0
    set gg_trg_Cities_Start_2=CreateTrigger()
    call TriggerRegisterTimerEvent(gg_trg_Cities_Start_2, 0.01, false)
    call TriggerAddAction(gg_trg_Cities_Start_2, function Trig_Cities_Start_2_Actions)
    
    loop
        exitwhen i > 23
        
        set CityPlayerCount[i]=0
        set i=i + 1
    endloop
    
endfunction


//===========================================================================
// Trigger: DeadSituastion
//===========================================================================
function Trig_DeadSituastion_Conditions takes nothing returns boolean
    return IsUnitInGroup(GetTriggerUnit(), udg_ZahvatBuildings)
endfunction

function Trig_DeadSituastion_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local unit u2
    local integer id= GetUnitTypeId(u)
    local unit u3= GetKillingUnit()
    local player p= GetOwningPlayer(u3)
    local integer pi0= GetPlayerId(GetOwningPlayer(u))
    local integer pi= GetPlayerId(p)
    local integer i
    
    
    //Для режима доминации
    
    set CityPlayerCount[pi0]=CityPlayerCount[pi0] - 1
    set CityPlayerCount[pi]=CityPlayerCount[pi] + 1
    call PercentGraph(pi0)
    call PercentGraph(pi)
    if udg_GameMode == 3 or udg_GameMode == 5 then
        call CheckCity(p)
    endif
    
    //Потом выбирать рандомного юнита рядом.
    if p == null then
        set p=Player(PLAYER_NEUTRAL_AGGRESSIVE)
        set pi=PLAYER_NEUTRAL_AGGRESSIVE
    endif
    set u2=CreateUnit(p, GetUnitTypeId(u), GetUnitX(u), GetUnitY(u), GetUnitFacing(u))
    call GroupAddUnit(udg_ZahvatBuildings, u2)
    call BlzSetUnitArmor(u2, 3)
    call GroupAddUnit(udg_BuildedSctructure[1], u2)
    
    //Условие что город мелкий
    if GetUnitAbilityLevel(u, 'A1MS') == 0 then
        call UnitAddAbility(u2, 'A0VJ')
    endif
    
    call UnitRemoveAbility(u2, 'A0B2')
    call UnitRemoveAbility(u2, 'A0B0')
    call UnitRemoveAbility(u2, 'A0MK')
    
    
    
    
    
    
    
    
    
    //Проверка на Прибрежный город
    if IsUnitInGroup(u, udg_CityNearWater) then
        call GroupRemoveUnit(udg_CityNearWater, u)
        call GroupAddUnit(udg_CityNearWater, u2)
    endif
    
    //Проверка на ии
    if IsUnitInGroup(u, PortalBuildingAi) then
        call GroupAddUnit(PortalBuildingAi, u2)
        
        if udg_AiControl[pi] then
            call UnitAddAbility(u2, 'A0Y4')
            call GroupAddUnit(AiUnitsToPort[pi], u2)
            if Random(1 , 3) then
                call PortTo(u2)
            endif
        endif
    elseif udg_AiControl[pi] then
        call aiKilledCity(u3)
    endif
    
    
    set u=null
    set u3=null
    
    //Автогрейды
    if GetUnitAbilityLevel(u2, 'A1MS') == 0 then
        call TimedUpdate(u2 , p)
    endif
    
    set u2=null

    
endfunction

//===========================================================================
function InitTrig_DeadSituastion takes nothing returns nothing
    set gg_trg_DeadSituastion=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_DeadSituastion, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_DeadSituastion, Condition(function Trig_DeadSituastion_Conditions))
    call TriggerAddAction(gg_trg_DeadSituastion, function Trig_DeadSituastion_Actions)
endfunction


//===========================================================================
// Trigger: Upgrade Gold C
//===========================================================================
function Trig_Upgrade_Gold_C_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0AZ' and IsUnitSelected(GetTriggerUnit(), GetOwningPlayer(GetTriggerUnit()))
endfunction

function Trig_Upgrade_Gold_C_Actions takes nothing returns nothing
    local integer levels= 4
    local integer pi= GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
    
    //Если малый город, -2 к максу
    if GetUnitAbilityLevel(GetTriggerUnit(), 'A1N9') > 0 then
        set levels=levels - 2
    endif
    set income[pi]=income[pi] + 100
    
    call UpdateGraf(pi)
    
    
    if GetUnitAbilityLevel(GetTriggerUnit(), 'A0AY') == 0 then
        call UnitAddAbility(GetTriggerUnit(), 'A0AY')

        return
    endif


    call IncUnitAbilityLevel(GetTriggerUnit(), 'A0AY')
    if GetUnitAbilityLevel(GetTriggerUnit(), 'A0AY') >= levels then
        call UnitRemoveAbility(GetTriggerUnit(), 'A0AZ')
    endif
    
    
endfunction

//===========================================================================
function InitTrig_Upgrade_Gold_C takes nothing returns nothing
    set gg_trg_Upgrade_Gold_C=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Upgrade_Gold_C, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Upgrade_Gold_C, Condition(function Trig_Upgrade_Gold_C_Conditions))
    call TriggerAddAction(gg_trg_Upgrade_Gold_C, function Trig_Upgrade_Gold_C_Actions)
endfunction


