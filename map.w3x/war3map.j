function GetLvlGoblins takes unit u returns nothing
    // Герои
        //Снайпер
        if GetUnitTypeId(u) == 'H0BD' then
                set gInt=GetRandomInt(1, 3)
                if GetHeroLevel(u) == 6 or GetHeroLevel(u) == 10 then
                    call SelectHeroSkill(u, 'A0D7')
                elseif gInt == 1 then
                    call SelectHeroSkill(u, 'A0D8')
                elseif gInt == 2 then
                    call SelectHeroSkill(u, 'AEar')
                else
                    call SelectHeroSkill(u, 'A0D5')
                endif
        //Galh
        elseif GetUnitTypeId(u) == 'Galh' then
                set gInt=GetRandomInt(1, 3)
                if GetHeroLevel(u) == 6 or GetHeroLevel(u) == 10 then
                    call SelectHeroSkill(u, 'ANtm')
                elseif gInt == 1 then
                    call SelectHeroSkill(u, 'ANhs')
                elseif gInt == 2 then
                    call SelectHeroSkill(u, 'ANab')
                else
                    call SelectHeroSkill(u, 'ANcr')
                endif

        //Gmex
        elseif GetUnitTypeId(u) == 'Gmex' then
                set gInt=GetRandomInt(1, 3)
                if GetHeroLevel(u) == 6 or GetHeroLevel(u) == 10 then
                    call SelectHeroSkill(u, 'ANrg')
                elseif gInt == 1 then
                    call SelectHeroSkill(u, 'ANsy')
                elseif gInt == 2 then
                    call SelectHeroSkill(u, 'ANcs')
                else
                    call SelectHeroSkill(u, 'ANeg')
                endif
        endif
endfunction
//***************************************************************************
//*  StartHorde2
function startHorde takes integer pi returns nothing
        //Старт юниты
        call CreateNUnitsAtLoc(8, 'opeo', Player(pi), udg_LocalPoint, bj_UNIT_FACING)
        call GroupAddGroup(GetLastCreatedGroup(), udg_Ai_units[pi])
        call GroupAddGroup(GetLastCreatedGroup(), udg_Ai_builders[pi])
        call CreateNUnitsAtLoc(1, 'ogre', Player(pi), udg_LocalPoint, bj_UNIT_FACING)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Ai_units[pi])
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Ai_buildings[pi])

        call SaveInteger(AiData, pi, 'opeo', 8)
        call SaveInteger(AiData, pi, 'ogre', 1)
        call SetPlayerName(Player(pi), "Орда (" + I2S(pi + 1) + ")")
        call SaveStr(AiData, pi, StringHash("Race"), "NG")
        call TriggerExecute(gg_trg_StartHorde)
        call TriggerExecute(gg_trg_HordeOn)
        
        set AiRace[pi]="Horde"
endfunction
//***************************************************************************
//*  JoinHorde
function Join_Horde takes integer id,integer pi,unit u returns nothing
    local integer i
    if id == 'opeo' then
        call GroupAddUnit(udg_Ai_builders[pi], u)
    elseif GetUnitAbilityLevel(u, 'A00A') > 0 then
        call GroupAddUnit(udg_Ai_navy[pi], u)
        call NumberAdd(pi , StringHash("NumberN"))
    elseif aiUnitJoinsCapitalGuard(u , pi) then
    else
        call aiUnitJoinsArmy(u , pi)
    endif


//Герои Obla,Ofar,Otch
    //  A12F,AOwk,AOcr,AOww
    if id == 'obla' then
        set i=GetRandomInt(1, 3)
        if i == 1 then
            call SelectHeroSkill(u, 'A12F')
        elseif i == 2 then
            call SelectHeroSkill(u, 'A12F')
        else
            call SelectHeroSkill(u, 'AOcr')
        endif
    
    
    // far AOfs,AOsf,AOcl,A12E
    elseif id == 'Ofar' then
        set i=GetRandomInt(1, 3)
        if i == 1 then
            call SelectHeroSkill(u, 'AOfs')
        elseif i == 2 then
            call SelectHeroSkill(u, 'AOsf')
        else
            call SelectHeroSkill(u, 'AOsf')
        endif
    
    
    // A026,AOr2,AOre,AOw2
    elseif id == 'Otch' then
        set i=GetRandomInt(1, 3)
        if i == 1 then
            call SelectHeroSkill(u, 'A026')
        elseif i == 2 then
            call SelectHeroSkill(u, 'A026')
        else
            call SelectHeroSkill(u, 'AOw2')
        endif
    
    endif


endfunction
//***************************************************************************
//*  AttackeHorde
function Attacker_Horde takes integer id,unit u,unit target,player p returns nothing
    local real x= GetUnitX(target)
    local real y= GetUnitY(target)
    local real x2= GetUnitY(u)
    local real y2= GetUnitY(u)
        
    //Obla,Ofar,Otch
    if IsUnitType(u, UNIT_TYPE_HERO) then
        // blade master A12F,AOwk,AOcr,AOww
        if id == 'obla' then
            set gInt=GetRandomInt(1, 5)
                if gInt <= 2 then
                    call IssueImmediateOrder(u, "windwalk")
                elseif gInt == 3 then
                    call IssueImmediateOrder(u, "roar")
                elseif gInt == 4 then
                    call IssueImmediateOrder(u, "whirlwind")
                endif
        
        /// farseer
        elseif id == 'Ofar' then
            set gInt=GetRandomInt(1, 6)
                if gInt == 1 then
                    call IssueTargetOrder(u, "chainlightning", target)
                elseif gInt == 2 then
                    call IssuePointOrder(u, "farsight", x + GetRandomReal(- 5000, 5000), y + GetRandomReal(- 5000, 5000))
                elseif gInt == 3 then
                    call IssueImmediateOrder(u, "spiritwolf")
                elseif gInt == 4 then
                    call IssuePointOrder(u, "monsoon", x, y)
                endif
        
        
        /// Tauren or general
        elseif id == 'Otch' or id == 'O02Z' then
            set gInt=GetRandomInt(1, 6)
                if gInt == 1 then
                    call IssueImmediateOrder(u, "stomp")
                elseif gInt == 3 then
                    call IssuePointOrder(u, "carrionswarm", x, y)
                endif
        endif
    else
        // ------ Юниты 

        /// Shaman
        if id == 'o01J' then
            set gInt=GetRandomInt(1, 5)
            if gInt == 1 then
                call IssueTargetOrder(u, "lightningshield", target)
            elseif gInt == 2 then
                call IssuePointOrder(u, "dispel", x, y)
            elseif gInt == 3 then
                call IssueTargetOrder(u, "purge", target)
            endif //+ спелл без приказа
        /// dark sham
        elseif id == 'o01V' then
            set gInt=GetRandomInt(1, 6)
            if gInt == 1 then
                call IssueTargetOrder(u, "soulburn", target)
            elseif gInt == 2 then
                call IssueImmediateOrder(u, "waterelemental")
            elseif gInt == 3 then
                call IssuePointOrder(u, "monsoon", x, y)
            endif
        /// Blood elf
        elseif id == 'o023' then
            set gInt=GetRandomInt(1, 6)
            if gInt == 1 then
            elseif gInt == 2 then
                call IssuePointOrder(u, "flamestrike", x, y)
            elseif gInt == 3 then
                call IssuePointOrder(u, "stampede", x, y)
            endif
        
        /// Troll or Dark mage
        elseif id == 'o024' or id == 'o02L' then
            set gInt=GetRandomInt(1, 6)
            if gInt == 1 then
                call IssuePointOrder(u, "evileye", x, y)
            elseif gInt == 2 then
                call IssuePointOrder(u, "stasistrap", x, y)
            elseif gInt == 3 then
                call IssuePointOrder(u, "healingward", x2, y2)
            endif
        endif
    endif
    

endfunction
