//===========================================================================
// Trigger: LegGer
//===========================================================================
function Trig_LegGer_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A11U'
endfunction


function Trig_LegGer_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    
    
    if GetUnitAbilityLevelSwapped('A11U', GetTriggerUnit()) == 1 then
        call UnitAddAbilityBJ('A11V', u)
        call RemoveAbilityTimed(u , 'A11V' , 15)
    
    elseif GetUnitAbilityLevelSwapped('A11U', GetTriggerUnit()) == 2 then
        call UnitAddAbilityBJ('A11W', u)
        call RemoveAbilityTimed(u , 'A11W' , 15)
    
    elseif GetUnitAbilityLevelSwapped('A11U', GetTriggerUnit()) == 3 then
        call UnitAddAbilityBJ('A11X', u)
        call RemoveAbilityTimed(u , 'A11X' , 15)
    
    elseif GetUnitAbilityLevelSwapped('A11U', GetTriggerUnit()) == 4 then
        call UnitAddAbilityBJ('A11Y', u)
        call RemoveAbilityTimed(u , 'A11Y' , 15)
      
    endif
    set u=null
endfunction

//===========================================================================
function InitTrig_LegGer takes nothing returns nothing
    set gg_trg_LegGer=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_LegGer, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_LegGer, Condition(function Trig_LegGer_Conditions))
    call TriggerAddAction(gg_trg_LegGer, function Trig_LegGer_Actions)
endfunction


