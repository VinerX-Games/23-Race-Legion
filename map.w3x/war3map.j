//===========================================================================
// Trigger: RepEc
//===========================================================================

function FixEcEnum takes nothing returns nothing
    local unit u= GetEnumUnit()
    local integer pi= GetPlayerId(GetOwningPlayer(u))

    if GetUnitAbilityLevel(u, 'AHad') > 0 then
        set CityPlayerCount[pi]=CityPlayerCount[pi] + 1
    endif

    call AddCountDis(u , pi)
    set u=null
endfunction


function UnitAliveBool takes nothing returns boolean
    return UnitAlive(GetFilterUnit())
    
endfunction

function FixEc takes integer pi returns nothing
    local real r
    local group g= CreateGroup()
    local boolexpr b= Condition(function UnitAliveBool)
    call ClearEc(pi)
    
    
    call GroupEnumUnitsOfPlayer(g, Player(pi), b)
    call ForGroup(g, function FixEcEnum)
    
    if udg_GameMode == 3 then
        call PercentGraph(pi)
    endif
    
    
    call DestroyGroup(g)
    set g=null
    call DestroyBoolExpr(b)
    set b=null
endfunction

function FixEcAll takes nothing returns nothing
    local integer i= 0
    //local timer t = GetExpiredTimer()
    
   
    loop
        exitwhen i >= 23
        
        call FixEc(i)
        call DisplayTextToPlayer(Player(i), 0, 0, "Экономика всех игроков пересчитана чтобы избежать непредвиденных багов, это экпериментальная функция")
        set i=i + 1
    endloop
    
    
endfunction



function Trig_RepEc_Actions takes nothing returns nothing
    
    local integer pi= GetPlayerId(GetTriggerPlayer())
    call FixEc(pi)
   
 
endfunction

//===========================================================================
function InitTrig_RepEc takes nothing returns nothing
    local integer i= 0
    local timer t= CreateTimer()
    set gg_trg_RepEc=CreateTrigger()
    loop
        exitwhen i >= 24
        call TriggerRegisterPlayerChatEvent(gg_trg_RepEc, Player(i), "-repec", true)
        set i=i + 1
    
    endloop
    
    
    call TriggerAddAction(gg_trg_RepEc, function Trig_RepEc_Actions)
    call TimerStart(t, 60 * 7, true, function FixEcAll)
endfunction




//===========================================================================
// Trigger: Gob Potreblenie
//
// Цена за нефть)
//===========================================================================
function Trig_Gob_Potreblenie_Conditions takes nothing returns boolean
    return GetResearched() == 'R04N'
endfunction

function Trig_Gob_Potreblenie_Func001002 takes nothing returns boolean
    return GetUnitAbilityLevel(GetFilterUnit(), 'A0A5') != 0
endfunction


function Trig_Gob_Potreblenie_Actions takes nothing returns nothing
    local group g= CreateGroup()
    local player p= GetOwningPlayer(GetTriggerUnit())
    local integer pi= GetPlayerId(p)
    local unit u
    local integer r= GetPlayerTechCount(p, 'R04N', true)
    set udg_Boolexpr=Condition(function Trig_Gob_Potreblenie_Func001002)
    call GroupEnumUnitsOfPlayer(g, p, udg_Boolexpr)
    loop
        set u=FirstOfGroup(g)
        exitwhen u == null
        
        set udg_Price=GetUnitGoldCost(GetUnitTypeId(u))
        if GetUnitAbilityLevel(u, 'A0A5') != 0 then
            set disincome[pi]=disincome[pi] - ( udg_Price * Tax ) * ( 1.60 - ( 0.10 * ( r - 1 ) ) )
            set disincome[pi]=disincome[pi] + ( udg_Price * Tax ) * ( 1.60 - ( 0.10 * r ) )
        endif
        
        
        
        call GroupRemoveUnit(g, u)
    endloop
    call UpdateGraf(pi)
    call GroupClear(udg_LocalOtrad2)
    
    call GroupClear(g)
    call DestroyGroup(g)
    set u=null
    set g=null
endfunction

//===========================================================================
function InitTrig_Gob_Potreblenie takes nothing returns nothing
    set gg_trg_Gob_Potreblenie=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Gob_Potreblenie, EVENT_PLAYER_UNIT_RESEARCH_FINISH)
    call TriggerAddCondition(gg_trg_Gob_Potreblenie, Condition(function Trig_Gob_Potreblenie_Conditions))
    call TriggerAddAction(gg_trg_Gob_Potreblenie, function Trig_Gob_Potreblenie_Actions)
endfunction


//===========================================================================
// Trigger: Silitid Potreblenie
//
// Цена за нефть)
//===========================================================================
function Trig_Silitid_Potreblenie_Conditions takes nothing returns boolean
    return GetResearched() == 'R089'
endfunction

function HaveSilitidSpell takes nothing returns boolean
    return GetUnitTypeId(GetFilterUnit()) == 'e02W'
    //return ( GetUnitAbilityLevelSwapped('A0VH', GetFilterUnit()) >=1 )
endfunction


function Trig_Silitid_Potreblenie_Actions takes nothing returns nothing
    local group g= CreateGroup()
    local player p= GetOwningPlayer(GetTriggerUnit())
    local integer pi= GetPlayerId(p)
    local unit u
    local integer r= GetPlayerTechCount(p, 'R04N', true)
    set udg_Boolexpr=Condition(function HaveSilitidSpell)
    call GroupEnumUnitsOfPlayer(g, p, udg_Boolexpr)
    loop
        set u=FirstOfGroup(g)
        exitwhen u == null
        
        set udg_Price=GetUnitGoldCost(GetUnitTypeId(u))
        set disincome[pi]=disincome[pi] - ( udg_Price * Tax / 2 )
        set disincome[pi]=disincome[pi] + ( udg_Price * Tax / 3 )

        call GroupRemoveUnit(g, u)
    endloop
    call GroupClear(udg_LocalOtrad2)
    call UpdateGraf(pi)
    call GroupClear(g)
    call DestroyGroup(g)
    set u=null
    set g=null
    set p=null
endfunction

//===========================================================================
function InitTrig_Silitid_Potreblenie takes nothing returns nothing
    set gg_trg_Silitid_Potreblenie=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Silitid_Potreblenie, EVENT_PLAYER_UNIT_RESEARCH_FINISH)
    call TriggerAddCondition(gg_trg_Silitid_Potreblenie, Condition(function Trig_Silitid_Potreblenie_Conditions))
    call TriggerAddAction(gg_trg_Silitid_Potreblenie, function Trig_Silitid_Potreblenie_Actions)
endfunction


