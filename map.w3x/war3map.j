//*  HasEnemyNear
function HasEnemyNear takes unit u returns boolean
    
    if u != null then
        set CheckPlayer=GetOwningPlayer(u)
        call GroupEnumUnitsInRange(gGroup, GetUnitX(u), GetUnitY(u), 11000, udg_B_EnemyUnit)
        if FirstOfGroup(gGroup) != null then
            return true
        endif
    endif

    return false
endfunction
