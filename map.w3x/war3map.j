function strategFleetGrades takes integer i,player p,integer id returns nothing
    if i > 45 then
        call MakeGradeCheckCap(p , id , 'R005' , 6)
        call MakeGradeCheckCap(p , id , 'R006' , 6)
        call MakeGradeCheckCap(p , id , 'R007' , 6)
        call MakeGradeCheckCap(p , id , 'R002' , 6)
        call MakeGradeCheckCap(p , id , 'R003' , 6)
    endif
endfunction
//***************************************************************************
//*  StartBloodElves
function startBloodElves takes integer pi returns nothing
        call CreateNUnitsAtLoc(8, 'h04K', Player(pi), udg_LocalPoint, bj_UNIT_FACING)
        call GroupAddGroup(GetLastCreatedGroup(), udg_Ai_units[pi])
        call GroupAddGroup(GetLastCreatedGroup(), udg_Ai_builders[pi])
        call CreateNUnitsAtLoc(1, 'h04C', Player(pi), udg_LocalPoint, bj_UNIT_FACING)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Ai_units[pi])
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Ai_buildings[pi])
        call SaveInteger(AiData, pi, 'h04K', 8)
        call SaveInteger(AiData, pi, 'h04C', 1)
        call SetPlayerName(Player(pi), "Эльфы Крови (" + I2S(pi + 1) + ")")
        call SaveStr(AiData, pi, StringHash("Race"), "BE")
        call TriggerExecute(gg_trg_BloodElvesOn)
        set AiRace[pi]="BloodElves"
endfunction
//***************************************************************************
//*  JoinBloodElves
function Join_BloodElves takes integer id,integer pi,unit u returns nothing

    
    if id == 'h04K' then
        call GroupAddUnit(udg_Ai_builders[pi], u)
    elseif id == 'h00X' or id == 'h00Y' or id == 'h00Z' then
        call GroupAddUnit(udg_Ai_navy[pi], u)
        call NumberAdd(pi , StringHash("NumberN"))
    elseif aiUnitJoinsCapitalGuard(u , pi) then
    else
        call aiUnitJoinsArmy(u , pi)
    endif



//Герои
    //Герой ЧАродей
    if id == 'H034' then
        set gInt=GetRandomInt(1, 3)
        if gInt == 1 then
            call SelectHeroSkill(u, 'AHfs')
        elseif gInt == 2 then
            call SelectHeroSkill(u, 'AHbn')
        else
            call SelectHeroSkill(u, 'AHdr')
        endif
    
    
    //Герой Странник
    elseif id == 'Hjnd' then
        set gInt=GetRandomInt(1, 3)
        if gInt == 1 then
            call SelectHeroSkill(u, 'A07U')
        elseif gInt == 2 then
            call SelectHeroSkill(u, 'A0LQ')
        else
            call SelectHeroSkill(u, 'A07V')
        endif
    
    
    //Герой Паладин
    elseif id == 'H045' then
        set gInt=GetRandomInt(1, 3)
        if gInt == 1 then
            call SelectHeroSkill(u, 'A08H')
        elseif gInt == 2 then
            call SelectHeroSkill(u, 'A07W')
        else
            call SelectHeroSkill(u, 'AHbh')
        endif
    
    
    //Флот 
    elseif id == 'h00Z' then
        call IssueImmediateOrder(u, "nagabuild")
        call IssueImmediateOrder(u, "spellbook")
        set gInt=GetRandomInt(1, 3)
        if gInt == 1 then
            call IssueImmediateOrder(u, "nagabuild")
        elseif gInt == 2 then
            call IssueImmediateOrder(u, "mounthippogryph")
        else
            call IssueImmediateOrder(u, "monsoon")
        endif
        
    endif
endfunction
//***************************************************************************
//*  AttackedBloodElves
function AttackedBloodElves takes unit u returns nothing
    //Мечник
    if GetUnitTypeId(u) == 'h03V' then
        set gInt=GetRandomInt(1, 5)
        if gInt == 1 then
            call IssueImmediateOrder(u, "defend")
        elseif gInt == 2 then
            call IssueImmediateOrder(u, "manashieldon")
        elseif gInt == 3 then
            call IssueImmediateOrder(u, "undefend")
        endif
   
    elseif GetUnitTypeId(u) == 'h03B' then
        set gInt=GetRandomInt(1, 3)
        if gInt == 1 then
            call IssueImmediateOrder(u, "defend")
        elseif gInt == 2 then
            call IssueImmediateOrder(u, "undefend")
        
        endif
    endif

endfunction
//***************************************************************************
//*  AttackerBloodElves
function Attacker_BloodElves takes integer id,unit u,unit target,player p returns nothing
    local integer i
    local real x= GetUnitX(target)
    local real y= GetUnitY(target)
    local real x2
    local real y2
    
    //Чародей
    if id == 'H043' then
        set i=GetRandomInt(1, 6)
            if i == 1 then
                call IssueTargetOrder(u, "banish", target)
            elseif i == 2 then
                call IssueTargetOrder(u, "steal", target)
            elseif i == 3 then
                call IssuePointOrder(u, "flamestrike", x, y)
            elseif i == 4 then
                call IssueImmediateOrder(u, "summonphoenix")
            endif
    
    ///Если герой Ренджер
    elseif id == 'Hjnd' then
        set i=GetRandomInt(1, 3)
            if i == 1 and not IsUnitType(target, UNIT_TYPE_STRUCTURE) then
                call IssueTargetOrder(u, "shadowstrike", target)
            elseif IsUnitType(target, UNIT_TYPE_HERO) then
                call IssueTargetOrder(u, "faeriefire", target)
            endif
    
    
    ///Если герой Паладин
    elseif id == 'H045' then
        set i=GetRandomInt(1, 5)
            if i == 1 then
                call IssueImmediateOrder(u, "roar")
            elseif i == 2 then
                call IssueImmediateOrder(u, "fanofknives")
            elseif i == 3 then
                call IssueImmediateOrder(u, "ressurection")
            endif
    
// ------ Юниты    
    
    ///Всадник
    elseif id == 'H03H' then
        set i=GetRandomInt(1, 4)
            if i == 1 then
                call IssueImmediateOrder(u, "berserk")
            endif
            
    
    ///Магистр
    elseif id == 'n040' then
        set i=GetRandomInt(1, 5)
            if i == 1 then
                call IssueImmediateOrder(u, "frostarmoron")
                call IssueImmediateOrder(u, "curseoff")
            elseif i == 2 then
                call IssueImmediateOrder(u, "frostarmoroff")
                call IssueImmediateOrder(u, "curseon")
            
            elseif i == 3 then
                set x2=GetUnitX(u) - GetUnitX(target)
                set y2=GetUnitY(u) - GetUnitY(target)
                if SquareRoot(x2 * x2 + y2 * y2) < 490 then
                    call IssueTargetOrder(u, "carrionswarm", target)
                endif
            endif
    
    /// Арканистка
    elseif id == 'h041' then
        set i=GetRandomInt(1, 3)
            if i == 1 then
                call IssueTargetOrder(u, "polymorph", target)
            elseif i == 2 then
                set x2=GetUnitX(u) - GetUnitX(target)
                set y2=GetUnitY(u) - GetUnitY(target)
                if SquareRoot(x2 * x2 + y2 * y2) < 490 then
                    call IssueTargetOrder(u, "devourmagic", target)
                endif
            endif
    //Чернокнижник
    elseif id == 'h042' then
        set i=GetRandomInt(1, 6)
            if i == 1 then
                call IssueImmediateOrder(u, "faeriefireoff")
                call IssueImmediateOrder(u, "curseon")
                call IssueImmediateOrder(u, "bloodlustoff")
            elseif i == 2 then
                call IssueImmediateOrder(u, "faeriefireoff")
                call IssueImmediateOrder(u, "curseoff")
                call IssueImmediateOrder(u, "bloodluston")
            elseif i == 3 then
                call IssueImmediateOrder(u, "faeriefireon")
                call IssueImmediateOrder(u, "curseoff")
                call IssueImmediateOrder(u, "bloodluston")
            
            endif
    // Рыцарь крови
    elseif id == 'H03Y' then
        set i=GetRandomInt(1, 3)
            if i == 1 then
                set CheckPlayer=p
                call GroupEnumUnitsInRange(gGroup, x, y, 550, ToHeal)
                set gUnit2=GroupPickRandomUnit2(gGroup)
                call IssueTargetOrder(u, "healingwave", gUnit2)
            
            endif
    
    // ФЛот
    else
        call Attacker_HumanFleet(id , u , target , x , y)
    endif

endfunction
//***************************************************************************
//*  StrategBloodElves
function Strateg_BloodElves_EC takes integer id returns nothing
    //Это ферма
    if id == 'h04M' then
        set udg_LocalInteger3=udg_LocalInteger3 + 1
    //Это Т1
    elseif id == 'h04C' then
        set udg_LocalInteger3=udg_LocalInteger3 + 2
    //Это Т2
    elseif id == 'h04B' then
        set udg_LocalInteger3=udg_LocalInteger3 + 5
    //Это Т3
    elseif id == 'h04A' then
        set udg_LocalInteger3=udg_LocalInteger3 + 8
    endif
endfunction

function Strateg_BloodElves takes integer i,integer pi,player p returns nothing
       local integer r=0
       if Grades[pi] < 100 then
           if i > 17 then


                set r=GetRandomInt(1, 3)
                
                if r == 1 then
                // Кузница
                call MakeGradeCheckCap(p , 'h04R' , 'R01L' , 6)
                call MakeGradeCheckCap(p , 'h04R' , 'R01J' , 6)
                call MakeGradeCheckCap(p , 'h04R' , 'R01K' , 6)
                call MakeGradeCheckCap(p , 'h04R' , 'R01M' , 6)
                elseif r == 2 then
                call MakeGradeCheckCap(p , 'h04R' , 'R01R' , 6)
                
                // Лесопилка
                call MakeGradeCheckCap(p , 'h04Q' , 'R03I' , 6)
                call MakeGradeCheckCap(p , 'h04Q' , 'R03J' , 6)
                call MakeGradeCheckCap(p , 'h04Q' , 'R01N' , 6)
                else
                call MakeGradeCheckCap(p , 'h04Q' , 'R01T' , 6)

                call MakeGradeCheckCap(p , 'h04Q' , 'R03E' , 6)
                call MakeGradeCheckCap(p , 'h04Q' , 'R03F' , 6)
                
                //Казармы
                call MakeGradeCheckCap(p , 'h04D' , 'R03K' , 1)
                
                //Покупка предмета
                endif
            endif

            


            if i > 35 and ( LoadInteger(AiData, pi, 'h04B') + LoadInteger(AiData, pi, 'h04A') >= 1 ) then


                 set r=GetRandomInt(1, 3)
                if r == 1 then
                    // Казармы R01Y,R01X,R01V,R01W
                    call MakeGradeCheckCap(p , 'h04D' , 'R01Y' , 1)
                    call MakeGradeCheckCap(p , 'h04D' , 'R01X' , 1)
                    
                    call MakeGradeCheckCap(p , 'h04D' , 'R01W' , 1)
                    call MakeGradeCheckCap(p , 'h04D' , 'R01W' , 1)
                    
                    // Здание магов R0BU,R01O,R01P,R01Q,R01S
                    call MakeGradeCheckCap(p , 'h04E' , 'R0BU' , 1)
                    call MakeGradeCheckCap(p , 'h04E' , 'R01O' , 6)
        
                elseif r == 2 then
                    call MakeGradeCheckCap(p , 'h04E' , 'R01P' , 6)
                    call MakeGradeCheckCap(p , 'h04E' , 'R01Q' , 6)
                    call MakeGradeCheckCap(p , 'h04E' , 'R01S' , 1)

                    
                    //Мастерская R03N,R021,R0KF
                   
                    call MakeGradeCheckCap(p , 'h04G' , 'R03N' , 6)
                    call MakeGradeCheckCap(p , 'h04G' , 'R021' , 6)
                else
                    call MakeGradeCheckCap(p , 'h04G' , 'R021' , 6)
                    call MakeGradeCheckCap(p , 'h04G' , 'R03Q' , 6)
                    call MakeGradeCheckCap(p , 'h04G' , 'R021' , 6)
                    call MakeGradeCheckCap(p , 'h04G' , 'Rhcd' , 6)
                endif
                
                
                //Хранилище маны

                set r=GetRandomInt(0, 4)
                if r == 0 then
                    call MakeGradeCheckCap(p , 'h04F' , 'R03R' , 3)
                elseif r == 1 then
                    call MakeGradeCheckCap(p , 'h04F' , 'R01H' , 3)
                elseif r == 2 then
                    call MakeGradeCheckCap(p , 'h04F' , 'R01I' , 3)
                elseif r == 3 then
                    call MakeGradeCheckCap(p , 'h04F' , 'R01G' , 3)
                else
                    call MakeGradeCheckCap(p , 'h04F' , 'R01D' , 3)
                endif
            
                // Флот
                if i > 45 then
                    call MakeGradeCheckCap(p , 'h011' , 'R005' , 6)
                    call MakeGradeCheckCap(p , 'h011' , 'R006' , 6)
                    call MakeGradeCheckCap(p , 'h011' , 'R007' , 6)
                    call MakeGradeCheckCap(p , 'h011' , 'R002' , 6)
                    call MakeGradeCheckCap(p , 'h011' , 'R003' , 6)
                endif
            

                
                
               
            endif
        else
            call warRace(Grades[pi] , p)

        endif
        
        
        //Купи предмет простой
        if i > 20 and GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD) > 2000 then
            call TryBuy(p , i)
        endif

        //Делай т2
        if i > 25 and LoadInteger(AiData, pi, 'h04B') < 3 then
            call BuildT(p , 'h04C' , 'h04B')
        endif

        //Делай т3
        if i > 55 and LoadInteger(AiData, pi, 'h04A') < 3 then
            call BuildT(p , 'h04B' , 'h04A')
        endif

        //Спавн мага тп
        if i > 60 and LoadInteger(AiData, pi, 'h07A') < 3 then
            call MakeMageTp(pi)
        endif


        
        
        
endfunction
//***************************************************************************
//*  BuildBloodElves
function ChooseBuildings_BloodElves takes integer pi returns integer
    local integer i

    // Инициализируем массив и добавляем стартовый вариант
    set tArray[0]=1
    set tArray[1]='h04M' // 1 Ферма

    // Добавляем здания по условиям
    call CheckAndAddBuilding(pi , 'h04C' , 4 , 4) // Ратуша
    call CheckAndAddBuilding(pi , 'h04M' , 15 , 4) // Дополнительные фермы
    call CheckAndAddBuilding(pi , 'h04D' , 15 , 4) // Казарма
    call CheckAndAddBuilding(pi , 'h04N' , 25 , 1) // Башня
    call CheckAndAddBuilding(pi , 'h04Q' , 5 , 2) // Лесопилка
    call CheckAndAddBuilding(pi , 'h04R' , 6 , 2) // Кузница
    call CheckAndAddBuilding(pi , 'h05J' , 3 , 8) // Алтарь

    // Проверяем условия для Мастерской и Храма
    if LoadInteger(AiData, pi, 'h04B') + LoadInteger(AiData, pi, 'h04A') >= 1 then
        call CheckAndAddBuilding(pi , 'h04G' , 15 , 8) // Мастерская
        call CheckAndAddBuilding(pi , 'h04E' , 15 , 8) // Храм
    endif

    // Хранилище энергии
    call CheckAndAddBuilding(pi , 'h04F' , 12 , 2)

    // Выбираем случайный вариант из массива
    set i=GetRandomInt(1, tArray[0])
    return tArray[i]
endfunction


//***************************************************************************
//*  BuildingsBloodElves
            
            
            
function PereborBuildings2_BloodElves takes integer id,integer pi,unit u returns nothing
    local integer b= 0
    local integer i= 0
    local integer array a
        if id == 'h04D' then //Казармы
    

            set a[0]=1 //Кол-во вариантов со старта
            set a[1]='h03V' // 1 Пехотинец

            // Доп. варианты при условиях

            // 2 Лучница
            if LoadInteger(AiData, pi, 'h04R') >= 1 then
                set i=1 //мошь выбора
                set b=1
                
                loop
                    set a[0]=a[0] + 1
                    set a[a[0]]='n00I'
                    
                    set b=b + 1
                    exitwhen b >= i
                endloop
            endif
            
            // 3 Всадник
            if LoadInteger(AiData, pi, 'h04B') + LoadInteger(AiData, pi, 'h04A') >= 1 then
                set i=4 //мошь выбора
                set b=1
                
                loop
                    set a[0]=a[0] + 1
                    set a[a[0]]='h03X'
                    set b=b + 1
                    exitwhen b >= i
                endloop
            endif
            
            // 4 Рыцарь крови
            if LoadInteger(AiData, pi, 'h04A') >= 1 then
                set i=6 //мошь выбора
                set b=1
                
                loop
                    set a[0]=a[0] + 1
                    set a[a[0]]='h03Y'
                    set b=b + 1
                    exitwhen b >= i
                endloop
            endif
            set i=GetRandomInt(1, a[0])
            call IssueImmediateOrderById(u, a[i])
            

        // Ратуша
        elseif id == 'h04C' then
             
                
                //Строитель
                if LoadInteger(AiData, pi, 'h04K') < 20 then
                    call IssueImmediateOrderById(u, 'h04K')
                endif
            
        // Мастеская
        elseif id == 'h04G' then
            set a[0]=0 //Кол-во вариантов со старта
            
            
            // Доп. варианты при условиях
            //Баллиста
            if LoadInteger(AiData, pi, 'h04B') + LoadInteger(AiData, pi, 'h04A') >= 1 then
                set i=1 //мошь выбора
                set b=1
                
                loop
                    set a[0]=a[0] + 1
                    set a[a[0]]='e001'
                    
                    set b=b + 1
                    exitwhen b >= i
                endloop
            endif

            

            // 2 Элем
            if LoadInteger(AiData, pi, 'h04B') + LoadInteger(AiData, pi, 'h04A') >= 1 then
                set i=2 //мошь выбора
                set b=1
                
                loop
                    set a[0]=a[0] + 1
                    set a[a[0]]='h046'
                    
                    set b=b + 1
                    exitwhen b >= i
                endloop
            endif
            
            // 3 Повозка
            if LoadInteger(AiData, pi, 'h04B') + LoadInteger(AiData, pi, 'h04A') >= 1 then
                set i=1 //мошь выбора
                set b=1
                
                loop
                    set a[0]=a[0] + 1
                    set a[a[0]]='e030'
                    set b=b + 1
                    exitwhen b >= i
                endloop
            endif
            
            // 4 Голем
            if LoadInteger(AiData, pi, 'h04A') >= 1 then
                set i=6 //мошь выбора
                set b=1
                
                loop
                    set a[0]=a[0] + 1
                    set a[a[0]]='h03Z'
                    set b=b + 1
                    exitwhen b >= i
                endloop
            endif
            set i=GetRandomInt(1, a[0])
            call IssueImmediateOrderById(u, a[i])
                   

        // Волшебное святилище
        elseif id == 'h04E' then
                set udg_LocalInteger3=GetRandomInt(1, 4)
                if udg_LocalInteger3 == 1 then
                    call IssueImmediateOrderById(u, 'h03W')
                elseif udg_LocalInteger3 == 2 then
                    call IssueImmediateOrderById(u, 'h040')
                elseif udg_LocalInteger3 == 2 then
                    call IssueImmediateOrderById(u, 'h041')
                else
                    call IssueImmediateOrderById(u, 'h042')
                endif
            
          
        // Алтарь
        elseif id == 'h05J' then
                set udg_LocalInteger3=GetRandomInt(1, 3)
                if udg_LocalInteger3 == 1 then
                    call IssueImmediateOrderById(u, 'Hjnd')
                endif
                if udg_LocalInteger3 == 2 then
                    call IssueImmediateOrderById(u, 'H043')
                endif
                if udg_LocalInteger3 == 3 then
                    call IssueImmediateOrderById(u, 'H045')
                endif
        
            
        endif
                
                
endfunction
                
                
                
                
                
                
//***************************************************************************
//*  UpgradeBloodElves
function UpgradeBloodElves takes integer pi,integer id returns nothing
    if id == 'h05V' then
        call NumberRem(pi , 'h05U')
    elseif id == 'h05W' then
        call NumberRem(pi , 'h05V')
    endif
endfunction
//***************************************************************************
//*  GetLvlBloodElves
function GetLvlBloodElves takes unit u returns nothing
    //Герой ЧАродей
    if GetUnitTypeId(u) == 'H043' then
            set gInt=GetRandomInt(1, 3)
            if GetHeroLevel(u) == 6 or GetHeroLevel(u) == 10 then
                call SelectHeroSkill(u, 'AHpx')
            elseif gInt == 1 then
                call SelectHeroSkill(u, 'AHfs')
            elseif gInt == 2 then
                call SelectHeroSkill(u, 'AHdr')
            else
                call SelectHeroSkill(u, 'AHpx')
            endif
    



    //Герой Ренодежр
    elseif GetUnitTypeId(u) == 'Hjnd' then
            set gInt=GetRandomInt(1, 3)
            if GetHeroLevel(u) == 6 or GetHeroLevel(u) == 10 then
                call SelectHeroSkill(u, 'A07V')
            elseif gInt == 1 then
                call SelectHeroSkill(u, 'A07U')
            elseif gInt == 2 then
                call SelectHeroSkill(u, 'A0LQ')
            else
                call SelectHeroSkill(u, 'AEar')
            endif
    


    //Герой Паладин
    elseif GetUnitTypeId(u) == 'H045' then
            set gInt=GetRandomInt(1, 3)
            if GetHeroLevel(u) == 6 or GetHeroLevel(u) == 10 then
                call SelectHeroSkill(u, 'AHre')
            elseif gInt == 1 then
                call SelectHeroSkill(u, 'A08H')
            elseif gInt == 2 then
                call SelectHeroSkill(u, 'A07W')
            else
                call SelectHeroSkill(u, 'AHbh')
            endif
    endif

endfunction
//***************************************************************************
//*  StartScarlet
function startScarlet takes integer pi returns nothing
        //Старт юниты
        call CreateNUnitsAtLoc(8, 'h014', Player(pi), udg_LocalPoint, bj_UNIT_FACING)
        call GroupAddGroup(GetLastCreatedGroup(), udg_Ai_units[pi])
        call GroupAddGroup(GetLastCreatedGroup(), udg_Ai_builders[pi])
        call CreateNUnitsAtLoc(1, 'h05U', Player(pi), udg_LocalPoint, bj_UNIT_FACING)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Ai_units[pi])
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Ai_buildings[pi])

        call SaveInteger(AiData, pi, 'h014', 8)
        call SaveInteger(AiData, pi, 'h05U', 1)
        call SetPlayerName(Player(pi), "Алый Орден (" + I2S(pi + 1) + ")")
        call SaveStr(AiData, pi, StringHash("Race"), "AO")
        
        set AiRace[pi]="Scarlet"
endfunction
//***************************************************************************
//*  JoinScarlet
function Join_Skarlet takes integer id,integer pi,unit u returns nothing
    local integer i
    if id == 'h014' then
        call GroupAddUnit(udg_Ai_builders[pi], u)
    elseif id == 'h00X' or id == 'h00Y' or id == 'h00Z' then
        call GroupAddUnit(udg_Ai_navy[pi], u)
        call NumberAdd(pi , StringHash("NumberN"))
    elseif aiUnitJoinsCapitalGuard(u , pi) then
    else
        call aiUnitJoinsArmy(u , pi)
    endif


//Герои
    //Герой маг
    if id == 'H06C' then
        set i=GetRandomInt(1, 3)
        if i == 1 then
            call SelectHeroSkill(u, 'A09K')
        elseif i == 2 then
            call SelectHeroSkill(u, 'A09L')
        else
            call SelectHeroSkill(u, 'A09N')
        endif
    
    
    //Герой Капитан
    elseif id == 'H06B' then
        set i=GetRandomInt(1, 3)
        if i == 1 then
            call SelectHeroSkill(u, 'A09G')
        elseif i == 2 then
            call SelectHeroSkill(u, 'A09F')
        else
            call SelectHeroSkill(u, 'A09I')
        endif
    
    
    //Герой Паладин
    elseif id == 'H03H' then
        set i=GetRandomInt(1, 3)
        if i == 1 then
            call SelectHeroSkill(u, 'A097')
        elseif i == 2 then
            call SelectHeroSkill(u, 'A09C')
        else
            call SelectHeroSkill(u, 'A09D')
        endif
    
    
    //Флот 
    elseif id == 'h00Z' then
        call IssueImmediateOrder(u, "nagabuild")
        call IssueImmediateOrder(u, "spellbook")
        set i=GetRandomInt(1, 3)
        if i == 1 then
            call IssueImmediateOrder(u, "nagabuild")
        elseif i == 2 then
            call IssueImmediateOrder(u, "mounthippogryph")
        else
            call IssueImmediateOrder(u, "monsoon")
        endif
        
    endif


endfunction
//***************************************************************************
//*  AttackerScarlet
function Attacker_Skarlet takes integer id,unit u,unit target,player p returns nothing
    local integer i
    local real x= GetUnitX(target)
    local real y= GetUnitY(target)
    local real x2
    local real y2
    
    if id == 'H06C' then
        set i=GetRandomInt(1, 5)
            if i == 1 then
                call IssueTargetOrder(u, "firebolt", target)
            elseif i == 2 then
                call IssuePointOrder(u, "flamestrike", x, y)
            elseif i == 2 then
                call IssueImmediateOrder(u, "waterelemental")
            endif
    
    ///Если герой Капиатн
    elseif id == 'H06B' then
        set i=GetRandomInt(1, 5)
            if i == 1 then
                call IssueImmediateOrder(u, "berserk")
            elseif i == 2 then
                call IssueImmediateOrder(u, "thanderclap")
            elseif i == 3 then
                call IssueImmediateOrder(u, "roar")
            endif
    
    
    ///Если герой Паладин
    elseif id == 'H03H' then
        set i=GetRandomInt(1, 5)
            if i == 1 then
                set CheckPlayer=p
                call GroupEnumUnitsInRange(gGroup, x, y, 450, ToHeal)
                set gUnit2=GroupPickRandomUnit2(gGroup)
                call IssueTargetOrder(u, "firebolt", gUnit2)
            elseif i == 2 then
                call IssueImmediateOrder(u, "roar")
            elseif i == 2 then
                call IssueImmediateOrder(u, "ressurection")
            endif
    
// ------ Юниты    
    
    ///Монахиня
    elseif id == 'h067' then
        set i=GetRandomInt(1, 4)
            if i == 1 then
                call IssueTargetOrder(u, "flamingarrows", target)
            elseif i == 2 then
                set x2=GetUnitX(u) - GetUnitX(target)
                set y2=GetUnitY(u) - GetUnitY(target)
                if SquareRoot(x2 * x2 + y2 * y2) < 525 then
                    call IssueTargetOrder(u, "devourmagic", target)
                endif
            endif
            
    
    ///Жрец
    elseif id == 'n008' then
        set i=GetRandomInt(1, 4)
            if i == 1 then
                call IssueTargetOrder(u, "flamingarrows", target)
            elseif i == 2 then
                set x2=GetUnitX(u) - GetUnitX(target)
                set y2=GetUnitY(u) - GetUnitY(target)
                if SquareRoot(x2 * x2 + y2 * y2) < 490 then
                    call IssueTargetOrder(u, "dispel", target)
                endif
            endif
    
    ///Гладиатор
    elseif id == 'h03G' then
        set i=GetRandomInt(1, 3)
            if i == 1 then
                call IssueTargetOrder(u, "berserk", target)
            elseif i == 2 then
                call IssuePointOrder(u, "roar", x, y)
            endif
    
    
    elseif id == 'h00Z' or id == 'h00Y' and IsUnitType(target, UNIT_TYPE_STRUCTURE) == false then
        set i=GetRandomInt(1, 6)
            if i == 1 and GetUnitStatePercent(target, UNIT_STATE_LIFE, UNIT_STATE_MAX_LIFE) < GetUnitStatePercent(u, UNIT_STATE_LIFE, UNIT_STATE_MAX_LIFE) then
                set x2=GetUnitX(u) - GetUnitX(target)
                set y2=GetUnitY(u) - GetUnitY(target)
                if SquareRoot(x2 * x2 + y2 * y2) < 125 then
                    call IssueTargetOrder(u, "ancestralspirit", target)
                else
                    //call IssuePointOrder(u, "Move", x,y)
                endif
            elseif i == 2 then
                set x2=GetUnitX(u) - GetUnitX(target)
                set y2=GetUnitY(u) - GetUnitY(target)
                if SquareRoot(x2 * x2 + y2 * y2) < 300 then
                    call IssuePointOrder(u, "clusterrockets", x, y)
                else
                    //call IssuePointOrder(u, "Move", x,y)
                endif
                
                
            elseif i == 3 and GetUnitStatePercent(u, UNIT_STATE_LIFE, UNIT_STATE_MAX_LIFE) < 45 then
                call IssueImmediateOrder(u, "tranquility")
            endif
    endif
    
endfunction
//***************************************************************************
//*  AttackedScarlet
function AttackedScarlet takes unit u returns nothing
        //Тяж Пехотинец
        if GetUnitTypeId(u) == 'h039' then
            set gInt=GetRandomInt(1, 5)
            if gInt == 1 then
                call IssueImmediateOrder(u, "defend")
            elseif gInt == 2 then
                call IssueImmediateOrder(u, "magicdefense")
            elseif gInt == 3 then
                call IssueImmediateOrder(u, "undefend")
            elseif gInt == 4 then
                call IssueImmediateOrder(u, "magicundefense")
            
            endif
        
        //Мечник
        elseif GetUnitTypeId(u) == 'h03B' then
            set gInt=GetRandomInt(1, 3)
            if gInt == 1 then
                call IssueImmediateOrder(u, "defend")
            elseif gInt == 2 then
                call IssueImmediateOrder(u, "undefend")
            
            endif
        endif
endfunction
//***************************************************************************
//*  StrategScarlet
function Strateg_Scarlet_EC takes integer id returns nothing
    //Это ферма
    if id == 'h05Y' then
        set udg_LocalInteger3=udg_LocalInteger3 + 1
    //Это Т1
    elseif id == 'h05U' then
        set udg_LocalInteger3=udg_LocalInteger3 + 2
    //Это Т2
    elseif id == 'h05V' then
        set udg_LocalInteger3=udg_LocalInteger3 + 5
    //Это Т3
    elseif id == 'h05W' then
        set udg_LocalInteger3=udg_LocalInteger3 + 8
    endif
endfunction

function Strateg_Scarlet takes integer i,integer pi,player p returns nothing
        local integer r=0
        
        
        if Grades[pi] < 100 then
            if i > 17 then

                // Кузница
                call MakeGradeCheckCap(p , 'h060' , 'R04B' , 6)
                call MakeGradeCheckCap(p , 'h060' , 'R04A' , 6)
                call MakeGradeCheckCap(p , 'h060' , 'R049' , 6)
                call MakeGradeCheckCap(p , 'h060' , 'R048' , 6)
                call MakeGradeCheckCap(p , 'h060' , 'R04C' , 6)
                
                // Лесопилка
                call MakeGradeCheckCap(p , 'h062' , 'RHac' , 6)
                call MakeGradeCheckCap(p , 'h062' , 'Rhlh' , 6)
                
                //Казармы
                call MakeGradeCheckCap(p , 'h05Z' , 'R03K' , 3)
                
                //Покупка предмета
                if GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD) > 2000 then
                    call TryBuy(p , i)
                endif
            endif

            


            if i > 35 and ( LoadInteger(AiData, pi, 'h05V') + LoadInteger(AiData, pi, 'h05W') >= 1 ) then

                // Казармы
                call MakeGradeCheckCap(p , 'h05Z' , 'R03W' , 2)
                call MakeGradeCheckCap(p , 'h05Z' , 'R03V' , 2)
                
                call MakeGradeCheckCap(p , 'h05Z' , 'R03L' , 2)
                call MakeGradeCheckCap(p , 'h05Z' , 'R03M' , 2)
                
                // Храм
                call MakeGradeCheckCap(p , 'h061' , 'R03Y' , 3)
                call MakeGradeCheckCap(p , 'h061' , 'R03X' , 3)
                
                //Мастерская
                set r=GetRandomInt(1, 2)
                if r == 1 then
                    call MakeGradeCheckCap(p , 'h064' , 'R03T' , 6)
                else
                    call MakeGradeCheckCap(p , 'h064' , 'R03S' , 6)
                endif
                call MakeGradeCheckCap(p , 'h064' , 'R047' , 6)
                call MakeGradeCheckCap(p , 'h064' , 'R046' , 6)
                call MakeGradeCheckCap(p , 'h064' , 'R045' , 6)
                call MakeGradeCheckCap(p , 'h064' , 'R03U' , 6)
            endif

            // Флот
            if i > 45 then
                call MakeGradeCheckCap(p , 'h011' , 'R005' , 6)
                call MakeGradeCheckCap(p , 'h011' , 'R006' , 6)
                call MakeGradeCheckCap(p , 'h011' , 'R007' , 6)
                call MakeGradeCheckCap(p , 'h011' , 'R002' , 6)
                call MakeGradeCheckCap(p , 'h011' , 'R003' , 6)
            endif
        else
            call warRace(Grades[pi] , p)
        
        endif

        //Делай т2
        if i > 25 and LoadInteger(AiData, pi, 'h05V') < 3 then
            call BuildT(p , 'h05U' , 'h05V')
        endif
        
        //Делай т3
        if i > 55 and LoadInteger(AiData, pi, 'h05W') < 3 then
            call BuildT(p , 'h05V' , 'h05W')
        endif

        //Спавн мага тп
        if i > 60 and LoadInteger(AiData, pi, 'h07A') < i / 35 then
            call MakeMageTp(pi)
        endif

        //Выбор Пути Ордена
        if i > 65 and LoadInteger(AiData, pi, 'h05V') >= 1 then
            set r=GetRandomInt(1, 2)
            if r == 1 then
                call MakeGradeCheckCap(p , 'h05W' , 'R040' , 1)
                call SaveBoolean(AiData, pi, 'R040', true)
            else
                call MakeGradeCheckCap(p , 'h05W' , 'R03Z' , 1)
                call SaveBoolean(AiData, pi, 'R03Z', true)
            endif
            
            
            // Церковь
            call MakeGradeCheckCap(p , 'h068' , 'R044' , 3)
            call MakeGradeCheckCap(p , 'h068' , 'R043' , 3)
            call MakeGradeCheckCap(p , 'h068' , 'R042' , 3)
            call MakeGradeCheckCap(p , 'h068' , 'R041' , 3)
        endif
        
        
        

    





endfunction
//***************************************************************************
//*  BuildScarlet
function ChooseBuildings_ScarletOrden takes integer pi returns integer
    local integer i

    // Инициализируем массив и добавляем стартовый вариант
    set tArray[0]=1
    set tArray[1]='h05Y' // 1 Ферма

    // Добавляем здания по условиям
    call CheckAndAddBuilding(pi , 'h05U' , 4 , 4) // Ратуша
    call CheckAndAddBuilding(pi , 'h05Y' , 15 , 4) // Дополнительные фермы
    call CheckAndAddBuilding(pi , 'h05Z' , 15 , 4) // Казарма
    call CheckAndAddBuilding(pi , 'h063' , 25 , 1) // Башня
    call CheckAndAddBuilding(pi , 'h062' , 5 , 2) // Лесопилка
    call CheckAndAddBuilding(pi , 'h060' , 6 , 2) // Кузница
    call CheckAndAddBuilding(pi , 'h05X' , 3 , 5) // Алтарь

    // Проверяем условия для Мастерской и Храма
    if LoadInteger(AiData, pi, 'h05V') + LoadInteger(AiData, pi, 'h05W') >= 1 then
        call CheckAndAddBuilding(pi , 'h064' , 7 , 8) // Мастерская
        call CheckAndAddBuilding(pi , 'h061' , 15 , 8) // Храм
    endif

    // Церковь
    if LoadInteger(AiData, pi, 'h05W') >= 1 and LoadInteger(AiData, pi, 'h068') < 15 then
        call AddBuilding('h068' , 10)
    endif

    // Выбираем случайный вариант из массива
    set i=GetRandomInt(1, tArray[0])
    return tArray[i]
endfunction



//***************************************************************************
//*  BuildingsScarletOrden
            
            
            
function PereborBuildings_ScarletOrden takes integer id,integer pi,unit u returns nothing
    local integer b= 0
    local integer i= 0
    local integer array a
    
    if id == 'h05Z' then //Казармы

        set a[0]=1 //Кол-во вариантов со старта
        set a[1]='h03B' // 1 Пехотинец

        // Доп. варианты при условиях

        // 2 Лучник
        if LoadInteger(AiData, pi, 'h060') >= 1 then
            set i=1 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='n007'
                
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        
        // 3 Тяж Мечник
        if LoadInteger(AiData, pi, 'h05V') + LoadInteger(AiData, pi, 'h05W') >= 1 then
            set i=4 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h039'
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        
        // 4 Всадник
        if LoadInteger(AiData, pi, 'h05W') >= 1 then
            set i=6 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h066'
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        set i=GetRandomInt(1, a[0])
        call IssueImmediateOrderById(u, a[i])


    // Ратуша
    elseif id == 'h05U' then
     
        
        set udg_LocalInteger3=GetRandomInt(1, 3)
        if udg_LocalInteger3 == 1 and LoadInteger(AiData, pi, 'h014') < 20 then
            call IssueImmediateOrderById(u, 'h014')

        elseif udg_LocalInteger3 == 2 and LoadInteger(AiData, pi, 'h03C') < 15 then
            call IssueImmediateOrderById(u, 'h03C')
            
        elseif udg_LocalInteger3 == 3 and LoadInteger(AiData, pi, 'h03A') < 15 then
            call IssueImmediateOrderById(u, 'h03A')
        else
        endif

    // Мастеская
    elseif id == 'h064' then
        call IssueImmediateOrderById(u, 'o00I')


    elseif id == 'h061' then
        set udg_LocalInteger3=GetRandomInt(1, 2)
        if udg_LocalInteger3 == 1 then
            call IssueImmediateOrderById(u, 'h067')
        elseif udg_LocalInteger3 == 2 then
            call IssueImmediateOrderById(u, 'n008')
        endif

    // Алтарь
    elseif id == 'h05X' then
        set udg_LocalInteger3=GetRandomInt(1, 3)
        if udg_LocalInteger3 == 1 then
            call IssueImmediateOrderById(u, 'H06C')
        endif
        if udg_LocalInteger3 == 2 then
            call IssueImmediateOrderById(u, 'H03H')
        endif
        if udg_LocalInteger3 == 3 then
            call IssueImmediateOrderById(u, 'H06B')
        endif
    // Церковь
    elseif id == 'h068' then

        set a[0]=1 //Кол-во вариантов со старта
        set a[1]=0 // Никто

        // Доп. варианты при условиях

        // 1 Паладин
        if LoadBoolean(AiData, pi, 'R040') and LoadInteger(AiData, pi, 'h05W') >= 1 then
            set i=1 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h03F'
                
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        
        // 3 Берсерк
        if LoadBoolean(AiData, pi, 'R040') and LoadInteger(AiData, pi, 'h05W') >= 1 then
            set i=1 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h03D'
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        
         // 3 Инквизитор
        if LoadBoolean(AiData, pi, 'R03Z') and LoadInteger(AiData, pi, 'h05W') >= 1 then
            set i=1 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h03I'
                
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        
        // 4 Гладиатор
        if LoadBoolean(AiData, pi, 'R03Z') and LoadInteger(AiData, pi, 'h05W') >= 1 then
            set i=1 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h03G'
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        
        set i=GetRandomInt(1, a[0])
        call IssueImmediateOrderById(u, a[i])
    
    endif
                
                
endfunction
                
                
                
                
                
                
//***************************************************************************
//*  UpgradeScarlet
function UpgradeScarlet takes integer pi,integer id returns nothing
    if id == 'h04B' then
        call NumberRem(pi , 'h04C')
    elseif id == 'h05A' then
        call NumberRem(pi , 'h04B')
    endif
endfunction
//***************************************************************************
//*  GetLvlScarlet
function GetLvlScarlet takes unit u returns nothing
    // Герои
        //Герой маг
        if GetUnitTypeId(u) == 'H06C' then
                set gInt=GetRandomInt(1, 3)
                if GetHeroLevel(u) == 6 or GetHeroLevel(u) == 10 then
                    call SelectHeroSkill(u, 'A09M')
                elseif gInt == 1 then
                    call SelectHeroSkill(u, 'A09K')
                elseif gInt == 2 then
                    call SelectHeroSkill(u, 'A09L')
                else
                    call SelectHeroSkill(u, 'A09N')
                endif
        



        //Герой Капитан
        elseif GetUnitTypeId(u) == 'H06B' then
                set gInt=GetRandomInt(1, 3)
                if GetHeroLevel(u) == 6 or GetHeroLevel(u) == 10 then
                    call SelectHeroSkill(u, 'A09J')
                elseif gInt == 1 then
                    call SelectHeroSkill(u, 'A09F')
                elseif gInt == 2 then
                    call SelectHeroSkill(u, 'A09G')
                else
                    call SelectHeroSkill(u, 'A09I')
                endif
        


        //Герой Паладин
        elseif GetUnitTypeId(u) == 'H03H' then
                set gInt=GetRandomInt(1, 3)
                if GetHeroLevel(u) == 6 or GetHeroLevel(u) == 10 then
                    call SelectHeroSkill(u, 'A09E')
                elseif gInt == 1 then
                    call SelectHeroSkill(u, 'A097')
                elseif gInt == 2 then
                    call SelectHeroSkill(u, 'A09C')
                else
                    call SelectHeroSkill(u, 'A09D')
                endif
        endif
endfunction
//***************************************************************************
//*  StartGoblins
function startGoblins takes integer pi returns nothing
        //Старт юниты
        call CreateNUnitsAtLoc(8, 'n00V', Player(pi), udg_LocalPoint, bj_UNIT_FACING)
        call GroupAddGroup(GetLastCreatedGroup(), udg_Ai_units[pi])
        call GroupAddGroup(GetLastCreatedGroup(), udg_Ai_builders[pi])
        call CreateNUnitsAtLoc(1, 'h070', Player(pi), udg_LocalPoint, bj_UNIT_FACING)
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Ai_units[pi])
        call GroupAddUnitSimple(GetLastCreatedUnit(), udg_Ai_buildings[pi])

        call SaveInteger(AiData, pi, 'n00V', 8)
        call SaveInteger(AiData, pi, 'h070', 1)
        call SetPlayerName(Player(pi), "Картель (" + I2S(pi + 1) + ")")
        call SaveStr(AiData, pi, StringHash("Race"), "GB")
        call TriggerExecute(gg_trg_GoblinsOn)
        call TriggerExecute(gg_trg_StartG)
        
        set AiRace[pi]="Goblins"
endfunction
//***************************************************************************
//*  JoinGoblins
function Join_Goblins takes integer id,integer pi,unit u returns nothing
    local integer i
    if id == 'n00V' then
        call GroupAddUnit(udg_Ai_builders[pi], u)
    elseif id == 'h06W' or id == 'h0DM' or id == 'h06V' or id == 'h06X' then //Гоблины then
        call GroupAddUnit(udg_Ai_navy[pi], u)
        call NumberAdd(pi , StringHash("NumberN"))
    elseif aiUnitJoinsCapitalGuard(u , pi) then
    else
        call aiUnitJoinsArmy(u , pi)
    endif


//Герои
    //Герой маг
    if id == 'H06C' then
        set i=GetRandomInt(1, 3)
        if i == 1 then
            call SelectHeroSkill(u, 'A09K')
        elseif i == 2 then
            call SelectHeroSkill(u, 'A09L')
        else
            call SelectHeroSkill(u, 'A09N')
        endif
    
    
    //Герой Капитан
    elseif id == 'H06B' then
        set i=GetRandomInt(1, 3)
        if i == 1 then
            call SelectHeroSkill(u, 'A09G')
        elseif i == 2 then
            call SelectHeroSkill(u, 'A09F')
        else
            call SelectHeroSkill(u, 'A09I')
        endif
    
    
    //Герой Паладин
    elseif id == 'H03H' then
        set i=GetRandomInt(1, 3)
        if i == 1 then
            call SelectHeroSkill(u, 'A097')
        elseif i == 2 then
            call SelectHeroSkill(u, 'A09C')
        else
            call SelectHeroSkill(u, 'A09D')
        endif
    
    
    //Флот 
    elseif id == 'h00Z' then
        call IssueImmediateOrder(u, "nagabuild")
        call IssueImmediateOrder(u, "spellbook")
        set i=GetRandomInt(1, 3)
        if i == 1 then
            call IssueImmediateOrder(u, "nagabuild")
        elseif i == 2 then
            call IssueImmediateOrder(u, "mounthippogryph")
        else
            call IssueImmediateOrder(u, "monsoon")
        endif
        
    endif


endfunction
//***************************************************************************
//*  AttackerGoblins
function Attacker_Goblins takes integer id,unit u,unit target,player p returns nothing
    local integer i
    local real x= GetUnitX(target)
    local real y= GetUnitY(target)
    local real x2
    local real y2
    
    // Спец
    if id == 'H0BD' then
        set i=GetRandomInt(1, 5)
            if i == 1 then
                call IssuePointOrder(u, "silence", x, y)
            elseif i == 2 then
                call IssuePointOrder(u, "clusterrockets", x, y)
            elseif i == 2 then
                call IssuePointOrder(u, "blizzard", x, y)
            endif
    
    ///Если герой алх
    elseif id == 'Galh' then
        set i=GetRandomInt(1, 5)
            if i == 1 then
                call IssueTargetOrder(u, "transmute", target)
            elseif i == 2 then
                call IssueTargetOrder(u, "acidbomb", target)
            elseif i == 3 then
                call IssueImmediateOrder(u, "chemicalrage")
            elseif i == 4 then
                call IssuePointOrder(u, "healingspray", GetUnitX(u), GetUnitY(u))
            endif
    
    
    ///Если герой механик
    elseif id == 'Gmex' then
        set i=GetRandomInt(1, 5)
            if i == 1 then
                call IssuePointOrder(u, "summonfactory", x, y)
            elseif i == 2 then
                call IssuePointOrder(u, "clusterrockets", x, y)
            elseif i == 3 then
                call IssueImmediateOrder(u, "robogoblin")
            endif
    
// ------ Юниты 

    /// рекрут
    elseif id == 'h06K' then
        set i=GetRandomInt(1, 4)
        if i == 1 then
            call IssuePointOrder(u, "flamestrike", x, y)
        endif
    /// Арта
    elseif id == 'h06Y' or id == 'h06Z' then
        if Random(1 , 4) then
            call IssueImmediateOrder(u, "bearform")
        elseif Random(1 , 4) then
            call IssueImmediateOrder(u, "unbearform")
        endif
    /// СуперБоец
    elseif id == 'h06P' then
        set i=GetRandomInt(1, 6)
        if i == 1 then
            call IssueImmediateOrder(u, "berserk")
        elseif i == 2 and DistanceBetweenUnitsXY(x , y , target) < 280 then
            call IssuePointOrder(u, "dispel", x, y)
        elseif i == 3 then
            call IssuePointOrder(u, "ward", x, y)
        endif
    endif
    
    //Машины c ускорением
    if GetUnitAbilityLevel(u, 'A0BL') > 0 and Random(1 , 4) then
       call IssueImmediateOrder(u, "berserk")
    endif
endfunction
