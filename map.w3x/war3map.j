//===========================================================================
// Trigger: BerserkTrol
//===========================================================================
function Trig_BerserkTrol_Conditions takes nothing returns boolean
    return GetUnitAbilityLevel(GetAttacker(), 'A0ZC') == 1 and Random(1 , 10)
endfunction

function Trig_BerserkTrol_Actions takes nothing returns nothing
    local unit u
    local sound s

    set u=GetAttacker()
    set s=gg_snd_BerserkerCaster
    call UnitAddAbility(u, 'A13H')
    call UnitAddAbility(u, 'A13I')
    call UnitAddAbility(u, 'Bbsk')
    
    call AttachSoundToUnit(s, u)
    call SetSoundVolume(s, 127)
    call StartSound(s)

    call RemoveAbilityTimed(u , 'A13H' , 9)
    call RemoveAbilityTimed(u , 'A13I' , 9)
    call RemoveAbilityTimed(u , 'Bbsk' , 9)
        
    set u=null
    set s=null
endfunction

//===========================================================================
function InitTrig_BerserkTrol takes nothing returns nothing
    set gg_trg_BerserkTrol=CreateTrigger()
    //call DisableTrigger( gg_trg_BerserkTrol )
    call TriggerRegisterAnyUnitEventBJ(gg_trg_BerserkTrol, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_BerserkTrol, Condition(function Trig_BerserkTrol_Conditions))
    call TriggerAddAction(gg_trg_BerserkTrol, function Trig_BerserkTrol_Actions)
endfunction


