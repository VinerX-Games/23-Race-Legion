function Trig_Cast_Copy_Actions takes nothing returns nothing
    call EnableTrigger(gg_trg_Lech)
    call CreateNUnitsAtLoc(1, 'h0ML', GetOwningPlayer(udg_u), GetUnitLoc(GetSpellAbilityUnit()), bj_UNIT_FACING)
    call UnitAddAbilityBJ('A1BS', GetLastCreatedUnit())
    call IssueTargetOrderBJ(GetLastCreatedUnit(), "purge", GetSpellAbilityUnit())
    call UnitApplyTimedLifeBJ(1.00, 'BTLF', GetLastCreatedUnit())
    call TriggerSleepAction(( 5.00 + ( 1.00 * I2R(GetUnitAbilityLevelSwapped('A1CB', GetSpellAbilityUnit())) ) ))
    call DisableTrigger(gg_trg_Lech)
