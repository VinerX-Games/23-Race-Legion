//===========================================================================
// Trigger: StartAlly
//===========================================================================
function WritePlayerName takes nothing returns nothing
    call DisplayTextToForce(udg_AllPlayers, "Игроком: " + GetPlayerName(GetEnumPlayer()))
endfunction


function Trig_StartAlly_Actions takes nothing returns nothing
    local player p= GetTriggerPlayer()
    local integer AllyCount= 0
    call ForceEnumAllies(gForce, p, null)
    set AllyCount=CountPlayersInForceBJ(gForce)
    if DipMode == 0 then
        //Оповещение о превышении
        if AllyCount > 1 then
            call DisplayTextToForce(udg_AllPlayers, "Игрок " + GetPlayerName(p) + " заключил союз с более чем одним!")
            call ForForce(gForce, function WritePlayerName)
            
        endif
    else
        if AllyCount > DipMode then
            call ClearAllies(p)
            call DisplayTextToForce(udg_AllPlayers, "Игрок " + GetPlayerName(p) + " заключил слишком много союзов, его альянсы сброшены")
            
        endif
    
    endif
    set AllyTax[GetPlayerId(p)]=0.1 * AllyCount
    call ForceClear(gForce)
endfunction

//===========================================================================
function InitTrig_StartAlly takes nothing returns nothing
    local integer i= 0
    set gg_trg_StartAlly=CreateTrigger()
    loop
        exitwhen i > 23
        call TriggerRegisterPlayerEventAllianceChanged(gg_trg_StartAlly, Player(i))
        set i=i + 1
    endloop
    
    //call TriggerAddCondition( gg_trg_StartAlly, Condition( function Trig_StartAlly_Conditions ) )
    call TriggerAddAction(gg_trg_StartAlly, function Trig_StartAlly_Actions)
endfunction


