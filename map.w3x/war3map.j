//===========================================================================
// Trigger: SpawnLich
//===========================================================================
function Trig_SpawnLich_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0ZU'
endfunction

function Trig_SpawnLich_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local player p= GetOwningPlayer(u)
    local location l= GetUnitLoc(u)
    call CreateUnitAtLoc(p, 'e01I', l, bj_UNIT_FACING)
    
    
    
    set p=null
    set u=null
    call RemoveLocation(l)
    set l=null
endfunction

