//===========================================================================
// Trigger: TotalProductionDeath
//===========================================================================
function Trig_TotalProductionDeath_Conditions takes nothing returns boolean
    return TotalProductionP[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]
endfunction


function ThisId takes nothing returns boolean
    return GetUnitTypeId(GetFilterUnit()) == udg_LocalInteger5
endfunction

function Trig_TotalProductionDeath_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local integer uh= GetHandleId(u)
    local integer id= LoadInteger(Hash, S2I(I2S(uh) + "a"), 0)
    local player p= GetOwningPlayer(u)
    local unit u2
    local group g= CreateGroup()
    local boolexpr b= Condition(function ThisId)
    set udg_LocalInteger5=id
    
    call FlushChildHashtable(Hash, S2I(I2S(uh) + "a"))
    call GroupEnumUnitsOfPlayer(g, p, b)
    set u2=GroupPickRandomUnit(g)
    if u2 != null then
        call IssueImmediateOrderById(u2, GetUnitTypeId(u))
    endif
    
    set u=null
    set u2=null
    call DestroyGroup(g)
    call DestroyBoolExpr(b)
    set b=null
    set g=null
endfunction

//===========================================================================
function InitTrig_TotalProductionDeath takes nothing returns nothing
    set gg_trg_TotalProductionDeath=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_TotalProductionDeath, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_TotalProductionDeath, Condition(function Trig_TotalProductionDeath_Conditions))
    call TriggerAddAction(gg_trg_TotalProductionDeath, function Trig_TotalProductionDeath_Actions)
endfunction


