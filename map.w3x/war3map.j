	call BlzFrameSetAbsPoint(fh, FRAMEPOINT_TOPRIGHT, 0.274, 0.136)
	call BlzFrameSetTexture(fh, "UI\\ButtonBorder.dds", 0, true)
	set fh=BlzGetFrameByName("MinimapSignalButton", 0)
