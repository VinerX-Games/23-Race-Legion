//***************************************************************************
//*  ContinentalTemplates
function RemoveOutsiders takes group g,boolexpr fromThisArea returns nothing
    call GroupEnumUnitsInRect(gSubGroup, bj_mapInitialPlayableArea, fromThisArea)
    call GroupRemoveGroup2(gSubGroup , g)
endfunction

function AddOutsiders takes group g,rect fromAreaRect returns nothing
    call GroupEnumUnitsInRect(gSubGroup, fromAreaRect, udg_B_EnemyUnit)
    call GroupAddGroup2(gSubGroup , g)
endfunction

function DestroyRocksAct takes nothing returns nothing
    set gDestructable=GetEnumDestructable()
    if GetDestructableTypeId(gDestructable) == 'B01K' then
        call SetDestructableLife(gDestructable, GetDestructableLife(gDestructable) - 350)
    endif
    
endfunction

function DestroyRocks takes rect r returns nothing
    call EnumDestructablesInRect(r, null, function DestroyRocksAct)
endfunction
//***************************************************************************
//*  Dungeons
function HandleAzgel takes real x,real y,group g returns boolean
    if RectContainsCoords(gg_rct_Azgel, x, y) then
        call RemoveOutsiders(g , udg_B_Azgel)
        call AddOutsiders(g , gg_rct_Nord)
        if RectContainsCoords(gg_rct_AzNerRocks, x, y) then
            call EnumDestructablesInRect((gg_rct_AzNerRocks), null, function DestroyRocksAct) // INLINED!!
        endif
        return true
    endif
    return false
endfunction

function HandleAnkirag takes real x,real y,group g returns boolean
    if RectContainsCoords(gg_rct_Ankirag, x, y) then
        call RemoveOutsiders(g , udg_B_Ankirag)
        call AddOutsiders(g , gg_rct_KalimSouth)
        return true
    endif
    return false
endfunction

function HandleBlackRock takes real x,real y,group g returns boolean
    if RectContainsCoords(gg_rct_BlackMountain, x, y) then
        call RemoveOutsiders(g , udg_B_BlackRock)
        call AddOutsiders(g , gg_rct_EKsouth)
        return true
    endif
    return false
endfunction

function HandleOrgrimmar takes real x,real y,group g returns boolean
    if RectContainsCoords(gg_rct_Orgrimmar, x, y) then
        call RemoveOutsiders(g , udg_B_Orgrimmar)
        call AddOutsiders(g , gg_rct_KalimCentral)
        return true
    endif
    return false
endfunction

function HandleDeadMines takes real x,real y,group g returns boolean
    if RectContainsCoords(gg_rct_DeadMines, x, y) then
        call RemoveOutsiders(g , udg_B_DeadMines)
        call AddOutsiders(g , gg_rct_EKsouth)
        return true
    endif
    return false
endfunction

function HandleStalgorn takes real x,real y,group g returns boolean
    if RectContainsCoords(gg_rct_Stalgorn2, x, y) and not RectContainsCoords(gg_rct_UldumNotStalgorn, x, y) then
        call RemoveOutsiders(g , udg_B_Stalgorn)
        call AddOutsiders(g , gg_rct_EKsouth)
        return true
    endif
    return false
endfunction

function HandleUldum takes real x,real y,group g returns boolean
    if RectContainsCoords(gg_rct_Uldum, x, y) then
        call RemoveOutsiders(g , udg_B_Uldum)
        call AddOutsiders(g , gg_rct_EKsouth)
        return true
    endif
    return false
endfunction

function HandleMaradon takes real x,real y,group g returns boolean
    if RectContainsCoords(gg_rct_Maradon, x, y) then
        call RemoveOutsiders(g , udg_B_Maradon)
        call AddOutsiders(g , gg_rct_KalimCentral)
        return true
    endif
    return false
endfunction

function HandleUndercity takes real x,real y,group g returns boolean
    if RectContainsCoords(gg_rct_Undercity, x, y) then
        call RemoveOutsiders(g , udg_B_Undercity)
        call AddOutsiders(g , gg_rct_EKWest)
        return true
    endif
    return false
endfunction

function HandleWestDungeons takes real x,real y,group g returns boolean
    if RectContainsCoords(gg_rct_NoWater1, x, y) then
        if HandleAzgel(x , y , g) then
        elseif HandleAnkirag(x , y , g) then
        elseif HandleBlackRock(x , y , g) then
        elseif HandleOrgrimmar(x , y , g) then
        elseif HandleDeadMines(x , y , g) then
        elseif HandleStalgorn(x , y , g) then
        elseif HandleUldum(x , y , g) then
        endif
    endif
    return false
endfunction


function HandleCentralDungeons takes real x,real y,group g returns boolean
    if RectContainsCoords(gg_rct_NoWater3, x, y) then
        if HandleMaradon(x , y , g) then
        elseif HandleUndercity(x , y , g) then
        endif
    endif
    return false
endfunction

// elseif HandleMaradon(x, y, g) then
// elseif HandleUndercity(x, y, g) then
//***************************************************************************
//*  ContinentalMain
function RemKalim takes group x returns nothing
    call GroupRemoveUnit(x, gg_unit_h0E2_0011)
    call GroupRemoveUnit(x, gg_unit_h08O_0444)
    call GroupRemoveUnit(x, gg_unit_h09B_0508)
    call GroupRemoveUnit(x, gg_unit_h09C_0509)
    call GroupRemoveUnit(x, gg_unit_h097_0502)
    
endfunction

function RemKalim_P takes group x returns nothing
    call GroupRemoveUnit(x, gg_unit_n003_0123)
    call GroupRemoveUnit(x, gg_unit_n003_0124)
endfunction

function RemKalim_P2 takes group x returns nothing
    call GroupRemoveUnit(x, gg_unit_n003_0118)
    call GroupRemoveUnit(x, gg_unit_n003_0117)
endfunction

function RemNord takes group x returns nothing
    call GroupRemoveUnit(x, gg_unit_h09A_0506)
    call GroupRemoveUnit(x, gg_unit_h09N_0346)
endfunction

function RemPandaria takes group x returns nothing
    call GroupRemoveUnit(x, gg_unit_h09V_0137)
    call GroupRemoveUnit(x, gg_unit_h0BH_0601)

endfunction

function RemVK takes group x returns nothing
    
    call GroupRemoveUnit(x, gg_unit_h0BJ_0602)
    call GroupRemoveUnit(x, gg_unit_h0BG_0600)
    call GroupRemoveUnit(x, gg_unit_h0BF_0012)
    call GroupRemoveUnit(x, gg_unit_h09P_0009)

endfunction

function RemBisles takes group x returns nothing
    call GroupRemoveUnit(x, gg_unit_h0BL_0603)
    call GroupRemoveUnit(x, gg_unit_h0BM_0604)
    call GroupRemoveUnit(x, gg_unit_h0OK_0337)
endfunction

function RemWaterPortals takes group x returns nothing
    call GroupRemoveUnit(x, gg_unit_n01D_0904)
    call GroupRemoveUnit(x, gg_unit_n01D_0903)
    //call GroupRemoveUnit(x, gg_unit_n003_0901)
    //call GroupRemoveUnit(x, gg_unit_n003_0902)
endfunction

function RemEmeraldPortals takes group x returns nothing
    call GroupRemoveUnit(x, gg_unit_n01Y_0934)
    call GroupRemoveUnit(x, gg_unit_n01Y_0896)
    call GroupRemoveUnit(x, gg_unit_n01Y_0889)
    call GroupRemoveUnit(x, gg_unit_n01Y_0897)
endfunction



function HandleKalim takes real x,real y,group g returns boolean
    if RectContainsCoords(gg_rct_Kalim, x, y) and not RectContainsCoords(gg_rct_NordNotKalim, x, y) then
        call GroupEnumUnitsInRect(gSubGroup, bj_mapInitialPlayableArea, udg_B_InKalim)
        call GroupRemoveGroup2(gSubGroup , g)
        call RemKalim(g)
        call RemKalim_P(g)
        return true
    endif
    return false
endfunction

function HandleNord takes real x,real y,group g returns boolean
    if RectContainsCoords(gg_rct_Nord, x, y) or RectContainsCoords(gg_rct_Azgel, x, y) or RectContainsCoords(gg_rct_NordNotKalim, x, y) then
        call GroupEnumUnitsInRect(gSubGroup, bj_mapInitialPlayableArea, udg_B_InNord)
        call GroupRemoveGroup2(gSubGroup , g)
        call RemNord(g)
        call AddOutsiders(g , gg_rct_Azgel)
        return true
    endif
    return false
endfunction

function HandleVK takes real x,real y,group g returns boolean
    if ( RectContainsCoords(gg_rct_EastenKingdoms, x, y) or RectContainsCoords(gg_rct_EasternDungeons, x, y) or RectContainsCoords(gg_rct_BlackMountain, x, y) or RectContainsCoords(gg_rct_VknotOut, x, y) ) and not ( RectContainsCoords(gg_rct_OkeaniaNoVk, x, y) or RectContainsCoords(gg_rct_OkeaniaNoVk, x, y) or RectContainsCoords(gg_rct_KillDalaran, x, y) ) then
        call GroupEnumUnitsInRect(gSubGroup, bj_mapInitialPlayableArea, udg_B_InVK)
        call GroupRemoveGroup2(gSubGroup , g)
        call RemVK(g)
        return true
    endif
    return false
endfunction

function HandleOutland takes real x,real y,group g returns boolean
    if ( RectContainsCoords(gg_rct_Outland, x, y) or RectContainsCoords(gg_rct_OutNoVk, x, y) ) and not RectContainsCoords(gg_rct_VknotOut, x, y) then
        call GroupEnumUnitsInRect(gSubGroup, bj_mapInitialPlayableArea, udg_B_InOutland)
        call GroupRemoveGroup2(gSubGroup , g)
        return true
    endif
    return false
endfunction

function HandleBrokenIsles takes real x,real y,group g returns boolean
    if RectContainsCoords(gg_rct_BrokenIsles, x, y) then
        call GroupEnumUnitsInRect(gSubGroup, bj_mapInitialPlayableArea, udg_B_InBIsles)
        call GroupRemoveGroup2(gSubGroup , g)
        call RemBisles(g)
        return true
    endif
    return false
endfunction

function HandleArgus takes real x,real y,group g returns boolean
    if RectContainsCoords(gg_rct_Argus, x, y) then
        call GroupEnumUnitsInRect(gSubGroup, bj_mapInitialPlayableArea, udg_B_InArgus)
        call GroupRemoveGroup2(gSubGroup , g)
        return true
    endif
    return false
endfunction

function HandlePandaria takes real x,real y,group g returns boolean
    if RectContainsCoords(gg_rct_Pandaria, x, y) then
        call GroupEnumUnitsInRect(gSubGroup, bj_mapInitialPlayableArea, udg_B_InPandaria)
        call GroupRemoveGroup2(gSubGroup , g)
        call RemPandaria(g)
        return true
    endif
    return false
endfunction


function ProcessContinentalStuff takes real x,real y,group g returns nothing
    if HandleKalim(x , y , g) then
    elseif HandleVK(x , y , g) then
    elseif HandleNord(x , y , g) then
    elseif HandlePandaria(x , y , g) then
    elseif HandleOutland(x , y , g) then
    elseif HandleBrokenIsles(x , y , g) then
    elseif HandleArgus(x , y , g) then
    elseif HandleWestDungeons(x , y , g) then
    elseif HandleCentralDungeons(x , y , g) then
    endif

    call RemWaterPortals(g)
    call RemEmeraldPortals(g)
endfunction


// НАГИ особое расположение
function ProcessContinentalStuffNaga takes real x,real y,group g returns nothing

    if HandleOutland(x , y , g) then
    elseif HandleArgus(x , y , g) then
    elseif HandleAnkirag(x , y , g) then
    elseif HandleWestDungeons(x , y , g) then
    elseif HandleCentralDungeons(x , y , g) then
    endif


    call RemWaterPortals(g)
    call RemEmeraldPortals(g)
endfunction
//***************************************************************************
//*  TryToAttack2 Uni

function TryPortalMovement takes unit u,group l__gEnemyGroup,real l__gX,real l__gY,integer i returns nothing
    local integer abilityLevel= GetUnitAbilityLevel(u, 'A1GZ')
    if i == 0 then
        set i=20
    endif
    
    set Counter=0
    set EnemyCapital=null
    //Еще осталось 1 попатка тепнуться
    if abilityLevel == 1 then
        call GroupEnumUnitsInRange(l__gEnemyGroup, l__gX, l__gY, 3000.00 * ( Pow(1.5, I2R(i)) ), udg_B_EnemyUnitP)
    //Порталы запрещены
    elseif abilityLevel >= 2 then
        call GroupEnumUnitsInRange(l__gEnemyGroup, l__gX, l__gY, 3000.00 * ( Pow(1.5, I2R(i)) ), udg_B_EnemyUnit)
        call UnitRemoveAbility(u, 'A1GZ')
    //Обычный поиск
    else
        call GroupEnumUnitsInRange(l__gEnemyGroup, l__gX, l__gY, 3000.00 * ( Pow(1.5, I2R(i)) ), udg_B_EnemyUnitP)
    endif

endfunction








function TryAttack takes nothing returns nothing
    local integer i
    set gUnit=udg_LocalUnit2
    set gPlayer=GetOwningPlayer(gUnit)
    set gX=GetUnitX(gUnit)
    set gY=GetUnitY(gUnit)
    //   ------------------- В атаку -------------------
    
    if gAllyGroup == null then
        set gAllyGroup=CreateGroup()
    endif
    if gSubGroup == null then
        set gSubGroup=CreateGroup()
    endif
    
    set CheckPlayer=gPlayer
    //// Дальнее исследование
    if Random(1 , 8) then
  
        //Обработка портала и вообще выбор врагов
        call TryPortalMovement(gUnit , gEnemyGroup , gX , gY , 0)

        ///Континентальные штуки
        if AiRace[GetPlayerId(gPlayer)] == "Naga" then
            call ProcessContinentalStuffNaga(gX , gY , gEnemyGroup)
        else
            call ProcessContinentalStuff(gX , gY , gEnemyGroup)
        endif
        
        
        
        // Шанс напасать именно на столицу
        if EnemyCapital != null and Random(1 , 2) then
            set gEnemy=EnemyCapital
        else
            set gEnemy=BlzGroupUnitAt(gEnemyGroup, GetRandomInt(0, Counter))
        endif
        
        //Враг не найден - запрашиваем тп!
        if gEnemy == null then
            call RequestPort(gUnit)
        else
            
            set gX2=GetUnitX(gEnemy)
            set gY2=GetUnitY(gEnemy)
            
            // Если это портал
            if WaygateIsActive(gEnemy) == true then
                
                set gDx=gX - gX2
                set gDy=gY - gY2
                set gDx=SquareRoot(gDx * gDx + gDy * gDy)
                call GroupEnumUnitsInRange(gAllyGroup, gX, gY, 2500 * AiRadius / 5, B_LazyF)
                
                
                //В любом случае спелы проверки портала получат
                        
                loop
                    set gUnit2=FirstOfGroup(gAllyGroup)
                    exitwhen gUnit2 == null
                    call UnitAddAbility(gUnit2, 'A1GZ')
                    call GroupRemoveUnit(gAllyGroup, gUnit2)
                    set gUnit2=null
                endloop
                //До портала всего нечего
                if gDx <= 2500 then
                    
                    call IssueImmediateOrder(gEnemy, "web")
                    call BlzEndUnitAbilityCooldown(gEnemy, 'A0HY')
                
                //До портала идти еще
                else
                    call GroupPointOrder(gAllyGroup, "smart", gX2, gY2)
                                           
                endif
                
            
            
            
            // Основной случай
            else
                //set CheckPlayer = gPlayer
                call GroupEnumUnitsInRange(gAllyGroup, gX, gY, 1500 * AiRadius / 5, B_LazyF)
                set gSubGroupCounter=0
                call GroupClear(gSubGroup)
                loop
                    set gUnit2=FirstOfGroup(gAllyGroup)
                    
                    if gUnit2 == null then
                        call GroupPointOrder(gSubGroup, "attack", gX2, gY2)
                        call GroupClear(gSubGroup)
                        set gSubGroupCounter=0
                        exitwhen true
                    endif
                    call GroupRemoveUnit(gAllyGroup, gUnit2)
                    
                    
                    call GroupAddUnit(gSubGroup, gUnit2)
                    set gSubGroupCounter=gSubGroupCounter + 1
                    if gSubGroupCounter >= 12 then
                        call GroupPointOrder(gSubGroup, "attack", gX2, gY2)
                        call GroupClear(gSubGroup)
                        set gSubGroupCounter=0
                    endif
                    
                    // Сломался с неуязом
                    if GetUnitAbilityLevel(gUnit2, 'Bvul') > 0 then
                        call ReplaceUnit2(gUnit2 , GetUnitTypeId(gUnit2) , bj_UNIT_STATE_METHOD_RELATIVE)
                    endif

                    set gUnit2=null
                endloop
            endif
        endif
           
    
    //// Ближайшее исследование, пытается перебрадть радиус пока не найдет хотя бы одного юнита
    else
    
        
        set i=0
        loop
            exitwhen i > 8
            set i=i + 1
            if i == 8 then
                set i=100
            endif
            
           
            //set CheckPlayer = gPlayer
                     
            call TryPortalMovement(gUnit , gEnemyGroup , gX , gY , i)
            
            ///Континентальные штуки
            if AiRace[GetPlayerId(gPlayer)] == "Naga" then
                call ProcessContinentalStuffNaga(gX , gY , gEnemyGroup)
            else
                call ProcessContinentalStuff(gX , gY , gEnemyGroup)
            endif
    
       
            // Шанс напасать именно на столицу
            if EnemyCapital != null and Random(1 , 4) then
                set gEnemy=EnemyCapital
            else
                set gEnemy=BlzGroupUnitAt(gEnemyGroup, GetRandomInt(0, Counter))
            endif
            
            //Враг не найден - запрашиваем тп!
            if gEnemy == null then
                if i == 100 then
                    call RequestPort(gUnit)
                endif
            //Враг найден
            else
                set i=15
                set gX2=GetUnitX(gEnemy)
                set gY2=GetUnitY(gEnemy)
                
                if WaygateIsActive(gEnemy) then
        
                    set gDx=gX - gX2
                    set gDy=gY - gY2
                    set gDx=SquareRoot(gDx * gDx + gDy * gDy)
                    call GroupEnumUnitsInRange(gAllyGroup, gX, gY, 2500 * AiRadius / 5, B_LazyF)
                    
                    
                    //В любом случае спелы проверки портала получат
                    
                    loop
                        set gUnit2=FirstOfGroup(gAllyGroup)
                        exitwhen gUnit2 == null
                        call UnitAddAbility(gUnit2, 'A1GZ')
                        call GroupRemoveUnit(gAllyGroup, gUnit2)
                        set gUnit2=null
                    endloop
                    //До портала всего ничего
                    if gDx <= 2500 then
                        
                        call IssueImmediateOrder(gEnemy, "web")
                        call BlzEndUnitAbilityCooldown(gEnemy, 'A0HY')
                    
                    //До портала идти еще
                    else
                        call GroupPointOrder(gAllyGroup, "smart", gX2, gY2)
                                               
                    endif
 
                //Обычная цель
                else

                    //Отдаю приказ юниту и рядом стоящим
                            
                    //set CheckPlayer = gPlayer
                    call GroupEnumUnitsInRange(gAllyGroup, gX, gY, 1500 * AiRadius / 5, B_LazyF)
                    set gSubGroupCounter=0
                    call GroupClear(gSubGroup)
                    loop
                        set gUnit2=FirstOfGroup(gAllyGroup)
                        
                        if gUnit2 == null then
                            call GroupPointOrder(gSubGroup, "attack", gX2, gY2)
                            call GroupClear(gSubGroup)
                            set gSubGroupCounter=0
                            exitwhen true
                        endif
                        call GroupRemoveUnit(gAllyGroup, gUnit2)
                        
                        
                        call GroupAddUnit(gSubGroup, gUnit2)
                        set gSubGroupCounter=gSubGroupCounter + 1
                        if gSubGroupCounter >= 12 then
                            call GroupPointOrder(gSubGroup, "attack", gX2, gY2)
                            call GroupClear(gSubGroup)
                            set gSubGroupCounter=0
                        endif
                        
                        // Сломался с неуязом
                        if GetUnitAbilityLevel(gUnit2, 'Bvul') > 0 then
                            call ReplaceUnit2(gUnit2 , GetUnitTypeId(gUnit2) , bj_UNIT_STATE_METHOD_RELATIVE)
                        endif

                        set gUnit2=null
                    endloop
                    
                    
                    
                endif
                
                
            endif
            
        endloop
        
        call UnitRemoveAbility(gUnit, 'A1GZ')
        
    endif

endfunction



//***************************************************************************
//*  TryToAttackN Uni
function TryAttackN takes nothing returns nothing
    local unit ChosenUnit= udg_LocalUnit3
    local unit u2
    local real x= GetUnitX(ChosenUnit)
    local real y= GetUnitY(ChosenUnit)
    local real x2
    local real y2
    

    // Шанс на дальнее исследование
    if Random(1 , 10) then
        set gInt=10
    else
        set gInt=1
    endif
    
    
    loop
        
        //call BJDebugMsg("Цикл атаки флота юнита: "+GetUnitName(ChosenUnit)+" Игрока:"+GetPlayerName(CheckPlayer))
        //Блок выбора врагов

        set Counter=0
        set CheckPlayer=GetOwningPlayer(ChosenUnit)
        call GroupEnumUnitsInRange(gEnemyGroup, x, y, 5500.00 * ( Pow(1.5, I2R(gInt)) ), udg_B_EnemyUnitN)
        
        //call BJDebugMsg("Кол-во доступных врагов"+I2S(Counter))
        //Блок отдачи приказа
        set u2=BlzGroupUnitAt(gEnemyGroup, GetRandomInt(0, Counter))
        if u2 != null then
            
            //call BJDebugMsg("Выбранный Враг "+GetUnitName(u2))
            set x2=GetUnitX(u2)
            set y2=GetUnitY(u2)
            set u2=null

            set LazyCount=0
            set CheckPlayer=GetOwningPlayer(ChosenUnit)
            call GroupEnumUnitsInRange(gAllyGroup, x, y, ( 2000 * AiRadius ) / 5, B_LazyN)
            set gSubGroupCounter=0
            call GroupClear(gSubGroup)

            loop
                set u2=FirstOfGroup(gAllyGroup)
                
                if u2 == null then
                    call GroupPointOrder(gSubGroup, "attack", x2, y2)
                    call GroupClear(gSubGroup)
                    set gSubGroupCounter=0
                    exitwhen true
                endif
                call GroupRemoveUnit(gAllyGroup, u2)
                
                
                call GroupAddUnit(gSubGroup, u2)
                set gSubGroupCounter=gSubGroupCounter + 1
                if gSubGroupCounter >= 12 then
                    call GroupPointOrder(gSubGroup, "attack", x2, y2)
                    call GroupClear(gSubGroup)
                    set gSubGroupCounter=0
                endif
            endloop

            set gInt=11
        else
           set gInt=gInt + 1
        endif
        
        exitwhen gInt > 10
           
        
    endloop

    //call BJDebugMsg("------------------------- ")

    set ChosenUnit=null
    set u2=null

endfunction



//***************************************************************************
//*  KilledCity
function aiKilledCity takes unit u returns nothing
    set udg_LocalUnit2=u
    call ExecuteFunc("TryAttack")
endfunction
//***************************************************************************
//*  GoToWater
function GoToWaterPoint takes integer pi,unit u,real x,real y returns boolean
    
    if Random(1 , 10) and LoadInteger(AiData, pi, StringHash("NumberPorts")) < 8 then
        if RectContainsCoords(gg_rct_EastenKingdoms, x, y) then
            set gInt=GetRandomInt(1, 4)
            if gInt == 1 then
                call IssuePointOrder(u, "move", 30150, - 3454)
            elseif gInt == 2 then
                call IssuePointOrder(u, "move", 25504, - 16284)
            elseif gInt == 3 then
                call IssuePointOrder(u, "move", 19258, 5665)
            elseif gInt == 4 then
                call IssuePointOrder(u, "move", 10979, 10501)
            endif
        elseif RectContainsCoords(gg_rct_Kalim, x, y) then
            set gInt=GetRandomInt(1, 4)
            if gInt == 1 then
                call IssuePointOrder(u, "move", - 28610, 16300)
            elseif gInt == 2 then
                call IssuePointOrder(u, "move", - 15796, - 10105)
            elseif gInt == 3 then
                call IssuePointOrder(u, "move", - 12405, 96678)
            elseif gInt == 4 then
                call IssuePointOrder(u, "move", - 27443, 11058)
            endif
        elseif RectContainsCoords(gg_rct_Nord, x, y) then
            set gInt=GetRandomInt(1, 4)
            if gInt == 1 then
                call IssuePointOrder(u, "move", - 4711, 20912)
            elseif gInt == 2 then
                call IssuePointOrder(u, "move", 8753, 22230)
            elseif gInt == 3 then
                call IssuePointOrder(u, "move", 1273, 20088)
            elseif gInt == 4 then
                call IssuePointOrder(u, "move", - 15652, 21381)
            endif
        elseif RectContainsCoords(gg_rct_BrokenIsles, x, y) then
            set gInt=GetRandomInt(1, 2)
            if gInt == 1 then
                call IssuePointOrder(u, "move", 2500, 12654)
            else
                call IssuePointOrder(u, "move", 4121, 621)
            endif
        elseif RectContainsCoords(gg_rct_Pandaria, x, y) then
            set gInt=GetRandomInt(1, 2)
            if gInt == 1 then
                call IssuePointOrder(u, "move", - 9460, - 12451)
            else
                call IssuePointOrder(u, "move", - 3941, - 22869)
            endif
        endif
        
        return true
    endif
    return false
endfunction

//***************************************************************************
//*  TryToBuild
function TryBuild takes nothing returns nothing
    set gUnit=TryBuild_u
    set gPi=GetPlayerId(GetOwningPlayer(gUnit))
    set gX=GetUnitX(gUnit)
    set gY=GetUnitY(gUnit)
    
    
    //call DisplayTimedTextFromPlayer( Player( 0x00 ), 0, 0, 4, "Вхожу в билд" )
    
    call GroupAddUnit(udg_Ai_buildersT[gPi], gUnit)
    call GroupRemoveUnit(udg_Ai_builders[gPi], gUnit)
    call GroupRemoveUnit(udg_Ai_harvest[gPi], gUnit)
    

    //Если в воде для верфи - то строй верфь c высоким шансом)
    if LoadInteger(AiData, gPi, StringHash("NumberPorts")) < 12 and ( not IsTerrainPathable(gX, gY, PATHING_TYPE_WALKABILITY) and RectContainsCoords(gg_rct_Outland, gX, gY) != true and RectContainsCoords(gg_rct_Azgel, gX, gY) != true ) then
        
 
        if Random(1 , 2) then

            set gInt2=0
        
            loop
                exitwhen gInt2 >= 5
                set gInt2=gInt2 + 1
                
                set gX2=gX + 200.00 * Cos(GetRandomReal(0.00, 360.00) * bj_DEGTORAD)
                set gY2=gY + 200.00 * Sin(GetRandomReal(0.00, 360.00) * bj_DEGTORAD)
                
                if not ( IsTerrainPathable(gX2, gY2, PATHING_TYPE_WALKABILITY) or IsTerrainPathable(gX2, gY2, PATHING_TYPE_FLOATABILITY) or RectContainsCoords(gg_rct_Outland, gX2, gY2) ) then
                    
                    
                    if AiRace[gPi] == "Scarlet" or AiRace[gPi] == "BloodElves" then
                        call IssueBuildOrderById(gUnit, 'h011', gX2, gY2)
                    elseif AiRace[gPi] == "Goblins" then
                        call IssueBuildOrderById(gUnit, 'h0D7', gX2, gY2)
                    elseif AiRace[gPi] == "Naga" then
                        call IssueBuildOrderById(gUnit, 'n04L', gX2, gY2)
                    elseif AiRace[gPi] == "Horde" then
                        call IssueBuildOrderById(gUnit, 'h0HO', gX2, gY2)
                    endif
                    
                    
                    return
                endif
                
            endloop
        endif
    
  
    //Идти к точке где много воды
    elseif AiRace[gPi] != "Naga" and GoToWaterPoint(gPi , gUnit , gX , gY) then
        return
    endif
  
    //Шанс перейти на новую локу
    if Random(1 , 25) then
        set gX=gX + AiBuildingRadius * 7 * Cos(GetRandomReal(0.00, 360.00) * bj_DEGTORAD)
        set gY=gY + AiBuildingRadius * 7 * Sin(GetRandomReal(0.00, 360.00) * bj_DEGTORAD)
        call IssuePointOrder(gUnit, "move", gX, gY)
        return
    endif
  
  
    // Определение точки постройки 
    set gX=gX + AiBuildingRadius * Cos(GetRandomReal(0.00, 360.00) * bj_DEGTORAD)
    set gY=gY + AiBuildingRadius * Sin(GetRandomReal(0.00, 360.00) * bj_DEGTORAD)
    
    
   
    if AiRace[gPi] == "Scarlet" then
        set gInt=ChooseBuildings_ScarletOrden(gPi)
    elseif AiRace[gPi] == "BloodElves" then
        set gInt=ChooseBuildings_BloodElves(gPi)
    elseif AiRace[gPi] == "Goblins" then
        set gInt=ChooseBuildings_Goblins(gPi)
    elseif AiRace[gPi] == "Naga" then
        set gInt=ChooseBuildings_Naga(gPi)
    elseif AiRace[gPi] == "Horde" then
        set gInt=ChooseBuildings_Horde(gPi)
    endif

    call IssueBuildOrderById(gUnit, gInt, gX, gY)
    
endfunction

//***************************************************************************
//*  AiUnitJoins
function aiUnitJoins takes unit u,integer pi returns nothing
    local integer id= GetUnitTypeId(u)
    
    call GroupAddUnit(udg_Ai_units[pi], u)
    //call UnitApplyTimedLife( u,'BTLF',1200.00)
    call NumberAdd(pi , id)

    if AiRace[pi] == "Scarlet" then
        call Join_Skarlet(id , pi , u)
    elseif AiRace[pi] == "BloodElves" then
        call Join_BloodElves(id , pi , u)
    elseif AiRace[pi] == "Goblins" then
        call Join_Goblins(id , pi , u)
    elseif AiRace[pi] == "Naga" then
        call Join_Naga(id , pi , u)
    elseif AiRace[pi] == "Horde" then
        call Join_Horde(id , pi , u)
    endif

endfunction
//***************************************************************************
//*  CapitalEnter
function aiCapitalEnterAct takes nothing returns nothing
    call GroupAddUnit(AiCapitalBuildigs[gPi], GetEnumUnit())
endfunction

// Добавляет все здания рядом в группу
function aiCapitalEnter takes unit u returns nothing
    set gPi=GetPlayerId(GetOwningPlayer(u))
    if udg_AiControl[gPi] then
        set CheckPlayer=Player(gPi)
        call GroupEnumUnitsInRange(gGroup, GetUnitX(u), GetUnitY(u), 3200, b_OwnBuldingsInRange)
        call ForGroup(gGroup, function aiCapitalEnterAct)
    endif
endfunction


//***************************************************************************
//*  EnterGreen2
function greencreature takes nothing returns boolean
    return GetUnitAbilityLevel(GetFilterUnit(), 'A0LR') > 0
endfunction

function alienToDream takes nothing returns boolean
    return UnitAlive(GetFilterUnit()) and GetUnitAbilityLevel(GetFilterUnit(), 'A0LR') == 0 and not IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) and GetUnitTypeId(GetFilterUnit()) != Dummy and GetUnitAbilityLevel(GetFilterUnit(), 'Awrp') == 0
endfunction


function WakeGreenUpEach takes nothing returns nothing
    call PauseUnit(GetEnumUnit(), false)
    //call UnitWakeUp(GetEnumUnit())
endfunction

function SleepGreenEach takes nothing returns nothing
    call PauseUnit(GetEnumUnit(), true)
    //call UnitWakeUp(GetEnumUnit())
endfunction

function WakeGreenUp takes nothing returns nothing
    call GroupEnumUnitsInRect(gGroup, gg_rct_EmeraldDream, Condition(function greencreature))
    call ForGroup(gGroup, function WakeGreenUpEach)
    call GroupClear(gGroup)
endfunction

function SleepGreen takes nothing returns nothing
    //call BJDebugMsg("Паузит")
    call GroupEnumUnitsInRect(gGroup, gg_rct_EmeraldDream, Condition(function greencreature))
    call ForGroup(gGroup, function SleepGreenEach)
    call GroupClear(gGroup)
endfunction


function checkGreenArea takes nothing returns nothing
    local unit u
    call GroupClear(gGroup)
    call GroupEnumUnitsInRect(gGroup, gg_rct_EmeraldDream, Condition(function alienToDream))
    loop
        set u=FirstOfGroup(gGroup)
       
       
        if u != null and GetUnitAbilityLevel(u, 'A1LR') == 0 then
            //call BJDebugMsg("обнаружило"+GetUnitName(u))
            set u=null
            
            call WakeGreenUp()
            return
        endif
        
        exitwhen u == null
            
        call GroupRemoveUnit(gGroup, u)
        set u=null
        
    endloop
    call GroupClear(gGroup)
    //call BJDebugMsg("Дошло норм")
    call SleepGreen()
    set u=null
endfunction



function EnterGreen takes unit u returns nothing
    if GetUnitAbilityLevel(u, 'A1LR') > 0 then
    
    else
        call WakeGreenUp()
    endif
    
endfunction




//***************************************************************************
//*
//*  Unit Item Tables
//*
//***************************************************************************

function Unit000387_DropItems takes nothing returns nothing
    local widget trigWidget= null
    local unit trigUnit= null
    local integer itemID= 0
    local boolean canDrop= true

    set trigWidget=bj_lastDyingWidget
    if ( trigWidget == null ) then
        set trigUnit=GetTriggerUnit()
    endif

    if ( trigUnit != null ) then
        set canDrop=not IsUnitHidden(trigUnit)
        if ( canDrop and GetChangingUnit() != null ) then
            set canDrop=( GetChangingUnitPrevOwner() == Player(PLAYER_NEUTRAL_AGGRESSIVE) )
        endif
    endif

    if ( canDrop ) then
        // Item set 0
        call RandomDistReset()
        call RandomDistAddItem(- 1, 100)
        set itemID=RandomDistChoose()
        if ( trigUnit != null ) then
            call UnitDropItem(trigUnit, itemID)
        else
            call WidgetDropItem(trigWidget, itemID)
        endif

    endif

    set bj_lastDyingWidget=null
    call DestroyTrigger(GetTriggeringTrigger())
endfunction


