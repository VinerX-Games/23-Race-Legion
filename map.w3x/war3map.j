//===========================================================================
// Trigger: DamageMore
//===========================================================================
function Trig_DamageMore_Conditions takes nothing returns boolean
    
    return GetUnitAbilityLevel(BlzGetEventDamageTarget(), 'A1D0') > 0 // Тут абилка иконка
    
    
endfunction

function Trig_DamageMore_Actions takes nothing returns nothing
    local unit u= BlzGetEventDamageTarget()
    local integer spellid= 'A1D1'
    local integer timerspellid= 'A1CX'
    local real lifep= GetUnitLifePercent(u)
    local integer time= 10
    
    
    //call DisplayTextToPlayer(Player(0),0,0,"Добавил")
    if lifep < 25 then
        call UnitAddAbility(u, spellid)
        call SetUnitAbilityLevel(u, spellid, 3)
        call BlzStartUnitAbilityCooldown(u, timerspellid, 20)
       // call DisplayTextToPlayer(Player(0),0,0,"м 25"+R2S(lifep))
    elseif lifep < 50 then
            call UnitAddAbility(u, spellid)
            call SetUnitAbilityLevel(u, spellid, 2)
            call BlzStartUnitAbilityCooldown(u, timerspellid, 20)
     //       call DisplayTextToPlayer(Player(0),0,0,"м50"+R2S(lifep))   
    elseif lifep < 75 then
            call UnitAddAbility(u, spellid)
            call SetUnitAbilityLevel(u, spellid, 1)
            call BlzStartUnitAbilityCooldown(u, timerspellid, 20)
     //       call DisplayTextToPlayer(Player(0),0,0,"м50"+R2S(lifep))
            
    else
            call UnitRemoveAbility(u, spellid)
       //     call DisplayTextToPlayer(Player(0),0,0,"Другое"+R2S(lifep))
    endif
    call UnitAddAbility(u, timerspellid)
    call BlzStartUnitAbilityCooldown(u, timerspellid, time)
    call TriggerSleepAction(time)
    
    if BlzGetUnitAbilityCooldownRemaining(u, timerspellid) == 0 then
        call UnitRemoveAbility(u, spellid)
    endif
    
    
    
    set u=null
endfunction

//===========================================================================
function InitTrig_DamageMore takes nothing returns nothing
    set gg_trg_DamageMore=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_DamageMore, EVENT_PLAYER_UNIT_DAMAGED)
    call TriggerAddCondition(gg_trg_DamageMore, Condition(function Trig_DamageMore_Conditions))
    call TriggerAddAction(gg_trg_DamageMore, function Trig_DamageMore_Actions)
endfunction


