//===========================================================================
// Trigger: Brac
//===========================================================================
function Trig_Brac_Conditions takes nothing returns boolean
    return GetUnitAbilityLevel(GetTriggerUnit(), 'B028') > 0 and GetUnitAbilityLevel(GetEventDamageSource(), 'A0A6') > 0
endfunction

function Trig_Brac_Actions takes nothing returns nothing
    local texttag t
    call CreateTextTagUnitBJ("TRIGSTR_7336", GetEventDamageSource(), - 20.00, 5.00, 100, 100, 100, 0.00)
    set t=GetLastCreatedTextTag()
    call SetTextTagPermanentBJ(t, false)
    call SetTextTagLifespanBJ(t, 2.00)
    call SetTextTagFadepointBJ(t, 2.00)
    call SetTextTagVelocityBJ(t, 75.00, 90)
    call RemoveTextTagTimed(t , 2.1)
    set t=null
endfunction

//===========================================================================
function InitTrig_Brac takes nothing returns nothing
    set gg_trg_Brac=CreateTrigger()
    call DisableTrigger(gg_trg_Brac)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Brac, EVENT_PLAYER_UNIT_DAMAGED)
    call TriggerAddCondition(gg_trg_Brac, Condition(function Trig_Brac_Conditions))
    call TriggerAddAction(gg_trg_Brac, function Trig_Brac_Actions)
endfunction


//===========================================================================
// Trigger: Samopodruv
//===========================================================================
function Trig_Samopodruv_Conditions takes nothing returns boolean
    return GetUnitAbilityLevel(GetAttacker(), 'A0A9') > 0
endfunction

function Trig_Samopodruv_Actions takes nothing returns nothing
    local texttag t
    if GetRandomInt(1, 100) < 35 + ( - 5 * GetUnitAbilityLevel(GetAttacker(), 'A0A9') ) then
        call SetUnitLifeBJ(GetAttacker(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetAttacker()) - 15.00 ))
        call CreateTextTagUnitBJ("TRIGSTR_433", GetAttacker(), - 20.00, 5.00, 100, 100, 100, 0.00)
        set t=GetLastCreatedTextTag()
        call SetTextTagPermanentBJ(t, false)
        call SetTextTagLifespanBJ(t, 2.00)
        call SetTextTagFadepointBJ(t, 2.00)
        call SetTextTagVelocityBJ(t, 75.00, 90)
        call RemoveTextTagTimed(t , 2.1)
    endif
    set t=null
endfunction

//===========================================================================
function InitTrig_Samopodruv takes nothing returns nothing
    set gg_trg_Samopodruv=CreateTrigger()
