//===========================================================================
// Trigger: CorrupPlus
//===========================================================================
function Trig_CorrupPlus_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0AS' ) ) then
        return false
    endif
    return true
endfunction

function Trig_CorrupPlus_Func005002 takes nothing returns boolean
    return ( 1 == 1 )
endfunction

function Trig_CorrupPlus_Func008A takes nothing returns nothing
    call SetUnitAbilityLevelSwapped('A0AW', GetEnumUnit(), GetPlayerTechCountSimple('R04O', GetOwningPlayer(GetEnumUnit())))
    call SetUnitAbilityLevelSwapped('A0AV', GetEnumUnit(), GetPlayerTechCountSimple('R04O', GetOwningPlayer(GetEnumUnit())))
endfunction

function Trig_CorrupPlus_Func014C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R04O', GetOwningPlayer(GetTriggerUnit())) == 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_CorrupPlus_Actions takes nothing returns nothing
    local player p
    call SetPlayerAbilityAvailableBJ(false, 'A0AS', GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerAbilityAvailableBJ(false, 'A0AT', GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerTechResearchedSwap('R04O', ( GetPlayerTechCountSimple('R04O', GetOwningPlayer(GetTriggerUnit())) + 1 ), GetOwningPlayer(GetTriggerUnit()))
    set udg_Boolexpr=Condition(function Trig_CorrupPlus_Func005002)
    set udg_LocalPlayer=GetOwningPlayer(GetTriggerUnit())
    call GroupEnumUnitsOfPlayer(udg_LocalOtrad2, udg_LocalPlayer, udg_Boolexpr)
    call ForGroupBJ(udg_LocalOtrad2, function Trig_CorrupPlus_Func008A)
    call GroupClear(udg_LocalOtrad2)
    set udg_LocalPlayer=GetOwningPlayer(GetTriggerUnit())
    set p=udg_LocalPlayer
    call TriggerSleepAction(60.00)
    set udg_LocalPlayer=p
    if ( Trig_CorrupPlus_Func014C() ) then
        call SetPlayerAbilityAvailableBJ(true, 'A0AT', GetOwningPlayer(GetTriggerUnit()))
    else
        call SetPlayerAbilityAvailableBJ(true, 'A0AS', GetOwningPlayer(GetTriggerUnit()))
        call SetPlayerAbilityAvailableBJ(true, 'A0AT', GetOwningPlayer(GetTriggerUnit()))
    endif
    set p=null
endfunction

