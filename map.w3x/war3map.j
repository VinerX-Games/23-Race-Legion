    set gg_trg_Flagman_die_Ot=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Flagman_die_Ot, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_Flagman_die_Ot, Condition(function Trig_Flagman_die_Ot_Conditions))
    call TriggerAddAction(gg_trg_Flagman_die_Ot, function Trig_Flagman_die_Ot_Actions)
endfunction


