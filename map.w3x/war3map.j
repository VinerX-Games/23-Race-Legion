    call TriggerAddCondition(gg_trg_ArcanaBuild, Condition(function Trig_ArcanaBuild_Conditions))
    call TriggerAddAction(gg_trg_ArcanaBuild, function Trig_ArcanaBuild_Actions)
endfunction

