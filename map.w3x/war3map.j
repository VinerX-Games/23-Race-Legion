//===========================================================================
function ConditionPlayerNumber takes nothing returns boolean
    return S2I(SubStringBJ(GetEventPlayerChatString(), 4, 5)) >= 1 and S2I(SubStringBJ(GetEventPlayerChatString(), 4, 5)) <= 24
endfunction

function TestGroupForAll takes nothing returns nothing
    local unit u= GetEnumUnit()
    call BJDebugMsg(I2S(Counter) + ": " + GetUnitName(u))
    set Counter=Counter + 1
endfunction

function Trig_CheckGroup_Actions takes nothing returns nothing
    local integer pi= S2I(SubStringBJ(GetEventPlayerChatString(), 4, 5)) - 1
    local group g= CreateGroup()
    
    set LazyCount=0
    set CheckPlayer=Player(pi)
    call GroupEnumUnitsOfPlayer(g, Player(pi), B_LazyN)
    set Counter=0
    call BJDebugMsg("Тест вычисляемой группы B_LazyN флота игрока " + GetPlayerName(Player(pi)) + "Кол-ва" + I2S(LazyCount))
    call ForGroup(g, function TestGroupForAll)
    call BJDebugMsg("Конец теста гоуппы флота игрока " + GetPlayerName(Player(pi)))
    
    call BJDebugMsg("Тест группы udg_Ai_navy флота игрока " + GetPlayerName(Player(pi)) + "Кол-ва" + I2S(LazyCount))
    call ForGroup(udg_Ai_navy[pi], function TestGroupForAll)
    call BJDebugMsg("Конец теста гоуппы флота игрока " + GetPlayerName(Player(pi)))
endfunction

