function deadEdly takes nothing returns nothing
    
    local timer t= GetExpiredTimer()
    local integer id= GetHandleId(t)
    local unit u= LoadUnitHandle(Hash, id, 0)
    local integer uh= LoadInteger(Hash, id, 1)
    
    if u == null then
        call FlushChildHashtable(Hash, uh)
    
    endif

    set t=null
    set u=null
endfunction




function Trig_DiyW2_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local integer uh= GetHandleId(u)
    
    local timer t= CreateTimer()
    local integer id= GetHandleId(t)
    
    call TimerStart(t, 45, false, function deadEdly)
    call SaveUnitHandle(Hash, id, 0, u)
    call SaveInteger(Hash, id, 1, uh)

    set t=null
    set u=null

endfunction

