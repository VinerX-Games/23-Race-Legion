    call GroupRemoveUnit(x, gg_unit_n003_0123)
    call GroupRemoveUnit(x, gg_unit_n003_0124)
endfunction

function RemKalim_P2 takes group x returns nothing
    call GroupRemoveUnit(x, gg_unit_n003_0118)
    call GroupRemoveUnit(x, gg_unit_n003_0117)
endfunction

function RemNord takes group x returns nothing
    call GroupRemoveUnit(x, gg_unit_h09A_0506)
    call GroupRemoveUnit(x, gg_unit_h09N_0346)
endfunction

function RemPandaria takes group x returns nothing
    call GroupRemoveUnit(x, gg_unit_h09V_0137)
    call GroupRemoveUnit(x, gg_unit_h0BH_0601)

endfunction





function RemVK takes group x returns nothing
    call GroupRemoveUnit(x, gg_unit_h00W_0145)
    call GroupRemoveUnit(x, gg_unit_h0BJ_0602)
    call GroupRemoveUnit(x, gg_unit_h0BG_0600)
    call GroupRemoveUnit(x, gg_unit_h0BF_0012)
    call GroupRemoveUnit(x, gg_unit_h09P_0009)
    call GroupRemoveUnit(x, gg_unit_h09P_0009)
endfunction

function RemBisles takes group x returns nothing
    call GroupRemoveUnit(x, gg_unit_h0BL_0603)
    call GroupRemoveUnit(x, gg_unit_h0BM_0604)
endfunction

function RemWaterPortals takes group x returns nothing
    call GroupRemoveUnit(x, gg_unit_n01D_0904)
    call GroupRemoveUnit(x, gg_unit_n01D_0903)
    call GroupRemoveUnit(x, gg_unit_n003_0901)
    call GroupRemoveUnit(x, gg_unit_n003_0902)
    
    
endfunction




function TryAttack takes nothing returns nothing
    local integer i
    local group g= CreateGroup()
    local group g3= CreateGroup()
    local unit u= udg_LocalUnit2
    local unit u2= null
    local player p= GetOwningPlayer(u)
    local real x= GetUnitX(u)
    local real y= GetUnitY(u)
    local real x2
    local real y2
    local real dx
    local real dy
    //   ------------------- В атаку -------------------
    
    set CheckPlayer=p
    set udg_LocalInteger3=1
    
    

    set udg_LocalInteger5=GetRandomInt(1, 6)
    
    //// Дальнее исследование
    if udg_LocalInteger5 == 1 then
        
        
        

        call GroupClear(g)
        set CheckPlayer=p




        if IsUnitInGroup(u, TryPortal) then
            call GroupRemoveUnit(TryPortal, u)
            call GroupAddUnit(AfterPortal, u)
        endif
        //Если раз прошел через портал, дальше пусть лучше дальше пойдет.
        if IsUnitInGroup(u, AfterPortal) then
            call GroupEnumUnitsInRange(g, x, y, 100000.00, udg_B_EnemyUnit)
            call GroupRemoveUnit(AfterPortal, u)
        else
            call GroupEnumUnitsInRange(g, x, y, 100000.00, udg_B_EnemyUnitP)
        endif





        ///Континентальные штуки

        
        if RectContainsCoords(gg_rct_Kalim, x, y) == true and RectContainsCoords(gg_rct_NordNotKalim, x, y) == false then
            
            call GroupEnumUnitsInRect(g3, bj_mapInitialPlayableArea, udg_B_InKalim)
            call GroupRemoveGroup(g3, g)
            call RemKalim(g)
            if RectContainsCoords(gg_rct_Kalim, x, y) then
                call RemKalim_P(g)
            else
                call RemKalim_P2(g)
            endif
            call DestroyGroup(g3)
            set g3=CreateGroup()
        
        
        elseif RectContainsCoords(gg_rct_Nord, x, y) == true or RectContainsCoords(gg_rct_Azgel, x, y) == true or RectContainsCoords(gg_rct_NordNotKalim, x, y) == true then
            
            call GroupEnumUnitsInRect(g3, bj_mapInitialPlayableArea, udg_B_InNord)
            call GroupRemoveGroup(g3, g)
            call RemNord(g)
            call DestroyGroup(g3)
            set g3=CreateGroup()
        
        elseif ( RectContainsCoords(gg_rct_EastenKingdoms, x, y) or RectContainsCoords(gg_rct_EasternDungeons, x, y) or RectContainsCoords(gg_rct_BlackMountain, x, y) or RectContainsCoords(gg_rct_VknotOut, x, y) ) and not ( RectContainsCoords(gg_rct_OkeaniaNoVk, x, y) or RectContainsCoords(gg_rct_OkeaniaNoVk, x, y) ) then
          
            call GroupEnumUnitsInRect(g3, bj_mapInitialPlayableArea, udg_B_InVK)
            call GroupRemoveGroup(g3, g)
            call RemVK(g)
            call DestroyGroup(g3)
            set g3=CreateGroup()
        
        elseif ( RectContainsCoords(gg_rct_Outland, x, y) == true or RectContainsCoords(gg_rct_OutNoVk, x, y) == true ) and not RectContainsCoords(gg_rct_VknotOut, x, y) then
            
            call GroupEnumUnitsInRect(g3, bj_mapInitialPlayableArea, udg_B_InOutland)
            call GroupRemoveGroup(g3, g)
            
            call DestroyGroup(g3)
            set g3=CreateGroup()
        elseif RectContainsCoords(gg_rct_BrokenIsles, x, y) == true then

            call GroupEnumUnitsInRect(g3, bj_mapInitialPlayableArea, udg_B_InBIsles)
            call GroupRemoveGroup(g3, g)
            
            call DestroyGroup(g3)
            set g3=CreateGroup()
        
        elseif RectContainsCoords(gg_rct_Argus, x, y) == true then

            call GroupEnumUnitsInRect(g3, bj_mapInitialPlayableArea, udg_B_InArgus)
            call GroupRemoveGroup(g3, g)
            
            call DestroyGroup(g3)
            set g3=CreateGroup()
        
        elseif RectContainsCoords(gg_rct_Pandaria, x, y) == true then

            call GroupEnumUnitsInRect(g3, bj_mapInitialPlayableArea, udg_B_InPandaria)
            call GroupRemoveGroup(g3, g)
            call RemPandaria(g)
            call DestroyGroup(g3)
            set g3=CreateGroup()
        elseif RectContainsCoords(gg_rct_Ankirag, x, y) == true then

            call GroupEnumUnitsInRect(g3, bj_mapInitialPlayableArea, udg_B_Ankirag)
            call GroupRemoveGroup(g3, g)
            call DestroyGroup(g3)
            set g3=CreateGroup()
        
        endif
        call RemWaterPortals(g)

 ///Континентальные штуки конец
    
        
        set udg_LocalUnit3=GroupPickRandomUnit(g)
        set x2=GetUnitX(udg_LocalUnit3)
        set y2=GetUnitY(udg_LocalUnit3)
        
        // Если это портал
        if WaygateIsActive(udg_LocalUnit3) == true then
            
            set dx=x - x2
            set dy=y - y2
            set dx=SquareRoot(dx * dx + dy * dy)
            call GroupEnumUnitsInRange(g3, x, y, 2500 * AiRadius / 5, B_LazyF)
            call GroupAddUnit(TryPortal, u)
            if dx <= 2500 then
                //call IssueImmediateOrder(udg_LocalUnit3,"web")
                
                
                
                call GroupTargetOrder(g3, "smart", udg_LocalUnit3)
                call GroupAddGroup(g3, AfterPortal)
                call IssueTargetOrder(u, "smart", udg_LocalUnit3)
                call IssueImmediateOrder(udg_LocalUnit3, "web")
                call BlzEndUnitAbilityCooldown(udg_LocalUnit3, 'A0HY')
            else
                
                call GroupAddUnit(TryPortal, u)
                call GroupPointOrder(g3, "smart", x2, y2)
                call GroupAddGroup(g3, AfterPortal)
                call IssuePointOrder(u, "smart", x2, y2)
            
            endif
            
        // Основной случай
        else
            set CheckPlayer=p
            call IssuePointOrder(u, "attack", x2, y2)
            call GroupEnumUnitsInRange(g3, x, y, 1500 * AiRadius / 5, B_LazyF)
            loop
                set u2=FirstOfGroup(g3)
                exitwhen u2 == null
                call IssuePointOrder(u2, "attack", x2, y2)
                call GroupRemoveUnit(g3, u2)
                set u2=null
            endloop
        endif
        call GroupClear(g)
        
           
    
    //// Ближайшее исследование, пытается перебрадть радиус пока не найдет хотя бы одного юнита
    else
    
        
        set i=1
        loop
            exitwhen i > 10
            set i=i + 1
            
            
            call GroupClear(g)
            set CheckPlayer=p
                     
                     
            if IsUnitInGroup(u, TryPortal) then
                call GroupRemoveUnit(TryPortal, u)
                call GroupAddUnit(AfterPortal, u)
            endif
            
            if IsUnitInGroup(u, AfterPortal) then
                call GroupEnumUnitsInRange(g, x, y, ( 4000.00 * I2R(i) ), udg_B_EnemyUnit)
                
            else
                call GroupEnumUnitsInRange(g, x, y, ( 4000.00 * I2R(i) ), udg_B_EnemyUnitP)
            endif
            
            
            ///Континентальные штуки
            if RectContainsCoords(gg_rct_Kalim, x, y) == true and RectContainsCoords(gg_rct_NordNotKalim, x, y) == false then
                
                call GroupEnumUnitsInRect(g3, bj_mapInitialPlayableArea, udg_B_InKalim)
                call GroupRemoveGroup(g3, g)
                call RemKalim(g)
                call RemKalim_P(g)
                call DestroyGroup(g3)
                set g3=CreateGroup()
            
        
            elseif RectContainsCoords(gg_rct_Nord, x, y) == true or RectContainsCoords(gg_rct_Azgel, x, y) == true or RectContainsCoords(gg_rct_NordNotKalim, x, y) == true then
                
                call GroupEnumUnitsInRect(g3, bj_mapInitialPlayableArea, udg_B_InNord)
                call GroupRemoveGroup(g3, g)
                call RemNord(g)
                call DestroyGroup(g3)
                set g3=CreateGroup()
            
            elseif ( RectContainsCoords(gg_rct_EastenKingdoms, x, y) or RectContainsCoords(gg_rct_EasternDungeons, x, y) or RectContainsCoords(gg_rct_BlackMountain, x, y) or RectContainsCoords(gg_rct_VknotOut, x, y) ) and not ( RectContainsCoords(gg_rct_OkeaniaNoVk, x, y) or RectContainsCoords(gg_rct_OkeaniaNoVk, x, y) ) then
              
                call GroupEnumUnitsInRect(g3, bj_mapInitialPlayableArea, udg_B_InVK)
                call GroupRemoveGroup(g3, g)
                call RemVK(g)
                call DestroyGroup(g3)
                set g3=CreateGroup()
            
            elseif ( RectContainsCoords(gg_rct_Outland, x, y) == true or RectContainsCoords(gg_rct_OutNoVk, x, y) == true ) and not RectContainsCoords(gg_rct_VknotOut, x, y) then
                
                call GroupEnumUnitsInRect(g3, bj_mapInitialPlayableArea, udg_B_InOutland)
                call GroupRemoveGroup(g3, g)
                
                call DestroyGroup(g3)
                set g3=CreateGroup()
            elseif RectContainsCoords(gg_rct_BrokenIsles, x, y) == true then

                call GroupEnumUnitsInRect(g3, bj_mapInitialPlayableArea, udg_B_InBIsles)
                call GroupRemoveGroup(g3, g)
                
                call DestroyGroup(g3)
                set g3=CreateGroup()
            
            elseif RectContainsCoords(gg_rct_Argus, x, y) == true then

                call GroupEnumUnitsInRect(g3, bj_mapInitialPlayableArea, udg_B_InArgus)
                call GroupRemoveGroup(g3, g)
                
                call DestroyGroup(g3)
                set g3=CreateGroup()
            
            elseif RectContainsCoords(gg_rct_Pandaria, x, y) == true then

                call GroupEnumUnitsInRect(g3, bj_mapInitialPlayableArea, udg_B_InPandaria)
                call GroupRemoveGroup(g3, g)
                call RemPandaria(g)
                call DestroyGroup(g3)
                set g3=CreateGroup()
            
            elseif RectContainsCoords(gg_rct_Ankirag, x, y) == true then

                call GroupEnumUnitsInRect(g3, bj_mapInitialPlayableArea, udg_B_Ankirag)
                call GroupRemoveGroup(g3, g)
                call DestroyGroup(g3)
                call RemKalim_P2(g)
                set g3=CreateGroup()
            
            endif
            call RemWaterPortals(g)
    
        ///Континентальные штуки конец
        ////
            
            
            
            if FirstOfGroup(g) == null then
            else
                set udg_LocalUnit3=GroupPickRandomUnit(g)
                set x2=GetUnitX(udg_LocalUnit3)
                set y2=GetUnitY(udg_LocalUnit3)
                
                if WaygateIsActive(udg_LocalUnit3) then
        
                    set dx=x - x2
                    set dy=y - y2
                    set dx=SquareRoot(dx * dx + dy * dy)
                    call GroupEnumUnitsInRange(g3, x, y, 2500 * AiRadius / 5, B_LazyF)
                    call GroupAddUnit(TryPortal, u)
                    if dx <= 2500 then
                        //call IssueImmediateOrder(udg_LocalUnit3,"web")
                        
                        
                        
                        call GroupTargetOrder(g3, "smart", udg_LocalUnit3)
                        call GroupAddGroup(g3, AfterPortal)
                        call IssueTargetOrder(u, "smart", udg_LocalUnit3)
                        call IssueImmediateOrder(udg_LocalUnit3, "web")
                        call BlzEndUnitAbilityCooldown(udg_LocalUnit3, 'A0HY')
                    else
                        
                        call GroupAddUnit(TryPortal, u)
                        call GroupPointOrder(g3, "smart", x2, y2)
                        call GroupAddGroup(g3, AfterPortal)
                        call IssuePointOrder(u, "smart", x2, y2)
                    
                    endif
                           
                else
                    
                    
                    
                    //Отдаю приказ юниту и рядом стоящим
                    
                    set CheckPlayer=p
                    call IssuePointOrder(u, "attack", x2, y2)
                    call GroupEnumUnitsInRange(g3, x, y, 1500 * AiRadius / 5, B_LazyF)
                    loop
                        set u2=FirstOfGroup(g3)
                        exitwhen u2 == null
                        call IssuePointOrder(u2, "attack", x2, y2)
                        call GroupRemoveUnit(g3, u2)
                        set u2=null
                    endloop
                    
                    
                    
                endif
                call GroupClear(g)
                set i=15
            endif
            
        endloop
        call GroupRemoveUnit(AfterPortal, u)
        
    endif
    
    
    
    
    
    set u=null
    set u=null
    call DestroyGroup(g)
    call DestroyGroup(g3)
    set g=null
    set g3=null
endfunction



//***************************************************************************
//*  TryToAttackN Uni
function TryAttackN takes nothing returns nothing
    local boolean HaveOrder= false
    local unit u= udg_LocalUnit3
    local unit u2
    local integer i= 0
    local group g= CreateGroup()
    local group g3= CreateGroup()
    local real x= GetUnitX(u)
    local real y= GetUnitX(u)
    local real x2
    local real y2
    

    set i=1
    loop
        exitwhen i > 10
        set CheckPlayer=GetOwningPlayer(u)
        call GroupEnumUnitsInRange(g, x, y, 6600 * I2R(i), udg_B_EnemyUnitN)
        
        if FirstOfGroup(g) != null then
            set u2=GroupPickRandomUnit(g)
            set x2=GetUnitX(u2)
            set y2=GetUnitY(u2)
            set u2=null
            set i=100
            call IssuePointOrder(u, "attack", x2, y2)
            call GroupEnumUnitsInRange(g3, x, y, 3000 * AiRadius / 5, B_LazyN)
            
            
            loop
                set u2=FirstOfGroup(g3)
                exitwhen u2 == null
                call IssuePointOrder(u2, "attack", x2, y2)
                call GroupRemoveUnit(g3, u2)
            endloop
            
        endif
        
        set i=i + 1
    endloop

    set u2=null
    call DestroyGroup(g)
    call DestroyGroup(g3)
    set g=null
    set g3=null
endfunction



//***************************************************************************
//*  TryToBuild2 M
function TryBuild takes nothing returns nothing
    local unit u= TryBuild_u
    local real x
    local real y
    local real x1
    local real y1
    local integer w= 0
    local integer b= 0
    local integer HaveOrder= 0
    local integer pi= GetPlayerId(GetOwningPlayer(u))
    local integer i= 1
    local integer array a

    
    //call DisplayTimedTextFromPlayer( Player( 0x00 ), 0, 0, 4, "Вхожу в билд" )
    
    call GroupAddUnit(udg_Ai_buildersT[pi], u)
    call GroupRemoveUnit(udg_Ai_builders[pi], u)
    call GroupRemoveUnit(udg_Ai_harvest[pi], u)
    
    //Что строить
    set b=1

    set x=GetUnitX(u)
    set y=GetUnitY(u)
    
    //Если в воде для верфи - то строй верфь c высоким шансом)
    if LoadInteger(AiData, pi, 'h011') < 12 and ( not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) and not IsTerrainPathable(x, y, PATHING_TYPE_FLOATABILITY) and RectContainsCoords(gg_rct_Outland, x, y) != true and RectContainsCoords(gg_rct_Azgel, x, y) != true ) then
        set i=GetRandomInt(1, 5)
        set b=0
        
        if i <= 4 then
            set HaveOrder=1
            
            loop
                exitwhen b >= 5
                set b=b + 1
                
                set x1=x + 200.00 * Cos(GetRandomReal(0.00, 360.00) * bj_DEGTORAD)
                set y1=y + 200.00 * Sin(GetRandomReal(0.00, 360.00) * bj_DEGTORAD)
                
                if not ( IsTerrainPathable(x1, y1, PATHING_TYPE_WALKABILITY) or IsTerrainPathable(x1, y1, PATHING_TYPE_FLOATABILITY) or RectContainsCoords(gg_rct_Outland, x1, y1) ) then
                    
                    
                    if AiRace[pi] == "Scarlet" or AiRace[pi] == "BloodElves" then
                        call IssueBuildOrderById(u, 'h011', x1, y1)
                    endif
                    
                    
                    set u=null
                    return
                endif
                
            endloop
        endif
    endif
  
    //Идти к точке где много воды
    set i=GetRandomInt(1, 20)
    if i == 1 and LoadInteger(AiData, pi, 'h011') < 12 then
    
        if RectContainsCoords(gg_rct_EastenKingdoms, x, y) then
            set i=GetRandomInt(1, 4)
                if i == 1 then
                    call IssuePointOrder(u, "move", 30150, - 3454)
                elseif i == 2 then
                    call IssuePointOrder(u, "move", 25504, - 16284)
                elseif i == 3 then
                    call IssuePointOrder(u, "move", 19258, 5665)
                elseif i == 4 then
                    call IssuePointOrder(u, "move", 10979, 10501)
                endif
         
        elseif RectContainsCoords(gg_rct_Kalim, x, y) then
            set i=GetRandomInt(1, 4)
                if i == 1 then
                    call IssuePointOrder(u, "move", - 28610, 16300)
                elseif i == 2 then
                    call IssuePointOrder(u, "move", - 15796, - 10105)
                elseif i == 3 then
                    call IssuePointOrder(u, "move", - 12405, 96678)
                elseif i == 4 then
                    call IssuePointOrder(u, "move", - 27443, 11058)
                endif
        elseif RectContainsCoords(gg_rct_Nord, x, y) then
            set i=GetRandomInt(1, 4)
                if i == 1 then
                    call IssuePointOrder(u, "move", - 4711, 20912)
                elseif i == 2 then
                    call IssuePointOrder(u, "move", 8753, 22230)
                elseif i == 3 then
                    call IssuePointOrder(u, "move", 1273, 20088)
                elseif i == 4 then
                    call IssuePointOrder(u, "move", - 15652, 21381)
                endif
         
        elseif RectContainsCoords(gg_rct_BrokenIsles, x, y) then
            set i=GetRandomInt(1, 2)
                if i == 1 then
                    call IssuePointOrder(u, "move", 2500, 12654)
                else
                    call IssuePointOrder(u, "move", 4121, 621)
                endif
        elseif RectContainsCoords(gg_rct_Pandaria, x, y) then
            set i=GetRandomInt(1, 2)
                if i == 1 then
                    call IssuePointOrder(u, "move", - 9460, - 12451)
                else
                    call IssuePointOrder(u, "move", - 3941, - 22869)
                endif
        endif
        
        set u=null
        return
        
    endif
  
    //Шанс перейти на новую локу
    set i=GetRandomInt(1, 25)
    if i == 1 then
        set x=x + 7000.00 * Cos(GetRandomReal(0.00, 360.00) * bj_DEGTORAD)
        set y=y + 7000.00 * Sin(GetRandomReal(0.00, 360.00) * bj_DEGTORAD)
        call IssuePointOrder(u, "move", x, y)
        set u=null
        return
    endif
  
  
  
    set x=x + 1000.00 * Cos(GetRandomReal(0.00, 360.00) * bj_DEGTORAD)
    set y=y + 1000.00 * Sin(GetRandomReal(0.00, 360.00) * bj_DEGTORAD)
    
    
    ///// АЛЫЙ ОРДЕН
    /////
    
    if AiRace[pi] == "Scarlet" then
        set a[0]=1 //Кол-во вариантов со старта
        set a[1]='h05Y' // 1 Ферма
        // Доп. варианты при условиях
        // 2 Ратуша 
        if LoadInteger(AiData, pi, 'h05U') < 4 then
            set i=4 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h05U'
                
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        // Доп приор ферм на старте
        if LoadInteger(AiData, pi, 'h05Y') < 15 then
            set i=4 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h05Y'
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        // 3 Казарма
        if LoadInteger(AiData, pi, 'h05Z') < 12 then
            set i=4 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h05Z'
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        // 4 Башня
        if LoadInteger(AiData, pi, 'h063') < 25 then
            set i=1 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h063'
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        // 5 Лесопилка
        if LoadInteger(AiData, pi, 'h062') < 5 then
            set i=2 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h062'
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        // 6 Кузница
        if LoadInteger(AiData, pi, 'h060') < 6 then
            set i=2 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h060'
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        // 7 Алтарь
        if LoadInteger(AiData, pi, 'h05X') < 3 then
            set i=5 //мошь выбора
            set b=1
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h05X'
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        //Мастеская
        if LoadInteger(AiData, pi, 'h05V') + LoadInteger(AiData, pi, 'h05W') >= 1 then
            if LoadInteger(AiData, pi, 'h064') < 7 then
                set i=8 //мошь выбора
                set b=1
                
                loop
                    set a[0]=a[0] + 1
                    set a[a[0]]='h064'
                    set b=b + 1
                    exitwhen b >= i
                endloop
            endif
            // 9 Храм
            if LoadInteger(AiData, pi, 'h061') < 12 then
                set i=8 //мошь выбора
                set b=1
                loop
                    set a[0]=a[0] + 1
                    set a[a[0]]='h061'
                    set b=b + 1
                    exitwhen b >= i
                endloop
            endif
        endif
        // 10 Церковь
        if LoadInteger(AiData, pi, 'h05W') >= 1 and LoadInteger(AiData, pi, 'h068') < 12 then
            set i=10 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h068'
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        
        
    ////// ЭК
    //////
        
    elseif AiRace[pi] == "BloodElves" then
        set a[0]=1 //Кол-во вариантов со старта
        set a[1]='h04M' // 1 Ферма
        // Доп. варианты при условиях
        // 2 Ратуша 
        if LoadInteger(AiData, pi, 'h04C') < 4 then
            set i=4 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h04C'
                
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        // Доп приор ферм на старте
        if LoadInteger(AiData, pi, 'h04M') < 15 then
            set i=4 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h04M'
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        // 3 Казарма
        if LoadInteger(AiData, pi, 'h04D') < 12 then
            set i=4 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h04D'
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        // 4 Башня
        if LoadInteger(AiData, pi, 'h04N') < 25 then
            set i=1 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h04N'
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        // 5 Лесопилка
        if LoadInteger(AiData, pi, 'h04Q') < 5 then
            set i=2 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h04Q'
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        // 6 Кузница
        if LoadInteger(AiData, pi, 'h04R') < 6 then
            set i=2 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h04R'
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        // 7 Алтарь
        if LoadInteger(AiData, pi, 'h05J') < 3 then
            set i=5 //мошь выбора
            set b=1
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h05J'
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
        //Мастеская
        if LoadInteger(AiData, pi, 'h04B') + LoadInteger(AiData, pi, 'h04A') >= 1 then
            if LoadInteger(AiData, pi, 'h04G') < 12 then
                set i=8 //мошь выбора
                set b=1
                
                loop
                    set a[0]=a[0] + 1
                    set a[a[0]]='h04G'
                    set b=b + 1
                    exitwhen b >= i
                endloop
            endif
            // 9 Храм
            if LoadInteger(AiData, pi, 'h04E') < 12 then
                set i=8 //мошь выбора
                set b=1
                loop
                    set a[0]=a[0] + 1
                    set a[a[0]]='h04E'
                    set b=b + 1
                    exitwhen b >= i
                endloop
            endif
        endif
        // 10 Хранилище энергии
        if LoadInteger(AiData, pi, 'h04F') < 12 then
            set i=2 //мошь выбора
            set b=1
            
            loop
                set a[0]=a[0] + 1
                set a[a[0]]='h04F'
                set b=b + 1
                exitwhen b >= i
            endloop
        endif
    
    
    endif

    set i=GetRandomInt(1, a[0])
    call IssueBuildOrderById(u, a[i], x, y)
    
    
    
    set u=null
endfunction

//***************************************************************************
//*  HasEnemyNear
function HasEnemyNear takes unit u returns boolean
    local group g= CreateGroup()
    
    if u != null then
        set CheckPlayer=GetOwningPlayer(u)
        call GroupEnumUnitsInRange(g, GetUnitX(u), GetUnitY(u), 7500, udg_B_EnemyUnit)
        if FirstOfGroup(g) != null then
            

            call DestroyGroup(g)
            set u=null
            set g=null
            return true
        endif
    endif
    
  
    
    set u=null
    call DestroyGroup(g)
    set g=null
    return false
endfunction
//***************************************************************************
//*  PortToAction


function PortTo takes unit u returns nothing
    local group g= CreateGroup()
    local player p= GetOwningPlayer(u)
    local integer pi= GetPlayerId(p)
    local unit u2

    call GroupEnumUnitsOfPlayer(g, p, B_Lazy)
    set u2=GroupPickRandomUnit(g)
    call GroupClear(g)
    call UnitAddAbility(u, 'A0Y4')
    call IssuePointOrder(u, "darksummoning", GetUnitX(u2), GetUnitY(u2))
    
    if LoadInteger(AiData, GetPlayerId(p), 'h07A') < 3 then
        set u2=CreateUnit(Player(pi), 'h07A', GetUnitX(u), GetUnitY(u), 0)
        call GroupAddUnit(udg_Ai_army[pi], u2)
        call GroupAddUnit(AiUnitsToPort[pi], u2)
        call NumberAdd(pi , 'h07A')
    endif
    
    set u=null
    set u2=null
    call DestroyGroup(g)
    set g=null
    set p=null
endfunction
//***************************************************************************
//*  TryPort


function TryPort takes nothing returns nothing
    local group g= CreateGroup()
    local integer pi= TryPort_pi
    local unit u
    


    set u=GroupPickRandomUnit(AiUnitsToPort[pi])
    if u != null then
        set CheckPlayer=Player(pi)
        if HasEnemyNear(u) != null then
            call PortTo(u)
        endif
    endif
    
    
    
    set u=null
    call DestroyGroup(g)
    set g=null
endfunction
//***************************************************************************
//*  GiveWeapon

function TryBuy takes player p returns nothing
    local group g= CreateGroup()
    local unit u
    local integer i
    call GroupEnumUnitsOfPlayer(g, p, LiveHero)
    set u=GroupPickRandomUnit(g)
    if u != null and UnitInventoryCount(u) < 6 then
        set i=GetRandomInt(1, 6)
        if i == 1 then
            call UnitAddItemByIdSwapped('I02S', u)
        elseif i == 2 then
            call UnitAddItemByIdSwapped('I030', u)
        elseif i == 3 then
            call UnitAddItemByIdSwapped('I02Z', u)
        elseif i == 4 then
            call UnitAddItemByIdSwapped('I02Y', u)
        elseif i == 5 then
            call UnitAddItemByIdSwapped('I02T', u)
        elseif i == 6 then
            call UnitAddItemByIdSwapped('I02X', u)
        endif
    endif
    call DestroyGroup(g)
    set g=null
    set u=null
endfunction
//***************************************************************************
//*  SpawnMageTp


function MakeMageTp takes integer pi returns nothing
    local group g= CreateGroup()
    local unit u
    local unit u2
    
    call GroupEnumUnitsOfPlayer(g, Player(pi), Altars)
    if FirstOfGroup(g) != null then
        set u2=GroupPickRandomUnit(g)
        set u=CreateUnit(Player(pi), 'h07A', GetUnitX(u2), GetUnitY(u2), 0)
        call GroupAddUnit(udg_Ai_army[pi], u)
        call GroupAddUnit(AiUnitsToPort[pi], u)
        call NumberAdd(pi , 'h07A')
        
    endif



    set u=null
    set u2=null
    call DestroyGroup(g)
    set g=null
endfunction
