//*  InitThings
function InitThings takes nothing returns nothing
    local integer i= 0
    loop
        exitwhen i == 25
        set cap_time[i]=true
        set Vassals[i]=CreateForce()
        set Senior[i]=null
        set Capital[i]=null
        
        set i=i + 1
        
    endloop
    
   
endfunction

