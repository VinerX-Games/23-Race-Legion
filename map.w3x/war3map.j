        call CreateNUnitsAtLoc(udg_LocalInteger2, 'e01Q', GetOwningPlayer(GetTriggerUnit()), udg_LocalPosition2, bj_UNIT_FACING)
        set udg_LocalOtrad=GetLastCreatedGroup()
