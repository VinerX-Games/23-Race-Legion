    set gg_trg_K1T4=CreateTrigger()
    call DisableTrigger(gg_trg_K1T4)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_K1T4, EVENT_PLAYER_UNIT_TRAIN_FINISH)
    call TriggerAddCondition(gg_trg_K1T4, Condition(function Trig_K1T4_Conditions))
    call TriggerAddAction(gg_trg_K1T4, function Trig_K1T4_Actions)
endfunction


