function Join_Naga takes integer id,integer pi,unit u returns nothing
    local integer i
    if id == 'nmpe' then
        call GroupAddUnit(udg_Ai_builders[pi], u)
    elseif id == 'n079' then
        call GroupAddUnit(udg_Ai_navy[pi], u)
        call NumberAdd(pi , StringHash("NumberN"))
    elseif aiUnitJoinsCapitalGuard(u , pi) then
    else
        call aiUnitJoinsArmy(u , pi)
    endif


//Герои N07A,H0JU,H0JV
    //Маг мурлок AEtq,AHbn,AHab,ANrf
    if id == 'N07A' then
        set i=GetRandomInt(1, 3)
        if i == 1 then
            call SelectHeroSkill(u, 'AHbn')
        elseif i == 2 then
            call SelectHeroSkill(u, 'AHab')
        else
            call SelectHeroSkill(u, 'AHab')
        endif
    
    
    //Нага Охотница A13D  A13C,AEbl,A13A,
    elseif id == 'H0JV' then
        set i=GetRandomInt(1, 3)
        if i == 1 then
            call SelectHeroSkill(u, 'A13C')
        elseif i == 2 then
            call SelectHeroSkill(u, 'A13C')
        else
            call SelectHeroSkill(u, 'A13A')
        endif
    
    
    //Герой нага A14G-   A14I,A14F,,A14H
    elseif id == 'H0JU' then
        set i=GetRandomInt(1, 3)
        if i == 1 then
            call SelectHeroSkill(u, 'A14I')
        elseif i == 2 then
            call SelectHeroSkill(u, 'A14I')
        else
            call SelectHeroSkill(u, 'A14H')
        endif
    
    endif


endfunction
//***************************************************************************
//*  AttackerNaga
function Attacker_Naga takes integer id,unit u,unit target,player p returns nothing
    local real x= GetUnitX(target)
    local real y= GetUnitY(target)
    local real x2= GetUnitY(u)
    local real y2= GetUnitY(u)
    
    //Наги в воде c ускорением
    if not IsTerrainPathable(x2, y2, PATHING_TYPE_WALKABILITY) and GetUnitAbilityLevel(u, 'S00E') == 0 then
        call IssueImmediateOrder(u, "blight")
        return
    endif
    
    
    if IsUnitType(u, UNIT_TYPE_HERO) then
        // Охотница
        if id == 'H0JV' then
            set gInt=GetRandomInt(1, 5)
                if gInt <= 2 then
                    call IssueImmediateOrder(u, "berserk")
                elseif gInt == 3 then
                    call IssuePointOrder(u, "clusterrockets", x, y)
                elseif gInt == 4 then
                    call IssuePointOrder(u, "blink", x2 + GetRandomReal(- 500, 500), y2 + GetRandomReal(- 500, 500))
                endif
        
        /// Мурлок шам
        elseif id == 'N07A' then
            set gInt=GetRandomInt(1, 5)
                if gInt == 1 then
                    call IssueTargetOrder(u, "banish", target)
                elseif gInt == 2 then
                    call IssuePointOrder(u, "rainoffire", x, y)
                elseif gInt == 3 then
                    call IssueImmediateOrder(u, "tranquility")
                endif
        
        
        /// Нага воин или аналог мурлок
        elseif id == 'H0JU' or id == 'H0OZ' then
            set gInt=GetRandomInt(1, 6)
                if gInt == 1 then
                    call IssueTargetOrder(u, "doom", target)
                elseif gInt == 2 then
                    call IssueTargetOrder(u, "frostnova", target)
                elseif gInt == 3 then
                    call IssueImmediateOrder(u, "stomp")
                endif
        endif
    else
        // ------ Юниты 

        /// Глубинница
        if id == 'n051' then
            set gInt=GetRandomInt(1, 4)
            if gInt == 1 then
                call IssueImmediateOrder(u, "healon")
            elseif gInt == 2 then
                call IssuePointOrder(u, "dispel", x, y)
            endif //+ спелл без приказа
        /// Сирена
        elseif id == 'nnsw' then
            set gInt=GetRandomInt(1, 6)
            if gInt == 1 then
                call IssueTargetOrder(u, "cyclone", target)
            elseif gInt == 2 then
                call IssueImmediateOrder(u, "frostarmoron")
            elseif gInt == 3 then
                call IssueImmediateOrder(u, "parasiteon")
            endif
        /// Нага гвардеец
        elseif id == 'nnrg' then
            set gInt=GetRandomInt(1, 6)
            if gInt == 1 then
                call IssueTargetOrder(u, "thunderbolt", target)
            elseif gInt == 2 then
                call IssuePointOrder(u, "carrionswarm", x, y)
            endif
        endif
    endif
    

endfunction
