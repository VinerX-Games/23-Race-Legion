    return true
endfunction

function Trig_Portal_Periodic_Func001Func006C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_Portal_loc1, udg_Portal_loc3) <= udg_Portal_range[udg_Portal_INDEX_TARGET] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func001A takes nothing returns nothing
    set udg_Portal_traveller=GetEnumUnit()
    set udg_Portal_INDEX_CASTER=GetUnitUserData(udg_Portal_traveller)
    set udg_Portal_INDEX_TARGET=GetUnitUserData(udg_Portal_targeted[udg_Portal_INDEX_CASTER])
    set udg_Portal_loc1=GetUnitLoc(udg_Portal_traveller)
    set udg_Portal_loc3=GetUnitLoc(udg_Portal_targeted[udg_Portal_INDEX_CASTER])
    if ( Trig_Portal_Periodic_Func001Func006C() ) then
        if ( Trig_Portal_Periodic_Func001Func006Func002C() ) then
            if ( Trig_Portal_Periodic_Func001Func006Func002Func002C() ) then
                set udg_Portal_isTeleporting[udg_Portal_INDEX_CASTER]=true
                set udg_Portal_delayFXAbil[udg_Portal_INDEX_CASTER]=udg_Portal_delayFXAbil[udg_Portal_INDEX_TARGET]
                call UnitAddAbilityBJ(udg_Portal_delayFXAbil[udg_Portal_INDEX_CASTER], udg_Portal_traveller)
            else
            endif
            set udg_Portal_delay[udg_Portal_INDEX_CASTER]=( udg_Portal_delay[udg_Portal_INDEX_CASTER] - ( 1.00 / 32.00 ) )
        else
            set udg_Portal_isTeleporting[udg_Portal_INDEX_CASTER]=false
            set udg_Portal_loc2=GetUnitLoc(udg_Portal_traveller)
            call AddSpecialEffectLocBJ(udg_Portal_loc2, udg_Portal_departureFX[udg_Portal_INDEX_TARGET])
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
            call UnitRemoveAbilityBJ(udg_Portal_delayFXAbil[udg_Portal_INDEX_CASTER], udg_Portal_traveller)
            call RemoveLocation(udg_Portal_loc2)
            set udg_Portal_loc2=GetUnitLoc(udg_Portal_portal[udg_Portal_INDEX_TARGET])
            // -------- -------- -------- -------- -------- -------- -------- -------- -------- --------
            if ( Trig_Portal_Periodic_Func001Func006Func002Func011C() ) then
                call CreateNUnitsAtLocFacingLocBJ(1, udg_Portal_missileDummy[udg_Portal_INDEX_TARGET], GetOwningPlayer(udg_Portal_traveller), udg_Portal_loc1, udg_Portal_loc2)
                set udg_Portal_dummy=GetLastCreatedUnit()
                if ( Trig_Portal_Periodic_Func001Func006Func002Func011Func003C() ) then
                    call SelectUnitAddForPlayer(udg_Portal_dummy, GetOwningPlayer(udg_Portal_traveller))
                else
                endif
                if ( Trig_Portal_Periodic_Func001Func006Func002Func011Func004C() ) then
                    call SetUnitInvulnerable(udg_Portal_dummy, false)
                else
                endif
                call IssuePointOrderLocBJ(udg_Portal_dummy, "move", udg_Portal_loc2)
                set udg_Portal_INDEX_TRAVELLER=GetUnitUserData(udg_Portal_dummy)
                set udg_Portal_missileSpeed[udg_Portal_INDEX_TRAVELLER]=0.00
                set udg_Portal_portal[udg_Portal_INDEX_TRAVELLER]=udg_Portal_portal[udg_Portal_INDEX_TARGET]
                set udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER]=udg_Portal_traveller
                call GroupAddUnitSimple(udg_Portal_dummy, udg_Portal_teleMissiles)
                call ShowUnitHide(udg_Portal_traveller)
            else
                if ( Trig_Portal_Periodic_Func001Func006Func002Func011Func012C() ) then
                    call CreateNUnitsAtLocFacingLocBJ(1, udg_Portal_missileDummy[udg_Portal_INDEX_TARGET], GetOwningPlayer(udg_Portal_traveller), udg_Portal_loc1, udg_Portal_loc2)
                    set udg_Portal_dummy=GetLastCreatedUnit()
                    if ( Trig_Portal_Periodic_Func001Func006Func002Func011Func012Func004C() ) then
                        call SelectUnitAddForPlayer(udg_Portal_dummy, GetOwningPlayer(udg_Portal_traveller))
                    else
                    endif
                    if ( Trig_Portal_Periodic_Func001Func006Func002Func011Func012Func005C() ) then
                        call SetUnitInvulnerable(udg_Portal_dummy, false)
                    else
                    endif
                    call UnitAddAbilityBJ(udg_Portal_missileFXAbil[udg_Portal_INDEX_TARGET], udg_Portal_dummy)
                    call SetUnitFlyHeightBJ(udg_Portal_dummy, udg_Portal_missileHeight[udg_Portal_INDEX_TARGET], 0.00)
                    set udg_Portal_INDEX_TRAVELLER=GetUnitUserData(udg_Portal_dummy)
                    set udg_Portal_missileSpeed[udg_Portal_INDEX_TRAVELLER]=udg_Portal_missileSpeed[udg_Portal_INDEX_TARGET]
                    set udg_Portal_portal[udg_Portal_INDEX_TRAVELLER]=udg_Portal_portal[udg_Portal_INDEX_TARGET]
                    set udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER]=udg_Portal_traveller
                    call SetUnitPathing(udg_Portal_dummy, false)
                    call GroupAddUnitSimple(udg_Portal_dummy, udg_Portal_teleMissiles)
                    call ShowUnitHide(udg_Portal_traveller)
                else
                    call RemoveLocation(udg_Portal_loc3)
                    set udg_Portal_INDEX_TRAVELLER=GetUnitUserData(udg_Portal_portal[udg_Portal_INDEX_TARGET])
                    set udg_Portal_loc3=PolarProjectionBJ(udg_Portal_loc2, GetRandomReal(0.00, udg_Portal_range[udg_Portal_INDEX_TRAVELLER]), GetRandomDirectionDeg())
                    call SetUnitPositionLoc(udg_Portal_traveller, udg_Portal_loc3)
                    set udg_Portal_loc4=GetUnitRallyPoint(udg_Portal_targeted[udg_Portal_INDEX_CASTER])
                    call IssuePointOrderLocBJ(udg_Portal_traveller, "attack", udg_Portal_loc4)
                    call RemoveLocation(udg_Portal_loc4)
                    call AddSpecialEffectLocBJ(udg_Portal_loc3, udg_Portal_arrivalFX[udg_Portal_INDEX_TRAVELLER])
                    call DestroyEffectBJ(GetLastCreatedEffectBJ())
                endif
            endif
            call RemoveLocation(udg_Portal_loc2)
            set udg_Portal_targeted[udg_Portal_INDEX_CASTER]=null
            call GroupRemoveUnitSimple(udg_Portal_traveller, udg_Portal_group)
        endif
    else
        if ( Trig_Portal_Periodic_Func001Func006Func001C() ) then
            // This is here in case of a unit being knockbacked outside the Portal's reach
            set udg_Portal_isTeleporting[udg_Portal_INDEX_CASTER]=false
            call IssueTargetOrderBJ(udg_Portal_traveller, "smart", udg_Portal_targeted[udg_Portal_INDEX_CASTER])
        else
        endif
    endif
    // -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- 
    call RemoveLocation(udg_Portal_loc3)
    call RemoveLocation(udg_Portal_loc1)
endfunction

function Trig_Portal_Periodic_Func002Func007Func003Func001Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Portal_portal[udg_Portal_INDEX_TRAVELLER]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func002Func007Func003Func001Func012C takes nothing returns boolean
    if ( not ( IsUnitSelected(udg_Portal_traveller, GetOwningPlayer(udg_Portal_traveller)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func002Func007Func003Func001C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_Portal_loc1, udg_Portal_loc2) <= udg_Portal_range[udg_Portal_INDEX_TARGET] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func002Func007Func003Func002Func013C takes nothing returns boolean
    if ( not ( IsUnitSelected(udg_Portal_traveller, GetOwningPlayer(udg_Portal_traveller)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func002Func007Func003Func002Func014C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Portal_portal[udg_Portal_INDEX_TRAVELLER]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func002Func007Func003Func002C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_Portal_loc1, udg_Portal_loc2) <= ( udg_Portal_missileSpeed[udg_Portal_INDEX_TRAVELLER] / 33.00 ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func002Func007Func003C takes nothing returns boolean
    if ( not ( udg_Portal_missileSpeed[udg_Portal_INDEX_TRAVELLER] > 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func002Func007Func015C takes nothing returns boolean
    if ( not ( IsUnitSelected(udg_Portal_traveller, GetOwningPlayer(udg_Portal_traveller)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func002Func007C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Portal_traveller) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Func002A takes nothing returns nothing
    // In this group, the Portal_traveller is the missile unit, not the actual unit being teleported
    // The unit is Portal_targeted
    set udg_Portal_traveller=GetEnumUnit()
    set udg_Portal_INDEX_TRAVELLER=GetUnitUserData(udg_Portal_traveller)
    set udg_Portal_INDEX_CASTER=GetUnitUserData(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER])
    set udg_Portal_INDEX_TARGET=GetUnitUserData(udg_Portal_portal[udg_Portal_INDEX_TRAVELLER])
    if ( Trig_Portal_Periodic_Func002Func007C() ) then
        set udg_Portal_loc1=GetUnitLoc(udg_Portal_traveller)
        set udg_Portal_loc2=GetUnitLoc(udg_Portal_portal[udg_Portal_INDEX_TRAVELLER])
        if ( Trig_Portal_Periodic_Func002Func007Func003C() ) then
            if ( Trig_Portal_Periodic_Func002Func007Func003Func002C() ) then
                call ShowUnitShow(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER])
                set udg_Portal_loc3=PolarProjectionBJ(udg_Portal_loc1, GetRandomReal(0.00, udg_Portal_range[GetUnitUserData(udg_Portal_portal[udg_Portal_INDEX_TRAVELLER])]), GetRandomDirectionDeg())
                call SetUnitPositionLoc(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], udg_Portal_loc3)
                call UnitApplyTimedLifeBJ(0.01, 'BTLF', udg_Portal_traveller)
                call GroupRemoveUnitSimple(udg_Portal_traveller, udg_Portal_teleMissiles)
                call GroupRemoveUnitSimple(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], udg_Portal_group)
                call AddSpecialEffectLocBJ(udg_Portal_loc3, udg_Portal_arrivalFX[GetUnitUserData(udg_Portal_portal[udg_Portal_INDEX_TRAVELLER])])
                call DestroyEffectBJ(GetLastCreatedEffectBJ())
                set udg_Portal_loc4=GetUnitRallyPoint(udg_Portal_portal[udg_Portal_INDEX_TRAVELLER])
                call IssuePointOrderLocBJ(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], "attack", udg_Portal_loc4)
                call RemoveLocation(udg_Portal_loc4)
                call RemoveLocation(udg_Portal_loc3)
                if ( Trig_Portal_Periodic_Func002Func007Func003Func002Func013C() ) then
                    call SelectUnitAddForPlayer(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], GetOwningPlayer(udg_Portal_traveller))
                else
                endif
            else
                if ( Trig_Portal_Periodic_Func002Func007Func003Func002Func014C() ) then
                    set udg_Portal_loc3=PolarProjectionBJ(udg_Portal_loc1, ( udg_Portal_missileSpeed[udg_Portal_INDEX_TRAVELLER] / 33.00 ), AngleBetweenPoints(udg_Portal_loc1, udg_Portal_loc2))
                    call SetUnitPositionLocFacingLocBJ(udg_Portal_traveller, udg_Portal_loc3, udg_Portal_loc2)
                    call RemoveLocation(udg_Portal_loc3)
                else
                    call UnitApplyTimedLifeBJ(0.01, 'BTLF', udg_Portal_traveller)
                endif
            endif
        else
            if ( Trig_Portal_Periodic_Func002Func007Func003Func001C() ) then
                call ShowUnitShow(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER])
                call SetUnitPositionLoc(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], udg_Portal_loc1)
                call UnitApplyTimedLifeBJ(0.01, 'BTLF', udg_Portal_traveller)
                call GroupRemoveUnitSimple(udg_Portal_traveller, udg_Portal_teleMissiles)
                call GroupRemoveUnitSimple(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], udg_Portal_group)
                call AddSpecialEffectLocBJ(udg_Portal_loc1, udg_Portal_arrivalFX[udg_Portal_INDEX_TARGET])
                call DestroyEffectBJ(GetLastCreatedEffectBJ())
                set udg_Portal_loc4=GetUnitRallyPoint(udg_Portal_portal[udg_Portal_INDEX_TRAVELLER])
                call IssuePointOrderLocBJ(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], "attack", udg_Portal_loc4)
                call RemoveLocation(udg_Portal_loc4)
                if ( Trig_Portal_Periodic_Func002Func007Func003Func001Func012C() ) then
                    call SelectUnitAddForPlayer(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], GetOwningPlayer(udg_Portal_traveller))
                else
                endif
            else
                if ( Trig_Portal_Periodic_Func002Func007Func003Func001Func001C() ) then
                else
                    call UnitApplyTimedLifeBJ(0.01, 'BTLF', udg_Portal_traveller)
                endif
            endif
        endif
        call RemoveLocation(udg_Portal_loc2)
        call RemoveLocation(udg_Portal_loc1)
    else
        call ShowUnitShow(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER])
        set udg_Portal_loc1=GetUnitLoc(udg_Portal_traveller)
        call SetUnitPositionLoc(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], udg_Portal_loc1)
        call RemoveLocation(udg_Portal_loc1)
        call SetUnitFlyHeightBJ(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], GetUnitFlyHeight(udg_Portal_traveller), 0.00)
        call ExplodeUnitBJ(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER])
        call GroupRemoveUnitSimple(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], udg_Portal_group)
        call GroupRemoveUnitSimple(udg_Portal_traveller, udg_Portal_teleMissiles)
        call UnitRemoveAbilityBJ(udg_Portal_delayFXAbil[udg_Portal_INDEX_TRAVELLER], udg_Portal_traveller)
        if ( Trig_Portal_Periodic_Func002Func007Func015C() ) then
            call SelectUnitAddForPlayer(udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER], GetOwningPlayer(udg_Portal_traveller))
        else
        endif
    endif
endfunction

function Trig_Portal_Periodic_Func003C takes nothing returns boolean
    if ( not ( IsUnitGroupEmptyBJ(udg_Portal_group) == true ) ) then
        return false
    endif
    if ( not ( IsUnitGroupEmptyBJ(udg_Portal_teleMissiles) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Periodic_Actions takes nothing returns nothing
    call ForGroupBJ(udg_Portal_group, function Trig_Portal_Periodic_Func001A)
    call ForGroupBJ(udg_Portal_teleMissiles, function Trig_Portal_Periodic_Func002A)
    if ( Trig_Portal_Periodic_Func003C() ) then
        call DisableTrigger(GetTriggeringTrigger())
    else
    endif
endfunction

