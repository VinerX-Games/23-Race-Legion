function HaveCapitalAbility takes nothing returns boolean
    return GetUnitAbilityLevel(GetFilterUnit(), 'A0IQ') != 0 and UnitAlive(GetFilterUnit())
endfunction

function Capitals takes nothing returns boolean
    return IsUnitInGroup(GetFilterUnit(), udg_StolicaGroups)
endfunction



function Trig_MakeStolica_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0IQ'
endfunction

function unitShareVisionAll takes unit u,boolean flag returns nothing
    local integer i= 0
    loop
        exitwhen i > 23
        call UnitShareVision(u, Player(i), flag)
        set i=i + 1
    endloop
endfunction


function checkMovingCity takes unit u returns nothing
    local real x= GetUnitX(u)
    local real y= GetUnitY(u)
    
    if RectContainsCoords(gg_rct_Naxramas, x, y) then
        call unitShareVisionAll(gg_unit_e00D_0080 , true)
    elseif RectContainsCoords(gg_rct_KillDalaran, x, y) then
        call unitShareVisionAll(gg_unit_e00C_0590 , true)
    elseif RectContainsCoords(gg_rct_TurtleIsland, x, y) then
        call unitShareVisionAll(gg_unit_e00E_0085 , true)
    endif
    
    
endfunction




function MakeCapital takes unit capital returns nothing
    call UnitSetConstructionProgress(capital, 100)
    call BlzSetUnitMaxHP(capital, 10000)
    call SetUnitLifeBJ(capital, 10000.00)
    call BlzSetUnitRealFieldBJ(capital, UNIT_RF_SIGHT_RADIUS, 750.00)
    call BlzSetUnitArmor(capital, 30.00)
    call UnitAddAbility(capital, 'A0I6')
    call UnitAddAbility(capital, 'A145')
    call BlzSetUnitStringFieldBJ(capital, UNIT_SF_NAME, ( "|cffd45e19Столица:|r " + GetUnitName(capital) ))
    call GroupAddUnit(udg_StolicaGroups, capital)
    call TriggerRegisterUnitEvent(gg_trg_StolicaAttacked, capital, EVENT_UNIT_ATTACKED)
    call unitShareVisionAll(capital , true)
    call checkMovingCity(capital)
    set playerCapital[GetPlayerId(GetOwningPlayer(capital))]=capital
endfunction

function MakeFakeCapital takes player p returns nothing
    local unit u
    call GroupEnumUnitsOfPlayer(gGroup, p, Condition(function HaveCapitalAbility))
    set u=BlzGroupUnitAt(gGroup, GetRandomInt(0, BlzGroupGetSize(gGroup) - 1))
    set playerCapital[GetPlayerId(p)]=u
    call aiCapitalEnter(u)
    set u=null
    call GroupClear(gGroup)
endfunction


function Trig_MakeStolica_Actions takes nothing returns nothing
    call SetPlayerAbilityAvailableBJ(false, 'A0IQ', GetOwningPlayer(GetTriggerUnit()))
    call MakeCapital(GetTriggerUnit())
    
endfunction

