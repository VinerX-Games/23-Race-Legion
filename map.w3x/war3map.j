//===========================================================================
// Trigger: LichinkaFinish
//
// Триггер срабатывает, когда личинка заканчивает свое превращение в юнита. Переведен в код, слегка обработан, но трубут доработки
//===========================================================================
function Trig_LichinkaFinish_Conditions takes nothing returns boolean
    set gTriggerUnit=GetTriggerUnit()
    set gPlayer=GetOwningPlayer(gTriggerUnit)
    return GetUnitAbilityLevel(gTriggerUnit, 'A1JE') > 0
endfunction


function OrderAfterUleyFinish takes nothing returns nothing
    local location l= GetUnitRallyPoint(GetEnumUnit())
    set udg_LocalPosition[17]=l
    if GetUnitTypeId(gTriggerUnit) == 'e01G' then
        call IssueTargetOrder(gTriggerUnit, "harvest", GetUnitRallyDestructable(GetEnumUnit()))
    else
        call IssuePointOrderLoc(gTriggerUnit, "attack", l)
    endif
    set l=null
endfunction

function ItIsHive takes nothing returns boolean
    local integer id= GetUnitTypeId(GetFilterUnit())
    return id == 'e01H' or id == 'e020' or id == 'e021'
endfunction

function Trig_LichinkaFinish_Actions takes nothing returns nothing
    local integer i= GetPlayerId(gPlayer)
    //local unit u = gTriggerUnit 
    local integer id= GetUnitTypeId(gTriggerUnit)
    local effect e
    
    
    //Блок врубай таймер
    local integer oldid= GetHandleId(gTriggerUnit)
    local unit u2= LoadUnitHandle(Hash, oldid, 1)
    local integer id2= GetHandleId(u2)
    local integer currentCount= LoadInteger(Hash, id2, 1) - 1
    local timer t
    call FlushChildHashtable(Hash, oldid)
    
    call SaveInteger(Hash, id2, 1, currentCount)
    
    
    if UnitAlive(u2) and currentCount < 3 and not LoadBoolean(Hash, oldid, 1) then
        set t=CreateTimer()
        call TimerStart(t, 25, true, function spawnlich)
        call SaveUnitHandle(Hash, GetHandleId(t), 1, u2)
        call SaveBoolean(Hash, id2, 1, true)
    endif
    set t=null
    set u2=null
    
    
    
    //local real x = GetUnitX(gPlayer)
    //local real y = GetUnitY(u)
    // хз откуда 2, уже все забыл))) и баг пофиксил без понимания.
    
    
    //Кейс если кансел
//    if GetUnitTypeId(u) == 'e01I' then
//
//    endif
    
    //Тк была личинка, она улучшилась, а не вошла на карту, значит надо вот это уже посчитать
    call AddCountDis(gTriggerUnit , i)
    
    set udg_LocalPosition[16]=GetUnitLoc(gTriggerUnit)
    set udg_Boolexpr=Condition(function ItIsHive)
    set udg_LocalOtrad2=CreateGroup()
    call GroupEnumUnitsInRangeOfLoc(udg_LocalOtrad2, udg_LocalPosition[16], 300, udg_Boolexpr)
    // Куда идти если рядом есть улей
    call ForGroup(udg_LocalOtrad2, function OrderAfterUleyFinish)
    call GroupClear(udg_LocalOtrad2)
    call SetUnitLifePercentBJ(gTriggerUnit, 100)

    
    
    set e=LoadEffectHandle(Hash, oldid * 10, StringHash("Cocon"))
    call BlzPlaySpecialEffect(e, ANIM_TYPE_DEATH)
    call RemoveEffectTimed(e , 1.5)
    call FlushChildHashtable(Hash, oldid * 10)
    
    
    
    
    
    // Трутень
    // ----
    if id == 'e01G' then
        
        call CreateNUnitsAtLoc(1, 'e01G', gPlayer, udg_LocalPosition[16], bj_UNIT_FACING)
        set udg_LocalPosition[18]=GetUnitLoc(GetLastCreatedUnit())
        set udg_Boolexpr=Condition(function ItIsHive)
        call GroupEnumUnitsInRangeOfLoc(udg_LocalOtrad2, udg_LocalPosition[18], 300, udg_Boolexpr)
        
        call IssueTargetDestructableOrder(GetLastCreatedUnit(), "harvest", GetUnitRallyDestructable(FirstOfGroup(udg_LocalOtrad2)))
        set udg_LocalPosition[17]=GetUnitLoc(GetLastCreatedUnit())
        set udg_Boolexpr=Condition(function ItIsHive)
        call GroupEnumUnitsInRangeOfLoc(udg_LocalOtrad2, udg_LocalPosition[17], 300, udg_Boolexpr)
        if IsUnitSelected(gTriggerUnit, GetOwningPlayer(gTriggerUnit)) then
            call SelectUnitAddForPlayer(GetLastCreatedUnit(), gPlayer)
        else
        endif
    
    
    
    
    
    // Слизень
    // ----
    elseif id == 'e01Z' then
        call UnitAddAbilityBJ('A0VH', gTriggerUnit)
        
        
        call CreateNUnitsAtLoc(1, 'e01Z', gPlayer, udg_LocalPosition[16], bj_UNIT_FACING)
        call UnitAddAbilityBJ('A0VH', GetLastCreatedUnit())
        
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_LocalPosition[17])
        if IsUnitSelected(gTriggerUnit, GetOwningPlayer(gTriggerUnit)) then
            call SelectUnitAddForPlayer(GetLastCreatedUnit(), gPlayer)
        else
        endif
    
    
    
    
    // Солдат т1
    // ----
    elseif id == 'e02W' then
        call CreateNUnitsAtLoc(1, 'e02W', gPlayer, udg_LocalPosition[16], bj_UNIT_FACING)
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_LocalPosition[17])
        
        
        
        // Выбор
        if IsUnitSelected(gTriggerUnit, GetOwningPlayer(gTriggerUnit)) then
            call SelectUnitAddForPlayer(GetLastCreatedUnit(), gPlayer)
        endif
        
        
        
        // Плодовитость
        if GetPlayerTechCountSimple('R089', GetOwningPlayer(gTriggerUnit)) == 1 then
            call SetUnitAbilityLevelSwapped('A0VH', GetLastCreatedUnit(), 2)
            call SetUnitAbilityLevelSwapped('A0VH', gTriggerUnit, 2)
            
            call CreateNUnitsAtLoc(1, 'e02W', gPlayer, udg_LocalPosition[16], bj_UNIT_FACING)
            call SetUnitAbilityLevelSwapped('A0VH', GetLastCreatedUnit(), 2)
            call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_LocalPosition[17])
            if IsUnitSelected(gTriggerUnit, GetOwningPlayer(gTriggerUnit)) then
                call SelectUnitAddForPlayer(GetLastCreatedUnit(), gPlayer)
            
            endif
        
            
        endif
        
       
   
    
    
    // ----
    // Оса
    elseif id == 'e01Q' and GetPlayerTechCountSimple('R08B', GetOwningPlayer(gTriggerUnit)) == 1 then
        call CreateNUnitsAtLoc(1, 'e01Q', gPlayer, udg_LocalPosition[16], bj_UNIT_FACING)
        call UnitAddAbilityBJ('A0VH', gTriggerUnit)
        call UnitAddAbilityBJ('A0VH', GetLastCreatedUnit())
        
        call IssuePointOrderLocBJ(GetLastCreatedUnit(), "attack", udg_LocalPosition[17])
        if IsUnitSelected(gTriggerUnit, GetOwningPlayer(gTriggerUnit)) then
            call SelectUnitAddForPlayer(GetLastCreatedUnit(), gPlayer)
        else
        endif
    
    
    //Паук страж и его паразит 
    elseif id == 'e01U' then
        
        call IssueImmediateOrder(gTriggerUnit, "parasiteon")
    //Мана пророку
    elseif id == 'e01T' then
        
        call SetUnitManaBJ(gTriggerUnit, 125)
        call BlzStartUnitAbilityCooldown(gTriggerUnit, 'A1KG', 50)
    
    endif
    
    
    // ----
    // ----
    call GroupClear(udg_LocalOtrad2)
    call RemoveLocation(udg_LocalPosition[16])
    call RemoveLocation(udg_LocalPosition[17])
    call RemoveLocation(udg_LocalPosition[18])

    set e=null
endfunction

//===========================================================================
function InitTrig_LichinkaFinish takes nothing returns nothing
    set gg_trg_LichinkaFinish=CreateTrigger()
    call DisableTrigger(gg_trg_LichinkaFinish)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_LichinkaFinish, EVENT_PLAYER_UNIT_UPGRADE_FINISH)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_LichinkaFinish, EVENT_PLAYER_UNIT_UPGRADE_CANCEL)
    call TriggerAddCondition(gg_trg_LichinkaFinish, Condition(function Trig_LichinkaFinish_Conditions))
    call TriggerAddAction(gg_trg_LichinkaFinish, function Trig_LichinkaFinish_Actions)
endfunction


