    set udg_MellLord=GetUnitsInRangeOfLocMatching(700.00, GetSpellTargetLoc(), Condition(function Trig_LordWave_Func002002003))
    call GroupAddGroup(udg_MellLord, udg_AllLords)
    call ForGroupBJ(udg_AllLords, function Trig_LordWave_Func004A)
    call TriggerSleepAction(6.00)
    set udg_AllLords=GetUnitsOfPlayerAndTypeId(GetTriggerPlayer(), 'lord')
    set udg_MellLord=GetUnitsOfPlayerAndTypeId(GetTriggerPlayer(), 'nq01')
    call GroupAddGroup(udg_MellLord, udg_AllLords)
