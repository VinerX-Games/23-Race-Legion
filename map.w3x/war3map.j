//*  RemoveAbilityTimed
function RemoveTimedAbilityAct takes nothing returns nothing
    
    local timer t= GetExpiredTimer()
    local integer id= GetHandleId(t)
    call UnitRemoveAbility(LoadUnitHandle(Hash, id, 1), LoadInteger(Hash, id, 2))
    call FlushChildHashtable(Hash, id)
    call DestroyTimer(t)
    set t=null

endfunction


function RemoveAbilityTimed takes unit u,integer abilid,real time returns nothing
    local timer t= CreateTimer()
    local integer id= GetHandleId(t)
    call TimerStart(t, time, false, function RemoveTimedAbilityAct)
    call SaveUnitHandle(Hash, id, 1, u)
    call SaveInteger(Hash, id, 2, abilid)
    set u=null
    set t=null
endfunction


function AddTimedAbilityAct takes nothing returns nothing
    
    local timer t= GetExpiredTimer()
    local integer id= GetHandleId(t)
    call UnitAddAbility(LoadUnitHandle(Hash, id, 1), LoadInteger(Hash, id, 2))
    call FlushChildHashtable(Hash, id)
    call DestroyTimer(t)
    set t=null

endfunction


function AddAbilityTimed takes unit u,integer abilid,real time returns nothing
    local timer t= CreateTimer()
    local integer id= GetHandleId(t)
    call TimerStart(t, time, false, function AddTimedAbilityAct)
    call SaveUnitHandle(Hash, id, 1, u)
    call SaveInteger(Hash, id, 2, abilid)
    set u=null
    set t=null
endfunction





function RemoveTimedAbilityActCD takes nothing returns nothing
    
    local timer t= GetExpiredTimer()
    local integer id= GetHandleId(t)
    local integer aid= LoadInteger(Hash, id, 2)
    local unit u= LoadUnitHandle(Hash, id, 1)
    if BlzGetUnitAbilityCooldownRemaining(u, aid) == 0 then
        call UnitRemoveAbility(u, aid)
    endif
    
    call FlushChildHashtable(Hash, id)
    call DestroyTimer(t)
    set t=null
    set u=null

endfunction

function RemoveAbilityTimedCD takes unit u,integer abilid,real time returns nothing
    local timer t= CreateTimer()
    local integer id= GetHandleId(t)
    call TimerStart(t, time, false, function RemoveTimedAbilityActCD)
    call SaveUnitHandle(Hash, id, 1, u)
    call SaveInteger(Hash, id, 2, abilid)
    set u=null
    set t=null
endfunction
