// Trigger: TechLoopedCancel
//===========================================================================
function Trig_TechLoopedCancel_Actions takes nothing returns nothing
    set udg_TechId=GetResearched()
endfunction

//===========================================================================
function InitTrig_TechLoopedCancel takes nothing returns nothing
    set gg_trg_TechLoopedCancel=CreateTrigger()
    call DisableTrigger(gg_trg_TechLoopedCancel)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_TechLoopedCancel, EVENT_PLAYER_UNIT_RESEARCH_CANCEL)
    call TriggerAddAction(gg_trg_TechLoopedCancel, function Trig_TechLoopedCancel_Actions)
endfunction

//===========================================================================
// Trigger: TechFinish
//===========================================================================
function Trig_TechFinish_Func001C takes nothing returns boolean
    if ( ( GetResearched() == 'R09C' ) ) then
        return true
    endif
    if ( ( GetResearched() == 'R09D' ) ) then
        return true
    endif
    if ( ( GetResearched() == 'R09E' ) ) then
        return true
    endif
    if ( ( GetResearched() == 'R09F' ) ) then
        return true
    endif
    return false
endfunction

function Trig_TechFinish_Conditions takes nothing returns boolean
    if ( not Trig_TechFinish_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_TechFinish_Func003C takes nothing returns boolean
    if ( not ( udg_TechResearched[GetConvertedPlayerId(GetTriggerPlayer())] == udg_MAX_TECH_RESEARCHES ) ) then
        return false
    endif
    return true
endfunction

function Trig_TechFinish_Actions takes nothing returns nothing
    set udg_TechResearched[GetConvertedPlayerId(GetTriggerPlayer())]=( udg_TechResearched[GetConvertedPlayerId(GetTriggerPlayer())] + 1 )
    if ( Trig_TechFinish_Func003C() ) then
        call SetPlayerTechMaxAllowedSwap('R09C', 0, GetTriggerPlayer())
        call SetPlayerTechMaxAllowedSwap('R09D', 0, GetTriggerPlayer())
        call SetPlayerTechMaxAllowedSwap('R09E', 0, GetTriggerPlayer())
        call SetPlayerTechMaxAllowedSwap('R09F', 0, GetTriggerPlayer())
    else
    endif
endfunction

//===========================================================================
function InitTrig_TechFinish takes nothing returns nothing
    set gg_trg_TechFinish=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_TechFinish, EVENT_PLAYER_UNIT_RESEARCH_FINISH)
    call TriggerAddCondition(gg_trg_TechFinish, Condition(function Trig_TechFinish_Conditions))
    call TriggerAddAction(gg_trg_TechFinish, function Trig_TechFinish_Actions)
endfunction

