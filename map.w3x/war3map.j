//===========================================================================
// Trigger: PerebobNavy
//===========================================================================
function PlayerNavy takes nothing returns nothing
    local group l__gGroup= CreateGroup()
    local player p= null
    local unit u
    local integer id
    local integer i
    local integer i2

    //Локалки
    
    //Каждый отдельный игрок
    //Узнаю номер игрока
    
    if CountPlayersInForceBJ(udg_BotsActiveB) == 0 then
        call PauseTimer(udg_PlayerGet4)
        call ResumeTimer(udg_TimerSmall4)
        call TimerStart(udg_TimerSmall4, 7 * AiRepeat / 5, false, null)
        if udg_Octhet then
            call DisplayTimedTextFromPlayer(Player(0), 0, 0, 4, "Заканчиваю перебор игроков для флота")
        endif
    else
        
        set p=ForcePickRandomPlayer(udg_BotsActiveB)
        //call BJDebugMsg("Игрок флота"+GetPlayerName(p))
        call ForceRemovePlayer(udg_BotsActiveB, p)
        
        
        set CheckPlayer=p
        set LazyCount=0
        call GroupEnumUnitsOfPlayer(l__gGroup, p, B_LazyN)
        //call BJDebugMsg("Колво флота без приказа: "+I2S(LazyCount))
        if FirstOfGroup(l__gGroup) != null then
            //call BJDebugMsg("Первый не пуст: "+I2S(LazyCount))
            
            set i=1
            loop
                set u=BlzGroupUnitAt(l__gGroup, GetRandomInt(0, LazyCount))
                exitwhen i > AiMass or u == null
                
                set id=GetUnitTypeId(u)
                call GroupRemoveUnit(l__gGroup, u)
                set LazyCount=LazyCount - 1
                set i=i + 1

                //if id=='h00Y' or id=='h00Z' or id == 'h06W'  or id == 'h0DM'  or id == 'h06V' or id == 'h06X' or id == 'n079' then
                    set udg_LocalUnit3=u
                    call ExecuteFunc("TryAttackN")
                //endif
            endloop
        endif
        
    endif

    set u=null
endfunction
