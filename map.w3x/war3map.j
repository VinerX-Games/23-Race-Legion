// Для работа надо номер игрока, ид юнита
function NumberAdd takes integer Playerid,integer Unitid returns nothing
    local integer Cunit= LoadInteger(AiData, Playerid, Unitid) + 1
    call SaveInteger(AiData, Playerid, Unitid, Cunit)
endfunction

function NumberRem takes integer Playerid,integer Unitid returns nothing
    local integer Cunit= LoadInteger(AiData, Playerid, Unitid) - 1
    call SaveInteger(AiData, Playerid, Unitid, Cunit)
endfunction



