//===========================================================================
// Trigger: NagaStart
//===========================================================================
function NagaStartLimits_act takes nothing returns nothing
    call SetPlayerTechMaxAllowedSwap('n054', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('n053', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('n052', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('n050', 0, GetEnumPlayer())
    
    call SetPlayerTechMaxAllowedSwap('n051', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('n057', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('nnsw', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('nmyr', 0, GetEnumPlayer())
    call SetPlayerTechMaxAllowedSwap('nnrg', 0, GetEnumPlayer())
    
     call SetPlayerTechMaxAllowedSwap('N07A', 1, GetEnumPlayer())
     
     call SetPlayerTechMaxAllowedSwap('H0OZ', 0, GetEnumPlayer())
     call SetPlayerTechMaxAllowedSwap('H0JU', 0, GetEnumPlayer()) //HERO
    call SetPlayerTechMaxAllowedSwap('H0JV', 1, GetEnumPlayer())
 
    //Murloc Grades
    call SetPlayerTechMaxAllowedSwap('R0FQ', 0, GetEnumPlayer())
    
endfunction

function NagaStartLimits takes nothing returns nothing
    call ForForce(udg_AllPlayers, function NagaStartLimits_act)
    call ForForce(udg_Bots, function NagaStartLimits_act)
endfunction

function Trig_NagaStart_Actions takes nothing returns nothing
    call NagaStartLimits()
endfunction

