// Trigger: Upgrade Lumber
//===========================================================================
function Trig_Upgrade_Lumber_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0B1' and IsUnitSelected(GetTriggerUnit(), GetOwningPlayer(GetTriggerUnit()))
endfunction



function Trig_Upgrade_Lumber_Actions takes nothing returns nothing
    local integer levels= 4
    local integer pi= GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
    set incomeW[pi]=incomeW[pi] + 50.00
    if GetUnitAbilityLevel(GetTriggerUnit(), 'A1N9') > 0 then
        set levels=levels - 2
    endif
    
    if GetUnitAbilityLevel(GetTriggerUnit(), 'A0B5') == 0 then
        call UnitAddAbility(GetTriggerUnit(), 'A0B5')
        
        return
    
    endif
    
    call IncUnitAbilityLevel(GetTriggerUnit(), 'A0B5')
    
    if GetUnitAbilityLevel(GetTriggerUnit(), 'A0B5') >= levels then
        call UnitRemoveAbility(GetTriggerUnit(), 'A0B1')
    endif

     

endfunction

