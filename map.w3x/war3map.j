//===========================================================================
// Trigger: GeneralRegen
//===========================================================================
function Trig_GeneralRegen_Conditions takes nothing returns boolean
    if ( not ( GetLearnedSkillBJ() == 'A0Y8' ) ) then
        return false
    endif
    return true
endfunction

function Trig_GeneralRegen_Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0Y8', GetTriggerUnit()) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_GeneralRegen_Actions takes nothing returns nothing
    if ( Trig_GeneralRegen_Func001C() ) then
        call UnitAddAbilityBJ('A104', GetTriggerUnit())
        call SetUnitAbilityLevelSwapped('A104', GetTriggerUnit(), GetUnitAbilityLevelSwapped('A0Y8', GetTriggerUnit()))
    else
        call SetUnitAbilityLevelSwapped('A104', GetTriggerUnit(), GetUnitAbilityLevelSwapped('A0Y8', GetTriggerUnit()))
    endif
endfunction

