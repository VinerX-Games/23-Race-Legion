    return GetUnitCurrentOrder(GetFilterUnit()) != OrderId("harvest") and not IsUnitType(GetFilterUnit(), UNIT_TYPE_PEON) and GetUnitTypeId(GetFilterUnit()) != 'h07A' and GetOwningPlayer(GetFilterUnit()) == udg_LocalPlayer

endfunction



