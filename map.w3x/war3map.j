            call CreateNUnitsAtLoc(1, 'mim1', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING)
            call SetUnitAnimation(GetLastCreatedUnit(), "birth")
            call UnitRemoveAbilityBJ('MIM4', GetTriggerUnit())
