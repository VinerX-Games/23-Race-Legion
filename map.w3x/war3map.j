//===========================================================================
// Trigger: CircleMove Code
//===========================================================================
function Trig_CircleMove_Code_Conditions takes nothing returns boolean
    return BlzGetTriggerPlayerMouseButton() == MOUSE_BUTTON_TYPE_RIGHT
endfunction

function Trig_CircleMove_Code_Actions takes nothing returns nothing
    local group g= CreateGroup()
    local unit u
    set udg_LocCircle=BlzGetTriggerPlayerMousePosition()
    if not ( IsTerrainPathableBJ(udg_LocCircle, PATHING_TYPE_WALKABILITY) or RectContainsLoc(gg_rct_HostRegion, udg_LocCircle) ) then
        
        set bj_groupEnumTypeId='h0HJ'
        call GroupEnumUnitsOfPlayer(g, GetTriggerPlayer(), filterGetUnitsOfPlayerAndTypeId)
        loop
            set u=FirstOfGroup(g)
            exitwhen u == null
            call SetUnitPositionLoc(u, udg_LocCircle)
            call GroupRemoveUnit(g, u)
        endloop
                
    
    endif
    call RemoveLocation(udg_LocCircle)
    call GroupClear(g)
    call DestroyGroup(g)
    set u=null
    set g=null
endfunction

