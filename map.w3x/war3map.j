    call SetPlayerTechMaxAllowedSwap('R0G6', 0, GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerTechMaxAllowedSwap('R0G7', 0, GetOwningPlayer(GetTriggerUnit()))
