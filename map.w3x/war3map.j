    set gg_trg_Portal_Target=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Portal_Target, EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
    call TriggerAddCondition(gg_trg_Portal_Target, Condition(function Trig_Portal_Target_Conditions))
