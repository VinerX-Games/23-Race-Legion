// --------------    --------------   Фильтры старт --------------   --------------



//  --------------    Функции для фильтров     --------------
function f_EnemyUnitP takes nothing returns boolean
    local unit u= GetFilterUnit()
    local player p= GetOwningPlayer(u)
    if IsPlayerEnemy(p, CheckPlayer) or WaygateIsActive(u) and not IsUnitInGroup(u, Navy) then
        set u=null
        return true
    else
        set u=null
        return false
    endif
endfunction

function f_EnemyUnit takes nothing returns boolean
    return IsPlayerEnemy(GetOwningPlayer(GetFilterUnit()), CheckPlayer) and not ( WaygateIsActive(GetFilterUnit()) or IsUnitInGroup(GetFilterUnit(), Navy) )
endfunction

function f_EnemyUnitN takes nothing returns boolean
    local unit u= GetFilterUnit()
    local integer i= GetUnitTypeId(u)
    local player p= GetOwningPlayer(u)
    local real x= GetUnitX(u)
    local real y= GetUnitY(u)
    
    if IsPlayerEnemy(p, CheckPlayer) and ( IsUnitInGroup(u, udg_CityNearWater) or IsUnitInGroup(u, Navy) or IsUnitInGroup(u, Port) ) and not RectContainsCoords(gg_rct_NoWater1, x, y) and not RectContainsCoords(gg_rct_NoWater2, x, y) and not RectContainsCoords(gg_rct_NoWater3, x, y) then
        set u=null
        return true
    else
        set u=null
        return false
    endif
    
    
endfunction

