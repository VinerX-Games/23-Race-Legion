function PereborBuildings2_BloodElves takes integer id,integer pi,unit u returns nothing
    local integer b= 0
    local integer i= 0
    local integer array a
        if id == 'h04D' then //Казармы
    

            set a[0]=1 //Кол-во вариантов со старта
            set a[1]='h03V' // 1 Пехотинец

            // Доп. варианты при условиях

            // 2 Лучница
            if LoadInteger(AiData, pi, 'h04R') >= 1 then
                set i=1 //мошь выбора
                set b=1
                
                loop
                    set a[0]=a[0] + 1
                    set a[a[0]]='n00I'
                    
                    set b=b + 1
                    exitwhen b >= i
                endloop
            endif
            
            // 3 Всадник
            if LoadInteger(AiData, pi, 'h04B') + LoadInteger(AiData, pi, 'h04A') >= 1 then
                set i=4 //мошь выбора
                set b=1
                
                loop
                    set a[0]=a[0] + 1
                    set a[a[0]]='h03X'
                    set b=b + 1
                    exitwhen b >= i
                endloop
            endif
            
            // 4 Рыцарь крови
            if LoadInteger(AiData, pi, 'h04A') >= 1 then
                set i=6 //мошь выбора
                set b=1
                
                loop
                    set a[0]=a[0] + 1
                    set a[a[0]]='h03Y'
                    set b=b + 1
                    exitwhen b >= i
                endloop
            endif
            set i=GetRandomInt(1, a[0])
            call IssueImmediateOrderById(u, a[i])
            

            // Ратуша
        elseif id == 'h04C' then
             
                
                //Строитель
                if LoadInteger(AiData, pi, 'h04K') < 20 then
                    call IssueImmediateOrderById(u, 'h04K')
                endif
            
            // Мастеская
            
        elseif id == 'h04G' then
            set a[0]=0 //Кол-во вариантов со старта
            
            
            // Доп. варианты при условиях
            //Баллиста
            if LoadInteger(AiData, pi, 'h04B') + LoadInteger(AiData, pi, 'h04A') >= 1 then
                set i=1 //мошь выбора
                set b=1
                
                loop
                    set a[0]=a[0] + 1
                    set a[a[0]]='e001'
                    
                    set b=b + 1
                    exitwhen b >= i
                endloop
            endif

            

            // 2 Элем
            if LoadInteger(AiData, pi, 'h04B') + LoadInteger(AiData, pi, 'h04A') >= 1 then
                set i=2 //мошь выбора
                set b=1
                
                loop
                    set a[0]=a[0] + 1
                    set a[a[0]]='h046'
                    
                    set b=b + 1
                    exitwhen b >= i
                endloop
            endif
            
            // 3 Повозка
            if LoadInteger(AiData, pi, 'h04B') + LoadInteger(AiData, pi, 'h04A') >= 1 then
                set i=1 //мошь выбора
                set b=1
                
                loop
                    set a[0]=a[0] + 1
                    set a[a[0]]='e030'
                    set b=b + 1
                    exitwhen b >= i
                endloop
            endif
            
            // 4 Голем
            if LoadInteger(AiData, pi, 'h04A') >= 1 then
                set i=6 //мошь выбора
                set b=1
                
                loop
                    set a[0]=a[0] + 1
                    set a[a[0]]='h03Z'
                    set b=b + 1
                    exitwhen b >= i
                endloop
            endif
            set i=GetRandomInt(1, a[0])
            call IssueImmediateOrderById(u, a[i])
                   

            
//            // Верфь
//        elseif id== 'h011' then
//                set udg_LocalInteger3 = GetRandomInt(2, 3)  
//                if udg_LocalInteger3 == 1 and LoadInteger(AiData,pi,'h00X')< 10 then 
//                    call IssueImmediateOrderById( u, 'h00X' )      
//                elseif udg_LocalInteger3 == 2 and LoadInteger(AiData,pi,'h00Y') < 50 then 
//                    call IssueImmediateOrderById( u, 'h00Y' )      
//                elseif udg_LocalInteger3 == 3 and LoadInteger(AiData,pi,'h00Z') < 75 then 
//                    call IssueImmediateOrderById( u, 'h00Z' )        
//                endif
//           
           // Волшебное святилище
        elseif id == 'h04E' then
                set udg_LocalInteger3=GetRandomInt(1, 4)
                if udg_LocalInteger3 == 1 then
                    call IssueImmediateOrderById(u, 'h03W')
                elseif udg_LocalInteger3 == 2 then
                    call IssueImmediateOrderById(u, 'h040')
                elseif udg_LocalInteger3 == 2 then
                    call IssueImmediateOrderById(u, 'h041')
                else
                    call IssueImmediateOrderById(u, 'h042')
                endif
            
          
          // Алтарь
        elseif id == 'h05J' then
                set udg_LocalInteger3=GetRandomInt(1, 3)
                if udg_LocalInteger3 == 1 then
                    call IssueImmediateOrderById(u, 'Hjnd')
                endif
                if udg_LocalInteger3 == 2 then
                    call IssueImmediateOrderById(u, 'H043')
