//===========================================================================
// Trigger: NoTpNearCapital
//===========================================================================
function Trig_NoTpNearCapital_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0IO'
endfunction

function CapitalOfEnemy takes nothing returns boolean
    return IsUnitInGroup(GetFilterUnit(), udg_StolicaGroups) and IsPlayerEnemy(GetOwningPlayer(GetFilterUnit()), udg_LocalPlayer)
endfunction


function Trig_NoTpNearCapital_Actions takes nothing returns nothing
    local group g= CreateGroup()
    local unit u= GetTriggerUnit()
   
    set udg_LocalPlayer=GetOwningPlayer(u)
    call GroupEnumUnitsInRange(g, GetUnitX(u), GetUnitY(u), 1350.00, Condition(function CapitalOfEnemy))

    if FirstOfGroup(g) != null then
        call IssueImmediateOrder(u, "stop")
        call DisplayTextToPlayer(GetOwningPlayer(u), 0, 0, "Ваш маг-тп слишком близко к столице, тп заблокировано")
    endif
    
    call DestroyGroup(g)
    set g=null
    set u=null
    
endfunction

