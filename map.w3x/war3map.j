function InitTrig_Pole_Astrala_Dragons_O takes nothing returns nothing
    set gg_trg_Pole_Astrala_Dragons_O=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Pole_Astrala_Dragons_O, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Pole_Astrala_Dragons_O, Condition(function Trig_Pole_Astrala_Dragons_O_Conditions))
