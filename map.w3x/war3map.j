//===========================================================================
// Trigger: ACounters
//===========================================================================
function AcountAll takes player p returns nothing
    call AT1Count(p)
    call AT2Count(p)

    call ACavCount(p)
    call AT3Count(p)
    
    call AK1Count(p)
    call AK2Count(p)
    call AK3Count(p)
    
    call AM1Count(p)
    call AM2Count(p)
    call AM3Count(p)
    
    call AE1Count(p)
    call AE2Count(p)
    
    call AN1Count(p)
    call AN2Count(p)
endfunction

//===========================================================================
// Trigger: OldAllianceForever
//===========================================================================
function Trig_OldAllianceForever_Conditions takes nothing returns boolean
    return GetResearched() == 'R0DW'
endfunction

function Trig_OldAllianceForever_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local player p= GetOwningPlayer(u)
    local integer pi= GetPlayerId(p)
    set udg_MainPrice[pi]=udg_MainPrice[pi] - 15
    
    //Запретил ветки
    call SetPlayerTechMaxAllowed(p, 'R0HS', 0)
    call SetPlayerTechMaxAllowed(p, 'R0HR', 0)
    call SetPlayerTechMaxAllowed(p, 'R0HQ', 0)
endfunction

//===========================================================================
function InitTrig_OldAllianceForever takes nothing returns nothing
    set gg_trg_OldAllianceForever=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_OldAllianceForever, EVENT_PLAYER_UNIT_RESEARCH_FINISH)
    call TriggerAddCondition(gg_trg_OldAllianceForever, Condition(function Trig_OldAllianceForever_Conditions))
    call TriggerAddAction(gg_trg_OldAllianceForever, function Trig_OldAllianceForever_Actions)
endfunction


//===========================================================================
// Trigger: BegEvery
//===========================================================================
function Trig_BegEvery_Func001C takes nothing returns boolean
    if ( ( GetResearched() == 'R0HS' ) ) then
        return true
    endif
    if ( ( GetResearched() == 'R0HR' ) ) then
        return true
    endif
    if ( ( GetResearched() == 'R0HQ' ) ) then
        return true
    endif
    return false
endfunction

function Trig_BegEvery_Conditions takes nothing returns boolean
    if ( not Trig_BegEvery_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_BegEvery_Actions takes nothing returns nothing
    call SetPlayerTechMaxAllowedSwap('R0GX', 0, GetOwningPlayer(GetTriggerUnit()))
endfunction

//===========================================================================
function InitTrig_BegEvery takes nothing returns nothing
    set gg_trg_BegEvery=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_BegEvery, EVENT_PLAYER_UNIT_RESEARCH_START)
    call TriggerAddCondition(gg_trg_BegEvery, Condition(function Trig_BegEvery_Conditions))
    call TriggerAddAction(gg_trg_BegEvery, function Trig_BegEvery_Actions)
endfunction

//===========================================================================
// Trigger: CanEvery
//===========================================================================
function Trig_CanEvery_Func001Func001C takes nothing returns boolean
    if ( not ( GetResearched() == 'R0HS' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R0HR', GetOwningPlayer(GetTriggerUnit())) == 0 ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R0HQ', GetOwningPlayer(GetTriggerUnit())) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_CanEvery_Func001Func002C takes nothing returns boolean
    if ( not ( GetResearched() == 'R0HR' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R0HS', GetOwningPlayer(GetTriggerUnit())) == 0 ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R0HQ', GetOwningPlayer(GetTriggerUnit())) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_CanEvery_Func001Func003C takes nothing returns boolean
    if ( not ( GetResearched() == 'R0HQ' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R0HS', GetOwningPlayer(GetTriggerUnit())) == 0 ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R0HR', GetOwningPlayer(GetTriggerUnit())) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_CanEvery_Func001C takes nothing returns boolean
    if ( Trig_CanEvery_Func001Func001C() ) then
        return true
    endif
    if ( Trig_CanEvery_Func001Func002C() ) then
        return true
    endif
    if ( Trig_CanEvery_Func001Func003C() ) then
        return true
    endif
    return false
endfunction

function Trig_CanEvery_Conditions takes nothing returns boolean
    if ( not Trig_CanEvery_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_CanEvery_Actions takes nothing returns nothing
    call SetPlayerTechMaxAllowedSwap('R0GX', 1, GetOwningPlayer(GetTriggerUnit()))
endfunction

//===========================================================================
function InitTrig_CanEvery takes nothing returns nothing
    set gg_trg_CanEvery=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_CanEvery, EVENT_PLAYER_UNIT_RESEARCH_CANCEL)
    call TriggerAddCondition(gg_trg_CanEvery, Condition(function Trig_CanEvery_Conditions))
    call TriggerAddAction(gg_trg_CanEvery, function Trig_CanEvery_Actions)
endfunction

