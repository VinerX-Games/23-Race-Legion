    return false
endfunction

function Trig_Samopodjog_Conditions takes nothing returns boolean
    if ( not Trig_Samopodjog_Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_Samopodjog_Func003C takes nothing returns boolean
    if ( not ( udg_LocalInteger <= ( 35 + ( - 5 * GetUnitAbilityLevelSwapped('A0AR', GetAttacker()) ) ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Samopodjog_Actions takes nothing returns nothing
    local texttag t
    set udg_LocalInteger=GetRandomInt(1, 100)
    if ( Trig_Samopodjog_Func003C() ) then
        call SetUnitLifeBJ(GetAttacker(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetAttacker()) - 7.00 ))
        call CreateTextTagUnitBJ("TRIGSTR_7899", GetAttacker(), - 20.00, 5.00, 100, 100, 100, 0.00)
        set udg_LocalText=GetLastCreatedTextTag()
        call SetTextTagPermanentBJ(udg_LocalText, false)
        call SetTextTagLifespanBJ(udg_LocalText, 2.00)
        call SetTextTagFadepointBJ(udg_LocalText, 2.00)
        call SetTextTagVelocityBJ(udg_LocalText, 75.00, 90)
        set t=udg_LocalText
        call TriggerSleepAction(2.00)
        set udg_LocalText=t
        call DestroyTextTagBJ(udg_LocalText)
        set t=null
    else
    endif
endfunction

//===========================================================================
function InitTrig_Samopodjog takes nothing returns nothing
    set gg_trg_Samopodjog=CreateTrigger()
    call DisableTrigger(gg_trg_Samopodjog)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Samopodjog, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(gg_trg_Samopodjog, Condition(function Trig_Samopodjog_Conditions))
    call TriggerAddAction(gg_trg_Samopodjog, function Trig_Samopodjog_Actions)
endfunction

