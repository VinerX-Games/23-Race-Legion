//===========================================================================
// Trigger: Arcana
//===========================================================================
function Trig_Arcana_Func009C takes nothing returns boolean
    if ( not ( GetResearched() == 'R01D' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R01D', GetOwningPlayer(GetTriggerUnit())) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Arcana_Conditions takes nothing returns boolean
    if ( not Trig_Arcana_Func009C() ) then
        return false
    endif
    return true
endfunction

function Trig_Arcana_Func002A takes nothing returns nothing
    call BlzSetUnitName(GetEnumUnit(), "|cff8080ffКолодец арканы|r")
endfunction

function Trig_Arcana_Actions takes nothing returns nothing
    set udg_LocalOtrad=GetUnitsOfPlayerAndTypeId(GetOwningPlayer(GetTriggerUnit()), 'h04F')
    call ForGroupBJ(udg_LocalOtrad, function Trig_Arcana_Func002A)
    call DestroyGroup(udg_LocalOtrad)
    call SetPlayerTechResearchedSwap('R01E', 1, GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerTechResearchedSwap('R01F', 1, GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerTechMaxAllowedSwap('R01G', 2, GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerTechMaxAllowedSwap('R01H', 2, GetOwningPlayer(GetTriggerUnit()))
    call SetPlayerTechMaxAllowedSwap('R01I', 2, GetOwningPlayer(GetTriggerUnit()))
endfunction

//===========================================================================
function InitTrig_Arcana takes nothing returns nothing
    set gg_trg_Arcana=CreateTrigger()
    call DisableTrigger(gg_trg_Arcana)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Arcana, EVENT_PLAYER_UNIT_RESEARCH_FINISH)
    call TriggerAddCondition(gg_trg_Arcana, Condition(function Trig_Arcana_Conditions))
    call TriggerAddAction(gg_trg_Arcana, function Trig_Arcana_Actions)
endfunction

