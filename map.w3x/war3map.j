//***************************************************************************
//*  StrategNaga
function Strateg_Naga_EC takes integer id returns nothing
        //Это ферма
        if id == 'nnfm' then
            set udg_LocalInteger3=udg_LocalInteger3 + 1
        //Это Т1
        elseif id == 'nntt' then
            set udg_LocalInteger3=udg_LocalInteger3 + 4
        //Это Т2
        elseif id == 'h0JX' then
            set udg_LocalInteger3=udg_LocalInteger3 + 6
        //Это Т3
        elseif id == 'h0JY' then
            set udg_LocalInteger3=udg_LocalInteger3 + 8
        endif
endfunction

function Strateg_Naga takes integer i,integer pi,player p returns nothing
    if Grades[pi] < 150 then
        
        // nnsg (второй набор)
        if i < 50 then
            call MakeGradeCheckCap(p , 'nntt' , 'R0FE' , 1)
            call MakeGradeCheckCap(p , 'nntt' , 'R0FF' , 1)
        endif
        
        if i > 17 then

            // h0JW
            call MakeGradeCheckCap(p , 'h0JW' , 'R0FD' , 6)
            call MakeGradeCheckCap(p , 'h0JW' , 'R0FH' , 6)
            call MakeGradeCheckCap(p , 'h0JW' , 'Rnat' , 6)
            call MakeGradeCheckCap(p , 'h0JW' , 'Rnam' , 6)
            call MakeGradeCheckCap(p , 'h0JW' , 'Rnsb' , 6)

            // nnsa (первый набор)
            call MakeGradeCheckCap(p , 'nnsa' , 'Rnsw' , 6)
            call MakeGradeCheckCap(p , 'nnsa' , 'Rnsi' , 6)

            // nnsg (второй набор)
            call MakeGradeCheckCap(p , 'nnsg' , 'R0FR' , 6)
            call MakeGradeCheckCap(p , 'nnsg' , 'Rnen' , 6)
            
            //Покупка предмета
            if GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD) > 2000 then
                call TryBuy(p , i)
            endif
        endif

    else
        call warRace(Grades[pi] , p)

    endif
    //Делай т2
    if i > 25 and LoadInteger(AiData, pi, 'h0JX') < 3 then
        call BuildT(p , 'nntt' , 'h0JX')
    endif
    
    //Делай т3
    if i > 55 and LoadInteger(AiData, pi, 'h0JY') < 3 then
        call BuildT(p , 'h0JX' , 'h0JY')
    endif
    
    //Спавн мага тп
    if i > 60 and LoadInteger(AiData, pi, 'h07A') < i / 35 then
        call MakeMageTp(pi)
    endif

endfunction
//***************************************************************************
//*  BuildNaga
function ChooseBuildings_Naga takes integer pi returns integer
    // Инициализируем массив и добавляем стартовый вариант
    set tArray[0]=1
    set tArray[1]='nnfm' // 1 Риф
    

    // Добавляем здания по условиям
    call CheckAndAddBuilding(pi , 'nntt' , 3 , 5) // T1
    call CheckAndAddBuilding(pi , 'nnfm' , 20 , 4) // Доп. рифы на старте
    call CheckAndAddBuilding(pi , 'nnsg' , 18 , 6) // Казарма
    call CheckAndAddBuilding(pi , 'nntg' , 30 , 1) // Приливной страж
    call CheckAndAddBuilding(pi , 'h0JW' , 5 , 2) // Морская дробильня грейды
    call CheckAndAddBuilding(pi , 'nnad' , 3 , 6) // Алтарь
    call CheckAndAddBuilding(pi , 'nnsa' , 15 , 2) // Святилеще Азары
    call CheckAndAddBuilding(pi , 'n055' , 15 , 3) // Морские врата

    // Выбираем случайный вариант из массива
    set gInt=GetRandomInt(1, tArray[0])
    return tArray[gInt]
endfunction

//***************************************************************************
//*  BuildingsNaga
function PereborBuildings_Naga takes integer id,integer pi,unit u returns nothing
    local boolean MurlocPath= GetPlayerTechResearched(Player(pi), 'R0FF', true)
    
    set tArray[0]=0
    // Нерестилище
    if id == 'nnsg' then

        call AddUnit('n04Z' , 2) // Воин волн
        if (LoadInteger(AiData, (pi ), ( 'h0JW')) > 0) then // INLINED!!
            call AddUnit('nsnp' , 2) // Варан
        endif

        if (LoadInteger(AiData, (pi ), ( 'h0JX')) > 0) then // INLINED!!
            call AddUnit('nhyc' , 1) // Черепаха
            if MurlocPath then
                call AddUnit('n052' , 3) // Доп. вариант для пути мурлоков
            else
                call AddUnit('nmyr' , 3) // Доп. вариант для пути наг
            endif
        endif

    // Тиры
    elseif id == 'nntt' or id == 'h0JX' or id == 'h0JY' then
        if LoadInteger(AiData, pi, 'nmpe') < 25 then
            call IssueImmediateOrderById(u, 'nmpe')
        elseif Random(1 , 2) then
            call IssueImmediateOrderById(u, 'nnmg')
        endif
    // Святилище
    elseif id == 'nnsa' then
        if (LoadInteger(AiData, (pi ), ( 'h0JX')) > 0) then // INLINED!!
            if MurlocPath then
                call AddUnit('n053' , 6) // Маг
                call AddUnit('n054' , 6) // Шаман
            else
                call AddUnit('n051' , 1) // Глубинница 1
                call AddUnit('nnsw' , 4) // Сирена
            endif
        endif
    // Морские врата
    elseif id == 'n055' then
    
        if (LoadInteger(AiData, (pi ), ( 'h0JY')) > 0) then // INLINED!!
            if MurlocPath then
                call AddUnit('n050' , 2) // Мурлок-мунтан
            else
                call AddUnit('nnrg' , 2) // Нага-гвардеец
            endif
            call AddUnit('n056' , 1) // Гигант
        endif
        call AddUnit('nwgs' , 1) // Коатль
    
    // Алтарь
    elseif id == 'nnad' then
        call CheckAndAddUnit(pi , 'N07A' , 1 , 1)
        call CheckAndAddUnit(pi , 'H0JV' , 1 , 1)
        if MurlocPath then
            call CheckAndAddUnit(pi , 'H0OZ' , 1 , 1)
        else
            call CheckAndAddUnit(pi , 'H0JU' , 1 , 1)
        endif
    endif
    
    call aiOrderUnit(u)
endfunction
                
 
function aiNavalTrain_Naga takes unit u,integer pi returns nothing
    call IssueImmediateOrderById(u, 'n079')
endfunction
                
                

                
                
//***************************************************************************
//*  UpgradeNaga
function UpgradeNaga takes integer pi,integer id returns nothing
    if id == 'h0JX' then
        call NumberRem(pi , 'nntt')
    elseif id == 'h0JY' then
        call NumberRem(pi , 'h0JX')
    endif
endfunction
//***************************************************************************
//*  GetLvlNaga
function GetLvlNaga takes unit u returns nothing
    // Герои N07A,H0JU,H0JV
        //Охоттница A13C,A13A,A13D
        if GetUnitTypeId(u) == 'H0JV' then
                set gInt=GetRandomInt(1, 3)
                if GetHeroLevel(u) == 6 or GetHeroLevel(u) == 10 then
                    call SelectHeroSkill(u, 'A13C')
                elseif gInt == 1 then
                    call SelectHeroSkill(u, 'A13A')
                elseif gInt == 2 then
                    call SelectHeroSkill(u, 'AEbl')
                else
                    //call SelectHeroSkill( u, 'A0D5' )
                endif
        //Нага A14I,A14F,A14G,A14H
        elseif GetUnitTypeId(u) == 'H0JU' then
                set gInt=GetRandomInt(0, 3)
                if gInt == 0 then
                    call SelectHeroSkill(u, 'A14I')
                elseif gInt == 1 then
                    call SelectHeroSkill(u, 'A14I')
                elseif gInt == 2 then
                    call SelectHeroSkill(u, 'A14G')
                else
                    call SelectHeroSkill(u, 'A14G')
                endif

        //Мурлок A14I,A14F,A14G,A14H
        elseif GetUnitTypeId(u) == 'N07A' then
                set gInt=GetRandomInt(1, 3)
                if GetHeroLevel(u) == 6 or GetHeroLevel(u) == 10 then
                    call SelectHeroSkill(u, 'ANrg')
                elseif gInt == 1 then
                    call SelectHeroSkill(u, 'ANsy')
                elseif gInt == 2 then
                    call SelectHeroSkill(u, 'ANcs')
                else
                    call SelectHeroSkill(u, 'ANeg')
                endif
        endif
endfunction
