function Trig_KokonDead2_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    call DestroyEffect(LoadEffectHandle(Hash, GetHandleId(u) * 10, StringHash("Cocon")))
    call FlushChildHashtable(Hash, GetHandleId(u) * 10)

    set u=null

//    set udg_LocalPosition[16] = GetUnitLoc(GetTriggerUnit())
//    call ForGroupBJ( udg_Kokon, function Trig_KokonDead2_Func002A )
//    call RemoveLocation(udg_LocalPosition[16])
endfunction

//===========================================================================
function InitTrig_KokonDead2 takes nothing returns nothing
    set gg_trg_KokonDead2=CreateTrigger()
    call DisableTrigger(gg_trg_KokonDead2)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_KokonDead2, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_KokonDead2, Condition(function Trig_KokonDead2_Conditions))
    call TriggerAddAction(gg_trg_KokonDead2, function Trig_KokonDead2_Actions)
endfunction


//===========================================================================
// Trigger: SpellBook
//===========================================================================
function Trig_SpellBook_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A1AV'
endfunction

function Trig_SpellBook_Actions takes nothing returns nothing
    local unit u1
    local group g= CreateGroup()
    local integer i= 0
    
    set udg_Boolexpr=Condition(function HaveSpell)
    call GroupEnumUnitsSelected(g, GetOwningPlayer(GetTriggerUnit()), udg_Boolexpr)
    loop
            set u1=FirstOfGroup(g)
            exitwhen u1 == null
            call IssueImmediateOrder(u1, "spellbook")
            call GroupRemoveUnit(g, u1)
    endloop
    
    
    
    
    call DestroyGroup(g)
    set u1=null
    set g=null
endfunction

//===========================================================================
function InitTrig_SpellBook takes nothing returns nothing
    set gg_trg_SpellBook=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_SpellBook, EVENT_PLAYER_UNIT_SPELL_FINISH)
    call TriggerAddCondition(gg_trg_SpellBook, Condition(function Trig_SpellBook_Conditions))
    call TriggerAddAction(gg_trg_SpellBook, function Trig_SpellBook_Actions)
endfunction


//===========================================================================
// Trigger: SpawnLich
//===========================================================================
function Trig_SpawnLich_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0ZU'
endfunction

function Trig_SpawnLich_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local player p= GetOwningPlayer(u)
    local integer i
    local unit u2= CreateUnit(p, 'e01I', GetUnitX(u), GetUnitY(u), bj_UNIT_FACING)
   //call UnitAddAbility(u2,'A1JF') //Антиреген
    call BlzSetUnitRealFieldBJ(u2, UNIT_RF_HIT_POINTS_REGENERATION_RATE, - 4.00)
    call SetUnitTimeScale(u2, 0.25)
    set u2=CreateUnit(p, 'e01I', GetUnitX(u), GetUnitY(u), bj_UNIT_FACING)
    call BlzSetUnitRealFieldBJ(u2, UNIT_RF_HIT_POINTS_REGENERATION_RATE, - 4.00)
   // call UnitAddAbility(u2,'A1JF') //Антиреген
    call SetUnitTimeScale(u2, 0.25)
    set i=GetUnitAbilityLevel(u, 'A1AV')
    
    if i >= 1 then
        //call DisplayTextToPlayer(Player(0),0,0,I2S(i))
        if i == 1 then
            call IssueImmediateOrderById(u2, 'e02W')
        elseif i == 2 then
            call IssueImmediateOrderById(u2, 'e01Q')
        elseif i == 3 then
            call IssueImmediateOrderById(u2, 'e01U')
        elseif i == 4 then
            call IssueImmediateOrderById(u2, 'e01V')
        elseif i == 5 then
            call IssueImmediateOrderById(u2, 'e01T')
        elseif i == 6 then
            call IssueImmediateOrderById(u2, 'e01O')
        elseif i == 7 then
            call IssueImmediateOrderById(u2, 'e01S')
        elseif i == 8 then
            call IssueImmediateOrderById(u2, 'e01Z')
        elseif i == 9 then
          
        elseif i == 10 then
            call IssueImmediateOrderById(u2, 'e01G')
        endif
    
    endif
    
    
    
    set p=null
    set u=null
    set u2=null
endfunction

//===========================================================================
function InitTrig_SpawnLich takes nothing returns nothing
    set gg_trg_SpawnLich=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_SpawnLich, EVENT_PLAYER_UNIT_SPELL_FINISH)
    call TriggerAddCondition(gg_trg_SpawnLich, Condition(function Trig_SpawnLich_Conditions))
    call TriggerAddAction(gg_trg_SpawnLich, function Trig_SpawnLich_Actions)
endfunction


//===========================================================================
// Trigger: SpawnTimer
//===========================================================================


function Trig_SpawnTimer_Func001A takes nothing returns nothing
    local integer id= GetUnitTypeId(GetEnumUnit())
    set udg_LocalPosition[16]=GetUnitLoc(GetEnumUnit())
    call CreateUnitAtLoc(GetOwningPlayer(GetEnumUnit()), 'e01I', udg_LocalPosition[16], bj_UNIT_FACING)
    if id == 'e021' then
        call CreateUnitAtLoc(GetOwningPlayer(GetEnumUnit()), 'e01I', udg_LocalPosition[16], bj_UNIT_FACING)
        call CreateUnitAtLoc(GetOwningPlayer(GetEnumUnit()), 'e01I', udg_LocalPosition[16], bj_UNIT_FACING)
    elseif id == 'e020' then
        call CreateUnitAtLoc(GetOwningPlayer(GetEnumUnit()), 'e01I', udg_LocalPosition[16], bj_UNIT_FACING)
        call CreateUnitAtLoc(GetOwningPlayer(GetEnumUnit()), 'e01I', udg_LocalPosition[16], bj_UNIT_FACING)
        call CreateUnitAtLoc(GetOwningPlayer(GetEnumUnit()), 'e01I', udg_LocalPosition[16], bj_UNIT_FACING)
        
    endif
    call RemoveLocation(udg_LocalPosition[16])
endfunction

function Trig_SpawnTimer_Actions takes nothing returns nothing
    call ForGroup(udg_SpawnLichinok[1], function Trig_SpawnTimer_Func001A)
endfunction

//===========================================================================
function InitTrig_SpawnTimer takes nothing returns nothing
    set gg_trg_SpawnTimer=CreateTrigger()
    call DisableTrigger(gg_trg_SpawnTimer)
    call TriggerRegisterTimerExpireEventBJ(gg_trg_SpawnTimer, udg_SilitidTimer)
    call TriggerAddAction(gg_trg_SpawnTimer, function Trig_SpawnTimer_Actions)
endfunction


