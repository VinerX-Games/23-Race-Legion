    set gg_trg_SpellArrow=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_SpellArrow, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_SpellArrow, Condition(function Trig_SpellArrow_Conditions))
