//===========================================================================
// Trigger: ArthasResurrection
//===========================================================================
function Trig_ArthasResurrection_Conditions takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0WB', GetKillingUnitBJ()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ArthasResurrection_Actions takes nothing returns nothing
    local unit u
    set udg_LocalPosition2=GetUnitLoc(GetTriggerUnit())
    call CreateNUnitsAtLoc(1, 'h05P', GetOwningPlayer(GetKillingUnitBJ()), udg_LocalPosition2, bj_UNIT_FACING)
    set udg_LocalUnit2=GetLastCreatedUnit()
    set u=udg_LocalUnit2
    call UnitAddAbilityBJ('A0WC', GetLastCreatedUnit())
    call IssueImmediateOrderBJ(GetLastCreatedUnit(), "animatedead")
    call TriggerSleepAction(2)
    set udg_LocalUnit2=u
    call RemoveUnit(udg_LocalUnit2)
    call RemoveLocation(udg_LocalPosition2)
endfunction

//===========================================================================
function InitTrig_ArthasResurrection takes nothing returns nothing
    set gg_trg_ArthasResurrection=CreateTrigger()
    call DisableTrigger(gg_trg_ArthasResurrection)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ArthasResurrection, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_ArthasResurrection, Condition(function Trig_ArthasResurrection_Conditions))
    call TriggerAddAction(gg_trg_ArthasResurrection, function Trig_ArthasResurrection_Actions)
endfunction

