    call UnitAddAbilityBJ('NQ14', GetEnumUnit())
    call SetUnitAbilityLevelSwapped('NQ14', GetEnumUnit(), GetUnitAbilityLevelSwapped('NQ14', GetTriggerUnit()))
    call IssuePointOrderLocBJ(GetEnumUnit(), "carrionswarm", GetSpellTargetLoc())
    call BlzUnitHideAbility(GetEnumUnit(), 'NQ14', true)
    call DestroyGroup(udg_AllLords)
endfunction

