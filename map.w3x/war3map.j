//===========================================================================
// Trigger: NoDeath
//===========================================================================
function Trig_NoDeath_Conditions takes nothing returns boolean
    return GetUnitAbilityLevel(GetTriggerUnit(), 'A1C6') != 0
endfunction

function BrokenBuilding takes nothing returns boolean
    return GetUnitTypeId(GetFilterUnit()) == 'h05A'
endfunction



function Trig_NoDeath_Actions takes nothing returns nothing
    local group g= CreateGroup()
    local boolexpr Boolexpr= Condition(function BrokenBuilding)
    local unit u
    local unit u2
    call GroupEnumUnitsOfPlayer(g, GetOwningPlayer(GetTriggerUnit()), Boolexpr)
    
    if Random(1 , 2) then
        set u=FirstOfGroup(g)
        if u != null then
            
            set u2=CreateUnit(GetOwningPlayer(GetTriggerUnit()), GetUnitTypeId(GetTriggerUnit()), GetUnitX(u), GetUnitY(u), 0)
            call SetUnitLifePercentBJ(u2, 10.00)
            call RemoveUnit(GetTriggerUnit())
        endif
        
        
    endif
    //call ForGroupBJ( GetUnitsOfPlayerAndTypeId(Player(0), 'hfoo'), function Trig_NoDeath_Func001A )
    
    call DestroyBoolExpr(Boolexpr)
    call DestroyGroup(g)
    set u=null
    set u2=null
endfunction

//===========================================================================
function InitTrig_NoDeath takes nothing returns nothing
    set gg_trg_NoDeath=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_NoDeath, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_NoDeath, Condition(function Trig_NoDeath_Conditions))
    call TriggerAddAction(gg_trg_NoDeath, function Trig_NoDeath_Actions)
endfunction


