//===========================================================================
// Trigger: Portal Connect
//===========================================================================
function Trig_Portal_Connect_Func008Func004Func001Func002C takes nothing returns boolean
    if ( not ( udg_Portal_active[udg_Portal_INDEX_CASTER] == false ) ) then
        return false
    endif
    if ( not ( udg_Portal_active[udg_Portal_INDEX_TARGET] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Connect_Func008Func004Func001C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_Portal_portal[udg_Portal_INDEX_TARGET] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Connect_Func008Func004C takes nothing returns boolean
    if ( not ( udg_Portal_active[udg_Portal_INDEX_TARGET] == true ) ) then
        return false
    endif
    if ( not ( GetSpellTargetUnit() != udg_Portal_portal[udg_Portal_INDEX_CASTER] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Connect_Func008C takes nothing returns boolean
    if ( not ( udg_Portal_active[udg_Portal_INDEX_CASTER] == true ) ) then
        return false
    endif
    if ( not ( GetSpellTargetUnit() != udg_Portal_portal[udg_Portal_INDEX_CASTER] ) ) then
        return false
    endif
    if ( not ( udg_Portal_active[udg_Portal_INDEX_TARGET] == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Connect_Actions takes nothing returns nothing
    if udg_Portal_SeverAbility == null then
    set udg_Portal_SeverAbility='A0TR'
    endif
    // NB
    // Portal_portal[Portal_INDEX_CASTER] is the sister portal
    // Portal_portal[Portal_INDEX_TARGET] is the caster portal
    // -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- --------
    if ( Trig_Portal_Connect_Func008C() ) then
        // TRAVELLER here is the index of the existing sister portal. Therefore, Portal_portal[Portal_INDEX_TRAVELLER] is the caster portal
        // Anything else indexed to TRAVELLER, however, is for the currently connected sister portal. TRAVELLER is used here to disengage her from the caster
        set udg_Portal_INDEX_TRAVELLER=GetUnitUserData(udg_Portal_portal[udg_Portal_INDEX_CASTER])
        call DestroyEffectBJ(udg_Portal_FX[udg_Portal_INDEX_CASTER])
        call DestroyEffectBJ(udg_Portal_FX[udg_Portal_INDEX_TRAVELLER])
        call UnitRemoveAbilityBJ(udg_Portal_SeverAbility, udg_Portal_portal[udg_Portal_INDEX_CASTER])
        call UnitRemoveAbilityBJ(udg_Portal_SeverAbility, udg_Portal_portal[udg_Portal_INDEX_TRAVELLER])
        set udg_Portal_active[udg_Portal_INDEX_TRAVELLER]=false
        set udg_Portal_portal[udg_Portal_INDEX_TRAVELLER]=null
        // -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- --------
        // Portal_portal[Portal_INDEX_CASTER] is set to the new sister portal
        set udg_Portal_portal[udg_Portal_INDEX_CASTER]=GetSpellTargetUnit()
        set udg_Portal_portal[udg_Portal_INDEX_TARGET]=GetTriggerUnit()
        set udg_Portal_active[udg_Portal_INDEX_TARGET]=true
        call AddSpecialEffectTargetUnitBJ("origin", udg_Portal_portal[udg_Portal_INDEX_TARGET], udg_Portal_activeFX[udg_Portal_INDEX_CASTER])
        set udg_Portal_FX[udg_Portal_INDEX_CASTER]=GetLastCreatedEffectBJ()
        call AddSpecialEffectTargetUnitBJ("origin", udg_Portal_portal[udg_Portal_INDEX_CASTER], udg_Portal_activeFX[udg_Portal_INDEX_TARGET])
        set udg_Portal_FX[udg_Portal_INDEX_TARGET]=GetLastCreatedEffectBJ()
        // -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- --------
        call UnitAddAbilityBJ(udg_Portal_SeverAbility, udg_Portal_portal[udg_Portal_INDEX_TARGET])
        call UnitAddAbilityBJ(udg_Portal_SeverAbility, udg_Portal_portal[udg_Portal_INDEX_CASTER])
    else
        if ( Trig_Portal_Connect_Func008Func004C() ) then
        else
            if ( Trig_Portal_Connect_Func008Func004Func001C() ) then
            else
                // If the targeted Portal, and the cast, are not active, connect them to one another
                if ( Trig_Portal_Connect_Func008Func004Func001Func002C() ) then
                    set udg_Portal_active[udg_Portal_INDEX_CASTER]=true
                    set udg_Portal_active[udg_Portal_INDEX_TARGET]=true
                    set udg_Portal_portal[udg_Portal_INDEX_CASTER]=GetSpellTargetUnit()
                    set udg_Portal_portal[udg_Portal_INDEX_TARGET]=GetTriggerUnit()
                    // -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- --------
                    call AddSpecialEffectTargetUnitBJ("origin", GetTriggerUnit(), udg_Portal_activeFX[udg_Portal_INDEX_CASTER])
                    set udg_Portal_FX[udg_Portal_INDEX_CASTER]=GetLastCreatedEffectBJ()
                    call AddSpecialEffectTargetUnitBJ("origin", GetSpellTargetUnit(), udg_Portal_activeFX[udg_Portal_INDEX_TARGET])
                    set udg_Portal_FX[udg_Portal_INDEX_TARGET]=GetLastCreatedEffectBJ()
                    // -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- --------
                    call UnitAddAbilityBJ(udg_Portal_SeverAbility, udg_Portal_portal[udg_Portal_INDEX_TARGET])
                    call UnitAddAbilityBJ(udg_Portal_SeverAbility, udg_Portal_portal[udg_Portal_INDEX_CASTER])
                else
                endif
            endif
        endif
    endif
endfunction

//===========================================================================
function InitTrig_Portal_Connect takes nothing returns nothing
    set gg_trg_Portal_Connect=CreateTrigger()
    call TriggerAddAction(gg_trg_Portal_Connect, function Trig_Portal_Connect_Actions)
endfunction

