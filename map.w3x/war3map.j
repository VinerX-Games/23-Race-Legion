//===========================================================================
// Trigger: OgrimmCharge
//===========================================================================

// Этам 1 - проверка скила - винер тут все прыжки)))
//================
function Trig_OgrimmCharge_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'w2o6'
endfunction
//================================================================================================================================================================================
// Этам 3 - двигаем врагов
//================
function Ogrimm2 takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer h= GetHandleId(t)
    local unit un= LoadUnitHandle(Hash, h, 1)
    local real ugol= LoadReal(Hash, h, 2)
    local integer kol= LoadInteger(Hash, h, 3)
    local real x= GetUnitX(un)
    local real y= GetUnitY(un)
    // ---------
    set x=x + 10 * Cos(ugol * bj_DEGTORAD) //вычисляем следующий х
    set y=y + 10 * Sin(ugol * bj_DEGTORAD) //вычисляем следующий у
    if kol >= 0 and not IsTerrainPathable(x, y, PATHING_TYPE_FLYABILITY) then
        call SetUnitX(un, x)
        call SetUnitY(un, y)
        call SaveInteger(Hash, h, 3, kol - 1)
    else
        call DestroyTimer(t)
        call FlushChildHashtable(Hash, h)
    endif
    // ----------
    set un=null
    set t=null
endfunction
//================================================================================================================================================================================
// Этам 2 - двигаем героя
//================
function Ogrimm1 takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer h= GetHandleId(t)
    local unit GT= LoadUnitHandle(Hash, h, 1)
    local real l= LoadReal(Hash, h, 2)
    local group g
    local real x1= LoadReal(Hash, h, 4)
    local real y1= LoadReal(Hash, h, 5)
    local real dx= GetUnitX(GT)
    local real dy= GetUnitY(GT)
    local unit un
    local real x
    local real y
    local real uron
    local integer lvl
    local real w
    local real ugol= JSTRUgolMT(dx , x1 , dy , y1)
    local timer t1
    local integer h1
    local real MaxW
    if l <= 500 then
        set MaxW=l
    else
        set MaxW=500
    endif
    //-------
    set x=dx + 25 * Cos(ugol * bj_DEGTORAD) //вычисляем следующий х
    set y=dy + 25 * Sin(ugol * bj_DEGTORAD) //вычисляем следующий у
    set w=JSTRParabolaZ(MaxW , l , JSTRRastMT(x , x1 , y , y1)) //вычисляем высоту
    
    // ищем конец пути
    if JSTRRastMT(x1 , dx , y1 , dy) > 25 then //and not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
        // двигаем юнита
        call SetUnitX(GT, x)
        call SetUnitY(GT, y)
        call SetUnitFacing(GT, ugol)
        call SetUnitFlyHeight(GT, w, 0)
    else
        call DestroyEffect(LoadEffectHandle(Hash, h, 6))
        call DestroyTimer(t)
        call FlushChildHashtable(Hash, h)
        call SetUnitAnimation(GT, "attack")
        call SetUnitFlyHeight(GT, 0, 0)
        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl", dx, dy))
        set g=CreateGroup()
        call GroupEnumUnitsInRange(g, dx, dy, 260, null)
        loop
            set un=FirstOfGroup(g)
            exitwhen un == null
            set lvl=GetUnitAbilityLevel(GT, GetSpellAbilityId())
            
            // винер - проверка на героя
            set uron=1.3 * lvl * GetHeroStr(GT, true) + lvl * 50
            
            if not IsUnitType(un, UNIT_TYPE_STRUCTURE) and IsUnitEnemy(un, GetOwningPlayer(GT)) and not IsUnitType(un, UNIT_TYPE_DEAD) and not IsUnitType(un, UNIT_TYPE_FLYING) then
                call UnitDamageTarget(GT, un, uron, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_UNIVERSAL, WEAPON_TYPE_WHOKNOWS)
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageDeathCaster.mdl", un, "orign"))
                //--------
                // двигаем юнита в другую сторону от кастера
                
                set ugol=JSTRUgolMT(dx , GetUnitX(un) , dy , GetUnitY(un))
                set t1=CreateTimer()
                set h1=GetHandleId(t1)
                call SaveUnitHandle(Hash, h1, 1, un)
                call SaveReal(Hash, h1, 2, ugol)
                call SaveInteger(Hash, h1, 3, 17)
                call TimerStart(t1, 0.015, true, function Ogrimm2)
                
                //-------- 
            endif
            call GroupRemoveUnit(g, un)
        endloop
        call DestroyGroup(g)
    endif
    //-------
    set GT=null
    set un=null
    set g=null
    set t=null
    set t1=null
endfunction

//================================================================================================================================================================================
// Этам 2 - основная функция
//================
function Trig_OgrimmCharge_Actions takes nothing returns nothing
    local unit GT= GetTriggerUnit()
    //local group g = CreateGroup()
    local timer t= CreateTimer()
    local integer h= GetHandleId(t)
    local real x= GetUnitX(GT)
    local real y= GetUnitY(GT)
    local real x1= GetSpellTargetX()
    local real y1= GetSpellTargetY()
    local real l= JSTRRastMT(x , x1 , y , y1)
    
    set JSTRSkill=GetSpellAbilityId()
    call UnitAddAbility(GT, 'Amrf')
    call UnitRemoveAbility(GT, 'Amrf')
    //-------
    call SaveUnitHandle(Hash, h, 1, GT)
    if l != 0 then
        call SaveReal(Hash, h, 2, l)
    else
        call SaveReal(Hash, h, 2, 1)
    endif
    call SaveReal(Hash, h, 4, x1)
    call SaveReal(Hash, h, 5, y1)
    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl", x, y))
    call TimerStart(t, 0.025, true, function Ogrimm1) //стартуем движение героя
    //-------
    set GT=null
    //set g = null
    set t=null
endfunction

//===========================================================================
function InitTrig_OgrimmCharge takes nothing returns nothing
    set gg_trg_OgrimmCharge=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_OgrimmCharge, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_OgrimmCharge, Condition(function Trig_OgrimmCharge_Conditions))
    call TriggerAddAction(gg_trg_OgrimmCharge, function Trig_OgrimmCharge_Actions)
endfunction


//===========================================================================
// Trigger: Duel
//===========================================================================
function Trig_Duel_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'w2ou' and IsUnitType(GetSpellTargetUnit(), UNIT_TYPE_HERO)
endfunction


function Duel takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer id= GetHandleId(t)
    local unit u= LoadUnitHandle(Hash, id, 0)
    local unit u2= LoadUnitHandle(Hash, id, 1)
    local location l1=GetUnitLoc(u)
    local location l2=GetUnitLoc(u2)
    call UnitRemoveAbility(u, 'Avul')
    call UnitRemoveAbility(u2, 'Avul')
    call PauseUnit(u, true)
    call PauseUnit(u2, true)
    call SetUnitAnimation(u, "attack")
    call SetUnitAnimation(u2, "attack")
    call SetUnitLookAt(u, "bone_chest", u2, 0, 0, 0)
    call SetUnitLookAt(u2, "bone_chest", u, 0, 0, 0)
    
    
    call UnitDamageTargetBJ(u, u2, BlzGetUnitBaseDamage(u, 1), ATTACK_TYPE_HERO, DAMAGE_TYPE_UNIVERSAL)
    if UnitAlive(u2) then
         call UnitDamageTargetBJ(u2, u, BlzGetUnitBaseDamage(u, 1), ATTACK_TYPE_HERO, DAMAGE_TYPE_UNIVERSAL)
    endif
   
    call UnitAddAbility(u, 'Avul')
    call UnitAddAbility(u2, 'Avul')
    if not UnitAlive(u) then
        call PauseUnit(u, false)
        call PauseUnit(u2, false)
        call SetUnitAnimation(u, "death")
        call SetUnitAnimation(u2, "stand")
        call UnitAddAbility(u2, 'w2oz')
        call IssueImmediateOrder(u2, "howlofterror")
            call UnitRemoveAbility(u, 'Avul')
        call UnitRemoveAbility(u2, 'Avul')
        call FlushChildHashtable(Hash, id)
        call PauseTimer(t)
        call DestroyTimer(t)
        
        call ResetUnitLookAt(u)
        call ResetUnitLookAt(u2)
        
    elseif not UnitAlive(u2) then
        call PauseUnit(u, false)
        call PauseUnit(u2, false)
        call SetUnitAnimation(u, "stand")
        call SetUnitAnimation(u2, "death")
        call UnitAddAbility(u, 'w2oz')
        call IssueImmediateOrder(u, "howlofterror")
        call UnitRemoveAbility(u, 'Avul')
        call UnitRemoveAbility(u2, 'Avul')
        call FlushChildHashtable(Hash, id)
        call PauseTimer(t)
        call DestroyTimer(t)
        
        call ResetUnitLookAt(u)
        call ResetUnitLookAt(u2)
        
    elseif u == null or u2 == null or DistanceBetweenPoints(l1, l2) > 500 then
        call PauseUnit(u, false)
        call PauseUnit(u2, false)
        call SetUnitAnimation(u, "stand")
        call SetUnitAnimation(u2, "stand")
        call ResetUnitLookAt(u)
        call ResetUnitLookAt(u2)
        call UnitRemoveAbility(u, 'Avul')
        call UnitRemoveAbility(u2, 'Avul')
        call FlushChildHashtable(Hash, id)
        call PauseTimer(t)
        call DestroyTimer(t)
        
    
    endif

    set t=null
    set u=null
    set u2=null
    
    call RemoveLocation(l1)
    call RemoveLocation(l2)
    set l1=null
    set l2=null
endfunction



function Trig_Duel_Actions takes nothing returns nothing
    local unit u= GetTriggerUnit()
    local unit u2= GetSpellTargetUnit()
    local timer t= CreateTimer()
    local integer id= GetHandleId(t)
    
    call TimerStart(t, 1, true, function Duel)
    call SaveUnitHandle(Hash, id, 0, u)
    call SaveUnitHandle(Hash, id, 1, u2)
    
    call UnitAddAbility(u, 'Avul')
    call UnitAddAbility(u2, 'Avul')
    
    
    //call SaveInteger(Hash,id,1, 'w2aW')
    //call SaveInteger(Hash,id,2, 0)
    //call SaveInteger(Hash,id,3, GetUnitAbilityLevel(u,'w2aW'))
    //call SaveLocationHandle(Hash,id,4, GetSpellTargetLoc())

    set t=null
    set u=null
    set u2=null

    
endfunction

