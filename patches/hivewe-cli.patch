@@ -31,6 +31,26 @@ import PlacedUnits;
 namespace {
 namespace fs = std::filesystem;
 
+bool asset_available(const std::string& name) {
+	std::vector<fs::path> candidates = {fs::path(name)};
+	const auto extension = fs::path(name).extension().string();
+	if (extension.empty()) {
+		candidates.push_back(fs::path(name + ".mdx"));
+		candidates.push_back(fs::path(name + ".mdl"));
+	} else if (extension == ".blp" || extension == ".BLP") {
+		auto dds = fs::path(name); dds.replace_extension(".dds"); candidates.push_back(dds);
+	} else if (extension == ".mdl" || extension == ".MDL") {
+		auto mdx = fs::path(name); mdx.replace_extension(".mdx"); candidates.push_back(mdx);
+	}
+	for (const auto& candidate : candidates) {
+		if (hierarchy.file_exists(candidate)) return true;
+		for (const auto* flavour : {"_sd.w3mod:", "_hd.w3mod:"}) {
+			if (hierarchy.game_data.file_exists(fs::path("war3.w3mod:" + std::string(flavour) + candidate.generic_string()))) return true;
+		}
+	}
+	return false;
+}
