//===========================================================================
// Trigger: AttackedAI
//
// IssuePointOrderLoc
// IssueTargetOrder
//===========================================================================
function Trig_AttackedAI_Conditions takes nothing returns boolean
    return udg_AiControl[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]
endfunction

function Trig_AttackedAI_Actions takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local integer i
    local integer pi = GetPlayerId(GetOwningPlayer(u))


    if IsUnitInGroup(u,udg_ZahvatBuildings) then
        set i = GetRandomInt(1,20)
        if i ==1 then
            call PortTo(u)
        endif
    elseif IsUnitInGroup(u,AiUnitsToPort[pi]) then
        set i = GetRandomInt(1,10)
        if i ==1 then
            call PortTo(u)
        endif
    else
        // --------------- Алый орден
        if AiRace[pi]=="Scarlet" then
        

            //Тяж Пехотинец
            if GetUnitTypeId(u)=='h039' then
                set i = GetRandomInt(1,5)
                    if i == 1 then 
                        call IssueImmediateOrder(u,"defend")
                    elseif i == 2 then
                        call IssueImmediateOrder(u,"magicdefense")
                    elseif i == 3 then
                        call IssueImmediateOrder(u,"undefend")
                    elseif i == 4 then
                        call IssueImmediateOrder(u,"magicundefense")     
                    
                    endif
            
            //Мечник
            elseif GetUnitTypeId(u)=='h03B' then
                set i = GetRandomInt(1,3)
                    if i ==1 then 
                        call IssueImmediateOrder(u,"defend")
                    elseif i == 2 then
                        call IssueImmediateOrder(u,"undefend")
                    
                    endif
            endif
        elseif AiRace[pi]=="BloodElves" then
             //Мечник
            if GetUnitTypeId(u)=='h03V' then
                set i = GetRandomInt(1,5)
                    if i == 1 then 
                        call IssueImmediateOrder(u,"defend")
                    elseif i == 2 then
                        call IssueImmediateOrder(u,"manashieldon")
                    elseif i == 3 then
                        call IssueImmediateOrder(u,"undefend")
                    endif
           
            elseif GetUnitTypeId(u)=='h03B' then
                set i = GetRandomInt(1,3)
                    if i ==1 then 
                        call IssueImmediateOrder(u,"defend")
                    elseif i == 2 then
                        call IssueImmediateOrder(u,"undefend")
                    
                    endif
            endif
        
        
        endif
    endif
    set u = null

endfunction

