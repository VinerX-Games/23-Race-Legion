//===========================================================================
// Trigger: Pandarens
//===========================================================================
function Trig_Pandarens_Conditions takes nothing returns boolean
    return GetResearched() == 'R0EE'
endfunction

function Trig_Pandarens_Actions takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local player p = GetOwningPlayer(u)
    local integer pi = GetPlayerId(p)
    call countAll(p)
    set udg_MainPrice[pi] = udg_MainPrice[pi] + 2
    set udg_HordeLandPrice[pi] = udg_HordeLandPrice[pi] - 2
    set udg_HordeElitePrice[pi] = udg_HordeElitePrice[pi] - 1
    call ChangeLandUnitsNow(p,pi)
    call ChangeEliteUnitsNow(p,pi)
    

    call SetPlayerTechMaxAllowed(p,'R0EH',1)
    //Compromise
    if GetPlayerTechCount(p,'R0EE',true) == 1 then
        call SetPlayerTechMaxAllowed(p,'R0EI',1)
    endif
    set p = null
    set u = null
endfunction

