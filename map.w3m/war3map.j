function InitTrig_Globals takes nothing returns nothing
    //set gg_trg_Globals = CreateTrigger(  )
endfunction


//===========================================================================
// Trigger: StartN
//===========================================================================
function Trig_StartN_Actions takes nothing returns nothing
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 24
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_UnitsCount[GetForLoopIndexA()] = 0
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

