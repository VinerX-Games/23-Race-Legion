function Trig_StartCreateChoice_Actions takes nothing returns nothing
    local integer i 
    local integer i2
    set i = S2I(SubStringBJ(GetEventPlayerChatString(), 4, 5)) - 1
    call TriggerExecute(gg_trg_TurnAi)
    
   
    set udg_AiControl[i] = true
    call ForceAddPlayerSimple( Player(i), udg_Bots )
    // Обычное появление и ресы
   
    //Задаю место
    
    
    set udg_LocalPoint = RandomLoc() //GetCameraEyePositionLoc()
    
    
        
    
    //Задаю место
    
    //call RandomAiPlace()
    
    //В итоге место 
    
    
    set i2 = GetRandomInt(1,2)
    
    
    //Алый орден
    if i2 == 1 then
        //Старт юниты
        call CreateNUnitsAtLoc( 8, 'h014', Player(i), udg_LocalPoint, bj_UNIT_FACING )
        call GroupAddGroup( GetLastCreatedGroup(), udg_Ai_units[i] )
        call GroupAddGroup( GetLastCreatedGroup(), udg_Ai_builders[i] )
        call CreateNUnitsAtLoc( 1, 'h05U', Player(i), udg_LocalPoint, bj_UNIT_FACING )
        call GroupAddUnitSimple( GetLastCreatedUnit(), udg_Ai_units[i] )
        call GroupAddUnitSimple( GetLastCreatedUnit(), udg_Ai_buildings[i] )
        call SaveInteger(AiData,i,'h014',8)
        call SaveInteger(AiData,i,'h05U',1)
        call SetPlayerName(Player(i),"Алый Орден ("+I2S(i+1)+")")
        call SaveStr(AiData,i,StringHash("Race"),"AO")
        
        set AiRace[i] = "Scarlet"
    elseif i>1 then
        call CreateNUnitsAtLoc( 8, 'h04K', Player(i), udg_LocalPoint, bj_UNIT_FACING )
        call GroupAddGroup( GetLastCreatedGroup(), udg_Ai_units[i] )
        call GroupAddGroup( GetLastCreatedGroup(), udg_Ai_builders[i] )
        call CreateNUnitsAtLoc( 1, 'h04C', Player(i), udg_LocalPoint, bj_UNIT_FACING )
        call GroupAddUnitSimple( GetLastCreatedUnit(), udg_Ai_units[i] )
        call GroupAddUnitSimple( GetLastCreatedUnit(), udg_Ai_buildings[i] )
        call SaveInteger(AiData,i,'h04K',8)
        call SaveInteger(AiData,i,'h04C',1)
        call SetPlayerName(Player(i),"Эльфы Крови ("+I2S(i+1)+")")
        call SaveStr(AiData,i,StringHash("Race"),"BE")
        call TriggerExecute(gg_trg_BloodElvesOn)
        set AiRace[i] = "BloodElves"

    
    endif
    //Лимиты
    call SetLimits(Player(i))
    
    
    
    call SetPlayerStateBJ( Player(i), PLAYER_STATE_RESOURCE_GOLD, 5000 )
    call SetPlayerStateBJ( Player(i), PLAYER_STATE_RESOURCE_LUMBER, 5000 )
    call SetBools()
    call TriggerExecute(gg_trg_CityNearWater2)
    
    // Данные ИИшки
    // Таймеры ИИ
    
    call StartTimerBJ( udg_TimerSmall, false, 1.11*AiRepeat/5 )
    call StartTimerBJ( udg_TimerSmall2, false, 2.12*AiRepeat/5 )
    call StartTimerBJ( udg_TimerSmall3, false, 3.13*AiRepeat/5 )
    call StartTimerBJ( udg_TimerSmall4, false, 4.14*AiRepeat/5 )
    call StartTimerBJ( udg_AiTimerStrateg, true, 15.15*AiRepeat/5 )
    call StartTimerBJ( udg_TimerToChangeAi, false, 3000.00 )
endfunction

