// Trigger: K1T2
//===========================================================================
function Trig_K1T2_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTrainedUnit()) == 'o01N'
endfunction


function T2Count takes player p returns nothing
    local integer array a
    local integer i = 0
    local integer b = 0
    local integer pi = GetPlayerId(p)
    
    //1 юнит
    set a[0]=0
    
    set b = 0
    set i = 2
    loop //Орк
            set a[0] = a[0] + 1
            set a[ a[0] ] = 'o01Q'
            set b = b + 1
            exitwhen b >= i
    endloop
    
    set b = 0
    set i = 1
    loop //Огр
            set a[0] = a[0] + 1
            set a[ a[0] ] = 'o01O'
            set b = b + 1
            exitwhen b >= i
    endloop
    
    
    if GetPlayerTechCount(p,'R0EE',true) == 1 and GetPlayerTechCount(p,'R0E9',true) != 1 then 
        set b = 0
        set i = 1
        loop //Pandaren
                set a[0] = a[0] + 1
                set a[ a[0] ] = 'o02S'
                set b = b + 1
                exitwhen b >= i
        endloop
    endif
    
    //Long Containment
    call SaveInteger(CommonHash,pi,StringHash("T2_0"),a[0])
    set i = 1
    loop
        
        
        call SaveInteger(CommonHash,pi, StringHash("T2")+i ,a[i])
        set i=i+1
        exitwhen i >a[0]
    endloop
    
    
    
    
endfunction


