//===========================================================================
// Trigger: SandStrike
//===========================================================================
function Trig_SandStrike_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0NF' ) ) then
        return false
    endif
    return true
endfunction

function Trig_SandStrike_Func001C takes nothing returns boolean
    if ( not ( udg_SSinteger[0] == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SandStrike_Actions takes nothing returns nothing
    if ( Trig_SandStrike_Func001C() ) then
        call EnableTrigger( gg_trg_Sand_Strike_Loop )
    else
    endif
    set udg_SSinteger[0] = ( udg_SSinteger[0] + 1 )
    set udg_SSinteger[1] = ( udg_SSinteger[1] + 1 )
    set udg_SScaster[udg_SSinteger[1]] = GetTriggerUnit()
    call SetUnitPathing( udg_SScaster[udg_SSinteger[1]], false )
    set udg_SSfacing[udg_SSinteger[1]] = GetUnitFacing(udg_SScaster[udg_SSinteger[1]])
    set udg_SSpointcaster[udg_SSinteger[1]] = GetUnitLoc(udg_SScaster[udg_SSinteger[1]])
    set udg_SSdamage[udg_SSinteger[1]] = ( 5.00 + I2R(GetUnitAbilityLevelSwapped('A0NF', udg_SScaster[udg_SSinteger[1]])) )
    set udg_SStargetpoint[udg_SSinteger[1]] = GetSpellTargetLoc()
    set udg_SSeffect[udg_SSinteger[1]] = "Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl"
    set udg_SS[udg_SSinteger[1]] = ( GetUnitAbilityLevelSwapped('A0NF', udg_SScaster[udg_SSinteger[1]]) + 30 )
    call PauseUnitBJ( true, GetTriggerUnit() )
    call RemoveLocation(udg_SSpointcaster[udg_SSinteger[1]])
    call RemoveLocation(udg_SStargetpoint[udg_SSinteger[1]])
endfunction

//===========================================================================
function InitTrig_SandStrike takes nothing returns nothing
    set gg_trg_SandStrike = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_SandStrike, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_SandStrike, Condition( function Trig_SandStrike_Conditions ) )
    call TriggerAddAction( gg_trg_SandStrike, function Trig_SandStrike_Actions )
endfunction

//===========================================================================
// Trigger: Sand Strike Loop
//===========================================================================
function Trig_Sand_Strike_Loop_Func001Func001Func003C takes nothing returns boolean
    if ( not ( IsTerrainPathableBJ(udg_SSpointmovecaster[udg_SSinteger[2]], PATHING_TYPE_WALKABILITY) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sand_Strike_Loop_Func001Func001Func004002003001 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_SScaster[udg_SSinteger[2]])) == true )
endfunction

function Trig_Sand_Strike_Loop_Func001Func001Func004002003002 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_Sand_Strike_Loop_Func001Func001Func004002003 takes nothing returns boolean
    return GetBooleanAnd( Trig_Sand_Strike_Loop_Func001Func001Func004002003001(), Trig_Sand_Strike_Loop_Func001Func001Func004002003002() )
endfunction

function Trig_Sand_Strike_Loop_Func001Func001Func007A takes nothing returns nothing
    set udg_SSpicked[udg_SSinteger[2]] = GetEnumUnit()
    set udg_SSpointpicked[udg_SSinteger[2]] = GetUnitLoc(udg_SSpicked[udg_SSinteger[2]])
    set udg_SSpointmovepicked[udg_SSinteger[2]] = PolarProjectionBJ(udg_SSpointpicked[udg_SSinteger[2]], I2R(udg_SS[udg_SSinteger[2]]), GetUnitFacing(udg_SSpicked[udg_SSinteger[2]]))
    call SetUnitPositionLoc( udg_SSpicked[udg_SSinteger[2]], udg_SSpointmovepicked[udg_SSinteger[2]] )
    call UnitDamageTargetBJ( udg_SScaster[udg_SSinteger[2]], udg_SSpicked[udg_SSinteger[3]], udg_SSdamage[udg_SSinteger[2]], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL )
    set udg_SSpicked[udg_SSinteger[2]] = null
    call RemoveLocation(udg_SSpointpicked[udg_SSinteger[2]])
    call RemoveLocation(udg_SSpointmovepicked[udg_SSinteger[2]])
endfunction

function Trig_Sand_Strike_Loop_Func001Func001Func011Func004C takes nothing returns boolean
    if ( not ( udg_SSinteger[0] == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sand_Strike_Loop_Func001Func001Func011C takes nothing returns boolean
    if ( not ( udg_SS[udg_SSinteger[2]] == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sand_Strike_Loop_Func001Func001C takes nothing returns boolean
    if ( not ( udg_SS[udg_SSinteger[2]] != 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sand_Strike_Loop_Actions takes nothing returns nothing
    set udg_SSinteger[2] = 1
    loop
        exitwhen udg_SSinteger[2] > udg_SSinteger[1]
        if ( Trig_Sand_Strike_Loop_Func001Func001C() ) then
            set udg_SSpointcaster[udg_SSinteger[2]] = GetUnitLoc(udg_SScaster[udg_SSinteger[2]])
            set udg_SSpointmovecaster[udg_SSinteger[2]] = PolarProjectionBJ(udg_SSpointcaster[udg_SSinteger[2]], I2R(udg_SS[udg_SSinteger[2]]), udg_SSfacing[udg_SSinteger[2]])
            if ( Trig_Sand_Strike_Loop_Func001Func001Func003C() ) then
                call RemoveLocation(udg_SSpointmovecaster[udg_SSinteger[2]])
                set udg_SSpointmovecaster[udg_SSinteger[2]] = PolarProjectionBJ(udg_SSpointcaster[udg_SSinteger[2]], I2R(udg_SS[udg_SSinteger[2]]), ( udg_SSfacing[udg_SSinteger[2]] - 180.00 ))
            else
            endif
            set udg_SSgroup[udg_SSinteger[2]] = GetUnitsInRangeOfLocMatching(150.00, udg_SSpointcaster[udg_SSinteger[2]], Condition(function Trig_Sand_Strike_Loop_Func001Func001Func004002003))
            set udg_SS[udg_SSinteger[2]] = ( udg_SS[udg_SSinteger[2]] - 1 )
            call SetUnitPositionLoc( udg_SScaster[udg_SSinteger[2]], udg_SSpointmovecaster[udg_SSinteger[2]] )
            call ForGroupBJ( udg_SSgroup[udg_SSinteger[2]], function Trig_Sand_Strike_Loop_Func001Func001Func007A )
            call RemoveLocation(udg_SSpointmovecaster[udg_SSinteger[2]])
            call DestroyGroup(udg_SSgroup[udg_SSinteger[2]])
            call RemoveLocation(udg_SSpointcaster[udg_SSinteger[2]])
            if ( Trig_Sand_Strike_Loop_Func001Func001Func011C() ) then
                call SetUnitPathing( udg_SScaster[udg_SSinteger[2]], true )
                call PauseUnitBJ( false, udg_SScaster[udg_SSinteger[2]] )
                set udg_SSinteger[0] = ( udg_SSinteger[0] - 1 )
                if ( Trig_Sand_Strike_Loop_Func001Func001Func011Func004C() ) then
                    set udg_SSinteger[1] = 0
                    call DisableTrigger( GetTriggeringTrigger() )
                else
                endif
            else
            endif
        else
        endif
        set udg_SSinteger[2] = udg_SSinteger[2] + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Sand_Strike_Loop takes nothing returns nothing
    set gg_trg_Sand_Strike_Loop = CreateTrigger(  )
    call DisableTrigger( gg_trg_Sand_Strike_Loop )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Sand_Strike_Loop, 0.04 )
    call TriggerAddAction( gg_trg_Sand_Strike_Loop, function Trig_Sand_Strike_Loop_Actions )
endfunction

