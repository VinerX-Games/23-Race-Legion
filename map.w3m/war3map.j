//===========================================================================
// Trigger: BegEvery
//===========================================================================
function Trig_BegEvery_Func001C takes nothing returns boolean
    if ( ( GetResearched() == 'R0HS' ) ) then
        return true
    endif
    if ( ( GetResearched() == 'R0HR' ) ) then
        return true
    endif
    if ( ( GetResearched() == 'R0HQ' ) ) then
        return true
    endif
    return false
endfunction

function Trig_BegEvery_Conditions takes nothing returns boolean
    if ( not Trig_BegEvery_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_BegEvery_Actions takes nothing returns nothing
    call SetPlayerTechMaxAllowedSwap( 'R0GX', 0, GetOwningPlayer(GetTriggerUnit()) )
endfunction

//===========================================================================
function InitTrig_BegEvery takes nothing returns nothing
    set gg_trg_BegEvery = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_BegEvery, EVENT_PLAYER_UNIT_RESEARCH_START )
    call TriggerAddCondition( gg_trg_BegEvery, Condition( function Trig_BegEvery_Conditions ) )
    call TriggerAddAction( gg_trg_BegEvery, function Trig_BegEvery_Actions )
endfunction

//===========================================================================
// Trigger: CanEvery
//===========================================================================
function Trig_CanEvery_Func001Func001C takes nothing returns boolean
    if ( not ( GetResearched() == 'R0HS' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R0HR', GetOwningPlayer(GetTriggerUnit())) == 0 ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R0HQ', GetOwningPlayer(GetTriggerUnit())) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_CanEvery_Func001Func002C takes nothing returns boolean
    if ( not ( GetResearched() == 'R0HR' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R0HS', GetOwningPlayer(GetTriggerUnit())) == 0 ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R0HQ', GetOwningPlayer(GetTriggerUnit())) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_CanEvery_Func001Func003C takes nothing returns boolean
    if ( not ( GetResearched() == 'R0HQ' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R0HS', GetOwningPlayer(GetTriggerUnit())) == 0 ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R0HR', GetOwningPlayer(GetTriggerUnit())) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_CanEvery_Func001C takes nothing returns boolean
    if ( Trig_CanEvery_Func001Func001C() ) then
        return true
    endif
    if ( Trig_CanEvery_Func001Func002C() ) then
        return true
    endif
    if ( Trig_CanEvery_Func001Func003C() ) then
        return true
    endif
    return false
endfunction

function Trig_CanEvery_Conditions takes nothing returns boolean
    if ( not Trig_CanEvery_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_CanEvery_Actions takes nothing returns nothing
    call SetPlayerTechMaxAllowedSwap( 'R0GX', 1, GetOwningPlayer(GetTriggerUnit()) )
endfunction

