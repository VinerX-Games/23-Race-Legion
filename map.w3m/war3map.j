//===========================================================================
// Trigger: Buildings
//===========================================================================
function Trig_Buildings_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AUin' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Buildings_Func010C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'AUin' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Buildings_Actions takes nothing returns nothing
    set udg_Spell = GetSpellTargetLoc()
    call AddSpecialEffectLocBJ( udg_Spell, "Units\\Demon\\Infernal\\InfernalBirth.mdl" )
    call BlzSetSpecialEffectTime( GetLastCreatedEffectBJ(), 0.01 )
    call TriggerSleepAction( 0.70 )
    call AddSpecialEffectLocBJ( udg_Spell, "Abilities\\Spells\\Undead\\Darksummoning\\DarkSummonTarget.mdl" )
    call BlzSetSpecialEffectScale( GetLastCreatedEffectBJ(), 1.80 )
    call BlzSetSpecialEffectTime( GetLastCreatedEffectBJ(), 1.00 )
    set udg_effect = GetLastCreatedEffectBJ()
    call TriggerSleepAction( 1.00 )
    if ( Trig_Buildings_Func010C() ) then
        call DestroyEffectBJ( udg_effect )
        call CreateNUnitsAtLoc( 1, 'ndmg', GetOwningPlayer(GetTriggerUnit()), udg_Spell, bj_UNIT_FACING )
        call TriggerSleepAction( 0.20 )
        call AddSpecialEffectLocBJ( udg_Spell, "Abilities\\Spells\\Human\\FlameStrike\\FlameStrikeTarget.mdl" )
        set udg_effect = GetLastCreatedEffectBJ()
        call TriggerSleepAction( 0.20 )
        call DestroyEffectBJ( udg_effect )
    else
    endif
endfunction

