//===========================================================================
// Trigger: EndBuilding
//===========================================================================
function Trig_EndBuilding_Conditions takes nothing returns boolean
    return udg_AiControl[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))] == true
endfunction

function Trig_EndBuilding_Actions takes nothing returns nothing
    local group g = CreateGroup()
    local unit u = GetTriggerUnit()
    
    call GroupEnumUnitsInRange(g,GetUnitX(u),GetUnitY(u),125.00,B_Worker)
    set u = FirstOfGroup(g)
    
    set TryBuild_u = u
    call ExecuteFunc("TryBuild")
    
    
    call DestroyGroup(g)
    set g = null
    set u = null
endfunction

