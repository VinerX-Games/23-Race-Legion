//===========================================================================
// Trigger: ChoseLich
//===========================================================================

function Trig_ChoseLich_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0SW' or GetSpellAbilityId() == 'A0T1'
endfunction

function HaveSpell takes nothing returns boolean
    return GetUnitAbilityLevel(GetFilterUnit(),'A0SW')+GetUnitAbilityLevel(GetFilterUnit(),'A0T1')!=0
endfunction


function Trig_ChoseLich_Func003002 takes nothing returns boolean
    return GetUnitTypeId(GetFilterUnit()) == 'e01I'  and  GetOwningPlayer(GetTriggerUnit()) == GetOwningPlayer(GetFilterUnit())
endfunction



function Trig_ChoseLich_Actions takes nothing returns nothing
    local unit u1
    local unit u2
    local group g = CreateGroup()
    local group g2 = CreateGroup()
    local integer i = 0
    
    call ClearSelectionForPlayer( GetOwningPlayer(GetTriggerUnit()) )
    set udg_Boolexpr = Condition(function HaveSpell)
    call GroupEnumUnitsSelected(g,GetOwningPlayer(GetTriggerUnit()), udg_Boolexpr)
    set udg_Boolexpr = Condition(function Trig_ChoseLich_Func003002)
    
    loop
        set u1= FirstOfGroup(g)
        exitwhen u1 == null or i>=12
        
        call GroupEnumUnitsInRange(g2, GetUnitX(u1),GetUnitY(u1), 1200,udg_Boolexpr)
        loop
            set u2= FirstOfGroup(g2)
            exitwhen u2 == null or i>=12
        
            call SelectUnitAddForPlayer( u2, GetOwningPlayer(GetTriggerUnit()) )
    
            set i = i + 1
            call GroupRemoveUnit(g2,u2)
        endloop
         
    
        
        call GroupRemoveUnit(g,u1)
    endloop
    
    
    
    
    
   
    call DestroyGroup(g)
    call DestroyGroup(g2)
    set g= null
    set g2= null
    
    
endfunction

//===========================================================================
function InitTrig_ChoseLich takes nothing returns nothing
    set gg_trg_ChoseLich = CreateTrigger(  )
    call DisableTrigger( gg_trg_ChoseLich )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_ChoseLich, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_ChoseLich, Condition( function Trig_ChoseLich_Conditions ) )
    call TriggerAddAction( gg_trg_ChoseLich, function Trig_ChoseLich_Actions )
endfunction


