//===========================================================================
// Trigger: Sdelat Flagman Ot
//===========================================================================
function Trig_Sdelat_Flagman_Ot_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A009' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sdelat_Flagman_Ot_Func002002 takes nothing returns boolean
    return ( GetUnitAbilityLevelSwapped('A009', GetFilterUnit()) >= 1 )
endfunction

function Trig_Sdelat_Flagman_Ot_Func005A takes nothing returns nothing
    call UnitRemoveAbilityBJ( 'A009', GetEnumUnit() )
endfunction

function Trig_Sdelat_Flagman_Ot_Func019C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'h06W' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sdelat_Flagman_Ot_Actions takes nothing returns nothing
    set udg_FlagmanEst[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = true
    set udg_Boolexpr = Condition(function Trig_Sdelat_Flagman_Ot_Func002002)
    set udg_LocalPlayer = GetOwningPlayer(GetTriggerUnit())
    call GroupEnumUnitsOfPlayer( udg_LocalOtrad2, udg_LocalPlayer, udg_Boolexpr )
    call ForGroupBJ( udg_LocalOtrad2, function Trig_Sdelat_Flagman_Ot_Func005A )
    call GroupClear( udg_LocalOtrad2 )
    call BlzSetUnitWeaponIntegerFieldBJ( GetTriggerUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0, ( BlzGetUnitWeaponIntegerField(GetTriggerUnit(), UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0) * 3 ) )
    call BlzSetUnitStringFieldBJ( GetTriggerUnit(), UNIT_SF_NAME, ( "|cffff0000Флагман|r - " + GetUnitName(GetTriggerUnit()) ) )
    call BlzSetUnitIntegerFieldBJ( GetTriggerUnit(), UNIT_IF_TINTING_COLOR_GREEN, 175 )
    call BlzSetUnitIntegerFieldBJ( GetTriggerUnit(), UNIT_IF_TINTING_COLOR_BLUE, 175 )
    call UnitAddTypeBJ( UNIT_TYPE_HERO, GetTriggerUnit() )
    call BlzSetUnitRealFieldBJ( GetTriggerUnit(), UNIT_RF_SCALING_VALUE, ( BlzGetUnitRealField(GetTriggerUnit(), UNIT_RF_SCALING_VALUE) * 1.25 ) )
    call BlzSetUnitArmor( GetTriggerUnit(), ( BlzGetUnitArmor(GetTriggerUnit()) + 5.00 ) )
    call BlzSetUnitMaxHP( GetTriggerUnit(), ( BlzGetUnitMaxHP(GetTriggerUnit()) * 3 ) )
    call BlzSetUnitRealFieldBJ( GetTriggerUnit(), UNIT_RF_HP, I2R(BlzGetUnitMaxHP(GetTriggerUnit())) )
    call UnitAddAbilityBJ( 'A008', GetTriggerUnit() )
    call GroupAddUnitSimple( GetTriggerUnit(), udg_Flagmans )
    if ( Trig_Sdelat_Flagman_Ot_Func019C() ) then
        call UnitRemoveAbilityBJ( 'A0LG', GetTriggerUnit() )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Sdelat_Flagman_Ot takes nothing returns nothing
    set gg_trg_Sdelat_Flagman_Ot = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Sdelat_Flagman_Ot, EVENT_PLAYER_UNIT_SPELL_CAST )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Sdelat_Flagman_Ot, EVENT_PLAYER_UNIT_SPELL_ENDCAST )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Sdelat_Flagman_Ot, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Sdelat_Flagman_Ot, Condition( function Trig_Sdelat_Flagman_Ot_Conditions ) )
    call TriggerAddAction( gg_trg_Sdelat_Flagman_Ot, function Trig_Sdelat_Flagman_Ot_Actions )
endfunction

