    call UnitAddAbilityBJ( 'A0UB', GetTriggerUnit() )
    call UnitRemoveAbilityBJ( 'A0UM', GetTriggerUnit() )
    call UnitAddAbilityBJ( 'A0UC', GetTriggerUnit() )
    call UnitRemoveAbilityBJ( 'A0UN', GetTriggerUnit() )
    call UnitRemoveAbilityBJ( 'A0UO', GetTriggerUnit() )
    call UnitAddAbilityBJ( 'A0UD', GetTriggerUnit() )
    call UnitAddAbilityBJ( 'A0UE', GetTriggerUnit() )
    call UnitRemoveAbilityBJ( 'A0UP', GetTriggerUnit() )
    call UnitAddAbilityBJ( 'A0UF', GetTriggerUnit() )
    call UnitRemoveAbilityBJ( 'A0UQ', GetTriggerUnit() )
    call UnitAddAbilityBJ( 'A0UH', GetTriggerUnit() )
