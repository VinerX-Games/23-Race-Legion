//===========================================================================
// Trigger: Draenei Build Abill
//===========================================================================
function Trig_Draenei_Build_Abill_Conditions takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B065') == true ) ) then
        return false
    endif
    if ( not ( GetRandomReal(0, 9.00) >= 5.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Draenei_Build_Abill_Actions takes nothing returns nothing
    call UnitSetConstructionProgress( GetConstructingStructure(), 20 )
endfunction

