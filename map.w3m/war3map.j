//===========================================================================
// Trigger: Безымянный триггер 001 Copy
//===========================================================================
function Trig_____________________________________001_Copy_Conditions takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0MQ', GetAttackedUnitBJ()) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_____________________________________001_Copy_Func004Func001Func001Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0NC', GetAttackedUnitBJ()) == 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_____________________________________001_Copy_Func004Func001Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0NC', GetAttackedUnitBJ()) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_____________________________________001_Copy_Func004Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0NC', GetAttackedUnitBJ()) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_____________________________________001_Copy_Func004C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0NC', GetAttackedUnitBJ()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_____________________________________001_Copy_Actions takes nothing returns nothing
    set udg_Dm[2] = GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetAttackedUnitBJ())
    set udg_Dm[1] = ( udg_Dm[2] - GetUnitStateSwap(UNIT_STATE_LIFE, GetAttackedUnitBJ()) )
    if ( Trig_____________________________________001_Copy_Func004C() ) then
        call UnitDamageTargetBJ( GetAttackedUnitBJ(), GetAttacker(), ( udg_Dm[1] * 0.01 ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL )
    else
        if ( Trig_____________________________________001_Copy_Func004Func001C() ) then
            call UnitDamageTargetBJ( GetAttackedUnitBJ(), GetAttacker(), ( udg_Dm[1] * 0.02 ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL )
        else
            if ( Trig_____________________________________001_Copy_Func004Func001Func001C() ) then
                call UnitDamageTargetBJ( GetAttackedUnitBJ(), GetAttacker(), ( udg_Dm[1] * 0.03 ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL )
            else
                if ( Trig_____________________________________001_Copy_Func004Func001Func001Func001C() ) then
                    call UnitDamageTargetBJ( GetAttackedUnitBJ(), GetAttacker(), ( udg_Dm[1] * 0.04 ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL )
                else
                endif
            endif
        endif
    endif
endfunction

