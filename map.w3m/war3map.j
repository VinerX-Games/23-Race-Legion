//===========================================================================
// Trigger: UpgradeBuildings
//===========================================================================
function Trig_UpgradeBuildings_Conditions takes nothing returns boolean
    return udg_AiControl[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))] == true
endfunction

function Trig_UpgradeBuildings_Actions takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local integer id = GetUnitTypeId(u)
    local integer pi = GetPlayerId(GetOwningPlayer(u))
    
    
    
    //call DisplayTimedTextFromPlayer(Player(0),0,0, 4,"Апгрейд замечен")
    call NumberAdd(pi,id)
    
    
//Алый Орден

    if AiRace[pi]=="Scarlet" then
        if id =='h05V' then
            call NumberRem(pi,'h05U')        
        elseif id =='h05W' then
            call NumberRem(pi,'h05V')
        endif
    elseif AiRace[pi]=="BloodElves" then
        if id =='h04B' then
            call NumberRem(pi,'h04C')        
        elseif id =='h05A' then
            call NumberRem(pi,'h04B')
        endif
    endif
    
    set u = null
endfunction

