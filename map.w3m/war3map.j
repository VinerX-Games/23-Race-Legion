    local location l = GetUnitRallyPoint(GetTriggerUnit())
    local unit u
    local integer pi = GetPlayerId(p)
    set a[0]=0
    
    //1 юнит
    if GetPlayerTechCount(p,'R0E9',true)<1 then 
        
        set i = 4
        loop //Знахарь
                set a[0] = a[0] + 1
                set a[ a[0] ] = 'o024'
                set b = b + 1
                exitwhen b >= i
        endloop
    else
        
        set i = 3
        loop //Темный маг
                set a[0] = a[0] + 1
                set a[ a[0] ] = 'o02L'
                set b = b + 1
                exitwhen b >= i
        endloop
    
    
    
    
    endif
    
    // Ведьмак
    if GetPlayerTechCount(p,'R0D2',true) >= 1 and GetPlayerTechCount(p,'R0E9',true) != 1 then
        set i = 1 
        set b = 2
        
        loop
            set a[0] = a[0] + 1
            set a[ a[0] ] = 'o025'
            
            set b = b + 1
            exitwhen b >= i
        endloop

    endif
    
    // Медик
    if GetPlayerTechCount(p,'R0E4',true) >= 1 then
        set i = 1 
        set b = 2
        
        loop
            set a[0] = a[0] + 1
            set a[ a[0] ] = 'o02I'
            
            set b = b + 1
            exitwhen b >= i
        endloop

    endif
    
    // Killer
    if GetPlayerTechCount(p,'R0D3',true) == 1 and GetPlayerTechCount(p,'R0E9',true) != 1 then
        set i = 1 
        set b = 2
        
        loop
            set a[0] = a[0] + 1
            set a[ a[0] ] = 'h0IH'
            
            set b = b + 1
            exitwhen b >= i
        endloop

    endif
    
    set i = GetRandomInt(1,a[0])
    set b = a[i]
    
    set u = ReplaceUnit( GetTrainedUnit(), b , bj_UNIT_STATE_METHOD_RELATIVE )
    
    
    
    call UnitAddAbility(u,'A0UY')
    call SetUnitAbilityLevel(u,'OR00',35+udg_HordeMagicPrice[pi])
    
    
    set udg_UnitsCount[pi]=udg_UnitsCount[pi]-1
    
    call UnitAddAbility(u,'A0YU')
    call IssuePointOrderLoc( u, "attack", l )
    call RemoveLocation(l)
    set p = null
    set u = null
endfunction

