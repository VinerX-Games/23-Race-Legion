function InitTrig_UnitIncomeUpgrade takes nothing returns nothing
    set gg_trg_UnitIncomeUpgrade = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_UnitIncomeUpgrade, EVENT_PLAYER_UNIT_UPGRADE_FINISH )
    call TriggerAddCondition( gg_trg_UnitIncomeUpgrade, Condition( function Trig_UnitIncomeUpgrade_Conditions ) )
    call TriggerAddAction( gg_trg_UnitIncomeUpgrade, function Trig_UnitIncomeUpgrade_Actions )
endfunction


//===========================================================================
// Trigger: Gob Potreblenie
//
// Цена за нефть)
//===========================================================================
function Trig_Gob_Potreblenie_Conditions takes nothing returns boolean
    return GetResearched() == 'R04N'
endfunction

function Trig_Gob_Potreblenie_Func001002 takes nothing returns boolean
    return GetUnitAbilityLevel(GetFilterUnit(),'A0A5') != 0
endfunction


function Trig_Gob_Potreblenie_Actions takes nothing returns nothing
    local group g = CreateGroup()
    local player p = GetOwningPlayer(GetTriggerUnit())
    local integer pi = GetPlayerId(p)
    local unit u
    local integer r = GetPlayerTechCount(p,'R04N',true)
    set udg_Boolexpr = Condition(function Trig_Gob_Potreblenie_Func001002)
    call GroupEnumUnitsOfPlayer( g, p, udg_Boolexpr )
    loop
        set u = FirstOfGroup(g)
        exitwhen u==null
        
        set udg_Price = GetUnitGoldCost(GetUnitTypeId(u))
        if GetUnitAbilityLevel(u,'A0A5') != 0 then
            set disincome[pi] = disincome[pi] - ( udg_Price * 0.10 ) * ( 1.60 - ( 0.10 * (r-1) )  )   
            set disincome[pi] = disincome[pi] + ( udg_Price * 0.10 ) * ( 1.60 - ( 0.10 *  r    )  )  
        endif
        
        
        
        call GroupRemoveUnit(g,u)
    endloop
    call UpdateGraf(pi)
    call GroupClear( udg_LocalOtrad2 )
    
    call GroupClear(g)
    call DestroyGroup(g)
    set u = null
    set g = null
    set p = null
endfunction

//===========================================================================
function InitTrig_Gob_Potreblenie takes nothing returns nothing
    set gg_trg_Gob_Potreblenie = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Gob_Potreblenie, EVENT_PLAYER_UNIT_RESEARCH_FINISH )
    call TriggerAddCondition( gg_trg_Gob_Potreblenie, Condition( function Trig_Gob_Potreblenie_Conditions ) )
    call TriggerAddAction( gg_trg_Gob_Potreblenie, function Trig_Gob_Potreblenie_Actions )
endfunction


//===========================================================================
// Trigger: Silitid Potreblenie
//
// Цена за нефть)
//===========================================================================
function Trig_Silitid_Potreblenie_Conditions takes nothing returns boolean
    return GetResearched() == 'R089'
endfunction

function HaveSilitidSpell takes nothing returns boolean
    return GetUnitTypeId(GetFilterUnit())=='e02W'
    //return ( GetUnitAbilityLevelSwapped('A0VH', GetFilterUnit()) >=1 )
endfunction


function Trig_Silitid_Potreblenie_Actions takes nothing returns nothing
    local group g = CreateGroup()
    local player p = GetOwningPlayer(GetTriggerUnit())
    local integer pi = GetPlayerId(p)
    local unit u
    local integer r = GetPlayerTechCount(p,'R04N',true)
    set udg_Boolexpr = Condition(function HaveSilitidSpell)
    call GroupEnumUnitsOfPlayer( g, p, udg_Boolexpr )
    loop
        set u = FirstOfGroup(g)
        exitwhen u==null
        
        set udg_Price = GetUnitGoldCost(GetUnitTypeId(u))
        set disincome[pi] = disincome[pi] - ( udg_Price * 0.05  )
        set disincome[pi] = disincome[pi] + ( udg_Price * 0.033  )

        call GroupRemoveUnit(g,u)
    endloop
    call GroupClear( udg_LocalOtrad2 )
    call UpdateGraf(pi)
    call GroupClear(g)
    call DestroyGroup(g)
    set u = null
    set g = null
    set p = null
endfunction

//===========================================================================
function InitTrig_Silitid_Potreblenie takes nothing returns nothing
    set gg_trg_Silitid_Potreblenie = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Silitid_Potreblenie, EVENT_PLAYER_UNIT_RESEARCH_FINISH )
    call TriggerAddCondition( gg_trg_Silitid_Potreblenie, Condition( function Trig_Silitid_Potreblenie_Conditions ) )
    call TriggerAddAction( gg_trg_Silitid_Potreblenie, function Trig_Silitid_Potreblenie_Actions )
endfunction


//===========================================================================
// Trigger: DeadAddCheck
//===========================================================================
globals
    group DeadGroup = CreateGroup()

endglobals

function DeadAddCheck_Conditions takes nothing returns boolean
        return GetTriggerUnit()!=null and GetUnitAbilityLevel(GetEnteringUnit(),'A0Z5')==0

endfunction

function Trig_DeadAddCheck_Actions takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local player p = GetOwningPlayer(u)
    local integer pi = GetPlayerId(p)
    local integer i = 0 


    //Убираю его инком
   // call DisplayTextToPlayer(p,0,0,("Увидел смерть "+GetUnitName(u)))
    //Здание
    if IsUnitType(u, UNIT_TYPE_STRUCTURE) then
        if IsUnitInGroup(u, udg_BuildedSctructure[1]) then
            set income[pi] = income[pi] - I2R(GetUnitFoodMade(u)) 
            if GetUnitAbilityLevel(u,'A0AY') >= 1 then
                    set income[pi] = ( income[pi] - ( 100.00 * I2R(GetUnitAbilityLevel(u,'A0AY')) ) )
            elseif GetUnitAbilityLevel(u,'A0SM') >= 1 then
                set income[pi] = ( income[pi] - ( 75.00 * I2R(GetUnitAbilityLevel(u,'A0SM')) ) )
            endif
            
            if GetUnitAbilityLevel(u,'A0VS') == 1 then
                set income[pi] = ( income[pi] - 100 )
            endif
            
            set i = GetUnitAbilityLevel(u, 'A0B5')
            if i>0 then
                set incomeW[pi] =  incomeW[pi] - ( 50.00 * i ) 
            endif
        endif
    //Гер
    elseif IsUnitType(u, UNIT_TYPE_HERO) then
            set disincome[pi] = ( disincome[pi] - 100.00 )
            if  GetUnitAbilityLevel(u,'A0ZT')!=0 then        
                    set income[pi] = income[pi] - (100+GetUnitAbilityLevel(u,'A0ZT')*100)
            endif
    //юнит
    elseif GetTriggerUnit()!=null then
    
            if not IsUnitType(u, UNIT_TYPE_SUMMONED) then
               // call DisplayTextToPlayer(p,0,0,("Увидел смерть до юнита "+GetUnitName(u)))
                set udg_Price = GetUnitGoldCost(GetUnitTypeId(u))
                set disincome[pi] = ( disincome[pi] - ( udg_Price * 0.10 ) )
                
                // ---------------------------Особые условия-----------------------------          +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
                // ---------------------------Топливо гоблинов-----------------------------
                if GetUnitAbilityLevel(u,'A0A5') != 0 then
                    set disincome[pi] = disincome[pi] - ( ( udg_Price * 0.10 ) * ( 1.60 - ( 0.10 * I2R(GetUnitAbilityLevel(u,'A0A5')) ) ) )

                // ---------------------------Поколения Силитидов------------------------- ??
                elseif GetUnitAbilityLevel(u,'A0VH') == 1 then
                    set disincome[pi] = disincome[pi] + ( udg_Price * 0.05  )
                elseif GetUnitAbilityLevel(u,'A0VH') == 2 then
                    set disincome[pi] = disincome[pi] + ( udg_Price * 0.066  )
                elseif  GetUnitAbilityLevel(u,'OR00')!=0 then
                    set disincome[pi] = disincome[pi] - (( udg_Price * 0.10 ) * (( GetUnitAbilityLevel(u,'OR00')-35 )/100.0))
                    //Horde land
                elseif  GetUnitAbilityLevel(u,'OR00')!=0 then                  
                    set disincome[pi] = disincome[pi] - ( ( udg_Price * 0.10 ) * ( ( GetUnitAbilityLevel(u,'OR00')-35 )/100.0) )
                
                endif
            endif
    endif
    
    call UpdateGraf(pi)
    
    


    call SetUnitLifeBJ( u,0 )
    if not IsUnitInGroup(u,DeadGroup) then
        call GroupAddUnit(DeadGroup,u)
        call TriggerRegisterUnitStateEvent(gg_trg_DeadRessurected, u, UNIT_STATE_LIFE, GREATER_THAN, 0.01)
    endif
    set u = null
endfunction

//===========================================================================
function InitTrig_DeadAddCheck takes nothing returns nothing
    set gg_trg_DeadAddCheck = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_DeadAddCheck, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_DeadAddCheck, Condition( function DeadAddCheck_Conditions ) )
    call TriggerAddAction( gg_trg_DeadAddCheck, function Trig_DeadAddCheck_Actions )
endfunction


//===========================================================================
// Trigger: DeadRessurected
//===========================================================================
function Trig_DeadRessurected_Conditions takes nothing returns boolean
    return UnitAlive(GetTriggerUnit()) and not IsUnitType(GetTriggerUnit(), UNIT_TYPE_SUMMONED) // GetUnitAbilityLevel(GetTriggerUnit(), 'BUan') <= 0 and
endfunction

function Trig_DeadRessurected_Actions takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local player p = GetOwningPlayer(u)
    local integer pi = GetPlayerId(p)
    
   

    set udg_UnitsCount[pi]=udg_UnitsCount[pi]+1

    call Enter(u)
    
    if IsUnitType(u, UNIT_TYPE_HERO) then
        set disincome[pi] = ( disincome[pi] + 100.00 )
        if  GetUnitAbilityLevel(u,'A0ZT')!=0 then        
            set income[pi] = income[pi] + (100+GetUnitAbilityLevel(u,'A0ZT')*100)
       
        endif
    else
        set udg_Price = GetUnitGoldCost(GetUnitTypeId(u))
        set disincome[pi] = ( disincome[pi] + ( udg_Price * 0.10 ) )
        
        // ---------------------------Особые условия-----------------------------          +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        // ---------------------------Топливо гоблинов-----------------------------
        if GetUnitAbilityLevel(u,'A0A5') != 0 then
            set disincome[pi] = disincome[pi] + ( ( udg_Price * 0.10 ) * ( 1.60 - ( 0.10 * I2R(GetUnitAbilityLevel(u,'A0A5')) ) ) )

        // ---------------------------Поколения Силитидов-------------------------
        elseif GetUnitAbilityLevel(u,'A0VH') == 1 then
            set disincome[pi] = disincome[pi] + ( udg_Price * 0.05  )
        elseif GetUnitAbilityLevel(u,'A0VH') == 2 then
            set disincome[pi] = disincome[pi] + ( udg_Price * 0.033  )
        
         //Horde land
        elseif  GetUnitAbilityLevel(u,'OR00')!=0 then
            set disincome[pi] = disincome[pi] + ( udg_Price * 0.10 ) * (( GetUnitAbilityLevel(u,'OR00')-35 )/100)
        endif
    endif


    call UpdateGraf(pi)




endfunction

//===========================================================================
function InitTrig_DeadRessurected takes nothing returns nothing
    set gg_trg_DeadRessurected = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_DeadRessurected, Condition( function Trig_DeadRessurected_Conditions ) )
    call TriggerAddAction( gg_trg_DeadRessurected, function Trig_DeadRessurected_Actions )
endfunction


