	call BlzFrameSetAbsPoint(fh, FRAMEPOINT_BOTTOMLEFT, 0.214, 0.116)
	call BlzFrameSetAbsPoint(fh, FRAMEPOINT_TOPRIGHT, 0.234, 0.136)
	call BlzFrameSetTexture(fh, "UI\\ButtonBorder.dds", 0, true)
