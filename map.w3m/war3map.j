//===========================================================================
function Trig_NoToMuch_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A00I' ) ) then
        return false
    endif
    return true
endfunction

function Trig_NoToMuch_Func003002 takes nothing returns boolean
    return ( GetUnitAbilityLevelSwapped('A00I', GetFilterUnit()) == 1 )
endfunction

function Trig_NoToMuch_Func005A takes nothing returns nothing
    call BlzStartUnitAbilityCooldown( GetEnumUnit(), 'A00I', 1.00 )
endfunction

