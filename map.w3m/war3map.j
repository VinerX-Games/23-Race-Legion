    elseif i2 == 14 then
        set udg_LocalPoint = Location(-20987,6727)
    elseif i2 == 15 then
        set udg_LocalPoint = Location(-21110,16964)
    elseif i2 == 16 then
        set udg_LocalPoint = Location(-15631,24064)
