//===========================================================================
// Trigger: GnomeNotToMuch
//===========================================================================
function Trig_GnomeNotToMuch_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0SG'
endfunction

function Type_1 takes nothing returns boolean
    return GetUnitTypeId(GetFilterUnit()) == 'h0FL'
endfunction


function FG takes nothing returns nothing
    local integer pi = GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
    call BlzEndUnitAbilityCooldown( GetEnumUnit(), 'A0SG' )
    call IssueImmediateOrder( GetEnumUnit(), "ravenform" )
    set income[pi] = ( income[pi]-30 )
endfunction


function Trig_GnomeNotToMuch_Actions takes nothing returns nothing
    local player p = GetOwningPlayer(GetTriggerUnit())
    local integer pi = GetPlayerId(p)
    local integer Tl = udg_TierLevel[GetConvertedPlayerId(p)]
    set udg_Boolexpr = Condition(function Type_1)
    
    if GetUnitTypeId(GetTriggerUnit()) != 'h0FL' then // наоборот для теста
        set income[pi] = ( income[pi]+30 )
        
        
        set udg_LocalText2 = "Превышен лимит. Некоторые башни сменили режим."
        call GroupEnumUnitsOfPlayer( udg_LocalOtrad, p, udg_Boolexpr )
        set udg_LocalInteger = CountUnitsInGroup(udg_LocalOtrad)
        if Tl == 1 and udg_LocalInteger >= 15 then
        
            call DisplayTimedTextToPlayer( p, 0, 0,7, udg_LocalText2 )
            
            set udg_LocalInteger2 = ( udg_LocalInteger - 15+1 )
            set udg_LocalOtrad2 = GetRandomSubGroup( udg_LocalInteger2, udg_LocalOtrad)
            call ForGroupBJ( udg_LocalOtrad2, function FG )
        elseif  Tl == 2 and udg_LocalInteger >= 30 then
        
            call DisplayTimedTextToPlayer( p, 0, 0,7, udg_LocalText2 )
            set udg_LocalInteger2 = ( udg_LocalInteger - 30+1 )
            set udg_LocalOtrad2 = GetRandomSubGroup( udg_LocalInteger2, udg_LocalOtrad)
            call ForGroupBJ( udg_LocalOtrad2, function FG )
        elseif  Tl == 3 and udg_LocalInteger >= 45 then
        
            call DisplayTimedTextToPlayer( p, 0, 0,7, udg_LocalText2 )
           
            set udg_LocalInteger2 = ( udg_LocalInteger - 45+1 )
            set udg_LocalOtrad2 = GetRandomSubGroup( udg_LocalInteger2, udg_LocalOtrad)
            call ForGroupBJ( udg_LocalOtrad2, function FG )
                
        else 
            //nothing
        
        endif
        call GroupClear( udg_LocalOtrad )
        call GroupClear( udg_LocalOtrad2 )
    else
        set income[pi] =  income[pi]-30 
    endif
    
    
    call UpdateGraf(pi)
    
endfunction

