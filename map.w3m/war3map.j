// Перебор игроков
function PlayerArmy takes nothing returns nothing
    //Локалки
    local group g = CreateGroup()
    local player p = null
    local integer i
    local integer b
    local integer pi

    //Локалки
    
    //Каждый отдельный игрок
    //Узнаю номер игрока
    set b= CountPlayersInForceBJ(udg_BotsActive)
    //if CountPlayersInForceBJ(udg_BotsActive)==0 then
    if b==0 then
        call PauseTimer( udg_PlayerGet1 )
        call ResumeTimer(udg_TimerSmall2)
        call TimerStart( udg_TimerSmall2, 2.12*AiRepeat/5, false, null )
        if udg_Octhet then
            call DisplayTimedTextFromPlayer(Player(0),0,0, 4,"Заканчиваю перебор игроков для армии")
        endif

    else
        
        set p = ForcePickRandomPlayer(udg_BotsActive)

        call ForceRemovePlayer(udg_BotsActive,p)
        set pi = GetPlayerId(p)
        
        set LazyCount=0
        call GroupEnumUnitsOfPlayer(g,p,B_Lazy)
        
        if FirstOfGroup(g)!= null then
            set udg_LocalInteger = 1
            
            loop
                exitwhen udg_LocalInteger > AiMass or FirstOfGroup(g)==null

                //set udg_LocalUnit2 = GroupPickRandomUnit(g)
                
                set udg_LocalUnit2 = BlzGroupUnitAt(g,GetRandomInt(0,LazyCount))
                
                
                call GroupRemoveUnit( g, udg_LocalUnit2)
                          
                // Дровосеки
                if GetUnitTypeId(udg_LocalUnit2) == 'h03C' then
                    set i = GetRandomInt(1,2)
                    if i == 1 then 
                        call IssueImmediateOrder( udg_LocalUnit2, "autoharvestlumber" )
                    else
                        
                        call ExecuteFunc("TryAttack")
                    endif
                else
                    
                    call ExecuteFunc("TryAttack")
                endif
                
                set udg_LocalInteger = udg_LocalInteger + 1
            endloop
            call GroupClear(g)
            set p = null
        endif
    endif
    
    
    
    call DestroyGroup(g)
    set g = null
endfunction
