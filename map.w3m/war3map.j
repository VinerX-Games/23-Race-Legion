            set a[ a[0] ] = 'h0M8'
            
            set b = b + 1
            exitwhen b >= i
        endloop
    endif

    
    //Long Containment
    call SaveInteger(CommonHash,pi,StringHash("AM3_0"),a[0])
    set i = 1
    loop
        
        
        call SaveInteger(CommonHash,pi, StringHash("AM3")+i,a[i])
        set i=i+1
        
        exitwhen i >a[0]
