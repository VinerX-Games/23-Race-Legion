//===========================================================================
function Trig_PodruvResearc_Conditions takes nothing returns boolean
    if ( not ( GetResearched() == 'R04Q' ) ) then
        return false
    endif
    return true
endfunction

function Trig_PodruvResearc_Func001C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R04Q', GetOwningPlayer(GetTriggerUnit())) == 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_PodruvResearc_Func002002 takes nothing returns boolean
    return ( GetUnitAbilityLevelSwapped('A0A9', GetFilterUnit()) != 0 )
endfunction

function Trig_PodruvResearc_Func005A takes nothing returns nothing
    call SetUnitAbilityLevelSwapped( 'A0A9', GetEnumUnit(), ( GetPlayerTechCountSimple('R04Q', GetOwningPlayer(GetTriggerUnit())) + 1 ) )
endfunction

function Trig_PodruvResearc_Actions takes nothing returns nothing
    if ( Trig_PodruvResearc_Func001C() ) then
        call SetPlayerAbilityAvailableBJ( false, 'A0A9', GetOwningPlayer(GetTriggerUnit()) )
        return
    else
    endif
    set udg_Boolexpr = Condition(function Trig_PodruvResearc_Func002002)
    set udg_LocalPlayer = GetOwningPlayer(GetTriggerUnit())
    call GroupEnumUnitsOfPlayer( udg_LocalOtrad2, udg_LocalPlayer, udg_Boolexpr )
    call ForGroupBJ( udg_LocalOtrad2, function Trig_PodruvResearc_Func005A )
    call GroupClear( udg_LocalOtrad2 )
endfunction

//===========================================================================
function InitTrig_PodruvResearc takes nothing returns nothing
    set gg_trg_PodruvResearc = CreateTrigger(  )
    call DisableTrigger( gg_trg_PodruvResearc )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_PodruvResearc, EVENT_PLAYER_UNIT_RESEARCH_FINISH )
