function AddPlayers2 takes nothing returns nothing
    call ForceAddPlayer(udg_BotsActiveB,GetEnumPlayer())
endfunction

function Trig_PereborPlayersForBuilders_Actions takes nothing returns nothing
    call PauseTimer(udg_TimerSmall)
    if udg_Octhet then
        call DisplayTimedTextFromPlayer(Player(0),0,0,4,"Начинаю перебор игроков для строителей")
    endif
    call ForForce(udg_Bots,function AddPlayers2)
    call TimerStart( udg_PlayerGet2, 1.11, true, null )
endfunction




