    set gg_trg_KM3 = CreateTrigger(  )
    call DisableTrigger(gg_trg_KM3)
    call TriggerRegisterAnyUnitEventBJ( gg_trg_KM3, EVENT_PLAYER_UNIT_TRAIN_FINISH )
    call TriggerAddCondition( gg_trg_KM3, Condition( function Trig_KM3_Conditions ) )
