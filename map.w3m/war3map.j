//===========================================================================
// Trigger: Initial things
//
// Все штуки которые должны быть включены при инициализации
//===========================================================================
function Trig_Initial_things_Func002A takes nothing returns nothing
    call CreateFogModifierRectBJ( true, GetEnumPlayer(), FOG_OF_WAR_VISIBLE, gg_rct_Shops )
    call CameraSetupApplyForPlayer( true, gg_cam_Camera_001, GetEnumPlayer(), 0 )
    call SetPlayerStateBJ( GetEnumPlayer(), PLAYER_STATE_RESOURCE_LUMBER, 4000 )
    call SetPlayerStateBJ( GetEnumPlayer(), PLAYER_STATE_RESOURCE_GOLD, 5000 )
    call SetPlayerStateBJ( GetEnumPlayer(), PLAYER_STATE_FOOD_CAP_CEILING, 3 )
    call SetPlayerStateBJ( GetEnumPlayer(), PLAYER_STATE_RESOURCE_FOOD_USED, 0 )
    call CreateFogModifierRectBJ( true, GetEnumPlayer(), FOG_OF_WAR_MASKED, GetPlayableMapRect() )
    set udg_Visibl[GetConvertedPlayerId(GetEnumPlayer())] = GetLastCreatedFogModifier()
endfunction

function Trig_Initial_things_Func019A takes nothing returns nothing
    call SetPlayerAbilityAvailableBJ( false, 'A0IQ', GetEnumPlayer() )
    call SetPlayerAllianceStateBJ( GetEnumPlayer(), Player(12), bj_ALLIANCE_UNALLIED )
    call SetPlayerAllianceStateBJ( Player(12), GetEnumPlayer(), bj_ALLIANCE_UNALLIED )
endfunction

function Trig_Initial_things_Actions takes nothing returns nothing
    set udg_AllPlayers = GetPlayersAll()
    call ForForce( udg_AllPlayers, function Trig_Initial_things_Func002A )
    call SetPlayerStateBJ( Player(PLAYER_NEUTRAL_AGGRESSIVE), PLAYER_STATE_RESOURCE_GOLD, 100000000 )
    call SetPlayerStateBJ( Player(PLAYER_NEUTRAL_AGGRESSIVE), PLAYER_STATE_RESOURCE_LUMBER, 100000000 )
    call SetPlayerStateBJ( Player(PLAYER_NEUTRAL_PASSIVE), PLAYER_STATE_RESOURCE_GOLD, 100000 )
    call SetPlayerStateBJ( Player(PLAYER_NEUTRAL_PASSIVE), PLAYER_STATE_RESOURCE_LUMBER, 100000 )
    call StartInc()
    call InitThings()
    // ------------------------------------------
    call SetPlayerColorBJ( Player(12), ConvertPlayerColor(24), true )
    call SetPlayerColorBJ( Player(15), ConvertPlayerColor(24), true )
    call SetMapFlag( MAP_LOCK_RESOURCE_TRADING, false )
    call SetMapFlag( MAP_LOCK_ALLIANCE_CHANGES, false )
    call SetMapFlag( MAP_ALLIANCE_CHANGES_HIDDEN, false )
    call SetMapFlag( MAP_LOCK_RESOURCE_TRADING, false )
    call SetGameSpeed( MAP_SPEED_FASTEST )
    call ForForce( udg_AllPlayers, function Trig_Initial_things_Func019A )
endfunction

