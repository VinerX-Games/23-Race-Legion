function Trig_AllPlayers_and_vassals_Actions takes nothing returns nothing
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 24
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call DisplayTextToForce( GetPlayersAll(), GetPlayerName(ConvertedPlayer(GetForLoopIndexA())) )
        call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_19436" )
        call DisplayTextToForce( GetPlayersAll(), I2S(CountPlayersInForceBJ(udg_Vassals[GetConvertedPlayerId(ConvertedPlayer(GetForLoopIndexA()))])) )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

