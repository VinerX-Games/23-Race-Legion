function Trig_ChoseUnits2_Actions takes nothing returns nothing
    set udg_LocalPosition2 = GetUnitLoc(GetTriggerUnit())
    set udg_LocalPosition3 = GetSpellTargetLoc()
    set udg_Boolexpr = Condition(function Trig_ChoseUnits_COD_2_Func003002)
    call GroupEnumUnitsInRangeOfLoc(udg_LocalOtrad2, udg_LocalPosition2, 400,udg_Boolexpr)
    call GroupPointOrderLocBJ( udg_LocalOtrad2, "attack", udg_LocalPosition3 )
    call GroupClear( udg_LocalOtrad2 )
    // --
    set udg_Boolexpr = Condition(function Trig_ChoseUnits_COD_2_Func008002)
    call GroupEnumUnitsInRangeOfLoc(udg_LocalOtrad2, udg_LocalPosition2, 400,udg_Boolexpr)
    call GroupPointOrderLocBJ( udg_LocalOtrad2, "attack", udg_LocalPosition3 )
    call GroupClear( udg_LocalOtrad2 )
    // --
//    set udg_Boolexpr = Condition(function A1)
//    call GroupEnumUnitsInRangeOfLoc(udg_LocalOtrad2, udg_LocalPosition2, 400,udg_Boolexpr)
//    call GroupPointOrderLocBJ( udg_LocalOtrad2, "attack", udg_LocalPosition3 )
//    call GroupClear( udg_LocalOtrad2 )
    // --
    set udg_Boolexpr = Condition(function A2)
    call GroupEnumUnitsInRangeOfLoc(udg_LocalOtrad2, udg_LocalPosition2, 400,udg_Boolexpr)
    call GroupPointOrderLocBJ( udg_LocalOtrad2, "attack", udg_LocalPosition3 )
    call GroupClear( udg_LocalOtrad2 )
    // --
    set udg_Boolexpr = Condition(function A3)
    call GroupEnumUnitsInRangeOfLoc(udg_LocalOtrad2, udg_LocalPosition2, 400,udg_Boolexpr)
    call GroupPointOrderLocBJ( udg_LocalOtrad2, "attack", udg_LocalPosition3 )
    call GroupClear( udg_LocalOtrad2 )
    // --
    set udg_Boolexpr = Condition(function A4)
    call GroupEnumUnitsInRangeOfLoc(udg_LocalOtrad2, udg_LocalPosition2, 400,udg_Boolexpr)
    call GroupPointOrderLocBJ( udg_LocalOtrad2, "attack", udg_LocalPosition3 )
    call GroupClear( udg_LocalOtrad2 )
    // --
    set udg_Boolexpr = Condition(function A5)
    call GroupEnumUnitsInRangeOfLoc(udg_LocalOtrad2, udg_LocalPosition2, 400,udg_Boolexpr)
    call GroupPointOrderLocBJ( udg_LocalOtrad2, "attack", udg_LocalPosition3 )
    call GroupClear( udg_LocalOtrad2 )
    // --
    set udg_Boolexpr = Condition(function A6)
    call GroupEnumUnitsInRangeOfLoc(udg_LocalOtrad2, udg_LocalPosition2, 400,udg_Boolexpr)
    call GroupPointOrderLocBJ( udg_LocalOtrad2, "attack", udg_LocalPosition3 )
    call GroupClear( udg_LocalOtrad2 )
    // --
    set udg_Boolexpr = Condition(function A7)
