//===========================================================================
// Trigger: Samopodruv
//===========================================================================
function Trig_Samopodruv_Func004C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0A9', GetAttacker()) >= 1 ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A0A9', GetAttacker()) <= 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Samopodruv_Conditions takes nothing returns boolean
    if ( not Trig_Samopodruv_Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_Samopodruv_Func003C takes nothing returns boolean
    if ( not ( udg_LocalInteger <= ( 35 + ( -5 * GetUnitAbilityLevelSwapped('A0A9', GetAttacker()) ) ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Samopodruv_Actions takes nothing returns nothing
    local texttag t
    set udg_LocalInteger = GetRandomInt(1, 100)
    if ( Trig_Samopodruv_Func003C() ) then
        call SetUnitLifeBJ( GetAttacker(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetAttacker()) - 15.00 ) )
        call CreateTextTagUnitBJ( "TRIGSTR_7897", GetAttacker(), -20.00, 5.00, 100, 100, 100, 0.00 )
        set udg_LocalText = GetLastCreatedTextTag()
        call SetTextTagPermanentBJ( udg_LocalText, false )
        call SetTextTagLifespanBJ( udg_LocalText, 2.00 )
        call SetTextTagFadepointBJ( udg_LocalText, 2.00 )
        call SetTextTagVelocityBJ( udg_LocalText, 75.00, 90 )
        set t = udg_LocalText
        call TriggerSleepAction( 2.00 )
        set udg_LocalText = t
        call DestroyTextTagBJ( udg_LocalText )
        set t = null
    else
    endif
endfunction

//===========================================================================
function InitTrig_Samopodruv takes nothing returns nothing
    set gg_trg_Samopodruv = CreateTrigger(  )
    call DisableTrigger( gg_trg_Samopodruv )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Samopodruv, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_Samopodruv, Condition( function Trig_Samopodruv_Conditions ) )
    call TriggerAddAction( gg_trg_Samopodruv, function Trig_Samopodruv_Actions )
endfunction

