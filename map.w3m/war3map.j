    if ( not ( GetUnitAbilityLevelSwapped('A0VI', GetKillingUnitBJ()) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_UpSystem_Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0VI', GetKillingUnitBJ()) >= 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_UpSystem_Actions takes nothing returns nothing
    if ( Trig_UpSystem_Func001C() ) then
        set udg_LocalUnit2 = GetKillingUnitBJ()
        call ReplaceUnit( udg_LocalUnit2, 'h0HE', bj_UNIT_STATE_METHOD_RELATIVE )
    else
        call IncUnitAbilityLevelSwapped( 'A0VI', GetKillingUnitBJ() )
    endif
endfunction

