function InitTrig_BerserkOrc takes nothing returns nothing
    set gg_trg_BerserkOrc = CreateTrigger(  )
    //call DisableTrigger( gg_trg_BerserkOrc )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_BerserkOrc, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_BerserkOrc, Condition( function Trig_BerserkOrc_Conditions ) )
    call TriggerAddAction( gg_trg_BerserkOrc, function Trig_BerserkOrc_Actions )
