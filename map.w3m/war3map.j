//***************************************************************************
//*  CreateRaceCircles
function CreateRaceCircles takes player p returns nothing
    local location l = RandomLoc()
    call CreateUnitAtLoc(p,'h0HJ',l,0)
    call PanCameraToTimedLocForPlayer( p, l, 0 )
    call RemoveLocation(l)
    set l= null
endfunction
//***************************************************************************
//*  GL NEP
globals
    real array income
    real array incomeW
    real array disincome
    real array logistic
    real array corruption
    real array balance
    real array additional
    region Allmap = CreateRegion()
endglobals




function StartInc takes nothing returns nothing
    
    local integer i = 0
        loop
            exitwhen i >= 24
            set income[i] = 0
            set incomeW[i] = 0
            set disincome[i] = 0
            set logistic[i] = 0
            set corruption[i] = 0
            set balance[i] = 0
            set additional[i] = 0
            set i = i + 1
        endloop
    call RegionAddRect(Allmap,GetWorldBounds())
    
endfunction
//***************************************************************************
//*  Enter
function Enter takes unit u returns nothing
    local integer id = GetUnitTypeId(u)
    local player p = GetOwningPlayer(u)
    local integer pi = GetPlayerId( p )
    
    
    
    call MultiboardSetItemValue( MultiboardItem[ MultiboardItemOwnerIndex[ pi] * 2 + 1 ], I2S( udg_UnitsCount[ pi ] ) )
    

    set p = null
endfunction
//***************************************************************************
//*  CountAddDis
function AddCountDis takes unit u, integer pi returns nothing


    if not (GetUnitAbilityLevel(u, 'BUan') > 0 or u==null or IsUnitType(u, UNIT_TYPE_STRUCTURE) or IsUnitType(u, UNIT_TYPE_SUMMONED) ) then
                
                //set udg_UnitsCount[pi]=udg_UnitsCount[pi]+1
                
                call Enter(u)
                if IsUnitType(u, UNIT_TYPE_HERO) == true then
                    set disincome[pi] = ( disincome[pi] + 100.00 )
               
               
                else
                    set udg_Price = GetUnitGoldCost(GetUnitTypeId(u))
                    set disincome[pi] = ( disincome[pi] + ( udg_Price * 0.10 ) )
                  
                    // Гоблины
                    if GetUnitAbilityLevel(u,'A0A5') != 0 then
                        set disincome[pi] = disincome[pi] + ( ( udg_Price * 0.10 ) * ( 1.60 - ( 0.10 * I2R(GetUnitAbilityLevel(u,'A0A5')) ) ) )

                    // ---------------------------Поколения Силитидов-------------------------
                    elseif GetUnitAbilityLevel(u,'A0VH') == 1 then
                        set disincome[pi] = disincome[pi] - ( udg_Price * 0.05  )
                    elseif GetUnitAbilityLevel(u,'A0VH') == 2 then
                        set disincome[pi] = disincome[pi] - ( udg_Price * 0.066  )
                    
                    //Horde land
                    elseif  GetUnitAbilityLevel(u,'OR00')!=0 then                  
                        set disincome[pi] = disincome[pi] + ( ( udg_Price * 0.10 ) * ( ( GetUnitAbilityLevel(u,'OR00')-35 )/100.0) )
                    endif
                    
                    
                endif
    endif
            
    call UpdateGraf(pi)
    set u = null
endfunction


function DelCountDis takes unit u, integer pi returns nothing
     
    //юнит
    if u!=null and not IsUnitType(u, UNIT_TYPE_SUMMONED)  then

            set udg_Price = GetUnitGoldCost(GetUnitTypeId(u))
            set disincome[pi] = ( disincome[pi] - ( udg_Price * 0.10 ) )
            
            // ---------------------------Особые условия-----------------------------          +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
            // ---------------------------Топливо гоблинов-----------------------------
            if GetUnitAbilityLevel(u,'A0A5') != 0 then
                set disincome[pi] = disincome[pi] - ( ( udg_Price * 0.10 ) * ( 1.60 - ( 0.10 * I2R(GetUnitAbilityLevel(u,'A0A5')) ) ) )

            // ---------------------------Поколения Силитидов------------------------- ??
            elseif GetUnitAbilityLevel(u,'A0VH') == 1 then
                set disincome[pi] = disincome[pi] + ( udg_Price * 0.05  )
            elseif GetUnitAbilityLevel(u,'A0VH') == 2 then
                set disincome[pi] = disincome[pi] + ( udg_Price * 0.066  )
            elseif  GetUnitAbilityLevel(u,'OR00')!=0 then
                set disincome[pi] = disincome[pi] - (( udg_Price * 0.10 ) * (( GetUnitAbilityLevel(u,'OR00')-35 )/100.0))
            
            //Horde land
            elseif  GetUnitAbilityLevel(u,'OR00')!=0 then                  
                set disincome[pi] = disincome[pi] - ( ( udg_Price * 0.10 ) * ( ( GetUnitAbilityLevel(u,'OR00')-35 )/100.0) )
            endif
            
    endif
    
    call UpdateGraf(pi)
    
    
    set u = null
endfunction
//***************************************************************************
//*  TimedUpdate
function TimedUpdate takes unit u, player p returns boolean
    local integer pi = GetPlayerId(p)
    if GetOwningPlayer(u)==p and UnitAlive(u) then

        //Development
        call BlzStartUnitAbilityCooldown( u, 'A10G', 300 )
        //call BlzSetUnitAbilityCooldown(u,'A10G',1,300)
    
        //Golda
        if GetUnitAbilityLevel(u, 'A0AY') == 0 then
            call UnitAddAbility( u, 'A0AY'  )
            set income[pi] = income[pi]+100

            
        elseif GetUnitAbilityLevel(u, 'A0AY') <5 then
            set income[pi] = income[pi]+100
            call IncUnitAbilityLevel( u,'A0AY' )
            
        elseif GetUnitAbilityLevel(u, 'A0AY') >= 5 then
            set income[pi] = income[pi]+100
            call BlzUnitHideAbility( u, 'A0AZ', true )
            call BlzUnitDisableAbility( u, 'A0AZ', true, true )
            
        endif
        
        //Lumber
        if GetUnitAbilityLevel(u,'A0B5' ) == 0 then
            call UnitAddAbility( u,'A0B5'  )
            set incomeW[pi] =  incomeW[pi] + 50.00
        elseif GetUnitAbilityLevel(u,'A0B5' ) < 5 then
            call IncUnitAbilityLevel( u,'A0B5')
            set incomeW[pi] =  incomeW[pi] + 50.00
        elseif GetUnitAbilityLevel( u,'A0B5' ) >= 5 then
            call BlzUnitHideAbility( u, 'A0B1', true )
            call BlzUnitDisableAbility( u, 'A0B1', true, true )      
            
            
        endif
        
        if GetUnitAbilityLevel(u, 'A0AY')+GetUnitAbilityLevel( u,'A0B5' ) >= 10 then
            //Развитие
            call BlzUnitHideAbility( u, 'A10G', true ) 
            call BlzUnitDisableAbility( u, 'A10G', true, true )
        
        
        endif
        
        call UpdateGraf(pi)
        set u = null
        set p = null
        return true

    else 
        set u = null
        set p = null
        return false
    endif
endfunction
//***************************************************************************
//*  SubGroup2
globals
    group SubGroup2 = CreateGroup()
endglobals

function GetRandomSubGroup2 takes integer count, group sourceGroup returns group
    call GroupClear(SubGroup2)

    set bj_randomSubGroupGroup = SubGroup2
    set bj_randomSubGroupWant  = count
    set bj_randomSubGroupTotal = CountUnitsInGroup(sourceGroup)

    if (bj_randomSubGroupWant <= 0 or bj_randomSubGroupTotal <= 0) then
        return SubGroup2
    endif

    set bj_randomSubGroupChance = I2R(bj_randomSubGroupWant) / I2R(bj_randomSubGroupTotal)
    call ForGroup(sourceGroup, function GetRandomSubGroupEnum)
    return SubGroup2

endfunction

//***************************************************************************
//*  ChangeSpellLimit
//
//
//function OnlyFaselessFarms takes nothing returns boolean
//    return GetUnitTypeId(GetFilterUnit())=='u02E'
//
//endfunction
//
//
//
function FaselessFarmLimit takes player p returns nothing
    local integer i
    local integer NowLimit = GetPlayerTechMaxAllowed(p,'u02E')
    local group g = CreateGroup()
    //local boolexpr b = Condition(function OnlyFaselessFarms)
    set i = GetPlayerUnitTypeCount(p,'u02E')
    
    if i <= NowLimit then
        call SetPlayerAbilityAvailable(p,'A11G',true)
    else
        call SetPlayerAbilityAvailable(p,'A11G',false)
    endif
    
    
    call DestroyGroup(g)
    set g= null
endfunction
//***************************************************************************
//*  HordeLandUnits
function HordeLandUnits takes nothing returns boolean
    return GetUnitAbilityLevel(GetFilterUnit(),'OR00')!=0
endfunction


function ChangeLandUnitsNow takes player p,integer pi returns nothing
    local unit u
    local group g = CreateGroup()
    set udg_Boolexpr = Condition(function HordeLandUnits)
    call GroupEnumUnitsOfPlayer( g, p, udg_Boolexpr )
    loop
        set u = FirstOfGroup(g)
        exitwhen u==null
        
        set udg_Price = GetUnitGoldCost(GetUnitTypeId(u))
        set disincome[pi] = disincome[pi] - (( udg_Price * 0.10 ) * (( GetUnitAbilityLevel(u,'OR00')-35 )/100.0)  )    
        call SetUnitAbilityLevel(u,'OR00',35+udg_HordeLandPrice[pi])
        set disincome[pi] = disincome[pi] + (( udg_Price * 0.10 ) * (( GetUnitAbilityLevel(u,'OR00')-35 )/100.0)  ) 
        
        call GroupRemoveUnit(g,u)
        set u = null
    endloop
    set u = null
    call DestroyGroup(g)
    set g = null
endfunction
