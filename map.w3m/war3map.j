function Trig_KokonDead_Func002Func002C takes nothing returns boolean
    if ( not ( R2I(DistanceBetweenPoints(udg_LocalPosition[17], udg_LocalPosition[16])) <= 25 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KokonDead_Func002A takes nothing returns nothing
    set udg_LocalPosition[17] = GetUnitLoc(GetEnumUnit())
    if ( Trig_KokonDead_Func002Func002C() ) then
        call RemoveUnit( GetEnumUnit() )
    else
