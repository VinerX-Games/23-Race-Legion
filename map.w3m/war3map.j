    if ( not ( GetSpellAbilityId() == 'A044' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fire_Arrow_Actions takes nothing returns nothing
    local unit firearrowtarget
    set firearrowtarget = GetSpellTargetUnit()
    call PolledWait( ( DistanceBetweenPoints(GetUnitLoc(GetSpellAbilityUnit()), GetUnitLoc(GetSpellTargetUnit())) / 1500.00 ) )
    set udg_unit = firearrowtarget
    call UnitDamageTargetBJ( GetSpellAbilityUnit(), udg_unit, I2R(GetHeroStatBJ(bj_HEROSTAT_INT, GetSpellAbilityUnit(), false)), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_COLD )
    set firearrowtarget = null
endfunction

//===========================================================================
function InitTrig_Fire_Arrow takes nothing returns nothing
    set gg_trg_Fire_Arrow = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Fire_Arrow, EVENT_PLAYER_UNIT_SPELL_CAST )
    call TriggerAddCondition( gg_trg_Fire_Arrow, Condition( function Trig_Fire_Arrow_Conditions ) )
    call TriggerAddAction( gg_trg_Fire_Arrow, function Trig_Fire_Arrow_Actions )
endfunction

