//===========================================================================
// Trigger: PandaSecondAttack
//===========================================================================
function Trig_PandaSecondAttack_Conditions takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A129', GetAttacker()) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_PandaSecondAttack_Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A12A', GetAttacker()) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_PandaSecondAttack_Actions takes nothing returns nothing
    if ( Trig_PandaSecondAttack_Func001C() ) then
        call UnitAddAbilityBJ( 'A12A', GetAttacker() )
    else
        call UnitRemoveAbilityBJ( 'A12A', GetAttacker() )
    endif
endfunction

//===========================================================================
function InitTrig_PandaSecondAttack takes nothing returns nothing
    set gg_trg_PandaSecondAttack = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_PandaSecondAttack, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_PandaSecondAttack, Condition( function Trig_PandaSecondAttack_Conditions ) )
    call TriggerAddAction( gg_trg_PandaSecondAttack, function Trig_PandaSecondAttack_Actions )
endfunction

//===========================================================================
// Trigger: ThrallMolnya
//===========================================================================
function Trig_ThrallMolnya_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A12X'
endfunction


function Thrallenum takes nothing returns nothing
    call CreateNUnitsAtLoc( 1, 'H0BN', GetOwningPlayer(GetTriggerUnit()), udg_LocalPosition2, bj_UNIT_FACING )
    set udg_LocalUnit2 = GetLastCreatedUnit()
    call TriggerExecute( gg_trg_ToKill2 )
    call UnitAddAbilityBJ( 'A14V', GetLastCreatedUnit() )
    call SetUnitManaBJ( GetLastCreatedUnit(), 1111111.00 )
    call SetUnitAbilityLevelSwapped( 'A14V', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A12X', GetTriggerUnit()) )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "chainlightning", GetEnumUnit() )
endfunction

function Trig_ThrallMolnya_Actions takes nothing returns nothing
    set udg_LocalPosition2 = GetUnitLoc(GetTriggerUnit())
    set udg_LocalPlayer = GetOwningPlayer(GetTriggerUnit())
    set udg_Boolexpr = Condition(function EnemEl)
    call GroupEnumUnitsInRangeOfLoc( udg_LocalOtrad2, udg_LocalPosition2, 400, udg_Boolexpr )
    call RemoveLocation(udg_LocalPosition2) 
    set udg_LocalPosition2 = GetUnitLoc(GetTriggerUnit())
    call ForGroupBJ( udg_LocalOtrad2, function Thrallenum )
    call RemoveLocation(udg_LocalPosition2) 
    call GroupClear( udg_LocalOtrad2 )
endfunction

//===========================================================================
function InitTrig_ThrallMolnya takes nothing returns nothing
    set gg_trg_ThrallMolnya = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_ThrallMolnya, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_ThrallMolnya, Condition( function Trig_ThrallMolnya_Conditions ) )
    call TriggerAddAction( gg_trg_ThrallMolnya, function Trig_ThrallMolnya_Actions )
endfunction


