    set udg_Portal_INDEX_CASTER = GetUnitUserData(GetTriggerUnit())
    set udg_Portal_loc1 = GetUnitLoc(udg_Portal_portal[udg_Portal_INDEX_CASTER])
    call IssuePointOrderLocBJ( GetTriggerUnit(), "move", udg_Portal_loc1 )
    call RemoveLocation(udg_Portal_loc1)
    call EnableTrigger( GetTriggeringTrigger() )
endfunction

