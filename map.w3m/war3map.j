    return true
endfunction

function Trig_Connect_Portal_2_Func001Func003C takes nothing returns boolean
    if ( not ( udg_Portal_active[udg_Portal_INDEX_TARGET] == true ) ) then
        return false
    endif
    if ( not ( GetSpellTargetUnit() != udg_Portal_portal[udg_Portal_INDEX_CASTER] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Connect_Portal_2_Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSpellTargetUnit()) == GetUnitTypeId(GetTriggerUnit()) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Connect_Portal_2_Actions takes nothing returns nothing
    if ( Trig_Connect_Portal_2_Func001C() ) then
        set udg_Portal_INDEX_CASTER = GetUnitUserData(GetTriggerUnit())
        set udg_Portal_INDEX_TARGET = GetUnitUserData(GetSpellTargetUnit())
        if ( Trig_Connect_Portal_2_Func001Func003C() ) then
            call DisplayTimedTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), 10.00, "TRIGSTR_19222" )
        else
            if ( Trig_Connect_Portal_2_Func001Func003Func002C() ) then
                call DisplayTimedTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), 10.00, "TRIGSTR_19228" )
            else
                set udg_Portal_ConfigIndex[1] = udg_Portal_INDEX_CASTER
                set udg_Portal_ConfigIndex[2] = udg_Portal_INDEX_TARGET
                set bj_forLoopAIndex = 1
                set bj_forLoopAIndexEnd = 2
                loop
                    exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                    // -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- --------
                    // CONFIGURE HERE
                    // -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- --------
                    set udg_Portal_departureFX[udg_Portal_ConfigIndex[GetForLoopIndexA()]] = "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl"
                    set udg_Portal_arrivalFX[udg_Portal_ConfigIndex[GetForLoopIndexA()]] = "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl"
                    set udg_Portal_activeFX[udg_Portal_ConfigIndex[GetForLoopIndexA()]] = "Abilities\\Spells\\Orc\\Voodoo\\VoodooAura.mdl"
                    set udg_Portal_range[udg_Portal_ConfigIndex[GetForLoopIndexA()]] = 180.00
                    set udg_Portal_delay[udg_Portal_ConfigIndex[GetForLoopIndexA()]] = 0.00
                    set udg_Portal_missileSpeed[udg_Portal_ConfigIndex[GetForLoopIndexA()]] = 0.00
                    set udg_Portal_preventAllies[udg_Portal_ConfigIndex[GetForLoopIndexA()]] = false
                    // The value below here dont matter since the delay and missileSpeed are both 0
                    set udg_Portal_missileHeight[udg_Portal_ConfigIndex[GetForLoopIndexA()]] = 0.00
                    set udg_Portal_missileTargetable[udg_Portal_ConfigIndex[GetForLoopIndexA()]] = false
                    set udg_Portal_missileUseOwnMovement[udg_Portal_ConfigIndex[GetForLoopIndexA()]] = false
                    // -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- --------
                    // //END CONFIGURATION
                    // -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- --------
                    set bj_forLoopAIndex = bj_forLoopAIndex + 1
                endloop
                set udg_Portal_INDEX_CASTER = udg_Portal_ConfigIndex[1]
                set udg_Portal_INDEX_TARGET = udg_Portal_ConfigIndex[2]
                // -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- -------- --------
                call TriggerExecute( gg_trg_Portal_Connect )
            endif
        endif
    else
        call DisplayTimedTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), 10.00, "TRIGSTR_19244" )
    endif
endfunction

