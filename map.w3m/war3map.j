    set udg_Portal_traveller = GetEnumUnit()
    set udg_Portal_INDEX_TRAVELLER = GetUnitUserData(udg_Portal_traveller)
    call UnitRemoveAbilityBJ( udg_Portal_delayFXAbil[udg_Portal_INDEX_CASTER], udg_Portal_traveller )
    if ( Trig_Portal_Disconnect_Func001Func005Func004C() ) then
        set udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER] = null
        set udg_Portal_delay[udg_Portal_INDEX_TRAVELLER] = 0.00
        set udg_Portal_isTeleporting[udg_Portal_INDEX_TRAVELLER] = false
        call GroupRemoveUnitSimple( udg_Portal_traveller, udg_Portal_group )
    else
    endif
    if ( Trig_Portal_Disconnect_Func001Func005Func005C() ) then
        set udg_Portal_targeted[udg_Portal_INDEX_TRAVELLER] = null
        set udg_Portal_delay[udg_Portal_INDEX_TRAVELLER] = 0.00
        set udg_Portal_isTeleporting[udg_Portal_INDEX_TRAVELLER] = false
        call GroupRemoveUnitSimple( udg_Portal_traveller, udg_Portal_group )
