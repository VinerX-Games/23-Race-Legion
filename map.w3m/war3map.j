    call TriggerAddCondition( gg_trg_LortemarArmorActive, Condition( function Trig_LortemarArmorActive_Conditions ) )
    call TriggerAddAction( gg_trg_LortemarArmorActive, function Trig_LortemarArmorActive_Actions )
endfunction


