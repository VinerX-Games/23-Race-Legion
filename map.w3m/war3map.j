    call TriggerRegisterAnyUnitEventBJ( gg_trg_No2SameItems, EVENT_PLAYER_UNIT_PICKUP_ITEM )
    call TriggerAddAction( gg_trg_No2SameItems, function Trig_No2SameItems_Actions )
endfunction


