//===========================================================================
// Trigger: Counters
//===========================================================================
function countAll takes player p returns nothing
    call T1Count(p)
    call T2Count(p)
    call T2bCount(p)
    call TCavCount(p)
    call T3Count(p)
    
    call K1Count(p)
    call K2Count(p)
    call K2bCount(p)
    call K3Count(p)
endfunction

