    call GroupClear( udg_LoadedGroup )
    call GroupClear( udg_TransportingGroup )
    set udg_StopOrder = String2OrderIdBJ("stop")
    set udg_TransportingIncrement = 1
    set udg_TransportingMin = udg_TransportingIncrement
endfunction

