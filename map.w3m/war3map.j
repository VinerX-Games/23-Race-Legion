//===========================================================================
// Trigger: VedmakF
//===========================================================================
function Trig_VedmakF_Conditions takes nothing returns boolean
    if ( not ( GetResearched() == 'R025' ) ) then
        return false
    endif
    return true
endfunction

function Trig_VedmakF_Actions takes nothing returns nothing
    call SetPlayerTechResearchedSwap( 'R026', 0, GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerTechResearchedSwap( 'R03C', 0, GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerTechResearchedSwap( 'R03D', 0, GetOwningPlayer(GetTriggerUnit()) )
    //                           
    call SetPlayerAbilityAvailableBJ( true, 'A05J', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A05K', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A049', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'Asps', GetOwningPlayer(GetTriggerUnit()) )
    //                           
    call SetPlayerAbilityAvailableBJ( false, 'A07L', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A037', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A07K', GetOwningPlayer(GetTriggerUnit()) )
    //                           
    call SetPlayerAbilityAvailableBJ( false, 'A07P', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A07Q', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A07N', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A07O', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A02G', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A07D', GetOwningPlayer(GetTriggerUnit()) )
    //                           
    call SetPlayerAbilityAvailableBJ( false, 'A07M', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A07S', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A07R', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( false, 'A07T', GetOwningPlayer(GetTriggerUnit()) )
    //                           
    call SetPlayerAbilityAvailableBJ( true, 'A02J', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A00W', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A030', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A02Z', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A02R', GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerAbilityAvailableBJ( true, 'A02G', GetOwningPlayer(GetTriggerUnit()) )
    //                           
    call SetPlayerTechMaxAllowedSwap( 'R026', 1, GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerTechMaxAllowedSwap( 'R03C', 1, GetOwningPlayer(GetTriggerUnit()) )
    call SetPlayerTechMaxAllowedSwap( 'R03D', 1, GetOwningPlayer(GetTriggerUnit()) )
endfunction

//===========================================================================
function InitTrig_VedmakF takes nothing returns nothing
    set gg_trg_VedmakF = CreateTrigger(  )
    call DisableTrigger( gg_trg_VedmakF )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_VedmakF, EVENT_PLAYER_UNIT_RESEARCH_FINISH )
    call TriggerAddCondition( gg_trg_VedmakF, Condition( function Trig_VedmakF_Conditions ) )
    call TriggerAddAction( gg_trg_VedmakF, function Trig_VedmakF_Actions )
endfunction

