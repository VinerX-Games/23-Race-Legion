// Trigger: AttackerAi
//
// IssuePointOrderLoc
// IssueTargetOrder
//===========================================================================
function Trig_AttackerAi_Conditions takes nothing returns boolean
    return udg_AiControl[GetPlayerId(GetOwningPlayer(GetAttacker()))]
endfunction

function Trig_AttackerAi_Actions takes nothing returns nothing
    local unit u = GetAttacker()
    local integer id = GetUnitTypeId(u)
    local unit u2 = null
    local unit target = GetTriggerUnit()
    
    local player p = GetOwningPlayer(u)
    local integer pi = GetPlayerId(p)
   
    



    if AiRace[pi]=="Scarlet" then
        call Attacker_Skarlet(id,u,target,p)
    else
        call Attacker_BloodElves(id,u,target,p)
    endif
    
    
    
    set p = null
    set u = null
