//
// Любой триг может это вызвать, главное до этого задать LocalUni2
//===========================================================================
function Trig_ToKill2_Actions takes nothing returns nothing
    local unit u = udg_LocalUnit2
    call TriggerSleepAction( 2 )
    set udg_LocalUnit2 = u
    call RemoveUnit( udg_LocalUnit2 )
    set u = null
endfunction

