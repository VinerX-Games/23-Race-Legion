    set udg_LocalPlayer = GetOwningPlayer(GetTriggerUnit())
    set udg_Boolexpr = Condition(function Trig_NoToMuch_Func003002)
    call GroupEnumUnitsOfPlayer( udg_LocalOtrad2, udg_LocalPlayer, udg_Boolexpr )
    call ForGroupBJ( udg_LocalOtrad2, function Trig_NoToMuch_Func005A )
endfunction

