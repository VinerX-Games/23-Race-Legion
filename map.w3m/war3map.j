//===========================================================================
// Trigger: InitForEconomics
//===========================================================================
globals
    boolexpr IncomeBuildings
    boolexpr IncomeLumber
    boolexpr DisFilter
    integer array LastIncome
    integer array LastDisincome
    integer array LastBalance
endglobals



function f_IncomeBuildings takes nothing returns boolean
    return GetUnitState(GetFilterUnit(), UNIT_STATE_LIFE) > 0 and GetUnitFoodMade(GetFilterUnit()) >= 1 and IsUnitInGroup(GetFilterUnit(), udg_BuildedSctructure[1])
endfunction

function f_IncomeLumber takes nothing returns boolean
    return GetUnitAbilityLevel(GetFilterUnit(),'A0B5') >= 1
endfunction

function f_DisFilter takes nothing returns boolean
    return IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false and GetUnitState(GetFilterUnit(), UNIT_STATE_LIFE) > 0
endfunction


function Trig_InitForEconomics_Actions takes nothing returns nothing
    set IncomeBuildings = Condition(function f_IncomeBuildings)
    set IncomeLumber = Condition(function f_IncomeLumber)
    set DisFilter = Condition(function f_DisFilter)
endfunction

//===========================================================================
function InitTrig_InitForEconomics takes nothing returns nothing
    set gg_trg_InitForEconomics = CreateTrigger(  )
    call TriggerAddAction( gg_trg_InitForEconomics, function Trig_InitForEconomics_Actions )
endfunction


//===========================================================================
// Trigger: TimerIncome
//===========================================================================
globals
    boolean DisOn = false
    boolean EcLog = false
endglobals

function Trig_TimerIncome_Actions takes nothing returns nothing
    local integer i = 0
    local integer r
    local player p
    local integer t = 0
    
    loop
        exitwhen i >= 24
        set p = Player(i)
               
        if DisOn then 
        
            
            // ---------------------------Система сверхпотребления-----------------------------
            //set logistic[i] = 500*R2I( udg_UnitsCount[i]/ 50.00 )
            //set logistic[i] = 250*R2I( udg_UnitsCount[i]/ 25.00 )
            set r = R2I( udg_UnitsCount[i]/ 25.00 )
            set logistic[i] = ( (500+100*( r-1 ))/2*r) // прогрессия
            
            
            // ---------------------------Система коррупции-----------------------------
            set t = GetPlayerTechCount(p,'R04O',true)
            if  t > 1 then
                set corruption[i] = ( disincome[i] * ( (t-1) * 0.15 ) )
                if EcLog then
                    set udg_LocalText2 = ( "Коррупция" + I2S(R2I(corruption[i])) )
                    call DisplayTimedTextToPlayer( p, 0, 0,7, udg_LocalText2 )
                endif
               
            endif
            
            //Общий модификатор расходов
            set t = GetPlayerTechCount(p,'R0DV',true)+GetPlayerTechCount(p,'R0GZ',true)
            if  t >= 1 then
                set additional[i] = disincome[i] * (udg_MainPrice[i]/(-100.0))
                if EcLog then
                    set udg_LocalText2 = ( "Дополнительно: " + I2S(R2I(additional[i])) )
                    call DisplayTimedTextToPlayer( p, 0, 0,7, udg_LocalText2 )
                endif
               
            endif
              
            set balance[i]=income[i]-disincome[i]-logistic[i]+corruption[i]+additional[i]
        else 
            set balance[i]=income[i]
        endif
        
        
        
        
        if EcLog then
                set udg_LocalText2 = ( "Доход: " + R2S(income[i])) 
                call DisplayTimedTextToPlayer( p, 0, 0,7, udg_LocalText2 )
                set udg_LocalText2 = ( "Расход: " + R2S(disincome[i])) 
                call DisplayTimedTextToPlayer( p, 0, 0,7, udg_LocalText2 )
                set udg_LocalText2 = ( "Логистика: " +  R2S(logistic[i]) )
                call DisplayTimedTextToPlayer( p, 0, 0,7, udg_LocalText2 )
                set udg_LocalText2 = ( "Юнитов: " + I2S(udg_UnitsCount[i])) 
                call DisplayTimedTextToPlayer( p, 0, 0,7, udg_LocalText2 )
                set udg_LocalText2 = ( "Итого: " + R2S(balance[i])) 
                call DisplayTimedTextToPlayer( p, 0, 0,7, udg_LocalText2 )
                set udg_LocalText2 = ( "Древесины: " + R2S(incomeW[i])) 
                call DisplayTimedTextToPlayer( p, 0, 0,7, udg_LocalText2 )
        endif
        
        call SetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD, GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD) + R2I(balance[i]) )
        call SetPlayerState(p, PLAYER_STATE_RESOURCE_LUMBER, GetPlayerState(p, PLAYER_STATE_RESOURCE_LUMBER) + R2I(incomeW[i]) )
        
        set p = null
        set i = i+1
    endloop



endfunction

