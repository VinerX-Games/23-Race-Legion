    call TriggerSleepAction( 60.00 )
    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_27018" )
    call TriggerSleepAction( 60.00 )
    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_27019" )
    call TriggerSleepAction( 60.00 )
