function InitTrig_Forsaken takes nothing returns nothing
    set gg_trg_Forsaken = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Forsaken, EVENT_PLAYER_UNIT_RESEARCH_FINISH )
    call TriggerAddCondition( gg_trg_Forsaken, Condition( function Trig_Forsaken_Conditions ) )
    call TriggerAddAction( gg_trg_Forsaken, function Trig_Forsaken_Actions )
endfunction


//===========================================================================
// Trigger: BloodElf
//===========================================================================
function Trig_BloodElf_Conditions takes nothing returns boolean
    return GetResearched() == 'R0D2'
endfunction

function Trig_BloodElf_Actions takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local player p = GetOwningPlayer(u)
    local integer pi = GetPlayerId(p)
    call countAll(p)
    set udg_MainPrice[pi] = udg_MainPrice[pi] + 4
    set udg_HordeLandPrice[pi] = udg_HordeLandPrice[pi] - 3
    set udg_HordeMagicPrice[pi] = udg_HordeMagicPrice[pi] - 5
    set udg_HordeNavyPrice[pi] = udg_HordeNavyPrice[pi] - 1
    set udg_HordeTechPrice[pi] = udg_HordeTechPrice[pi] - 1
    call ChangeTechUnitsNow(p,pi)
    call ChangeLandUnitsNow(p,pi)
    call ChangeMagicUnitsNow(p,pi)
    call ChangeNavyUnitsNow(p,pi)
    
    
    
    
    
    
    
    call SetPlayerTechResearched(p,'R0E8',1) // Разрешает особую технику
    call SetPlayerTechResearched(p,'R0E7',1) //Разрешает дд
    call SetPlayerTechMaxAllowed(p,'R0EE',1)
    
    set p = null
    set u = null
endfunction

