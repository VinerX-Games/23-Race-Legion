//*  HordeMagicUnits
function HordeMagicUnits takes nothing returns boolean
    return GetUnitAbilityLevel(GetFilterUnit(),'A0UY')!=0
endfunction





function ChangeMagicUnitsNow takes player p,integer pi returns nothing
    local unit u
    local group g = CreateGroup()
    set udg_Boolexpr = Condition(function HordeMagicUnits)
    call GroupEnumUnitsOfPlayer( g, p, udg_Boolexpr )
    loop
        set u = FirstOfGroup(g)
        exitwhen u==null
        
        set udg_Price = GetUnitGoldCost(GetUnitTypeId(u))
        set disincome[pi] = disincome[pi] - (( udg_Price * 0.10 ) * (( GetUnitAbilityLevel(u,'A0UY')-35 )/100.0)  )    
        call SetUnitAbilityLevel(u,'A0UY',35+udg_HordeLandPrice[pi])
        set disincome[pi] = disincome[pi] + (( udg_Price * 0.10 ) * (( GetUnitAbilityLevel(u,'A0UY')-35 )/100.0)  ) 
        
        call GroupRemoveUnit(g,u)
        set u = null
    endloop
    set u = null
    call DestroyGroup(g)
    set g = null
endfunction
//***************************************************************************
//*  HordeNavyUnits
function HordeNavyUnits takes nothing returns boolean
    return GetUnitAbilityLevel(GetFilterUnit(),'A0V0')!=0
endfunction





function ChangeNavyUnitsNow takes player p,integer pi returns nothing
    local unit u
    local group g = CreateGroup()
    set udg_Boolexpr = Condition(function HordeNavyUnits)
    call GroupEnumUnitsOfPlayer( g, p, udg_Boolexpr )
    loop
        set u = FirstOfGroup(g)
        exitwhen u==null
        
        set udg_Price = GetUnitGoldCost(GetUnitTypeId(u))
        set disincome[pi] = disincome[pi] - (( udg_Price * 0.10 ) * (( GetUnitAbilityLevel(u,'A0V0')-35 )/100.0)  )    
        call SetUnitAbilityLevel(u,'A0V0',35+udg_HordeLandPrice[pi])
        set disincome[pi] = disincome[pi] + (( udg_Price * 0.10 ) * (( GetUnitAbilityLevel(u,'A0V0')-35 )/100.0)  ) 
        
        call GroupRemoveUnit(g,u)
        set u = null
    endloop
    set u = null
    call DestroyGroup(g)
    set g = null
endfunction
//***************************************************************************
//*  PointAi
globals 
    location array PointForAi
endglobals

function AiPoitsSet takes nothing returns nothing
    set PointForAi[0]=Location(-18782,469)
    set PointForAi[1]=Location(-27743,548)
    set PointForAi[2]=Location(-26040,-6528)
    set PointForAi[3]=Location(-16827,-5185)
    set PointForAi[4]=Location(-16827,-5185)
    //set PointForAi[5]=Location(-18782,469)
endfunction

function RandomAiPlace takes nothing returns nothing
    local integer i = 0
    local integer c = 0
    local location array b

    set i = 0
    loop 
        exitwhen i>=15
        
        if PointForAi[i]!= null then
            set b[c]=PointForAi[i]
            set PointForAi[i] = null
            set c = c +1
        endif
        set i = i + 1
    endloop
    // Получил массив локаций б
    
    set i = GetRandomInt(0,c)
    set udg_LocalPoint = b[i]
    set i = 0
    loop
        exitwhen i>=15
        set b[i]=null
    
        set i = i + 1
    endloop
    

endfunction
