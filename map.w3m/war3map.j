//===========================================================================
// Trigger: TrutenStartUpgrade
//===========================================================================
function Trig_TrutenStartUpgrade_Func001C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e01G' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e022' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e02W' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e01Q' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e01S' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e01O' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e01U' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e01V' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e01Z' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'e01T' ) ) then
        return true
    endif
    return false
endfunction

function Trig_TrutenStartUpgrade_Conditions takes nothing returns boolean
    if ( not Trig_TrutenStartUpgrade_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_TrutenStartUpgrade_Actions takes nothing returns nothing
    local integer i = GetPlayerId( GetOwningPlayer( GetTriggerUnit( ) ) )
    set udg_LocalPosition[15] = GetUnitLoc(GetTriggerUnit())
    call CreateNUnitsAtLoc( 1, 'h0DE', GetOwningPlayer(GetTriggerUnit()), udg_LocalPosition[15], bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 75.00, 'BTLF', GetLastCreatedUnit() )
    call SetUnitAnimation( GetLastCreatedUnit(), "stand" )
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_Kokon )
    set i = 0
    call RemoveLocation(udg_LocalPosition[15])
endfunction

//===========================================================================
function InitTrig_TrutenStartUpgrade takes nothing returns nothing
    set gg_trg_TrutenStartUpgrade = CreateTrigger(  )
    call DisableTrigger( gg_trg_TrutenStartUpgrade )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_TrutenStartUpgrade, EVENT_PLAYER_UNIT_UPGRADE_START )
    call TriggerAddCondition( gg_trg_TrutenStartUpgrade, Condition( function Trig_TrutenStartUpgrade_Conditions ) )
    call TriggerAddAction( gg_trg_TrutenStartUpgrade, function Trig_TrutenStartUpgrade_Actions )
