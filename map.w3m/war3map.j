function InitTrig_GnomeNotToMuch takes nothing returns nothing
    set gg_trg_GnomeNotToMuch = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_GnomeNotToMuch, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_GnomeNotToMuch, Condition( function Trig_GnomeNotToMuch_Conditions ) )
    call TriggerAddAction( gg_trg_GnomeNotToMuch, function Trig_GnomeNotToMuch_Actions )
