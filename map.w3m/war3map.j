    set gg_trg_Abordach_D_or_Ot = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Abordach_D_or_Ot, EVENT_PLAYER_UNIT_SPELL_CAST )
    call TriggerAddCondition( gg_trg_Abordach_D_or_Ot, Condition( function Trig_Abordach_D_or_Ot_Conditions ) )
