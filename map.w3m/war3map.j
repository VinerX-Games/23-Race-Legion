function Trig_Portal_Disconnect_Func001C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == udg_Portal_SeverAbility ) ) then
        return false
    endif
    return true
endfunction

function Trig_Portal_Disconnect_Actions takes nothing returns nothing
    if ( Trig_Portal_Disconnect_Func001C() ) then
        set udg_Portal_INDEX_CASTER = GetUnitUserData(GetTriggerUnit())
        set udg_Portal_INDEX_TARGET = GetUnitUserData(udg_Portal_portal[udg_Portal_INDEX_CASTER])
        call UnitRemoveAbilityBJ( udg_Portal_SeverAbility, GetTriggerUnit() )
        call UnitRemoveAbilityBJ( udg_Portal_SeverAbility, udg_Portal_portal[udg_Portal_INDEX_CASTER] )
        call ForGroupBJ( udg_Portal_group, function Trig_Portal_Disconnect_Func001Func005A )
        set udg_Portal_active[udg_Portal_INDEX_CASTER] = false
        set udg_Portal_active[udg_Portal_INDEX_TARGET] = false
        call DestroyEffectBJ( udg_Portal_FX[udg_Portal_INDEX_CASTER] )
        call DestroyEffectBJ( udg_Portal_FX[udg_Portal_INDEX_TARGET] )
        set udg_Portal_portal[udg_Portal_INDEX_CASTER] = null
        set udg_Portal_portal[udg_Portal_INDEX_TARGET] = null
    else
    endif
endfunction

