function InitTrig_PerebobArmy_Uni takes nothing returns nothing
    set gg_trg_PerebobArmy_Uni = CreateTrigger(  )
    call DisableTrigger(gg_trg_PerebobArmy_Uni)
    call TriggerRegisterTimerExpireEvent( gg_trg_PerebobArmy_Uni, udg_PlayerGet1 )
    call TriggerAddAction( gg_trg_PerebobArmy_Uni, function PlayerArmy )
