//===========================================================================
// Trigger: Emerald Dream TP O
//===========================================================================
function Trig_Emerald_Dream_TP_O_Func001Func001C takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Emerald_Dream_TP_O_Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'H049' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Emerald_Dream_TP_O_Actions takes nothing returns nothing
    if ( Trig_Emerald_Dream_TP_O_Func001C() ) then
        set udg_LocalPosition[21] = GetRectCenter(GetPlayableMapRect())
        call SetUnitPositionLoc( GetTriggerUnit(), udg_LocalPosition[21] )
        call DisplayTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), "TRIGSTR_13200" )
        set udg_LocalText2 = "Нельзя телепортировать круг сюда. Он перемещен в центр карты."
        call DisplayTextToPlayer( GetEnumPlayer( ), 0, 0, udg_LocalText2 )
        call RemoveLocation(udg_LocalPosition[21]) 
    else
        if ( Trig_Emerald_Dream_TP_O_Func001Func001C() ) then
            call KillUnit( GetTriggerUnit() )
        else
            call UnitAddAbilityBJ( 'A0LT', GetTriggerUnit() )
        endif
    endif
endfunction

//===========================================================================
function InitTrig_Emerald_Dream_TP_O takes nothing returns nothing
    set gg_trg_Emerald_Dream_TP_O = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_Emerald_Dream_TP_O, gg_rct_EmeraldDream )
    call TriggerAddAction( gg_trg_Emerald_Dream_TP_O, function Trig_Emerald_Dream_TP_O_Actions )
endfunction

