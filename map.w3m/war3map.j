//===========================================================================
// Trigger: UnitIncomeConstructed
//===========================================================================
function Trig_UnitIncomeConstructed_Conditions takes nothing returns boolean
    return GetUnitState(GetConstructedStructure(), UNIT_STATE_LIFE) > 0 and GetUnitFoodMade(GetConstructedStructure()) >= 1 // and IsUnitInGroup(GetConstructedStructure(), udg_BuildedSctructure[1])
endfunction

function Trig_UnitIncomeConstructed_Actions takes nothing returns nothing
    local unit u = GetConstructedStructure()
    local player p = GetOwningPlayer(u)
    local integer pi = GetPlayerId(p)
    
    
    //Добавляю инком
    set income[pi] = income[pi] + I2R(GetUnitFoodMade(u)) 
    if GetUnitAbilityLevel(u,'A0AY') >= 1 then
            set income[pi] = ( income[pi] + ( 100.00 * I2R(GetUnitAbilityLevel(u,'A0AY')) ) )
    elseif GetUnitAbilityLevel(u,'A0SM') >= 1 then
        set income[pi] = ( income[pi] + ( 75.00 * I2R(GetUnitAbilityLevel(u,'A0SM')) ) )
    endif
    
    
    call UpdateGraf(pi)
    
    
    set u = null
    set p = null
endfunction

//===========================================================================
function InitTrig_UnitIncomeConstructed takes nothing returns nothing
    set gg_trg_UnitIncomeConstructed = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_UnitIncomeConstructed, EVENT_PLAYER_UNIT_CONSTRUCT_FINISH )
    call TriggerAddCondition( gg_trg_UnitIncomeConstructed, Condition( function Trig_UnitIncomeConstructed_Conditions ) )
    call TriggerAddAction( gg_trg_UnitIncomeConstructed, function Trig_UnitIncomeConstructed_Actions )
endfunction


//===========================================================================
// Trigger: UnitIncomeUpgrade
//===========================================================================
function Trig_UnitIncomeUpgrade_Conditions takes nothing returns boolean
    return GetUnitState(GetTriggerUnit(), UNIT_STATE_LIFE) > 0 and GetUnitFoodMade(GetTriggerUnit()) >= 1
endfunction

function Trig_UnitIncomeUpgrade_Actions takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local player p = GetOwningPlayer(u)
    local integer pi = GetPlayerId(p)
    local integer i = GetUnitFoodMade(u)
    
    //Добавляю инком
    
    
    if GetUnitAbilityLevel(u,'A0LJ') >= 1 then
        if i==200 then
            set income[pi] = income[pi] + 170
        elseif i==300 then
            set income[pi] = income[pi] + 100
        
        endif
           
    elseif GetUnitTypeId(u)== 'h0HU' then
        set income[pi] = income[pi] + 40
    endif
    
    
    call UpdateGraf(pi)
    
    
    set u = null
    set p = null
endfunction

