//===========================================================================
// Trigger: Cities Start 2
//
// Заношу в группы нейтральные здания
//===========================================================================
globals
    group PortalBuildingAi = CreateGroup()
endglobals

function Trig_Cities_Start_2_Func001002 takes nothing returns boolean
    return GetUnitAbilityLevel(GetFilterUnit(), 'AHad') == 1
endfunction

function Trig_Cities_Start_2_Func003A takes nothing returns nothing
    local unit u = GetEnumUnit()
    local integer id = GetUnitTypeId(u)
    call BlzSetUnitArmor(u,3)
    call SetUnitState(u,UNIT_STATE_LIFE,5000)
    call GroupAddUnit( udg_ZahvatBuildings,u )
    call GroupAddUnit( udg_BuildedSctructure[1],u )
    if (id == 'h08A' or id == 'h08A' or id == 'h004' or id == 'h0B3' or id == 'h081' or id == 'h0AP' or id == 'h00G' or id == 'h08G' or id == 'h05O' or id == 'h089' or id == 'h0AG' or id == 'h097' or id == 'h09Z'  or id == 'h088'  or id == 'h094' /*
    */or id == 'h00F' or id == 'h09P' or id == 'h00F' or id == 'h0BB' or id == 'h0E3' or id == 'h06I') then
        call GroupAddUnit(PortalBuildingAi,u)
    endif
    set u = null
endfunction

function Trig_Cities_Start_2_Actions takes nothing returns nothing
    set udg_Boolexpr = Condition(function Trig_Cities_Start_2_Func001002)
    call GroupEnumUnitsInRect( udg_LocalOtrad2, bj_mapInitialPlayableArea, udg_Boolexpr )
    call ForGroup( udg_LocalOtrad2, function Trig_Cities_Start_2_Func003A )
    call GroupClear( udg_LocalOtrad2 )
endfunction

