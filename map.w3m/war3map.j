//===========================================================================
// Trigger: Start Elves O
//===========================================================================
function Trig_Start_Elves_O_Func001A takes nothing returns nothing
    call SetPlayerAbilityAvailableBJ( false, 'A05J', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A05K', GetEnumPlayer() )
    // -----------------------
    call SetPlayerAbilityAvailableBJ( false, 'A07K', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A07L', GetEnumPlayer() )
    // -----------------------
    call SetPlayerAbilityAvailableBJ( false, 'A07M', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A07S', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A07T', GetEnumPlayer() )
    // -----------------------
    call SetPlayerAbilityAvailableBJ( false, 'A07D', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A02G', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A07O', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A07N', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A07P', GetEnumPlayer() )
    call SetPlayerAbilityAvailableBJ( false, 'A07Q', GetEnumPlayer() )
    // -----------------------
    call SetPlayerTechMaxAllowedSwap( 'H043', 1, GetEnumPlayer() )
    call SetPlayerTechMaxAllowedSwap( 'H044', 1, GetEnumPlayer() )
    call SetPlayerTechMaxAllowedSwap( 'H05H', 1, GetEnumPlayer() )
    call SetPlayerTechMaxAllowedSwap( 'H05I', 1, GetEnumPlayer() )
    call SetPlayerTechMaxAllowedSwap( 'H045', 1, GetEnumPlayer() )
    call SetPlayerTechMaxAllowedSwap( 'Hjnd', 1, GetEnumPlayer() )
endfunction

function Trig_Start_Elves_O_Actions takes nothing returns nothing
    call ForForce( udg_AllPlayers, function Trig_Start_Elves_O_Func001A )
endfunction

//===========================================================================
function InitTrig_Start_Elves_O takes nothing returns nothing
    set gg_trg_Start_Elves_O = CreateTrigger(  )
    call TriggerRegisterTimerEventSingle( gg_trg_Start_Elves_O, 5.00 )
    call TriggerAddAction( gg_trg_Start_Elves_O, function Trig_Start_Elves_O_Actions )
endfunction

//===========================================================================
// Trigger: KaelMassAstral
//===========================================================================
function Trig_KaelMassAstral_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A08R' ) ) then
        return false
    endif
    return true
endfunction

function Trig_KaelMassAstral_Func002002 takes nothing returns boolean
    return ( 0 == 0 )
endfunction

function Trig_KaelMassAstral_Func007A takes nothing returns nothing
    call CreateNUnitsAtLoc( 1, 'H0BN', GetOwningPlayer(GetTriggerUnit()), udg_LocalPosition2, bj_UNIT_FACING )
    set udg_LocalUnit2 = GetLastCreatedUnit()
    call TriggerExecute( gg_trg_ToKill2 )
    call UnitAddAbilityBJ( 'AHbn', GetLastCreatedUnit() )
    call SetUnitManaBJ( GetLastCreatedUnit(), 1111111.00 )
    call SetUnitAbilityLevelSwapped( 'AHbn', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A08R', GetTriggerUnit()) )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "banish", GetEnumUnit() )
endfunction

function Trig_KaelMassAstral_Actions takes nothing returns nothing
    set udg_LocalPosition2 = GetSpellTargetLoc()
    set udg_Boolexpr = Condition(function Trig_KaelMassAstral_Func002002)
    set udg_LocalPlayer = GetOwningPlayer(GetTriggerUnit())
    call GroupEnumUnitsInRangeOfLoc( udg_LocalOtrad2, udg_LocalPosition2, 150, udg_Boolexpr )
    call RemoveLocation(udg_LocalPosition2) 
    set udg_LocalPosition2 = GetUnitLoc(GetTriggerUnit())
    call ForGroupBJ( udg_LocalOtrad2, function Trig_KaelMassAstral_Func007A )
    call RemoveLocation(udg_LocalPosition2) 
    call GroupClear( udg_LocalOtrad2 )
endfunction

//===========================================================================
function InitTrig_KaelMassAstral takes nothing returns nothing
    set gg_trg_KaelMassAstral = CreateTrigger(  )
    call DisableTrigger( gg_trg_KaelMassAstral )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_KaelMassAstral, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_KaelMassAstral, Condition( function Trig_KaelMassAstral_Conditions ) )
    call TriggerAddAction( gg_trg_KaelMassAstral, function Trig_KaelMassAstral_Actions )
endfunction

//===========================================================================
// Trigger: LortemarArmorActive
//===========================================================================
function Trig_LortemarArmorActive_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A16M'
endfunction

function Trig_LortemarArmorActive_Actions takes nothing returns nothing

    
    local unit u = GetTriggerUnit()
    call UnitAddAbility( u, 'A0DD' )
    call UnitAddAbility( u, 'ACmi' )
    call TriggerSleepAction( 20.00 )
    call UnitRemoveAbility( u,'A0DD' )
    call UnitRemoveAbility( u,'ACmi' )
    set u = null

endfunction

//===========================================================================
function InitTrig_LortemarArmorActive takes nothing returns nothing
    set gg_trg_LortemarArmorActive = CreateTrigger(  )
    call DisableTrigger( gg_trg_LortemarArmorActive )
