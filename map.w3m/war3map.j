function InitTrig_Revive takes nothing returns nothing
    set gg_trg_Revive = CreateTrigger(  )
    call DisableTrigger(gg_trg_Revive)
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Revive, EVENT_PLAYER_HERO_REVIVABLE )
    call TriggerAddCondition( gg_trg_Revive, Condition( function Trig_Revive_Conditions ) )
    call TriggerAddAction( gg_trg_Revive, function Trig_Revive_Actions )
endfunction


//===========================================================================
// Trigger: JoinAll
//===========================================================================


function Trig_JoinAll_Conditions takes nothing returns boolean
    return udg_AiControl[GetPlayerId(GetOwningPlayer(GetTriggerUnit()))]
endfunction

function Trig_JoinAll_Actions takes nothing returns nothing
    local unit u = GetTrainedUnit()
    local integer i
    local integer id = GetUnitTypeId(u)
    local integer pi = GetPlayerId(GetOwningPlayer(u))
    
    
    
    call GroupAddUnit( udg_Ai_units[pi],u )
    
    
    //Алый Орден
    if AiRace[pi]=="Scarlet" then
    
        if id == 'h014' then 
            call GroupAddUnit( udg_Ai_builders[pi],u )
        elseif id == 'h00X' or id == 'h00Y' or id == 'h00Z' then
            call GroupAddUnit( udg_Ai_navy[pi],u )
            call NumberAdd(pi,StringHash("NumberN"))
        else 
            call GroupAddUnit( udg_Ai_army[pi],u )
            call NumberAdd(pi,StringHash("Number"))
        endif
        call NumberAdd(pi,id)
        
        
      
      
    
    //Герои
        //Герой маг
        if id == 'H06C' then 
            set i = GetRandomInt(1,3)
            if i ==1 then 
                call SelectHeroSkill( u, 'A09K' )
            elseif i == 2 then
                call SelectHeroSkill( u, 'A09L' )
            else 
                call SelectHeroSkill( u, 'A09N' )
            endif
        
        
        //Герой Капитан
        elseif id == 'H06B' then 
            set i = GetRandomInt(1,3)
            if i ==1 then 
                call SelectHeroSkill( u, 'A09G' )
            elseif i == 2 then
                call SelectHeroSkill( u, 'A09F' )
            else 
                call SelectHeroSkill( u, 'A09I' )
            endif
        
        
        //Герой Паладин
        elseif id == 'H03H' then 
            set i = GetRandomInt(1,3)
            if i ==1 then 
                call SelectHeroSkill( u, 'A097' )
            elseif i == 2 then
                call SelectHeroSkill( u, 'A09C' )
            else 
                call SelectHeroSkill( u, 'A09D' )
            endif
        
        
        //Флот 
        elseif id=='h00Z' then 
            call IssueImmediateOrder( u, "nagabuild" )
            call IssueImmediateOrder( u, "spellbook" )
            set i = GetRandomInt(1,3)
            if i ==1 then 
                call IssueImmediateOrder( u, "nagabuild" )
            elseif i == 2 then
                call IssueImmediateOrder( u, "mounthippogryph" )
            else 
                call IssueImmediateOrder( u, "monsoon" )
            endif 
            
        endif
    
    elseif  AiRace[pi]=="BloodElves" then
        
        if id == 'h04K' then 
            call GroupAddUnit( udg_Ai_builders[pi],u )
        elseif id == 'h00X' or id == 'h00Y' or id == 'h00Z' then
            call GroupAddUnit( udg_Ai_navy[pi],u )
        else 
            call GroupAddUnit( udg_Ai_army[pi],u )
        endif
        call NumberAdd(pi,id)
        call NumberAdd(pi,StringHash("Number"))
        
      
      
    
    //Герои
        //Герой ЧАродей
        if id == 'H034' then 
            set i = GetRandomInt(1,3)
            if i ==1 then 
                call SelectHeroSkill( u, 'AHfs' )
            elseif i == 2 then
                call SelectHeroSkill( u, 'AHbn' )
            else 
                call SelectHeroSkill( u, 'AHdr' )
            endif
        
        
        //Герой Странник
        elseif id == 'Hjnd' then 
            set i = GetRandomInt(1,3)
            if i ==1 then 
                call SelectHeroSkill( u, 'A07U' )
            elseif i == 2 then
                call SelectHeroSkill( u, 'A0LQ' )
            else 
                call SelectHeroSkill( u, 'A07V' )
            endif
        
        
        //Герой Паладин
        elseif id == 'H045' then 
            set i = GetRandomInt(1,3)
            if i ==1 then 
                call SelectHeroSkill( u, 'A08H' )
            elseif i == 2 then
                call SelectHeroSkill( u, 'A07W' )
            else 
                call SelectHeroSkill( u, 'AHbh' )
            endif
        
        
        //Флот 
        elseif id=='h00Z' then 
            call IssueImmediateOrder( u, "nagabuild" )
            call IssueImmediateOrder( u, "spellbook" )
            set i = GetRandomInt(1,3)
            if i ==1 then 
                call IssueImmediateOrder( u, "nagabuild" )
            elseif i == 2 then
                call IssueImmediateOrder( u, "mounthippogryph" )
            else 
                call IssueImmediateOrder( u, "monsoon" )
            endif 
            
        endif
    
    endif
    //Зачистка
    
    set u = null    
endfunction

