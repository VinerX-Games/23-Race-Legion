function ZahType takes nothing returns nothing
    local unit u = GetEnumUnit()
    local integer pi = GetPlayerId(GetOwningPlayer(u))
    local integer id = GetUnitTypeId(u)
    //Это точка
    if IsUnitInGroup(u,udg_ZahvatBuildings)==true then
        set udg_LocalInteger3 = udg_LocalInteger3 + 8
    else
    
    
        if AiRace[pi]=="Scarlet" then
            //Это ферма
            if id=='h05Y' then
                set udg_LocalInteger3 = udg_LocalInteger3 + 1
            

            //Это Т1
            elseif id=='h05U' then
                set udg_LocalInteger3 = udg_LocalInteger3 + 2
            
            
            //Это Т2
            elseif id=='h05V' then
                set udg_LocalInteger3 = udg_LocalInteger3 + 5
            
                
            //Это Т3
            elseif id=='h05W' then
                set udg_LocalInteger3 = udg_LocalInteger3 + 8
            endif
        
        
        elseif AiRace[pi]=="BloodElves" then
            //Это ферма
            if id=='h04M' then
                set udg_LocalInteger3 = udg_LocalInteger3 + 1
            

            //Это Т1
            elseif id=='h04C' then
                set udg_LocalInteger3 = udg_LocalInteger3 + 2
            
            
            //Это Т2
            elseif id=='h04B' then
                set udg_LocalInteger3 = udg_LocalInteger3 + 5
            
                
            //Это Т3
            elseif id=='h04A' then
                set udg_LocalInteger3 = udg_LocalInteger3 + 8
            endif
        endif
    endif
endfunction












function Strateg takes nothing returns nothing
    local group g = CreateGroup()
    local integer i = 0
    local integer r = 0
    local player p = GetEnumPlayer()
    local integer pi = GetPlayerId(p)
    
    
    // Считаю фермы и точки
    set udg_LocalInteger3 = 0
    call GroupEnumUnitsOfPlayer(g,p,null)
    call ForGroup(g,function ZahType)
    call GroupClear(g)
    set i = udg_LocalInteger3
    //Посчитал
    
    
    //Ресы на развитие
    
    call AdjustPlayerStateSimpleBJ(p, PLAYER_STATE_RESOURCE_GOLD, 500+i*9*AiMoney) // -LoadInteger(AiData,pi,StringHash("Number"))*10 )
    call AdjustPlayerStateSimpleBJ(p, PLAYER_STATE_RESOURCE_LUMBER, i*10 ) 
    
    //call DisplayTimedTextFromPlayer(Player(0),0,0,4,(GetPlayerName(p)+" "+I2S(GetPlayerId(p))))
    //call DisplayTimedTextFromPlayer(Player(0),0,0,4,I2S(i))
    
      
    if AiRace[pi]=="Scarlet" then
        call Strateg_Scarlet(i,pi,p)
    elseif AiRace[pi]=="BloodElves" then
        call Strateg_BloodElves(i,pi,p)
    endif
    //if i > 50 and LoadInteger(AiData, GetPlayerId(pi),
    
    
    
    //Рандомный теп - чем больше доходов, тем больше попыток
    set r=0
    loop
        exitwhen r > i/30
        if FirstOfGroup(AiUnitsToPort[pi]) != null then
            set TryPort_pi = pi
            call ExecuteFunc("TryPort")
        endif
        set r = r+1
    endloop 
    
    // Чистка
    call DestroyGroup(g)
    set g = null
    set i = 0
    set p = null
    
endfunction



function Trig_Strateg_Actions takes nothing returns nothing
    
    if udg_Octhet then
        call DisplayTimedTextFromPlayer(GetEnumPlayer(),0,0,4,"Тик стратега")
    endif
    
    
    call ForForce(udg_Bots, function Strateg)

    if udg_Octhet then
        call DisplayTimedTextFromPlayer(GetEnumPlayer(),0,0,4,"Конец Тика стратега")
    endif




endfunction

