    set gg_trg_FeodalDead = CreateTrigger(  )
    call DisableTrigger( gg_trg_FeodalDead )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_FeodalDead, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_FeodalDead, Condition( function Trig_FeodalDead_Conditions ) )
