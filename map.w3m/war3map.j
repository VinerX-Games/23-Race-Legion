endfunction

//===========================================================================
// Trigger: Colision 1 s
//===========================================================================
function Trig_Colision_1_s_Actions takes nothing returns nothing
    local unit u
    set u = udg_LocalUnit[15]
    call TriggerSleepAction( 1.00 )
    set udg_LocalUnit[15] = u
    call SetUnitPathing( udg_LocalUnit[15], true )
    set u = null
endfunction

//===========================================================================
function InitTrig_Colision_1_s takes nothing returns nothing
    set gg_trg_Colision_1_s = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Colision_1_s, function Trig_Colision_1_s_Actions )
endfunction

