//===========================================================================
// Trigger: KakecCommon
//===========================================================================
function DisableKalec takes nothing returns nothing
    call SetPlayerAbilityAvailableBJ( false, 'A12R', GetEnumPlayer() )
endfunction

function EnableKalec takes nothing returns nothing
    call SetPlayerAbilityAvailableBJ( true, 'A12R', GetEnumPlayer() )
endfunction

//===========================================================================
// Trigger: KalecStart
//===========================================================================
function Trig_KalecStart_Conditions takes nothing returns boolean

    return GetSpellAbilityId() == 'A12R' and IsUnitSelected(GetTriggerUnit(), GetOwningPlayer(GetTriggerUnit()))
endfunction

function Trig_KalecStart_Actions takes nothing returns nothing
    local unit u
    local location l = GetUnitLoc(GetTriggerUnit())
    set u =  CreateUnitAtLoc( Player(24), 'n04W', l, bj_UNIT_FACING )
    call TriggerRegisterUnitEvent( gg_trg_KalecDead, u, EVENT_UNIT_DEATH )
    call UnitRemoveAbility(GetTriggerUnit(),'A12R')
    call ForForce( udg_AllPlayers, function DisableKalec )
    call TriggerSleepAction(120)
    if UnitAlive(u) then
        call ShowUnit(u,false)
        call RemoveUnit(u)
        call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"Вы не успели победить Калесгоса за 2 минуты")
        call ForForce( udg_AllPlayers, function EnableKalec )
        call UnitAddAbility(GetTriggerUnit(),'A12R')
    endif
    
    call RemoveLocation(l)
    set l = null
    set u = null
endfunction

//===========================================================================
function InitTrig_KalecStart takes nothing returns nothing
    set gg_trg_KalecStart = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_KalecStart, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_KalecStart, Condition( function Trig_KalecStart_Conditions ) )
    call TriggerAddAction( gg_trg_KalecStart, function Trig_KalecStart_Actions )
endfunction


//===========================================================================
// Trigger: KalecDead
//===========================================================================
function Trig_KalecDead_Func004A takes nothing returns nothing
    call SetPlayerAbilityAvailableBJ( false, 'A12R', GetEnumPlayer() )
endfunction

function Trig_KalecDead_Actions takes nothing returns nothing
    set udg_LocalPosition2 = GetUnitLoc(GetTriggerUnit())
    call CreateItemLoc( 'I01U', udg_LocalPosition2 )
    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_25200" )
    call ForForce( udg_AllPlayers, function Trig_KalecDead_Func004A )
    call DisableTrigger( gg_trg_KalecStart )
endfunction

//===========================================================================
function InitTrig_KalecDead takes nothing returns nothing
    set gg_trg_KalecDead = CreateTrigger(  )
    call TriggerAddAction( gg_trg_KalecDead, function Trig_KalecDead_Actions )
endfunction

