//===========================================================================
// Trigger: PereborBuilders Uni
//===========================================================================
globals
    unit TryBuild_u
endglobals



function PlayerBuilders takes nothing returns nothing
    local group g = CreateGroup()
    local player p
    local integer pi
    local integer i
    local unit u
        
    if CountPlayersInForceBJ(udg_BotsActiveB)== 0 then
        call PauseTimer( udg_PlayerGet2 )
        call ResumeTimer(udg_TimerSmall)
        call TimerStart( udg_TimerSmall, 2.17*AiRepeat/5, false, null )
        if udg_Octhet then
            call DisplayTimedTextFromPlayer(Player(0),0,0, 4,"Заканчиваю перебор игроков для строителей")
        endif
    else
        set p = ForcePickRandomPlayer(udg_BotsActiveB)
        set pi = GetPlayerId(p)
        call ForceRemovePlayer(udg_BotsActiveB,p)
            
    
        
        // Перебор юнитов !!!

    //Нераспределенные рабочие
        call GroupEnumUnitsOfPlayer(g,p,B_LazyW)
           
       
        if FirstOfGroup(g)!=null then
            set bj_forLoopAIndex = 1
            

            
            loop
                set u = FirstOfGroup(g)
                exitwhen bj_forLoopAIndex > AiMass+2 or FirstOfGroup(g) == null
                
                call GroupRemoveUnit(g,u)


                if LoadInteger(AiData,pi,StringHash("T")) >= 12  then
                    
                    set i = LoadInteger(AiData,pi,StringHash("HV"))+1
                    call SaveInteger(AiData,pi,StringHash("HV"),i)
                    call GroupAddUnit( udg_Ai_harvest[pi], u )
                    call GroupRemoveUnit( udg_Ai_builders[pi], u)
                    call IssueImmediateOrder( u, "autoharvestlumber" )
                else
                    
                    set i = LoadInteger(AiData,pi,StringHash("T"))+1
                    call SaveInteger(AiData,pi,StringHash("T"),i)
                    call GroupAddUnit( udg_Ai_buildersT[pi], u )
                    call GroupRemoveUnit( udg_Ai_builders[pi], u)
                    
                    
                    set TryBuild_u = u
                    call ExecuteFunc("TryBuild")
                endif
                 
                
                
                set bj_forLoopAIndex = bj_forLoopAIndex + 1
            endloop
            call GroupClear(g)
        endif
        
    // Рабочие-строители
        call GroupEnumUnitsOfPlayer(g,p,B_LazyT)
        if FirstOfGroup(g)!=null then
            set bj_forLoopAIndex = 1
            set bj_forLoopAIndexEnd = 4
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd or FirstOfGroup(g) == null
                set u = GroupPickRandomUnit(g)
                call GroupRemoveUnit( g,u )
                set TryBuild_u = u
                call ExecuteFunc("TryBuild")
                
                set bj_forLoopAIndex = bj_forLoopAIndex + 1
            endloop
            call GroupClear(g)
        endif
        
        // Лесорубы - из них приходят лишь строить
        if LoadInteger(AiData,pi,StringHash("T")) < 12  then
            call GroupEnumUnitsOfPlayer(g,p,Harwest)
            
            loop
                exitwhen LoadInteger(AiData,pi,StringHash("T")) > 9 or LoadInteger(AiData,pi,StringHash("HV")) < 1
            
            
                set u = GroupPickRandomUnit(g)
                
                call GroupAddUnit( udg_Ai_buildersT[pi], u )
                call GroupRemoveUnit( udg_Ai_harvest[pi], u)
                set i = LoadInteger(AiData,pi,StringHash("T"))+1
                call SaveInteger(AiData,pi,StringHash("T"),i)
                set i = LoadInteger(AiData,pi,StringHash("HV"))-1
                call SaveInteger(AiData,pi,StringHash("HV"),i)
                set TryBuild_u = u
                call ExecuteFunc("TryBuild")
            endloop
            
        else
        endif
        call GroupClear(g)
        
        
        
    endif
    call DestroyGroup(g)
    set g = null
    set u = null
endfunction




