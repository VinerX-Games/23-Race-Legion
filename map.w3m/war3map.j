//===========================================================================
// Trigger: Revive
//===========================================================================
function Trig_Revive_Conditions takes nothing returns boolean
    return udg_AiControl[GetPlayerId(GetOwningPlayer(GetRevivableUnit()))]
endfunction

function Trig_Revive_Actions takes nothing returns nothing
    local group g = CreateGroup()
    local unit u = GetRevivableUnit()
    local unit u2 = null
    local player p = GetOwningPlayer(u) 
    local location l 
    
    
    //call DisplayTimedTextFromPlayer(Player(0),0,0, 4,"Готов к воскрешению")
    call GroupClear(udg_LocalOtrad)
    //set AO_Altar = Condition(function f_AO_Altar) 
    call GroupEnumUnitsOfPlayer(g,p,Altars)
    if FirstOfGroup(g) != null then
        set u2 = GroupPickRandomUnit(g)
        set l = GetUnitLoc(u2)
        //call IssueTargetOrder(u2, "revive", u)
        call TriggerSleepAction(9*GetHeroLevel(u))
        call ReviveHeroLoc( u, l, true )
        
    endif
    //Зачистка
    call RemoveLocation(l)
    set l = null
    call DestroyGroup(g)
    set g = null
    set u = null
    set p = null

endfunction

