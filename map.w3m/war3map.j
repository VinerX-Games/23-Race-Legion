        call AdjustPlayerStateBJ( 50, GetOwningPlayer(GetEventDamageSource()), PLAYER_STATE_RESOURCE_LUMBER )
        call IssueImmediateOrderBJ( GetEventDamageSource(), "berserk" )
    else
    endif
endfunction

