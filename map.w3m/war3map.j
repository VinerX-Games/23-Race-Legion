//===========================================================================
// Trigger: ResearhRobbery
//===========================================================================
function Trig_ResearhRobbery_Conditions takes nothing returns boolean
    if ( not ( GetResearched() == 'R00I' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ResearhRobbery_Func001Func001002 takes nothing returns boolean
    return ( GetUnitAbilityLevelSwapped('A00M', GetTriggerUnit()) >= 1 )
endfunction

function Trig_ResearhRobbery_Func001Func004A takes nothing returns nothing
    call SetUnitAbilityLevelSwapped( 'A00M', GetEnumUnit(), 2 )
endfunction

function Trig_ResearhRobbery_Func001C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R00I', GetOwningPlayer(GetTriggerUnit())) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ResearhRobbery_Func002Func001002 takes nothing returns boolean
    return ( GetUnitAbilityLevelSwapped('A00M', GetTriggerUnit()) >= 1 )
endfunction

function Trig_ResearhRobbery_Func002Func004A takes nothing returns nothing
    call SetUnitAbilityLevelSwapped( 'A00M', GetEnumUnit(), 3 )
endfunction

function Trig_ResearhRobbery_Func002C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R00I', GetOwningPlayer(GetTriggerUnit())) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ResearhRobbery_Func003Func001002 takes nothing returns boolean
    return ( GetUnitAbilityLevelSwapped('A00M', GetTriggerUnit()) >= 1 )
endfunction

function Trig_ResearhRobbery_Func003Func004A takes nothing returns nothing
    call SetUnitAbilityLevelSwapped( 'A00M', GetEnumUnit(), 4 )
endfunction

function Trig_ResearhRobbery_Func003C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R00I', GetOwningPlayer(GetTriggerUnit())) == 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ResearhRobbery_Actions takes nothing returns nothing
    if ( Trig_ResearhRobbery_Func001C() ) then
        set udg_Boolexpr = Condition(function Trig_ResearhRobbery_Func001Func001002)
        set udg_LocalPlayer = GetOwningPlayer(GetTriggerUnit())
        call GroupEnumUnitsOfPlayer( udg_LocalOtrad2, udg_LocalPlayer, udg_Boolexpr )
        call ForGroupBJ( udg_LocalOtrad2, function Trig_ResearhRobbery_Func001Func004A )
        call GroupClear( udg_LocalOtrad2 )
    else
    endif
    if ( Trig_ResearhRobbery_Func002C() ) then
        set udg_Boolexpr = Condition(function Trig_ResearhRobbery_Func002Func001002)
        set udg_LocalPlayer = GetOwningPlayer(GetTriggerUnit())
        call GroupEnumUnitsOfPlayer( udg_LocalOtrad2, udg_LocalPlayer, udg_Boolexpr )
        call ForGroupBJ( udg_LocalOtrad2, function Trig_ResearhRobbery_Func002Func004A )
        call GroupClear( udg_LocalOtrad2 )
    else
    endif
    if ( Trig_ResearhRobbery_Func003C() ) then
        set udg_Boolexpr = Condition(function Trig_ResearhRobbery_Func003Func001002)
        set udg_LocalPlayer = GetOwningPlayer(GetTriggerUnit())
        call GroupEnumUnitsOfPlayer( udg_LocalOtrad2, udg_LocalPlayer, udg_Boolexpr )
        call ForGroupBJ( udg_LocalOtrad2, function Trig_ResearhRobbery_Func003Func004A )
        call GroupClear( udg_LocalOtrad2 )
    else
    endif
endfunction

//===========================================================================
function InitTrig_ResearhRobbery takes nothing returns nothing
    set gg_trg_ResearhRobbery = CreateTrigger(  )
    call DisableTrigger( gg_trg_ResearhRobbery )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_ResearhRobbery, EVENT_PLAYER_UNIT_RESEARCH_FINISH )
    call TriggerAddCondition( gg_trg_ResearhRobbery, Condition( function Trig_ResearhRobbery_Conditions ) )
