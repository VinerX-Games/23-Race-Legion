//===========================================================================
// Trigger: StartCreateAll
//===========================================================================

function Trig_StartCreateAll_Actions takes nothing returns nothing
    local integer i = 1
    local integer i2 = 0
    call TriggerExecute(gg_trg_TurnAi)

    loop
        exitwhen i==23
        if i!=12 and i!=15 and GetPlayerName(Player(i))!="Нейтрал" and GetPlayerName(Player(i))!="Противник" then
            set udg_AiControl[i] = true
            call ForceAddPlayer(  udg_Bots,Player(i) )
            // Обычное появление и ресы
           
            //Задаю место
            set i2 = GetRandomInt(0, 4)
            if i2 == 0 then
                set udg_LocalPoint = Location(18787,-14852)
            elseif i2 == 1 then
                set udg_LocalPoint = Location(18891,-8993)
            elseif i2 == 2 then
                set udg_LocalPoint = Location(16989,-2303)
            elseif i2 == 3 then
                set udg_LocalPoint = Location(26958,-5)
            elseif i2 == 4 then
                set udg_LocalPoint = Location(20346,7012)
            endif
            //Задаю место
            
            //set udg_LocalPoint = GetRandomLocInRect(gg_rct_Bot1_Copy15)
            
            //В итоге место 
            
            
            
            
            //Старт юниты
            call CreateNUnitsAtLoc( 10, 'h014', Player(i), udg_LocalPoint, bj_UNIT_FACING )
            call GroupAddGroup( GetLastCreatedGroup(), udg_Ai_units[i] )
            call GroupAddGroup( GetLastCreatedGroup(), udg_Ai_builders[i] )
            call CreateNUnitsAtLoc( 1, 'h05U', Player(i), udg_LocalPoint, bj_UNIT_FACING )
            call GroupAddUnitSimple( GetLastCreatedUnit(), udg_Ai_units[i] )
            call GroupAddUnitSimple( GetLastCreatedUnit(), udg_Ai_buildings[i] )
            call SaveInteger(AiData,i,'h014',10)
            call SaveInteger(AiData,i,'h05U',1)
            call SaveStr(AiData,udg_LocalInteger,StringHash("Race"),"AO")
            //Лимиты
            call SetLimits(Player(i))
            
            
            
            call SetPlayerStateBJ( Player(i), PLAYER_STATE_RESOURCE_GOLD, 6000 )
            call SetPlayerStateBJ( Player(i), PLAYER_STATE_RESOURCE_LUMBER, 6000 )
        endif
        set i = i + 1
    endloop
   
    
    call SetBools()
    call TriggerExecute(gg_trg_CityNearWater2)
    // Данные ИИшки
    // Таймеры ИИ
    
    call StartTimerBJ( udg_TimerSmall, false, 1.11 )
    call StartTimerBJ( udg_TimerSmall2, false, 2.12 )
    call StartTimerBJ( udg_TimerSmall3, false, 3.13 )
    call StartTimerBJ( udg_TimerSmall4, false, 4.14 )
    call StartTimerBJ( udg_AiTimerStrateg, true, 15.15 )
endfunction

