function Trig_Abordach_D_or_Ot_Actions takes nothing returns nothing
    local unit array u
    local location array p
    local effect array ef
    if ( Trig_Abordach_D_or_Ot_Func005C() ) then
        call UnitRemoveAbilityBJ( 'A001', udg_LocalUnit[1] )
        call UnitAddAbilityBJ( 'A001', udg_LocalUnit[1] )
        return
    else
    endif
    set udg_LocalUnit[1] = GetTriggerUnit()
    set udg_LocalUnit[2] = GetSpellTargetUnit()
    set u[1] = udg_LocalUnit[1]
    set u[2] = udg_LocalUnit[2]
    set udg_LocalPosition[1] = GetUnitLoc(udg_LocalUnit[1])
    set udg_LocalPosition[2] = GetUnitLoc(udg_LocalUnit[2])
    set p[1] = udg_LocalPosition[1]
    set p[2] = udg_LocalPosition[2]
    call BlzSetUnitRealFieldBJ( udg_LocalUnit[1], UNIT_RF_SPEED, 0.00 )
    call BlzSetUnitRealFieldBJ( udg_LocalUnit[1], UNIT_RF_TURN_RATE, 0.00 )
    call BlzSetUnitRealFieldBJ( udg_LocalUnit[2], UNIT_RF_SPEED, 0.00 )
    call BlzSetUnitRealFieldBJ( udg_LocalUnit[2], UNIT_RF_TURN_RATE, 0.00 )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 9
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_LocalUnit[1] = u[1]
        set udg_LocalUnit[2] = u[2]
        if ( Trig_Abordach_D_or_Ot_Func018Func003C() ) then
            call UnitRemoveAbilityBJ( 'A001', udg_LocalUnit[1] )
            call UnitAddAbilityBJ( 'A001', udg_LocalUnit[1] )
            call BlzSetUnitRealFieldBJ( udg_LocalUnit[1], UNIT_RF_SPEED, GetUnitDefaultMoveSpeed(udg_LocalUnit[1]) )
            call BlzSetUnitRealFieldBJ( udg_LocalUnit[1], UNIT_RF_TURN_RATE, GetUnitDefaultTurnSpeed(udg_LocalUnit[1]) )
            call BlzSetUnitRealFieldBJ( udg_LocalUnit[2], UNIT_RF_SPEED, GetUnitDefaultMoveSpeed(udg_LocalUnit[2]) )
            call BlzSetUnitRealFieldBJ( udg_LocalUnit[2], UNIT_RF_TURN_RATE, GetUnitDefaultTurnSpeed(udg_LocalUnit[2]) )
            return
        else
        endif
        set udg_LocalPosition[1] = GetUnitLoc(udg_LocalUnit[1])
        set udg_LocalPosition[2] = GetUnitLoc(udg_LocalUnit[2])
        call AddSpecialEffectLocBJ( udg_LocalPosition[1], "Objects\\Spawnmodels\\Human\\HCancelDeath\\HCancelDeath.mdl" )
        set udg_LocalspecialEffect[1] = GetLastCreatedEffectBJ()
        set ef[1] = udg_LocalspecialEffect[1]
        call AddSpecialEffectLocBJ( udg_LocalPosition[2], "Objects\\Spawnmodels\\Human\\HCancelDeath\\HCancelDeath.mdl" )
        set udg_LocalspecialEffect[2] = GetLastCreatedEffectBJ()
        set ef[2] = udg_LocalspecialEffect[2]
        call RemoveLocation(udg_LocalPosition[1]) 
        call RemoveLocation(udg_LocalPosition[2]) 
        // --------
        // --------
        // Победил Корабль 1
        if ( Trig_Abordach_D_or_Ot_Func018Func017C() ) then
            set udg_LocalUnit[1] = u[1]
            set udg_LocalUnit[2] = u[2]
            call TriggerExecute( gg_trg_AbordachSystemDefence2_O )
            set udg_Boolexpr = Condition(function Trig_Abordach_D_or_Ot_Func018Func017Func005002)
            set udg_LocalUnit2 = udg_LocalUnit[2]
            set udg_LocalPlayer = GetOwningPlayer(udg_LocalUnit2)
            call GroupEnumUnitsOfPlayer( udg_LocalOtrad2, udg_LocalPlayer, udg_Boolexpr )
            call ForGroupBJ( udg_LocalOtrad2, function Trig_Abordach_D_or_Ot_Func018Func017Func009A )
            call GroupClear( udg_LocalOtrad2 )
            if ( Trig_Abordach_D_or_Ot_Func018Func017Func011C() ) then
                call GroupRemoveUnitSimple( udg_LocalUnit[2], udg_Flagmans )
                call UnitRemoveAbilityBJ( 'A009', udg_LocalUnit[2] )
                set udg_LocalPlayer = GetOwningPlayer(udg_LocalUnit2)
                set udg_Boolexpr = Condition(function Trig_Abordach_D_or_Ot_Func018Func017Func011Func004002)
                call GroupEnumUnitsOfPlayer( udg_LocalOtrad2, udg_LocalPlayer, udg_Boolexpr )
                set udg_LocalText2 = "Ваш флагман |cffff0000захвачен.|r"
                call DisplayTextToPlayer( GetOwningPlayer(udg_LocalUnit[2]), 0, 0, udg_LocalText2 )
                set udg_LocalText2 = "Вы |cff00ff00захватили |rчужой флагман!"
                call DisplayTextToPlayer( GetOwningPlayer(udg_LocalUnit[1]), 0, 0, udg_LocalText2 )
                call ForGroupBJ( udg_LocalOtrad2, function Trig_Abordach_D_or_Ot_Func018Func017Func011Func010A )
                call GroupClear( udg_LocalOtrad2 )
            else
            endif
            call SetUnitOwner( udg_LocalUnit[2], GetOwningPlayer(udg_LocalUnit[1]), true )
            call UnitRemoveAbilityBJ( 'A009', udg_LocalUnit[2] )
            call UnitRemoveAbilityBJ( 'A001', udg_LocalUnit[1] )
            call UnitAddAbilityBJ( 'A001', udg_LocalUnit[1] )
            call BlzSetUnitRealFieldBJ( udg_LocalUnit[1], UNIT_RF_SPEED, GetUnitDefaultMoveSpeed(udg_LocalUnit[1]) )
            call BlzSetUnitRealFieldBJ( udg_LocalUnit[1], UNIT_RF_TURN_RATE, GetUnitDefaultTurnSpeed(udg_LocalUnit[1]) )
            call BlzSetUnitRealFieldBJ( udg_LocalUnit[2], UNIT_RF_SPEED, GetUnitDefaultMoveSpeed(udg_LocalUnit[2]) )
            call BlzSetUnitRealFieldBJ( udg_LocalUnit[2], UNIT_RF_TURN_RATE, GetUnitDefaultTurnSpeed(udg_LocalUnit[2]) )
            return
        else
        endif
        // --------
        // --------
        // Победил Корабль 2
        if ( Trig_Abordach_D_or_Ot_Func018Func021C() ) then
            set udg_LocalUnit[1] = u[1]
            set udg_LocalUnit[2] = u[2]
            call TriggerExecute( gg_trg_AbordachSystemDefence1_O )
            call UnitRemoveAbilityBJ( GetSpellAbilityId(), udg_LocalUnit[1] )
            set udg_LocalOtrad = GetUnitsOfPlayerMatching(GetOwningPlayer(udg_LocalUnit[1]), Condition(function Trig_Abordach_D_or_Ot_Func018Func021Func006002002))
            if ( Trig_Abordach_D_or_Ot_Func018Func021Func007C() ) then
                set udg_LocalOtrad = GetUnitsOfPlayerAll(GetOwningPlayer(udg_LocalUnit[1]))
                call GroupRemoveUnitSimple( udg_LocalUnit[1], udg_Flagmans )
                set udg_LocalText2 = "Ваш флагман |cffff0000захвачен.|r"
                call DisplayTextToPlayer( GetOwningPlayer(udg_LocalUnit[1]), 0, 0, udg_LocalText2 )
                set udg_LocalText2 = "Вы |cff00ff00захватили |rчужой флагман!"
                call DisplayTextToPlayer( GetOwningPlayer(udg_LocalUnit[2]), 0, 0, udg_LocalText2 )
                call UnitRemoveAbilityBJ( 'A009', udg_LocalUnit[1] )
                set udg_Boolexpr = Condition(function Trig_Abordach_D_or_Ot_Func018Func021Func007Func008002)
                set udg_LocalUnit2 = udg_LocalUnit[1]
                set udg_LocalPlayer = GetOwningPlayer(udg_LocalUnit2)
                call GroupEnumUnitsOfPlayer( udg_LocalOtrad2, udg_LocalPlayer, udg_Boolexpr )
                call ForGroupBJ( udg_LocalOtrad2, function Trig_Abordach_D_or_Ot_Func018Func021Func007Func012A )
                call GroupClear( udg_LocalOtrad2 )
            else
            endif
            call SetUnitOwner( udg_LocalUnit[1], GetOwningPlayer(udg_LocalUnit[2]), true )
            call UnitRemoveAbilityBJ( 'A009', udg_LocalUnit[1] )
            call UnitAddAbilityBJ( 'A001', udg_LocalUnit[1] )
            set udg_Boolexpr = Condition(function Trig_Abordach_D_or_Ot_Func018Func021Func011002)
            set udg_LocalUnit2 = udg_LocalUnit[1]
            set udg_LocalPlayer = GetOwningPlayer(udg_LocalUnit2)
            call GroupEnumUnitsOfPlayer( udg_LocalOtrad2, udg_LocalPlayer, udg_Boolexpr )
            call ForGroupBJ( udg_LocalOtrad2, function Trig_Abordach_D_or_Ot_Func018Func021Func015A )
            call BlzSetUnitRealFieldBJ( udg_LocalUnit[1], UNIT_RF_SPEED, GetUnitDefaultMoveSpeed(udg_LocalUnit[1]) )
            call BlzSetUnitRealFieldBJ( udg_LocalUnit[1], UNIT_RF_TURN_RATE, GetUnitDefaultTurnSpeed(udg_LocalUnit[1]) )
            call BlzSetUnitRealFieldBJ( udg_LocalUnit[2], UNIT_RF_SPEED, GetUnitDefaultMoveSpeed(udg_LocalUnit[2]) )
            call BlzSetUnitRealFieldBJ( udg_LocalUnit[2], UNIT_RF_TURN_RATE, GetUnitDefaultTurnSpeed(udg_LocalUnit[2]) )
            return
        else
        endif
        // --------
        // --------
        call SetUnitLifeBJ( udg_LocalUnit[1], ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_LocalUnit[1]) - I2R(BlzGetUnitWeaponIntegerField(udg_LocalUnit[2], UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0)) ) )
        call SetUnitLifeBJ( udg_LocalUnit[2], ( ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_LocalUnit[2]) - 6.00 ) - I2R(BlzGetUnitWeaponIntegerField(udg_LocalUnit[1], UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE, 0)) ) )
        // Поблажка пиратам)))
        if ( Trig_Abordach_D_or_Ot_Func018Func027C() ) then
            call SetUnitLifeBJ( udg_LocalUnit[2], ( ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_LocalUnit[2]) - 6.00 ) - 20.00 ) )
        else
        endif
        if ( Trig_Abordach_D_or_Ot_Func018Func028C() ) then
            call SetUnitLifeBJ( udg_LocalUnit[2], ( ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_LocalUnit[2]) - 6.00 ) - 10.00 ) )
        else
        endif
        if ( Trig_Abordach_D_or_Ot_Func018Func029C() ) then
            call SetUnitLifeBJ( udg_LocalUnit[1], ( ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_LocalUnit[2]) - 6.00 ) - 20.00 ) )
        else
        endif
        if ( Trig_Abordach_D_or_Ot_Func018Func030C() ) then
            call SetUnitLifeBJ( udg_LocalUnit[1], ( ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_LocalUnit[2]) - 6.00 ) - 10.00 ) )
        else
        endif
        // Конец поблажки ====
        set udg_LocalspecialEffect[1] = ef[1]
        set udg_LocalspecialEffect[1] = ef[2]
        call DestroyEffectBJ( udg_LocalspecialEffect[1] )
        call DestroyEffectBJ( udg_LocalspecialEffect[2] )
        call RemoveLocation(udg_LocalPosition[1]) 
        call RemoveLocation(udg_LocalPosition[2]) 
        call TriggerSleepAction( 1.00 )
        set ef[1] = null
        set ef[2] = null
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set  udg_LocalUnit[1] = u[1]
    set  udg_LocalUnit[2] = u[2]
    call BlzSetUnitRealFieldBJ( udg_LocalUnit[1], UNIT_RF_SPEED, GetUnitDefaultMoveSpeed(udg_LocalUnit[1]) )
    call BlzSetUnitRealFieldBJ( udg_LocalUnit[1], UNIT_RF_TURN_RATE, GetUnitDefaultTurnSpeed(udg_LocalUnit[1]) )
    call BlzSetUnitRealFieldBJ( udg_LocalUnit[2], UNIT_RF_SPEED, GetUnitDefaultMoveSpeed(udg_LocalUnit[2]) )
    call BlzSetUnitRealFieldBJ( udg_LocalUnit[2], UNIT_RF_TURN_RATE, GetUnitDefaultTurnSpeed(udg_LocalUnit[2]) )
    call RemoveLocation(udg_LocalPosition[1]) 
    call RemoveLocation(udg_LocalPosition[2]) 
    set u[1] = null
    set u[2] = null
    set p[1] = null
    set p[2] = null
endfunction

