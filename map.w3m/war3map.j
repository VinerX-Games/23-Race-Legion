//===========================================================================
// Trigger: felspell
//===========================================================================
function Trig_felspell_Func012C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A02D' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R01G', GetOwningPlayer(GetTriggerUnit())) == 3 ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetSpellTargetUnit(), 'B00U') == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_felspell_Conditions takes nothing returns boolean
    if ( not Trig_felspell_Func012C() ) then
        return false
    endif
    return true
endfunction

function Trig_felspell_Actions takes nothing returns nothing
    local unit u
    set udg_LocalUnit[13] = GetSpellTargetUnit()
    call UnitAddAbilityBJ( 'A04F', udg_LocalUnit[13] )
    call BlzSetUnitMaxHP( udg_LocalUnit[13], ( BlzGetUnitMaxHP(udg_LocalUnit[13]) + R2I(( BlzGetUnitRealField(udg_LocalUnit[13], UNIT_RF_HP) * 0.15 )) ) )
    set u = udg_LocalUnit[13]
    call TriggerSleepAction( 125.00 )
    set udg_LocalUnit[13] = u
    call BlzSetUnitMaxHP( udg_LocalUnit[13], ( BlzGetUnitMaxHP(udg_LocalUnit[13]) - R2I(( BlzGetUnitRealField(udg_LocalUnit[13], UNIT_RF_HP) * 0.15 )) ) )
    call UnitRemoveAbilityBJ( 'A04F', udg_LocalUnit[13] )
    call UnitRemoveBuffBJ( 'B00U', udg_LocalUnit[13] )
    set u = null
endfunction

//===========================================================================
function InitTrig_felspell takes nothing returns nothing
    set gg_trg_felspell = CreateTrigger(  )
    call DisableTrigger( gg_trg_felspell )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_felspell, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_felspell, Condition( function Trig_felspell_Conditions ) )
    call TriggerAddAction( gg_trg_felspell, function Trig_felspell_Actions )
endfunction

//===========================================================================
// Trigger: voidspell
//===========================================================================
function Trig_voidspell_Func016C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A02D' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R01H', GetOwningPlayer(GetTriggerUnit())) == 3 ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetSpellTargetUnit(), 'B00X') == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_voidspell_Conditions takes nothing returns boolean
    if ( not Trig_voidspell_Func016C() ) then
        return false
    endif
    return true
endfunction

function Trig_voidspell_Actions takes nothing returns nothing
    local unit u
    local integer i
    set udg_LocalUnit[13] = GetSpellTargetUnit()
    call UnitAddAbilityBJ( 'A04P', udg_LocalUnit[13] )
    set udg_LocalInteger = R2I(( I2R(BlzGetUnitBaseDamage(udg_LocalUnit[13], 0)) * 0.15 ))
    call BlzSetUnitBaseDamage( udg_LocalUnit[13], ( BlzGetUnitBaseDamage(udg_LocalUnit[13], 0) + udg_LocalInteger ), 0 )
    set u = udg_LocalUnit[13]
    set i = udg_LocalInteger
    call TriggerSleepAction( 125.00 )
    set udg_LocalUnit[13] = u
    set udg_LocalInteger = i
    call BlzSetUnitBaseDamage( udg_LocalUnit[13], ( BlzGetUnitBaseDamage(udg_LocalUnit[13], 0) - udg_LocalInteger ), 0 )
    call UnitRemoveAbilityBJ( 'A04P', udg_LocalUnit[13] )
    call UnitRemoveBuffBJ( 'B00X', udg_LocalUnit[13] )
    set u = null
endfunction

//===========================================================================
function InitTrig_voidspell takes nothing returns nothing
    set gg_trg_voidspell = CreateTrigger(  )
    call DisableTrigger( gg_trg_voidspell )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_voidspell, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_voidspell, Condition( function Trig_voidspell_Conditions ) )
    call TriggerAddAction( gg_trg_voidspell, function Trig_voidspell_Actions )
endfunction

