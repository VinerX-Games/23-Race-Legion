    if ( not ( GetSpellAbilityId() == 'A0N9' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pole_Astrala_Demons_Func003A takes nothing returns nothing
    local unit u
    call CreateNUnitsAtLoc( 1, 'H0BN', GetOwningPlayer(GetTriggerUnit()), udg_LocalPosition[14], bj_UNIT_FACING )
    set udg_LocalUnit[1] = GetLastCreatedUnit()
    call UnitAddAbilityBJ( 'AHbn', GetLastCreatedUnit() )
    call SetUnitManaBJ( GetLastCreatedUnit(), 1111111.00 )
    call SetUnitAbilityLevelSwapped( 'AHbn', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A08R', GetTriggerUnit()) )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "banish", GetEnumUnit() )
    set u = udg_LocalUnit[1]
    call UnitApplyTimedLife( u, 'BTLF', 2 )
    set u = null
endfunction

function Trig_Pole_Astrala_Demons_Actions takes nothing returns nothing
    set udg_LocalOtrad = GetUnitsInRangeOfLocAll(125.00, GetSpellTargetLoc())
    set udg_LocalPosition[14] = GetUnitLoc(GetTriggerUnit())
    call ForGroupBJ( udg_LocalOtrad, function Trig_Pole_Astrala_Demons_Func003A )
    call RemoveLocation(udg_LocalPosition[14]) 
endfunction

