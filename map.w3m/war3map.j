function Trig_LigthBuild_Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetConstructedStructure()) == 'h04F' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R01I', GetOwningPlayer(GetTriggerUnit())) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_LigthBuild_Conditions takes nothing returns boolean
    if ( not Trig_LigthBuild_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_LigthBuild_Actions takes nothing returns nothing
    call BlzSetUnitName( GetTriggerUnit(), "|cffffff00Колодец света|r" )
endfunction

//===========================================================================
function InitTrig_LigthBuild takes nothing returns nothing
    set gg_trg_LigthBuild = CreateTrigger(  )
    call DisableTrigger( gg_trg_LigthBuild )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_LigthBuild, EVENT_PLAYER_UNIT_CONSTRUCT_FINISH )
    call TriggerAddCondition( gg_trg_LigthBuild, Condition( function Trig_LigthBuild_Conditions ) )
    call TriggerAddAction( gg_trg_LigthBuild, function Trig_LigthBuild_Actions )
endfunction

//===========================================================================
// Trigger: Porcha
//===========================================================================
function Trig_Porcha_Conditions takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A02X', GetAttacker()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Porcha_Func003C takes nothing returns boolean
    if ( not ( udg_LocalInteger == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Porcha_Actions takes nothing returns nothing
    local unit u
    set udg_LocalInteger = GetRandomInt(1, 10)
    if ( Trig_Porcha_Func003C() ) then
        set udg_LocalUnit[11] = GetAttackedUnitBJ()
        call UnitAddAbilityBJ( 'A08I', udg_LocalUnit[11] )
        set u = udg_LocalUnit[11]
        call TriggerSleepAction( 9.00 )
        set udg_LocalUnit[11] = u
        call UnitRemoveAbilityBJ( 'A08I', udg_LocalUnit[11] )
        set u = null
    else
    endif
endfunction

//===========================================================================
function InitTrig_Porcha takes nothing returns nothing
    set gg_trg_Porcha = CreateTrigger(  )
    call DisableTrigger( gg_trg_Porcha )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Porcha, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_Porcha, Condition( function Trig_Porcha_Conditions ) )
    call TriggerAddAction( gg_trg_Porcha, function Trig_Porcha_Actions )
endfunction

