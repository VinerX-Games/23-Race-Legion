function Trig_K1T4_Conditions takes nothing returns boolean
    return GetUnitTypeId(GetTrainedUnit()) == 'otau'
endfunction


function T3Count takes player p returns nothing
    local integer array a
    local integer i = 0
    local integer b = 0
    local integer pi = GetPlayerId(p)
    
    //1 юнит
    set a[0]=0
    
    if GetPlayerTechCount(p,'R0E9',true)<1 then 
        set b = 0
        set i = 5
        loop // Таурен
                set a[0] = a[0] + 1
                set a[ a[0] ] = 'o01L'
                
                
                set b = b + 1
                exitwhen b >= i
        endloop
    endif
    set b = 0
    set i = 2
    loop // Огр-воитель
            set a[0] = a[0] + 1
            set a[ a[0] ] = 'o01M'
            set b = b + 1
            exitwhen b >= i
    endloop
    
    //Cor Cron
    if GetPlayerTechCount(p,'R0E0',false) == 1 and GetPlayerTechCount(p,'R0EH',true)<1 then
        set i = 4
        set b = 1
        
        loop
            set a[0] = a[0] + 1
            set a[ a[0] ] = 'o01U'
            
            set b = b + 1
            exitwhen b >= i
        endloop

    endif
    
    //Death knight
    if GetPlayerTechCount(p,'R0E3',true) == 1 then
        set i = 2
        set b = 1
        
        loop
            set a[0] = a[0] + 1
            set a[ a[0] ] = 'o021'
            
            set b = b + 1
            exitwhen b >= i
        endloop

    endif
    
    if GetPlayerTechCount(p,'R0EE',true) == 1 and GetPlayerTechCount(p,'R0E9',true) != 1 then 
        set b = 0
        set i = 2
        loop //Pandaren
                set a[0] = a[0] + 1
                set a[ a[0] ] = 'o02W'
                set b = b + 1
                exitwhen b >= i
        endloop
    endif
    
    
    //Long Containment
    call SaveInteger(CommonHash,pi,StringHash("T3_0"),a[0])
    set i = 1
    loop
        
        
        call SaveInteger(CommonHash,pi, StringHash("T3")+i ,a[i])
        set i=i+1
        exitwhen i >a[0]
    endloop
    
    
    
    
endfunction

function Trig_K1T4_Actions takes nothing returns nothing
    local integer array a
    local integer i = 0
    local integer b = 0
    local player p = GetOwningPlayer(GetTriggerUnit())
    local location l = GetUnitRallyPoint(GetTriggerUnit())
    local unit u
    local integer pi = GetPlayerId(p)
    
    
    
    
    
    // 
    set i = LoadInteger(CommonHash,pi,StringHash("T3_0"))
    set i = GetRandomInt( 1, i)
    set b = LoadInteger(CommonHash,pi,StringHash("T3")+i)
    //
    
    //Тен Тотем
    if b=='o01L' and Random(1,25) then
        set b = 'o032'
    endif
    set u = ReplaceUnit( GetTrainedUnit(), b , bj_UNIT_STATE_METHOD_RELATIVE )
    
    
    
    // Elite Price
    call UnitAddAbility(u,'A0UX')
    call SetUnitAbilityLevel(u,'OR00',35+udg_HordeElitePrice[pi])
    

    set udg_UnitsCount[pi]=udg_UnitsCount[pi]-1
    call UnitAddAbility(u,'A0YU')
    call IssuePointOrderLoc( u, "attack", l )
    call RemoveLocation(l)
    set p = null
    set u = null
endfunction

