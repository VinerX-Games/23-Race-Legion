    set gg_trg_Connect_Portal_2 = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Connect_Portal_2, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Connect_Portal_2, Condition( function Trig_Connect_Portal_2_Conditions ) )
    call TriggerAddAction( gg_trg_Connect_Portal_2, function Trig_Connect_Portal_2_Actions )
endfunction

