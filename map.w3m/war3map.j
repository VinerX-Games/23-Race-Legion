function Trig_FireRage_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0QJ'
endfunction

function Trig_FireRage_Actions takes nothing returns nothing
    local unit u = GetTriggerUnit()
    call UnitAddAbility( u,'A0OM')
    call TriggerSleepAction( 12.00 )
    call UnitRemoveAbility( u,'A0OM' )
    set u = null
endfunction

