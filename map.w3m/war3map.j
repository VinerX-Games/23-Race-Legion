    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) != true )
endfunction

function Trig_DM_1_O_Func002002001002 takes nothing returns boolean
    return ( GetUnitAbilityLevelSwapped('Sch5', GetFilterUnit()) == 0 )
endfunction

function Trig_DM_1_O_Func002002001 takes nothing returns boolean
    return GetBooleanAnd( Trig_DM_1_O_Func002002001001(), Trig_DM_1_O_Func002002001002() )
endfunction

