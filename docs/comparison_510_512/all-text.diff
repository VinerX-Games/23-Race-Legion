+---@param angle real
+function SetUnitPolarLoc(u, l, dist, angle)
+	local a = angle * bj_DEGTORAD
+	SetUnitPosition(u, GetLocationX(l) + dist * Cos(a), GetLocationY(l) + dist * Sin(a))
+end
