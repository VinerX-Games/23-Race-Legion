+            UnitRemoveAbility(caster, FourCC('Anhe'))
+            UnitAddAbility(caster, FourCC('ACfb'))
+        else
+            Owl_Phase[h] = "lunar"
+            UnitRemoveAbility(caster, FourCC('ACfb'))
+            UnitAddAbility(caster, FourCC('Anhe'))
+        end
+        UpdateOwlAstralVisuals(caster)
