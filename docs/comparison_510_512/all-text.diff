+-- Ленивый кэш boolexpr по функции-фильтру: GroupEnum*/TriggerAddCondition ждут
+-- Filter(f), а не голую функцию. Создаётся при первом вызове (не на корневом уровне
+-- скрипта), по таблице не итерируемся -> детерминизм не страдает.
+local cachedFilters = {}
+---@param f function
+---@return boolexpr
+function CachedFilter(f)
+	local b = cachedFilters[f]
+	if b == nil then
+		b = Filter(f)
+		cachedFilters[f] = b
+	end
+	return b
+end
+-- GUI-идиома `ForGroupBJ(GetUnits...(...), f)` без bj_wantDestroyGroup теряла группу
+-- на каждом вызове. Для свежесозданной группы: перебрать и уничтожить.
+---@param g group
+---@param f function
+function ForGroupDestroy(g, f)
+	ForGroup(g, f)
+	DestroyGroup(g)
+end
+-- `SetUnitPositionLoc(u, PolarProjectionBJ(l, d, a))` создавала (и теряла) локацию.
+---@param u unit
